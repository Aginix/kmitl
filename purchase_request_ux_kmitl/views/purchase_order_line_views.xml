<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_line_tree" model="ir.ui.view">
        <field name="name">view.purchase.order.line.tree</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase_request.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='action_open_request_line_tree_view']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_request.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='action_open_request_line_tree_view']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
