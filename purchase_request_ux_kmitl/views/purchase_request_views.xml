<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form (UX KMITL)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <!-- Hide unused fields -->
            <xpath expr="//field[@name='purchase_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='group_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="attrs"
                    >{'invisible': [('origin', '=', False)]}</attribute
                >
            </xpath>
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='verified_by']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_verified']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='approved_by']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_approved']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='title']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_fiscal_year_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='is_egp']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_method_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='exception_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Tree name='line_ids' -->
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='name']"
                position="attributes"
            >
                <attribute name="required">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='product_uom_id']"
                position="attributes"
            >
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='date_required']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='purchased_qty']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='purchase_state']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_show_details']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_view_purchase_request_line']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree" position="attributes">
                <attribute name="no_open">1</attribute>
            </xpath>

            <!-- add field -->
            <xpath expr="//h1" position="after">
                <group
                    string="รายละเอียดคำขอซื้อขอจ้าง"
                    name="purchase_request_details_group"
                >
                    <group>
                        <field
                            name="title"
                            required="1"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                        />
                        <field
                            name="description"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                        />
                        <field
                            name="requested_by"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                        />
                        <field
                            name="department_id"
                            string="Department"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                        <field name="user_id" readonly="1" />
                    </group>
                </group>

                <group string="คำขอซื้อขอจ้าง" name="purchase_request_group">
                    <group>
                        <field
                            name="account_fiscal_year_id"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                            required="1"
                            widget="selection"
                        />
                        <field
                            name="procurement_type_id"
                            required="1"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                        />
                        <field
                            name="procurement_method_id"
                            required="1"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                        />
                        <field
                            name="payment_type"
                            required="1"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                            widget="radio"
                            options="{'horizontal': true}"
                        />
                        <field
                            name="is_egp"
                            attrs="{'readonly': ['|', ('estimated_cost', '>', 100000), ('is_editable', '=', False)]}"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- View purchase.request tree -->
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree (UX KMITL)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="l10n_th_gov_purchase_request.view_purchase_request_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_requisition_inherit_view_form" model="ir.ui.view">
        <field name="name"
            >view.purchase.request.requisition.inherit.view.form (Hide requisition
            fields)</field
        >
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_to_requisition.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requisition_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='requisition_state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
