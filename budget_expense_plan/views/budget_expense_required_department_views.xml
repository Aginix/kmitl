<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_expense_required_department_tree" model="ir.ui.view">
        <field name="name">budget.expense.required.department.tree</field>
        <field name="model">budget.expense.required.department</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="department_analytic_id" />
                <field name="note" />
                <field name="active" invisible="1" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="action_budget_expense_required_department" model="ir.actions.act_window">
        <field name="name">ส่วนงานที่ต้องทำแผนเบิกจ่าย</field>
        <field name="res_model">budget.expense.required.department</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">กำหนดส่วนงานที่ต้องจัดทำแผนเบิกจ่าย</p>
            <p>รายชื่อนี้ใช้สร้างเอกสารแผนให้แต่ละส่วนงาน และติดตามว่าส่วนงานใดยังไม่ทำ</p>
        </field>
    </record>

</odoo>
