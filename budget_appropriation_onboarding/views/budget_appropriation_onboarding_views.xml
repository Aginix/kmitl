<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Kanban View -->
    <record id="view_budget_appropriation_onboarding_kanban" model="ir.ui.view">
        <field name="name">budget.appropriation.onboarding.kanban</field>
        <field name="model">budget.appropriation.onboarding</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard" sample="1">
                <field name="progress" />
                <field name="step1_done" />
                <field name="step2_done" />
                <field name="step3_done" />
                <field name="step1_total_count" />
                <field name="step2_compilation_count" />
                <field name="step3_submitted_count" />
                <field name="step3_total_compilation_count" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="department_analytic_id" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span class="text-muted">
                                        <field name="account_fiscal_year_id" />
                                    </span>
                                    <div class="mt-2">
                                        <field name="progress" widget="progressbar" options="{'editable': false}" />
                                    </div>
                                    <div class="mt-2">
                                        <span t-attf-class="badge rounded-pill #{record.step1_done.raw_value ? 'bg-success' : 'bg-secondary'} me-1">
                                            1. ประมาณการ
                                            <t t-if="record.step1_total_count.raw_value > 0">
                                                (<t t-esc="record.step1_total_count.value" />)
                                            </t>
                                        </span>
                                        <span t-attf-class="badge rounded-pill #{record.step2_done.raw_value ? 'bg-success' : 'bg-secondary'} me-1">
                                            2. รวมเล่ม
                                            <t t-if="record.step2_compilation_count.raw_value > 0">
                                                (<t t-esc="record.step2_compilation_count.value" />)
                                            </t>
                                        </span>
                                        <span t-attf-class="badge rounded-pill #{record.step3_done.raw_value ? 'bg-success' : 'bg-secondary'}">
                                            3. ยืนยัน
                                            <t t-if="record.step3_total_compilation_count.raw_value > 0">
                                                (<t t-esc="record.step3_submitted_count.value" />/<t t-esc="record.step3_total_compilation_count.value" />)
                                            </t>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_budget_appropriation_onboarding_tree" model="ir.ui.view">
        <field name="name">budget.appropriation.onboarding.tree</field>
        <field name="model">budget.appropriation.onboarding</field>
        <field name="arch" type="xml">
            <tree>
                <field name="department_analytic_id" />
                <field name="account_fiscal_year_id" />
                <field name="step1_done" widget="boolean_toggle" />
                <field name="step2_done" widget="boolean_toggle" />
                <field name="step3_done" widget="boolean_toggle" />
                <field name="progress" widget="progressbar" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_budget_appropriation_onboarding_form" model="ir.ui.view">
        <field name="name">budget.appropriation.onboarding.form</field>
        <field name="model">budget.appropriation.onboarding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="department_analytic_id" />
                            <field name="account_fiscal_year_id" />
                        </group>
                        <group>
                            <field name="progress" widget="progressbar" />
                        </group>
                    </group>
                    <notebook>
                        <!-- Step 1 -->
                        <page string="1. ทำประมาณการรายรับ-รายจ่าย" name="step1">
                            <group>
                                <group string="สถานะข้อมูลประมาณการ">
                                    <field name="step1_total_count" />
                                    <field name="step1_revenue_count" />
                                    <field name="step1_expense_count" />
                                    <field name="step1_submitted_count" />
                                    <field name="step1_draft_count" />
                                </group>
                                <group string="ดำเนินการ">
                                    <field name="step1_done" widget="boolean_toggle" />
                                    <button
                                        name="action_open_appropriations"
                                        string="ดูรายการประมาณการ"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-external-link"
                                    />
                                </group>
                            </group>
                        </page>
                        <!-- Step 2 -->
                        <page string="2. ทำรวมเล่มหน่วยงาน" name="step2">
                            <group>
                                <group string="สถานะรวมเล่มตามแหล่งเงิน">
                                    <field
                                        name="step2_source_status_html"
                                        nolabel="1"
                                        colspan="2"
                                    />
                                </group>
                                <group string="ดำเนินการ">
                                    <field name="step2_compilation_count" />
                                    <field name="step2_pending_appropriation_count" />
                                    <field name="step2_done" widget="boolean_toggle" />
                                    <button
                                        name="action_open_compilations"
                                        string="ดูรายการรวมเล่ม"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-external-link"
                                    />
                                </group>
                            </group>
                        </page>
                        <!-- Step 3 -->
                        <page string="3. ยืนยันส่งข้อมูลประมาณการ" name="step3">
                            <group>
                                <group string="สถานะการยืนยัน">
                                    <field name="step3_submitted_count" />
                                    <field name="step3_total_compilation_count" />
                                </group>
                                <group string="ดำเนินการ">
                                    <field name="step3_done" widget="boolean_toggle" />
                                    <button
                                        name="action_open_compilations"
                                        string="ดูรายการรวมเล่ม"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-external-link"
                                    />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_budget_appropriation_onboarding_search" model="ir.ui.view">
        <field name="name">budget.appropriation.onboarding.search</field>
        <field name="model">budget.appropriation.onboarding</field>
        <field name="arch" type="xml">
            <search>
                <field name="department_analytic_id" />
                <field name="account_fiscal_year_id" />
                <filter
                    name="current_fiscal_year"
                    string="ปีงบประมาณปัจจุบัน"
                    domain="[
                        ('account_fiscal_year_id.date_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                        ('account_fiscal_year_id.date_to', '&gt;=', context_today().strftime('%Y-%m-%d')),
                    ]"
                />
                <separator />
                <filter
                    name="not_complete"
                    string="ยังไม่เสร็จ"
                    domain="['|', '|', ('step1_done', '=', False), ('step2_done', '=', False), ('step3_done', '=', False)]"
                />
                <filter
                    name="complete"
                    string="เสร็จสิ้น"
                    domain="[('step1_done', '=', True), ('step2_done', '=', True), ('step3_done', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_fiscal_year"
                        string="ปีงบประมาณ"
                        context="{'group_by': 'account_fiscal_year_id'}"
                    />
                </group>
                <searchpanel>
                    <field
                        name="department_analytic_id"
                        icon="fa-users"
                        select="multi"
                        limit="0"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_budget_appropriation_onboarding" model="ir.actions.act_window">
        <field name="name">ติดตามความคืบหน้าการจัดสรรงบประมาณ</field>
        <field name="res_model">budget.appropriation.onboarding</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_current_fiscal_year': 1}</field>
        <field name="search_view_id" ref="view_budget_appropriation_onboarding_search" />
    </record>

</odoo>
