<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_type_form_accounting" model="ir.ui.view">
        <field name="name">res.partner.type.form.accounting</field>
        <field name="model">res.partner.type</field>
        <field name="inherit_id" ref="partner_type_kmitl.res_partner_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="accounting_settings" string="Accounting Settings">
                    <group>
                        <field name="property_account_receivable_id"/>
                        <field name="property_account_payable_id"/>
                        <field name="wht_tax_id"/>
                        <button
                            name="action_apply_accounts_to_partners"
                            type="object"
                            string="Apply to existing partners"
                            class="btn-link"
                            icon="fa-refresh"
                            colspan="2"
                            groups="account.group_account_manager"
                            attrs="{'invisible': [('property_account_receivable_id', '=', False), ('property_account_payable_id', '=', False)]}"
                            confirm="Overwrite the receivable and payable accounts of every partner of this type, including partners whose accounts were changed by hand? Journal entries already recorded are not affected."
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_res_partner_type_accounting"
        name="Partner Type"
        parent="account.menu_finance_configuration"
        action="partner_type_kmitl.action_res_partner_type"
        sequence="50"
    />

</odoo>
