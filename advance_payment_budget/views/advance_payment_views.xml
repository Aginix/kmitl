<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_form_budget" model="ir.ui.view">
        <field name="name">advance.payment.form.budget</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">

            <xpath expr="//group[@name='actual_expense']" position="before">
                <group name="analytic_dimensions" string="มิติทางบัญชี">
                    <field name="budget_commitment_id"
                        widget="budget_commitment_info"
                        options="{'no_create': True, 'no_open': True}"
                        attrs="{'readonly': [('state', '!=', 'draft')]}" />
                    <field name="department_analytic_id"
                        attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_locked_by_reference', '=', True)]}" />
                    <field name="source_analytic_id"
                        attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_locked_by_reference', '=', True)]}" />
                    <field name="fund_analytic_id"
                        attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_locked_by_reference', '=', True)]}" />
                    <field name="activity_analytic_id"
                        attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_locked_by_reference', '=', True)]}" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
