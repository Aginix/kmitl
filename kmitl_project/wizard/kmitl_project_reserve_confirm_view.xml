<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_reserve_confirm_form" model="ir.ui.view">
        <field name="name">kmitl.project.reserve.confirm.form</field>
        <field name="model">kmitl.project.reserve.confirm</field>
        <field name="arch" type="xml">
            <form string="จองงบประมาณ">
                <sheet>
                    <group>
                        <group string="รหัสงบ / มิติ">
                            <field name="budget_account_id" />
                            <field name="account_fiscal_year_id" />
                            <field name="activity_analytic_id" />
                            <field name="department_analytic_id" />
                            <field name="fund_analytic_id" />
                            <field name="source_analytic_id" />
                            <field name="analytic_account_id" />
                        </group>
                        <group string="ยอดจัดสรร">
                            <field name="budget_amount" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="ยืนยันจองงบประมาณ" class="btn-primary" />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
