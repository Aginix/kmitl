<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_reserve_confirm_form" model="ir.ui.view">
        <field name="name">kmitl.project.reserve.confirm.form</field>
        <field name="model">kmitl.project.reserve.confirm</field>
        <field name="arch" type="xml">
            <form string="ยืนยันงบประมาณ">
                <sheet>
                    <p>ยืนยันงบประมาณที่ได้รับจัดสรรสำหรับโครงการนี้ใช่หรือไม่?</p>
                    <p class="text-muted">ระบบจะจองงบประมาณเมื่อโครงการได้รับอนุมัติ</p>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="ยืนยันงบประมาณ" class="btn-primary" />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
