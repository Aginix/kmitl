<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmitl_project_reject_wizard_form" model="ir.ui.view">
        <field name="name">kmitl.project.reject.wizard.form</field>
        <field name="model">kmitl.project.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Project">
                <group>
                    <field name="project_id" invisible="1" />
                    <field name="rejection_reason" placeholder="Please provide a reason for rejection..." />
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
