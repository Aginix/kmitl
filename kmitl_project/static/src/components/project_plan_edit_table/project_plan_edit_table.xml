<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="kmitl_project.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary" owl="1">
        <xpath expr="//thead/tr" position="before">
            <tr>
                <th data-name="sequence" style=""></th>
                <th data-name="name" style=""></th>
                <th data-name="percentage" style=""></th>
                <th data-name="amount" style=""></th>
                <th colspan="3" class="text-center quarterly">ไตรมาสที่ 1</th>
                <th colspan="3" class="text-center quarterly">ไตรมาสที่ 2</th>
                <th colspan="3" class="text-center quarterly">ไตรมาสที่ 3</th>
                <th colspan="3" class="text-center quarterly">ไตรมาสที่ 4</th>
                <th style=""></th>
            </tr>
        </xpath>

        <xpath expr="//t[@t-foreach='state.columns']//th" position="attributes">
            <attribute name="t-on-click"/>
            <attribute name="t-on-mouseenter"/>
            <attribute name="t-on-mouseleave"/>
        </xpath>
    </t>
</templates>
