<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.impact View Tree -->
    <record id="view_project_impact_tree" model="ir.ui.view">
        <field name="name">view.project.impact.tree</field>
        <field name="model">project.impact</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View project.impact search -->
    <record id="view_project_impact_search" model="ir.ui.view">
        <field name="name">view.project.impact.search</field>
        <field name="model">project.impact</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.impact -->
    <record id="action_project_impact" model="ir.actions.act_window">
        <field name="name">Project Impact</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.impact</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Impact.
            </p>
        </field>
    </record>

    <menuitem id="project_impact_config_menu" name="Impact" action="action_project_impact" parent="menu_project_config" sequence="15" />
</odoo>
