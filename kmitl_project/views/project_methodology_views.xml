<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.methodology View Tree -->
    <record id="view_project_methodology_tree" model="ir.ui.view">
        <field name="name">view.project.methodology.tree</field>
        <field name="model">project.methodology</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View project.methodology search -->
    <record id="view_project_methodology_search" model="ir.ui.view">
        <field name="name">view.project.methodology.search</field>
        <field name="model">project.methodology</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.methodology -->
    <record id="action_project_methodology" model="ir.actions.act_window">
        <field name="name">Project Methodology</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.methodology</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Methodology.
            </p>
        </field>
    </record>

    <menuitem id="project_methodology_config_menu" name="วิธีดำเนินการ" action="action_project_methodology" parent="menu_project_config" sequence="30" />
</odoo>
