<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_commitment_form" model="ir.ui.view">
        <field name="name">view.budget.commitment.form</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="kmitl_project_id" invisible="1" />
                <button
                    name="action_view_kmitl_project"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    attrs="{'invisible': [('kmitl_project_id', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">KMITL Project</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="kmitl_project_id" string="KMITL Project"
                    options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" />
            </xpath>
        </field>
    </record>
</odoo>
