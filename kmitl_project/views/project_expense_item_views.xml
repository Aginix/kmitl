<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.expense.item tree -->
    <record id="view_project_expense_item_tree" model="ir.ui.view">
        <field name="name">view.project.expense.item.tree</field>
        <field name="model">project.expense.item</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="budget_type" />
                <field name="parent_id" options="{'no_create': True}" domain="[('parent_id', '=', False)]" />
                <field name="name" />
                <field name="complete_name" optional="hide" />
            </tree>
        </field>
    </record>

    <!-- View project.expense.item search -->
    <record id="view_project_expense_item_search" model="ir.ui.view">
        <field name="name">view.project.expense.item.search</field>
        <field name="model">project.expense.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name" string="รายการ" filter_domain="['|', ('name', 'ilike', self), ('complete_name', 'ilike', self)]" />
                <field name="parent_id" />
                <filter name="income" string="รายรับ" domain="[('budget_type', '=', 'income')]" />
                <filter name="expense" string="รายจ่าย" domain="[('budget_type', '=', 'expense')]" />
                <separator />
                <filter name="roots" string="ประเภทงบ (รายการหลัก)" domain="[('parent_id', '=', False)]" />
                <group expand="1" name="group_by" string="Group By">
                    <filter string="ประเภท" name="group_budget_type" domain="[]" context="{'group_by': 'budget_type'}" />
                    <filter string="ประเภทงบ" name="group_parent" domain="[]" context="{'group_by': 'parent_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.expense.item -->
    <record id="action_project_expense_item" model="ir.actions.act_window">
        <field name="name">รายการงบประมาณโครงการ</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.expense.item</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                คลิกเพื่อเพิ่มรายการงบประมาณโครงการ (รายรับ/รายจ่าย)
            </p>
        </field>
    </record>

    <menuitem id="project_expense_item_config_menu" name="รายการงบประมาณ" action="action_project_expense_item" parent="menu_project_config" sequence="35" />
</odoo>
