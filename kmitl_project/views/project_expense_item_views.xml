<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.expense.item tree -->
    <record id="view_project_expense_item_tree" model="ir.ui.view">
        <field name="name">view.project.expense.item.tree</field>
        <field name="model">project.expense.item</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="budget_type" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <!-- View project.expense.item search -->
    <record id="view_project_expense_item_search" model="ir.ui.view">
        <field name="name">view.project.expense.item.search</field>
        <field name="model">project.expense.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter name="personnel" string="งบบุคลากร" domain="[('budget_type', '=', 'personnel')]" />
                <filter name="operating" string="งบดำเนินงาน" domain="[('budget_type', '=', 'operating')]" />
                <filter name="subsidy" string="งบอุดหนุน" domain="[('budget_type', '=', 'subsidy')]" />
                <group expand="1" name="group_by" string="Group By">
                    <filter string="ประเภทงบ" name="group_budget_type" domain="[]" context="{'group_by': 'budget_type'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.expense.item -->
    <record id="action_project_expense_item" model="ir.actions.act_window">
        <field name="name">รายการค่าใช้จ่ายโครงการ</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.expense.item</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                คลิกเพื่อเพิ่มรายการค่าใช้จ่ายโครงการ
            </p>
        </field>
    </record>

    <menuitem id="project_expense_item_config_menu" name="รายการค่าใช้จ่าย" action="action_project_expense_item" parent="menu_project_config" sequence="35" />
</odoo>
