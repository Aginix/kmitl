<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home Page: Projects Counter -->
    <template id="portal_my_home" name="Show KMITL Projects" customize_show="True" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">KMITL Projects</t>
                <t t-set="url" t-value="'/my/kmitl-projects'"/>
                <t t-set="placeholder_count" t-value="'project_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Projects List View -->
    <template id="portal_my_kmitl_projects" name="My KMITL Projects">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">KMITL Projects</t>
            </t>

            <t t-if="not projects">
                <div class="alert alert-info">
                    ยังไม่มีโครงการในระบบ
                </div>
            </t>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>รหัสโครงการ</th>
                            <th>ชื่อโครงการ</th>
                            <th>ปีงบประมาณ</th>
                            <th>หน่วยงาน</th>
                            <th>สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="projects" t-as="project">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/kmitl-project/#{project.id}">
                                        <span t-field="project.key" t-if="project.key"/>
                                        <span t-else="">-</span>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/kmitl-project/#{project.id}">
                                        <span t-field="project.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-field="project.account_fiscal_year_id.name" t-if="project.account_fiscal_year_id"/>
                                    <span t-else="">-</span>
                                </td>
                                <td>
                                    <span t-field="project.department_id.name" t-if="project.department_id"/>
                                    <span t-else="">-</span>
                                </td>
                                <td>
                                    <span t-field="project.state"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <!-- Project Detail View -->
    <template id="portal_my_kmitl_project" name="KMITL Project Portal Template" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="row mt16 o_portal_project_sidebar">
                <div class="col-12">
                    <div class="card">
                        <div t-call="kmitl_project.kmitl_project_portal_content"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Project Content Details -->
    <template id="kmitl_project_portal_content" name="KMITL Project Portal Content">
        <div class="card-header">
            <h3>
                <span t-field="kmitl_project.name"/>
            </h3>
            <div t-if="kmitl_project.key">
                รหัสโครงการ: <span t-field="kmitl_project.key"/>
            </div>
        </div>

        <div class="card-body">
            <!-- Basic Information -->
            <h5>ข้อมูลทั่วไป</h5>
            <table class="table table-sm">
                <tr>
                    <td width="30%"><strong>ประเภทโครงการ</strong></td>
                    <td>
                        <t t-if="kmitl_project.project_type == 'project'">โครงการ/กิจกรรม</t>
                        <t t-elif="kmitl_project.project_type == 'strategic_project'">โครงการยุทธศาสตร์</t>
                    </td>
                </tr>
                <tr>
                    <td><strong>สถานะ</strong></td>
                    <td><span t-field="kmitl_project.state"/></td>
                </tr>
                <tr t-if="kmitl_project.account_fiscal_year_id">
                    <td><strong>ปีงบประมาณ</strong></td>
                    <td><span t-field="kmitl_project.account_fiscal_year_id.name"/></td>
                </tr>
                <tr t-if="kmitl_project.department_id">
                    <td><strong>หน่วยงาน</strong></td>
                    <td><span t-field="kmitl_project.department_id.name"/></td>
                </tr>
                <tr t-if="kmitl_project.user_id">
                    <td><strong>ผู้รับผิดชอบ</strong></td>
                    <td><span t-field="kmitl_project.user_id.name"/></td>
                </tr>
                <tr t-if="kmitl_project.date_start">
                    <td><strong>วันที่เริ่มต้น</strong></td>
                    <td><span t-field="kmitl_project.date_start" t-options='{"widget": "date"}'/></td>
                </tr>
                <tr t-if="kmitl_project.date_end">
                    <td><strong>วันที่สิ้นสุด</strong></td>
                    <td><span t-field="kmitl_project.date_end" t-options='{"widget": "date"}'/></td>
                </tr>
                <tr t-if="kmitl_project.location">
                    <td><strong>สถานที่ดำเนินโครงการ</strong></td>
                    <td><span t-field="kmitl_project.location"/></td>
                </tr>
            </table>

            <!-- Introduction -->
            <div t-if="kmitl_project.introduction">
                <h5>หลักการและเหตุผล</h5>
                <p style="white-space: pre-wrap;" t-field="kmitl_project.introduction"/>
            </div>

            <!-- Objectives -->
            <div t-if="kmitl_project.objective">
                <h5>วัตถุประสงค์</h5>
                <p style="white-space: pre-wrap;" t-field="kmitl_project.objective"/>
            </div>

            <!-- Strategic Plans -->
            <div t-if="kmitl_project.national_strategy_id or kmitl_project.master_plan_id or kmitl_project.nesdc_plan_id or kmitl_project.kmitl_plan_id">
                <h5>ความสอดคล้องกับแผนยุทธศาสตร์</h5>
                <table class="table table-sm">
                    <tr t-if="kmitl_project.national_strategy_id">
                        <td width="30%"><strong>ยุทธศาสตร์ชาติ</strong></td>
                        <td><span t-field="kmitl_project.national_strategy_id.name"/></td>
                    </tr>
                    <tr t-if="kmitl_project.master_plan_id">
                        <td><strong>แผนแม่บทภายใต้ยุทธศาสตร์ชาติ</strong></td>
                        <td><span t-field="kmitl_project.master_plan_id.name"/></td>
                    </tr>
                    <tr t-if="kmitl_project.nesdc_plan_id">
                        <td><strong>แผนพัฒนาเศรษฐกิจและสังคมแห่งชาติ</strong></td>
                        <td><span t-field="kmitl_project.nesdc_plan_id.name"/></td>
                    </tr>
                    <tr t-if="kmitl_project.kmitl_plan_id">
                        <td><strong>แผนกลยุทธ์สถาบัน</strong></td>
                        <td><span t-field="kmitl_project.kmitl_plan_id.name"/></td>
                    </tr>
                </table>
            </div>

            <!-- FIGHT Values -->
            <div t-if="kmitl_project.fight_ids">
                <h5>ความสอดคล้องกับค่านิยม FIGHT</h5>
                <ul>
                    <t t-foreach="kmitl_project.fight_ids" t-as="fight">
                        <li><span t-field="fight.code"/> - <span t-field="fight.name"/></li>
                    </t>
                </ul>
            </div>

            <!-- Impact -->
            <div t-if="kmitl_project.impact_ids">
                <h5>ผลกระทบ</h5>
                <ul>
                    <t t-foreach="kmitl_project.impact_ids" t-as="impact">
                        <li><span t-field="impact.name"/></li>
                    </t>
                </ul>
            </div>

            <!-- Global Index -->
            <div t-if="kmitl_project.global_index_ids">
                <h5>ดัชนีชี้วัดระดับสากล</h5>
                <ul>
                    <t t-foreach="kmitl_project.global_index_ids" t-as="index">
                        <li><span t-field="index.code"/> - <span t-field="index.name"/></li>
                    </t>
                </ul>
            </div>

            <!-- Methodology -->
            <div t-if="kmitl_project.methodology_ids">
                <h5>วิธีดำเนินการ</h5>
                <ul>
                    <t t-foreach="kmitl_project.methodology_ids" t-as="method">
                        <li><span t-field="method.name"/></li>
                    </t>
                </ul>
            </div>
            <div t-if="kmitl_project.methodology_detail">
                <p><strong>รายละเอียดวิธีดำเนินการ:</strong></p>
                <p style="white-space: pre-wrap;" t-field="kmitl_project.methodology_detail"/>
            </div>

            <!-- Target Groups -->
            <div t-if="kmitl_project.target_ids">
                <h5>กลุ่มเป้าหมาย</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>รายละเอียด</th>
                            <th>จำนวน</th>
                            <th>หน่วย</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="kmitl_project.target_ids" t-as="target">
                            <tr>
                                <td><span t-field="target.name"/></td>
                                <td><span t-field="target.quantity"/></td>
                                <td><span t-field="target.unit"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Participants -->
            <div t-if="kmitl_project.participant_ids">
                <h5>ผู้เข้าร่วม</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>รายละเอียด</th>
                            <th>จำนวน</th>
                            <th>หน่วย</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="kmitl_project.participant_ids" t-as="participant">
                            <tr>
                                <td><span t-field="participant.name"/></td>
                                <td><span t-field="participant.quantity"/></td>
                                <td><span t-field="participant.unit"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Organizers -->
            <div t-if="kmitl_project.organizer_ids">
                <h5>ผู้จัดงาน</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>รายละเอียด</th>
                            <th>จำนวน</th>
                            <th>หน่วย</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="kmitl_project.organizer_ids" t-as="organizer">
                            <tr>
                                <td><span t-field="organizer.name"/></td>
                                <td><span t-field="organizer.quantity"/></td>
                                <td><span t-field="organizer.unit"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Outputs -->
            <div t-if="kmitl_project.output_ids">
                <h5>ผลผลิต</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>รายละเอียด</th>
                            <th>จำนวน</th>
                            <th>หน่วย</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="kmitl_project.output_ids" t-as="output">
                            <tr>
                                <td><span t-field="output.name"/></td>
                                <td><span t-field="output.quantity"/></td>
                                <td><span t-field="output.unit"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Outcomes -->
            <div t-if="kmitl_project.outcome_ids">
                <h5>ผลลัพธ์</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>รายละเอียด</th>
                            <th>จำนวน</th>
                            <th>หน่วย</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="kmitl_project.outcome_ids" t-as="outcome">
                            <tr>
                                <td><span t-field="outcome.name"/></td>
                                <td><span t-field="outcome.quantity"/></td>
                                <td><span t-field="outcome.unit"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Project Plans -->
            <div t-if="kmitl_project.plan_ids">
                <h5>แผนการดำเนินงานและแผนการใช้จ่ายงบประมาณ</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>กิจกรรม</th>
                            <th>ผู้รับผิดชอบ</th>
                            <th>ม.ค.</th>
                            <th>ก.พ.</th>
                            <th>มี.ค.</th>
                            <th>เม.ย.</th>
                            <th>พ.ค.</th>
                            <th>มิ.ย.</th>
                            <th>ก.ค.</th>
                            <th>ส.ค.</th>
                            <th>ก.ย.</th>
                            <th>ต.ค.</th>
                            <th>พ.ย.</th>
                            <th>ธ.ค.</th>
                            <th>งบประมาณ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="kmitl_project.plan_ids" t-as="plan">
                            <tr>
                                <td><span t-field="plan.name"/></td>
                                <td><span t-field="plan.responsible"/></td>
                                <td><t t-if="plan.m1">✓</t></td>
                                <td><t t-if="plan.m2">✓</t></td>
                                <td><t t-if="plan.m3">✓</t></td>
                                <td><t t-if="plan.m4">✓</t></td>
                                <td><t t-if="plan.m5">✓</t></td>
                                <td><t t-if="plan.m6">✓</t></td>
                                <td><t t-if="plan.m7">✓</t></td>
                                <td><t t-if="plan.m8">✓</t></td>
                                <td><t t-if="plan.m9">✓</t></td>
                                <td><t t-if="plan.m10">✓</t></td>
                                <td><t t-if="plan.m11">✓</t></td>
                                <td><t t-if="plan.m12">✓</t></td>
                                <td><span t-field="plan.budget" t-options='{"widget": "monetary", "display_currency": kmitl_project.company_id.currency_id}'/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Expected Outcomes -->
            <div t-if="kmitl_project.expected_outcome_ids">
                <h5>ผลที่คาดว่าจะได้รับ</h5>
                <ol>
                    <t t-foreach="kmitl_project.expected_outcome_ids" t-as="outcome">
                        <li><span t-field="outcome.name"/></li>
                    </t>
                </ol>
            </div>

            <!-- Evaluation -->
            <div t-if="kmitl_project.evaluation_ids">
                <h5>วิธีการ/เครื่องมือติดตามและประเมินผล</h5>
                <ul>
                    <t t-foreach="kmitl_project.evaluation_ids" t-as="eval">
                        <li><span t-field="eval.name"/></li>
                    </t>
                </ul>
            </div>
            <div t-if="kmitl_project.evaluation_detail">
                <p><strong>รายละเอียดการประเมินผล:</strong></p>
                <p style="white-space: pre-wrap;" t-field="kmitl_project.evaluation_detail"/>
            </div>

            <!-- Attachments -->
            <div t-if="kmitl_project.attachment_ids">
                <h5>เอกสารแนบ</h5>
                <ul>
                    <t t-foreach="kmitl_project.attachment_ids" t-as="attachment">
                        <li>
                            <a t-attf-href="/web/content/#{attachment.id}?download=true">
                                <span t-field="attachment.name"/>
                            </a>
                            (<span t-field="attachment.file_size"/> bytes)
                        </li>
                    </t>
                </ul>
            </div>
        </div>
    </template>
</odoo>