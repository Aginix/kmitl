<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home Page: Projects Counter -->
    <template
        id="portal_my_home"
        name="Show KMITL Projects"
        customize_show="True"
        inherit_id="portal.portal_my_home"
        priority="25"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">KMITL Projects</t>
                <t t-set="url" t-value="'/my/kmitl-projects'" />
                <t t-set="placeholder_count" t-value="'project_count'" />
            </t>
        </xpath>
    </template>

    <!-- Public Projects List View -->
    <template id="portal_public_projects" name="Public KMITL Projects">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">โครงการ</t>
            </t>

            <t t-if="not projects">
                <div class="alert alert-info">ยังไม่มีโครงการในระบบ</div>
            </t>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>รหัสโครงการ</th>
                            <th>ชื่อโครงการ</th>
                            <th>ปีงบประมาณ</th>
                            <th>หน่วยงาน</th>
                            <th>สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="projects" t-as="project">
                            <tr>
                                <td>
                                    <a t-attf-href="/project/#{project.id}">
                                        <span
                                            t-field="project.key"
                                            t-if="project.key"
                                        />
                                        <span t-else="">-</span>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/project/#{project.id}">
                                        <span t-field="project.name" />
                                    </a>
                                </td>
                                <td>
                                    <span
                                        t-field="project.account_fiscal_year_id.name"
                                        t-if="project.account_fiscal_year_id"
                                    />
                                    <span t-else="">-</span>
                                </td>
                                <td>
                                    <span
                                        t-field="project.department_id.name"
                                        t-if="project.department_id"
                                    />
                                    <span t-else="">-</span>
                                </td>
                                <td>
                                    <span t-field="project.state" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <!-- Projects List View -->
    <template id="portal_my_kmitl_projects" name="My KMITL Projects">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">KMITL Projects</t>
            </t>

            <t t-if="not projects">
                <div class="alert alert-info">ยังไม่มีโครงการในระบบ</div>
            </t>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>รหัสโครงการ</th>
                            <th>ชื่อโครงการ</th>
                            <th>ปีงบประมาณ</th>
                            <th>หน่วยงาน</th>
                            <th>สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="projects" t-as="project">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/kmitl-project/#{project.id}">
                                        <span
                                            t-field="project.key"
                                            t-if="project.key"
                                        />
                                        <span t-else="">-</span>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/kmitl-project/#{project.id}">
                                        <span t-field="project.name" />
                                    </a>
                                </td>
                                <td>
                                    <span
                                        t-field="project.account_fiscal_year_id.name"
                                        t-if="project.account_fiscal_year_id"
                                    />
                                    <span t-else="">-</span>
                                </td>
                                <td>
                                    <span
                                        t-field="project.department_id.name"
                                        t-if="project.department_id"
                                    />
                                    <span t-else="">-</span>
                                </td>
                                <td>
                                    <span t-field="project.state" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <!-- Project Detail View -->
    <template
        id="portal_my_kmitl_project"
        name="KMITL Project Portal Template"
        inherit_id="portal.portal_sidebar"
        primary="True"
    >
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="mt16">
                <t t-call="kmitl_project.kmitl_project_portal_content" />
            </div>
        </xpath>
    </template>

    <!-- Project Content Details -->
    <template id="kmitl_project_portal_content" name="KMITL Project Portal Content">
        <!-- <style>
            .required.form-label:after {
                content: " *";
                color: red;
            }
        </style> -->
        <div class="card mb-3">
            <div class="card-header">
                <t t-if="kmitl_project.project_type == 'project'">โครงการ/กิจกรรม</t>
                <t t-elif="kmitl_project.project_type == 'strategic_project'"
                    >โครงการยุทธศาสตร์</t
                >
            </div>

            <div class="card-body">
                <div class="row form-group mb-3">
                    <label for="name" class="form-label required col col-lg-2 text-end"
                        >รหัสโครงการ</label
                    >
                    <div class="col col-lg-9">
                        <span t-out="kmitl_project.key" />
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.name"
                        class="form-label required col col-lg-2 text-end"
                        >ชื่อโครงการ/กิจกรรม</label
                    >
                    <div class="col col-lg-9">
                        <div
                            id="kmitl_project.name"
                            class="form-control text-bg-light input-block-level"
                            style="white-space: pre-wrap"
                            t-out="kmitl_project.name"
                        />
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label for="name" class="form-label required col col-lg-2 text-end"
                        >ปีงบประมาณ</label
                    >
                    <div class="col col-lg-9">
                        <span t-out="kmitl_project.account_fiscal_year_id.name" />
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label for="name" class="form-label required col col-lg-2 text-end"
                        >ประเภทโครงการ</label
                    >
                    <div class="col col-lg-9">
                        <span t-out="kmitl_project.project_type" />
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label for="name" class="form-label required col col-lg-2 text-end"
                        >หน่วยงาน</label
                    >
                    <div class="col col-lg-9">
                        <span t-out="kmitl_project.department_id.complete_name" />
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label for="name" class="form-label required col col-lg-2 text-end"
                        >ความสอดคล้องกับนโยบายสถาบัน</label
                    >
                    <div class="col col-lg-9">
                        <dt>Impact</dt>
                        <dd>
                            <span t-out="kmitl_project.impact_id.name" />
                        </dd>
                        <dt>Global Index</dt>
                        <dd>
                            <span t-out="kmitl_project.global_index_id.name" />
                        </dd>
                        <dt>FIGHT</dt>
                        <dd>
                            <span t-out="kmitl_project.fight_id.name" />
                        </dd>
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label for="name" class="form-label required col col-lg-2 text-end"
                        >ความสอดคล้องกับแผนยุทธศาสตร์</label
                    >
                    <div class="col col-lg-9">
                        <dl>
                            <dt>ยุทธศาสตร์ชาติ</dt>
                            <dd>
                                <span
                                    t-field="kmitl_project.national_strategy_id.name"
                                />
                            </dd>
                            <dt>แผนแม่บทภายใต้ยุทธศาสตร์ชาติ</dt>
                            <dd>
                                <span t-field="kmitl_project.master_plan_id.name" />
                            </dd>
                            <dt>แผนพัฒนาเศรษฐกิจและสังคมแห่งชาติ</dt>
                            <dd>
                                <span t-field="kmitl_project.nesdc_plan_id.name" />
                            </dd>
                            <dt>แผนกลยุทธ์สถาบัน</dt>
                            <dd>
                                <span t-field="kmitl_project.kmitl_plan_id.name" />
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">งบประมาณ</div>

            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label required"
                        >แผนการดำเนินงานและแผนการใช้จ่ายงบประมาณ</label
                    >
                    <table class="table table-sm table-light table-bordered">
                        <thead>
                            <tr>
                                <th>ชื่อรายการ</th>
                                <th style="min-width: 120px; max-width: 200px">
                                    งบประมาณ
                                </th>
                                <th class="text-center" style="width: 50px">ม.ค.</th>
                                <th class="text-center" style="width: 50px">ก.พ.</th>
                                <th class="text-center" style="width: 50px">มี.ค.</th>
                                <th class="text-center" style="width: 50px">เม.ย.</th>
                                <th class="text-center" style="width: 50px">พ.ค.</th>
                                <th class="text-center" style="width: 50px">มิ.ย.</th>
                                <th class="text-center" style="width: 50px">ก.ค.</th>
                                <th class="text-center" style="width: 50px">ส.ค.</th>
                                <th class="text-center" style="width: 50px">ก.ย.</th>
                                <th class="text-center" style="width: 50px">ต.ค.</th>
                                <th class="text-center" style="width: 50px">พ.ย.</th>
                                <th class="text-center" style="width: 50px">ธ.ค.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="kmitl_project.plan_ids" t-as="plan">
                                <tr>
                                    <td>
                                        <span t-field="plan.name" />
                                    </td>
                                    <td>
                                        <span t-field="plan.amount" />
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m1">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m2">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m3">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m4">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m5">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m6">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m7">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m8">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m9">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m10">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m11">✓</t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="plan.m12">✓</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">รายละเอียดโครงการ/กิจกรรม</div>

            <div class="card-body">
                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.manager_id"
                        class="form-label required col col-lg-2 text-end"
                        >หัวหน้าโครงการ</label
                    >
                    <div class="col col-lg-9">
                        <span id="kmitl_project.manager_id"
                            ><t t-out="kmitl_project.manager_id.name"
                        /></span>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.state"
                        class="form-label required col col-lg-2 text-end"
                        >สถานะการดำเนินโครงการ</label
                    >
                    <div class="col col-lg-9">
                        <div
                            class="btn-group"
                            role="group"
                            aria-label="Basic radio toggle button group"
                        >
                            <label
                                t-attf-class="btn btn-{{ 'success' if kmitl_project.state == 'complete' else 'outline-secondary' }}"
                                for="complete"
                                >แล้วเสร็จ</label
                            >
                            <label
                                t-attf-class="btn btn-{{ 'success' if kmitl_project.state == 'in_progress' else 'outline-secondary' }}"
                                for="in_progress"
                                >กำลังดำเนินการ</label
                            >
                            <label
                                t-attf-class="btn btn-{{ 'success' if kmitl_project.state == 'on_hold' else 'outline-secondary' }}"
                                for="on_hold"
                                >ชะลอ</label
                            >
                            <label
                                t-attf-class="btn btn-{{ 'success' if kmitl_project.state == 'new' else 'outline-secondary' }}"
                                for="new"
                                >ยังไม่เริ่มดำเนินการ</label
                            >
                            <label
                                t-attf-class="btn btn-{{ 'success' if kmitl_project.state == 'cancel' else 'outline-secondary' }}"
                                for="cancel"
                                >ยกเลิก</label
                            >
                            <label
                                t-attf-class="btn btn-{{ 'primary' if kmitl_project.state == 'draft' else 'outline-secondary' }}"
                                for="draft"
                                >แบบร่าง</label
                            >
                        </div>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.date_start"
                        class="form-label required col col-lg-2 text-end"
                        >ระยะเวลาดำเนินโครงการ</label
                    >
                    <div class="col col-lg-9">
                        ตั้งแต่
                        <span
                            class="p-1 text-bg-secondary"
                            t-out="kmitl_project.date_start"
                        />
                        ถึง
                        <span
                            class="p-1 text-bg-secondary"
                            t-out="kmitl_project.date_end"
                        />
                    </div>
                </div>

                <!-- Introduction -->
                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.introduction"
                        class="form-label required col col-lg-2 text-end"
                        >หลักการและเหตุผล</label
                    >
                    <div class="col col-lg-9">
                        <div
                            id="kmitl_project.introduction"
                            class="form-control text-bg-light input-block-level"
                            style="white-space: pre-wrap"
                            t-out="kmitl_project.introduction"
                        />
                    </div>
                </div>

                <!-- Objectives -->
                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.objective"
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >วัตถุประสงค์</label
                    >
                    <div class="col col-lg-9">
                        <div
                            id="kmitl_project.objective"
                            class="form-control text-bg-light input-block-level"
                            style="white-space: pre-wrap"
                            t-out="kmitl_project.objective"
                        />
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.location"
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >สถานที่/พื้นที่ดำเนินโครงการ</label
                    >
                    <div class="col col-lg-9">
                        <div
                            id="kmitl_project.location"
                            class="form-control text-bg-light input-block-level"
                            style="white-space: pre-wrap"
                            t-out="kmitl_project.location"
                        />
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.methodology_ids"
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >วิธีดำเนินการ</label
                    >
                    <div class="col col-lg-9">
                        <t t-foreach="kmitl_project.methodology_ids" t-as="method">
                            <div>
                                <span t-field="method.name" />
                            </div>
                        </t>
                        <p
                            style="white-space: pre-wrap"
                            t-field="kmitl_project.methodology_detail"
                        />
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >กลุ่มเป้าหมาย</label
                    >
                    <div class="col col-lg-9">
                        <table class="table table-sm table-light w-75">
                            <thead>
                                <tr>
                                    <th>ชื่อกลุ่มเป้าหมาย</th>
                                    <th>จำนวน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t
                                    t-if="len(kmitl_project.target_ids) > 0"
                                    t-foreach="kmitl_project.target_ids"
                                    t-as="target"
                                >
                                    <tr>
                                        <td>
                                            <span t-field="target.name" />
                                        </td>
                                        <td>
                                            <span t-field="target.amount" />
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr colspan="3">
                                        ไม่มีข้อมูล
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >ผู้เข้าร่วม</label
                    >
                    <div class="col col-lg-9">
                        <table class="table table-sm table-light w-75">
                            <thead>
                                <tr>
                                    <th>ชื่อกลุ่มเป้าหมาย</th>
                                    <th>จำนวน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t
                                    t-if="len(kmitl_project.participant_ids) > 0"
                                    t-foreach="kmitl_project.participant_ids"
                                    t-as="participant_id"
                                >
                                    <tr>
                                        <td>
                                            <span t-field="participant_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="participant_id.amount" />
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr colspan="3">
                                        ไม่มีข้อมูล
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >ผู้จัดงาน</label
                    >
                    <div class="col col-lg-9">
                        <table class="table table-sm table-light w-75">
                            <thead>
                                <tr>
                                    <th>ชื่อกลุ่มเป้าหมาย</th>
                                    <th>จำนวน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t
                                    t-if="len(kmitl_project.organizer_ids) > 0"
                                    t-foreach="kmitl_project.organizer_ids"
                                    t-as="organizer_id"
                                >
                                    <tr>
                                        <td>
                                            <span t-field="organizer_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="organizer_id.amount" />
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr colspan="3">
                                        ไม่มีข้อมูล
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >ผลผลิต</label
                    >
                    <div class="col col-lg-9">
                        <t t-if="len(kmitl_project.output_ids) > 0">
                            <ul>
                                <li
                                    t-foreach="kmitl_project.output_ids"
                                    t-as="output_id"
                                >
                                    <t t-out="output_id.name" />
                                    <t t-out="output_id.amount" />
                                    <t t-out="output_id.unit" />
                                </li>
                            </ul>
                        </t>
                        <t t-else=""> ไม่มีข้อมูล </t>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >ผลลัพธ์</label
                    >
                    <div class="col col-lg-9">
                        <t t-if="len(kmitl_project.outcome_ids) > 0">
                            <ul>
                                <li
                                    t-foreach="kmitl_project.outcome_ids"
                                    t-as="outcome_id"
                                >
                                    <t t-out="outcome_id.name" />
                                    <t t-out="outcome_id.amount" />
                                    <t t-out="outcome_id.unit" />
                                </li>
                            </ul>
                        </t>
                        <t t-else=""> ไม่มีข้อมูล </t>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.expected_outcome_ids"
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >ผลที่คาดว่าจะได้รับ</label
                    >
                    <div class="col col-lg-9">
                        <ol id="kmitl_project.expected_outcome_ids">
                            <t
                                t-foreach="kmitl_project.expected_outcome_ids"
                                t-as="outcome"
                            >
                                <li>
                                    <span t-field="outcome.name" />
                                </li>
                            </t>
                        </ol>
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.evaluation_ids"
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >วิธีการ/เครื่องมือติดตามและประเมินผล</label
                    >
                    <div class="col col-lg-9">
                        <div
                            id="kmitl_project.evaluation_ids"
                            t-foreach="kmitl_project.evaluation_ids"
                            t-as="eval"
                        >
                            <div t-field="eval.name" />
                        </div>
                        <p
                            style="white-space: pre-wrap"
                            t-field="kmitl_project.evaluation_detail"
                        />
                    </div>
                </div>

                <div class="row form-group mb-3">
                    <label
                        for="kmitl_project.attachment_ids"
                        class="form-label required col col-lg-2 text-end"
                        style="white-space: pre-wrap"
                        >เอกสารแนบ</label
                    >
                    <div class="col col-lg-9">
                        <ul>
                            <t
                                t-foreach="kmitl_project.attachment_ids"
                                t-as="attachment"
                            >
                                <li>
                                    <a
                                        t-attf-href="/web/content/#{attachment.id}?download=true"
                                    >
                                        <span t-field="attachment.name" />
                                    </a>
                                    (<span t-field="attachment.file_size" />
                                    bytes)
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
