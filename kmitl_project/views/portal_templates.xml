<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="portal_my_kmitl_project"
        name="KMITL Project Portal Template"
        inherit_id="portal.portal_sidebar"
        primary="True"
    >
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="project.group_project_manager">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t
                        t-set="backend_url"
                        t-value="'/web#model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (kmitl_project._name, kmitl_project.id, kmitl_project.env.ref('kmitl_project.action_kmitl_project_all').id)"
                    />
                    <t t-set="custom_html">This is a preview of the KMITL project.</t>
                </t>
            </t>

            <div class="row mt16 o_portal_project_sidebar">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'" />
                </t>

                <!-- Page content -->
                <div id="project_content" class="col-12 col-lg justify-content-end">
                    <!-- main content -->
                    <div t-attf-class="card pb-5" id="portal_project_content">
                        <div t-call="kmitl_project.kmitl_project_portal_content"/>
                    </div>

                    <!-- chatter -->
                    <div id="kmitl_project_communication" class="mt-4">
                        <h2>History</h2>
                        <t t-call="portal.message_thread" />
                    </div>
                </div>
                <!-- // #project_content -->
            </div>
        </xpath>
    </template>

    <template id="kmitl_project_portal_content" name="Purchase Order Portal Content">
        <!-- Intro -->
        <div id="introduction" t-attf-class="pb-2 pt-3 card-header bg-white">
            <h2 class="my-0">
                <em t-esc="kmitl_project.name" />
            </h2>
        </div>
    </template>
</odoo>
