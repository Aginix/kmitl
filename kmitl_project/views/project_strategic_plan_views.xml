<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.strategic.plan View Tree -->
    <record id="view_project_strategic_plan_tree" model="ir.ui.view">
        <field name="name">view.project.strategic.plan.tree</field>
        <field name="model">project.strategic.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="hierarchy_level" optional="hide" />
                <field name="level" optional="hide" />
                <field name="parent_id" />
                <field name="deprecated" />
            </tree>
        </field>
    </record>

    <!-- View project.strategic.plan form -->
    <record id="view_project_strategic_plan_form" model="ir.ui.view">
        <field name="name">view.project.strategic.plan.form</field>
        <field name="model">project.strategic.plan</field>
        <field name="arch" type="xml">
            <form string="Project Strategic Plan">
                <field name="active" invisible="1" />
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_children_accounts" type="object" class="oe_stat_button" icon="fa-bars">
                            <field string="Sub plans" name="children_count" widget="statinfo" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}" />
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="parent_id" />
                            <field name="deprecated" />
                            <field name="note" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- View project.strategic.plan search -->
    <record id="view_project_strategic_plan_search" model="ir.ui.view">
        <field name="name">view.project.strategic.plan.search</field>
        <field name="model">project.strategic.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="parent_id" string="Parent Account" />
                <separator />
                <filter string="Top Level Accounts" name="top_level" domain="[('parent_id', '=', False)]" />
                <filter string="Child Accounts" name="child_accounts" domain="[('parent_id', '!=', False)]" />
                <separator />
                <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Archived" name="archived" domain="[('active', '=', False)]" />
                <filter string="Deprecated" name="deprecated" domain="[('deprecated', '=', True)]" />
                <group expand="1" name="group_by" string="Group By">
                    <filter string="Deprecated" name="deprecated" domain="[]" context="{'group_by':'deprecated'}"/>
                    <filter string="Parent" name="parent_id" domain="[]" context="{'group_by':'parent_id'}"/>
                </group>
                <searchpanel>
                    <field name="parent_id" string="Parent" icon="fa-sitemap" limit="0"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action project.strategic.plan -->
    <record id="action_project_strategic_plan" model="ir.actions.act_window">
        <field name="name">Project Strategic Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.strategic.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Strategic Plan.
            </p>
        </field>
    </record>

    <menuitem id="project_strategic_plan_config_menu" name="ความสอดคล้องกับยุทธศาสตร์" action="action_project_strategic_plan" parent="menu_project_config" sequence="10" />
</odoo>
