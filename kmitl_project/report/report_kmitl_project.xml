<odoo>
    <template id="report_kmitl_project">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.company_id.currency_id" />
                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        table.budget tr td:first-child {
                            width: 30%;
                        }
                        p,
                        span,
                        div {
                            font-size: 16pt;
                            line-height: 1.2;
                            margin-bottom: 0;
                        }
                        .item-title {
                          font-size: 16pt;
                          font-weight: bold;
                        }
                        .item-content {
                          padding-left: 16pt;
                        }
                        .content {
                          display: grid;
                          row-gap: 16pt;
                        }
                        .paragraph {
                          text-indent: 16pt;
                        }

                    </style>

                    <div class="page">
                        <div style="position: absolute; top: 0px; left: 0px">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 110px" alt="Logo"/>
                        </div>
                        <div style="position: absolute; top: 0px; right: 0px">
                            <div>แบบเสนอโครงการ</div>
                        </div>
                        <div class="oe_structure"/>
                        <div style="height: 1px"/>
                        <div class="page-header mt-5 mb-5">
                            <h3 class="text-center fw-bolder" style="line-height: 1.575">
                                แบบเสนอโครงการ ประจำปีงบประมาณ พ.ศ. <span t-field="o.account_fiscal_year_id"/> <br/>
                                <span>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</span>
                            </h3>
                            <h3>
                                <span t-field="o.source_analytic_id"/>
                            </h3>
                        </div>
                        <div class="content">
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">1. ชื่อโครงการ</div>
                                <p class="paragraph" t-out="o.name"/>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">2. หลักการและเหตุผล</div>
                                <p class="paragraph" t-out="o.introduction"/>
                              </div>
                          </div>
                          <!--<div class="row">-->
                          <!--    <div class="col-12">-->
                          <!--      <div class="item-title">3. ความสอดคล้องกับยุทธศาสตร์</div>-->

                          <!--    </div>-->
                          <!--</div>-->
                          <!--<div class="row">-->
                          <!--    <div class="col-12">-->
                          <!--      <div class="item-title">4. ความสอดคล้องกับนโยบายสถาบัน</div>-->
                          <!--    </div>-->
                          <!--</div>-->
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">3. ความสอดคล้องกับค่านิยม : FIGHT</div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">4. ด้าน/แผนงาน/กิจกรรม</div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">5. วัตถุประสงค์</div>
                                <p class="paragraph" t-out="o.objective"/>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">6. ผู้รับผิดชอบโครงการ</div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">7. สถานที่/พื้นที่ดำเนินโครงการ</div>
                                <p class="paragraph" t-out="o.location"/>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">8. ระยะเวลาดำเนินโครงการ</div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">9. วิธีดำเนินการ</div>
                                <div>
                                  <!--<p class="paragraph" t-out="o.methodology_ids"/>-->
                                  <p class="paragraph" t-out="o.methodology_detail"/>
                                </div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">10. กลุ่มเป้าหมาย/ผู้ดำเนินโครงการ</div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">11. เป้าหมาย ผลผลิต และผลลัพธ์ </div>
                                <div class="item-content">
                                  <table class="table table-bordered table-sm">
                                    <thead>
                                      <tr>
                                        <th style="width: 55%">ตัวชี้วัด</th>
                                        <th style="text-align: center;">หน่วยนับ</th>
                                        <th style="text-align: center; width: 120pt;">เป้าหมาย</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <tr>
                                        <td component="th" class="fw-bold">ผลผลิต (Output)</td>
                                        <td/>
                                        <td/>
                                      </tr>
                                      <tr t-foreach="o.output_ids" t-as="line">
                                        <td t-out="line.name"/>
                                        <td style="text-align: center;" t-out="line.unit"/>
                                        <td style="text-align: center;" t-out="line.amount"/>
                                      </tr>
                                      <tr>
                                        <td component="th" class="fw-bold">ผลลัพธ์ (Outcome)</td>
                                        <td/>
                                        <td/>
                                      </tr>
                                      <tr t-foreach="o.outcome_ids" t-as="line">
                                        <td t-out="line.name"/>
                                        <td style="text-align: center;" t-out="line.unit"/>
                                        <td style="text-align: center;" t-out="line.amount"/>
                                      </tr>
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">12. แผนการดำเนินงานและแผนการใช้จ่ายงบประมาณ  </div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">13. งบประมาณโครงการ</div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">14. ผลที่คาดว่าจะได้รับ</div>
                                <div class="item-content">
                                    <div t-foreach="o.expected_outcome_ids" t-as="line" t-out="line.name"/>
                                </div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">15. วิธีการ/เครื่องมือติดตามและประเมินผล</div>
                                <div class="item-content">
                                  <div t-foreach="o.evaluation_ids" t-as="line" t-out="line.name"/>
                                  <div>
                                    อื่น ๆ  <span t-out="o.evaluation_detail"/>
                                  </div>
                                </div>
                              </div>
                          </div>
                          <div class="row">
                              <div class="col-12">
                                <div class="item-title">16. เอกสารประกอบการพิจารณาโครงการ (Check List)</div>
                              </div>
                          </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
