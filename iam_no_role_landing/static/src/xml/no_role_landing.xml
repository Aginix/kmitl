<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="iam_no_role_landing.Landing" owl="1">
        <div class="o_no_role_landing">
            <t t-if="state.loading">
                <div class="d-flex align-items-center justify-content-center vh-100">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>
            <t t-else="">
                <Dialog
                    title="'บัญชีรอกำหนดสิทธิ์'"
                    size="'md'"
                    contentClass="'o_no_role_dialog_content'"
                >
                    <div class="text-center py-3">
                        <div class="mb-4">
                            <i class="fa fa-lock fa-3x text-muted" />
                        </div>
                        <h5 class="mb-2">บัญชีของคุณยังไม่ได้กำหนดสิทธิ์การใช้งาน</h5>
                        <p class="text-muted mb-1">
                            ยินดีต้อนรับ, <strong t-esc="state.userName" />
                        </p>
                        <p class="text-muted o_no_role_contact" t-esc="state.contactMessage" />
                    </div>
                    <t t-set-slot="footer">
                        <button
                            class="btn btn-primary"
                            t-on-click="onCheckRole"
                            t-att-disabled="state.checking"
                        >
                            <t t-if="state.checking">
                                <span class="spinner-border spinner-border-sm me-1" role="status" />
                            </t>
                            ตรวจสอบสิทธิ์
                        </button>
                        <button class="btn btn-secondary" t-on-click="onLogout">
                            ออกจากระบบ
                        </button>
                    </t>
                </Dialog>
            </t>
        </div>
    </t>
</templates>
