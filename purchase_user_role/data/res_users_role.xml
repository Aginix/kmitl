<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="purchase_role_procurement" model="res.users.role">
            <field name="name">เจ้าหน้าที่พัสดุหน่วยงาน</field>
            <field
                name="implied_ids"
                eval="[(6, 0, [
                ref('purchase_request_kmitl.group_purchase_request_user_all'),
                ref('purchase.group_purchase_user'),
                ref('account.group_account_invoice'),
            ])]"
            />
        </record>
        <record id="purchase_role_procurement_central" model="res.users.role">
            <field name="name">เจ้าหน้าที่พัสดุส่วนกลาง</field>
            <field
                name="implied_ids"
                eval="[(6, 0, [
                ref('purchase_request_kmitl.group_purchase_request_user_all'),
                ref('purchase.group_purchase_user'),
                ref('account.group_account_invoice'),
                ref('operating_unit_access_all.group_all_operating_unit'),
            ])]"
            />
        </record>
        <record id="purchase_role_procurement_admin" model="res.users.role">
            <field name="name">แอดมินเจ้าหน้าที่พัสดุ</field>
            <field
                name="implied_ids"
                eval="[(6, 0, [
                ref('purchase_request.group_purchase_request_manager'),
                ref('purchase.group_purchase_manager'),
                ref('account.group_account_invoice'),
                ref('operating_unit_access_all.group_all_operating_unit'),
                ref('purchase_manual_delivery_security.group_enable_incoming_shipment'),
            ])]"
            />
        </record>
    </data>
</odoo>
