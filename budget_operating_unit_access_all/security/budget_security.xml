<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="group_all_ou_budget" model="res.groups">
        <field name="name">Access all OUs' Budget</field>
        <field name="category_id" ref="operating_unit.module_operating_units" />
    </record>

    <function model="ir.rule" name="write">
        <value
            eval="[ref('budget_operating_unit.ir_rule_budget_move_allowed_operating_units'),
                   ref('budget_operating_unit.ir_rule_budget_move_line_allowed_operating_units'),
                   ref('budget_operating_unit.ir_rule_budget_transfer_allowed_operating_units'),
                   ref('budget_operating_unit.ir_rule_budget_transfer_line_allowed_operating_units'),
                   ref('budget_operating_unit.ir_rule_budget_commitment_allowed_operating_units'),
                   ref('budget_operating_unit.ir_rule_budget_commitment_line_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|',(1, '=', 1) if user.has_group('budget_operating_unit_access_all.group_all_ou_budget') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>

</odoo>
