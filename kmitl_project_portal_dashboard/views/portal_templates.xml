<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Dashboard Template -->
    <template id="portal_dashboard" name="KMITL Project Dashboard">
        <t t-call="portal.portal_layout">
            <div id="project_dashboard" class="container-fluid py-4">

                <!-- Header Row: Title + Fiscal Year Filter -->
                <div class="row mb-4 align-items-center">
                    <div class="col-md-8">
                        <h1 class="mb-0 dashboard-title">โครงการหน่วยงาน</h1>
                        <p class="text-muted mb-0">ภาพรวมโครงการ/กิจกรรม</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted">ปีที่ได้รับจัดสรร</label>
                        <select id="fiscal_year_filter" class="form-select">
                            <option value="">ทั้งหมด</option>
                            <t t-foreach="fiscal_years" t-as="fy">
                                <option t-att-value="fy.id"
                                        t-att-selected="str(fy.id) == str(current_fiscal_year_id) if current_fiscal_year_id else None">
                                    <t t-out="fy.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>

                <!-- Summary Cards Row -->
                <div class="row mb-4 g-3">
                    <!-- Total Projects Card -->
                    <div class="col-md-2">
                        <div class="card summary-card h-100">
                            <div class="card-body text-center">
                                <h6 class="card-subtitle text-muted mb-2">จำนวน</h6>
                                <h2 class="card-title mb-1 text-primary">
                                    <t t-out="summary.get('total_count', 0)"/>
                                </h2>
                                <small class="text-muted">โครงการ</small>
                            </div>
                        </div>
                    </div>

                    <!-- Budget Bar Chart Card -->
                    <div class="col-md-4">
                        <div class="card summary-card h-100">
                            <div class="card-body">
                                <h6 class="card-subtitle text-muted mb-2">งบประมาณตามหน่วยงาน</h6>
                                <canvas id="budgetBarChart" height="100"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Total Budget Card -->
                    <div class="col-md-2">
                        <div class="card summary-card h-100">
                            <div class="card-body text-center">
                                <h6 class="card-subtitle text-muted mb-2">งบประมาณได้รับจัดสรร</h6>
                                <h4 class="card-title mb-1 text-success">
                                    <t t-out="'{:,.0f}'.format(summary.get('total_budget', 0))"/>
                                </h4>
                                <small class="text-muted">บาท</small>
                            </div>
                        </div>
                    </div>

                    <!-- Trend Line Chart Card -->
                    <div class="col-md-2">
                        <div class="card summary-card h-100">
                            <div class="card-body">
                                <h6 class="card-subtitle text-muted mb-2">แนวโน้มรายเดือน</h6>
                                <canvas id="trendLineChart" height="70"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Completed Count Card -->
                    <div class="col-md-2">
                        <div class="card summary-card h-100">
                            <div class="card-body text-center">
                                <h6 class="card-subtitle text-muted mb-2">เสร็จสิ้นแล้ว</h6>
                                <h2 class="card-title mb-1 text-info">
                                    <t t-out="summary.get('completed_count', 0)"/>
                                </h2>
                                <small class="text-muted">โครงการ</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filter Bar: 4 Dimensions -->
                <div class="card filter-card mb-4">
                    <div class="card-body py-3">
                        <div class="row g-2 align-items-end">
                            <!-- Department Filter -->
                            <div class="col-md-3">
                                <label class="form-label small mb-1">หน่วยงาน</label>
                                <select id="department_filter" class="form-select form-select-sm">
                                    <option value="">ทั้งหมด</option>
                                    <t t-foreach="departments" t-as="dept">
                                        <option t-att-value="dept.id"
                                                t-att-selected="str(dept.id) == str(current_department_id) if current_department_id else None">
                                            [<t t-out="dept.code"/>] <t t-out="dept.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Activity Filter -->
                            <div class="col-md-3">
                                <label class="form-label small mb-1">ด้าน/แผนงาน/กิจกรรม</label>
                                <select id="activity_filter" class="form-select form-select-sm">
                                    <option value="">ทั้งหมด</option>
                                    <t t-foreach="activities" t-as="act">
                                        <option t-att-value="act.id"
                                                t-att-selected="str(act.id) == str(current_activity_id) if current_activity_id else None">
                                            [<t t-out="act.code"/>] <t t-out="act.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Fund Filter -->
                            <div class="col-md-3">
                                <label class="form-label small mb-1">กองทุน</label>
                                <select id="fund_filter" class="form-select form-select-sm">
                                    <option value="">ทั้งหมด</option>
                                    <t t-foreach="funds" t-as="fund">
                                        <option t-att-value="fund.id"
                                                t-att-selected="str(fund.id) == str(current_fund_id) if current_fund_id else None">
                                            [<t t-out="fund.code"/>] <t t-out="fund.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Source Filter -->
                            <div class="col-md-3">
                                <label class="form-label small mb-1">แหล่งเงิน</label>
                                <select id="source_filter" class="form-select form-select-sm">
                                    <option value="">ทั้งหมด</option>
                                    <t t-foreach="sources" t-as="src">
                                        <option t-att-value="src.id"
                                                t-att-selected="str(src.id) == str(current_source_id) if current_source_id else None">
                                            [<t t-out="src.code"/>] <t t-out="src.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Legend -->
                <div class="mb-3">
                    <t t-call="kmitl_project_portal_dashboard.status_legend"/>
                </div>

                <!-- Table Header: Title + Tabs + Search -->
                <div class="card">
                    <div class="card-header bg-primary text-white py-2">
                        <strong>โครงการหน่วยงานที่ได้รับจัดสรรงบประมาณ</strong>
                    </div>
                    <div class="card-body pb-0">
                        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                            <!-- Tab Filters -->
                            <ul class="nav nav-tabs border-0" id="stateTabs">
                                <t t-foreach="states" t-as="s">
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{'active' if current_state == s[0] else ''}"
                                           href="#"
                                           t-att-data-state="s[0]"
                                           onclick="setTab(this.dataset.state); return false;">
                                            <t t-out="s[1]"/>
                                            <t t-if="s[0] == 'all'">
                                                <span class="badge bg-secondary ms-1">
                                                    <t t-out="projects_count"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary ms-1">
                                                    <t t-out="status_counts.get(s[0], 0)"/>
                                                </span>
                                            </t>
                                        </a>
                                    </li>
                                </t>
                            </ul>

                            <!-- Search -->
                            <div class="d-flex mt-2 mt-md-0">
                                <input type="text" id="search_input"
                                       class="form-control form-control-sm me-2"
                                       placeholder="ค้นหาโครงการ..."
                                       t-att-value="current_search"
                                       style="width: 220px;"/>
                                <button class="btn btn-primary btn-sm" onclick="applyFilters()">
                                    <i class="fa fa-search"/> ค้นหา
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="table-responsive">
                        <t t-call="kmitl_project_portal_dashboard.project_table"/>
                    </div>
                </div>

                <!-- Pagination -->
                <t t-if="total_pages > 1">
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center mb-0">
                            <li t-attf-class="page-item #{'disabled' if page == 1 else ''}">
                                <a class="page-link" href="#"
                                   t-att-onclick="'goToPage(%d); return false;' % (page - 1)">
                                    <i class="fa fa-chevron-left"/>
                                </a>
                            </li>
                            <t t-foreach="range(1, total_pages + 1)" t-as="p">
                                <t t-if="p == 1 or p == total_pages or (p >= page - 2 and p &lt;= page + 2)">
                                    <li t-attf-class="page-item #{'active' if p == page else ''}">
                                        <a class="page-link" href="#"
                                           t-att-onclick="'goToPage(%d); return false;' % p">
                                            <t t-out="p"/>
                                        </a>
                                    </li>
                                </t>
                                <t t-elif="p == page - 3 or p == page + 3">
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                </t>
                            </t>
                            <li t-attf-class="page-item #{'disabled' if page == total_pages else ''}">
                                <a class="page-link" href="#"
                                   t-att-onclick="'goToPage(%d); return false;' % (page + 1)">
                                    <i class="fa fa-chevron-right"/>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </t>

            </div>

            <!-- Chart Data for JavaScript -->
            <script type="text/javascript">
                var chartData = <t t-out="chart_data" t-options="{'widget': 'raw'}"/>;
            </script>
        </t>
    </template>

    <!-- Status Legend Sub-template -->
    <template id="status_legend" name="Status Legend">
        <div class="d-flex flex-wrap gap-3 status-legend">
            <span class="legend-item">
                <span class="legend-dot bg-secondary"></span>
                Draft (<t t-out="status_counts.get('draft', 0)"/>)
            </span>
            <span class="legend-item">
                <span class="legend-dot bg-info"></span>
                ยังไม่เริ่ม (<t t-out="status_counts.get('new', 0)"/>)
            </span>
            <span class="legend-item">
                <span class="legend-dot bg-primary"></span>
                กำลังดำเนินการ (<t t-out="status_counts.get('in_progress', 0)"/>)
            </span>
            <span class="legend-item">
                <span class="legend-dot bg-warning"></span>
                ระงับชั่วคราว (<t t-out="status_counts.get('on_hold', 0)"/>)
            </span>
            <span class="legend-item">
                <span class="legend-dot bg-success"></span>
                เสร็จสิ้น (<t t-out="status_counts.get('complete', 0)"/>)
            </span>
            <span class="legend-item">
                <span class="legend-dot bg-danger"></span>
                ยกเลิก (<t t-out="status_counts.get('cancel', 0)"/>)
            </span>
        </div>
    </template>

    <!-- Project Table Sub-template -->
    <template id="project_table" name="Project Table">
        <table class="table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;" class="text-center">#</th>
                    <th>ชื่อโครงการ</th>
                    <th style="width: 200px;">หน่วยงาน</th>
                    <th style="width: 140px;" class="text-end">งบประมาณ</th>
                    <th style="width: 130px;" class="text-center">สถานะ</th>
                    <th style="width: 150px;">ความคืบหน้า</th>
                </tr>
            </thead>
            <tbody>
                <t t-if="projects">
                    <t t-foreach="projects" t-as="project">
                        <tr>
                            <td class="text-center text-muted">
                                <t t-out="(page - 1) * per_page + project_index + 1"/>
                            </td>
                            <td>
                                <a t-attf-href="/my/kmitl-project/#{project.id}" class="text-decoration-none">
                                    <strong t-out="project.name"/>
                                </a>
                                <t t-if="project.key">
                                    <div class="text-muted small">
                                        <t t-out="project.key"/>
                                    </div>
                                </t>
                            </td>
                            <td class="small">
                                <t t-out="project.department_analytic_id.name or project.department_id.name or '-'"/>
                            </td>
                            <td class="text-end">
                                <t t-set="project_budget" t-value="sum(p.amount for p in project.plan_ids)"/>
                                <strong t-out="'{:,.0f}'.format(project_budget)"/>
                            </td>
                            <td class="text-center">
                                <t t-call="kmitl_project_portal_dashboard.status_badge">
                                    <t t-set="state" t-value="project.state"/>
                                </t>
                            </td>
                            <td>
                                <t t-set="avg_progress" t-value="sum(p.percentage for p in project.plan_ids) / len(project.plan_ids) if project.plan_ids else 0"/>
                                <t t-call="kmitl_project_portal_dashboard.progress_bar">
                                    <t t-set="progress" t-value="avg_progress"/>
                                    <t t-set="state" t-value="project.state"/>
                                </t>
                            </td>
                        </tr>
                    </t>
                </t>
                <t t-else="">
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa fa-folder-open fa-3x mb-3 d-block opacity-50"/>
                            ไม่พบโครงการที่ตรงกับเงื่อนไขการค้นหา
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <!-- Status Badge Sub-template -->
    <template id="status_badge" name="Status Badge">
        <span t-if="state == 'draft'" class="badge bg-secondary">Draft</span>
        <span t-elif="state == 'new'" class="badge bg-info">ยังไม่เริ่ม</span>
        <span t-elif="state == 'in_progress'" class="badge bg-primary">กำลังดำเนินการ</span>
        <span t-elif="state == 'on_hold'" class="badge bg-warning text-dark">ระงับชั่วคราว</span>
        <span t-elif="state == 'complete'" class="badge bg-success">เสร็จสิ้น</span>
        <span t-elif="state == 'cancel'" class="badge bg-danger">ยกเลิก</span>
    </template>

    <!-- Progress Bar Sub-template -->
    <template id="progress_bar" name="Progress Bar">
        <div class="progress" style="height: 20px;">
            <t t-set="bar_class" t-value="'bg-success' if state == 'complete' else ('bg-danger' if state == 'cancel' else 'bg-primary')"/>
            <div t-attf-class="progress-bar #{bar_class}"
                 role="progressbar"
                 t-attf-style="width: #{int(progress)}%"
                 t-att-aria-valuenow="int(progress)"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <t t-out="'{:.0f}%'.format(progress)"/>
            </div>
        </div>
    </template>
</odoo>
