<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View stock.request form -->
    <record id="view_stock_request_form" model="ir.ui.view">
        <field name="name">view.stock.request.form</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request_aginix.view_stock_request_form"/>
        <field name="arch" type="xml">
            <button name="action_reset" position="after">
              <field name="rejected" invisible="1" />
              <field name="validation_status" invisible="1" />
              <field name="need_validation" invisible="1" />
              <field name="can_request" invisible="1" />
              <button
                  name="request_validation"
                  string="Request Validation"
                  class="btn-primary"
                  attrs="{'invisible': ['|', '|', '|', '|',
                        ('need_validation', '!=', True),
                        ('validation_status', '=', 'pending'),
                        ('rejected', '=', True),
                        ('state', '!=', 'submitted'),
                        ('can_request','=',False)
                    ]}"
                  type="object"
              />

              <button
                  name="restart_validation"
                  string="Restart Validation"
                  class="btn-primary"
                  attrs="{'invisible': ['|', '|',
                        ('need_validation', '!=', True),
                        ('validation_status', '!=', 'pending'),
                        ('can_request','=',False)
                    ]}"
                  type="object"
              />
            </button>
            <xpath expr="//field[@name='state']" position="after">
              <field name="validation_status" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_approved']" position="replace">
                <button name="action_approved" 
                        string="Approved" 
                        type="object" 
                        groups="stock_request_aginix.group_stock_request_approver"
                        attrs="{'invisible': ['|', ('state', '!=', 'submitted'), ('validation_status', '!=', 'validated')]}"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['submitted']), ('validation_status', '!=', 'rejected')]}</attribute>
            </xpath>
        </field>
    </record>

  </odoo>