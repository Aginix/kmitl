<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="advance_payment_partner_bank_wizard_form" model="ir.ui.view">
        <field name="name">advance.payment.partner.bank.wizard.form</field>
        <field name="model">advance.payment.partner.bank.wizard</field>
        <field name="arch" type="xml">
            <form string="สร้างบัญชีธนาคาร">
                <p class="text-muted">
                    ตรวจสอบข้อมูลกับสำเนาสมุดบัญชีธนาคาร (Book Bank) และแก้ไขได้ก่อนบันทึก
                    หากผู้ยืมมีบัญชีเลขเดียวกันอยู่แล้ว ระบบจะใช้บัญชีเดิม
                </p>
                <group>
                    <field name="advance_payment_id" invisible="1" />
                    <field name="partner_id" options="{'no_open': True}" />
                    <field name="book_bank_filename" invisible="1" />
                    <field
                        name="book_bank_file"
                        filename="book_bank_filename"
                        readonly="1"
                    />
                    <field
                        name="bank_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="acc_number" />
                    <field name="acc_holder_name" />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="บันทึก"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
