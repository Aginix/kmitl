<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_advance_payment_form_partner_bank" model="ir.ui.view">
        <field name="name">advance.payment.form.partner_bank</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">
            <!-- Next to the declared account, not in the header: it fixes
                 data, it is no workflow step. Shown even once bank_id is set,
                 to re-point it after the borrower changed the account. -->
            <field name="book_bank_file" position="after">
                <div
                    colspan="2"
                    attrs="{'invisible': ['|', '|', ('state', '!=', 'to_verify'), ('use_unlisted_bank', '=', False), ('can_verify', '=', False)]}"
                    groups="advance_payment.group_advance_payment_loan_officer"
                >
                    <button
                        name="action_open_partner_bank_wizard"
                        string="สร้างบัญชีธนาคาร"
                        type="object"
                        class="btn-link ps-0"
                        icon="fa-university"
                        attrs="{'invisible': [('bank_id', '!=', False)]}"
                    />
                    <button
                        name="action_open_partner_bank_wizard"
                        string="สร้าง/เปลี่ยนบัญชีจากข้อมูลที่แจ้ง"
                        type="object"
                        class="btn-link ps-0"
                        icon="fa-university"
                        attrs="{'invisible': [('bank_id', '=', False)]}"
                    />
                </div>
            </field>
        </field>
    </record>
</odoo>
