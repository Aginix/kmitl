<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      <record id="view_work_acceptance_form_inherit_disbursement" model="ir.ui.view">
          <field name="name">work.acceptance.form.inherit.disbursement</field>
          <field name="model">work.acceptance</field>
          <field name="inherit_id" ref="purchase_work_acceptance.view_work_acceptance_form"/>
          <field name="arch" type="xml">
              <xpath expr="//field[@name='partner_id']" position="after">
                  <field name="is_disbursed" readonly="1"/>
                  <field name="disbursement_request_id"
                      readonly="1"
                      attrs="{'invisible': [('disbursement_request_id', '=', False)]}"/>
              </xpath>
              <!-- Return-to-source correction: Confirm button + statusbar + fields -->
              <xpath expr="//header//field[@name='state']" position="before">
                  <button name="action_confirm_correction" type="object" string="Confirm Correction" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'returned')]}"/>
                  <button
                      name="action_force_mark_disbursed"
                      type="object"
                      string="Force Mark Disbursed"
                      attrs="{'invisible': ['|', ('state', '!=', 'accept'), ('is_disbursed', '=', True)]}"
                      groups="base.group_erp_manager"
                  />
              </xpath>
              <xpath expr="//header//field[@name='state']" position="attributes">
                  <attribute name="statusbar_visible">draft,in_review,accept</attribute>
              </xpath>
              <xpath expr="//header" position="after">
                  <div class="alert alert-warning" role="alert" attrs="{'invisible': [('state', '!=', 'returned')]}">
                      <p><strong>Returned for correction.</strong> The disbursement officer returned the linked disbursement request. Correct the payee bank account and note and/or attach evidence below, then click <b>Confirm Correction</b>.</p>
                  </div>
              </xpath>
              <xpath expr="//sheet" position="inside">
                  <group name="disbursement_correction" string="Disbursement Correction" attrs="{'invisible': [('state', '!=', 'returned')]}">
                      <field name="disbursement_return_bank_id" domain="[('partner_id', '=', partner_id)]" options="{'no_create': True}"/>
                      <field name="disbursement_return_note"/>
                      <field name="disbursement_return_attachment_ids" widget="many2many_binary"/>
                  </group>
              </xpath>
          </field>
      </record>

      <record id="view_work_acceptance_tree_inherit_disbursement" model="ir.ui.view">
          <field name="name">work.acceptance.tree.inherit.disbursement</field>
          <field name="model">work.acceptance</field>
          <field name="inherit_id" ref="purchase_work_acceptance.view_work_acceptance_tree"/>
          <field name="arch" type="xml">
              <xpath expr="//tree" position="inside">
                  <field name="is_disbursed" optional="show"/>
                  <field name="disbursement_request_id" optional="hide"/>
              </xpath>
          </field>
      </record>
  </odoo>
