<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      <record id="view_disbursement_request_form_inherit_wa" model="ir.ui.view">
          <field name="name">disbursement.request.form.inherit.wa</field>
          <field name="model">disbursement.request</field>
          <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
          <field name="arch" type="xml">
              <xpath expr="//div[@name='button_box']" position="before">
                  <field name="wa_ids" invisible="1"/>
                  <field name="wa_count" invisible="1"/>
              </xpath>
              <xpath expr="//div[@name='button_box']" position="inside">
                  <button name="action_view_work_acceptances"
                      type="object"
                      class="oe_stat_button"
                      string="WA"
                      icon="fa-clipboard"
                      attrs="{'invisible': [('wa_count', '=', 0)]}">
                  </button>
              </xpath>
              <xpath expr="//field[@name='amount_untaxed']" position="attributes">
                  <attribute name="invisible">1</attribute>
              </xpath>
              <xpath expr="//field[@name='amount_total']" position="attributes">
                  <attribute name="invisible">1</attribute>
              </xpath>
              <xpath expr="//field[@name='amount_untaxed']" position="after">
                  <field name="fines_total" />
                  <field name="fines_total" string="Value Before Tax"/>
              </xpath>
          </field>
      </record>
  </odoo>
