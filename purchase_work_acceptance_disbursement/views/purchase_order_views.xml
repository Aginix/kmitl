<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order form -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="wa_fines_total"/>
            </xpath>
        </field>
    </record>

    <!-- Block creating a new WA while an accepted WA is still pending disbursement -->
    <record id="view_po_form_inherit_wa_disbursement" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.wa.disbursement</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_work_acceptance_invoice_plan.purchase_order_form_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='%(purchase_work_acceptance_invoice_plan.action_view_wa_installment)d']" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', '|', '|',
                        ('use_invoice_plan', '=', False),
                        ('state', 'not in', ('purchase', 'done')),
                        ('wa_accepted', '=', True),
                        ('pending_wa_count', '>', 0)
                    ]}
                </attribute>
            </xpath>

            <xpath expr="//button[@name='action_view_wa']" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', '|', '|',
                        ('use_invoice_plan', '=', True),
                        ('state', 'not in', ('purchase', 'done')),
                        ('wa_accepted', '=', True),
                        ('pending_wa_count', '>', 0)
                    ]}
                </attribute>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="pending_wa_count" invisible="1"/>
            </xpath>

        </field>
    </record>

  </odoo>