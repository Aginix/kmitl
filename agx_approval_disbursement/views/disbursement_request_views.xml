<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form.approval</field>
        <field name="model">disbursement.request</field>
        <field
            name="inherit_id"
            ref="disbursement.view_disbursement_request_form"
        />
        <field name="arch" type="xml">
            <!-- The "returned to source" banner and the hide-Return-when-returned
                 behaviour are now generic (base disbursement view + assignment
                 view, keyed on returned_to_source). -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="approval_request_id" invisible="1" />
                <button
                    name="action_view_approval_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-check-circle"
                    string="Approval"
                    attrs="{'invisible': [('approval_request_id', '=', False)]}"
                />
            </xpath>
            <xpath expr="//group[@name='attachment']" position="after">
                <group name="approval_attachment" string="หลักฐานจากใบขออนุมัติ"
                    attrs="{'invisible': [('approval_attachment_ids', '=', [])]}">
                    <field name="approval_attachment_ids" nolabel="1" colspan="2"
                        widget="many2many_binary" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
