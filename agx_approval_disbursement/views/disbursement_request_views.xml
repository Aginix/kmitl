<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form.approval</field>
        <field name="model">disbursement.request</field>
        <field
            name="inherit_id"
            ref="disbursement.view_disbursement_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <field name="returned_to_approval" invisible="1" />
                <div class="alert alert-warning" role="alert" style="margin-bottom:0px;"
                    attrs="{'invisible': [('returned_to_approval', '=', False)]}">
                    <strong>Returned:</strong>
                    <span>This disbursement request was returned to its approval request for a corrected version.</span>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="approval_request_id" invisible="1" />
                <button
                    name="action_view_approval_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-check-circle"
                    string="Approval"
                    attrs="{'invisible': [('approval_request_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
