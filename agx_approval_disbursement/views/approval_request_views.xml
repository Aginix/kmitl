<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_bill']" position="before">
                <field name="has_active_disbursement" invisible="1" />
                <button
                    name="action_create_disbursement_request"
                    string="สร้างใบขอเบิก"
                    type="object"
                    class="oe_highlight"
                    groups="disbursement.group_disbursement_user"
                    attrs="{'invisible': [('state', '!=', 'to_disburse')]}"
                />
            </xpath>
            <xpath expr="//header/button[@name='action_bill']" position="attributes">
                <attribute name="string">ตั้งเบิกครบแล้ว</attribute>
                <attribute name="class">btn btn-secondary</attribute>
                <attribute name="groups">disbursement.group_disbursement_user</attribute>
                <attribute name="confirm">ยืนยันว่าตั้งเบิกครบแล้ว? หลังจากนี้จะสร้างใบขอเบิกเพิ่มไม่ได้ (งบที่เหลือคืนจองได้ที่ใบจองงบประมาณ)</attribute>
                <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'to_disburse'), ('has_active_disbursement', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_pull_back_from_finance']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'to_disburse'), ('has_active_disbursement', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disbursement_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_request_count"
                        widget="statinfo"
                        string="Disbursements"
                    />
                </button>
            </xpath>
            <xpath expr="//field[@name='total_actual_amount']" position="after">
                <field name="disbursed_amount" widget="monetary"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}" />
            </xpath>
            <xpath expr="//page[@name='actual_expenses']" position="inside">
                <group name="attachment_for_disbursement" string="เอกสารแนบสำหรับการเบิก"
                    attrs="{'invisible': [('state', 'not in', ['approved', 'to_disburse', 'billed'])]}">
                    <field name="disbursement_attachment_ids"
                        widget="many2many_binary_disbursement"
                        attrs="{'readonly': [('state', '!=', 'approved')]}">
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
