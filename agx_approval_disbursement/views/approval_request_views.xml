<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_to_verify']" position="after">
                <field name="has_active_disbursement" invisible="1" />
                <button
                    name="action_ready_to_bill"
                    string="Confirm Ready to Bill"
                    type="object"
                    class="oe_highlight"
                    groups="agx_approval.group_approval_user"
                    attrs="{'invisible': ['|', '|', ('state', '!=', 'approved'), ('payment_type', 'not in', ['direct', 'prepaid']), ('has_active_disbursement', '=', True)]}"
                />
                <button
                    name="action_create_disbursement_request"
                    string="Create Bill"
                    type="object"
                    class="oe_highlight"
                    groups="disbursement.group_disbursement_user"
                    attrs="{'invisible': ['|', ('state', '!=', 'ready_to_bill'), ('has_active_disbursement', '=', True)]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disbursement_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_request_count"
                        widget="statinfo"
                        string="Disbursements"
                    />
                </button>
            </xpath>
            <xpath expr="//group[@name='attachment']" position="after">
                <group name="attachment_for_disbursement" string="Attachment for Disbursement"
                    attrs="{'invisible': [('state', 'not in', ['approved', 'ready_to_bill', 'billed'])]}">
                    <field name="disbursement_attachment_ids"
                        widget="many2many_binary"
                        attrs="{'readonly': [('disbursement_request_count', '>', 0)]}">
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="approval_request_view_tree" model="ir.ui.view">
        <field name="name">approval.request.view.tree.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="disbursement_request_ids" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
