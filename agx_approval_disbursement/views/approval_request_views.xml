<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning" role="alert" style="margin-bottom:0px;"
                    attrs="{'invisible': [('is_correction', '=', False)]}">
                    <p><strong>ตีกลับจากการเบิก:</strong> คำขอนี้ถูกตีกลับจากใบเบิก แก้ไขบัญชีผู้รับเงิน คำอธิบาย หรือหลักฐานการเบิก แล้วกด "ยืนยันการแก้ไข"</p>
                </div>
            </xpath>
            <xpath expr="//header/field[@name='is_correction']" position="after">
                <field name="has_active_disbursement" invisible="1" />
            </xpath>
            <xpath expr="//header/button[@name='action_bill']" position="attributes">
                <attribute name="name">action_create_disbursement_request</attribute>
                <attribute name="groups">disbursement.group_disbursement_user</attribute>
                <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'to_disburse'), ('has_active_disbursement', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="after">
                <button
                    name="action_confirm_correction"
                    string="ยืนยันการแก้ไข"
                    type="object"
                    class="oe_highlight"
                    groups="agx_approval.group_approval_user"
                    attrs="{'invisible': [('is_correction', '=', False)]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disbursement_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_request_count"
                        widget="statinfo"
                        string="Disbursements"
                    />
                </button>
            </xpath>
            <xpath expr="//page[@name='actual_expenses']" position="inside">
                <group name="attachment_for_disbursement" string="เอกสารแนบสำหรับการเบิก"
                    attrs="{'invisible': [('state', 'not in', ['approved', 'to_disburse', 'billed', 'returned'])]}">
                    <field name="disbursement_attachment_ids"
                        widget="many2many_binary_disbursement"
                        attrs="{'readonly': ['&amp;', ('disbursement_request_count', '>', 0), ('is_correction', '=', False)]}">
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="approval_request_view_tree" model="ir.ui.view">
        <field name="name">approval.request.view.tree.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="disbursement_request_ids" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
