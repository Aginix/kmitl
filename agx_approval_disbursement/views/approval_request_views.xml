<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_to_verify']" position="after">
                <button
                    name="action_create_disbursement_request"
                    string="Create Bill"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('state', '!=', 'approved')]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disbursement_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_request_count"
                        widget="statinfo"
                        string="Disbursements"
                    />
                </button>
            </xpath>
            <xpath expr="//group[@name='attachment']/field[@name='attachment_ids']" position="attributes">
                <attribute name="context">{'default_res_model': 'approval.request', 'default_is_disbursement_evidence': False}</attribute>
            </xpath>
            <xpath expr="//group[@name='attachment']" position="after">
                <group string="Attachment for Disbursement"
                    attrs="{'invisible': [('state', '!=', 'approved')]}">
                    <field name="disbursement_attachment_ids"
                        context="{'default_res_model': 'approval.request', 'default_is_disbursement_evidence': True}"
                        widget="many2many_binary">
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="approval_request_view_tree" model="ir.ui.view">
        <field name="name">approval.request.view.tree.disbursement</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval.approval_request_view_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="billing_status" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
