<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="disbursement_type_wizard_view_form" model="ir.ui.view">
        <field name="name">disbursement.type.wizard.form</field>
        <field name="model">disbursement.type.wizard</field>
        <field name="arch" type="xml">
            <form string="เลือกประเภทการจ่ายเงิน">
                <field name="approval_request_id" invisible="1"/>
                <field name="can_direct" invisible="1"/>
                <field name="can_prepaid" invisible="1"/>
                <field name="can_advance" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    1 ใบเบิก สร้างได้ 1 ประเภทการจ่ายเงินเท่านั้น กรุณาเลือกประเภทที่ต้องการสร้างใบเบิก
                    — สร้างครบทุกประเภทได้โดยกดปุ่ม "สร้างใบเบิก" ซ้ำ
                </div>
                <footer>
                    <button
                        name="action_confirm_direct"
                        string="สร้างใบเบิก: จ่ายตรง"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('can_direct', '=', False)]}"
                    />
                    <button
                        name="action_confirm_prepaid"
                        string="สร้างใบเบิก: สำรองจ่าย"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('can_prepaid', '=', False)]}"
                    />
                    <button
                        name="action_confirm_advance"
                        string="สร้างใบเบิก: เงินยืม"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('can_advance', '=', False)]}"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
