msgstr "ตีกลับได้เฉพาะใบที่อยู่ระหว่างหมวดตรวจ (สถานะ signed) เท่านั้น"

#. module: agx_approval_disbursement
#. odoo-python
#: code:addons/agx_approval_disbursement/models/disbursement_request.py:0
#, python-format
msgid ""
"This request was returned to its approval request. Please wait for the "
"corrected approval to be confirmed before validating."
msgstr ""
"ใบขอเบิกนี้ถูกตีกลับไปยังคำขออนุมัติ กรุณารอการยืนยันการแก้ไขคำขออนุมัติก่อนจึงจะตรวจสอบได้"

#. module: agx_approval_disbursement
#. odoo-python
#: code:addons/agx_approval_disbursement/models/disbursement_request.py:0
#, python-format
msgid "Returned to approval request: %s"
msgstr "ตีกลับไปคำขออนุมัติ: %s"

#. module: agx_approval_disbursement
#. odoo-python
#: code:addons/agx_approval_disbursement/models/disbursement_request.py:0
#, python-format
msgid ""
"<p><b>Returned for correction</b></p><p>Disbursement <b>%(dr)s</b> was "
"returned by the verification officer.<br/>Reason: <b>%(reason)s</b><br/>"
"Please correct the payee bank, description or disbursement evidence, then "
"click <b>Confirm Correction</b>.</p>"
msgstr ""
"<p><b>ถูกตีกลับเพื่อแก้ไข</b></p><p>ใบขอเบิก <b>%(dr)s</b> "
"ถูกตีกลับโดยเจ้าหน้าที่ตรวจสอบ<br/>เหตุผล: <b>%(reason)s</b><br/>"
"กรุณาแก้ไขเลขบัญชีผู้รับเงิน คำอธิบาย หรือหลักฐานส่งเบิก "
"แล้วกด <b>ยืนยันการแก้ไข</b></p>"

#. module: agx_approval_disbursement
#: model:mail.activity.type,name:agx_approval_disbursement.mail_activity_ar_correct
msgid "Correct and confirm the returned approval request"
msgstr "แก้ไขและยืนยันคำขออนุมัติที่ถูกตีกลับ"

#. module: agx_approval_disbursement
#: model:mail.activity.type,name:agx_approval_disbursement.mail_activity_dr_await
msgid "Disbursement returned - awaiting approval correction"
msgstr "ใบขอเบิกถูกตีกลับ - รอการแก้ไขคำขออนุมัติ"

#. module: agx_approval_disbursement
#: model:mail.activity.type,name:agx_approval_disbursement.mail_activity_dr_continue
msgid "Approval corrected - continue verification"
msgstr "คำขออนุมัติแก้ไขแล้ว - ดำเนินการตรวจสอบต่อ"

#. module: agx_approval_disbursement
#: model:mail.activity.type,name:agx_approval_disbursement.mail_activity_ar_done
msgid "Correction submitted to the disbursement officer"
msgstr "ส่งการแก้ไขให้เจ้าหน้าที่เบิกจ่ายแล้ว"

#. module: agx_approval_disbursement
#. odoo-python
#: code:addons/agx_approval_disbursement/models/disbursement_request.py:0
#, python-format
msgid ""
"Approval correction applied: payee bank, description and evidence updated. "
"Please continue verification."
msgstr ""
"ปรับตามการแก้ไขคำขออนุมัติแล้ว: เลขบัญชีผู้รับเงิน คำอธิบาย และหลักฐานถูกอัปเดต "
"กรุณาดำเนินการตรวจสอบต่อ"

#. module: agx_approval_disbursement
#: model_terms:ir.ui.view,arch_db:agx_approval_disbursement.approval_request_view_form
msgid ""
"<strong>Returned:</strong> This request was returned from its disbursement. "
"Correct the payee bank, description or disbursement evidence, then click "
"Confirm Correction."
msgstr ""
"<strong>ถูกตีกลับ:</strong> คำขอนี้ถูกตีกลับจากใบขอเบิก "
"กรุณาแก้ไขเลขบัญชีผู้รับเงิน คำอธิบาย หรือหลักฐานส่งเบิก แล้วกดยืนยันการแก้ไข"

#. module: agx_approval_disbursement
#: model_terms:ir.ui.view,arch_db:agx_approval_disbursement.view_disbursement_request_form
msgid ""
"<strong>Returned:</strong> This disbursement request was returned to its "
"approval request for correction."
msgstr ""
"<strong>ถูกตีกลับ:</strong> ใบขอเบิกนี้ถูกตีกลับไปยังคำขออนุมัติเพื่อแก้ไข"
