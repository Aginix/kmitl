<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <field name="hide_reserve_budget_button" invisible="1" />
                    <field name="is_plan_editable" invisible="1"/>
                    <field name="is_actual_editable" invisible="1"/>
                    <field name="is_correction" invisible="1"/>
                    <button name="action_to_verify" string="Submit request" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="action_reserve_budget" type="object" attrs="{'invisible':[('hide_reserve_budget_button', '=', True)]}" string="Reserve Budget" class="oe_highlight btn-success" groups="budget.group_budget_commitment" />
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['to_send', 'sent'])]}" groups="agx_approval.group_approval_manager"/>
                    <button name="action_record_actual" string="Record Actual Expense" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'approved')]}" />
                    <button name="action_bill" string="Submit for Disbursement" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'actual')]}" />
                    <button name="%(agx_approval.action_report_disbursement_voucher)d" type="action" string="Print Disbursement Voucher Cover" class="btn btn-secondary" attrs="{'invisible': [('state', 'not in', ['actual', 'billed'])]}" />
                    <button name="action_open_pull_back_wizard" string="Pull Back" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', 'not in', ['to_verify', 'to_send'])]}"/>
                    <button name="action_cancel" string="Cancel / Reject" type="object" attrs="{'invisible': [('state', 'not in', ['to_verify', 'to_send', 'approved'])]}" groups="agx_approval.group_approval_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_verify,to_send,sent,approved,actual,billed" />
                </header>
                <div class="alert alert-danger" role="alert" style="margin-bottom:0px;" attrs="{'invisible': [('exceptions_summary', '=', False)]}">
                    <p>
                        <strong>Exception:</strong>
                    </p>
                    <field name="exceptions_summary"/>
                </div>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_budget_commitment" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible':[('budget_commitment_id','=',False)]}">
                            <field name="budget_commitment_id" invisible="1"/>
                            <div class="o_stat_info">
                                <span>Budget</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group name="approval_details" string="Request Details">
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="account_fiscal_year_id" readonly="1" options="{'no_open': True}" />
                            <field name="id" invisible="1" />
                            <field name="category_id" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_open': True}" />
                            <field name="owner_id" widget="employee_detail_many2one" attrs="{'readonly': [('is_plan_editable', '=', False)]}" />
                            <field name="user_id" readonly="1" />
                            <field name="has_period" invisible="1" />
                            <field name="has_city" invisible="1" />
                            <field name="has_country_id" invisible="1" />
                            <field name="period_type" widget="radio" options="{'horizontal': True}" attrs="{'invisible': [('has_period', '!=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            <label for="date_start" string="Period" attrs="{'invisible': [('has_period', '!=', True)]}"/>
                            <div class="o_row" attrs="{'invisible': [('has_period', '!=', True)]}">
                                <field name="date_start" nolabel="1" class="oe_inline" attrs="{'required': [('has_period', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                                <i class="fa fa-long-arrow-right mx-2" attrs="{'invisible': [('period_type', '!=', 'range')]}" aria-label="Arrow icon" title="Arrow"/>
                                <field name="date_end" nolabel="1" class="oe_inline" attrs="{'invisible': [('period_type', '!=', 'range')], 'required': [('period_type', '=', 'range')], 'readonly': [('is_plan_editable', '=', False)]}"/>
                                <field name="day_portion" widget="radio" options="{'horizontal': True}" nolabel="1" class="oe_inline ms-3" attrs="{'invisible': [('period_type', '!=', 'single')], 'required': [('period_type', '=', 'single')], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            </div>
                            <field name="city" attrs="{'invisible': [('has_city', '!=', True)], 'required': [('has_city', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            <field name="country_id" attrs="{'invisible': [('has_country_id', '!=', True)], 'required': [('has_country_id', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                        <label for="description" string="Description" attrs="{'readonly': [('is_plan_editable', '=', False)]}"/>
                        <field name="description" attrs="{'readonly': [('is_plan_editable', '=', False)]}" colspan="2" nolabel="1"/>
                    </group>
                    <group name="attachment" string="Attachments">
                        <field name="attachment_ids" attrs="{'readonly': [('is_plan_editable','=', False)]}" context="{'default_res_model': 'approval.request'}" widget="many2many_binary">
                        </field>
                    </group>
                    <!-- The reserved commitment, however it came to be: reserved by
                         this request or drawn from an existing slip. Shown to everyone
                         once a slip exists — users without budget.group_budget_commitment
                         never see the selection UI below, but they must still see the
                         ใบจองงบประมาณ their request ended up with. -->
                    <group name="budget_commitment_info_group" string="รหัสงบประมาณ"
                        attrs="{'invisible': [('budget_commitment_id', '=', False)]}">
                        <field name="budget_commitment_state" invisible="1"/>
                        <field name="budget_commitment_id" colspan="2" nolabel="1"
                            widget="budget_commitment_info" readonly="1"
                            options="{'no_create': True, 'no_open': True}"
                            invisible="1"/>
                    </group>
                    <!-- Budget selection UI: reserved to budget officers. Users without
                         budget.group_budget_commitment never see this group nor its
                         heading — they only see the reserved commitment above. -->
                    <group name="budget" string="Budget"
                        groups="budget.group_budget_commitment">
                        <field name="is_budget_editable" invisible="1"/>
                        <!-- Ask which way first, then show only that way's fields.
                             The mode is a UI affordance: the server still keys
                             draw-down off reservation_commitment_id (ADR-0010). Each
                             branch also stays visible whenever its own value is
                             already set, so a record can never hide the thing that
                             actually drives the reserve action. -->
                        <field name="budget_selection_mode" colspan="2"
                            widget="radio" options="{'horizontal': True}"
                            attrs="{'invisible': [('is_budget_editable', '=', False)]}"/>

                        <field name="allowed_reservation_commitment_ids" invisible="1"/>
                        <field name="reservation_commitment_id" colspan="2"
                            widget="budget_commitment_info"
                            domain="[('id', 'in', allowed_reservation_commitment_ids)]"
                            options="{'no_create': True, 'no_open': True}"
                            attrs="{'invisible': ['|', '&amp;', ('budget_selection_mode', '!=', 'reservation'), ('reservation_commitment_id', '=', False), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')], 'readonly': [('is_budget_editable', '=', False)]}"
                            placeholder="เลือกใบจองงบประมาณที่จะหยิบไปใช้"/>

                        <button name="action_open_reservation_picker" type="object"
                            string="เลือกงบประมาณจากผังงบ (ดูยอดคงเหลือ)"
                            class="btn btn-primary mb-2" icon="fa-sitemap" colspan="2"
                            attrs="{'invisible': ['|', '|', ('is_budget_editable', '=', False), ('reservation_commitment_id', '!=', False), ('budget_selection_mode', '!=', 'chart')]}"/>
                        <!-- Only while budget is still being chosen from the chart:
                             once reserved the same values are in the card above, and
                             under the reservation mode they come from the slip. -->
                        <field name="budget_account_id" readonly="1" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" attrs="{'invisible': ['|', ('budget_selection_mode', '!=', 'chart'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"/>
                        <field name="activity_analytic_id" readonly="1" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" attrs="{'invisible': ['|', ('budget_selection_mode', '!=', 'chart'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"/>
                        <field name="department_analytic_id" readonly="1" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" attrs="{'invisible': ['|', ('budget_selection_mode', '!=', 'chart'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"/>
                        <field name="fund_analytic_id" widget="selection" readonly="1" attrs="{'invisible': ['|', ('budget_selection_mode', '!=', 'chart'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"/>
                        <field name="source_analytic_id" widget="selection" readonly="1" attrs="{'invisible': ['|', ('budget_selection_mode', '!=', 'chart'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"/>
                        <field name="account_fiscal_year_id" readonly="1" options="{'no_open': True}" attrs="{'invisible': ['&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"/>
                        <field name="analytic_distribution" invisible="1"/>
                    </group>
                    <separator string="Planned Expenses"/>
                    <field name="line_ids" widget="no_open_readonly_x2many" attrs="{'readonly': [('is_plan_editable', '=', False)]}">
                        <tree editable="bottom">
                            <field name="allowed_product_ids" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="total_amount" sum="Total"/>
                        </tree>
                    </field>
                    <separator string="Participants"/>
                    <field name="participant_ids" widget="no_open_readonly_x2many" attrs="{'readonly': [('is_plan_editable', '=', False)]}">
                        <tree editable="bottom">
                            <field name="allowed_partner_type_ids" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="partner_id"/>
                            <field name="description"/>
                        </tree>
                    </field>
                    <div attrs="{'invisible': [('state', 'not in', ['approved','actual','billed'])]}">
                        <separator string="Actual Expenses"/>
                        <field name="allocation_ids" widget="allocation_grouped" attrs="{'readonly': ['&amp;', ('is_actual_editable', '=', False), ('is_correction', '=', False)]}">
                            <tree editable="bottom" default_order="partner_id">
                                <field name="allowed_recipient_ids" invisible="1"/>
                                <field name="allowed_product_ids" invisible="1"/>
                                <field name="sequence" widget="handle"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="partner_id" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="product_id" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="description" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="payment_type" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="amount" sum="Total" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="partner_bank_id" options="{'no_create': True, 'no_create_edit': True}" attrs="{'readonly': ['&amp;', ('parent.is_actual_editable', '=', False), ('parent.is_correction', '=', False)]}"/>
                            </tree>
                        </field>
                        <group class="oe_subtotal_footer oe_right">
                            <field name="total_actual_amount" widget="monetary"/>
                        </group>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="approval_request_view_tree" model="ir.ui.view">
        <field name="name">approval.request.view.tree</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <tree string="Approval Request" decoration-danger="main_exception_id != False">
                <field name="name" />
                <field name="create_date" />
                <field name="category_id" />
                <field name="owner_id" />
                <field name="user_id" string="Created by" optional="hide" />
                <field name="date" optional="hide" />
                <field name="account_fiscal_year_id" options="{'no_open': True}" optional="hide" />
                <field name="total_amount" sum="Total" optional="show"/>
                <field name="main_exception_id" invisible="1"/>
                <field name="exception_ids" widget="many2many_tags" string="Exceptions" optional="show"/>
                <field name="state" widget="badge" decoration-success="state in ('billed', 'approved')" decoration-muted="state == 'draft'" decoration-warning="state in ('to_verify', 'to_send', 'sent')" decoration-info="state == 'actual'" decoration-danger="state in ('rejected', 'returned')"/>
            </tree>
        </field>
    </record>

    <record id="approval_request_view_search" model="ir.ui.view">
        <field name="name">approval.request.view.search</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Request">
                <field name="name" />
                <field name="category_id" />
                <field name="account_fiscal_year_id" />
                <field name="owner_id" />
                <separator />
                <filter name="my_request" string="My Requests" domain="[('owner_id.user_id','=', uid)]" />
                <filter name="created_by_me" string="Created by Me" domain="[('user_id','=', uid)]" />
                <separator />
                <filter name="current_fy" string="ปีงบประมาณปัจจุบัน"
                    domain="[('account_fiscal_year_id.date_from', '&lt;=', context_today()), ('account_fiscal_year_id.date_to', '&gt;=', context_today())]" />
                <separator />
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="filter_to_verify" string="To Verify / Reserve Budget" domain="[('state', '=', 'to_verify')]" />
                <filter name="filter_submitted" string="To Send" domain="[('state', '=', 'to_send')]" />
                <filter name="filter_sent" string="Sent" domain="[('state', '=', 'sent')]" />
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]" />
                <filter name="filter_actual" string="Actual Recorded" domain="[('state', '=', 'actual')]" />
                <filter name="filter_billed" string="Billed" domain="[('state', '=', 'billed')]" />
                <filter name="filter_returned" string="Returned" domain="[('state', '=', 'returned')]" />
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]" />
                <separator />
                <filter name="filter_exception" string="Has Exception" domain="[('main_exception_id', '!=', False)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_fy" string="Fiscal Year" context="{'group_by': 'account_fiscal_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- "My Request" menu: same list as Approval Request but pre-filtered to
         the acting user's own requests. -->
    <record id="action_approval_my_request" model="ir.actions.act_window">
        <field name="name">My Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_my_request': 1}</field>
    </record>

</odoo>
