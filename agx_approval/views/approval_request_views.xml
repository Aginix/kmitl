<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <field name="hide_reserve_budget_button" invisible="1" />
                    <field name="is_editable" invisible="1"/>
                    <field name="is_plan_editable" invisible="1"/>
                    <field name="is_actual_editable" invisible="1"/>
                    <field name="is_correction" invisible="1"/>
                    <button name="action_to_verify" string="ตรวจสอบ / จองงบประมาณ" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="action_reserve_budget" type="object" attrs="{'invisible':[('hide_reserve_budget_button', '=', True)]}" string="Reserve Budget" class="oe_highlight btn-success" groups="budget.group_budget_commitment" />
                    <button name="action_approve" string="อนุมัติ" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['submitted', 'sent'])]}" groups="agx_approval.group_approval_manager"/>
                    <button name="action_record_actual" string="บันทึกค่าใช้จ่ายจริง" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'approved')]}" />
                    <button name="action_bill" string="ส่งเบิก" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'actual')]}" />
                    <button name="%(agx_approval.action_report_disbursement_voucher)d" type="action" string="พิมพ์งบหน้าใบสำคัญคู่จ่าย" class="btn btn-secondary" attrs="{'invisible': [('state', 'not in', ['actual', 'billed'])]}" />
                    <button name="action_open_pull_back_wizard" string="ดึงกลับ" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', 'not in', ['to_verify', 'submitted'])]}"/>
                    <button name="action_cancel" string="ยกเลิก / ปฏิเสธ" type="object" attrs="{'invisible': [('state', 'not in', ['to_verify', 'submitted', 'approved'])]}" groups="agx_approval.group_approval_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_verify,submitted,sent,approved,actual,billed" />
                </header>
                <div class="alert alert-danger" role="alert" style="margin-bottom:0px;" attrs="{'invisible': [('exceptions_summary', '=', False)]}">
                    <p>
                        <strong>Exception:</strong>
                    </p>
                    <field name="exceptions_summary"/>
                </div>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_budget_commitment" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible':[('budget_commitment_id','=',False)]}">
                            <field name="budget_commitment_id" invisible="1"/>
                            <div class="o_stat_info">
                                <span>Budget</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group name="approval_details" string="รายละเอียดคำขอ">
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="id" invisible="1" />
                            <field name="category_id" attrs="{'readonly': [('id', '!=', False)]}" />
                            <field name="owner_id" widget="employee_detail_many2one" attrs="{'readonly': [('is_plan_editable', '=', False)]}"/>
                            <field name="user_id" readonly="1"/>
                            <field name="has_period" invisible="1" />
                            <field name="has_city" invisible="1" />
                            <field name="has_country_id" invisible="1" />
                            <label for="date_start" string="Period" attrs="{'invisible': [('has_period', '!=', True)]}"/>
                            <div class="o_row" attrs="{'invisible': [('has_period', '!=', True)]}">
                                <field name="date_start" widget="daterange" nolabel="1" class="oe_inline" options="{'related_end_date': 'date_end'}" attrs="{'invisible': [('has_period', '!=', True)], 'required': [('has_period', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                <field name="date_end" widget="daterange" nolabel="1" class="oe_inline" options="{'related_start_date': 'date_start'}" attrs="{'invisible': [('has_period', '!=', True)], 'required': [('has_period', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            </div>
                            <field name="city" attrs="{'invisible': [('has_city', '!=', True)], 'required': [('has_city', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            <field name="country_id" attrs="{'invisible': [('has_country_id', '!=', True)], 'required': [('has_country_id', '=', True)], 'readonly': [('is_plan_editable', '=', False)]}"/>
                            <field name="description" attrs="{'readonly': [('is_plan_editable', '=', False)]}"/>
                        </group>
                    </group>
                    <group name="attachment" string="เอกสารแนบ">
                        <field name="attachment_ids" attrs="{'readonly': [('is_editable','=', False)]}" context="{'default_res_model': 'approval.request'}" widget="many2many_binary">
                        </field>
                    </group>
                    <group name="budget" string="งบประมาณ">
                        <div colspan="2" class="alert alert-success my-2" role="alert" attrs="{'invisible': [('budget_commitment_id', '=', False)]}">
                            <i class="fa fa-check-circle me-1" title="Budget Reserved"/>
                            <strong>Budget Reserved:</strong>
                            <field name="budget_commitment_id" readonly="1" nolabel="1" class="oe_inline ms-1"/>
                            <span class="mx-1">—</span>
                            <field name="budget_commitment_amount" readonly="1" nolabel="1" widget="monetary" class="oe_inline"/>
                            <span class="ms-1">฿</span>
                        </div>
                        <field name="is_budget_editable" invisible="1"/>
                        <button name="action_open_reservation_picker" type="object"
                            string="เลือกงบจากผังงบประมาณ (ดูยอดคงเหลือ)"
                            class="btn btn-primary mb-2" icon="fa-sitemap" colspan="2"
                            attrs="{'invisible': [('is_budget_editable', '=', False)]}"/>
                        <field name="budget_account_id" readonly="1" attrs="{'required': [('state', '=', 'to_verify')]}" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"/>
                        <field name="activity_analytic_id" readonly="1" attrs="{'required': [('state', '=', 'to_verify')]}" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"/>
                        <field name="department_analytic_id" readonly="1" attrs="{'required': [('state', '=', 'to_verify')]}" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"/>
                        <field name="fund_analytic_id" widget="selection" readonly="1" attrs="{'required': [('state', '=', 'to_verify')]}"/>
                        <field name="source_analytic_id" widget="selection" readonly="1" attrs="{'required': [('state', '=', 'to_verify')]}"/>
                        <field name="account_fiscal_year_id" readonly="1" options="{'no_open': True}"/>
                        <field name="analytic_distribution" invisible="1"/>
                    </group>
                    <separator string="ค่าใช้จ่าย (แผน)"/>
                    <field name="line_ids" attrs="{'readonly': [('is_plan_editable', '=', False)]}">
                        <tree editable="bottom">
                            <field name="allowed_product_ids" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="total_amount" sum="รวม"/>
                        </tree>
                    </field>
                    <separator string="รายชื่อ"/>
                    <field name="participant_ids" attrs="{'readonly': [('is_plan_editable', '=', False)]}">
                        <tree editable="bottom">
                            <field name="allowed_partner_type_ids" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="partner_id"/>
                            <field name="description"/>
                        </tree>
                    </field>
                    <div attrs="{'invisible': [('state', 'not in', ['actual', 'billed', 'returned'])]}">
                        <separator string="ค่าใช้จ่ายจริง"/>
                        <field name="allocation_ids" widget="allocation_grouped" attrs="{'readonly': ['&amp;', ('is_actual_editable', '=', False), ('is_correction', '=', False)]}">
                            <tree editable="bottom" default_order="partner_id">
                                <field name="allowed_recipient_ids" invisible="1"/>
                                <field name="allowed_product_ids" invisible="1"/>
                                <field name="sequence" widget="handle"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="partner_id" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="product_id" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="description" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="payment_type" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="amount" sum="รวม" attrs="{'readonly': [('parent.is_actual_editable', '=', False)]}"/>
                                <field name="partner_bank_id" options="{'no_create': True, 'no_create_edit': True}" attrs="{'readonly': ['&amp;', ('parent.is_actual_editable', '=', False), ('parent.is_correction', '=', False)]}"/>
                                <field name="bank_id"/>
                            </tree>
                        </field>
                        <group class="oe_subtotal_footer oe_right">
                            <field name="total_actual_amount" widget="monetary"/>
                        </group>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="approval_request_view_tree" model="ir.ui.view">
        <field name="name">approval.request.view.tree</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <tree string="Approval Request">
                <field name="name" />
                <field name="date" />
                <field name="category_id" />
                <field name="owner_id" />
                <field name="account_fiscal_year_id" options="{'no_open': True}" />
                <field name="total_amount" sum="รวม" optional="show"/>
                <field name="state" widget="badge" decoration-success="state in ('billed', 'approved')" decoration-muted="state == 'draft'" decoration-warning="state in ('to_verify', 'submitted', 'sent')" decoration-info="state == 'actual'" decoration-danger="state in ('rejected', 'returned')"/>
            </tree>
        </field>
    </record>

    <record id="approval_request_view_search" model="ir.ui.view">
        <field name="name">approval.request.view.search</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Request">
                <field name="name" />
                <field name="category_id" />
                <field name="account_fiscal_year_id" />
                <field name="owner_id" />
                <filter name="filter_draft" string="ร่าง" domain="[('state', '=', 'draft')]" />
                <filter name="filter_to_verify" string="รอตรวจสอบ/จองงบ" domain="[('state', '=', 'to_verify')]" />
                <filter name="filter_submitted" string="รอส่งขออนุมัติ" domain="[('state', '=', 'submitted')]" />
                <filter name="filter_sent" string="ส่งขออนุมัติแล้ว" domain="[('state', '=', 'sent')]" />
                <filter name="filter_approved" string="อนุมัติแล้ว" domain="[('state', '=', 'approved')]" />
                <filter name="filter_actual" string="บันทึกจริง" domain="[('state', '=', 'actual')]" />
                <filter name="filter_billed" string="เบิกแล้ว" domain="[('state', '=', 'billed')]" />
                <filter name="filter_returned" string="ตีกลับ" domain="[('state', '=', 'returned')]" />
                <filter name="filter_rejected" string="ปฏิเสธ" domain="[('state', '=', 'rejected')]" />
                <separator />
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_category" string="ประเภท" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_fy" string="ปีงบประมาณ" context="{'group_by': 'account_fiscal_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
