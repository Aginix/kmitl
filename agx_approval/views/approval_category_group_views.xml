<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_category_group_view_form" model="ir.ui.view">
        <field name="name">approval.category.group.view.form</field>
        <field name="model">approval.category.group</field>
        <field name="arch" type="xml">
            <form string="Approval Category Group">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="approval_category_group_view_tree" model="ir.ui.view">
        <field name="name">approval.category.group.view.tree</field>
        <field name="model">approval.category.group</field>
        <field name="arch" type="xml">
            <tree string="Approval Category Group" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="approval_category_group_view_search" model="ir.ui.view">
        <field name="name">approval.category.group.view.search</field>
        <field name="model">approval.category.group</field>
        <field name="arch" type="xml">
            <search string="Approval Category Group">
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="action_approval_category_group" model="ir.actions.act_window">
        <field name="name">Approval Category Group</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.category.group</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
