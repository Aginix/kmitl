<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="update_actual_amount_wizard_view_form" model="ir.ui.view">
        <field name="name">approval.update.actual.amount.wizard.form</field>
        <field name="model">approval.update.actual.amount.wizard</field>
        <field name="arch" type="xml">
            <form string="Update actual amount">
                <field name="approval_request_id" invisible="1"/>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="approval_line_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="partner_id" readonly="1" options="{'no_open': True}"/>
                        <field name="product_id" readonly="1" options="{'no_open': True}"/>
                        <field name="total_amount" readonly="1" sum="Total"/>
                        <field name="actual_amount" sum="Total"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
