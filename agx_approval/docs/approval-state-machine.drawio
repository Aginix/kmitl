        <!-- Sarabun engine + outcomes -->
        <mxCell id="sarabun" value="e-Saraban engine (agx_sarabun)&#10;เห็นชอบ / ลงนาม-อนุมัติ · ตีกลับ · ปฏิเสธ&#10;ดึงกลับ (ผู้ส่ง) · ยกเลิกการส่ง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;dashed=1;" vertex="1" parent="1"><mxGeometry x="730" y="360" width="300" height="66" as="geometry" /></mxCell>
        <mxCell id="rejected" value="&lt;b&gt;rejected&lt;/b&gt; · ปฏิเสธ (terminal)&lt;br&gt;&lt;i&gt;_on_sarabun_rejected&lt;/i&gt; · ปลดจองงบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="452" width="250" height="48" as="geometry" /></mxCell>
        <mxCell id="returned" value="&lt;b&gt;returned&lt;/b&gt; · ตีกลับ&lt;br&gt;&lt;i&gt;_on_sarabun_returned / _recalled&lt;/i&gt;&lt;br&gt;(หรือ DR ตีกลับหลังเบิก)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="556" width="250" height="72" as="geometry" /></mxCell>

        <!-- Notes -->
        <mxCell id="note_nopaytype" value="&lt;b&gt;draft = เสนอแผน&lt;/b&gt; (หน้าเดียว):&#10;ค่าใช้จ่าย(แผน) + รายชื่อ&#10;ไม่มี &#39;ประเภทการจ่าย&#39; — ยืมเงิน/สำรองจ่าย&#10;เป็น action หลัง approved (รายคน)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="290" height="82" as="geometry" /></mxCell>
        <mxCell id="note_pullback" value="&lt;b&gt;ดึงกลับ (AR — ก่อนส่งสารบรรณ)&lt;/b&gt; [D1]&#10;เฉพาะ to_verify / submitted → draft&#10;confirm wizard + ปลดจองงบ&#10;(คนละตัวกับ ดึงกลับ ของ e-Saraban)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="note_actual" value="&lt;b&gt;ค่าใช้จ่ายจริง&lt;/b&gt; (inline, จัดกลุ่มรายผู้รับเงิน):&#10;ผู้รับเงิน(จากรายชื่อ)/รายการ/จำนวนเงิน/บัญชี&#10;1 แถว = 1 บรรทัด DR (multi-partner)&#10;→ งบหน้าใบสำคัญคู่จ่าย PDF (WHT รายคน)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="310" height="84" as="geometry" /></mxCell>
        <mxCell id="note_returned" value="&lt;b&gt;returned = state เดียว, 2 ที่มา&lt;/b&gt; [D2/D3]&#10;• สารบรรณตีกลับ (ก่อนอนุมัติ): แก้ได้ทุกอย่างยกเว้นงบ → ส่งสารบรรณใหม่&#10;• DR ตีกลับ (หลังเบิก): แก้ได้เฉพาะบัญชี/คำอธิบาย/หลักฐาน → ยืนยัน → billed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="648" width="340" height="86" as="geometry" /></mxCell>

        <!-- Spine edges -->
        <mxCell id="e1" value="Verify Request" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="draft" target="to_verify" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="Reserve Budget (จองงบ)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" source="to_verify" target="submitted" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="สร้าง+ส่งสารบรรณ" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="submitted" target="sent" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
