        <mxCell id="st_send" value="to_send&lt;br&gt;รอส่งขออนุมัติ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
