          <mxGeometry x="860" y="300" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="st_rejected" value="rejected&lt;br&gt;ปฏิเสธ / ยกเลิก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1440" y="300" width="190" height="56" as="geometry" />
