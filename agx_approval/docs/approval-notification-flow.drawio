        <mxCell id="e3" value="สร้างหนังสือ → เวียนสารบรรณ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="st_send" target="st_sent">
