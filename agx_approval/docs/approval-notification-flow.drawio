        <mxCell id="e2" value="จองงบประมาณ → action_submit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="st_verify" target="st_send">
          <mxGeometry relative="1" as="geometry" />
