          <mxGeometry x="860" y="440" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nc_appr_fyi" value="🔔 → ผู้สร้าง&lt;br&gt;&lt;b&gt;[FYI]&lt;/b&gt; คำขอได้รับอนุมัติแล้ว&lt;br&gt;✅ agx_approval_sarabun_todo" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#e1d5e7;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
