        </mxCell>
        <mxCell id="nc_disb" value="🔔 → เจ้าหน้าที่การเงิน&lt;br&gt;&lt;b&gt;[EXEC]&lt;/b&gt; ตรวจสอบและตั้งเบิก&lt;br&gt;⛔ เสนอเพิ่ม" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#dae8fc;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="440" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nc_bill" value="🔔 → ผู้สร้าง&lt;br&gt;&lt;b&gt;[FYI]&lt;/b&gt; เบิกจ่ายเรียบร้อยแล้ว&lt;br&gt;⛔ เสนอเพิ่ม (optional)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#e1d5e7;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1740" y="440" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nc_returned" value="🔔 → ผู้สร้าง&lt;br&gt;&lt;b&gt;[EXEC]&lt;/b&gt; ตีกลับสารบรรณ: แก้ไข+ส่งหนังสือใหม่ — ⛔ เสนอเพิ่ม&lt;br&gt;&lt;b&gt;[EXEC]&lt;/b&gt; ตีกลับใบเบิก (DR): แก้ไข bank/หลักฐาน — ✅ agx_approval_disbursement" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
