        <!-- Happy-path edges -->
        <mxCell id="e1" value="action_to_verify" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="st_draft" target="st_verify">
