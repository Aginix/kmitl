        <mxCell id="c_fin_return" value="ตอนตีกลับ (to_disburse → approved)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="st_disburse" target="nc_fin_return">
