<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_invoice'][1]" position="after">
                <field name="is_move_request_allowed" invisible="1" />
                <button name="action_move_request" type="object" string="Create bill" attrs="{'invisible': ['|', ('state', '!=', 'purchase'), ('is_move_request_allowed', '=', False)]}" class="btn-primary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_move_request" type="object" class="oe_stat_button" icon="fa-exchange">
                    <field name="move_request_count" widget="statinfo" string="Move Requests"/>
                    <field name='move_request_ids' invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
