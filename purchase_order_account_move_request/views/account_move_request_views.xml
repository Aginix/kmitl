<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View account.move.request tree -->
    <record id="view_account_move_request_tree" model="ir.ui.view">
        <field name="name">view.account.move.request.tree</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>
      
    <!-- View account.move.request form -->
    <record id="view_account_move_request_form" model="ir.ui.view">
        <field name="name">view.account.move.request.form</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="purchase_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_order" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-shopping-cart"
                        string="Purchase Order"
                        attrs="{'invisible': [('purchase_id', '=', False)]}">
                </button>
            </xpath>
        </field>
    </record>

  </odoo>