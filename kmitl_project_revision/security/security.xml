<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A Revision Draft (ADR-0014) belongs to its live project's owners even
         after a draft edit changes หัวหน้าโครงการ: OR'ed with the Own rules. -->
    <record id="kmitl_project_revision_owner_rule" model="ir.rule">
        <field name="name">KMITL Project: Revision Owner Access</field>
        <field name="model_id" ref="kmitl_project.model_kmitl_project" />
        <field
            name="groups"
            eval="[(4, ref('kmitl_project.group_kmitl_project_user'))]"
        />
        <field name="domain_force">[
            '|', '|',
            ('revision_of_id.manager_id.user_id', '=', user.id),
            ('revision_of_id.creating_user_id', '=', user.id),
            ('revision_of_id.coordinator_ids', 'in', user.id)
        ]</field>
    </record>
