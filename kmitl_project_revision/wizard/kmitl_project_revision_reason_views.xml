<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_revision_reason_form" model="ir.ui.view">
        <field name="name">kmitl.project.revision.reason.form</field>
        <field name="model">kmitl.project.revision.reason</field>
        <field name="arch" type="xml">
            <form>
                <field name="project_id" invisible="1" />
                <field name="mode" invisible="1" />
                <group>
                    <field name="reason" placeholder="ระบุเหตุผล..." />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
