<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View budget.appropriation form -->
    <record id="view_budget_appropriation_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form</field>
        <field name="model">budget.appropriation</field>
        <field name="inherit_id" ref="budget_operating_unit.view_budget_appropriation_form"/>
        <field name="arch" type="xml">
            <field name="operating_unit_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//page[@name='extra']/group/group[2]" position="inside">
                <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit" readonly="1" />
                <field name="operating_unit_id" invisible="1" />
            </xpath>
        </field>
    </record>

  </odoo>
