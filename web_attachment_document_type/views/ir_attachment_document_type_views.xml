<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ================================================================
         Document Type master — dedicated CRUD menu so admins have one
         place to create / rename / archive / delete doctypes. The Config
         form's mapping tree m2o is locked to select-only (see below) so
         typo'd master rows can never be spawned from that form.
         ================================================================ -->

    <record id="view_ir_attachment_document_type_tree" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.tree</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="view_ir_attachment_document_type_form" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.form</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_attachment_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">ir.attachment.document.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ================================================================
         Attachment Doctypes — model-first config
         Tree = one row per configured model. "New" creates a config
         (not a new ir.model), so `create="true"` is safe.
         ================================================================ -->

    <record id="view_ir_attachment_document_type_config_tree" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.config.tree</field>
        <field name="model">ir.attachment.document.type.config</field>
        <field name="arch" type="xml">
            <tree string="Attachment Doctypes">
                <field name="res_model_id" />
            </tree>
        </field>
    </record>

    <record id="view_ir_attachment_document_type_config_form" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.config.form</field>
        <field name="model">ir.attachment.document.type.config</field>
        <field name="arch" type="xml">
            <form string="Attachment Doctypes">
                <sheet>
                    <group>
                        <field
                            name="res_model_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                            attrs="{'readonly': [('id', '!=', False)]}"
                        />
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field
                                name="document_type_id"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="action_ir_attachment_document_type_config"
        model="ir.actions.act_window"
    >
        <field name="name">Attachment Doctypes</field>
        <field name="res_model">ir.attachment.document.type.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================================================================
         Menus
         ================================================================ -->

    <menuitem
        id="menu_ir_attachment_document_type"
        name="Document Types"
        parent="base.menu_ir_property"
        action="action_ir_attachment_document_type"
        sequence="89"
    />

    <menuitem
        id="menu_ir_attachment_document_type_rel"
        name="Attachment Doctypes"
        parent="base.menu_ir_property"
        action="action_ir_attachment_document_type_config"
        sequence="90"
    />

</odoo>
