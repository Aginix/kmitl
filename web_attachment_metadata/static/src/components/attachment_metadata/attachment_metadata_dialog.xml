<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_attachment_metadata.AttachmentMetadataDialog" owl="1">
        <Dialog title="env._t('Add Attachment')" size="'md'">
            <div class="mb-3">
                <label class="o_form_label">File</label>
                <input type="file" t-ref="fileInput" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="o_form_label" t-esc="props.metadataLabel" />
                <select class="form-select" t-model="state.metadataId">
                    <option value="">--</option>
                    <t t-foreach="metadataOptions" t-as="opt" t-key="opt.id">
                        <option t-att-value="opt.id" t-esc="opt.name" />
                    </t>
                </select>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave">Save</button>
                <button
                    class="btn btn-secondary"
                    t-on-click="() => props.close()"
                >Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
