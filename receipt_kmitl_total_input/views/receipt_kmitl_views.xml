<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_receipt_kmitl_form_total_input" model="ir.ui.view">
        <field name="name">kmitl.receipt.form.total.input</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree/field[@name='quantity']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
