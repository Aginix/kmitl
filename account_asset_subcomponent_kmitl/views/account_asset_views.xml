<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View account.asset form -->
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='asset_info']" position="before">
                    <page string="Subcomponents" name="subcomponents">
                        <field 
                            name="subcomponent_ids"
                            mode="tree">
                            <tree editable="bottom" string="Subcomponents">
                                <field 
                                    name="sequence" 
                                    widget="handle"/>
                                <field name="name"/>
                                <field name="number"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
        </field>
    </record>

  </odoo>