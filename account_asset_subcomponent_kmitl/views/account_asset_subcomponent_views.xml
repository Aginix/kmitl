<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.asset.subcomponent View Tree -->
    <record id="view_account_asset_subcomponent_tree" model="ir.ui.view">
        <field name="name">view.account.asset.subcomponent.tree</field>
        <field name="model">account.asset.subcomponent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View account.asset.subcomponent form -->
    <record id="view_account_asset_subcomponent_form" model="ir.ui.view">
        <field name="name">view.account.asset.subcomponent.form</field>
        <field name="model">account.asset.subcomponent</field>
        <field name="arch" type="xml">
            <form string="Account Asset Subcomponent">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View account.asset.subcomponent search -->
    <record id="view_account_asset_subcomponent_search" model="ir.ui.view">
        <field name="name">view.account.asset.subcomponent.search</field>
        <field name="model">account.asset.subcomponent</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action account.asset.subcomponent -->
    <record id="action_account_asset_subcomponent" model="ir.actions.act_window">
        <field name="name">Account Asset Subcomponent</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.subcomponent</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Account Asset Subcomponent.
            </p>
        </field>
    </record>

</odoo>
