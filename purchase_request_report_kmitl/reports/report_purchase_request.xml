<odoo>
    <template
        id="report_purchase_request_kmitl"
        inherit_id="purchase_request.report_purchase_request"
    >
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.basic_layout">
                <style>
                    * {
                        line-height: 1.5;
                    }
                    table.budget tr td:first-child {
                        width: 30%;
                    }
                </style>

                <div class="page">
                    <div style="position: absolute; top: 0px; left: 0px">
                        <img
                            t-if="o.company_id.logo"
                            t-att-src="image_data_uri(o.company_id.logo)"
                            style="max-height: 110px"
                            alt="Logo"
                        />
                    </div>
                    <div style="position: absolute; top: 0px; right: 0px">
                        <div>แทนพ.1</div>
                    </div>
                    <div class="oe_structure" />
                    <div style="height: 1px" />
                    <div class="page-header mt-5 mb-5">
                        <h3 class="text-center fw-bolder" style="line-height: 1.575">
                            บันทึกขอซื้อขอจ้าง
                        </h3>
                    </div>
                    <div class="row my-2">
                        <div class="col-8">
                            เลขที่เอกสาร
                            <span
                                class="ms-2"
                                style="font-weight: normal"
                                t-out="o.name"
                            />
                        </div>
                        <div class="col">
                            วันที่
                            <span
                                class="ms-2"
                                style="font-weight: normal; margin-left: 16px"
                                t-out="o.create_date"
                            />
                        </div>
                    </div>
                    <div class="row my-2">
                        <div class="col">
                            หน่วยงาน
                            <span class="ms-2" t-out="o.department_id.complete_name" />
                        </div>
                    </div>
                    <div class="row my-2">
                        <div class="col">
                            เรื่อง <span class="ms-2" t-out="o.title" />
                        </div>
                    </div>

                    <div class="my-4" />
                    <p style="text-indent: 6em; line-height: 2.5">
                        ข้าพเจ้า
                        <span
                            t-out="o.requested_by.display_name"
                            class="fw-bolder"
                            style="text-decoration: underline"
                        />
                        <span class="ms-2">สังกัด</span>
                        <span
                            t-out="o.requested_by.employee_id.department_id.complete_name"
                            class="fw-bolder"
                            style="text-decoration: underline"
                        />
                        ต้องการ
                        <span
                            t-out="o.procurement_type_id.name"
                            class="fw-bolder"
                            style="text-decoration: underline"
                        />
                        <span
                            t-out="o.product_id.name"
                            class="fw-bolder"
                            style="text-decoration: underline"
                        />
                        ด้วยวิธีการจัดซื้อจัดจ้าง
                        <strong
                            ><u><t t-out="o.procurement_method_id.name" /></u
                        ></strong>
                    </p>

                    <div class="my-4" />

                    <div class="row my-4">
                        <div class="col">
                            เหตุผลความจำเป็น
                            <strong
                                ><u><t t-out="o.description" /></u
                            ></strong>
                        </div>
                    </div>

                    <div class="row my-4">
                        <div class="col">
                            โดยใช้งบประมาณ ประจำปีงบประมาณ พ.ศ.
                            <strong
                                ><u><t t-out="o.account_fiscal_year_id.name" /></u
                            ></strong>
                        </div>
                    </div>
                    <div class="row my-4">
                        <div class="col">
                            โดยมีการเบิกจ่ายดังนี้
                            <strong
                                ><u><t t-out="o.payment_type" /></u
                            ></strong>
                        </div>
                    </div>

                    <div class="my-4" />
                    <div class="row my-2">
                        <div class="col">ขอให้จัดหาพัสดุ ดังตารางต่อไปนี้</div>
                    </div>

                    <table class="table table-bordered table-sm mb-4">
                        <thead>
                            <tr>
                                <th>ลำดับ</th>
                                <th class="text-center">รายละเอียด</th>
                                <th class="text-center">จำนวน</th>
                                <th class="text-end">ราคาต่อหน่วย</th>
                                <th class="text-end">จำนวนเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="row_no" t-value="1" />
                            <t t-foreach="o.line_ids" t-as="line">
                                <tr>
                                    <td class="text-center" t-out="row_no" />
                                    <td>
                                        <span t-out="line.name" />
                                    </td>
                                    <td class="text-center">
                                        <span t-out="line.product_qty" />
                                        <span t-out="line.product_uom_id.name" />
                                    </td>
                                    <td class="text-end">
                                        <t t-out="'{0:,.2f}'.format(line.price_unit)" />
                                    </td>
                                    <td class="text-end">
                                        <t
                                            t-out="'{0:,.2f}'.format(line.estimated_cost)"
                                        />
                                    </td>
                                </tr>
                                <t t-set="row_no" t-value="row_no + 1" />
                            </t>
                            <tr>
                                <t t-set="currency" t-value="o.currency_id" />
                                <td
                                    colspan="2"
                                    rowspan="3"
                                    class="text-center align-middle"
                                >
                                    (<t
                                        t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.amount_total)"
                                    />)
                                </td>
                                <td class="text-center" colspan="2">
                                    <strong>ราคาก่อนรวมภาษีมูลค่าเพิ่ม</strong>
                                </td>
                                <td class="text-end">
                                    <t t-out="'{0:,.2f}'.format(o.amount_untaxed)" />
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" colspan="2">
                                    <strong>ภาษีมูลค่าเพิ่ม (VAT 7%)</strong>
                                </td>
                                <td class="text-end">
                                    <t t-out="'{0:,.2f}'.format(o.amount_tax)" />
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" colspan="2">
                                    <strong>ราคาสุทธิ</strong>
                                </td>
                                <td class="text-end">
                                    <t t-out="'{0:,.2f}'.format(o.amount_total)" />
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="my-4" />
                    <p>รายละเอียดงบประมาณ</p>
                    <t
                        t-call="purchase_request_report_kmitl.report_purchase_request_budget"
                    />

                    <div class="my-4"></div>
                    <div class="mb-2">
                        และพร้อมกันนี้ได้แนบเอกสารประกอบการพิจารณา ดังนี้
                    </div>
                    <ol>
                        <li>
                            บันทึกเสนอซื้อ จำนวน
                            <span class="fw-bolder" style="text-decoration: underline"
                                >1</span
                            >
                            ชุด
                        </li>
                        <li>
                            ใบเสนอราคาพัสดุ จำนวน
                            <span
                                class="fw-bolder"
                                style="text-decoration: underline"
                                t-out="len(o.attachment_ids.filtered(lambda x: x.attachment_type == 'rfq'))"
                            />
                            ชุด
                        </li>
                        <li>
                            เอกสารคุณสมบัติ จำนวน
                            <span
                                class="fw-bolder"
                                style="text-decoration: underline"
                                t-out="len(o.attachment_ids.filtered(lambda x: x.attachment_type == 'tor'))"
                            />
                            ชุด
                        </li>
                        <li>
                            ขออนุมัติแต่งตั้งคณะกรรมการตรวจรับ ดังต่อไปนี้
                            <ol>
                                <li>
                                    <strong><u>นายจิตดี จิตแจ่มใส</u></strong>
                                </li>
                                <li>
                                    <strong><u>นายสมองดี อัจฉริยะ</u></strong>
                                </li>
                                <li>
                                    <strong><u>นางสาวอารมณ์ ผ่องใส</u></strong>
                                </li>
                            </ol>
                        </li>
                    </ol>

                    <t
                        t-call="purchase_request_report_kmitl.report_purchase_request_sign"
                    />
                </div>
            </t>
        </xpath>
    </template>

    <template id="report_purchase_request_budget">
        <table class="table table-bordered border table-sm budget">
            <tbody>
                <tr class="o_field_budget_commitment_id">
                    <td>เลขที่ใบจองงบประมาณ</td>
                    <td>
                        <t t-out="o.budget_commitment_id.name" />
                    </td>
                </tr>
                <tr class="o_field_budget_account_id">
                    <td>รหัสงบประมาณค่าใช้จ่าย</td>
                    <td>
                        <t t-out="'[' + o.budget_account_id.code + ']'" />
                        <t t-out="o.budget_account_id.complete_name" />
                    </td>
                </tr>
                <tr class="o_field_source_analytic_id">
                    <td>แหล่งเงิน</td>
                    <td>
                        <t t-out="'[' + o.source_analytic_id.code + ']'" />
                        <t t-out="o.source_analytic_id.name" />
                    </td>
                </tr>
                <tr class="o_field_department_analytic_id">
                    <td>หน่วยงาน</td>
                    <td>
                        <t t-out="'[' + o.department_analytic_id.code + ']'" />
                        <t t-out="o.department_analytic_id.complete_name" />
                    </td>
                </tr>
                <tr class="o_field_activity_analytic_id">
                    <td>ด้าน/แผนงาน/กิจกรรม</td>
                    <td>
                        <t t-out="'[' + o.activity_analytic_id.code + ']'" />
                        <t t-out="o.activity_analytic_id.complete_name" />
                    </td>
                </tr>
                <tr class="o_field_fund_analytic_id">
                    <td>กองทุน</td>
                    <td>
                        <t t-out="'[' + o.fund_analytic_id.code + ']'" />
                        <t t-out="o.fund_analytic_id.complete_name" />
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_purchase_request_sign">
        <div class="my-5">
            <div class="my-2" style="display: inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /> ผู้ขอให้จัดหา</div>
                <div
                    class="text-center fw-bolder my-2"
                    style="text-decoration: underline"
                >
                    (<span t-out="o.requested_by.display_name" />)
                </div>
            </div>
        </div>
        <div class="my-5" />
        <div class="my-5">
            <div class="my-2" style="display: inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /></div>
                <div
                    class="text-center fw-bolder my-2"
                    style="text-decoration: underline"
                >
                    (<span t-out="o.requested_by.display_name" />)
                </div>
                <div
                    class="text-center fw-bolder my-2"
                    style="text-decoration: underline"
                >
                    คณบดี<t t-out="o.department_id.master_department_id.name" />
                </div>
            </div>
        </div>
    </template>
</odoo>
