<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Inherit from the view that *adds* the bank-accounts button so we can:
        1. Insert partner_is_internal as an invisible field (required for attrs).
        2. Extend the button's invisible condition to also hide it for internal staff.
    -->
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field
            name="name"
        >disbursement.request.form (disbursement_partner_bank_hr_kmitl)</field>
        <field name="model">disbursement.request</field>
        <field
            name="inherit_id"
            ref="disbursement_partner_bank.view_disbursement_request_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/tree/button[@name='action_open_partner_bank_wizard']"
                position="before"
            >
                <field name="partner_is_internal" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/tree/button[@name='action_open_partner_bank_wizard']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': ['|', '|', ('parent.state', '!=', 'draft'), ('requires_partner_bank', '=', False), ('partner_is_internal', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
