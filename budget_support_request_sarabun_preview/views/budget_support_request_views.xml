<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_support_request_form_sarabun_preview" model="ir.ui.view">
        <field name="name">budget.support.request.form.sarabun.preview</field>
        <field name="model">budget.support.request</field>
        <field name="inherit_id" ref="budget_support_request.view_budget_support_request_form"/>
        <field name="arch" type="xml">
            <!-- The หนังสือ this request sends to e-Saraban, before and after
                 สร้างหนังสือ. -->
            <xpath expr="//button[@name='action_reset_to_draft']" position="after">
                <button name="action_preview_sarabun_document"
                        string="ดูตัวอย่างเอกสาร"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
            </xpath>
        </field>
    </record>

</odoo>
