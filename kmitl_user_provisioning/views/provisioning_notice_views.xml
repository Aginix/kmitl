<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Landing page shown to un-provisioned users on login. Not attached to any
        menu, so it never appears as an app; it is reached only through
        res.users.action_id injected by ir.http.session_info.
    -->
    <record id="action_provisioning_notice" model="ir.actions.client">
        <field name="name">บัญชียังไม่ได้รับสิทธิ์การใช้งาน</field>
        <field name="tag">kmitl_provisioning_notice</field>
        <field name="target">fullscreen</field>
    </record>
</odoo>
