<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_form_tier" model="ir.ui.view">
        <field name="name">advance.payment.form.tier</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form"/>
        <field name="arch" type="xml">
            <!-- Reviews are requested automatically on action_verify
                 (to_verify → to_approve), so no manual request button is
                 needed. The approve button only enables once the tier chain
                 has validated. -->
            <xpath expr="//button[@name='action_approve']" position="before">
                <field name="rejected" invisible="1"/>
                <field name="validation_status" invisible="1"/>
                <field name="need_validation" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'to_approve'), ('validation_status', '!=', 'validated')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
