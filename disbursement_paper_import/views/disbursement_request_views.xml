<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_paper_import)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="inside">
                <!-- A div, not a span: its text stays a plain term for the
                     translation. -->
                <div
                    class="badge rounded-pill bg-info fs-6 d-inline-block ms-2"
                    attrs="{'invisible': [('is_paper_import', '=', False)]}"
                >Paper Import</div>
            </xpath>
            <field name="payment_type" position="after">
                <!-- One of the two survives per user: only the paper import
                     group may edit the flag. -->
                <field
                    name="is_paper_import"
                    readonly="1"
                    groups="!disbursement_paper_import.group_disbursement_paper_import"
                />
                <field
                    name="is_paper_import"
                    groups="disbursement_paper_import.group_disbursement_paper_import"
                />
            </field>
        </field>
    </record>

    <record id="view_disbursement_request_search" model="ir.ui.view">
        <field name="name">disbursement.request.search (disbursement_paper_import)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search" />
        <field name="arch" type="xml">
            <filter name="tofix" position="after">
                <separator />
                <filter
                    name="paper_import"
                    string="Imported from Paper"
                    domain="[('is_paper_import', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
