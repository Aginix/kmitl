<odoo>
    <!-- เอกสารแนบท้าย แบบ งปม.303 — แผนจัดซื้อจัดจ้างที่ปรากฏในบรรทัดโอน.
         ต่อหน้าใหม่ใน PDF เดียวกัน จึงติดไปกับไฟล์ที่แนบตอน post และ enclosure ของ sarabun. -->
    <template
        id="report_budget_transfer_plan_annex"
        inherit_id="budget_transfer_pdf.report_budget_transfer"
    >
        <xpath expr="//div[hasclass('page')]" position="after">
            <t t-foreach="o._annex_procurement_plans()" t-as="side">
                <div class="annex" style="page-break-before: always; color: #000; font-size: 15pt; line-height: 1.25;">
                    <div class="form-code">เอกสารแนบ แบบ งปม. 303 เลขที่ <span t-out="o.name"/></div>
                    <div class="doc-title">
                        รายละเอียดแผนจัดซื้อจัดจ้าง<br/>
                        <span t-out="side[0]"/>
                    </div>
                    <table class="detail">
                        <thead>
                            <tr>
                                <th class="seq">ที่</th>
                                <th>รหัสแผน</th>
                                <th>ชื่อรายการ</th>
                                <th>จำนวน</th>
                                <th class="amt">ยอดโอน (บาท)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="side[1]" t-as="row">
                                <td class="seq" t-out="row_index + 1"/>
                                <td t-out="row[0].name"/>
                                <td t-out="row[0].description"/>
                                <td><t t-out="row[0].amount"/> <t t-out="row[0].unit"/></td>
                                <td class="amt" t-out="'{:,.2f}'.format(row[1])"/>
                            </tr>
                            <tr class="total">
                                <td colspan="4" style="text-align:right;">รวมทั้งสิ้น</td>
                                <td class="amt" t-out="'{:,.2f}'.format(sum(r[1] for r in side[1]))"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
