<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_procurement_mode" model="ir.ui.view">
        <field name="name">purchase.request.form.procurement_mode</field>
        <field name="model">purchase.request</field>
        <field name="priority">150</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <field name="vat_included" position="before">
                <field
                    name="procurement_mode"
                    widget="radio"
                    options="{'horizontal': true}"
                    attrs="{'readonly': [('is_editable', '=', False)]}"
                />
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="attrs">{'readonly': [('is_editable', '=', False)], 'invisible': [('procurement_mode', '=', 'by_officer')]}</attribute>
            </field>
            <field name="vat_included" position="attributes">
                <attribute name="attrs">{'readonly': [('is_editable', '=', False)], 'invisible': [('procurement_mode', '=', 'by_officer')]}</attribute>
            </field>
            <field name="tax_id" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('vat_included', '=', 'exclusive'), ('procurement_mode', '=', 'by_officer')], 'required': ['&amp;', ('vat_included', '=', 'inclusive'), ('procurement_mode', '!=', 'by_officer')], 'readonly': [('is_editable', '=', False)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
