<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_procurement_mode" model="ir.ui.view">
        <field name="name">purchase.request.form.procurement_mode</field>
        <field name="model">purchase.request</field>
        <field name="priority">150</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="is_procurement_mode_editable" invisible="1" />
                <field
                    name="procurement_mode"
                    widget="radio"
                    options="{'horizontal': true}"
                    attrs="{'readonly': [('is_procurement_mode_editable', '=', False)], 'invisible': [('payment_type', '!=', 'direct')]}"
                />
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="attrs">{'readonly': [('is_editable', '=', False)], 'invisible': ['|', ('payment_type', '!=', 'direct'), ('procurement_mode', '=', 'by_officer')]}</attribute>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_form_procurement_mode_vat" model="ir.ui.view">
        <field name="name">purchase.request.form.procurement_mode.vat_included</field>
        <field name="model">purchase.request</field>
        <field name="priority">150</field>
        <field name="inherit_id" ref="purchase_request_price_tax_included.view_purchase_request_form" />
        <field name="arch" type="xml">
            <field name="vat_included" position="attributes">
                <attribute name="attrs">{'readonly': [('is_vat_editable', '=', False)], 'invisible': ['|', ('payment_type', '!=', 'direct'), ('procurement_mode', '=', 'by_officer')]}</attribute>
            </field>
        </field>
    </record>
</odoo>
