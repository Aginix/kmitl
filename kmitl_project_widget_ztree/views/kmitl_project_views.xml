<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View kmitl.project form -->
    <record id="view_kmitl_project_form" model="ir.ui.view">
        <field name="name">view.kmitl.project.form</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='national_strategy_id']" position="attributes">
                <!-- Add your fields or attributes here -->
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'ztree_parent_key': 'parent_id','ztree_expend_level': '2', 'order': 'name' }</attribute>
            </xpath>
            <xpath expr="//field[@name='master_plan_id']" position="attributes">
                <!-- Add your fields or attributes here -->
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'ztree_parent_key': 'parent_id','ztree_expend_level': '2', 'order': 'name' }</attribute>
            </xpath>
            <xpath expr="//field[@name='nesdc_plan_id']" position="attributes">
                <!-- Add your fields or attributes here -->
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'ztree_parent_key': 'parent_id','ztree_expend_level': '2', 'order': 'name' }</attribute>
            </xpath>
            <xpath expr="//field[@name='kmitl_plan_id']" position="attributes">
                <!-- Add your fields or attributes here -->
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'ztree_parent_key': 'parent_id','ztree_expend_level': '2', 'order': 'name' }</attribute>
            </xpath>
            <xpath expr="//field[@name='budget_account_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//field[@name='department_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//field[@name='fund_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//field[@name='source_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

  </odoo>
