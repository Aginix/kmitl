<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Route Template for Purchase Request Approval -->
    <record id="route_template_purchase_request_approval" model="sarabun.route.template">
        <field name="name">Purchase Request Approval (PA)</field>
        <field name="description">Route template for purchase request approval workflow</field>
        <field name="sequence">20</field>
        <field name="origin_model">purchase.request.approval</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Default Route Template Line: Approver (seed-only) -->
    <record id="route_template_line_pa_approve" model="sarabun.route.template.line">
        <field name="template_id" ref="route_template_purchase_request_approval"/>
        <field name="order">10</field>
        <field name="verb">sign_approve</field>
        <field name="target_mode">person</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>

</odoo>
