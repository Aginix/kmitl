<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Placeholder approving position. Holder is base.user_admin as a seed only —
         assign the real holder(s) in Configuration ▸ Positions before go-live.
         noupdate="1" so the holder assignment survives module upgrades. -->
    <data noupdate="1">
        <record id="position_pa_approver" model="sarabun.position">
            <field name="name">ผู้อนุมัติจัดซื้อ (PA Approver)</field>
            <field name="code">PA_APPROVER</field>
            <field name="holder_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
        </record>
    </data>

    <data noupdate="0">
        <!-- Route Template for Purchase Request Approval -->
        <record id="route_template_purchase_request_approval" model="sarabun.route.template">
            <field name="name">Purchase Request Approval (PA)</field>
            <field name="description">Route template for purchase request approval workflow</field>
            <field name="sequence">20</field>
            <field name="origin_model">purchase.request.approval</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Approver step — targets a Position (canonical). Change the approver by
             reassigning the position's holders, not by editing this line. -->
        <record id="route_template_line_pa_approve" model="sarabun.route.template.line">
            <field name="template_id" ref="route_template_purchase_request_approval"/>
            <field name="order">10</field>
            <field name="verb" ref="agx_sarabun.verb_sign_approve"/>
            <field name="target_mode">position</field>
            <field name="position_id" ref="position_pa_approver"/>
        </record>
    </data>

</odoo>
