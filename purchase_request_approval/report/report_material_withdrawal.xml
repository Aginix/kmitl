<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_material_withdrawal" model="ir.actions.report">
        <field name="name">ใบเบิกวัสดุ (พ.43)</field>
        <field name="model">purchase.request.approval.material.withdrawal.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_request_approval.report_material_withdrawal</field>
        <field name="report_file">purchase_request_approval.report_material_withdrawal</field>
        <field name="paperformat_id" ref="paperformat_purchase_request_approval_report"/>
        <field name="print_report_name">'ใบเบิกวัสดุ - %s' % (object.approval_id.name)</field>
    </record>

    <template id="report_material_withdrawal_document">
        <t t-set="o" t-value="w.approval_id.with_context({'lang': 'th_TH'})"/>
        <t t-set="currency" t-value="o.currency_id"/>
        <t t-set="doc_date" t-value="o.approval_date or o.date_start or o.create_date"/>
        <t t-set="requester" t-value="w.requester_id"/>
        <t t-set="dept_head" t-value="w.dept_head_id"/>
        <t t-set="disburser" t-value="w.disburser_id"/>
        <t t-set="activity_name" t-value="o.request_id.activity_analytic_id.name if o.request_id and 'activity_analytic_id' in o.request_id._fields and o.request_id.activity_analytic_id else ''"/>
        <style>
            * {
                font-family: "THSarabunNew", Arial, sans-serif;
                --bs-body-font-size: 16pt;
            }
            p, span, div, td, th {
                font-size: 16pt;
                line-height: 1.3;
            }
            table.mw-table {
                width: 100%;
                border-collapse: collapse;
            }
            table.mw-table th, table.mw-table td {
                border: 1px solid #000;
                padding: 4px 6px;
                vertical-align: middle;
            }
            .sig-line {
                border-bottom: 1px dotted #000;
                display: inline-block;
                width: 200px;
                vertical-align: baseline;
            }
            .sig-row {
                margin-bottom: 1rem;
                white-space: nowrap;
            }
        </style>

        <div class="page">
            <div style="position: absolute; top: 0px; left: 0px">
                <img t-if="o.company_id.logo"
                     t-att-src="image_data_uri(o.company_id.logo)"
                     style="max-height: 90px" alt="Logo"/>
            </div>
            <div style="position: absolute; top: 0px; right: 0px">
                <div>พ.43</div>
            </div>

            <div style="height: 100px"/>
            <h3 class="text-center fw-bolder">ใบเบิกวัสดุ</h3>
            <div class="my-3"/>

            <div class="row">
                <div class="col-7">
                    เลขที่เอกสาร
                    <span class="ms-2 fw-bolder text-decoration-underline"
                          t-out="o.name"/>
                </div>
                <div class="col">
                    วันที่
                    <span class="ms-2 fw-bolder text-decoration-underline"
                          t-out="o.format_date_thai(doc_date)"/>
                </div>
            </div>

            <div class="my-3"/>
            <p style="text-indent: 4em">
                ด้วย
                <span class="fw-bolder text-decoration-underline"
                      t-out="requester.name or ''"/>
                มีความประสงค์ขอเบิกวัสดุตามรายการและจำนวน
                <span class="fw-bolder text-decoration-underline"
                      t-out="len(o.line_ids)"/>
                รายการ เพื่อใช้ในงาน
                <span class="fw-bolder text-decoration-underline"
                      t-out="activity_name"/>
                และมอบให้
                <span class="fw-bolder text-decoration-underline"
                      t-out="requester.name or ''"/>
                เป็นผู้รับพัสดุแทน
            </p>

            <div class="my-3"/>

            <table class="mw-table">
                <thead>
                    <tr>
                        <th class="text-center" rowspan="2" style="width: 6%">ลำดับ</th>
                        <th class="text-center" rowspan="2">รายการ</th>
                        <th class="text-center" rowspan="2" style="width: 8%">หน่วยนับ</th>
                        <th class="text-center" colspan="2" style="width: 14%">จำนวน</th>
                        <th class="text-center" colspan="3" style="width: 32%">ส่วนของงานพัสดุ</th>
                        <th class="text-center" rowspan="2" style="width: 10%">หมายเหตุ</th>
                    </tr>
                    <tr>
                        <th class="text-center">เบิก</th>
                        <th class="text-center">จ่าย</th>
                        <th class="text-center">รหัสวัสดุ</th>
                        <th class="text-center">ต้นทุน/หน่วย</th>
                        <th class="text-center">จำนวนเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="row_no" t-value="1"/>
                    <t t-foreach="o.line_ids" t-as="line">
                        <tr>
                            <td class="text-center" t-out="row_no"/>
                            <td t-out="line.product_id.name or line.name or ''"/>
                            <td class="text-center"
                                t-out="line.product_uom_id.name or ''"/>
                            <td class="text-center"
                                t-out="'{0:,.0f}'.format(line.product_qty)"/>
                            <td class="text-center"
                                t-out="'{0:,.0f}'.format(line.product_qty)"/>
                            <td class="text-center"
                                t-out="line.product_id.default_code or ''"/>
                            <td class="text-end"
                                t-out="'{0:,.2f}'.format(line.price_unit)"/>
                            <td class="text-end"
                                t-out="'{0:,.2f}'.format(line.price_subtotal)"/>
                            <td/>
                        </tr>
                        <t t-set="row_no" t-value="row_no + 1"/>
                    </t>
                    <tr>
                        <td colspan="7" class="text-center">
                            (
                            <span t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.amount_untaxed)"/>
                            )
                        </td>
                        <td class="text-end fw-bolder"
                            t-out="'{0:,.2f}'.format(o.amount_untaxed)"/>
                        <td/>
                    </tr>
                </tbody>
            </table>

            <div style="height: 60px"/>

            <div class="sig-row">
                <div>ลงชื่อ <span class="sig-line"/> ผู้ขอเบิก/ผู้รับของ</div>
                <div style="margin-left: 3em">
                    ( <span t-out="requester.name or ''"/> )
                </div>
            </div>

            <div class="sig-row">
                <div>ลงชื่อ <span class="sig-line"/> หัวหน้าหน่วยงาน</div>
                <div style="margin-left: 3em">
                    ( <span t-out="dept_head.name or ''"/> )
                </div>
            </div>

            <div class="sig-row">
                <div>ลงชื่อ <span class="sig-line"/> ผู้เบิกจ่าย</div>
                <div style="margin-left: 3em">
                    ( <span t-out="disburser.name or ''"/> )
                </div>
            </div>
        </div>
    </template>

    <template id="report_material_withdrawal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="w">
                <t t-call="web.basic_layout">
                    <t t-call="purchase_request_approval.report_material_withdrawal_document"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
