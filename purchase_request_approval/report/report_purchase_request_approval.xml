<odoo>
    <template id="report_purchase_request_approval">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.currency_id" />
                    <style>
                        * {
                        font-family: "THSarabunNew", Arial, sans-serif;
                        --bs-body-font-size: 16pt;
                        }
                        table.budget tr td:first-child {
                        width: 30%;
                        }
                        p,
                        span,
                        div {
                        font-size: 16pt;
                        line-height: 1.2;
                        }
                    </style>

                    <div class="page">
                        <div style="position: absolute; top: 0px; left: 0px">
                            <img
                                t-if="o.request_id.company_id.logo"
                                t-att-src="image_data_uri(o.request_id.company_id.logo)"
                                style="max-height: 110px"
                                alt="Logo"
                            />
                        </div>
                        <div style="position: absolute; top: 0px; right: 0px">
                            <div>แทน แบบ พจ.1</div>
                        </div>
                        <div class="oe_structure" />
                        <div style="height: 1px" />
                        <div class="page-header mt-5 mb-5">
                            <h3
                                class="text-center fw-bolder"
                                style="line-height: 1.575"
                            >
                                บันทึกรายงานขอซื้อ/จ้าง
                            </h3>
                        </div>
                        <div class="row">
                            <div class="col-8"> เลขที่ <span class="ms-2 fw-normal" t-out="o.active_sarabun_document_id.name" />
                            </div>
                            <div class="col"> วันที่ <span
                                    class="ms-2 fw-normal"
                                    t-esc="o.format_date_thai(o.active_sarabun_document_id.date)"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"> หน่วยงาน <span class="ms-2" t-out="o.active_sarabun_document_id.sender_department_id.display_name" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"> เรื่อง <span class="ms-2" t-out="o.active_sarabun_document_id.subject" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                เรียน <span class="ms-2" t-out="o.active_sarabun_document_id.addressee" />
                            </div>
                        </div>

                        <div class="my-4" />
                        <p style="text-indent: 6em"> ตาม ใบขอซื้อขอจ้าง,PR ต้องการ<span>
                                <span t-field="o.procurement_type_id" />
                                <span t-out="o.product_id.name"
                                />
                            </span>
                            ด้วยวิธีการ<span t-field="o.procurement_method_id" /> เลขที่ <span
                                t-field="o.request_id" /> ลงวันที่ 3 กรกฎาคม พ.ศ. 2568
                            ได้รับอนุมัติหลักการและงบประมาณ <span t-out="o.product_id.name" />
                            งบประมาณ <t t-out="'{0:,.2f}'.format(o.amount_total)" /> บาท (<t
                                t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.amount_total)"
                            />)
                            นั้น </p>

                        <div class="my-4" />

                        <div class="row">
                            <div class="col"> เหตุผลความจำเป็น <span
                                    class="fw-bolder text-decoration-underline"
                                    t-out="o.description"
                                />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col"> โดยใช้งบประมาณ ประจำปีงบประมาณ พ.ศ. <span
                                    class="fw-bolder text-decoration-underline"
                                    t-field="o.account_fiscal_year_id"
                                />
                            </div>
                        </div>

                        <div class="my-4" />

                        <table class="table table-bordered table-sm mb-4">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 8%">ลำดับ</th>
                                    <th class="text-center">รายละเอียด</th>
                                    <th class="text-center">จำนวน</th>
                                    <th class="text-end">ราคาต่อหน่วย</th>
                                    <th class="text-end">จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="row_no" t-value="1" />
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td
                                            class="text-center"
                                            style="width: 8%"
                                            t-out="row_no"
                                        />
                                        <td t-out="line.name" />
                                        <td class="text-center">
                                            <span
                                                t-out="'{0:,.0f}'.format(line.product_qty)"
                                            />
                                            <span t-field="line.product_uom_id" />
                                        </td>
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.price_unit)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.estimated_cost)"
                                        />
                                    </tr>
                                    <t t-set="row_no" t-value="row_no + 1" />
                                </t>
                                <tr>
                                    <td
                                        colspan="2"
                                        rowspan="3"
                                        class="text-center align-middle"
                                    > ( <t
                                            t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.amount_total)"
                                        />
                                        ) </td>
                                    <td class="text-center" colspan="2">
                                        ราคาก่อนรวมภาษีมูลค่าเพิ่ม
                                    </td>
                                    <td
                                        class="text-end"
                                        t-out="'{0:,.2f}'.format(o.amount_untaxed)"
                                    />
                                </tr>
                                <tr>
                                    <td class="text-center" colspan="2">
                                        ภาษีมูลค่าเพิ่ม (VAT 7%)
                                    </td>
                                    <td
                                        class="text-end"
                                        t-out="'{0:,.2f}'.format(o.amount_tax)"
                                    />
                                </tr>
                                <tr>
                                    <td class="text-center" colspan="2">ราคาสุทธิ</td>
                                    <td
                                        class="text-end"
                                        t-out="'{0:,.2f}'.format(o.amount_total)"
                                    />
                                </tr>
                            </tbody>
                        </table>

                        <div class="my-4" />
                        <p>รายละเอียดงบประมาณ</p>

                        <div class="my-4"></div>
                        <div class="mb-2">
                            และพร้อมกันนี้ได้แนบเอกสารประกอบการพิจารณา ดังนี้
                        </div>
                        <ol>
                            <li> บันทึกเสนอซื้อ/จ้าง (พัสดุ) <span
                                    class="fw-bolder text-decoration-underline"
                                >1</span> ชุด </li>
                            <li> ใบเสนอราคาพัสดุ <span
                                    class="fw-bolder text-decoration-underline"
                                    t-out="len(o.attachment_ids.filtered(lambda x: x.attachment_type == 'rfq'))"
                                />
                                ชุด
                            </li>
                            <li>
                                เอกสารคุณสมบัติ จำนวน
                                <span
                                    class="fw-bolder text-decoration-underline"
                                    t-out="len(o.attachment_ids.filtered(lambda x: x.attachment_type == 'tor'))"
                                />
                                ชุด
                            </li> -->
                        </ol>
                        <div class="my-4" />
                        <p style="text-indent: 6em"> 1.1 ตาม อนุมัติให้จัดซื้อ <span
                                t-field="o.product_id.name" /> จำนวน 1 รายการ เป็นเงิน <span
                                t-out="o.estimated_cost" /> บาท โดยวิธี<span
                                t-field="o.procurement_method_id"
                            />
                            ตามพระราชบัญญัติการจัดซื้อจัดจ้างและการบริหารพัสดุภาครัฐ พ.ศ. 2560 มาตรา
                            56 (2) ข้อ (ข) และกฎกระทรวง เรื่อง
                            กำหนดวงเงินการจัดซื้อจัดจ้างพัสดุโดยวิธี<span
                                t-field="o.procurement_method_id"
                            />วงเงินจัดซื้อจัดจ้างที่ไม่ทำข้อตกลงเป็นหนังสือและวงเงินจัดซื้อจัดจ้างในการแต่งตั้งผู้ตรวจรับพัสดุ
                            พ.ศ. 2560 ข้อ 1 ซึ่งอยู่ใต้อำนาจจัดซื้อจัดจ้างและบริหารพัสดุภาครัฐ พ.ศ.
                            2560 และได้ตรวจสอบเอกสารการเงินเป็นที่เรียบร้อยแล้ว โดยขอเบิกจ่ายจาก <span
                                t-field="o.source_analytic_id.name" /> ประจำปีพ.ศ. <span
                                t-field="o.account_fiscal_year_id.name" />
                        </p>
                        <div class="my-4" />
                        <p>จาก <span t-field="o.partner_id.name" /></p>
                        <p>เนื่องจากเป็นผู้ประกอบการ</p>

                        <ol>
                            <li> อนุมัติให้คณะกรรมการตรวจรับพัสดุ ประกอบด้วย <ul
                                    style="list-style-type: none; margin-left: 20px">
                                    <t t-set="idx" t-value="0" />
                                    <t t-foreach="o.work_acceptance_committee_ids" t-as="committee">
                                        <t t-set="idx" t-value="idx + 1" />
                                        <li><t t-esc="idx" />. <t t-esc="committee.name" /></li>
                                    </t>
                                </ul>
                            </li>
                            <li>บันทึกชี้แจงเพิ่มเติม (ถ้ามี)</li>
                        </ol>

                        <div class="my-5" style="height: 10px" />

                        <t
                            t-call="purchase_request_approval.report_purchase_request_sign"
                        />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_purchase_request_committee">
        <li> ขออนุมัติแต่งตั้งคณะกรรมการตรวจรับพัสดุ ดังต่อไปนี้ <ol>
                <li t-foreach="o.work_acceptance_committee_ids" t-as="committee">
                    <span t-field="committee.employee_id" />
                </li>
            </ol>
        </li>
        <t t-if="o.estimated_cost > 100000">
            <li> ขออนุมัติแต่งตั้งคณะกรรมการกำหนดคุณลักษณะเฉพาะร่างขอบเขตงาน ดังต่อไปนี้ <ol>
                    <li t-foreach="o.tor_committee_ids" t-as="committee">
                        <span t-field="committee.employee_id" />
                    </li>
                </ol>
            </li>
            <li> ขออนุมัติแต่งตั้งคณะกรรมการกำหนดราคากลาง ดังต่อไปนี้ <ol>
                    <li t-foreach="o.price_determine_committee_ids" t-as="committee">
                        <span t-field="committee.employee_id" />
                    </li>
                </ol>
            </li>
            <li> ขออนุมัติแต่งตั้งคณะกรรมการพิจารณาผล ดังต่อไปนี้ <ol>
                    <li t-foreach="o.evaluation_committee_ids" t-as="committee">
                        <span t-field="committee.employee_id" />
                    </li>
                </ol>
            </li>
        </t>
        <t t-else=""></t>
    </template>

    <template id="report_purchase_request_budget">
        <table class="table table-bordered border table-sm budget">
            <tbody>
                <tr class="o_field_budget_commitment_id">
                    <td>เลขที่ใบจองงบประมาณ</td>
                    <td>
                        <span t-field="o.budget_commitment_id" />
                    </td>
                </tr>
                <tr class="o_field_budget_account_id">
                    <td>รหัสงบประมาณค่าใช้จ่าย</td>
                    <td>
                        <span t-field="o.budget_account_id" />
                    </td>
                </tr>
                <tr class="o_field_source_analytic_id">
                    <td>แหล่งเงิน</td>
                    <td>
                        <span t-field="o.source_analytic_id" />
                    </td>
                </tr>
                <tr class="o_field_department_analytic_id">
                    <td>หน่วยงาน</td>
                    <td>
                        <span t-field="o.department_analytic_id" />
                    </td>
                </tr>
                <tr class="o_field_activity_analytic_id">
                    <td>ด้าน/แผนงาน/กิจกรรม</td>
                    <td>
                        <span t-field="o.activity_analytic_id" />
                    </td>
                </tr>
                <tr class="o_field_fund_analytic_id">
                    <td>กองทุน</td>
                    <td>
                        <span t-field="o.fund_analytic_id" />
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_purchase_request_sign">
        <div class="my-5">
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /> ผู้รับผิดชอบ</div>
                <div class="text-center my-2">
                    ( <span t-field="o.requested_by" />
                    )
                </div>
            </div>
            <div class="my-5" />
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /> ผู้สร้างคำขอ</div>
                <div class="text-center my-2">
                    ( <span t-field="o.user_id" />
                    )
                </div>
            </div>
            <div class="my-5" />
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /></div>
                <div class="text-center"> ( <span t-field="o.requested_by" /> ) </div>
                <div class="text-center"> คณบดี <span
                        t-out="o.department_id.master_department_id.name" />
                </div>
            </div>
        </div>
        <div class="my-5" />
    </template>
</odoo>
