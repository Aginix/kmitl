<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_inherit" model="ir.ui.view">
        <field name="name">view.purchase.request.form.inherit</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="before">
                <field name="has_approval" invisible="1" />
                <button name="action_create_approval" type="object" string="บันทึกคู่ค้า" class="btn-primary" groups="purchase_request_kmitl.group_purchase_request_user_all" attrs="{
            'invisible': ['|', ('state','!=','approved'), ('has_approval','=',True)]
        }"/>
            </xpath>
            <xpath expr="//button[@name='button_done']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="after">
                <field name="approval_id" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
