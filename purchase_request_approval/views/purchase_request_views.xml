<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="request_approval_count" invisible="1" />
                <button
                    type="object"
                    name="action_view_request_approval"
                    class="oe_stat_button"
                    attrs="{'invisible':[('request_approval_count', '=', 0)]}"
                    groups="purchase.group_purchase_user"
                    icon="fa-file-contract"
                    string="PA"
                />
            </xpath>
            <xpath expr="//button[@name='action_submit_to_sarabun']" position="after">
                <field name="can_resume_returned_sarabun" invisible="1" />
                <button
                    name="action_resume_returned_sarabun"
                    string="ส่งเรื่องสารบรรณ"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('can_resume_returned_sarabun', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
