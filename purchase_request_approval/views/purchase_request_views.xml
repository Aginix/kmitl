<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="request_approval_count" invisible="1" />
                <button
                    type="object"
                    name="action_view_request_approval"
                    class="oe_stat_button"
                    attrs="{'invisible':[('request_approval_count', '=', 0)]}"
                    groups="purchase.group_purchase_user"
                    icon="fa-file-contract"
                    string="PA"
                />
            </xpath>
            <!-- state ที่โมดูลนี้เป็นเจ้าของ ต่อเข้า states ของ button_cancel เอง -->
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="states" add="in_approval" separator="," />
            </xpath>
        </field>
    </record>

</odoo>
