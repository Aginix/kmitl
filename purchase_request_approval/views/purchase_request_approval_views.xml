<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View purchase.request.approval View Tree -->
    <record id="view_purchase_request_approval_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.tree</field>
        <field name="model">purchase.request.approval</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="state in ('approved')"
                decoration-muted="state == 'draft'"
                decoration-warning="state == 'to_approve'"
                decoration-danger="state in ('cancelled', 'rejected')"
                create="0"
                edit="0"
                delete="0"
            >
            <field name="name" optional="show"/>
            <field name="title" optional="show"/>
            <field name="date_start" widget="date" optional="show"/>
            <field name="approval_date" widget="date" optional="show"/>
            <field name="estimated_cost" optional="show"/>
            <field name="procurement_type_id" optional="show"/>
            <field name="procurement_method_id" optional="show"/>
            <field name="active_sarabun_document_id" optional="show"/>

            <field name="activity_ids" widget="list_activity" optional="hide" />
            <field
                name="state"
                widget="badge"
                decoration-success="state in ('approved')"
                decoration-muted="state == 'draft'"
                decoration-warning="state == 'to_approve'"
                decoration-danger="state in ('cancelled', 'rejected')"
                optional="show"
            />
            <field name="account_fiscal_year_id" optional="show"/>
            <field name="department_id" optional="show"/>
            <field
                name="requested_by"
                widget="many2one_avatar_user"
                optional="show"
            />
            </tree>
        </field>
    </record>

    <!-- View purchase.request.approval form -->
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form</field>
        <field name="model">purchase.request.approval</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Approval">
                <header>
                    <button
                        name="button_draft"
                        states="to_approve,cancelled,rejected"
                        string="Reset"
                        type="object"
                        groups="purchase_request.group_purchase_request_manager"
                    />
                    <button
                        name="button_draft"
                        states="approved"
                        string="Reset"
                        type="object"
                        groups="base.group_erp_manager"
                    />
                    <field name="sarabun_document_count" invisible="1" />
                    <field name="sarabun_has_live_document" invisible="1" />
                    <button
                        name="action_submit_to_sarabun"
                        string="Create Sarabun"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('sarabun_has_live_document', '=', True)]}"
                    />
                    <button
                        name="button_to_approve"
                        string="Request approval"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('id', '>', 0)]}"
                    />
                    <button
                        name="button_cancel"
                        states="draft,to_approve"
                        string="Cancel"
                        type="object"
                        groups="purchase_request.group_purchase_request_manager"
                    />
                    <button
                        name="action_open_material_withdrawal_wizard"
                        string="พิมพ์ใบเบิกวัสดุ"
                        type="object"
                        states="approved"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,to_approve,approved,rejected"
                        statusbar_colors='{"approved":"blue"}'
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_request"
                            icon="fa-shopping-cart"
                            string="Purchase Request"
                        />
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="open_preview"
                            icon="fa-search-plus"
                            string="Preview"
                        />
                        <button
                            type="object"
                            name="action_view_sarabun_documents"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            attrs="{'invisible': [('sarabun_document_count', '=', 0)]}"
                            string="Sarabun Document"
                        />
                    </div>
                    <!-- Sarabun status notification on the origin record -->
                    <field name="sarabun_is_draft" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="alert"
                         attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                        <i class="fa fa-pencil-square-o me-1"/>
                        หนังสือสารบรรณถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                        <button name="action_view_sarabun_documents" type="object"
                                class="btn btn-sm btn-warning ms-2" string="เปิดหนังสือเพื่อส่ง"/>
                    </div>
                    <div class="alert alert-info mb-2" role="alert"
                         attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                        <i class="fa fa-paper-plane me-1"/>
                        สถานะการเดินหนังสือสารบรรณ: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Approved"
                        bg_color="bg-success"
                        attrs="{'invisible': [('state', '!=', 'approved')]}"
                    />
                    <widget
                        name="web_ribbon"
                        title="Cancelled"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('state', '!=', 'cancelled')]}"
                    />
                    <widget
                        name="web_ribbon"
                        title="Rejected"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('state', '!=', 'rejected')]}"
                    />
                    <group>
                        <group name="main_info" string="Main Information">
                            <field name="name" placeholder="Approval Reference..." readonly="1"/>
                            <field name="title" attrs="{'readonly': [('state', '!=', 'draft')]}" />
                            <field name="description" attrs="{'readonly': [('state', '!=', 'draft')]}" />
                            <field name="date_start" readonly="1" />
                            <field name="requested_by" widget="many2one_avatar_user" readonly="1" />
                            <field name="department_id" readonly="1" />
                        </group>
                        <group name="procurement_info" string="Procurement Information">
                            <field name="company_id" invisible="1" />
                            <field name="procurement_type_id" attrs="{'readonly': [('state', '!=', 'draft')]}" widget="selection" />
                            <field name="procurement_method_id" attrs="{'readonly': [('state', '!=', 'draft')]}" widget="selection" />
                            <field name="account_fiscal_year_id" readonly="1" />
                            <field name="estimated_cost" readonly="1"/>
                            <field name="payment_type" readonly="1" />
                            <field
                                name="partner_id"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                                options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                            />
                            <field
                                name="vat_included"
                                required="1"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                            <field
                                name="tax_id"
                                widget="selection"
                                attrs="{'invisible': [('vat_included', '=', 'exclusive')], 'required': [('vat_included', '=', 'inclusive')], 'readonly': [('state', '!=', 'draft')]}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Products">
                            <field name="line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="product_id" readonly="1" />
                                    <field name="name" readonly="1"/>
                                    <field name="product_uom_id"/>
                                    <field name="product_qty"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id" optional="hide"/>
                                    <field name="price_subtotal" widget="monetary" invisible="1"/>
                                    <field name="price_total" widget="monetary" invisible="1"/>
                                    <field name="price_tax" widget="monetary" optional="hide"/>
                                    <field name="estimated_cost" readonly="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1"/>
                                <field name="estimated_cost" invisible="1"/>
                                <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" colspan="2" readonly="1"/>
                            </group>
                        </page>
                        <page name="committee" string="Committee" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}">
                            <separator string="Work Acceptance Committee"/>
                            <field name="work_acceptance_committee_ids" nolabel="1" readonly="1"/>
                            <separator string="TOR Committee"/>
                            <field name="tor_committee_ids" nolabel="1" readonly="1"/>
                            <separator string="Price Determine Committee"/>
                            <field name="price_determine_committee_ids" nolabel="1" readonly="1" />
                            <separator string="Evaluation Committee"/>
                            <field name="evaluation_committee_ids" nolabel="1" readonly="1" />
                        </page>
                        <page name="other_info" string="Other Information">
                            <group>
                                <group>
                                    <field name="origin" readonly="1" />
                                    <field name="assigned_to" readonly="1" />
                                </group>
                                <group>
                                    <field name="approval_date" readonly="1" />
                                    <field name="requesting_department_id" readonly="1" />
                                </group>
                            </group>
                        </page>
                        <page name="document" string="Attachment">
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   context="{'default_res_model': 'purchase.request.approval'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview" />
                <div class="oe_chatter">
                    <field
                        name="message_follower_ids"
                        options="{'post_refresh':True}"
                        groups="base.group_user"
                    />
                    <field name="activity_ids" />
                    <field name="message_ids" options="{'open_attachments': True}" />
                </div>
            </form>
        </field>
    </record>

    <!-- View purchase.request.approval search -->
    <record id="view_purchase_request_approval_search" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.search</field>
        <field name="model">purchase.request.approval</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="to_approve"
                    string="To approve"
                    domain="[('state', '=', 'to_approve')]"
                />
                <filter
                    name="approved"
                    string="Approved"
                    domain="[('state', '=', 'approved')]"
                />
                <separator />
                <filter name="filter_by_fy" string="Fiscal Year" domain="[('account_fiscal_year_id', '!=', False)]"/>
                <filter name="filter_by_dept" string="Department" domain="[('requesting_department_id', '!=', False)]"/>
                <separator />
                <filter
                    name="today"
                    string="Today"
                    domain="[('date_start','&lt;', time.strftime('%%Y-%%m-%%d 23:59:59')), ('date_start','&gt;=', time.strftime('%%Y-%%m-%%d 00:00:00'))]"
                />
                <filter
                    name="yesterday"
                    string="Yesterday"
                    domain="[
                        ('date_start','&lt;', (datetime.date.today()-datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d 23:59:59')),
                        ('date_start','&gt;=',(datetime.date.today()-datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d 00:00:00'))
                    ]"
                />
                <filter
                    name="last_7days"
                    string="Last 7 days"
                    domain="[
                        ('date_start','&lt;', time.strftime('%%Y-%%m-%%d 23:59:59')),
                        ('date_start','&gt;=',(datetime.date.today()-datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d 00:00:00'))
                    ]"
                />
                <filter
                    name="this_month"
                    string="This Month"
                    domain="[('date_start', '>=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                ('date_start', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="this_year"
                    string="This Year"
                    domain="[('date_start', '>=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                                ('date_start', '&lt;', (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"
                />
                <group expand="1" name="group_by" string="Group By">
                    <filter
                        name="group_by_account_fiscal_year_id"
                        string="Fiscal Year"
                        domain="[]"
                        context="{'group_by':'account_fiscal_year_id'}"
                    />
                    <filter
                        name="group_by_department_id"
                        string="Department"
                        domain="[]"
                        context="{'group_by':'department_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="Status"
                        domain="[]"
                        context="{'group_by':'state'}"
                    />
                </group>
                <searchpanel>
                    <field name="department_id" icon="fa-book" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action purchase.request.approval -->
    <record id="action_purchase_request_approval" model="ir.actions.act_window">
        <field name="name">Purchase Request Approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Approval.
            </p>
        </field>
    </record>

    <menuitem
        id="purchase_request_approval_menu"
        parent="purchase.menu_purchase_root"
        action="action_purchase_request_approval"
        groups="purchase.group_purchase_user"
        sequence="4"
    />
    <menuitem
        id="purchase_request_approval_menu_purchase_request"
        parent="purchase_request.parent_menu_purchase_request"
        action="action_purchase_request_approval"
        groups="purchase.group_purchase_user"
        sequence="20"
    />
</odoo>
