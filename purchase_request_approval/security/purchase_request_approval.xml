<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.rule" id="purchase_request_approval_comp_rule">
        <field name="name">Purchase Request Approval multi-company</field>
        <field name="model_id" ref="model_purchase_request_approval" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="purchase_request_approval_followers_rule" model="ir.rule">
        <field name="name">Follow Purchase Request Approval</field>
        <field name="model_id" ref="model_purchase_request_approval" />
        <field
            name="groups"
            eval="[(6,0, [ref('purchase_request.group_purchase_request_user')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">
            ['|',('requested_by','=',user.id), ('message_partner_ids', 'in',
            [user.partner_id.id])]
        </field>
    </record>
    <record id="purchase_request_approval_rule" model="ir.rule">
        <field name="name">Purchase Request Approval User</field>
        <field name="model_id" ref="model_purchase_request_approval" />
        <field
            name="groups"
            eval="[(6,0, [ref('purchase_request.group_purchase_request_user')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('requested_by','=',user.id)]</field>
    </record>
    <record id="purchase_request_approval_user_all_rule" model="ir.rule">
        <field name="name">Purchase Request Approval User All</field>
        <field name="model_id" ref="model_purchase_request_approval" />
        <field
            name="groups"
            eval="[(6,0, [ref('purchase_request_kmitl.group_purchase_request_user_all')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record id="purchase_request_approval_manager_rule" model="ir.rule">
        <field name="name">Purchase Request Approval Manager</field>
        <field name="model_id" ref="model_purchase_request_approval" />
        <field
            name="groups"
            eval="[(6,0, [ref('purchase_request.group_purchase_request_manager')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
