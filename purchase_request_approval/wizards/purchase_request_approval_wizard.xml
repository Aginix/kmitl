<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_approval_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.approval.wizard.form</field>
        <field name="model">purchase.request.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Approval">
                <div class="alert alert-warning" role="alert">
                    ถ้าจำนวนเงิน 100,000 บาท กรุณาดำเนินการ EGP ให้เสร็จสิ้นก่อนดำเนินการกรอกแบบฟอร์ม
                </div>
                <group>
                    <field name="vendor_id"/>
                    <field name="purchase_request_name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
