<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View work.acceptance form -->
    <record id="view_work_acceptance_form" model="ir.ui.view">
        <field name="name">view.work.acceptance.form Attachment</field>
        <field name="model">work.acceptance</field>
        <field name="inherit_id" ref="purchase_work_acceptance.view_work_acceptance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
              <page name="document" string="Attachment">
                    <field name="attachment_ids" 
                          attrs="{'readonly': [('state', '!=', 'draft')]}" 
                          context="{'default_res_model': 'work.acceptance'}">
                        <tree default_order="sequence">
                            <field name="sequence" widget="handle"/>
                            <field name="name" string="File Name" required="1"/>
                            <field name="description"/>
                        </tree>
                        <form>
                            <sheet>
                                <group>
                                    <field name="res_model" invisible="1" readonly="0"/>
                                    <field name="res_id" invisible="1" readonly="0"/>
                                    <field name="name" required="1" invisible="1"/>
                                    <field name="datas" filename="name" required="1"/>
                                    <field name="description" placeholder="Description"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

  </odoo>