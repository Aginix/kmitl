<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- noupdate: switching a rule off (active) or making it non-blocking must
         survive a module upgrade. -->
    <data noupdate="1">
        <record id="budget_transfer_excep_core_dimensions" model="exception.rule">
            <field name="name">ระบุมิติหลักไม่ครบ 4 มิติ</field>
            <field
                name="description"
            >ทุกรายการโอนต้องระบุมิติหลักครบ 4 มิติ (ส่วนงาน/แหล่งเงิน/กิจกรรม/กองทุน)</field>
            <field name="sequence">1</field>
            <field name="model">budget.transfer</field>
            <field name="exception_type">by_method</field>
            <field name="method">budget_transfer_check_core_dimensions</field>
            <field name="is_blocking" eval="True" />
            <field name="active" eval="True" />
        </record>
        <record id="budget_transfer_excep_budget_availability" model="exception.rule">
            <field name="name">งบประมาณคงเหลือไม่เพียงพอ</field>
            <field
                name="description"
            >รายการโอนออก (FROM) ต้องมีงบประมาณคงเหลือเพียงพอกับจำนวนเงินที่โอน</field>
            <field name="sequence">2</field>
            <field name="model">budget.transfer</field>
            <field name="exception_type">by_method</field>
            <field name="method">budget_transfer_check_budget_availability</field>
            <field name="is_blocking" eval="True" />
            <field name="active" eval="True" />
        </record>
        <record id="budget_transfer_excep_both_tags" model="exception.rule">
            <field name="name">รายการมีทั้งโครงการและแผนจัดซื้อจัดจ้าง</field>
            <field
                name="description"
            >แต่ละรายการโอนระบุมิติเสริมได้เพียงอย่างเดียว — โครงการ/กิจกรรม หรือ แผนจัดซื้อจัดจ้าง อย่างใดอย่างหนึ่ง</field>
            <field name="sequence">3</field>
            <field name="model">budget.transfer</field>
            <field name="exception_type">by_method</field>
            <field name="method">budget_transfer_check_both_tags</field>
            <field name="is_blocking" eval="True" />
            <field name="active" eval="True" />
        </record>
        <record id="budget_transfer_excep_tag_account_mismatch" model="exception.rule">
            <field name="name">มิติเสริมไม่ตรงกับประเภทรหัสงบประมาณ</field>
            <field
                name="description"
            >มิติโครงการ/กิจกรรมใช้ได้กับรหัสงบประมาณประเภทโครงการเท่านั้น และมิติแผนจัดซื้อจัดจ้างใช้ได้กับรหัสงบประมาณประเภทแผนจัดซื้อจัดจ้างเท่านั้น</field>
            <field name="sequence">4</field>
            <field name="model">budget.transfer</field>
            <field name="exception_type">by_method</field>
            <field name="method">budget_transfer_check_tag_account_mismatch</field>
            <field name="is_blocking" eval="True" />
            <field name="active" eval="True" />
        </record>
        <record id="budget_transfer_excep_duplicate_lines" model="exception.rule">
            <field name="name">รายการโอนซ้ำกัน</field>
            <field
                name="description"
            >รายการโอนที่มีทิศทาง รหัสงบประมาณ และมิติทางบัญชีเดียวกันต้องไม่ซ้ำกัน</field>
            <field name="sequence">5</field>
            <field name="model">budget.transfer</field>
            <field name="exception_type">by_method</field>
            <field name="method">budget_transfer_check_duplicate_lines</field>
            <field name="is_blocking" eval="True" />
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
