<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- (1) Filtered exception-rule shortcut — only the budget.transfer rules,
         under Budget › Configuration (base_exception's own menu lists every
         model's rules together). -->
    <record id="action_budget_transfer_exception_rule_tree" model="ir.actions.act_window">
        <field name="name">Budget Transfer Exception Rules</field>
        <field name="res_model">exception.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="base_exception.view_exception_rule_tree" />
        <field name="domain">[('model', '=', 'budget.transfer')]</field>
        <field name="context">{'active_test': False, 'default_model': 'budget.transfer'}</field>
    </record>
    <menuitem
        id="menu_budget_transfer_exception_rule"
        name="Budget Transfer Exceptions"
        action="action_budget_transfer_exception_rule_tree"
        parent="budget.budget_config_menu"
        sequence="60"
        groups="base_exception.group_exception_rule_manager"
    />

    <!-- (2) Show the detected exceptions on the transfer form itself, so the
         reviewer sees why ยืนยัน was blocked without re-triggering the popup.
         exception_ids is written on the submit attempt, so the banner persists
         on the record afterwards. -->
    <record id="view_budget_transfer_form_exception" model="ir.ui.view">
        <field name="name">budget.transfer.form.exception</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    attrs="{'invisible': [('exceptions_summary', '=', False)]}"
                >
                    <field name="ignore_exception" invisible="1" />
                    <p>
                        <strong>รายการนี้ติดเงื่อนไขตรวจทาน (ยังยืนยันไม่ได้):</strong>
                    </p>
                    <field name="exceptions_summary" />
                    <button
                        name="action_ignore_exceptions"
                        type="object"
                        class="btn-warning"
                        string="ข้ามเงื่อนไข (Ignore)"
                        help="ข้ามเฉพาะเงื่อนไขที่ไม่ใช่ blocking เพื่อยืนยันรายการนี้"
                        groups="base_exception.group_exception_rule_manager"
                    />
                </div>
            </sheet>
        </field>
    </record>

    <!-- (3) List: an optional column + a search filter to spot transfers that
         currently carry a review exception (main_exception_id is stored). -->
    <record id="view_budget_transfer_tree_exception" model="ir.ui.view">
        <field name="name">budget.transfer.tree.exception</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="main_exception_id"
                    string="เงื่อนไขตรวจทาน"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record id="view_budget_transfer_search_exception" model="ir.ui.view">
        <field name="name">budget.transfer.search.exception</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_search" />
        <field name="arch" type="xml">
            <filter name="cancelled" position="after">
                <separator />
                <filter
                    name="has_exception"
                    string="ติดเงื่อนไขตรวจทาน"
                    domain="[('main_exception_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>
</odoo>
