<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View work.acceptance form -->
    <record id="view_work_acceptance_form" model="ir.ui.view">
        <field name="name">view.work.acceptance.form</field>
        <field name="model">work.acceptance</field>
        <field
            name="inherit_id"
            ref="purchase_work_acceptance.view_work_acceptance_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_receive']" position="after">
                <field name="requested_delivery_date" required="1" />
            </xpath>

            <xpath expr="//field[@name='date_due']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>

            <xpath expr="//field[@name='date_receive']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>

            <xpath
                expr="//field[@name='wa_line_ids']/tree/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="confirm">Are you sure you want to Cancel?</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_work_acceptance_notebook_form" model="ir.ui.view">
        <field name="name">view.work.acceptance.form</field>
        <field name="model">work.acceptance</field>
        <field
            name="inherit_id"
            ref="l10n_th_gov_work_acceptance.view_work_acceptance_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="replace">
                <field name="mobile_phone" />
            </xpath>
            <xpath expr="//field[@name='wa_tier_validation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='%(l10n_th_gov_work_acceptance.action_view_wa_evaluation_result)d']"
                position="attributes"
            >
                <attribute name="groups"
                    >purchase_work_acceptance_evaluation.group_enable_eval_on_wa</attribute
                >
            </xpath>
        </field>
    </record>

    <record id="view_purchase_work_acceptance_inherit_view_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.exception.inherit.view.tree</field>
        <field name="model">work.acceptance</field>
        <field
            name="inherit_id"
            ref="purchase_work_acceptance.view_work_acceptance_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_ref']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_l10n_work_acceptance_form" model="ir.ui.view">
        <field name="name">view.l10n.work.acceptance.form</field>
        <field name="model">work.acceptance</field>
        <field
            name="inherit_id"
            ref="l10n_th_gov_work_acceptance.view_work_acceptance_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='work_acceptance_committee_ids']"
                position="attributes"
            >
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_work_acceptance_form_tier_validation_custom" model="ir.ui.view">
        <field name="name">view.work.acceptance.form.tier_validation.custom</field>
        <field name="model">work.acceptance</field>
        <field
            name="inherit_id"
            ref="l10n_th_gov_work_acceptance.view_work_acceptance_form_tier_validation"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@class='alert alert-warning']//button[contains(@class, 'btn-danger') and @icon='fa-thumbs-down']"
                position="attributes"
            >
                <attribute name="name">reject_tier</attribute>
                <attribute name="context" />
            </xpath>

            <xpath
                expr="//div[@class='alert alert-warning']//button[contains(@class, 'btn-warning') and @icon='fa-arrow-circle-right']"
                position="attributes"
            >
                <attribute name="attrs">{'invisible': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
