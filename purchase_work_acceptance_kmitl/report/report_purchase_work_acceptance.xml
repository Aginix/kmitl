<odoo>
    <template id="report_purchase_work_acceptance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.currency_id" />
                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        table.budget tr td:first-child {
                            width: 30%;
                        }
                        p,
                        span,
                        div {
                            font-size: 16pt;
                            line-height: 1.2;
                        }
                    </style>

                    <div class="page">
                        <div class="text-center" style="margin-top: 0px">
                            <img
                                t-if="o.purchase_id.request_id.company_id.logo"
                                t-att-src="image_data_uri(o.purchase_id.request_id.company_id.logo)"
                                style="max-height: 110px"
                                alt="Logo"
                            />
                        </div>
                        <div style="position: absolute; top: 0px; right: 0px">
                            <div>แบบ พ.36</div>
                        </div>
                        <div class="oe_structure" />
                        <div style="height: 1px" />
                        <div class="page-header mt-3 mb-3">
                            <h3
                                class="text-center fw-bolder"
                                style="line-height: 1.575"
                            >
                                ใบตรวจรับพัสดุ
                            </h3>
                            <p class="text-center">
                                สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง
                            </p>
                        </div>
                        <div class="row">
                            <div class="col-8" />
                            <div class="col">
                                <p>เลขที่ อว.123</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-8">
                                ได้รับของจาก
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.partner_id.name"
                                />
                            </div>
                            <div class="col">
                                วันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.date_receive)"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                ตามใบสั่งซื้อเลขที่ เลขที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.name"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                ตามสัญญาซื้อขาย เลขที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.contract_number"
                                />
                                ลงวันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.purchase_id.date_order_date)"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                ตามใบส่งมอบงาน เลขที่
                                <span class="ms-2 fw-bolder text-decoration-underline">
                                    31231s213
                                </span>
                                ลงวันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.requested_delivery_date)"
                                />
                                ดังรายการต่อไปนี้
                            </div>
                        </div>
                        <table class="table table-bordered table-sm mb-4">
                            <thead>
                                <tr>
                                    <th
                                        rowspan="2"
                                        style="width: 5%; text-align: center"
                                    >
                                        ลำดับที่
                                    </th>
                                    <th
                                        rowspan="2"
                                        style="width: 35%; text-align: center"
                                    >
                                        รายการ
                                    </th>
                                    <th
                                        rowspan="2"
                                        style="width: 10%; text-align: center"
                                    >
                                        หน่วยนับ
                                    </th>
                                    <th
                                        colspan="3"
                                        style="width: 25%; text-align: center"
                                    >
                                        จำนวนหน่วย
                                    </th>
                                    <th
                                        rowspan="2"
                                        style="width: 15%; text-align: center"
                                    >
                                        เป็นเงิน
                                    </th>
                                </tr>
                                <tr>
                                    <th style="text-align: center">
                                        ตามใบสั่งซื้อ/จ้าง
                                    </th>
                                    <th style="text-align: center">ตามใบส่งของ</th>
                                    <th style="text-align: center">ตามที่รับจริง</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="row_no" t-value="1" />
                                <t t-foreach="o.wa_line_ids" t-as="line">
                                    <tr>
                                        <td
                                            class="text-center"
                                            style="width: 8%"
                                            t-out="row_no"
                                        />
                                        <td t-out="line.name" />
                                        <td class="text-center">
                                            <span t-field="line.product_uom" />
                                        </td>
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.purchase_line_id.product_qty)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.product_qty)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.product_qty)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.price_subtotal)"
                                        />
                                    </tr>
                                    <t t-set="row_no" t-value="row_no + 1" />
                                </t>
                                <tr>
                                    <td
                                        colspan="5"
                                        rowspan="3"
                                        class="text-center align-middle"
                                    >
                                        (
                                        <t
                                            t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(
    sum(o.wa_line_ids.mapped('price_subtotal'))
)"
                                        />
                                        )
                                    </td>
                                    <td class="text-center">
                                        ราคาก่อนรวมภาษีมูลค่าเพิ่ม
                                    </td>
                                    <td
                                        class="text-end"
                                        t-esc="'{0:,.2f}'.format(sum(o.wa_line_ids.mapped('price_subtotal')))"
                                    />
                                </tr>
                                <tr>
                                    <td class="text-center">ภาษีมูลค่าเพิ่ม</td>
                                    <td
                                        class="text-end"
                                        t-esc="'{0:,.2f}'.format(sum(o.wa_line_ids.mapped('price_subtotal')))"
                                    />
                                </tr>
                                <tr>
                                    <td class="text-center">รวมเป็นเงินทั้งสิ้น</td>
                                    <td
                                        class="text-end"
                                        t-esc="'{0:,.2f}'.format(sum(o.wa_line_ids.mapped('price_subtotal')))"
                                    />
                                </tr>
                            </tbody>
                        </table>
                        <div class="col-6 text-center">
                            <div>
                                ลงชื่อ
                                <span
                                    style="
                                        display: inline-block;
                                        width: 200px;
                                        border-bottom: 1px dotted #000;
                                    "
                                ></span>
                                ผู้รับพัสดุ/เจ้าหน้าที่พัสดุ
                            </div>
                            <div class="mt-2">
                                (<span
                                    t-esc="o.work_acceptance_committee_ids[0].name"
                                />)
                            </div>
                        </div>
                        <div class="my-5" style="height: 10px" />
                        <div class="row">
                            <div class="col">ส่วนบันทึกคณะกรรมการตรวจรับพัสดุ</div>
                        </div>
                        <div class="row">
                            <div class="col">เรียน อธิการบดี</div>
                        </div>
                        <div class="row">
                            <div class="col">
                                คณะกรรมการตรวจรับพัสดุได้พร้อมกันตรวจรับพัสดุซึ่ง
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.partner_id.name"
                                />
                                / (ผู้ขาย) ได้ส่งมอบพัสดุ ให้แก่
                                สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง (ผู้ซื้อ)
                                ตามข้อตกลงและสัญญาจ้างข้างต้น เป็นที่เรียบร้อยแล้ว
                                โดยการนี้
                                ได้ดำเนินการตรวจสอบแล้วถูกต้องตามสัญญา/ข้อตกลงตั้งแต่วันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.date_receive)"
                                />
                                และได้ตรวจรับพัสดุเรียบร้อยแล้ว ตั้งแต่วันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.date_receive)"
                                />
                                ผู้ขาย/ผู้รับจ้างควรได้รับเงินตามสัญญา ข้อ 1. เป็นเงิน
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="sum(o.wa_line_ids.mapped('price_subtotal'))"
                                />
                                บาท (
                                <t
                                    t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(
    sum(o.wa_line_ids.mapped('price_subtotal'))
)"
                                />
                                ) เกินกำหนดสัญญาหรือข้อตกลง ตั้งแต่วันที่…-….
                                เดือน...…-…..….พ.ศ…...-…...ถึงวันที่…..-….…เดือน.....-........พ.ศ......…-...เป็นเวลา.....…-……..วัน
                                คงส่งมอบของล่าช้าเกินกำหนดสัญญา/ข้อตกลงไป……-…...วัน
                                จะต้องเสียค่าปรับ วันละ..…-…….บาท (..……-….....)
                                รวมเป็นเงิน…..-…...บาท (…...…-....….) คงได้รับเงินงวดนี้
                                เป็นเงิน
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="sum(o.wa_line_ids.mapped('price_subtotal'))"
                                />
                                บาท (
                                <t
                                    t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(
    sum(o.wa_line_ids.mapped('price_subtotal'))
)"
                                />
                                )
                            </div>
                        </div>
                        <div class="my-5" style="height: 10px" />
                        <t t-foreach="o.work_acceptance_committee_ids" t-as="line">
                            <div class="row mt-4">
                                <div class="col-6 offset-6 text-center">
                                    <div style="white-space: nowrap">
                                        (ลงชื่อ)
                                        <span
                                            style="
                                                display: inline-block;
                                                width: 200px;
                                                border-bottom: 1px dotted #000;
                                            "
                                        ></span>
                                        <span t-field="line.approve_role" />
                                    </div>
                                    <div class="mt-2">(<span t-esc="line.name" />)</div>
                                </div>
                            </div>
                        </t>
                        <div class="my-5" style="height: 10px" />
                        <div class="row">
                            <div class="col">ส่วนบันทึกงานพัสดุ</div>
                        </div>
                        <div class="row">
                            <div class="col ms-5">
                                ด้วยสำนักงานพัสดุ สำนักงานอธิการบดี
                                มีความประสงค์ขอเบิกเงินรายได้ ประจำปี 2568
                                ตามรายละเอียดดังต่อไปนี้
                            </div>
                        </div>
                        <table class="table table-borderless table-sm">
                            <tbody>
                                <tr>
                                    <td style="width: 60%">
                                        สำนักบริหารข้อมูลดิจิทัลฯ
                                    </td>
                                    <td>รหัสสำนักงาน</td>
                                    <td>09</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">กองทุนสินทรัพย์ถาวร</td>
                                    <td>รหัสกองทุน</td>
                                    <td>0600</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">
                                        แผนงาน จัดการศึกษาอุดมศึกษา
                                    </td>
                                    <td>รหัสแผนงาน</td>
                                    <td>09007</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">
                                        งาน - กิจกรรมหลัก งานสนับสนุนการจัดการศึกษา
                                    </td>
                                    <td>รหัส - กิจกรรมหลัก</td>
                                    <td>0101</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">
                                        - กิจกรรมรอง บริการคอมพิวเตอร์ทางวิชาการ
                                    </td>
                                    <td>- กิจกรรมรอง</td>
                                    <td>13</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">
                                        - กิจกรรมย่อย งานด้านบริการคอมพิวเตอร์
                                    </td>
                                    <td>- กิจกรรมย่อย</td>
                                    <td>134</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">งบรายจ่าย งบลงทุน</td>
                                    <td>รหัสงบรายจ่าย</td>
                                    <td>53000</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">ค่าใช้จ่ายงบลงทุน</td>
                                    <td>รหัสประเภทรายจ่าย</td>
                                    <td>53100</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">ครุภัณฑ์</td>
                                    <td>รหัส</td>
                                    <td>5412000000</td>
                                </tr>
                                <tr>
                                    <td style="width: 60%">ค่าครุภัณฑ์คอมพิวเตอร์</td>
                                    <td>รหัส</td>
                                    <td>5412000003</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col">
                                จำนวนเงิน
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="sum(o.wa_line_ids.mapped('price_subtotal'))"
                                />
                                บาท (
                                <t
                                    t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(
    sum(o.wa_line_ids.mapped('price_subtotal'))
)"
                                />)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col ms-5">
                                จึงเรียนมาเพื่อทราบรายงานการตรวจรับพัสดุของคณะกรรมการและเห็นควรแจ้งหน่วยงานที่เกี่ยวข้องเพื่อดำเนินการต่อไป
                            </div>
                        </div>
                        <div class="my-5" style="height: 10px" />
                        <div class="row mt-4">
                            <div class="col-6 offset-6 text-center">
                                <div style="white-space: nowrap">
                                    ลงชื่อ
                                    <span
                                        style="
                                            display: inline-block;
                                            width: 200px;
                                            border-bottom: 1px dotted #000;
                                        "
                                    ></span>
                                    <span>ผู้อำนวยการสำนักงานพัสดุ</span>
                                </div>
                                <div class="mt-2">
                                    (<span>นางสาวกรองทิพย์ สกุนตศรี</span>)
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-6 offset-6 text-center fw-bolder">
                                ทราบ/ดำเนินการเสนอ
                            </div>
                        </div>
                        <div class="my-5" style="height: 10px" />
                        <div class="row mt-4">
                            <div class="col-6 offset-6 text-center">
                                (รองศาสตราจารย์ไพฑูรย์ พิมดี)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 offset-6 text-center">
                                รองอธิการบดีฝ่ายพัสดุ ปฏิบัติการแทน
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 offset-6 text-center">อธิการบดี</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
