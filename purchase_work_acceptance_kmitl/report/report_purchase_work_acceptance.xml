<odoo>
    <template id="report_purchase_work_acceptance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.currency_id" />
                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        table.budget tr td:first-child {
                            width: 30%;
                        }
                        p,
                        span,
                        div {
                            font-size: 16pt;
                            line-height: 1.2;
                        }
                    </style>

                    <div class="page">
                        <div class="text-center" style="margin-top: 0px">
                            <img
                                t-if="o.purchase_id.request_id.company_id.logo"
                                t-att-src="image_data_uri(o.purchase_id.request_id.company_id.logo)"
                                style="max-height: 110px"
                                alt="Logo"
                            />
                        </div>
                        <div style="position: absolute; top: 0px; right: 0px">
                            <div>แบบ พ.36</div>
                        </div>
                        <div class="oe_structure" />
                        <div style="height: 1px" />
                        <div class="page-header mt-3 mb-3">
                            <h3
                                class="text-center fw-bolder"
                                style="line-height: 1.575"
                            >
                                ใบตรวจรับพัสดุ
                            </h3>
                            <p class="text-center">
                                สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง
                            </p>
                        </div>
                        <div class="row">
                            <div class="col-8" />
                            <div class="col">
                                <p>เลขที่ อว.123</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-8">
                                ได้รับของจาก
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.partner_id.name"
                                />
                            </div>
                            <div class="col">
                                วันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.date_receive)"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                ตามใบสั่งซื้อเลขที่ เลขที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.name"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                ตามสัญญาซื้อขาย เลขที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-out="o.purchase_id.contract_number"
                                />
                                ลงวันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.purchase_id.date_order_date)"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                ตามใบส่งมอบงาน เลขที่
                                <span class="ms-2 fw-bolder text-decoration-underline">
                                    31231s213
                                </span>
                                ลงวันที่
                                <span
                                    class="ms-2 fw-bolder text-decoration-underline"
                                    t-esc="o.format_date_thai(o.requested_delivery_date)"
                                />
                                ดังรายการต่อไปนี้
                            </div>
                        </div>
                        <table class="table table-bordered table-sm mb-4">
                            <thead>
                                <tr>
                                    <th
                                        rowspan="2"
                                        style="width: 5%; text-align: center"
                                    >
                                        ลำดับที่
                                    </th>
                                    <th
                                        rowspan="2"
                                        style="width: 35%; text-align: center"
                                    >
                                        รายการ
                                    </th>
                                    <th
                                        rowspan="2"
                                        style="width: 10%; text-align: center"
                                    >
                                        หน่วยนับ
                                    </th>
                                    <th
                                        colspan="3"
                                        style="width: 25%; text-align: center"
                                    >
                                        จำนวนหน่วย
                                    </th>
                                    <th
                                        rowspan="2"
                                        style="width: 15%; text-align: center"
                                    >
                                        เป็นเงิน
                                    </th>
                                </tr>
                                <tr>
                                    <th style="text-align: center">
                                        ตามใบสั่งซื้อ/จ้าง
                                    </th>
                                    <th style="text-align: center">ตามใบส่งของ</th>
                                    <th style="text-align: center">ตามที่รับจริง</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="row_no" t-value="1" />
                                <t t-foreach="o.wa_line_ids" t-as="line">
                                    <tr>
                                        <td
                                            class="text-center"
                                            style="width: 8%"
                                            t-out="row_no"
                                        />
                                        <td t-out="line.name" />
                                        <td class="text-center">
                                            <span t-field="line.product_uom" />
                                        </td>
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.purchase_line_id.product_qty)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.product_qty)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.product_qty)"
                                        />
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.price_subtotal)"
                                        />
                                    </tr>
                                    <t t-set="row_no" t-value="row_no + 1" />
                                </t>
                            </tbody>
                        </table>
                        <div class="my-5" style="height: 10px" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
