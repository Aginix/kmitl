<odoo>
    <template id="report_purchase_work_acceptance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.currency_id" />
                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        table.budget tr td:first-child {
                            width: 30%;
                        }
                        p,
                        span,
                        div {
                            font-size: 16pt;
                            line-height: 1.2;
                        }
                    </style>

                    <div class="page">
                        <div class="text-center" style="margin-top: 0px">
                            <img
                                t-if="o.purchase_id.request_id.company_id.logo"
                                t-att-src="image_data_uri(o.purchase_id.request_id.company_id.logo)"
                                style="max-height: 110px"
                                alt="Logo"
                            />
                        </div>
                        <div style="position: absolute; top: 0px; right: 0px">
                            <div>แบบ พ.36</div>
                        </div>
                        <div class="oe_structure" />
                        <div style="height: 1px" />
                        <div class="page-header mt-3 mb-5">
                            <h3
                                class="text-center fw-bolder"
                                style="line-height: 1.575"
                            >
                                ใบตรวจรับพัสดุ
                            </h3>
                            <p class="text-center">
                                สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง
                            </p>
                        </div>
                        <div class="my-5" style="height: 10px" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
