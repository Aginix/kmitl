<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_comment_wizard_inherit" model="ir.ui.view">
        <field name="name">comment.wizard.inherit</field>
        <field name="model">comment.wizard</field>
        <field name="inherit_id" ref="base_tier_validation.view_comment_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='comment']" position="replace">
                <field name="is_wa_model" invisible="1"/>
                <field
                    name="comment_selection"
                    nolabel="0"
                    attrs="{'invisible': [('is_wa_model', '=', True)]}"
                />
                <field
                    name="comment"
                    nolabel="0"
                    attrs="{'invisible': [('is_wa_model', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>