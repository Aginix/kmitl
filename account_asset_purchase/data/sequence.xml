<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Procurement -->
        <record id="seq_asset_batch_procurement" model="ir.sequence">
            <field name="name">Asset Batch Procurement</field>
            <field name="code">asset.batch.procurement</field>
            <field name="prefix">PROC/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Donation -->
        <record id="seq_asset_batch_donation" model="ir.sequence">
            <field name="name">Asset Batch Donation</field>
            <field name="code">asset.batch.donation</field>
            <field name="prefix">DON/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Transfer -->
        <record id="seq_asset_batch_transfer" model="ir.sequence">
            <field name="name">Asset Batch Transfer</field>
            <field name="code">asset.batch.transfer</field>
            <field name="prefix">TRAN/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>