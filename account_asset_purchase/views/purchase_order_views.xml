<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order form -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="has_storable_product" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_asset_batch"
                        string="Asset Batch"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        attrs="{'invisible': [('has_storable_product', '=', False)]}">
                        <field name="asset_count" widget="statinfo" string="Asset Batch"/>
                </button>
            </xpath>
        </field>
    </record>

  </odoo>