<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.asset.batch View Tree -->
    <record id="view_account_asset_batch_tree" model="ir.ui.view">
        <field name="name">view.account.asset.batch.tree</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View account.asset.batch form -->
    <record id="view_account_asset_batch_form" model="ir.ui.view">
        <field name="name">view.account.asset.batch.form</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <form string="Asset Registration">
                <header>
                
                    <button name="action_register_assets" type="object"
                            string="Register Asset" states="draft" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_asset_items"
                                string="Asset"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-archive"
                                attrs="{'invisible': [('id', '=', False)]}"
                        />
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="account_fiscal_year_id"/>
                        <field name="operating_unit_id"/>
                        <field name="purchase_id" readonly="1"/>
                        <field name="company_id" />
                        <field name="notes" />
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="profile_id"/>
                                    <field name="amount"/>
                                    <field name="gpsc_id"/>
                                    <field name="price_per_unit"/>
                                    <field name="amount_total" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View account.asset.batch search -->
    <record id="view_account_asset_batch_search" model="ir.ui.view">
        <field name="name">view.account.asset.batch.search</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action account.asset.batch -->
    <record id="action_account_asset_batch" model="ir.actions.act_window">
        <field name="name">Account Asset Batch</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Account Asset Batch.
            </p>
        </field>
    </record>

</odoo>
