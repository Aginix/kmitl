<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.asset.batch View Tree -->
    <record id="view_account_asset_batch_tree" model="ir.ui.view">
        <field name="name">view.account.asset.batch.tree</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="account_fiscal_year_id" optional="hide"/>
                <field name="purchase_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="operating_unit_id" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- View account.asset.batch form -->
    <record id="view_account_asset_batch_form" model="ir.ui.view">
        <field name="name">view.account.asset.batch.form</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <form string="Asset Registration">
                <header>                
                    <button name="action_register_assets" type="object"
                            string="Register Asset" states="draft" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_asset_items"
                            string="Asset"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                            attrs="{'invisible': [('state', '!=', 'done')]}">
                            <field name="asset_count" widget="statinfo" string ="Asset"/>
                        </button>

                    </div>
                    <widget name="web_ribbon" title="Done" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'done')]}" />
                    <group>
                        <field name="is_editable" invisible="1"/>
                        <field name="name" attrs="{'readonly': [('is_editable', '=', False)]}"/>
                        <field name="date" invisible="1"/>
                        <field name="account_fiscal_year_id"/>
                        <field name="operating_unit_id"/>
                        <field name="department_id" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field name="contract_number"/>
                        <field name="purchase_id" readonly="1"/>
                        <field name="source_of_asset" required="1" attrs="{'readonly': [('is_editable','=', False)]}" widget="radio" options="{'horizontal': true}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="notes" />
                    </group>
                    <notebook>
                        <page string="List">
                            <field name="line_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Dell Computer All in one Set"/>
                                    <field name="profile_id"/>
                                    <field name="gpsc_id"/>
                                    <field name="amount"/>
                                    <field name="price_per_unit"/>
                                    <field name="amount_total" readonly="1"/>
                                </tree>
                            </field>

                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1" />
                                <field class="fw-bold" widget="monetary" options="{'currency_field': 'currency_id'}" name="total_amount" readonly="1"/>
                            </group>
                            
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View account.asset.batch search -->
    <record id="view_account_asset_batch_search" model="ir.ui.view">
        <field name="name">view.account.asset.batch.search</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action account.asset.batch -->
    <record id="action_account_asset_batch" model="ir.actions.act_window">
        <field name="name">Asset Batch</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Account Asset Batch.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_assets_batch"
        name="Asset Batch"
        parent="account_asset_usability_kmitl.menu_assets"
        action="action_account_asset_batch"
    />

</odoo>
