<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.report View Tree -->
    <record id="view_purchase_request_report_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.report.tree</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View purchase.request.report form -->
    <record id="view_purchase_request_report_form" model="ir.ui.view">
        <field name="name">view.purchase.request.report.form</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Report">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View purchase.request.report search -->
    <record id="view_purchase_request_report_search" model="ir.ui.view">
        <field name="name">view.purchase.request.report.search</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action purchase.request.report -->
    <record id="action_purchase_request_report" model="ir.actions.act_window">
        <field name="name">Purchase Request Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Report.
            </p>
        </field>
    </record>

</odoo>
