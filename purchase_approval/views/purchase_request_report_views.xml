<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_report_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.report.tree</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="payment_type"/>
                <field name="state"/>
                <field name="operating_unit_id"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_request_report_form" model="ir.ui.view">
        <field name="name">purchase.request.report.form</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Report" create="1" edit="1">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,done" />
                    <!-- <button name="action_submit" string="Submit" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_done" string="Approve" type="object" class="btn-success" attrs="{'invisible': [('state', '!=', 'submit')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" attrs="{'invisible': [('state', 'in', ['cancel','done'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,done,cancel" statusbar_colors='{"done":"green","cancel":"red"}'/> -->
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Report Reference"/>
                        </h1>
                        <label for="date" string="Created On:"/>
                        <field name="date" class="oe_inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="payment_type"/>
                            <field name="approval_date" attrs="{'readonly': [('state','!=','done')]}"/>
                            <field name="operating_unit_id"/>

                        </group>
                        <group>
                            <field name="is_editable" invisible="1" />
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requests">
                            <field name="request_ids" domain="[('payment_type', '=', payment_type), ('state', '=', 'to_verify'), ('report_id', '=', False)]" context="{'default_payment_type': payment_type}">
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                    <button string="Save" type="object" name="action_save_changes" class="btn-primary" attrs="{'invisible': [('is_editable','=',False)]}"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_purchase_request_report_search" model="ir.ui.view">
        <field name="name">view.purchase.request.report.search</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_request_report" model="ir.actions.act_window">
        <field name="name">Purchase Request Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Report.
            </p>
        </field>
    </record>
    <menuitem id="menu_purchase_approval" action="action_purchase_request_report" name="Purchase Approval" parent="purchase_request.parent_menu_purchase_request" groups="purchase_request.group_purchase_request_user,purchase_request.group_purchase_request_manager" sequence="50" />
</odoo>
