<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_report_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.report.tree</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="payment_type"/>
                <field name="state" widget="badge" decoration-success="state in ('done')" decoration-muted="state == 'draft'" decoration-warning="state == 'submit'" decoration-danger="state == 'cancel'" />
                <field name="operating_unit_id"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_request_tree_custom" model="ir.ui.view">
        <field name="name">view.purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="title"/>
                <field name="requested_by" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state in ('draft','to_approve')" decoration-muted="state in ('rejected')" />
                <field name="operating_unit_id"/>
                <field name="substate_sequence" invisible="1"/>
                <field name="substate_id" widget="badge" decoration-muted="substate_sequence == 1" decoration-warning="substate_sequence == 2" decoration-success="substate_sequence == 3" optional="hide"/>
                <field name="procurement_type_id" optional="show"/>
                <field name="contract_type" optional="show"/>
                <field name="payment_type" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="estimated_cost" optional="show"/>
                <button name="action_form_request_report" string="create PA" type="object" icon="fa-pencil" class="btn-primary"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_request_report_form" model="ir.ui.view">
        <field name="name">purchase.request.report.form</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Report" create="1" edit="1">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,done" />
                    <button name="button_submit" string="Submit" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="button_done" string="Done" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'submit')]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="name" />
                            <field name="name" placeholder="Report Reference" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_type" required="1" attrs="{'readonly': [('is_editable','=', False)]}" />
                            <field name="department_id" required="1" attrs="{'readonly': [('is_editable','=', False)]}" />
                            <field name="approval_date" readonly="1" />
                        </group>
                        <group>
                            <field name="is_editable" invisible="1" />
                            <field name="company_id" groups="base.group_multi_company" attrs="{'readonly': [('is_editable','=', False)]}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Requests">
                            <separator string="รายการคำขอจัดซื้อ/จ้าง"/>
                            <field name="request_ids" widget="many2many" attrs="{'readonly': ['|', ('payment_type', '=', 'direct'), ('is_editable','=', False)]}" domain="[('payment_type', '=', payment_type), ('state', '=', 'approved'), ('report_id', '=', False), ('is_required_approval', '=', True), ('department_id', '=', department_id)]" options="{'no_create': True, 'no_open': True}">
                                <tree create="0">
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="date_start"/>
                                    <field name="requested_by" widget="many2one_avatar_user"/>
                                    <field name="procurement_type_id"/>
                                    <field name="contract_type"/>
                                    <field name="payment_type"/>
                                    <field name="operating_unit_id"/>
                                    <field name="estimated_cost"/>
                                    <field name="state" widget="badge" decoration-success="state in ('done', 'approved', 'in_progress')" decoration-muted="state == 'draft'" decoration-warning="state == 'to_approve'" decoration-danger="state == 'rejected'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="more">
                            <group name="more">
                                <field name="operating_unit_id" attrs="{'readonly': [('is_editable','=', False)]}" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_request_report_search" model="ir.ui.view">
        <field name="name">view.purchase.request.report.search</field>
        <field name="model">purchase.request.report</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
                <searchpanel>
                    <field name="department_id" icon="fa-users" enable_counters="1" order="code asc" />
                    <field name="payment_type" icon="fa-money" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_purchase_request_report" model="ir.actions.act_window">
        <field name="name">Purchase Request Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Report.
            </p>
        </field>
    </record>

    <record id="action_purchase_request_report_filter" model="ir.actions.act_window">
        <field name="name">Purchase Request Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="purchase_approval.view_purchase_request_tree_custom"/>
        <field name="domain">[('report_id', '=', False), ('is_required_approval', '=', True), ('state', '=', 'approved')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Report.
            </p>
        </field>
    </record>
</odoo>
