<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View budget.commitment form -->
    <record id="view_budget_commitment_form" model="ir.ui.view">
        <field name="name">view.budget.commitment.form</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view"/>
        <field name="arch" type="xml">
            <field name="operating_unit_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//page[@name='extra']/group/group" position="inside">
                <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit" readonly="1" />
                <field name="operating_unit_id" invisible="1" />
            </xpath>
        </field>
    </record>

  </odoo>
