<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View budget.move form -->
    <record id="view_budget_move_form" model="ir.ui.view">
        <field name="name">view.budget.move.form</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form"/>
        <field name="arch" type="xml">
            <field name="operating_unit_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="domain">['|', ('operating_unit_id', '=', False), ('operating_unit_id', '=', operating_unit_id)]</attribute>
            </xpath>
            <xpath expr="//page[@name='extra']/group/group" position="inside">
                <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit" />
                <field name="operating_unit_id" invisible="1" />
            </xpath>
        </field>
    </record>

  </odoo>
