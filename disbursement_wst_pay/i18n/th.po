#. module: disbursement_wst_pay
#: model:res.groups,name:disbursement_wst_pay.group_disbursement_payment_finance
msgid "Disbursement Finance"
msgstr "เจ้าหน้าที่การเงินจ่าย (Disbursement Finance)"

#. module: disbursement_wst_pay
#: model:mail.activity.type,name:disbursement_wst_pay.mail_activity_dr_to_pay
msgid "Disbursement to pay"
msgstr "ใบขอเบิกรอจ่ายเงิน"

#. module: disbursement_wst_pay
#: model:mail.activity.type,summary:disbursement_wst_pay.mail_activity_dr_to_pay
msgid ""
"A disbursement request was authorized and its vouchers are ready — put"
" them in an e-payment file and confirm the payment"
msgstr ""
"ใบขอเบิกได้รับอนุมัติเบิกจ่ายและออกใบสำคัญจ่ายเรียบร้อยแล้ว — "
"กรุณาใส่ไฟล์ e-Payment แล้วยืนยันจ่ายสำเร็จ"

#. module: disbursement_wst_pay
#: model:disbursement.station,name:disbursement_wst_pay.station_pay
msgid "Pay"
msgstr "จ่ายเงิน"

#. module: disbursement_wst_pay
#: code:addons/disbursement_wst_pay/models/disbursement_request.py:0
#, python-format
msgid "Every payment of the request must be paid before it can move on."
msgstr "ใบจ่ายเงินทุกใบของใบขอเบิกต้องจ่ายแล้วก่อนจึงจะไปต่อได้"

#. module: disbursement_wst_pay
#: code:addons/disbursement_wst_pay/models/disbursement_request.py:0
#, python-format
msgid "The disbursement must be authorized before creating the payment."
msgstr "ต้องอนุมัติเบิกจ่ายก่อนจึงจะสร้างใบจ่ายได้"

#. module: disbursement_wst_pay
#: code:addons/disbursement_wst_pay/models/disbursement_request.py:0
#, python-format
msgid "Payments"
msgstr "ใบจ่ายเงิน"

#. module: disbursement_wst_pay
#: code:addons/disbursement_wst_pay/models/disbursement_request.py:0
#, python-format
msgid ""
"Only a request waiting at the payment station can be confirmed as "
"paid."
msgstr "ยืนยันจ่ายสำเร็จได้เฉพาะใบขอเบิกที่รออยู่ที่สถานีจ่ายเงิน"

#. module: disbursement_wst_pay
#: code:addons/disbursement_wst_pay/models/disbursement_request.py:0
#, python-format
msgid "Create the payment(s) before confirming the payment."
msgstr "กรุณาสร้างใบจ่ายก่อนยืนยันการจ่ายเงิน"

#. module: disbursement_wst_pay
#: code:addons/disbursement_wst_pay/models/disbursement_request.py:0
#, python-format
msgid ""
"These payments have not left in an e-payment file yet: %s. Put them in"
" a file and mark it done before confirming the payment."
msgstr ""
"ใบจ่ายเหล่านี้ยังไม่ได้ส่งออกไปกับไฟล์ e-Payment: %s "
"กรุณาสร้างไฟล์และปิดงานไฟล์ให้เรียบร้อยก่อนยืนยันจ่ายสำเร็จ"

#. module: disbursement_wst_pay
#: model:ir.actions.act_window,name:disbursement_wst_pay.action_dr_pay_queue
#: model:ir.ui.menu,name:disbursement_wst_pay.menu_dr_pay_queue
msgid "Pay Disbursements"
msgstr "จ่ายเงินตามใบขอเบิก"

#. module: disbursement_wst_pay
#: model_terms:ir.actions.act_window,help:disbursement_wst_pay.action_dr_pay_queue
msgid "No disbursement request is waiting to be paid."
msgstr "ไม่มีใบขอเบิกที่รอจ่ายเงิน"

#. module: disbursement_wst_pay
#: model_terms:ir.actions.act_window,help:disbursement_wst_pay.action_dr_pay_queue
msgid ""
"Requests that have been authorized: their vouchers are raised and wait"
" to go to the bank in an e-payment file."
msgstr ""
"ใบขอเบิกที่อนุมัติเบิกจ่ายแล้ว ใบสำคัญจ่ายถูกออกและรอส่งธนาคารในไฟล์ "
"e-Payment"

#. module: disbursement_wst_pay
#: model_terms:ir.ui.view,arch_db:disbursement_wst_pay.view_disbursement_request_search_inherit_pay
msgid "To Pay"
msgstr "รอจ่ายเงิน"

#. module: disbursement_wst_pay
#: model_terms:ir.ui.view,arch_db:disbursement_wst_pay.view_disbursement_request_form_inherit_pay
msgid "Create Payment"
msgstr "สร้างใบจ่ายเงิน"

#. module: disbursement_wst_pay
#: model_terms:ir.ui.view,arch_db:disbursement_wst_pay.view_disbursement_request_form_inherit_pay
msgid "Confirm Paid"
msgstr "ยืนยันจ่ายสำเร็จ"

#. module: disbursement_wst_pay
#: model_terms:ir.ui.view,arch_db:disbursement_wst_pay.view_disbursement_request_form_inherit_pay
msgid "Confirm the bank has successfully paid every item?"
msgstr "ยืนยันว่าธนาคารจ่ายเงินสำเร็จครบทุกรายการแล้ว?"
