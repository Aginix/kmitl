<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_appropriation_compilation_form_ztree" model="ir.ui.view">
        <field name="name">budget.appropriation.compilation.form.ztree</field>
        <field name="model">budget.appropriation.compilation</field>
        <field
            name="inherit_id"
            ref="budget_appropriation_summary.view_budget_appropriation_compilation_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//group//field[@name='department_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
