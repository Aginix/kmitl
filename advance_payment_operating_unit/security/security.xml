<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Global rules AND with every group rule, so the named endorser has to
         be ORed in here as well or a supervisor outside the request's OU
         could still not open it (advance_payment_endorser_rule, ADR-0020). -->
    <record id="ir_rule_advance_payment_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="advance_payment.model_advance_payment"/>
        <field name="domain_force">
            ['|', '|', ('operating_unit_id','=',False),
            ('operating_unit_id','in',user.operating_unit_ids.ids),
            '&amp;', ('endorser_id','=',user.id), ('state','!=','draft')]
        </field>
        <field name="name">Advance Payment from allowed operating units</field>
        <field name="global" eval="True"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>

    <record id="ir_rule_advance_payment_usage_line_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="advance_payment.model_advance_payment_usage_line"/>
        <field name="domain_force">
            ['|', ('operating_unit_id','=',False),
            ('operating_unit_id','in',user.operating_unit_ids.ids)]
        </field>
        <field name="name">Advance Payment Usage Line from allowed operating units</field>
        <field name="global" eval="True"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>

    <record id="ir_rule_advance_payment_return_line_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="advance_payment.model_advance_payment_return_line"/>
        <field name="domain_force">
            ['|', '|', ('operating_unit_id','=',False),
            ('operating_unit_id','in',user.operating_unit_ids.ids),
            '&amp;', ('agreement_id.endorser_id','=',user.id), ('agreement_id.state','!=','draft')]
        </field>
        <field name="name">Advance Payment Return Line from allowed operating units</field>
        <field name="global" eval="True"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>
</odoo>
