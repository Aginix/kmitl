<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_rule_advance_payment_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="advance_payment.model_advance_payment"/>
        <field name="domain_force">
            ['|', ('operating_unit_id','=',False),
            ('operating_unit_id','in',user.operating_unit_ids.ids)]
        </field>
        <field name="name">Advance Payment from allowed operating units</field>
        <field name="global" eval="True"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>

