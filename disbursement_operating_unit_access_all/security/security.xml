<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <data noupdate="1">
        <record id="group_all_ou_disbursement" model="res.groups">
            <field name="name">Access all OUs' disbursement request</field>
            <field name="category_id" ref="operating_unit.module_operating_units" />
        </record>
    </data>

    <!-- Global rules are ANDed with every other rule, so the only way to widen
         them is to rewrite their own domain. This runs on every upgrade, right
         after disbursement_operating_unit has reset the restrictive domain. -->
    <function model="ir.rule" name="write">
        <value
            eval="[ref('disbursement_operating_unit.ir_rule_disbursement_request_allowed_operating_units'),
                   ref('disbursement_operating_unit.ir_rule_disbursement_request_line_allowed_operating_units'),
                   ref('disbursement_operating_unit.ir_rule_disbursement_request_signature_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|',(1, '=', 1) if user.has_group('disbursement_operating_unit_access_all.group_all_ou_disbursement') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>

</odoo>
