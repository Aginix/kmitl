<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View base.snapshot View Tree -->
    <record id="view_base_snapshot_tree" model="ir.ui.view">
        <field name="name">view.base.snapshot.tree</field>
        <field name="model">base.snapshot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View base.snapshot form -->
    <record id="view_base_snapshot_form" model="ir.ui.view">
        <field name="name">view.base.snapshot.form</field>
        <field name="model">base.snapshot</field>
        <field name="arch" type="xml">
            <form string="Base Snapshot">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View base.snapshot search -->
    <record id="view_base_snapshot_search" model="ir.ui.view">
        <field name="name">view.base.snapshot.search</field>
        <field name="model">base.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action base.snapshot -->
    <record id="action_base_snapshot" model="ir.actions.act_window">
        <field name="name">Base Snapshot</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">base.snapshot</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Base Snapshot.
            </p>
        </field>
    </record>

</odoo>
