<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_form_receipt" model="ir.ui.view">
        <field name="name">advance.payment.form.receipt</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form"/>
        <field name="arch" type="xml">
            <button name="action_view_return_lines" position="after">
                <button name="action_view_receipts" type="object"
                    class="oe_stat_button" icon="fa-file-text-o"
                    attrs="{'invisible': [('receipt_count', '=', 0)]}"
                    groups="advance_payment.group_advance_payment_loan_officer">
                    <field name="receipt_count" string="ใบเสร็จ" widget="statinfo"/>
                </button>
            </button>

            <xpath expr="//field[@name='return_line_ids']/tree/field[@name='note']" position="after">
                <field name="receipt_id"/>
            </xpath>
        </field>
    </record>
</odoo>
