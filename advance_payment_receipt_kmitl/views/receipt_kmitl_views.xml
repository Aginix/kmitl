<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_receipt_kmitl_form_advance_payment" model="ir.ui.view">
        <field name="name">kmitl.receipt.form.advance_payment</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_advance_agreement" type="object"
                    class="oe_stat_button" icon="fa-file-text-o"
                    attrs="{'invisible': [('advance_agreement_id', '=', False)]}">
                    <field name="advance_agreement_id" widget="statinfo"
                        string="สัญญายืมเงิน"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
