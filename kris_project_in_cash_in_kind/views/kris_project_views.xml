<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- FORM: In Cash / In Kind above Project Value                  -->
    <!-- ============================================================ -->
    <record id="view_kris_project_form" model="ir.ui.view">
        <field name="name">kris.project.form.in_cash_in_kind</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='1. Project Value']/field[@name='project_value']"
                   position="before">
                <field name="is_research_category" invisible="1"/>
                <field
                    name="in_cash"
                    attrs="{
                        'invisible': [('is_research_category', '=', False)],
                        'readonly': [('can_edit', '=', False)],
                    }"
                />
                <field
                    name="in_kind"
                    attrs="{
                        'invisible': [('is_research_category', '=', False)],
                        'readonly': [('can_edit', '=', False)],
                    }"
                />
            </xpath>
            <xpath expr="//group[@string='1. Project Value']/field[@name='project_value']"
                   position="attributes">
                <attribute name="attrs">{
                    'readonly': ['|', ('is_research_category', '=', True), ('can_edit', '=', False)],
                }</attribute>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- TREE: optional columns beside Project Value                  -->
    <!-- ============================================================ -->
    <record id="view_kris_project_tree" model="ir.ui.view">
        <field name="name">kris.project.tree.in_cash_in_kind</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_value']" position="after">
                <field name="in_cash" sum="รวม" optional="hide"/>
                <field name="in_kind" sum="รวม" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- PIVOT: additional measures                                   -->
    <!-- ============================================================ -->
    <record id="view_kris_project_pivot" model="ir.ui.view">
        <field name="name">kris.project.pivot.in_cash_in_kind</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_value']" position="after">
                <field name="in_cash" type="measure"/>
                <field name="in_kind" type="measure"/>
            </xpath>
        </field>
    </record>

</odoo>
