<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="project_proposal.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary" owl="1">
        <xpath expr="//thead/tr" position="replace">
            <tr>
                <th t-if="hasSelectors" class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer" tabindex="-1" t-on-keydown="(ev) => this.onCellKeydown(ev)" t-on-click.stop="toggleSelection">
                    <CheckBox disabled="!canSelectRecord" value="selectAll" className="'d-flex'" onChange.bind="toggleSelection"/>
                </th>
                <th rowspan="3"></th>
                <th rowspan="3" class="align-middle">กิจกรรม/ขั้นตอน</th>
                <th rowspan="3" class="align-middle">งบประมาณ</th>
                <th colspan="12" class="text-center">ปีงบประมาณ พ.ศ. 2568</th>
            </tr>
            <tr>
                <th colspan="3" class="text-center">ไตรมาสที่ 1</th>
                <th colspan="3" class="text-center">ไตรมาสที่ 2</th>
                <th colspan="3" class="text-center">ไตรมาสที่ 3</th>
                <th colspan="3" class="text-center">ไตรมาสที่ 4</th>
            </tr>
            <tr>
                <th>ต.ค.</th>
                <th>พ.ย.</th>
                <th>ธ.ค.</th>
                <th>ม.ค.</th>
                <th>ก.พ.</th>
                <th>มี.ค.</th>
                <th>เม.ย.</th>
                <th>พ.ค.</th>
                <th>มิ.ย.</th>
                <th>ก.ค.</th>
                <th>ส.ค.</th>
                <th>ก.ย.</th>
            </tr>
            
        </xpath>
        <xpath expr="//table" position="after">
            <div t-if="validPercentage" class="alert alert-warning" role="alert">
               ร้อยละต้องอยู่ระหว่าง 1 ถึง 100
            </div>
        </xpath>
    </t>

    <t t-name="project_proposal.ListRendererActivity.Rows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary" owl="1">
        <xpath expr="//tr[@t-if='displayRowCreates']" position="after">
            <tr>
                <td colspan="2">รวม</td>
                <td class="text-end">
                    <t t-esc="totalAmount"/>
                </td>
            </tr>
        </xpath>
    </t>
</templates>