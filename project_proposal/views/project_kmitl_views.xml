<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Tree View -->
    <record id="view_project_kmitl_tree" model="ir.ui.view">
        <field name="name">view.project.kmitl.tree</field>
        <field name="model">project.kmitl</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="source" />
                <field name="user_id" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_project_kmitl_form" model="ir.ui.view">
        <field name="name">view.project.kmitl.form</field>
        <field name="model">project.kmitl</field>
        <field name="arch" type="xml">
            <form string="Project Kmitl">
                <header>
                    <field name="state" widget="statusbar" />
                    <button
                        name="action_next_state"
                        type="object"
                        string="ถัดไป"
                        class="btn-primary"
                        icon="fa-arrow-right"
                        attrs="{'invisible': [('state', '=', 'approved')]}"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="user_id" />
                            <field name="introduction" />
                            <field name="national_strategy_id" />
                        </group>
                        <group>
                            <field name="date_range_fy_id" />
                            <field name="source" />
                        </group>
                    </group>

                    <group string="ความสอดคล้องกับนโยบายสถาบัน">
                        <group>
                            <field name="impact_ids" widget="many2many_tags" />
                            <field name="global_index_ids" widget="many2many_tags" />

                        </group>
                        <group>
                            <field name="okr_1" widget="many2many_tags" />
                            <field name="fight_ids" widget="many2many_tags" />
                        </group>
                    </group>

                    <group>
                        <field name="objective_ids">
                            <tree editable="bottom">
                                <field name="name" />
                            </tree>
                        </field>
                    </group>

                    <group name="project" string="โครงการ">
                        <group>
                            <field name="project_manager_name" />
                            <field name="project_manager_position" />
                            <field name="project_manager_tel" />
                            <field name="project_manager_email" />
                            <field name="location" />
                        </group>
                        <group>
                            <field name="department_id" />
                            <field name="department_name" />
                        </group>
                    </group>

                    <group>
                        <field name="methodology" />
                        <field name="methodology_description" />
                        <field name="target_ids" />
                        <field name="output_ids" widget="table_output">
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="line_type" />
                                <field name="unit" />
                                <field name="target" />
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="activity_ids" widget="table_activity">
                            <tree>
                                <field name="seq" />
                                <field name="name" />
                                <field name="percentage" />
                                <field name="amount" />
                                <field name="line_type" invisible="1" />
                                <field name="m10" />
                                <field name="m11" />
                                <field name="m12" />
                                <field name="m1" />
                                <field name="m2" />
                                <field name="m3" />
                                <field name="m4" />
                                <field name="m5" />
                                <field name="m6" />
                                <field name="m7" />
                                <field name="m8" />
                                <field name="m9" />
                                <field name="percentage" invisible="1" />
                            </tree>
                        </field>
                        <field name="expected_result" />
                        <field name="evaluation_method_ids" widget="many2many_tags" />
                        <field name="evaluation_method_description" />
                    </group>
                    <group>
                        <group>
                            <field name="total_budget" />
                        </group>
                        <group>
                            <field name="attachment_ids" filename="ชื่อไฟล์" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View project.kmitl search -->
    <record id="view_project_kmitl_search" model="ir.ui.view">
        <field name="name">view.project.kmitl.search</field>
        <field name="model">project.kmitl</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.kmitl -->
    <record id="action_project_kmitl" model="ir.actions.act_window">
        <field name="name">Project Kmitl</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.kmitl</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Kmitl.
            </p>
        </field>
    </record>

    <record id="view_form_project_activity" model="ir.ui.view">
        <field name="name">project.activity.form</field>
        <field name="model">project.activity</field>
        <field name="arch" type="xml">
            <form string="กิจกรรม / ขั้นตอน">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="seq" />
                        <field name="amount" />
                        <field name="line_type" />
                        <field name="percentage" />
                        <field name="project_kmitl_id" invisible="1" />
                    </group>

                    <group string="ระบุเดือนที่ดำเนินการ">
                        <group>
                            <separator string="ไตรมาสที่ 1 (ต.ค. - ธ.ค.)" />
                            <field name="m10" />
                            <field name="m11" />
                            <field name="m12" />
                        </group>

                        <group>
                            <separator string="ไตรมาสที่ 2 (ม.ค. - มี.ค.)" />
                            <field name="m1" />
                            <field name="m2" />
                            <field name="m3" />
                        </group>
                    </group>

                    <group>
                        <group>
                            <separator string="ไตรมาสที่ 3 (เม.ย. - มิ.ย.)" />
                            <field name="m4" />
                            <field name="m5" />
                            <field name="m6" />
                        </group>
                        <group>
                            <separator string="ไตรมาสที่ 4 (ก.ค. - ก.ย.)" />
                            <field name="m7" />
                            <field name="m8" />
                            <field name="m9" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <menuitem
        action="action_project_kmitl"
        id="menu_project_proposal"
        name="โครงการยุทธศาสตร์"
        parent="project.menu_main_pm"
        sequence="2"
    />

</odoo>
