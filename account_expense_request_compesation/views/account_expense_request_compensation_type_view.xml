<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_account_expense_request_compensation_type_tree" model="ir.ui.view">
        <field name="name">account.expense.request.compensation.type.tree</field>
        <field name="model">account.expense.request.compensation.type</field>
        <field name="arch" type="xml">
            <tree string="Expense Compensation Type">
                <field name="code" />
                <field name="name" />
                <field name="allowed_expense_product_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_account_expense_request_compensation_type_form" model="ir.ui.view">
        <field name="name">account.expense.request.compensation.type.tree</field>
        <field name="model">account.expense.request.compensation.type</field>
        <field name="arch" type="xml">
            <form string="Expense Compensation Type">
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="allowed_expense_product_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_account_expense_request_compensation_type_search" model="ir.ui.view">
        <field name="name">account.expense.request.compensation.type.search</field>
        <field name="model">account.expense.request.compensation.type</field>
        <field name="arch" type="xml">
            <search string="Expense Compensation Type">
                <field name="code" string="Code" filter_domain="[('code', 'ilike', self)]" />
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]" />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_account_expense_request_compensation_type" model="ir.actions.act_window">
        <field name="name">Compensation Type</field>
        <field name="res_model">account.expense.request.compensation.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_account_expense_request_compensation_type" name="Compensation Type" parent="account_expense_request.menu_account_expense_request_config" action="action_account_expense_request_compensation_type" sequence="10" />

</odoo>
