<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_account_expense_request_compensation_tree" model="ir.ui.view">
        <field name="name">account.expense.request.compensation.tree</field>
        <field name="model">account.expense.request.compensation</field>
        <field name="arch" type="xml">
            <tree string="Expense Compensation">
                <field name="name" />
                <field name="requester_id" />
                <field name="compensation_type_id" />
                <field name="date" />
                <field name="amount_total" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'done')" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_account_expense_request_compensation_form" model="ir.ui.view">
        <field name="name">account.expense.request.compensation.tree</field>
        <field name="model">account.expense.request.compensation</field>
        <field name="arch" type="xml">
            <form string="Expense Compensation">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="action_draft" string="Reset to draft" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', '!=', 'submitted')]}" groups="account.group_account_manager" />
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '!=', 'approved')]}" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="can_edit_type" invisible="1"/>
                            <field name="date" />
                            <field name="requester_id" />
                            <field name="responsible_id" />
                            <field name="department_id" />
                            <field name="compensation_type_id" attrs="{'readonly': [('can_edit_type', '!=', True)]}"/>
                            <field name="payment_type" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="allowed_product_ids" invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id" />
                                    <field name="product_id" />
                                    <field name="description" />
                                    <field name="amount_total" />
                                </tree>
                            </field>
                        </page>
                        <page string="Details" name="detail">
                            <group>
                                <field name="amount_total" />
                                <field name="description" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_account_expense_request_compensation_search" model="ir.ui.view">
        <field name="name">account.expense.request.compensation.search</field>
        <field name="model">account.expense.request.compensation</field>
        <field name="arch" type="xml">
            <search string="Expense Compensation">
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]" />
                <field name="requester_id" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]" />
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]" />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="date" string="Date" date="date" />
                <group expand="0" string="Group By">
                    <filter string="Date" name="date" context="{'group_by': 'date'}" />
                    <filter string="State" name="state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_account_expense_request_compensation" model="ir.actions.act_window">
        <field name="name">Expense Compensation</field>
        <field name="res_model">account.expense.request.compensation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Expense Compensation
            </p>
            <p>
                Expense requests are used to hold information before creating Move Request.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_account_expense_request_compensation" name="Compensation" parent="account_expense_request.menu_account_expense_request" action="action_account_expense_request_compensation" sequence="10" />

</odoo>
