<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order form -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form WA External</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="before">
              <group string="External WA" name="external_wa_section" attrs="{'invisible': [('use_invoice_plan', '=', True)]}">
                  <field name="is_external" attrs="{'readonly': [('state', 'in', ('purchase', 'done', 'cancel'))]}"/>
              </group>
            </xpath>
        </field>
    </record>

  </odoo>