<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The fulfil buttons open a NEW, unsaved budget.transfer /
         budget.commitment pre-filled through ``default_*`` context keys. Odoo
         only runs ``default_get`` for the fields the form view actually
         contains, so ``support_request_id`` must be present (invisible, but
         NOT readonly — the web client drops readonly fields on save) or the
         back-link to the request is silently lost. -->

    <record id="view_budget_transfer_form_support_request" model="ir.ui.view">
        <field name="name">budget.transfer.form.support.request</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="support_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_budget_commitment_form_support_request" model="ir.ui.view">
        <field name="name">budget.commitment.form.support.request</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='basic_information']" position="inside">
                <field name="support_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
