<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_support_request_verify_return_wizard_form" model="ir.ui.view">
        <field name="name">budget.support.request.verify.return.wizard.form</field>
        <field name="model">budget.support.request.verify.return.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งกลับแก้ไข">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="ระบุสิ่งที่ต้องแก้ไข เพื่อให้ผู้ขอทราบว่าต้องทำอะไรต่อ..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="ส่งกลับแก้ไข" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
