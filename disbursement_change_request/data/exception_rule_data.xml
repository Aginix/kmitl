<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Checked by ตรวจสอบ (action_validate), not on Submit: the method only
         fails a request in the circuit. -->
    <record id="excep_disbursement_outstanding_change_requests" model="exception.rule">
        <field name="name">ยังมีข้อแก้ไขที่ค้างอยู่</field>
        <field
            name="description"
        >ตรวจสอบได้เมื่อข้อแก้ไขของใบขอเบิกปิดครบแล้ว (ข้อแก้ไขที่ยังเปิดอยู่หรือตอบแล้วถือว่ายังค้างอยู่)</field>
        <field name="sequence">20</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_method</field>
        <field
            name="method"
        >disbursement_request_check_outstanding_change_requests</field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- ส่งคืนผู้จัดทำ marker: linked by the send-back while Change requests are
         outstanding and cleared on the next state change, never evaluated (see
         disbursement_return_exception). -->
    <record id="excep_disbursement_sent_back_change_requests" model="exception.rule">
        <field name="name">มีข้อแก้ไขที่ต้องแก้</field>
        <field
            name="description"
        >ใบขอเบิกถูกส่งคืนพร้อมข้อแก้ไขที่ยังค้างอยู่ ดูรายการได้ที่ข้อแก้ไขของใบขอเบิก</field>
        <field name="sequence">81</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code"># set by the send-back, never evaluated
failed = False</field>
        <field name="is_blocking" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
