<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_move_request_form" model="ir.ui.view">
        <field name="name">account.move.request.form.fiscal.year</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_form" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="account_fiscal_year_id" readonly="1" options="{'no_open': True}" />
                <field name="account_fiscal_year_id" invisible="1" />
            </field>
        </field>
    </record>

    <record id="view_account_move_request_tree" model="ir.ui.view">
        <field name="name">account.move.request.tree.fiscal.year</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_tree" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="account_fiscal_year_id" options="{'no_open': True}" />
            </field>
        </field>
    </record>

    <record id="view_account_move_request_search" model="ir.ui.view">
        <field name="name">account.move.request.search.fiscal.year</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_search" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="account_fiscal_year_id" />
            </field>
        </field>
    </record>
</odoo>
