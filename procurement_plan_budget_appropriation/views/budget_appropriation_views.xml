<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.appropriation.line form -->
    <record id="view_budget_appropriation_line_form_procurement_plan" model="ir.ui.view">
        <field name="name">view.budget.appropriation.line.form.procurement.plan</field>
        <field name="model">budget.appropriation.line</field>
        <field name="inherit_id" ref="budget_appropriation.view_budget_appropriation_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="procurement_plan" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='balance']" position="after">
                <field name="enable_procurement_plan" string="จัดสรรงบประมาณงบลงทุน" attrs="{'invisible': [('procurement_plan', '=', False)]}" />
            </xpath>
            <xpath expr="//group" position="after">
                <group name="procurement_plan" string="แผนจัดซื้อจัดจ้าง" attrs="{'invisible': [('enable_procurement_plan', '=', False)]}">
                    <div class="alert alert-info" role="alert" colspan="2">
                        <p class="fst-italic fw-light mt-1">
                            ตัวอย่างการกรอกข้อมูล                            <br />
                            ตัวอย่าง 1. "ปรับปรุงห้องเรียนและห้องปฏิบัติการ อาคารปฏิบัติการพิเศษจอมไตร จำนวน 7 ห้อง วงเงินรวม 5,250,000 บาท" <br />
                            ตัวอย่าง 2. "เครื่องล้างเครื่องมือด้วยคลื่นเสียงความถี่สูง จำนวน 1 เครื่อง วงเงินรวม 45,000 บาท" <br />
                        </p>
                    </div>
                    <field name="description" attrs="{'required': [('enable_procurement_plan', '=', True)], 'invisible': [('procurement_plan_id', '!=', False)]}" />
                    <field name="procurement_plan_id" attrs="{'invisible': [('procurement_plan_id', '=', False)]}" />
                    <label for="procurement_plan_amount" string="จำนวน" attrs="{'required': [('enable_procurement_plan', '=', True)]}" />
                    <div class="o_row">
                        <field name="procurement_plan_amount" attrs="{'required': [('enable_procurement_plan', '=', True)]}" />
                        <field name="procurement_plan_unit" placeholder="e.g. ชิ้น, รายการ, ตัว, ชุด" attrs="{'required': [('enable_procurement_plan', '=', True)]}" />
                    </div>
                    <label for="balance" string="วงเงินรวม" />
                    <div class="o_row">
                        <field name="balance" />
                        <div>บาท</div>
                    </div>

                </group>
            </xpath>
        </field>
    </record>

    <!-- View budget.appropriation form -->
    <record id="view_budget_appropriation_form_procurement_plan" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form.procurement.plan</field>
        <field name="model">budget.appropriation</field>
        <field name="inherit_id" ref="budget_appropriation.view_budget_appropriation_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="procurement_plan" invisible="1" />
                <field name="enable_procurement_plan" invisible="1" />
                <field name="description" string="Name" invisible="1" />
                <field name="procurement_plan_amount" invisible="1" />
                <field name="procurement_plan_unit" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                <attribute name="decoration-info">procurement_plan</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='line_ids']" position="after">
                <page name="procurement_plan_summary" string="แผนจัดซื้อจัดจ้าง"
                      attrs="{'invisible': [('budget_type', '!=', 'expense')]}">
                    <field name="procurement_plan_ids" readonly="1" nolabel="1">
                        <tree create="false" edit="false" delete="false">
                            <field name="description" string="ชื่อรายการ" />
                            <field name="account_id" string="รหัสงบประมาณ" />
                            <field name="activity_analytic_id" string="กิจกรรม" />
                            <field name="procurement_plan_amount" string="จำนวน" />
                            <field name="procurement_plan_unit" string="หน่วย" />
                            <field name="balance" string="วงเงินรวม" sum="รวม" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
