<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_bill_posted_confirm)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <button name="action_draft" position="before">
                <button
                    name="action_confirm_bill"
                    string="Confirm Bills Posted"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('can_confirm_bill', '=', False)]}"
                    groups="accounting_kmitl.group_accounting_kmitl_user"
                />
                <field name="can_confirm_bill" invisible="1" />
            </button>
            <group id="other_information" position="inside">
                <field
                    name="bill_confirmer_id"
                    attrs="{'invisible': [('bill_confirmer_id', '=', False)]}"
                />
                <field
                    name="bill_confirm_date"
                    attrs="{'invisible': [('bill_confirmer_id', '=', False)]}"
                />
            </group>
        </field>
    </record>
</odoo>
