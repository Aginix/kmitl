<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_project_project_inherit_filter" model="ir.ui.view">
        <field name="name">project.project.select</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <field name="analytic_account_id" position="after">
                <field name="current_revision_id" invisible="1" />
            </field>
        </field>
    </record>

    <record id="view_project_project_kmitl_inherit_form" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field
            name="inherit_id"
            ref="project_kmitl.view_project_project_inherit_form"
        />
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='change_type']" position="replace">
                <field
                    name="change_type"
                    attrs="{'invisible': [('current_revision_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_project_project_inherit_form" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position='inside'>
                <button
                    name="create_revision"
                    string="New Revision"
                    type="object"
                    attrs="{'invisible': ['|', ('current_revision_id', '!=', False), ('state', '!=', 'approve')]}"
                />
            </xpath>
            <xpath expr="//sheet/*[1]" position="before">
                <widget
                    name="web_ribbon"
                    title="โครงการกำลังมีการแก้ไข"
                    bg_color="bg-warning"
                    attrs="{'invisible': ['|', ('current_revision_id', '=', False), ('state', '!=', 'approve')]}"
                />
                <widget
                    name="web_ribbon"
                    title="เวอร์ชันเก่า"
                    bg_color="bg-black"
                    attrs="{'invisible': [('state', '!=', 'revised')]}"
                />
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="current_revision_id" invisible="1" />
            </xpath>
            <xpath expr="//div[@name='dates']" position="after">
                <field name="revision_number" attrs="{'readonly': 1}" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div
                    class="alert alert-warning d-flex align-items-center gap-2"
                    role="alert"
                    attrs="{'invisible': [('state', '!=', 'revised')]}"
                >
                    ท่านกำลังดูข้อมูลเวอร์ชันเก่า
                    <button
                        name="open_project"
                        class="btn-secondary"
                        type="object"
                        string="กดที่นี้เพื่อดูเวอร์ชันล่าสุด"
                    />
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_revisions"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-archive-o"
                    attrs="{'invisible': ['|', ('has_old_revisions', '=', False),('revision_count', '=', 0)]}"
                >
                    <field
                        name="revision_count"
                        widget="statinfo"
                        string="Prev. revisions"
                    />
                </button>
            </xpath>
            <field name="date" position="after">
                <field
                    name="current_revision_id"
                    attrs="{'invisible': [('current_revision_id', '=', False)]}"
                />
                <field name="has_old_revisions" invisible="1" />
            </field>
        </field>
    </record>

  </odoo>
