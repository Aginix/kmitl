<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_project_revision_confirm_wizard_form" model="ir.ui.view">
        <field name="name">project.revision.confirm.wizard.form</field>
        <field name="model">project.revision.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="ยืนยันการสร้างเวอร์ชันใหม่">
                <field name="project_id" invisible="1" />
                <p>คุณแน่ใจหรือไม่ว่าต้องการสร้างเวอร์ชันใหม่ของโครงการนี้?</p>
                <footer>
                    <button
                        string="ยืนยัน"
                        type="object"
                        name="confirm_create_revision"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_revision_confirm_wizard" model="ir.actions.act_window">
        <field name="name">ยืนยันการ revision</field>
        <field name="res_model">project.revision.confirm.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
