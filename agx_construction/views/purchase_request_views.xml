<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record
        id="purchase_request.purchase_request_form_action"
        model="ir.actions.act_window"
    >
        <field name="domain">[('is_construction', '=', False)]</field>
    </record>

    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form.construction</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="is_construction" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute
                    name="attrs"
                >{'readonly': ['|',('is_construction', '=', True), ('is_editable','=', False)]}</attribute>
            </xpath>
        </field>
    </record>

    <record
        id="l10n_th_gov_purchase_request_view_purchase_request_form"
        model="ir.ui.view"
    >
        <field name="name">purchase.request.form.construction</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='procurement_type_id']" position="attributes">
                <attribute
                    name="domain"
                >([('is_construction', '=', True)] if is_construction else [('is_purchase', '=', True)])</attribute>
            </xpath>

        </field>
    </record>

    <record
        id="view_purchase_request_form_ux_construction"
        model="ir.ui.view"
    >
        <field name="name">purchase.request.form.construction</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="before">
                <field name="is_construction" invisible="1" />
                <!-- <field name="is_construction" groups="base.group_no_one" readonly="1"/> -->
                <field
                    name="project_id"
                    attrs="{'invisible': [('is_construction', '!=', True)], 'required': [('is_construction', '=', True)]}"
                />
            </xpath>

        </field>
    </record>

    <record id="construction_purchase_request_view_tree" model="ir.ui.view">
        <field name="name">purchase.request.tree.construction</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <tree string="Constructions">
                <field name="main_sarabun_document_id" optional="show"/>
                <field name="project_id" />
                <field name="name" optional="hide"/>
                <field name="title" optional="hide"/>
                <field name="date_start" />
                <field name="user_id" optional="hide"/>
                <field name="requested_by" widget="many2one_avatar_user" optional="show"/>
                <field name="procurement_type_id" optional="hide"/>
                <field name="procurement_method_id" optional="hide"/>
                <field name="account_fiscal_year_id" optional="hide"/>
                <field name="operating_unit_id" optional="hide"/>
                <field name="department_id" optional="show"/>
                <field name="activity_ids" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="estimated_cost" optional="show"/>
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state in ('done', 'approved', 'purchasing', 'in_pa')"
                    decoration-muted="state == 'draft'"
                    decoration-warning="state == 'to_approve'"
                    decoration-danger="state == 'cancel'"
                />
                <field name="is_egp" optional="hide" invisible="1"/>
                <field name="main_exception_id" optional="hide"/>
                <field name="budget_account_id" optional="hide"/>
                <field name="department_analytic_id" optional="hide"/>
                <field name="source_analytic_id" optional="show"/>
                <field name="fund_analytic_id" optional="hide"/>
                <field name="activity_analytic_id" optional="show"/>
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="construction_purchase_request_view_search" model="ir.ui.view">
        <field name="name">purchase.request.search.construction</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search string="Constructions">
                <field name="name" />
                <field name="project_id" />
                <field name="requested_by" />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="In Progress"
                    name="in_progress"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <separator />
                <group expand="0" name="group_by" string="Group By">
                    <filter
                        string="Project"
                        name="group_project"
                        context="{'group_by': 'project_id'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
