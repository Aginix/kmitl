<mxfile host="Electron">
  <diagram id="purchase-workflow-v3" name="Purchase Workflow v3 (Current — post ADR-0005)">
    <mxGraphModel dx="991" dy="863" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="กระบวนการจัดซื้อจัดจ้าง KMITL — v3 (Current)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;พ.1 (PR) master · พจ.1 (PA) child swimlane · Sarabun sole approval · Post-Sarabun state split (in_egp / in_approval) · Auto-create PA on non-e-GP&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="1100" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="grill_notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;การเปลี่ยนแปลงจาก v2 → v3 (ตาม ADR-0005)&lt;/b&gt;&lt;br&gt;✔ แยกสถานะหลัง Sarabun approve เป็น 2 state:&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;b&gt;in_egp&lt;/b&gt; — e-GP branch (owned by purchase_request_egp)&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;b&gt;in_approval&lt;/b&gt; — non-e-GP branch (owned by purchase_request_approval)&lt;br&gt;✔ ใช้ OCA base &lt;b&gt;in_progress&lt;/b&gt; ในเฟส &quot;PO ยังไม่ตัด&quot; (แทนที่ในเฟส in_purchase ของ round-3)&lt;br&gt;✔ Auto-create พจ.1 (PA draft) เมื่อ Sarabun approve บน non-e-GP path&lt;br&gt;✔ Dual statusbar: e-GP กับ non-e-GP มี statusbar ต่างกัน (dynamic ตาม is_egp)&lt;br&gt;✔ Terminal state ใช้ชื่อ &lt;b&gt;cancel&lt;/b&gt; (align กับ OCA upstream) แทน cancelled/rejected&lt;br&gt;✔ PA states เหลือ 4: draft / to_approve / approved / reject|cancel&lt;br&gt;✔ ลบปุ่ม manual &quot;สร้าง พจ.1&quot; · ลบปุ่ม manual reject ของ PR (มาจาก Sarabun เท่านั้น)&lt;br&gt;✔ Cancel wizard บังคับกรอกเหตุผล (log ลง chatter)" vertex="1">
          <mxGeometry height="220" width="470" x="1200" y="60" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="เริ่ม&lt;br&gt;(ผู้ขอสร้าง พ.1)" vertex="1">
          <mxGeometry height="50" width="160" x="480" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s_draft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="1. ร่าง&lt;br&gt;(draft)" vertex="1">
