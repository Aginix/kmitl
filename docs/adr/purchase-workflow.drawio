          <mxGeometry height="100" width="330" x="20" y="80" as="geometry" />
        </mxCell>
        <mxCell id="note_egp_criteria" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;เกณฑ์เข้า e-GP&lt;/b&gt;&lt;br&gt;is_egp = computed default (วงเงิน &amp;gt; ฿100,000)&lt;br&gt;+ เจ้าหน้าที่ override ได้ (readonly เมื่อ estimated_cost &amp;gt; 100k)&lt;br&gt;&lt;b&gt;e-GP path ข้ามการสร้าง PA ทั้งหมด&lt;/b&gt; — 1 PR ≤ 1 PA" vertex="1">
          <mxGeometry height="100" width="330" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="note_dual_statusbar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;Dual Statusbar (view UX)&lt;/b&gt;&lt;br&gt;• non-e-GP statusbar: draft → to_verify → to_submit → to_approve →&lt;br&gt;&amp;nbsp;&amp;nbsp;in_approval → in_progress → done&lt;br&gt;• e-GP statusbar: draft → to_verify → to_submit → to_approve →&lt;br&gt;&amp;nbsp;&amp;nbsp;in_egp → in_progress → done&lt;br&gt;• สลับด้วย attrs invisible=[(&#39;is_egp&#39;, ...)]&lt;br&gt;• กำหนดใน purchase_request_egp.view_purchase_request_form_ux" vertex="1">
          <mxGeometry height="140" width="330" x="20" y="305" as="geometry" />
        </mxCell>
        <mxCell id="note_egp_substates" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;e-GP sub-status field (egp_status)&lt;/b&gt;&lt;br&gt;• waiting — เข้ามาตอน PR = in_egp&lt;br&gt;• in_progress — หลังกรอกเลข e-GP + กดปุ่ม&lt;br&gt;• (cleared) — เมื่อสร้าง PO เสร็จ (button_done)&lt;br&gt;อยู่คู่กับ state หลัก — ไม่แทนที่ statusbar" vertex="1">
          <mxGeometry height="110" width="330" x="20" y="450" as="geometry" />
        </mxCell>
        <mxCell id="note_cancel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;ปุ่ม Cancel บน พ.1 (wizard-driven)&lt;/b&gt;&lt;br&gt;visible ที่: draft, to_verify, to_submit, to_approve, in_egp, in_approval, in_progress&lt;br&gt;→ เปิด wizard บังคับกรอก &quot;เหตุผลการยกเลิก&quot;&lt;br&gt;→ _action_do_cancel(reason) log ลง chatter + write state=&#39;cancel&#39;&lt;br&gt;→ purchase_request_budget.button_cancel cancel commitment" vertex="1">
          <mxGeometry height="120" width="360" x="5" y="850" as="geometry" />
        </mxCell>
        <mxCell id="note_terminal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;Terminal states (พ.1)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;rejected&lt;/b&gt; (OCA base) — Sarabun reject บน PR/PA (via button_rejected)&lt;br&gt;• &lt;b&gt;cancel&lt;/b&gt; (KMITL) — user cancel (wizard) หรือ PA cancel cascade&lt;br&gt;• &lt;b&gt;done&lt;/b&gt; (OCA base) — สร้าง PO สำเร็จ (happy terminal)&lt;br&gt;หลัง terminal — ไม่มี revive; สร้าง PR ใหม่ (copy) แทน&lt;br&gt;Migration: legacy approved+non-egp+no-PA คงไว้ approved (log เตือน ops)" vertex="1">
          <mxGeometry height="130" width="360" x="5" y="990" as="geometry" />
        </mxCell>
        <mxCell id="note_pa_subphase" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;PA to_approve — 2 sub-phases (ADR-0003)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Pre-Sarabun&lt;/b&gt; (main_sarabun_document_id is None):&lt;br&gt;&amp;nbsp;&amp;nbsp;พัสดุแก้ vendor/price/tax ได้; ปุ่ม &quot;ยกเลิก&quot; ของ manager visible&lt;br&gt;• &lt;b&gt;Sarabun running&lt;/b&gt; (main_sarabun_document_id set):&lt;br&gt;&amp;nbsp;&amp;nbsp;locked; ทางออก = Sarabun approve → approved | Sarabun reject → reject&lt;br&gt;&lt;b&gt;PA approved cascade&lt;/b&gt;: PR in_approval → in_progress&lt;br&gt;&lt;b&gt;PA reject cascade&lt;/b&gt;: PR → rejected (button_rejected)&lt;br&gt;&lt;b&gt;PA cancel cascade&lt;/b&gt;: PR → cancel" vertex="1">
          <mxGeometry height="160" width="470" x="1200" y="290" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=top;spacing=6;" value="&lt;b&gt;คำอธิบาย&lt;/b&gt;&lt;br&gt;น้ำเงิน = สถานะของ พ.1 (master)&lt;br&gt;ม่วง = สถานะของ พจ.1 (child) — swimlane&lt;br&gt;เขียว = เริ่ม/จบ (happy terminal)&lt;br&gt;แดง = terminal ไม่ happy (rejected/cancel)&lt;br&gt;เหลือง = จุดตัดสินใจ&lt;br&gt;ส้ม = การเปลี่ยนแปลงหลัก (v2 → v3)&lt;br&gt;เทา = หมายเหตุ · [ ] = actor · เส้นประ = ย้อน/relationship" vertex="1">
          <mxGeometry height="140" width="360" x="5" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="note_files" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;verticalAlign=top;spacing=6;" value="&lt;b&gt;การ Mapping ในโค้ด&lt;/b&gt;&lt;br&gt;• &lt;code&gt;purchase_request_kmitl&lt;/code&gt; — selection_add: to_submit, cancel · button_cancel wizard · fallback dispatcher&lt;br&gt;• &lt;code&gt;purchase_request_egp&lt;/code&gt; — selection_add: in_egp · dispatcher branch is_egp=True&lt;br&gt;• &lt;code&gt;purchase_request_approval&lt;/code&gt; — selection_add: in_approval · dispatcher branch is_egp=False + auto-create PA&lt;br&gt;• &lt;code&gt;purchase_request_sarabun&lt;/code&gt; — _on_sarabun_completed → _transition_after_sarabun_approve() · _on_sarabun_rejected → button_rejected&lt;br&gt;• &lt;code&gt;purchase_request_budget&lt;/code&gt; — button_cancel override (cancel commitment)&lt;br&gt;• &lt;code&gt;migrations/16.0.0.1.0/post-migration.py&lt;/code&gt; — legacy approved / validate / cancelled → new states" vertex="1">
          <mxGeometry height="160" width="800" x="400" y="1080" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
