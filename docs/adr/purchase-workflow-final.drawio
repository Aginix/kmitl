        <mxCell id="s_purch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="อยู่ระหว่างจัดซื้อจัดจ้าง" vertex="1">
