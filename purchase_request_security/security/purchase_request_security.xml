<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request.group_purchase_request_user" model="res.groups">
        <field name="name">Purchase Request User : Own Documents Only</field>
    </record>

    <record id="group_purchase_request_user_all" model="res.groups">
        <field name="name">Purchase Request User : All Documents</field>
        <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchase_request_user'))]" />
        <field name="category_id" ref="purchase_request.module_category_purchase_request" />
    </record>
    <record id="purchase_request.group_purchase_request_manager" model="res.groups">
        <field name="name">Purchase Request Manager</field>
        <field name="implied_ids" eval="[(4, ref('purchase_request_security.group_purchase_request_user_all'))]" />
    </record>

    <!-- add group to admin  -->
    <record id="add_admin_to_request_manager" model="res.groups">
        <field name="id" ref="purchase_request.group_purchase_request_manager"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <!-- rules -->
    <record id="purchase_request_user_all_rule" model="ir.rule">
        <field name="name">Purchase Request User : All Documents</field>
        <field name="model_id" ref="purchase_request.model_purchase_request" />
        <field name="groups" eval="[(6,0, [ref('purchase_request_security.group_purchase_request_user_all')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="purchase_request_line_user_all_rule" model="ir.rule">
        <field name="name">Purchase Request User : All Documents</field>
        <field name="model_id" ref="purchase_request.model_purchase_request_line" />
        <field name="groups" eval="[(6,0, [ref('purchase_request_security.group_purchase_request_user_all')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <!-- change cotext -->
    <function name="write" model="ir.actions.act_window">
        <value model="ir.actions.act_window" search="[('id', '=', ref('purchase_request.purchase_request_form_action'))]" />
        <value eval="{'context': '{}'}"/>
    </function>
</odoo>
