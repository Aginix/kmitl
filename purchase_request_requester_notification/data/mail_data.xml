<odoo>
    <record
        id="mail_act_purchase_request_requester_notification_reminder"
        model="mail.activity.type"
        forcecreate="1"
    >
        <field name="name">Tier Validation Reminder</field>
        <field name="icon">fa-bell</field>
    </record>

    <record id="email_purchase_request_to_approve" model="mail.template">
        <field name="name">PR To Approve Email</field>
        <field name="model_id" ref="purchase_request.model_purchase_request" />
        <field name="subject">PR ${object.name} รออนุมัติ</field>
        <field name="email_from"
            >${(object.requested_by.email or 'noreply@example.com')}</field
        >
        <field name="email_to">${object.requested_by.email}</field>
        <field name="body_html"
            ><![CDATA[ <p>เรียนคุณ ${object.requested_by.name},</p>
            <p>เอกสารขอซื้อ/ขอจ้างหมายเลข <strong>${object.name}</strong>
            รออนุมัติแล้ว</p> <p>เรื่อง: ${object.title}</p> <p>สถานะปัจจุบัน:
            ${object.state}</p> <br/> <p>ขอบคุณ</p> ]]></field
        >
    </record>
</odoo>
