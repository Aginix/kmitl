<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="automation_notify_reserve_budget" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: แจ้งเจ้าหน้าที่จองงบประมาณเมื่อเข้าสถานะรอตรวจสอบ/จองงบประมาณ</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '!=', 'to_verify')]</field>
            <field name="filter_domain">[('state', '=', 'to_verify')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state')])]"
            />
            <field name="state">code</field>
            <field name="code">
role = env.ref("budget_role.role_budget_commitment", raise_if_not_found=False)
if role:
    for record in records:
        ou = record.operating_unit_id
        if not ou:
            continue
        record.activity_schedule(
            "agx_approval_budget_todo.mail_activity_reserve_budget",
            summary="คำขออนุมัติเลขที่ %s รอตรวจสอบและจองงบประมาณ" % (record.name or ""),
            responsible_role_id=role.id,
            operating_unit_id=ou.id,
        )
</field>
        </record>

        <record id="automation_clear_reserve_budget" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: ล้าง Todo จองงบประมาณเมื่อออกจากสถานะรอตรวจสอบ/จองงบประมาณ</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '=', 'to_verify')]</field>
            <field name="filter_domain">[('state', '!=', 'to_verify')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state')])]"
            />
            <field name="state">code</field>
            <field name="code">records.activity_unlink(["agx_approval_budget_todo.mail_activity_reserve_budget"])</field>
        </record>

    </data>
</odoo>
