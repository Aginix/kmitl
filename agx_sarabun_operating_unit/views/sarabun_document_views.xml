<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sarabun_document_form" model="ir.ui.view">
        <field name="name">sarabun.document.form.operating_unit</field>
        <field name="model">sarabun.document</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_document_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other']//field[@name='sender_user_id']" position="after">
                <field
                    name="operating_unit_id"
                    widget="selection"
                    attrs="{'readonly': [('state', '!=', 'draft')]}"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </xpath>
        </field>
    </record>

    <record id="view_sarabun_document_tree" model="ir.ui.view">
        <field name="name">sarabun.document.tree.operating_unit</field>
        <field name="model">sarabun.document</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_document_tree" />
        <field name="arch" type="xml">
            <field name="sender_department_id" position="after">
                <field
                    name="operating_unit_id"
                    optional="hide"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </field>
        </field>
    </record>

    <record id="view_sarabun_document_search" model="ir.ui.view">
        <field name="name">sarabun.document.search.operating_unit</field>
        <field name="model">sarabun.document</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_document_search" />
        <field name="arch" type="xml">
            <field name="type_id" position="after">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </field>
            <filter name="group_dept" position="after">
                <filter
                    name="group_operating_unit"
                    string="Operating Unit"
                    context="{'group_by': 'operating_unit_id'}"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </filter>
        </field>
    </record>
</odoo>
