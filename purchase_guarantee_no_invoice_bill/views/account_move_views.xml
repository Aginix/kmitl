<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View account.move form -->
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_guarantee.view_move_form"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='guarantee_ids']" position="attributes">
            <attribute name="invisible">1</attribute>
          </xpath>
          <xpath expr="//field[@name='return_guarantee_ids']" position="attributes">
            <attribute name="invisible">1</attribute>
          </xpath>
        </field>
    </record>

  </odoo>