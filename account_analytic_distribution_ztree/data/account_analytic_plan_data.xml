<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Enable the tree picker for KMITL's hierarchical dimensions.
             Sources/kmitl_project/procurement_plan are flat and keep the
             plain search; admins can enable other plans via the checkbox. -->
        <record
            id="account_analytic_kmitl.analytic_plan_departments"
            model="account.analytic.plan"
        >
            <field name="use_ztree_widget" eval="True" />
        </record>
        <record
            id="account_analytic_kmitl.analytic_plan_funds"
            model="account.analytic.plan"
        >
            <field name="use_ztree_widget" eval="True" />
        </record>
        <record
            id="account_analytic_kmitl.analytic_plan_activities"
            model="account.analytic.plan"
        >
            <field name="use_ztree_widget" eval="True" />
        </record>
    </data>
</odoo>
