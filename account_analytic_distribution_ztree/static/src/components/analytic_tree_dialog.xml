<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="account_analytic_distribution_ztree.AnalyticTreeNode" owl="1">
        <div
            class="o_analytic_ztree_node"
            t-attf-style="padding-left: {{props.level * 16}}px"
        >
            <span
                t-if="props.node.hasChildren"
                class="o_analytic_ztree_toggle"
                t-on-click.stop="onToggle"
            >
                <i
                    t-attf-class="fa {{props.node.expanded ? 'fa-caret-down' : 'fa-caret-right'}}"
                />
            </span>
            <span t-else="" class="o_analytic_ztree_toggle_spacer" />
            <span class="o_analytic_ztree_label" t-on-click="onSelect">
                <span t-if="props.node.code" class="o_analytic_ztree_code">[<t
                        t-esc="props.node.code"
                    />]</span>
                <t t-esc="props.node.name" />
            </span>
        </div>
        <t t-if="props.node.expanded">
            <AnalyticTreeNode
                t-foreach="props.node.children"
                t-as="child"
                t-key="child.id"
                node="child"
                onToggle="props.onToggle"
                onSelect="props.onSelect"
                level="props.level + 1"
            />
        </t>
    </t>

    <t t-name="account_analytic_distribution_ztree.AnalyticTreeDialog" owl="1">
        <Dialog title="props.title" size="'md'">
            <input
                type="text"
                class="o_input mb-2 w-100"
                placeholder="'Search by name or code'"
                t-on-input="onSearchInput"
            />
            <t t-if="state.searchResults">
                <div class="o_analytic_ztree_search_results">
                    <div
                        t-if="!state.searchResults.length"
                        class="text-muted p-2"
                    >No results</div>
                    <div
                        t-foreach="state.searchResults"
                        t-as="rec"
                        t-key="rec.id"
                        class="o_analytic_ztree_row"
                        t-on-click="() => this.selectSearchResult(rec)"
                    >
                        <span t-if="rec.code" class="o_analytic_ztree_code">[<t
                                t-esc="rec.code"
                            />]</span>
                        <t t-esc="rec.complete_name" />
                    </div>
                </div>
            </t>
            <t t-else="">
                <div t-if="state.loading" class="text-muted p-2">Loading...</div>
                <div t-else="" class="o_analytic_ztree_tree">
                    <div
                        t-if="!state.rootNodes.length"
                        class="text-muted p-2"
                    >No accounts</div>
                    <AnalyticTreeNode
                        t-foreach="state.rootNodes"
                        t-as="node"
                        t-key="node.id"
                        node="node"
                        onToggle.bind="toggleNode"
                        onSelect.bind="selectNode"
                        level="0"
                    />
                </div>
            </t>
            <t t-set-slot="footer">
                <button
                    class="btn btn-secondary"
                    t-on-click="() => this.props.close()"
                >Close</button>
            </t>
        </Dialog>
    </t>

</templates>
