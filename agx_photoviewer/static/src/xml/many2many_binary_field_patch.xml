<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-inherit="web.Many2ManyBinaryField.attachment_preview"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_attachment_wrap')]" position="attributes">
            <attribute
                name="t-att-class"
            >{'o_agx_photoviewer_previewable': isPreviewable(file)}</attribute>
            <attribute
                name="t-on-click"
            >(ev) => this.onPreviewClick(ev, file)</attribute>
        </xpath>
    </t>

</templates>
