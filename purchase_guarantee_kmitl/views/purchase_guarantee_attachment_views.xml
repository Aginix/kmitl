<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.guarantee.attachment View Tree -->
    <record id="view_purchase_guarantee_attachment_tree" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.attachment.tree</field>
        <field name="model">purchase.guarantee.attachment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View purchase.guarantee.attachment form -->
    <record id="view_purchase_guarantee_attachment_form" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.attachment.form</field>
        <field name="model">purchase.guarantee.attachment</field>
        <field name="arch" type="xml">
            <form string="Purchase Guarantee Attachment">
                <sheet>
                    <group name="file" string="รายละเอียดไฟล์">
                        <field name="file" filename="file_name" />
                        <field name="file_name" string="ชื่อไฟล์ที่แสดง" />
                        <field name="description" string="คำอธิบาย" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View purchase.guarantee.attachment search -->
    <record id="view_purchase_guarantee_attachment_search" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.attachment.search</field>
        <field name="model">purchase.guarantee.attachment</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action purchase.guarantee.attachment -->
    <record id="action_purchase_guarantee_attachment" model="ir.actions.act_window">
        <field name="name">Purchase Guarantee Attachment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.guarantee.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Guarantee Attachment.
            </p>
        </field>
    </record>

</odoo>
