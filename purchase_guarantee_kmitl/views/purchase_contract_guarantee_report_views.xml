<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_purchase_contract_guarantee_report_tree" model="ir.ui.view">
        <field name="name">view.purchase.contract.guarantee.report.tree</field>
        <field name="model">purchase.contract.guarantee.report</field>
        <field name="arch" type="xml">
            <tree string="Contract Guarantee Register" create="0" edit="0" delete="0">
                <field name="contract_number"/>
                <field name="contract_name"/>
                <field name="partner_id"/>
                <field name="contract_type_id"/>
                <field name="work_start"/>
                <field name="work_end"/>
                <field name="purchase_state" widget="badge"
                    decoration-info="purchase_state in ('draft', 'sent')"
                    decoration-success="purchase_state in ('purchase', 'done')"
                    decoration-danger="purchase_state == 'cancel'"/>
                <field name="guarantee_type_id"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount"/>
                <field name="amount_total" optional="show"/>
                <field name="fines_late" optional="hide"/>
                <field name="contract_period_days" optional="hide"/>
                <field name="date_due_display"/>
                <field name="date_return" optional="hide"/>
                <field name="guarantee_return_state" widget="badge"
                    decoration-info="guarantee_return_state == 'pending'"
                    decoration-success="guarantee_return_state == 'returned'"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_purchase_contract_guarantee_report_pivot" model="ir.ui.view">
        <field name="name">view.purchase.contract.guarantee.report.pivot</field>
        <field name="model">purchase.contract.guarantee.report</field>
        <field name="arch" type="xml">
            <pivot string="Contract Guarantee Register" disable_linking="True">
                <field name="partner_id" type="row"/>
                <field name="contract_number" type="row"/>
                <field name="contract_name" type="row"/>
                <field name="contract_type_id" type="row"/>
                <field name="guarantee_count" type="measure"/>
                <field name="amount_returned" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_contract_guarantee_report_search" model="ir.ui.view">
        <field name="name">view.purchase.contract.guarantee.report.search</field>
        <field name="model">purchase.contract.guarantee.report</field>
        <field name="arch" type="xml">
            <search string="Contract Guarantee Register">
                <field name="contract_number"/>
                <field name="contract_name"/>
                <field name="partner_id"/>
                <filter
                    string="Cash/Transfer"
                    name="filter_cash"
                    domain="[('guarantee_type_id.name', '=', 'เงินสด/เงินโอน')]"
                />
                <separator/>
                <filter
                    string="Pending"
                    name="filter_pending"
                    domain="[('guarantee_return_state', '=', 'pending')]"
                />
                <filter
                    string="Returned"
                    name="filter_returned"
                    domain="[('guarantee_return_state', '=', 'returned')]"
                />
                <group expand="0" string="Group By">
                    <filter string="Contract Type" name="group_contract_type" context="{'group_by': 'contract_type_id'}"/>
                    <filter string="Guarantee Type" name="group_guarantee_type" context="{'group_by': 'guarantee_type_id'}"/>
                    <filter string="Contract Status" name="group_purchase_state" context="{'group_by': 'purchase_state'}"/>
                    <filter string="Guarantee Return Status" name="group_return_state" context="{'group_by': 'guarantee_return_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contract_guarantee_report" model="ir.actions.act_window">
        <field name="name">Contract Guarantee Register</field>
        <field name="res_model">purchase.contract.guarantee.report</field>
        <field name="view_mode">tree,pivot</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_purchase_contract_guarantee_report_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_purchase_contract_guarantee_report_pivot')}),
        ]"/>
        <field name="search_view_id" ref="view_purchase_contract_guarantee_report_search"/>
    </record>

    <!-- Report menu item -->
    <menuitem
        id="menu_contract_guarantee_report"
        name="Contract Guarantee Register"
        parent="purchase.purchase_report_main"
        action="action_contract_guarantee_report"
        sequence="10"
    />
</odoo>
