<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View purchase.guarantee tree -->
    <record id="view_purchase_guarantee_tree" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.tree</field>
        <field name="model">purchase.guarantee</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_guarantee.view_purchase_guarantee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='bill_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
      
    <!-- View purchase.guarantee form -->
    <record id="view_purchase_guarantee_form" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.form</field>
        <field name="model">purchase.guarantee</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_guarantee.view_purchase_guarantee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="attributes">
              <attribute name="required">False</attribute>
              <attribute name="attrs">{'invisible': [('purchase_id', '=', False)]}</attribute>
            </xpath>

            <xpath expr="//field[@name='note']" position="after">
              <field name="receive_contract_ref" string="Receive contract reference"/>
              <field name="return_contract_ref" string="Return contract reference"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
              <notebook>
                <page name="document" string="Attachment">
                    <field name="document_ids">
                        <tree>
                            <field name="file_name"/>
                            <field name="description" />
                        </tree>
                    </field>
                </page>
              </notebook>
            </xpath>
        </field>
    </record>

    <menuitem
        id="kmitl_guarantee_agreement"
        name="Guarantee"
        parent="agreement.agreement_menu"
        action="l10n_th_gov_purchase_guarantee.purchase_guarantee_action"
        sequence="10"/>

    <menuitem
        id="kmitl_guarantee_purchase"
        name="Guarantee"
        parent="purchase.menu_purchase_root"
        action="l10n_th_gov_purchase_guarantee.purchase_guarantee_action"
        sequence="10"/>

  </odoo>