<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_advance_payment_related_document_kind_list" model="ir.ui.view">
        <field name="name">advance.payment.related.document.kind.list</field>
        <field name="model">advance.payment.related.document.kind</field>
        <field name="arch" type="xml">
            <tree string="ชนิดเอกสารอ้างอิง">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="model_id" />
                <field name="number_field_id" />
                <field name="subject_field_id" />
                <field name="date_field_id" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="view_advance_payment_related_document_kind_form" model="ir.ui.view">
        <field name="name">advance.payment.related.document.kind.form</field>
        <field name="model">advance.payment.related.document.kind</field>
        <field name="arch" type="xml">
            <form string="ชนิดเอกสารอ้างอิง">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        ผู้ยืมค้นเอกสารชนิดนี้ด้วยเลขที่โดยใช้สิทธิ์ระบบ ใครพิมพ์เลขที่ถูกจะเห็น "เรื่อง"
                        ของเอกสารนั้นได้ ให้เลือกเฉพาะเอกสารที่เปิดเผยเรื่องได้
                    </div>
                    <group>
                        <field name="name" />
                        <field name="model_id" options="{'no_create': True}" />
                        <field
                            name="number_field_id"
                            options="{'no_create': True}"
                            attrs="{'invisible': [('model_id', '=', False)]}"
                        />
                        <field
                            name="subject_field_id"
                            options="{'no_create': True}"
                            attrs="{'invisible': [('model_id', '=', False)]}"
                        />
                        <field
                            name="date_field_id"
                            options="{'no_create': True}"
                            attrs="{'invisible': [('model_id', '=', False)]}"
                        />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advance_payment_related_document_kind" model="ir.actions.act_window">
        <field name="name">ชนิดเอกสารอ้างอิง</field>
        <field name="res_model">advance.payment.related.document.kind</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_advance_payment_related_document_kind"
        name="ชนิดเอกสารอ้างอิง"
        parent="advance_payment.menu_advance_payment_config"
        action="action_advance_payment_related_document_kind"
        sequence="30"
        groups="base.group_system"
    />
</odoo>
