<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_move_form" model="ir.ui.view">
        <field name="name">view.budget.move.form</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="is_budget_manager" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('is_budget_manager', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
