<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_form_sarabun" model="ir.ui.view">
        <field name="name">advance.payment.form.sarabun</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">
            <!-- Smart button: linked หนังสือ. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sarabun_document_count" invisible="1" />
                <field name="sarabun_has_live_document" invisible="1" />
                <button type="object" name="action_view_sarabun_documents"
                    class="oe_stat_button" icon="fa-file-text-o"
                    attrs="{'invisible': [('sarabun_document_count', '=', 0)]}"
                    string="หนังสือ" />
            </xpath>

            <!-- "สร้างหนังสือ" replaces the base manual "อนุมัติ" fallback once
                 the bridge is installed: available at to_approve when no live
                 หนังสือ. -->
            <xpath expr="//button[@name='action_approve']" position="after">
                <button name="action_submit_to_sarabun" string="สร้างหนังสือ"
                    type="object" class="btn-primary"
                    attrs="{'invisible': ['|', ('state', '!=', 'to_approve'), ('sarabun_has_live_document', '=', True)]}"
                    groups="advance_payment.group_advance_payment_loan_officer" />
            </xpath>

            <!-- Sarabun routing replaces direct approval — hide the fallback. -->
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ungrouped field declarations + Sarabun status notice, between
                 the statusbar and the sheet. -->
            <xpath expr="//header" position="after">
                <field name="sarabun_is_draft" invisible="1" />
                <div class="alert alert-warning mb-2" role="alert"
                    attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1" />
                    หนังสือถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                    <button name="action_view_sarabun_documents" type="object"
                        class="btn btn-sm btn-warning ms-2" string="เปิดหนังสือเพื่อส่ง" />
                </div>
                <div class="alert alert-info mb-2" role="alert"
                    attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1" />
                    สถานะการเดินหนังสือ:
                    <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_advance_payment_list_sarabun" model="ir.ui.view">
        <field name="name">advance.payment.list.sarabun</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="active_sarabun_document_id" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
