<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template
        id="report_mis_report_instance_hierarchy"
        inherit_id="mis_builder.report_mis_report_instance"
    >
        <xpath
            expr="//div[hasclass('mis_cell')][hasclass('mis_rowlabel')]"
            position="attributes"
        >
            <attribute
                name="t-att-style"
            >(style_obj.to_css_style(row.style_props) or '') + '; padding-left:' + str(getattr(row, 'level', 0) * 1.5) + 'em;'</attribute>
        </xpath>
    </template>

</odoo>
