<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.guarantee form -->
    <record id="view_purchase_guarantee_form" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.form</field>
        <field name="model">purchase.guarantee</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_guarantee.view_purchase_guarantee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
              <header>
                <button
                        name="button_draft"
                        states="lock"
                        string="Draft"
                        type="object"
                    />
                
                <button
                        name="button_lock"
                        states="draft"
                        string="Lock"
                        type="object"
                        class="oe_highlight"
                    />
                
                <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,lock"
                    />
              </header>
            </xpath>

            <xpath expr="//field[@name='reference']" position="before">
              <field name="is_editable" invisible="1" />
            </xpath>

            <xpath expr="//field[@name='reference']" position="attributes">
              <attribute name="attrs">{'readonly': [('is_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
              <attribute name="attrs">{'readonly': [('is_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='guarantee_type_id']" position="attributes">
              <attribute name="attrs">{'readonly': [('is_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
              <attribute name="attrs">{'readonly': [('is_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_guarantee_receive']" position="attributes">
              <attribute name="attrs">{'readonly': [('is_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='document_ref']" position="attributes">
              <attribute name="attrs">{'readonly': [('is_editable', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>

  </odoo>