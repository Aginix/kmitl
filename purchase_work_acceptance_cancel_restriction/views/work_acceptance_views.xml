<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View work.acceptance form -->
    <record id="view_work_acceptance_form" model="ir.ui.view">
        <field name="name">view.work.acceptance.form</field>
        <field name="model">work.acceptance</field>
        <field name="inherit_id" ref="purchase_work_acceptance.view_work_acceptance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,in_review,accept</attribute>
            </xpath>

            <xpath expr="//button[@name='button_accept']" position="attributes">
                <attribute name="states">in_review</attribute>
            </xpath>

            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="states">draft,in_review</attribute>
                <attribute name="confirm">Are you sure you want to Cancel?</attribute>
            </xpath>

            <xpath expr="//button[@name='button_cancel']" position="after">
                <button
                        name="button_cancel"
                        type="object"
                        states="accept"
                        string="Cancel"
                        groups="purchase.group_purchase_manager"
                        confirm="Are you sure you want to Cancel?"
                    />
            </xpath>
        </field>
    </record>

    <record id="view_l10n_work_acceptance_form" model="ir.ui.view">
        <field name="name">view.work.acceptance.form l10n inherit</field>
        <field name="model">work.acceptance</field>
        <field name="inherit_id" ref="l10n_th_gov_work_acceptance.view_work_acceptance_form_tier_validation"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='request_validation']" position="attributes">
                <attribute name="states">draft</attribute>
            </xpath>
            
            <!-- Warning -->
            <xpath expr="//div[contains(@class, 'alert-warning')]" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', '|', '|',
                        ('validated', '=', True),
                        ('state', 'not in', ['in_review']),
                        ('rejected', '=', True),
                        ('review_ids', '=', [])]}
                </attribute>
            </xpath>

            <!-- Success -->
            <xpath expr="//div[contains(@class, 'alert-success')]" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', '|',
                        ('validated', '!=', True),
                        ('state', 'not in', ['in_review']),
                        ('review_ids', '=', [])]}
                </attribute>
            </xpath>

            <!-- Danger -->
            <xpath expr="//div[contains(@class, 'alert-danger')]" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', '|',
                        ('rejected', '!=', True),
                        ('state', 'not in', ['in_review']),
                        ('review_ids', '=', [])]}
                </attribute>
            </xpath>
        </field>
    </record>
  </odoo>