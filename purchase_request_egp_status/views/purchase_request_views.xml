<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_egp.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="before">
                <field name="egp_status" readonly="1" widget="badge" decoration-info="egp_status == 'waiting'" decoration-warning="egp_status == 'in_progress'" decoration-success="egp_status == 'done'" attrs="{'invisible': [('egp_status', '=', False)]}" />
                <field name="can_edit_egp" invisible="1" />
            </xpath>
            <xpath expr="//page[@name='egp_page']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('is_egp', '=', False), ('state', 'not in', ('approved', 'in_progress', 'done'))]}</attribute>
            </xpath>
            <xpath expr="//field[@name='egp_project_id']" position="attributes">
                <attribute name="attrs">
        {
            'readonly': [('can_edit_egp', '=', False)],
            'required': [('egp_status', '!=', False)]
        }
                </attribute>
            </xpath>
            <xpath expr="//button[@name='button_done']" position="after">
                <button name="action_egp_in_progress" type="object" string="อยู่ในกระบวนการ e-GP" attrs="{'invisible': ['|', ('state', '!=', 'approved'), ('egp_status', '!=', 'waiting')]}" class="btn-primary"/>
            </xpath>
            <xpath expr="//button[@type='action']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@type='action']" position="after">
                <button name="action_create_rfq" type="object" string="สร้างใบจัดซื้อ/จ้าง" attrs="{'invisible': ['|', ('state', 'not in', ('approved', 'in_progress')), ('purchase_count', '!=', 0)]}" class="btn-primary"/>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="egp_status" widget="badge" decoration-info="egp_status == 'waiting'" decoration-warning="egp_status == 'in_progress'" decoration-success="egp_status == 'done'" optional="show" />
            </field>
        </field>
    </record>
</odoo>
