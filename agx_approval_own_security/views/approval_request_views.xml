<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Own only" users cannot edit the requester (ผู้ขออนุมัติ): it is always
         themselves. Driven by the per-user is_own_only_user flag so Users and
         Managers (who also carry group_approval_own via the imply) keep the
         normal editable behaviour. -->
    <record id="approval_request_view_form_own" model="ir.ui.view">
        <field name="name">approval.request.form.own.readonly.owner</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="is_own_only_user" invisible="1"/>
            </field>
            <field name="owner_id" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('is_plan_editable', '=', False), ('is_own_only_user', '=', True)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
