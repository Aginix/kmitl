<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Email Template: Transfer Submitted for Approval -->
        <record id="email_template_budget_transfer_submitted" model="mail.template">
            <field name="name">Budget Transfer: Submitted for Approval</field>
            <field name="model_id" ref="model_budget_transfer"/>
            <field name="subject">Budget Transfer Approval Required: {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear Budget Approver,
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        A new budget transfer request has been submitted and requires your approval.
                    </p>
                    <br/>
                    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F2F3; width:100%; margin: 16px 0px 16px 0px;">
                        <tr>
                            <td style="background-color:#875A7B; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;">
                                Transfer Details
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 16px 16px 16px;">
                                <table>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Transfer Number:</td>
                                        <td>{{ object.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Requested by:</td>
                                        <td>{{ object.user_id.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Date:</td>
                                        <td>{{ object.date }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Amount:</td>
                                        <td style="color: #875A7B; font-weight: bold;">{{ object.amount | safe }} {{ object.currency_id.name }}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F8F9FA; width:100%; margin: 16px 0px 16px 0px;">
                        <tr>
                            <td style="background-color:#17A2B8; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;">
                                Transfer Reason
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 16px 16px 16px;">
                                {{ object.reason | safe }}
                            </td>
                        </tr>
                    </table>

                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Please review and approve/reject this transfer request.
                    </p>
                    <br/>
                    <div style="text-align: center;">
                        <a href="/web#id={{ object.id }}&amp;model=budget.transfer&amp;view_type=form"
                           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            Review Transfer Request
                        </a>
                    </div>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Best regards,<br/>
                        {{ user.name }}<br/>
                        {{ user.company_id.name }}
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template: Transfer Approved -->
        <record id="email_template_budget_transfer_approved" model="mail.template">
            <field name="name">Budget Transfer: Approved</field>
            <field name="model_id" ref="model_budget_transfer"/>
            <field name="subject">Budget Transfer Approved: {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear {{ object.user_id.name }},
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Good news! Your budget transfer request has been approved.
                    </p>
                    <br/>
                    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #D4F6E8; width:100%; margin: 16px 0px 16px 0px;">
                        <tr>
                            <td style="background-color:#28A745; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;">
                                ✓ Transfer Approved
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 16px 16px 16px;">
                                <table>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Transfer Number:</td>
                                        <td>{{ object.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Approved by:</td>
                                        <td>{{ object.approver_id.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Approval Date:</td>
                                        <td>{{ object.approval_date }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Amount:</td>
                                        <td style="color: #28A745; font-weight: bold;">{{ object.amount | safe }} {{ object.currency_id.name }}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Your transfer is now ready to be posted. A manager will complete the posting process shortly.
                    </p>
                    <br/>
                    <div style="text-align: center;">
                        <a href="/web#id={{ object.id }}&amp;model=budget.transfer&amp;view_type=form"
                           style="background-color: #28A745; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            View Transfer
                        </a>
                    </div>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Best regards,<br/>
                        {{ user.name }}<br/>
                        {{ user.company_id.name }}
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template: Transfer Rejected -->
        <record id="email_template_budget_transfer_rejected" model="mail.template">
            <field name="name">Budget Transfer: Rejected</field>
            <field name="model_id" ref="model_budget_transfer"/>
            <field name="subject">Budget Transfer Rejected: {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear {{ object.user_id.name }},
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        We regret to inform you that your budget transfer request has been rejected.
                    </p>
                    <br/>
                    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F8D7DA; width:100%; margin: 16px 0px 16px 0px;">
                        <tr>
                            <td style="background-color:#DC3545; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;">
                                ✗ Transfer Rejected
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 16px 16px 16px;">
                                <table>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Transfer Number:</td>
                                        <td>{{ object.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Rejected by:</td>
                                        <td>{{ object.approver_id.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Rejection Date:</td>
                                        <td>{{ object.approval_date }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Amount:</td>
                                        <td>{{ object.amount | safe }} {{ object.currency_id.name }}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #FFF3CD; width:100%; margin: 16px 0px 16px 0px;">
                        <tr>
                            <td style="background-color:#856404; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;">
                                Rejection Reason
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 16px 16px 16px;">
                                {{ object.rejection_reason | safe }}
                            </td>
                        </tr>
                    </table>

                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Please review the rejection reason and feel free to submit a new transfer request if needed.
                    </p>
                    <br/>
                    <div style="text-align: center;">
                        <a href="/web#id={{ object.id }}&amp;model=budget.transfer&amp;view_type=form"
                           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            View Transfer
                        </a>
                    </div>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Best regards,<br/>
                        {{ user.name }}<br/>
                        {{ user.company_id.name }}
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template: Transfer Posted/Completed -->
        <record id="email_template_budget_transfer_posted" model="mail.template">
            <field name="name">Budget Transfer: Completed</field>
            <field name="model_id" ref="model_budget_transfer"/>
            <field name="subject">Budget Transfer Completed: {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email_formatted or '') }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear {{ object.user_id.name }},
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Your budget transfer has been successfully completed and posted to the budget system.
                    </p>
                    <br/>
                    <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #D1ECF1; width:100%; margin: 16px 0px 16px 0px;">
                        <tr>
                            <td style="background-color:#17A2B8; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;">
                                ✓ Transfer Completed
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 16px 16px 16px;">
                                <table>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Transfer Number:</td>
                                        <td>{{ object.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Amount:</td>
                                        <td style="color: #17A2B8; font-weight: bold;">{{ object.amount | safe }} {{ object.currency_id.name }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Posted Date:</td>
                                        <td>{{ object.write_date }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-right: 20px; font-weight: bold;">Budget Move:</td>
                                        <td>{{ object.move_id.name }}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        The budget amounts have been successfully transferred and are now available for use in the destination accounts.
                    </p>
                    <br/>
                    <div style="text-align: center;">
                        <a href="/web#id={{ object.id }}&amp;model=budget.transfer&amp;view_type=form"
                           style="background-color: #17A2B8; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            View Transfer
                        </a>
                    </div>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Thank you for using the budget transfer system.
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Best regards,<br/>
                        Budget Management System<br/>
                        {{ user.company_id.name }}
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
