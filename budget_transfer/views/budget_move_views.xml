<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A transfer's ledger move is authored through its budget.transfer
         (ADR-0013): a stat button links back to it. get_formview_action also
         redirects internal-link opens straight to the transfer. -->
    <record id="view_budget_move_form_transfer_link" model="ir.ui.view">
        <field name="name">budget.move.form.transfer.link</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_transfer" invisible="1"/>
                <button name="action_open_transfer" type="object" class="oe_stat_button"
                        icon="fa-exchange"
                        attrs="{'invisible': [('is_transfer', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Budget</span>
                        <span class="o_stat_text">Transfer</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
