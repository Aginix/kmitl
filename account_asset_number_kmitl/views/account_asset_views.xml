<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_number.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number']" position="after">
                <field name="is_asset_number_editable" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='number']" position="attributes">
                <attribute name="attrs">{'readonly':[('is_asset_number_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//button[@name='validate']" position="after">
                <field name="has_asset_number" invisible="1"/>
                <button name="create_asset_number" string="Get Asset Number" type="object" class="oe_highlight" attrs="{'invisible': [('has_asset_number', '=', True)]}"/>
                <button name="action_force_confirm" type="object" string="Force Confirm" attrs="{'invisible': [('state', '!=', 'draft')]}" groups="base.group_erp_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_tree" model="ir.ui.view">
        <field name="name">view.account.asset.tree</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="create_asset_number" string="Get Asset Number" type="object" class="btn-primary" />
                </header>
            </xpath>
        </field>
    </record>

</odoo>
