<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View account.asset form -->
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_number.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number']" position="attributes">
              <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

  </odoo>