<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order form -->
    <record id="view_purchase_ou_order_form" model="ir.ui.view">
        <field name="name">view.purchase.ou.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_operating_unit.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operating_unit_id']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_location']" position="after">
              <field name="operating_unit_id" readonly="1"/>
            </xpath>
        </field>
    </record>

  </odoo>