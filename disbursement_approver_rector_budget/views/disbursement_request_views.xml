<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field
            name="name"
        >disbursement.request.form (disbursement_approver_rector_budget)</field>
        <field name="model">disbursement.request</field>
        <field
            name="inherit_id"
            ref="disbursement_approver_rector.view_disbursement_request_form"
        />
        <field name="arch" type="xml">
            <button name="action_approve" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('can_approve_rector', '=', False), ('consumes_budget', '=', True)]}</attribute>
            </button>
            <button name="action_approve" position="after">
                <button
                    name="action_approve"
                    string="Approve (Rector Delegate)"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('can_approve_rector', '=', False), ('consumes_budget', '=', False)]}"
                    confirm="Approving this request also consumes its budget. Are you sure you want to approve it?"
                    groups="disbursement.group_disbursement_rector_delegate"
                />
            </button>
        </field>
    </record>
</odoo>
