<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_route_tree" model="ir.ui.view">
        <field name="name">disbursement.route.tree</field>
        <field name="model">disbursement.route</field>
        <field name="arch" type="xml">
            <tree string="Routes">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="view_disbursement_route_form" model="ir.ui.view">
        <field name="name">disbursement.route.form</field>
        <field name="model">disbursement.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="1" />
                    <field name="request_model" invisible="1" />
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="condition_domain" widget="domain" options="{'model': 'request_model'}" />
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="request_model" invisible="1" />
                            <field name="station_id" />
                            <field name="condition_domain" widget="domain" options="{'model': 'request_model'}" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_disbursement_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">disbursement.route</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_disbursement_route" name="Routes" parent="disbursement.menu_disbursement_config" action="action_disbursement_route" sequence="30" />
</odoo>
