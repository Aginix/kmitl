<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_station_tree" model="ir.ui.view">
        <field name="name">disbursement.station.tree</field>
        <field name="model">disbursement.station</field>
        <field name="arch" type="xml">
            <tree string="Work Stations">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="group_id" />
                <field name="is_signature" />
            </tree>
        </field>
    </record>

    <record id="view_disbursement_station_form" model="ir.ui.view">
        <field name="name">disbursement.station.form</field>
        <field name="model">disbursement.station</field>
        <field name="arch" type="xml">
            <form string="Work Station">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="1" />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="group_id" />
                            <field name="activity_type_id" />
                            <field name="is_signature" />
                            <field name="requires_codes" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_disbursement_station" model="ir.actions.act_window">
        <field name="name">Work Stations</field>
        <field name="res_model">disbursement.station</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_disbursement_station" name="Work Stations" parent="disbursement.menu_disbursement_config" action="action_disbursement_station" sequence="20" />
</odoo>
