          <mxGeometry x="560" y="1134" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t1_dv_d" value="ไปตาม route ต่อ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="1134" width="120" height="30" as="geometry" />
