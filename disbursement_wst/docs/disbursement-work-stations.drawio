        <mxCell id="t1_f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="t1_st5" target="t1_st6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t1_f6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="t1_st6" target="t1_st7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t1_f7" value="Hand-over — จากนี้เป็นงานของบัญชี" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="t1_st7" target="t1_st8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t1_f8" value="_finish_route()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1_st8" target="t1_done"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="t1_r1" value="ตีกลับไปแก้ — action_draft() → _reset_route()&lt;br/&gt;&lt;b&gt;ทำได้ก่อนตัดงบเท่านั้น&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;dashed=1;fontSize=9;exitX=0;exitY=0.03;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1_band" target="t1_draft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t1_r2" value="ยกเลิก — action_cancel() → _reset_route()&lt;br/&gt;กลับรายการผูกพันงบให้ด้วย" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;dashed=1;fontSize=9;exitX=0;exitY=0.97;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1_band" target="t1_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="t1_g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;dashed=1;endArrow=open;" edge="1" parent="1" source="t1_st3" target="t1_d3"><mxGeometry relative="1" as="geometry" /></mxCell>
