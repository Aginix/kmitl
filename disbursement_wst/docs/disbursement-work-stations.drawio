<mxfile host="Electron" modified="" version="26.0.0">
  <diagram id="dr-wst-route" name="เส้นทางงาน (Route)">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1_title" value="ใบขอเบิก (DR) เดินยังไง — route กับ work station" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="800" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t1_sub" value="core เหลือ state แค่ 6 ค่า · ตอนนี้ใบอยู่ที่ใคร ดูจาก station_code ซึ่งเป็น data ไม่ใช่ code" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="800" height="22" as="geometry" />
        </mxCell>

        <mxCell id="t1_legend" value="&lt;b&gt;อ่านภาพนี้ยังไง&lt;/b&gt;&lt;br/&gt;กล่องเหลือง = station ที่ต้องมีคนกดปุ่มส่งต่อ&lt;br/&gt;กล่องฟ้า = station ที่ปิดตัวเองเมื่อมีเหตุการณ์เกิดขึ้น ไม่มีใครต้องกด&lt;br/&gt;กรอบหนา = จุดที่ตัดงบ มีที่เดียวในเส้นทางทั้งหมด&lt;br/&gt;&quot;· ลงนาม&quot; = station นั้น is_signature จะโผล่เป็นช่องเซ็นในใบที่พิมพ์&lt;br/&gt;— — —&lt;br/&gt;เส้นเขียวทึบ = forward ส่งต่อตามปกติ&lt;br/&gt;เส้นม่วงประ = divert / detour&lt;br/&gt;เส้นแดงประ = ตีกลับไปแก้ หรือยกเลิก&lt;br/&gt;เส้นฟ้าประ = เอกสารที่เกิดขึ้นตรงนั้น" style="text;html=1;strokeColor=#666666;fillColor=#fafafa;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="60" width="440" height="200" as="geometry" />
        </mxCell>

        <mxCell id="t1_src" value="แทบไม่มีใครพิมพ์ใบขอเบิกเอง เอกสารต้นเรื่องสร้างให้&lt;br/&gt;ใบขออนุมัติ · ใบสั่งซื้อ · ตรวจรับงาน · สัญญายืมเงิน&lt;br/&gt;โครงการ · แผนจัดซื้อจัดจ้าง&lt;br/&gt;&lt;i&gt;โมดูล *_disbursement&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="250" height="76" as="geometry" />
        </mxCell>

        <mxCell id="t1_draft" value="ฉบับร่าง&lt;br/&gt;&lt;b&gt;draft&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="162" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t1_submitted" value="ยืนยันแล้ว&lt;br/&gt;&lt;b&gt;submitted&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t1_signed" value="ลงนามแล้ว&lt;br/&gt;&lt;b&gt;signed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="298" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t1_done" value="เสร็จสิ้น&lt;br/&gt;&lt;b&gt;done&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1060" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1_cancel" value="ยกเลิกแล้ว&lt;br/&gt;&lt;b&gt;cancel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1150" width="200" height="44" as="geometry" />
        </mxCell>

        <mxCell id="t1_band" value="&lt;b&gt;in_progress&lt;/b&gt; &amp;nbsp;&amp;nbsp; ช่วงที่ใบเดินอยู่บน route — route ถูกคัดลอกลงใบตอนลงนาม แล้วไม่เปลี่ยนอีก ต่อให้แอดมินไปแก้ route ทีหลังก็ไม่กระทบใบที่ออกเดินไปแล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f7fd;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="1010" height="690" as="geometry" />
        </mxCell>

        <mxCell id="t1_st1" value="หมวดตรวจ&lt;br/&gt;&lt;b&gt;verify&lt;/b&gt; · ลงนาม&lt;br/&gt;เจ้าหน้าที่เบิกจ่าย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="378" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st2" value="ผอ.กองคลังอนุมัติ&lt;br/&gt;&lt;b&gt;approve_finance&lt;/b&gt; · ลงนาม&lt;br/&gt;ผู้อำนวยการกองคลัง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="456" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st3" value="ผู้รับมอบอำนาจอนุมัติ&lt;br/&gt;&lt;b&gt;approve_rector&lt;/b&gt; · ลงนาม&lt;br/&gt;ผู้รับมอบอำนาจอธิการบดี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="534" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st4" value="ตั้งหนี้&lt;br/&gt;&lt;b&gt;bill&lt;/b&gt;&lt;br/&gt;เจ้าหน้าที่บัญชี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="612" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st5" value="ตรวจสอบการเบิกจ่าย&lt;br/&gt;&lt;b&gt;payment_audit&lt;/b&gt; · ลงนาม&lt;br/&gt;ผู้ตรวจสอบการเบิกจ่าย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="690" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st6" value="อนุมัติเบิกจ่าย&lt;br/&gt;&lt;b&gt;payment_authorize&lt;/b&gt; · ลงนาม&lt;br/&gt;ผู้อนุมัติเบิกจ่าย (มอบอำนาจอธิการ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="768" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st7" value="จ่ายเงิน&lt;br/&gt;&lt;b&gt;pay&lt;/b&gt;&lt;br/&gt;เจ้าหน้าที่การเงินจ่าย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="846" width="255" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1_st8" value="ล้างหนี้&lt;br/&gt;&lt;b&gt;clear&lt;/b&gt;&lt;br/&gt;เจ้าหน้าที่บัญชี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="924" width="255" height="64" as="geometry" />
        </mxCell>

        <mxCell id="t1_hooks" value="&lt;b&gt;station ต่อเข้ากับ engine ผ่าน hook 3 ตัวบน disbursement.request&lt;/b&gt;&lt;br/&gt;&lt;b&gt;_station_check(code)&lt;/b&gt; — ยังไปต่อไม่ได้ถ้า… (บิลยังไม่ post ครบ / ใบสำคัญยังจ่ายไม่ครบ)&lt;br/&gt;&lt;b&gt;_station_enter(code)&lt;/b&gt; — พอใบมาถึงแล้วทำอะไร (payment_audit → _ensure_payment_lines())&lt;br/&gt;&lt;b&gt;_station_complete(code)&lt;/b&gt; — พอส่งต่อแล้วทำอะไร (approve_rector → ตัดงบ, payment_authorize → ออกใบสำคัญจ่าย)&lt;br/&gt;&lt;br/&gt;engine ประกาศ hook ไว้เป็น no-op เฉย ๆ แล้วให้ station มา override เอง — engine เลยไม่รู้จัก station ตัวไหนเลยสักตัว" style="text;html=1;strokeColor=#9673a6;fillColor=#f9f5fc;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="372" width="630" height="140" as="geometry" />
        </mxCell>

        <mxCell id="t1_d3" value="&lt;b&gt;budget.commitment&lt;/b&gt; — ผูกพันและตัดงบ&lt;br/&gt;_action_approve_budget()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f3ff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="540" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1_d4" value="&lt;b&gt;account.move (in_invoice)&lt;/b&gt; — บิล 1 ใบต่อผู้รับเงิน 1 ราย&lt;br/&gt;post ครบทุกใบเมื่อไหร่ _on_bills_posted() ปิด station ให้เอง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f3ff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="618" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1_d5" value="&lt;b&gt;disbursement.payment.line&lt;/b&gt; — 1 แถวต่อผู้รับเงิน 1 ราย&lt;br/&gt;ผู้ตรวจเลือกเรื่องที่จ่าย แล้วทุกแถวได้หัวจ่ายของตัวเอง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f3ff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="696" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1_d6" value="&lt;b&gt;account.payment&lt;/b&gt; — ใบสำคัญจ่าย 1 ใบต่อ 1 แถว หักภาษีแล้ว&lt;br/&gt;กดอนุมัติเมื่อไหร่ ใบสำคัญเกิดตอนนั้น (ADR-0006)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f3ff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="774" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1_d7" value="&lt;b&gt;bank.payment.export&lt;/b&gt; ไฟล์ e-Payment + ใบรับรองหัก ณ ที่จ่าย&lt;br/&gt;ปิด 1 ไฟล์ = จ่ายผู้รับทุกคนที่อยู่ในไฟล์นั้น" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f3ff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="852" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1_d8" value="&lt;b&gt;account.move ของใบสำคัญจ่าย ถูก post&lt;/b&gt;&lt;br/&gt;post นี่แหละคือการล้างหนี้ · post ครบแล้ว station ปิดเอง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f3ff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="930" width="290" height="52" as="geometry" />
        </mxCell>

        <mxCell id="t1_rc_close" value="&lt;b&gt;step ปิดได้ 2 แบบ&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1) มีคนกด&lt;/b&gt; — step.act() เช็กว่า step ยัง active อยู่ไหม แล้วคนกดอยู่ใน group ของ station นั้นหรือเปล่า&lt;br/&gt;verify · approve_finance · approve_rector · payment_audit · payment_authorize&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2) ปิดตัวเองจากเหตุการณ์&lt;/b&gt; — เรียก _do_complete() ตรง ๆ ไม่ต้องเช็ก group เพราะเหตุการณ์นั้นผ่านการอนุมัติของมันเองมาแล้ว&lt;br/&gt;bill (บิลใบสุดท้าย post) · pay (ใบสำคัญใบสุดท้ายจ่าย) · clear (voucher ใบสุดท้าย post)" style="text;html=1;strokeColor=#d6b656;fillColor=#fffdf5;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="540" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t1_rc_sign" value="&lt;b&gt;ช่องเซ็นในใบที่พิมพ์ออกมา&lt;/b&gt;&lt;br/&gt;มีเฉพาะ 5 station ที่ is_signature = True&lt;br/&gt;ลายเซ็นถูกก๊อปเก็บไว้ที่ disbursement.step ตอนกด ใครไปแก้ข้อมูลใน HR ทีหลัง ใบเก่าก็ไม่เปลี่ยน&lt;br/&gt;station ที่ยังไม่ผ่าน ไม่พิมพ์อะไรออกมาเลย" style="text;html=1;strokeColor=#9673a6;fillColor=#f9f5fc;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="722" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t1_rc_settled" value="&lt;b&gt;สองคำนี้คนละเรื่องกัน&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;is_settled&lt;/b&gt; = ใบสำคัญทุกใบ finance_state = paid&lt;br/&gt;เงินออกจากบัญชีแล้ว เกิดที่ station &lt;b&gt;pay&lt;/b&gt; — &lt;i&gt;แต่ยังไม่ได้ลงบัญชี&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;state = done&lt;/b&gt; = เดินครบทุก station บน route&lt;br/&gt;เกิดที่ station &lt;b&gt;clear&lt;/b&gt; ตอนบัญชี post ครบ" style="text;html=1;strokeColor=#82b366;fillColor=#f6fbf4;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="844" width="310" height="140" as="geometry" />
        </mxCell>

        <mxCell id="t1_divert" value="&lt;b&gt;divert กับ detour&lt;/b&gt; &amp;nbsp;&amp;nbsp; — ไม่มีคำว่า &quot;ส่งกลับ&quot; ในระบบนี้แล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf8fd;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="1070" width="500" height="290" as="geometry" />
        </mxCell>
        <mxCell id="t1_dv_l1" value="come_back = True — ส่งไปแล้วให้กลับมาหาฉัน (ค่าเริ่มต้น)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="1110" width="420" height="18" as="geometry" />
