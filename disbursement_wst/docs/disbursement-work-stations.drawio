  <diagram id="dr-wst-modules" name="สถาปัตยกรรมโมดูล">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2_title" value="ใบขอเบิก — โมดูลหลังเปลี่ยนมาเป็น work station" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t2_sub" value="data อยู่ที่ bridge, verb อยู่ที่ station (ADR-0004) · station ไม่ depends กันเอง (ADR-0002)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="t2_legend" value="&lt;b&gt;อ่านภาพนี้ยังไง&lt;/b&gt; &amp;nbsp;&amp;nbsp; กล่องเหลือง = station ที่ต้องมีคนกด &amp;nbsp;·&amp;nbsp; กล่องฟ้า = station ที่ปิดตัวเอง&lt;br/&gt;เส้นเทาทึบ = &lt;b&gt;depends&lt;/b&gt; จริง ๆ ใน manifest ลูกศรชี้ไปตัวที่ถูกพึ่ง&lt;br/&gt;เส้นส้มประ = &lt;b&gt;requires_codes&lt;/b&gt; ลำดับที่ station ประกาศไว้เป็นสตริง — ไม่ใช่ depends ไม่ใช่ xmlid" style="text;html=1;strokeColor=#666666;fillColor=#fafafa;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="14" width="580" height="86" as="geometry" />
        </mxCell>

        <mxCell id="t2_l4" value="&lt;b&gt;ชั้น 4 — ส่วนเสริมที่เกาะ station ไม่ได้เกาะ core&lt;/b&gt; &amp;nbsp;&amp;nbsp; อะไรที่เป็นทางเลือกแยกเป็นโมดูลของตัวเอง ถอดออกแล้ว route ก็ยังเดินได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfaf7;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t2_a1" value="&lt;b&gt;disbursement_assignment_kmitl&lt;/b&gt;&lt;br/&gt;จ่ายงานตรวจให้เจ้าหน้าที่อัตโนมัติ&lt;br/&gt;disbursement.assignment.rule · รับงานเอง / โอนงานกันได้&lt;br/&gt;เคลียร์งานตอน _station_complete(&quot;verify&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="152" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="t2_a2" value="&lt;b&gt;disbursement_cash_revenue_handover&lt;/b&gt;&lt;br/&gt;ตอนตั้งหนี้ โอนเงินและรายได้ให้ส่วนงาน&lt;br/&gt;(เฉพาะงบแผ่นดิน)&lt;br/&gt;ต่อยอด _create_bill() ให้ร่าง JV เพิ่มอีกใบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="152" width="300" height="84" as="geometry" />
        </mxCell>

        <mxCell id="t2_l3" value="&lt;b&gt;ชั้น 3 — โมดูล station · 1 โมดูล = 1 station&lt;/b&gt; &amp;nbsp;&amp;nbsp; ไม่มีโมดูลฐานร่วมกัน และ&lt;b&gt;ไม่ depends กันเอง&lt;/b&gt; สิ่งเดียวที่รู้จักกันคือ code ที่เป็นสตริง&lt;br/&gt;อยากเพิ่ม station ก็ติดตั้งโมดูล อยากเอาออกก็ถอน (uninstall_hook ไม่ยอมให้ถอนถ้ายังมีใบค้างอยู่ที่ station นั้น)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1500" height="400" as="geometry" />
        </mxCell>

        <mxCell id="t2_s1" value="&lt;b&gt;disbursement_wst_verify&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;verify&lt;/b&gt; · sequence 10&lt;br/&gt;requires: —&lt;br/&gt;group: เจ้าหน้าที่เบิกจ่าย (ยืมของ core)&lt;br/&gt;is_signature: ใช่ · Todo: ไม่มี&lt;br/&gt;depends: disbursement_wst&lt;br/&gt;&lt;i&gt;มีแค่ขยายเงื่อนไข under_verification ของ core&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t2_s2" value="&lt;b&gt;disbursement_wst_approve_finance&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;approve_finance&lt;/b&gt; · sequence 20&lt;br/&gt;requires: verify&lt;br/&gt;group: ผู้อำนวยการกองคลัง (ของตัวเอง)&lt;br/&gt;is_signature: ใช่ · Todo: มี&lt;br/&gt;depends: disbursement_wst&lt;br/&gt;&lt;i&gt;Python 0 บรรทัด มีแต่ data ไม่แตะงบ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t2_s3" value="&lt;b&gt;disbursement_wst_approve_rector&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;approve_rector&lt;/b&gt; · sequence 30&lt;br/&gt;requires: approve_finance&lt;br/&gt;group: ผู้รับมอบอำนาจอธิการบดี (ของตัวเอง)&lt;br/&gt;is_signature: ใช่ · Todo: มี&lt;br/&gt;depends: disbursement_wst&lt;br/&gt;&lt;b&gt;_station_complete → _action_approve_budget()&lt;/b&gt;&lt;br/&gt;&lt;i&gt;ที่เดียวในระบบที่ผูกพันและตัดงบ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="320" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t2_s4" value="&lt;b&gt;disbursement_wst_bill&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;bill&lt;/b&gt; · sequence 40&lt;br/&gt;requires: approve_rector&lt;br/&gt;group: เจ้าหน้าที่บัญชี (ยืมของ accounting_kmitl)&lt;br/&gt;is_signature: ไม่ · Todo: ไม่มี&lt;br/&gt;depends: + &lt;b&gt;disbursement_accounting_kmitl&lt;/b&gt;&lt;br/&gt;&lt;i&gt;เป็นเจ้าของ method สร้างบิล และการ์ด KPI บนแดชบอร์ดบัญชี&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1190" y="320" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="t2_s5" value="&lt;b&gt;disbursement_wst_payment_audit&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;payment_audit&lt;/b&gt; · sequence 50&lt;br/&gt;requires: bill&lt;br/&gt;group: ผู้ตรวจสอบการเบิกจ่าย (ของตัวเอง)&lt;br/&gt;is_signature: ใช่ · Todo: มี&lt;br/&gt;depends: + &lt;b&gt;disbursement_finance_kmitl&lt;/b&gt;&lt;br/&gt;_station_enter → _ensure_payment_lines()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t2_s6" value="&lt;b&gt;disbursement_wst_payment_authorize&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;payment_authorize&lt;/b&gt; · sequence 60&lt;br/&gt;requires: payment_audit&lt;br/&gt;group: ผู้อนุมัติเบิกจ่าย (ของตัวเอง)&lt;br/&gt;is_signature: ใช่ · Todo: มี&lt;br/&gt;depends: + &lt;b&gt;disbursement_finance_kmitl&lt;/b&gt;&lt;br/&gt;_station_complete → _try_create_payments()&lt;br/&gt;&lt;i&gt;กดอนุมัติ = ใบสำคัญจ่ายเกิดตรงนั้น&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="500" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t2_s7" value="&lt;b&gt;disbursement_wst_pay&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;pay&lt;/b&gt; · sequence 70&lt;br/&gt;requires: payment_authorize&lt;br/&gt;group: เจ้าหน้าที่การเงินจ่าย (ของตัวเอง)&lt;br/&gt;is_signature: ไม่ · Todo: มี&lt;br/&gt;depends: + &lt;b&gt;disbursement_finance_kmitl&lt;/b&gt;&lt;br/&gt;&lt;i&gt;คอยดู account.payment — ใบสุดท้าย paid เมื่อไหร่ก็ _hand_over()&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="500" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t2_s8" value="&lt;b&gt;disbursement_wst_clear&lt;/b&gt;&lt;br/&gt;code: &lt;b&gt;clear&lt;/b&gt; · sequence 80&lt;br/&gt;requires: pay&lt;br/&gt;group: เจ้าหน้าที่บัญชี (ยืมของ accounting_kmitl)&lt;br/&gt;is_signature: ไม่ · Todo: มี&lt;br/&gt;depends: + &lt;b&gt;disbursement_finance_kmitl&lt;/b&gt;&lt;br/&gt;&lt;i&gt;คอยดู account.move._post() — post ครบแล้วปิด station · post = ล้างหนี้&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1190" y="500" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="t2_l2" value="&lt;b&gt;ชั้น 2 — bridge&lt;/b&gt; &amp;nbsp;&amp;nbsp; เก็บ data ที่เชื่อมใบขอเบิกกับเอกสารในแอปอื่น ไม่ตั้งชื่อ station ไม่รู้จัก route — station depends bridge เสมอ ไม่เคยกลับทาง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafd;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t2_b1" value="&lt;b&gt;disbursement_accounting_kmitl&lt;/b&gt; — bridge ระหว่างใบขอเบิกกับบิล&lt;br/&gt;เก็บ: account.move.disbursement_request_id · bill_ids&lt;br/&gt;ปุ่มดูรายการบันทึกบัญชีที่เกี่ยวข้อง (ไล่หา m2o ให้เอง)&lt;br/&gt;ยิงเหตุการณ์ _on_bills_posted() ไว้ให้ station มาเกาะ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="755" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t2_b2" value="&lt;b&gt;disbursement_finance_kmitl&lt;/b&gt; — bridge ระหว่างใบขอเบิกกับใบสำคัญจ่าย&lt;br/&gt;เก็บ: disbursement.payment.line (1 แถวต่อผู้รับ) · payment_subject_id (เรื่องที่จ่าย) · หัวจ่าย + ผลการจับคู่&lt;br/&gt;account.payment.disbursement_request_id + finance_state / export_status · bank.payment.export(.line) · _compute_is_settled&lt;br/&gt;&lt;i&gt;ส่วนเสริมที่เกาะ bridge ตัวนี้ ไม่ใช่ station: disbursement_cash_movement_kmitl (เส้นทางเดินเงินระหว่างบัญชี)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="755" width="600" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t2_l1" value="&lt;b&gt;ชั้น 1 — core กับ engine&lt;/b&gt; &amp;nbsp;&amp;nbsp; ชั้นนี้ไม่มีใครรู้จัก station ตัวไหนเลย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="t2_c1" value="&lt;b&gt;disbursement&lt;/b&gt; — ตัวใบขอเบิก ฝั่งคนขอ&lt;br/&gt;state 6 ค่า: draft · submitted · signed · in_progress · done · cancel&lt;br/&gt;&lt;b&gt;ปิดแล้ว&lt;/b&gt; ไม่มีโมดูลไหน selection_add เข้ามาได้อีก&lt;br/&gt;ช่องเซ็นในใบที่พิมพ์ · is_settled (ประกาศไว้ให้โมดูลปลายทางถาม)&lt;br/&gt;จบแค่ลายเซ็นหัวหน้าส่วนงาน ซึ่ง&lt;b&gt;ไม่ใช่ station&lt;/b&gt; (ADR-0003)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="965" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t2_c2" value="&lt;b&gt;disbursement_wst&lt;/b&gt; — engine&lt;br/&gt;disbursement.station · disbursement.route(.line) · disbursement.step · disbursement.divert.wizard&lt;br/&gt;ต่อ disbursement.request ให้มี: route_id · step_ids · current_step_id · &lt;b&gt;station_code&lt;/b&gt;&lt;br/&gt;station_code เป็น Selection ที่สร้างจาก station ที่ติดตั้งอยู่ → ลงโมดูลใหม่ status bar ยาวขึ้นเอง ไม่ต้องแก้ view&lt;br/&gt;hook ที่ประกาศไว้เป็น no-op: _station_check · _station_enter · _station_complete&lt;br/&gt;&lt;i&gt;รู้แค่ว่า station คืออะไร ไม่รู้จัก station ตัวไหนเลย&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="965" width="600" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t2_c3" value="&lt;b&gt;base_state_leadtime&lt;/b&gt;&lt;br/&gt;state.leadtime.mixin&lt;br/&gt;&lt;i&gt;ไว้ดูว่างานค้างที่ไหนนาน&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="995" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t2_n1" value="&lt;b&gt;requires_codes — ลำดับที่ประกาศเป็นสตริง ไม่ใช่ xmlid (ADR-0002)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;verify → approve_finance → approve_rector → bill → payment_audit → payment_authorize → pay → clear&lt;br/&gt;&lt;br/&gt;• station ไม่เคย import และไม่เคย depends กันเอง รู้จักกันแค่ชื่อ code&lt;br/&gt;• disbursement.route._check_station_order() ตรวจเฉพาะ station ที่อยู่บน route เดียวกัน&lt;br/&gt;• station ที่ไม่ได้ติดตั้ง หรือไม่ได้อยู่บน route ไม่บังคับอะไรเลย&lt;br/&gt;• ตอน divert ก็ใช้กฎเดียวกัน _check_divert_target() กันไม่ให้ข้ามงานที่ยังไม่เสร็จ&lt;br/&gt;• ผลคือถอด station กลางทางออกได้ ที่เหลือยังเดินต่อโดยไม่ต้องไปแก้โมดูลอื่น" style="text;html=1;strokeColor=#d79b00;fillColor=#fffaf3;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="740" height="190" as="geometry" />
        </mxCell>
        <mxCell id="t2_n2" value="&lt;b&gt;station หนึ่งตัวมีอะไรบ้าง&lt;/b&gt; (ดูตัวอย่างจาก disbursement_wst_approve_rector — 13 ไฟล์ Python 38 บรรทัด)&lt;br/&gt;&lt;br/&gt;__manifest__.py &amp;nbsp;depends: [disbursement_wst, bridge ถ้ามี] + uninstall_hook&lt;br/&gt;data/disbursement_station.xml &amp;nbsp;&lt;b&gt;noupdate=&quot;0&quot;&lt;/b&gt; — station เป็น code&lt;br/&gt;data/disbursement_route_line.xml &amp;nbsp;&lt;b&gt;noupdate=&quot;1&quot;&lt;/b&gt; — route เป็น config แอดมินแก้ได้&lt;br/&gt;data/mail_activity_type.xml &amp;nbsp;Todo ที่ยิงเข้าทุกคนใน group ตอนใบมาถึง&lt;br/&gt;models/disbursement_request.py &amp;nbsp;override hook 3 ตัว&lt;br/&gt;security/security.xml · views/ (ปุ่ม + คิวงาน) · i18n/th.po · CONTEXT.md&lt;br/&gt;&lt;br/&gt;&lt;b&gt;ไม่มีเมนู Work Stations&lt;/b&gt; และ ACL ของ disbursement.station เป็น 1,0,0,0 ทั้ง user และ manager — สร้าง station จากหน้าจอไม่ได้ เพราะจะได้ step ที่ไม่มีโค้ดรองรับ&lt;br/&gt;&lt;b&gt;คิวงานคือ list view&lt;/b&gt; กรองด้วย station_code ไม่ใช่หน้าจอใหม่ · กด Proceed ทีละหลายใบได้" style="text;html=1;strokeColor=#d6b656;fillColor=#fffdf5;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="1160" width="740" height="190" as="geometry" />
        </mxCell>
        <mxCell id="t2_n3" value="&lt;b&gt;ของเดิมที่หายไป&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;state selection ~39 ค่า ที่ core กับ bridge ช่วยกัน selection_add&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ เหลือ state 6 ค่า + station_code ที่เป็น data&lt;br/&gt;pipeline_status · display_status · approval_state (4 ฟิลด์สถานะเดินคู่กัน) → เหลือฟิลด์เดียว&lt;br/&gt;disbursement.request.signature → disbursement.step (เก็บลายเซ็นรายขั้น)&lt;br/&gt;ฟิลด์คนอนุมัติ / คนตรวจ แยกตัว (payment_auditor_id ฯลฯ) → acted_by_id / acted_date บน step&lt;br/&gt;ทางส่งกลับ 3 เส้น + disbursement.return.source.mixin + state &quot;returned&quot; ของ bridge ต้นทาง 4 ตัว&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ เหลือ divert ที่&lt;b&gt;ต้องใส่เหตุผล&lt;/b&gt; และ&lt;b&gt;นับสถิติได้&lt;/b&gt;" style="text;html=1;strokeColor=#b85450;fillColor=#fdf6f6;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1370" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t2_n4" value="&lt;b&gt;กฎที่งานชุดนี้ยึด&lt;/b&gt; (ตัวเต็มอยู่ใน disbursement_wst/docs/adr/)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;ADR-0001&lt;/b&gt; ใช้ station แทนคำศัพท์ state ที่ใครก็เติมได้&lt;br/&gt;&lt;b&gt;ADR-0002&lt;/b&gt; station ประกาศลำดับด้วย code ไม่ใช่ xmlid จึงไม่ depends กันเอง&lt;br/&gt;&lt;b&gt;ADR-0003&lt;/b&gt; ลายเซ็นหัวหน้าส่วนงานไม่ใช่ station&lt;br/&gt;&lt;b&gt;ADR-0004&lt;/b&gt; data อยู่ที่ bridge, verb อยู่ที่ station&lt;br/&gt;&lt;b&gt;ADR-0005&lt;/b&gt; ถอด station ออกได้ แต่ถอดตอนยังมีงานค้างไม่ได้ — ประวัติอยู่รอด งานค้างไม่รอด&lt;br/&gt;&lt;b&gt;disbursement/ADR-0003&lt;/b&gt; core ประกาศข้อเท็จจริงที่โมดูลปลายทางจะถาม (is_settled)&lt;br/&gt;&lt;br/&gt;คำศัพท์ที่ใช้ร่วมกัน: disbursement_wst/CONTEXT.md กับ disbursement/CONTEXT.md" style="text;html=1;strokeColor=#9673a6;fillColor=#f9f5fc;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="1370" width="740" height="180" as="geometry" />
        </mxCell>

