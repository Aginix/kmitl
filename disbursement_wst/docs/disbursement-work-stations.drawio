        <mxCell id="t1_dv_l2" value="come_back = False — ส่งไปแล้วไม่ต้องกลับมา" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="1188" width="420" height="18" as="geometry" />
