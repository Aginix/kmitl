<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form</field>
        <field name="model">purchase.request.approval</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_approval"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_approve']" position="attributes">
                <attribute name="attrs">{'invisible':['|' ,('validation_status', 'in', ('pending', 'rejected')), ('state', 'not in', ['submitted'])]}</attribute>
            </xpath>
            <xpath expr="//button[@name='button_approve']" position="after">
                <field name="validation_status" invisible="1" />
                <field name="need_validation" invisible="1" />
                <button name="request_validation" string="Request Validation" class="btn-primary" attrs="{'invisible': ['|', '|',
        ('need_validation', '!=', True),
        ('validation_status', 'in', ['pending', 'rejected']),
        ('state', 'not in', 'submitted')]}" type="object" />
            </xpath>

            <field name="state" position="after">
                <field name="validation_status" invisible="1" />
            </field>
        </field>
    </record>

</odoo>
