<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_advance_payment" model="ir.ui.view">
        <field name="name">purchase.request.form.advance_payment</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advance_payment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-handshake-o"
                    attrs="{'invisible': [('advance_payment_count', '=', 0)]}">
                    <field name="advance_payment_count" string="สัญญาเงินยืม" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Create advance payment button in header -->
            <xpath expr="//button[@name='button_done']" position="after">
                <field name="is_requested_by_current_user" invisible="1"/>
                <button name="action_create_advance_payment"
                    string="สร้างสัญญาเงินยืม"
                    type="object"
                    class="btn-primary"
                    attrs="{'invisible': ['|', '|', '|',
                        ('state', '!=', 'approved'),
                        ('payment_type', '!=', 'advance'),
                        ('advance_payment_count', '!=', 0),
                        ('is_requested_by_current_user', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
