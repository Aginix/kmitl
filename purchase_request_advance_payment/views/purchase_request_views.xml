<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_advance_payment" model="ir.ui.view">
        <field name="name">purchase.request.form.advance_payment</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <!-- Smart button. No create button: a loan is made in the advance
                 payment app by picking this request. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advance_payment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('advance_payment_count', '=', 0)]}">
                    <field name="advance_payment_count" string="สัญญาเงินยืม" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
