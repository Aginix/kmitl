<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_form_purchase_request" model="ir.ui.view">
        <field name="name">advance.payment.form.purchase_request</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible': [('purchase_request_count', '=', 0)]}">
                    <field name="purchase_request_count" string="คำขอซื้อขอจ้าง" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_advance_payment_list_purchase_request" model="ir.ui.view">
        <field name="name">advance.payment.list.purchase_request</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="purchase_request_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_advance_payment_search_purchase_request" model="ir.ui.view">
        <field name="name">advance.payment.search.purchase_request</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_search"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="purchase_request_id"/>
            </field>
            <filter name="group_loan_type" position="after">
                <filter string="คำขอซื้อขอจ้าง" name="group_purchase_request"
                    context="{'group_by': 'purchase_request_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
