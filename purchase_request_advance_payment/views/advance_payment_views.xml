<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_form_from_pr" model="ir.ui.view">
        <field name="name">advance.payment.form.from_pr</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form"/>
        <field name="arch" type="xml">
            <!-- Lock reference: readonly when setting disabled OR already has a value from PR -->
            <field name="reference" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('allow_manual_reference', '=', False), ('reference', '!=', False)]}</attribute>
            </field>
            <!-- Lock loan_type_id when created from PR -->
            <field name="loan_type_id" position="attributes">
                <attribute name="attrs">{'readonly': [('reference', '!=', False)]}</attribute>
            </field>
            <!-- Lock loan_amount when created from PR -->
            <field name="loan_amount" position="attributes">
                <attribute name="attrs">{'readonly': [('reference', '!=', False)]}</attribute>
            </field>
            <!-- Lock requested_by when created from PR -->
            <field name="requested_by" position="attributes">
                <attribute name="attrs">{'readonly': [('reference', '!=', False)]}</attribute>
            </field>
            <!-- Lock department_id when created from PR -->
            <field name="department_id" position="attributes">
                <attribute name="attrs">{'readonly': [('reference', '!=', False)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
