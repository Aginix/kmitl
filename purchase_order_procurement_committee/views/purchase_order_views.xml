<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Committee" name="committee">
                    <separator string="Work Acceptance Committee" />
                    <field
                        name="work_acceptance_committee_ids"
                        attrs="{'readonly': [('state', 'not in', ['draft', 'sent'])]}"
                        nolabel="1"
                        context="{'default_committee_type': 'work_acceptance'}"
                    >
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field
                                name="employee_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="name" />
                            <field name="approve_role" />
                            <field name="department_id" />
                            <field name="email" />
                            <field name="mobile_phone" />
                            <field name="note" />
                        </tree>
                    </field>
                </page>
                <page string="Work Supervisors" name="work_supervisor">
                    <field
                        name="work_supervisor_ids"
                        attrs="{'readonly': [('state', 'not in', ['draft', 'sent'])]}"
                        nolabel="1"
                        context="{'default_committee_type': 'work_supervisor'}"
                    >
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field
                                name="employee_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="name" />
                            <field name="department_id" />
                            <field name="email" />
                            <field name="mobile_phone" />
                        </tree>
                    </field>
                </page>
            </xpath>
            <field name="requesting_operating_unit_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
