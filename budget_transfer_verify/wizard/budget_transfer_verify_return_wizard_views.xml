<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_transfer_verify_return_wizard_form" model="ir.ui.view">
        <field name="name">budget.transfer.verify.return.wizard.form</field>
        <field name="model">budget.transfer.verify.return.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งกลับแก้ไข">
                <field name="transfer_id" invisible="1" />
                <group>
                    <field name="reason" placeholder="ระบุสิ่งที่ต้องแก้ไข..." />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="ส่งกลับแก้ไข"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
