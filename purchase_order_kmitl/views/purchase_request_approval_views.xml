<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form</field>
        <field name="model">purchase.request.approval</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_approval"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_approve']" position='after'>
                <field name="hide_create_po_button" invisible="1" />
                <button name="make_purchase_order" string="Create PO" type="object" class="btn-primary" attrs="{'invisible': [('hide_create_po_button','=',True)]}" />
            </xpath>
            <xpath expr="//field[@name='request_id']" position='after'>
                <div>
                    <label for="order_id"/>
                    <h2>
                        <field name="order_id" options="{'no_create': True}" />
                    </h2>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
