<?xml version="1.0" encoding="utf-8"?>
  <odoo>
    <record id="view_purchase_create_invoice_plan_form" model="ir.ui.view">
        <field name="name">view.purchase.create.invoice.plan.form</field>
        <field name="model">purchase.create.invoice.plan</field>
        <field name="inherit_id" ref="purchase_invoice_plan.view_purchase_create_invoice_plan"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='num_installment']" position="attributes">
              <attribute name="string">Number of installment</attribute>
            </xpath>

            <xpath expr="//field[@name='installment_date']" position="attributes">
              <attribute name="string">Installment date</attribute>
            </xpath>

            <xpath expr="//field[@name='interval']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='interval_type']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

  </odoo>
