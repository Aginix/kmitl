<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_inherit" model="ir.ui.view">
        <field name="name">view.purchase.request.form.inherit</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_id']" position="after">
                <field name="order_id" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
