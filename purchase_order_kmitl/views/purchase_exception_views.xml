<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.exception form -->
    <record id="view_purchase_exception_form" model="ir.ui.view">
        <field name="name">view.purchase.exception.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_exception.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='exception_ids']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

  </odoo>