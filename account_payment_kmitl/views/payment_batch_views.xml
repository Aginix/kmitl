<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="payment_cycle_view_form" model="ir.ui.view">
        <field name="name">payment.cycle.form</field>
        <field name="model">payment.cycle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="date"/>
                            <field name="account_fiscal_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="payment_cycle_view_tree" model="ir.ui.view">
        <field name="name">payment.cycle.tree</field>
        <field name="model">payment.cycle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="date"/>
                <field name="account_fiscal_year_id" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="payment_cycle_view_search" model="ir.ui.view">
        <field name="name">payment.cycle.search</field>
        <field name="model">payment.cycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Fiscal Year" name="group_by_fiscal_year" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_payment_cycle" model="ir.actions.act_window">
        <field name="name">รอบการจ่ายเงิน</field>
        <field name="res_model">payment.cycle</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างรอบการจ่ายเงินใหม่
            </p>
        </field>
    </record>

</odoo>
