<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit account.payment form: add Submit button, update statusbar -->
    <record id="view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.kmitl</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Hide original Confirm (action_post) in draft - force submit flow -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', '!=', 'submitted')]}</attribute>
            </xpath>

            <!-- Add Submit button before the hidden Confirm -->
            <xpath expr="//button[@name='action_post']" position="before">
                <button
                    name="action_submit"
                    string="Submit"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('state', '!=', 'draft')]}"
                    data-hotkey="v"
                />
            </xpath>

            <!-- Update Reset to Draft to also work from submitted -->
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', 'not in', ('posted', 'cancel', 'submitted'))]}</attribute>
            </xpath>

            <!-- Update statusbar to show submitted -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,submitted,posted</attribute>
            </xpath>

            <!-- Add KMITL payment type after payment_type -->
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="kmitl_payment_type_id"/>
            </xpath>

        </field>
    </record>

    <!-- Inherit account.payment tree: add kmitl_payment_type column -->
    <record id="view_account_payment_tree_inherit" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.kmitl</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kmitl_payment_type_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
