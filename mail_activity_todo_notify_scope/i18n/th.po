#. module: mail_activity_todo_notify_scope
#: model:ir.model.fields,field_description:mail_activity_todo_notify_scope.field_mail_activity__is_my_primary_todo
msgid "Is My Primary Todo"
msgstr "เป็น Todo หลักของฉัน"

