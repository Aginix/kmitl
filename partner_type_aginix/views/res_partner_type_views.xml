<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Tree View -->
    <record id="res_partner_type_tree" model="ir.ui.view">
        <field name="name">res.partner.type.tree</field>
        <field name="model">res.partner.type</field>
        <field name="arch" type="xml">
            <tree string="Partner Types">
                <field name="name" />
                <field name="company_type" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="res_partner_type_form" model="ir.ui.view">
        <field name="name">res.partner.type.form</field>
        <field name="model">res.partner.type</field>
        <field name="arch" type="xml">
            <form string="Partner Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Retail Customer" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_type" />
                        </group>
                    </group>
                    <group name="accounting_settings" string="Accounting Settings">
                        <group>
                            <field name="property_account_receivable_id" />
                            <field name="property_account_payable_id" />
                            <field name="wht_tax_id" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="res_partner_type_search" model="ir.ui.view">
        <field name="name">res.partner.type.search</field>
        <field name="model">res.partner.type</field>
        <field name="arch" type="xml">
            <search string="Partner Types">
                <field name="name" />
                <field name="company_type" />
                <filter
                    name="person"
                    string="Individual"
                    domain="[('company_type', '=', 'person')]"
                />
                <filter
                    name="company"
                    string="Company"
                    domain="[('company_type', '=', 'company')]"
                />
            </search>
        </field>
    </record>

    <!-- Action res.partner.type -->
    <record id="action_res_partner_type" model="ir.actions.act_window">
        <field name="name">Payee Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner.type</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No payee type yet. Click here to add one.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_res_partner_type"
        name="Partner Type"
        parent="purchase.menu_purchase_config"
        action="action_res_partner_type"
        sequence="10"
    />

</odoo>
