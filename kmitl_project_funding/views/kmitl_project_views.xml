<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_form" model="ir.ui.view">
        <field name="name">kmitl.project.form.funding</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_form" />
        <field name="arch" type="xml">
            <data>
                <div name="button_box" position="inside">
                    <button
                        name="action_open_funding"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                        groups="kmitl_project.group_kmitl_project_user"
                    >
                        <field
                            name="budget_amount"
                            widget="statinfo"
                            string="เงินสนับสนุน"
                        />
                    </button>
                </div>
                <xpath
                    expr="//group[@name='budget']/field[@name='budget_amount']"
                    position="after"
                >
                    <field
                        name="funding_in_progress"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                    <field
                        name="funding_shortfall"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                </xpath>
            </data>
        </field>
    </record>
</odoo>
