<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- kmitl.project.funding mirrors the visibility of its kmitl.project
         (ADR-0007): it is a project-level view, never budget's OU rules. -->
    <record id="kmitl_project_funding_company_rule" model="ir.rule">
        <field name="name">Project Funding: Multi-company</field>
        <field name="model_id" ref="model_kmitl_project_funding" />
        <field name="domain_force">[
            '|', ('company_id', '=', False), ('company_id', 'in', company_ids)
        ]</field>
        <field name="global" eval="True" />
    </record>

    <record id="kmitl_project_funding_operating_unit_rule" model="ir.rule">
        <field name="name">Project Funding: Operating Unit</field>
        <field name="model_id" ref="model_kmitl_project_funding" />
        <field name="domain_force">[
            '|',
            ('project_id.operating_unit_id', '=', False),
            ('project_id.operating_unit_id', 'in', user.operating_unit_ids.ids)
        ]</field>
        <field name="global" eval="True" />
    </record>

    <record id="kmitl_project_funding_user_rule" model="ir.rule">
        <field name="name">Project Funding: Own Projects</field>
        <field name="model_id" ref="model_kmitl_project_funding" />
        <field
            name="groups"
            eval="[(4, ref('kmitl_project.group_kmitl_project_user'))]"
        />
        <field name="domain_force">[
            '|',
            ('project_id.manager_id.user_id', '=', user.id),
            ('project_id.creating_user_id', '=', user.id)
        ]</field>
    </record>

    <record id="kmitl_project_funding_officer_rule" model="ir.rule">
        <field name="name">Project Funding: Officer Access</field>
        <field name="model_id" ref="model_kmitl_project_funding" />
        <field
            name="groups"
            eval="[(4, ref('kmitl_project.group_kmitl_project_user_all'))]"
        />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
