<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Whoever may read a ใบขอเบิก may read the request it references
         (agx_approval ADR-0010): the group rule beside agx_approval's
         own-requests-only one; the OU global rule lets them through via the
         same shared_group_ids. Its groups are THE list of ใบขอเบิก readers —
         approval.request._compute_shared_group_ids reads them from here. -->
    <record id="approval_request_disbursement_reader_rule" model="ir.rule">
        <field name="name">Approval Request: read when referenced by a disbursement request</field>
        <field name="model_id" ref="agx_approval.model_approval_request" />
        <field name="domain_force">[('shared_group_ids', 'in', user.groups_id.ids)]</field>
        <field
            name="groups"
            eval="[(6, 0, [ref('disbursement.group_disbursement_user'),
                           ref('disbursement.group_disbursement_head'),
                           ref('disbursement.group_disbursement_officer'),
                           ref('disbursement.group_disbursement_manager'),
                           ref('disbursement.group_disbursement_finance_director'),
                           ref('disbursement.group_disbursement_rector_delegate')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
