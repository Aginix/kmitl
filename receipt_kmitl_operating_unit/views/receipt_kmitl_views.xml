<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_kmitl_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.form.operating_unit</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="operating_unit_id" widget="selection"
                       groups="operating_unit.group_multi_operating_unit"/>
            </xpath>
        </field>
    </record>

    <record id="view_receipt_kmitl_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.tree.operating_unit</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="operating_unit_id"
                       groups="operating_unit.group_multi_operating_unit"
                       optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
