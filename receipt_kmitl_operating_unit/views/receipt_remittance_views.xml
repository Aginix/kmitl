<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_remittance_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.form.operating_unit</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_remittance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_analytic_id']" position="after">
                <!-- Ungrouped copy: the receipt_ids domain needs it for every user.
                     Keep it BEFORE the visible node: the form parser keeps the
                     last node's widget, and widget="selection" must win. -->
                <field name="operating_unit_id" invisible="1"/>
                <field name="operating_unit_id" widget="selection"
                       groups="operating_unit.group_multi_operating_unit"/>
            </xpath>
            <xpath expr="//field[@name='receipt_ids']" position="attributes">
                <attribute name="domain">[('state', '=', 'draft'),
                                          ('remittance_id', '=', False),
                                          ('department_analytic_id', 'child_of', department_analytic_id),
                                          ('company_id', '=', company_id),
                                          ('operating_unit_id', '=', operating_unit_id)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_receipt_remittance_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.tree.operating_unit</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_remittance_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="operating_unit_id"
                       groups="operating_unit.group_multi_operating_unit"
                       optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
