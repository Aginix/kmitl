<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.request form -->
    <record id="view_purchase_request_team_form" model="ir.ui.view">
        <field name="name">view.purchase.request.team.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='logs']/group" position="inside">
              <field name="team_id"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_purchase_request_team_filter" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_requests']" position="after">
              <filter name="my_team"
                      string="My Team"
                      domain="[('team_id.member_ids', 'in', uid)]"/>
            </xpath>
        </field>
    </record>

  </odoo>