<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View purchase.request.approval form -->
    <record id="view_purchase_request_approval_team_form" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="is_user_in_team" invisible="1"/>
                <field name="requesting_department_id" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='button_to_approve']" position="replace">
                <button
                    name="button_to_approve"
                    string="Request approval"
                    type="object"
                    class="oe_highlight"
                    attrs="{
                        'invisible': [
                            '|',
                            ('state', '!=', 'draft'),
                            ('is_user_in_team', '=', False)
                        ]
                    }"
                />
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="replace">
                <button
                    name="button_draft"
                    string="Reset"
                    type="object"
                    attrs="{
                            'invisible': [
                                '|',
                                ('state', '!=', 'to_approve'),
                                ('is_user_in_team', '=', False)
                            ]
                        }"
                    groups="purchase_request.group_purchase_request_manager"
                />
            </xpath>

            <xpath expr="//button[@name='button_approved']" position="replace">
                <button
                        name="button_approved"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        attrs="{
                            'invisible': [
                                '|',
                                ('state', '!=', 'to_approve'),
                                ('is_user_in_team', '=', False)
                            ]
                        }"
                        groups="purchase_request.group_purchase_request_manager"
                    />
            </xpath>

            <xpath expr="//button[@name='button_rejected']" position="replace">
                <button
                    name="button_rejected"
                    string="Reject"
                    type="object"
                    class="btn btn-danger"
                    attrs="{
                            'invisible': [
                                '|',
                                ('state', '!=', 'to_approve'),
                                ('is_user_in_team', '=', False)
                            ]
                        }"
                    groups="purchase_request.group_purchase_request_manager"
                />
            </xpath>

            <!-- need depends from purchase request approval operating unit -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Other Information" name="other">
                        <group>
                            <group>
                                <field name="team_id"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
