<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ================= Inbox list (L1) ================= -->
    <record id="view_my_todo_tree" model="ir.ui.view">
        <field name="name">kmitl.todo.tree</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <tree
                string="Todos"
                create="false"
                edit="false"
                decoration-bf="is_read_by_me == False"
                decoration-danger="state == 'overdue'"
                decoration-warning="state == 'today'"
                decoration-muted="is_read_by_me == True"
            >
                <field name="state" widget="badge" optional="show" />
                <field name="todo_category" optional="show" />
                <field name="summary" string="Subject" />
                <field name="res_name" string="Source" />
                <field name="res_model" string="App" optional="show" />
                <field name="operating_unit_id" string="Operating Unit" optional="show" />
                <field name="responsible_role_id" optional="hide" />
                <field name="user_id" optional="hide" />
                <field name="date_deadline" string="Deadline" />
                <field name="is_read_by_me" invisible="1" />
                <button
                    name="action_open_document"
                    type="object"
                    string="Open Source"
                    icon="fa-external-link"
                    class="btn-link"
                />
                <button
                    name="action_mark_read"
                    type="object"
                    string="Mark as Read"
                    icon="fa-check"
                    attrs="{'invisible': ['|', ('todo_category', 'not in', ['fyi', 'acknowledgement']), ('is_read_by_me', '=', True)]}"
                />
            </tree>
        </field>
    </record>

    <!-- ================= Inbox compact form ================= -->
    <record id="view_my_todo_form" model="ir.ui.view">
        <field name="name">kmitl.todo.form</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <form string="Todo" create="false" edit="false">
                <header>
                    <button
                        name="action_open_document"
                        type="object"
                        string="Open Source Document"
                        class="btn-primary"
                        icon="fa-external-link"
                    />
                    <button
                        name="action_mark_read"
                        type="object"
                        string="Mark as Read"
                        icon="fa-check"
                        attrs="{'invisible': ['|', ('todo_category', 'not in', ['fyi', 'acknowledgement']), ('is_read_by_me', '=', True)]}"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="summary" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="todo_category" />
                            <field name="activity_type_id" />
                            <field name="res_name" string="Source Document" />
                            <field name="res_model" string="Model" />
                        </group>
                        <group>
                            <field name="date_deadline" />
                            <field name="state" />
                            <field name="user_id" />
                            <field name="operating_unit_id" />
                            <field name="responsible_role_id" />
                            <field name="is_read_by_me" invisible="1" />
                        </group>
                    </group>
                    <field name="note" readonly="1" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= Search + filters + searchpanel ================= -->
    <record id="view_my_todo_search" model="ir.ui.view">
        <field name="name">kmitl.todo.search</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search string="Todos">
                <field name="summary" string="Subject" />
                <field name="res_name" string="Source" />
                <field name="activity_type_id" />
                <field name="operating_unit_id" />
                <filter
                    name="unread"
                    string="Unread"
                    domain="[('is_read_by_me', '=', False)]"
                />
                <separator />
                <filter
                    name="overdue"
                    string="Overdue"
                    domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="today"
                    string="Today"
                    domain="[('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="planned"
                    string="Planned"
                    domain="[('date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <separator />
                <filter
                    name="personal"
                    string="Assigned to me"
                    domain="[('user_id', '!=', False)]"
                />
                <filter
                    name="group"
                    string="Group"
                    domain="[('responsible_role_id', '!=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'todo_category'}"
                    />
                    <filter
                        name="group_type"
                        string="Activity Type"
                        context="{'group_by': 'activity_type_id'}"
                    />
                    <filter
                        name="group_model"
                        string="Source App"
                        context="{'group_by': 'res_model'}"
                    />
                    <filter
                        name="group_ou"
                        string="Operating Unit"
                        context="{'group_by': 'operating_unit_id'}"
                    />
                    <filter
                        name="group_deadline"
                        string="Deadline"
                        context="{'group_by': 'date_deadline'}"
                    />
                </group>
                <searchpanel>
                    <field name="todo_category" string="Category" enable_counters="1" />
                    <field
                        name="operating_unit_id"
                        string="Operating Unit"
                        select="multi"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ================= Action + menu ================= -->
    <record id="action_my_todos" model="ir.actions.act_window">
        <field name="name">Todos</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_my_todo', '=', True)]</field>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="search_view_id" ref="view_my_todo_search" />
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'sequence': 1, 'view_mode': 'tree', 'view_id': ref('view_my_todo_tree')}),
                   (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('view_my_todo_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending todos 🎉</p>
            <p>Work awaiting you from every app shows up here.</p>
        </field>
    </record>

    <menuitem id="menu_my_todos_root" name="Todos" sequence="1" />
    <menuitem
        id="menu_todo_inbox"
        name="Inbox"
        parent="menu_my_todos_root"
        action="action_my_todos"
        sequence="1"
    />

</odoo>
