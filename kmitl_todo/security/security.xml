<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A read receipt is private: each user sees and manages only their own. -->
    <record id="kmitl_todo_read_own_rule" model="ir.rule">
        <field name="name">Todo read receipts: own only</field>
        <field name="model_id" ref="model_kmitl_todo_read" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!--
      Completed-Todo history mirrors inbox visibility (ADR-0004): a user sees
      only Todos they completed, that were addressed to them personally, or
      that were routed to a role they hold in one of their operating units.
      Without this rule the log would leak approval outcomes + cross-OU history
      org-wide. role/OU ids are read via the sudo-computed res.users helpers
      (an ir.rule cannot sudo, and role_ids is ERP-manager restricted).
    -->
    <record id="kmitl_todo_log_visibility_rule" model="ir.rule">
        <field name="name">Completed Todos: own / addressed / role-in-unit</field>
        <field name="model_id" ref="model_kmitl_todo_log" />
        <field
            name="domain_force"
        >['|', '|', ('completed_by', '=', user.id), ('user_id', '=', user.id), '&amp;', ('responsible_role_id', 'in', user.kmitl_role_ids.ids), ('operating_unit_id', 'in', user.operating_unit_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
