<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
      "เจ้าหน้าที่แผน" — the Responsible Role used to route group Todos for
      procurement planning (ADR-0002). A base_user_role role names *who does the
      job* (deliberately assigned, date-bounded), distinct from merely holding
      the underlying permission group. Holders are intersected with a plan's
      Operating Unit to find the plan officers of that faculty.
    -->
    <record id="role_procurement_plan_officer" model="res.users.role">
        <field name="name">Procurement Plan Officer</field>
        <field
            name="implied_ids"
            eval="[(6, 0, [ref('procurement_plan.group_procurement_plan_user')])]"
        />
    </record>
</odoo>
