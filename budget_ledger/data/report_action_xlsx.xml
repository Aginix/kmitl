<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- XLSX export. Rendered against the throwaway carrier wizard; the real
         filters travel in the report ``data`` dict (see the client action's
         action_export_xlsx), so the spreadsheet mirrors the screen. -->
    <record id="action_report_budget_ledger_xlsx" model="ir.actions.report">
        <field name="name">สมุดรายการเคลื่อนไหวงบประมาณ (XLSX)</field>
        <field name="model">budget.ledger.export.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">budget_ledger.report_ledger_xlsx</field>
        <field name="report_file">budget_ledger.report_ledger_xlsx</field>
        <field name="binding_model_id" eval="False" />
    </record>
</odoo>
