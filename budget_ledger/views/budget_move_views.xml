<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_move_line_tree" model="ir.ui.view">
        <field name="name">budget.move.line.tree.budget_ledger</field>
        <field name="model">budget.move.line</field>
        <field name="inherit_id" ref="budget.view_budget_move_line_tree" />
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <field name="move_type" optional="show" />
                <field name="commitment_id" optional="show" />
                <field name="is_liquidation" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_budget_move_line_search" model="ir.ui.view">
        <field name="name">budget.move.line.search.budget_ledger</field>
        <field name="model">budget.move.line</field>
        <field name="inherit_id" ref="budget.view_budget_move_line_search" />
        <field name="arch" type="xml">
            <field name="source_analytic_id" position="after">
                <field name="commitment_id" />
                <separator />
                <filter
                    string="งบประมาณ (a)"
                    name="bucket_current"
                    domain="[('move_type', 'in', ('appropriation', 'entry'))]"
                />
                <filter string="จองงบ" name="bucket_reserve" domain="[('move_type', '=', 'reserve')]" />
                <filter string="ผูกพัน" name="bucket_obligate" domain="[('move_type', '=', 'obligate')]" />
                <filter string="เบิกจ่าย" name="bucket_consume" domain="[('move_type', '=', 'consume')]" />
            </field>
            <filter name="source_analytic_id" position="after">
                <filter string="ประเภท" name="group_move_type" context="{'group_by': 'move_type'}" />
                <filter string="ใบจองงบประมาณ" name="group_commitment" context="{'group_by': 'commitment_id'}" />
            </filter>
        </field>
    </record>

    <record id="view_budget_move_form" model="ir.ui.view">
        <field name="name">budget.move.form.budget_ledger</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form" />
        <field name="arch" type="xml">
            <field name="move_type" position="after">
                <field name="commitment_id" attrs="{'invisible': [('commitment_id', '=', False)]}" readonly="1" />
            </field>
        </field>
    </record>
</odoo>
