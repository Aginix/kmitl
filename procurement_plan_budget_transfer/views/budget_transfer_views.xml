<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_transfer_form" model="ir.ui.view">
        <field name="name">budget.transfer.form.procurement.plan</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <!-- Procurement-plan picker narrows to the plans matching the line's budget code / dimensions. -->
            <xpath
                expr="//field[@name='from_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id', 'in', allowed_procurement_plan_analytic_ids)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='from_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="before"
            >
                <field name="allowed_procurement_plan_analytic_ids" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='to_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id', 'in', allowed_procurement_plan_analytic_ids)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='to_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="before"
            >
                <field name="allowed_procurement_plan_analytic_ids" invisible="1" />
            </xpath>
        </field>
    </record>

</odoo>
