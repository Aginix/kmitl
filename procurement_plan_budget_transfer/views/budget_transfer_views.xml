<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_transfer_form" model="ir.ui.view">
        <field name="name">budget.transfer.form.procurement.plan</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <!-- Procurement-plan picker narrows to the plans matching the line's budget code / dimensions. -->
            <xpath
                expr="//field[@name='from_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id', 'in', allowed_procurement_plan_analytic_ids)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='from_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="before"
            >
                <field name="allowed_procurement_plan_analytic_ids" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='to_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id', 'in', allowed_procurement_plan_analytic_ids)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='to_line_ids']//form//field[@name='procurement_plan_analytic_id']"
                position="before"
            >
                <field name="allowed_procurement_plan_analytic_ids" invisible="1" />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="is_procurement_plan_floating_return" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="status"
                    attrs="{'invisible': [('is_procurement_plan_floating_return', '=', False)]}"
                >
                    <i class="fa fa-bolt" /> โอนคืนงบลอย — ใบโอนนี้สร้างจากหน้าแผนจัดซื้อจัดจ้าง <field
                        name="procurement_plan_id"
                        readonly="1"
                        class="oe_inline fw-bold"
                    />
                </div>
            </xpath>
            <!-- Lines carrying this dimension; "เปิด" opens the record in a new tab. -->
            <xpath expr="//notebook/page[@name='transfer_lines']" position="after">
                <page name="procurement_plans" string="แผนจัดซื้อจัดจ้าง">
                    <field name="procurement_plan_line_ids" nolabel="1" readonly="1">
                        <tree>
                            <field
                                name="procurement_plan_analytic_id"
                                string="แผนจัดซื้อจัดจ้าง"
                            />
                            <field name="department_analytic_id" />
                            <field name="transfer_direction" />
                            <field name="amount" widget="monetary" />
                            <field name="currency_id" invisible="1" />
                            <button
                                name="action_open_procurement_plan"
                                type="object"
                                string="เปิด"
                                icon="fa-external-link"
                            />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Plan form: โอนคืนงบลอย for budget users while the plan holds money. -->
    <record id="view_procurement_plan_form_floating_return" model="ir.ui.view">
        <field name="name">procurement.plan.form.floating.return</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <field name="has_held_money" invisible="1" />
                <button
                    name="action_open_floating_return"
                    string="โอนคืนงบลอย"
                    type="object"
                    groups="budget.group_budget_user"
                    attrs="{'invisible': ['|', ('has_held_money', '=', False), ('analytic_account_id', '=', False)]}"
                />
            </header>
        </field>
    </record>

</odoo>
