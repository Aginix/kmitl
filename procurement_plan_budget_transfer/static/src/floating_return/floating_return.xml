<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="procurement_plan_budget_transfer.FloatingReturn" owl="1">
        <div class="o_ppfr">
            <!-- No floating pool covers the plan, or it is used up -->
            <t t-if="data.step === 'input' and (!data.pool_found or isExhausted)">
                <div class="o_ppfr_nopool">
                    <div class="o_ppfr_icon"><i class="fa fa-info" /></div>
                    <t t-if="isReturn">
                        <h3>ไม่มีเงินที่โอนคืนงบลอยได้</h3>
                        <p t-if="isExhausted and data.claimed_amount">
                            เงินของแผนถูกกันไว้สำหรับ<t t-esc="data.claimed_label" /> ฿<t
                                t-esc="money(data.claimed_amount)"
                            /> แล้ว
                        </p>
                        <p t-elif="isExhausted">แผนยังไม่ได้รับงบประมาณ หรือโอนคืนครบแล้ว</p>
                        <p t-else="">
                            แผนยังไม่มีรหัสงบประมาณหรือมิติแผน
                        </p>
                    </t>
                    <t t-else="">
                    <h3 t-if="isExhausted">เงินลอยสำหรับแผนนี้ถูกใช้หมดแล้ว</h3>
                    <h3 t-else="">ไม่พบเงินลอยสำหรับแผนนี้</h3>
                    <p t-if="isExhausted">
                        เงินลอยที่พิกัดงบประมาณของแผนคงเหลือ ฿<t
                                t-esc="money(data.floating_available)"
                            />
                    </p>
                    <p t-else="">
                        ยังไม่มีงบประมาณจัดสรร (เงินลอย) ที่พิกัดงบประมาณของแผน<br
                            />หรือระดับที่ครอบพิกัดนี้
                    </p>
                    </t>
                    <div class="o_ppfr_coord">
                        <div class="o_ppfr_kicker">พิกัดงบประมาณของแผน</div>
                        <div class="o_ppfr_title" t-esc="data.plan_label" />
                        <t t-call="procurement_plan_budget_transfer.Dims">
                            <t t-set="dims" t-value="planDims" />
                        </t>
                    </div>
                    <div t-if="!isReturn" class="o_ppfr_next">
                        หากต้องการโอนงบประมาณจากพิกัดอื่น กรุณาทำใบโอนงบประมาณตามขั้นตอนปกติ
                    </div>
                </div>
            </t>

            <t t-else="">
                <t t-call="procurement_plan_budget_transfer.Steps" />

                <!-- Step 1: from → to + amount -->
                <t t-if="data.step === 'input'">
                    <div class="o_ppfr_flow">
                        <t t-if="isReturn">
                            <t t-call="procurement_plan_budget_transfer.PlanCard">
                                <t t-set="kicker" t-value="'จาก · แผนจัดซื้อจัดจ้าง'" />
                            </t>
                            <div class="o_ppfr_arrow"><i
                                    class="fa fa-long-arrow-right"
                                /></div>
                            <t t-call="procurement_plan_budget_transfer.PoolCard">
                                <t t-set="kicker" t-value="'ไป'" />
                            </t>
                        </t>
                        <t t-else="">
                            <t t-call="procurement_plan_budget_transfer.PoolCard">
                                <t t-set="kicker" t-value="'จาก'" />
                            </t>
                            <div class="o_ppfr_arrow"><i
                                    class="fa fa-long-arrow-right"
                                /></div>
                            <t t-call="procurement_plan_budget_transfer.PlanCard">
                                <t t-set="kicker" t-value="'ไป · แผนจัดซื้อจัดจ้าง'" />
                            </t>
                        </t>
                    </div>

                    <div
                        class="o_ppfr_amount"
                        t-att-class="{'o_ppfr_amount_bad': isOverAvailable}"
                    >
                        <label for="o_ppfr_amount_input"><t
                                t-if="isReturn"
                            >จำนวนเงินที่ต้องการโอนคืน</t><t
                                t-else=""
                            >จำนวนเงินที่ต้องการจัดสรร</t></label>
                        <div class="o_ppfr_amount_field">
                            <span class="o_ppfr_currency">฿</span>
                            <input
                                id="o_ppfr_amount_input"
                                type="text"
                                inputmode="decimal"
                                autocomplete="off"
                                placeholder="0.00"
                                t-att-style="'width: ' + ((state.raw or '0.00').length + 1) + 'ch'"
                                t-att-value="state.raw"
                                t-on-input="onAmountInput"
                                t-on-blur="onAmountBlur"
                            />
                        </div>
                        <div class="o_ppfr_hint">
                            <t t-if="isOverAvailable"><t
                                    t-if="isReturn"
                                >เกินยอดที่โอนคืนได้</t><t
                                    t-else=""
                                >เกินเงินลอยคงเหลือ</t> ฿<t
                                    t-esc="money(data.floating_available)"
                                /></t>
                            <a
                                t-elif="isReturn"
                                href="#"
                                t-on-click.prevent="onFillMax"
                            >คืนทั้งหมด ฿<t
                                    t-esc="money(data.floating_available)"
                                /></a>
                            <t t-elif="data.plan_total">วงเงินตามแผน ฿<t
                                    t-esc="money(data.plan_total)"
                                /></t>
                        </div>
                    </div>
                    <div
                        t-if="isOverPlan and !isOverAvailable"
                        class="o_ppfr_msg o_ppfr_msg_warn"
                    >
                        ยอดหลังโอนเกินวงเงินตามแผน
                    </div>
                    <div t-if="isReturn and data.claimed_amount" class="o_ppfr_msg">
                        กันไว้สำหรับ<t t-esc="data.claimed_label" /> ฿<t
                            t-esc="money(data.claimed_amount)"
                        /> — ส่วนนี้โอนคืนไม่ได้
                    </div>
                    <div
                        t-if="isReturn and data.commitment_status !== 'none'"
                        class="o_ppfr_msg"
                    >
                        แผนจองงบประมาณแล้ว — ยอดจองที่ยังไม่ผูกพันจะลดลงตามเงินที่โอนคืนอัตโนมัติ
                    </div>
                    <div
                        t-if="!isReturn and data.commitment_status === 'reserved'"
                        class="o_ppfr_msg"
                    >
                        แผนจองงบประมาณแล้ว — ใบจองจะปรับเป็นยอดใหม่อัตโนมัติ
                    </div>
                    <div
                        t-if="!isReturn and data.commitment_status === 'spending'"
                        class="o_ppfr_msg o_ppfr_msg_warn"
                    >
                        แผนเริ่มใช้จ่ายแล้ว — เงินที่จัดสรรเพิ่มจะเข้ามิติแผน แต่ใบจองเดิมจะไม่ขยายตามอัตโนมัติ
                    </div>
                </t>

                <!-- Step 2: short review -->
                <div t-elif="data.step === 'review'" class="o_ppfr_sum">
                    <div class="o_ppfr_big">
                        <div class="o_ppfr_big_label">จำนวนเงิน</div>
                        <div class="o_ppfr_big_value">฿<t t-esc="money(amount)" /></div>
                    </div>
                    <div class="o_ppfr_rows">
                        <t t-call="procurement_plan_budget_transfer.FromTo" />
                        <div class="o_ppfr_row">
                            <div class="o_ppfr_row_label">บันทึกช่วยจำ</div>
                            <div class="o_ppfr_row_value"><t
                                    t-esc="data.note or '—'"
                                /></div>
                        </div>
                    </div>
                    <div
                        class="o_ppfr_callout"
                    >ผ่านรายการทันที โดยไม่ผ่านกระบวนการขออนุมัติโอนงบประมาณ</div>
                </div>

                <!-- Step 3: the slip -->
                <div t-elif="data.step === 'done'" class="o_ppfr_sum">
                    <div class="o_ppfr_icon o_ppfr_icon_ok"><i
                            class="fa fa-check"
                        /></div>
                    <div class="o_ppfr_big">
                        <div class="o_ppfr_big_label"><t
                                t-if="isReturn"
                            >โอนคืนงบลอยสำเร็จ</t><t
                                t-else=""
                            >จัดสรรงบประมาณสำเร็จ</t></div>
                        <div class="o_ppfr_big_value">฿<t t-esc="money(amount)" /></div>
                    </div>
                    <div class="o_ppfr_rows">
                        <t t-call="procurement_plan_budget_transfer.FromTo" />
                        <div class="o_ppfr_row">
                            <div class="o_ppfr_row_label">เลขที่ใบโอน</div>
                            <div class="o_ppfr_row_value" t-esc="data.transfer_name" />
                        </div>
                        <div class="o_ppfr_row">
                            <div class="o_ppfr_row_label">วันที่/เวลา</div>
                            <div class="o_ppfr_row_value" t-esc="transferDate" />
                        </div>
                        <div class="o_ppfr_row">
                            <div class="o_ppfr_row_label">ผู้ทำรายการ</div>
                            <div class="o_ppfr_row_value" t-esc="transferUser" />
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <t t-name="procurement_plan_budget_transfer.Steps" owl="1">
        <div class="o_ppfr_steps">
            <t t-foreach="steps" t-as="label" t-key="label_index">
                <div
                    class="o_ppfr_step"
                    t-att-class="{'o_ppfr_step_on': label_index === stepIndex, 'o_ppfr_step_ok': label_index &lt; stepIndex}"
                >
                    <span class="o_ppfr_step_dot">
                        <i t-if="label_index &lt; stepIndex" class="fa fa-check" />
                        <t t-else="" t-esc="label_index + 1" />
                    </span>
                    <span class="o_ppfr_step_label" t-esc="label" />
                </div>
            </t>
        </div>
    </t>

    <!-- Complete names: ancestors muted, leaf in ink. -->
    <t t-name="procurement_plan_budget_transfer.Dims" owl="1">
        <dl class="o_ppfr_dims">
            <t t-foreach="dims" t-as="dim" t-key="dim.key">
                <dt t-esc="dim.label" />
                <dd>
                    <span class="o_ppfr_code">[<t t-esc="dim.code" />]</span>
                    <t t-foreach="dim.path" t-as="part" t-key="part_index">
                        <span class="o_ppfr_anc"><t t-esc="part" /> / </span>
                    </t>
                    <span class="o_ppfr_leaf" t-esc="dim.leaf" />
                </dd>
            </t>
        </dl>
    </t>

    <!-- The floating pool (allocation) or the plan's own coordinate it goes back to (return). -->
    <t t-name="procurement_plan_budget_transfer.PoolCard" owl="1">
        <div class="o_ppfr_acct" t-att-class="{'o_ppfr_acct_to': isReturn}">
            <div class="o_ppfr_kicker" t-esc="kicker" />
            <div class="o_ppfr_title"><t t-if="isReturn">เงินลอย (พิกัดของแผน)</t><t
                    t-else=""
                >เงินลอย</t></div>
            <t t-call="procurement_plan_budget_transfer.Dims">
                <t t-set="dims" t-value="poolDims" />
            </t>
            <div class="o_ppfr_bal">
                <span class="o_ppfr_bal_label"><t t-if="isReturn">คืนได้</t><t
                        t-else=""
                    >คงเหลือ</t></span>
                <span class="o_ppfr_bal_value">฿<t
                        t-esc="money(data.floating_available)"
                    /></span>
            </div>
            <div class="o_ppfr_after" t-att-class="{'o_ppfr_neg': isOverAvailable}">
                <t t-if="amount">หลังโอน <b>฿<t t-esc="money(floatingAfter)" /></b></t>
            </div>
        </div>
    </t>

    <t t-name="procurement_plan_budget_transfer.PlanCard" owl="1">
        <div class="o_ppfr_acct" t-att-class="{'o_ppfr_acct_to': !isReturn}">
            <div class="o_ppfr_kicker" t-esc="kicker" />
            <div class="o_ppfr_title" t-esc="data.plan_label" />
            <t t-call="procurement_plan_budget_transfer.Dims">
                <t t-set="dims" t-value="planDims" />
            </t>
            <div class="o_ppfr_bal">
                <span class="o_ppfr_bal_label">ได้รับจัดสรรแล้ว</span>
                <span class="o_ppfr_bal_value">฿<t
                        t-esc="money(data.plan_received)"
                    /></span>
            </div>
            <div class="o_ppfr_after">
                <t t-if="amount">หลังโอน <b>฿<t t-esc="money(planAfter)" /></b></t>
            </div>
        </div>
    </t>

    <t t-name="procurement_plan_budget_transfer.FromTo" owl="1">
        <div class="o_ppfr_row">
            <div class="o_ppfr_row_label">จาก</div>
            <div class="o_ppfr_row_value">
                <t t-if="isReturn" t-esc="data.plan_label" />
                <t t-else="">เงินลอย</t>
                <small t-esc="budgetCode(fromDims)" />
            </div>
        </div>
        <div class="o_ppfr_row">
            <div class="o_ppfr_row_label">ไป</div>
            <div class="o_ppfr_row_value">
                <t t-if="isReturn">เงินลอย (พิกัดของแผน)</t>
                <t t-else="" t-esc="data.plan_label" />
                <small t-esc="budgetCode(toDims)" />
            </div>
        </div>
    </t>

</templates>
