<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
      UC2: tag the existing purchase-request activity types so they surface in
      the unified inbox with a behavioural category. These are "create the next
      document" tasks assigned to a single user (assigned_to / requester) =
      Execution Todos (no Mark as Read; cleared by acting on the source).
      noupdate defaults to 0 so the field is set on install/upgrade.
    -->
    <record
        id="purchase_request_approval.mail_activity_awaiting_approval_creation"
        model="mail.activity.type"
    >
        <field name="todo_category">execution</field>
    </record>
    <record
        id="purchase_request_activity_kmitl.mail_activity_create_purchase_order"
        model="mail.activity.type"
    >
        <field name="todo_category">execution</field>
    </record>
</odoo>
