<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- FYI: พ.1 endorsed — notify user_id that the request has been approved -->
    <record id="mail_activity_pr_in_approval_fyi" model="mail.activity.type">
        <field name="name">แบบขอให้จัดหา (พ.1) ได้รับความเห็นชอบแล้ว</field>
        <field name="summary">แบบขอให้จัดหา (พ.1) ได้รับความเห็นชอบแล้ว</field>
        <field name="todo_category">acknowledgement</field>
        <field name="res_model">purchase.request.approval</field>
        <field name="icon">fa-info-circle</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Execution Todo: reserve the budget commitment while the พ.1 sits at to_verify_budget (รอจองงบประมาณ) -->
    <record id="mail_activity_pr_reserve_budget" model="mail.activity.type">
        <field name="name">Reserve budget (พ.1)</field>
        <field
            name="summary"
        >Reserve the budget commitment for the purchase request</field>
        <field name="todo_category">execution</field>
        <field name="res_model">purchase.request</field>
        <field name="icon">fa-money</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Execution Todo: create the endorsement letter (หนังสือขอความเห็นชอบให้จัดหา) at to_approve -->
    <record
        id="mail_activity_pr_awaiting_endorsement_letter"
        model="mail.activity.type"
    >
        <field name="name">Awaiting endorsement letter (พ.1)</field>
        <field
            name="summary"
        >Create the endorsement letter for the purchase request</field>
        <field name="todo_category">execution</field>
        <field name="res_model">purchase.request</field>
        <field name="icon">fa-file-text-o</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Execution Todo: authorized signer must sign the circulating Sarabun document at sent -->
    <record id="mail_activity_pr_awaiting_signer" model="mail.activity.type">
        <field name="name">Awaiting authorized signer (พ.1)</field>
        <field name="summary">Sign the endorsement letter for the purchase request</field>
        <field name="todo_category">execution</field>
        <field name="res_model">purchase.request</field>
        <field name="icon">fa-pencil-square-o</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Execution Todo: PR endorsed — proceed with PA creation (non-EGP) or EGP recording -->
    <record id="mail_activity_pr_endorsement_approved" model="mail.activity.type">
        <field name="name">Endorsement approved — proceed (พ.1)</field>
        <field
            name="summary"
        >Purchase request endorsement approved — proceed with next step</field>
        <field name="todo_category">execution</field>
        <field name="res_model">purchase.request</field>
        <field name="icon">fa-check-circle</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Execution Todo: PR endorsed — proceed with PA creation (non-EGP) or EGP recording -->
    <record id="mail_activity_create_purchase_order" model="mail.activity.type">
        <field name="name">ดำเนินการสร้างสัญญา/ใบสั่งซื้อ (PO)</field>
        <field
            name="summary"
        >กรุณาดำเนินการสร้างสัญญา/ใบสั่งซื้อ (PO)</field>
        <field name="todo_category">execution</field>
        <field name="res_model">purchase.request</field>
        <field name="icon">fa-check-circle</field>
        <field name="delay_count">0</field>
    </record>
</odoo>
