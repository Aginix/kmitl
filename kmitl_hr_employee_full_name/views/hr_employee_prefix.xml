<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="hr_employee_prefix_form_view">
        <field name="name">hr.employee.prefix.form (in
            hr_employee_prefix)</field>
        <field name="model">hr.employee.prefix</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_employee_prefix_search_view">
        <field name="name">hr.employee.prefix.search (in
            hr_employee_prefix)</field>
        <field name="model">hr.employee.prefix</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_employee_prefix_tree_view">
        <field name="name">hr.employee.prefix.tree (in
            hr_employee_prefix)</field>
        <field name="model">hr.employee.prefix</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>
    <record model="ir.actions.act_window" id="hr_employee_prefix_act_window">
        <field name="name">Prefixes</field>
        <field name="res_model">hr.employee.prefix</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record model="ir.ui.menu" id="hr_employee_prefix_menu">
        <field name="name">Prefixes</field>
        <field name="parent_id" ref="hr.menu_config_employee" />
        <field name="action" ref="hr_employee_prefix_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
