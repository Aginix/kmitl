<?xml version="1.0" ?>
<odoo>
    <record id="action_purchase_request_approval_exception" model="ir.actions.act_window">
        <field name="name">Purchase Request Approval Exception Rules</field>
        <field name="res_model">exception.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="base_exception.view_exception_rule_tree" />
        <field name="domain">[('model', 'in', ['purchase.request.approval', 'purchase.request.approval.line'])]</field>
        <field name="context">{'default_model' : 'purchase.request.approval'}</field>
    </record>
    <menuitem action="action_purchase_request_approval_exception" id="menu_purchase_request_approval_action" parent="purchase.menu_purchase_config" />
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">purchase_request_approval_exception.view_purchase_request_approval_form</field>
        <field name="model">purchase.request.approval</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_approval" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div class="alert alert-danger" role="alert" style="margin-bottom:0px;" attrs="{'invisible': [('exceptions_summary','=',False)]}">
                    <p>
                        <strong
                        >There are exceptions blocking this Purchase Request Approval:</strong>
                    </p>
                    <field name="exceptions_summary" />
                    <button name="action_ignore_exceptions" type="object" class="btn-danger" string="Ignore Exceptions" help="Click here to be able to confirm this Agreement regardless of the exceptions." groups="base_exception.group_exception_rule_manager" />
                </div>
            </sheet>
            <xpath expr="//field[@name='payment_type']/.." position="inside">
                <field name="ignore_exception" states="submitted" groups='base_exception.group_exception_rule_manager'/>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_request_approval_tree" model="ir.ui.view">
        <field name="name">purchase_request_approval_exception.view_purchase_request_approval_tree</field>
        <field name="model">purchase.request.approval</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_approval_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="main_exception_id" invisible="1" />
            </field>
        </field>
    </record>
    <menuitem action="action_purchase_request_approval_exception" id="menu_purchase_request_approval_config_exception" parent="purchase.menu_purchase_config" />
</odoo>
