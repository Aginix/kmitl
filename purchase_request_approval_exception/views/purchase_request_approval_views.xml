<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- (1) Filtered exception-rule shortcut — only the purchase.request.approval
         rules, under Purchase › Configuration right after OCA's
         "Purchase Request Exception Rules" menu
         (purchase_request_exception.menu_purchase_request_test). -->
    <record
        id="action_purchase_request_approval_exception_rule_tree"
        model="ir.actions.act_window"
    >
        <field name="name">Purchase Request Approval Exception Rules</field>
        <field name="res_model">exception.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="base_exception.view_exception_rule_tree" />
        <field name="domain">[('model', '=', 'purchase.request.approval')]</field>
        <field
            name="context"
        >{'active_test': False, 'default_model': 'purchase.request.approval'}</field>
    </record>
    <menuitem
        id="menu_purchase_request_approval_exception_rule"
        name="Purchase Request Approval Exceptions"
        action="action_purchase_request_approval_exception_rule_tree"
        parent="purchase.menu_purchase_config"
        sequence="50"
        groups="base_exception.group_exception_rule_manager"
    />

    <!-- (2) Show the detected exceptions on the พจ.1 form itself. exception_ids
         is written on the submit attempt, so the banner persists on the record
         afterwards. -->
    <record
        id="view_purchase_request_approval_form_exception"
        model="ir.ui.view"
    >
        <field name="name">purchase.request.approval.form.exception</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_form"
        />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    attrs="{'invisible': [('exceptions_summary', '=', False)]}"
                >
                    <field name="ignore_exception" invisible="1" />
                    <p>
                        <strong
                        >รายการนี้ติดเงื่อนไขตรวจทาน (ยังส่งเข้าสารบรรณไม่ได้):</strong>
                    </p>
                    <field name="exceptions_summary" />
                    <button
                        name="action_ignore_exceptions"
                        type="object"
                        class="btn-warning"
                        string="ข้ามเงื่อนไข (Ignore)"
                        help="ข้ามเฉพาะเงื่อนไขที่ไม่ใช่ blocking เพื่อส่งเข้าสารบรรณ"
                        groups="base_exception.group_exception_rule_manager"
                    />
                </div>
            </sheet>
        </field>
    </record>

    <!-- (3) List: an optional column + a search filter to spot พจ.1 that
         currently carry a review exception (main_exception_id is stored). -->
    <record
        id="view_purchase_request_approval_tree_exception"
        model="ir.ui.view"
    >
        <field name="name">purchase.request.approval.tree.exception</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_tree"
        />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="main_exception_id"
                    string="เงื่อนไขตรวจทาน"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record
        id="view_purchase_request_approval_search_exception"
        model="ir.ui.view"
    >
        <field name="name">purchase.request.approval.search.exception</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_search"
        />
        <field name="arch" type="xml">
            <filter name="approved" position="after">
                <separator />
                <filter
                    name="has_exception"
                    string="ติดเงื่อนไขตรวจทาน"
                    domain="[('main_exception_id', '!=', False)]"
                />
            </filter>
        </field>
    </record>
</odoo>
