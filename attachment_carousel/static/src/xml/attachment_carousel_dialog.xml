<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="attachment_carousel.Dialog" owl="1">
        <Dialog title="dialogTitle"
                size="'xl'"
                contentClass="'o_ac_dialog'"
                withBodyPadding="false"
                footer="false">
            <div class="o_ac d-flex flex-column">
                <t t-if="count === 0">
                    <div class="o_ac_empty text-center p-5 m-auto">
                        <i class="fa fa-folder-open-o fa-3x text-muted mb-3 d-block"/>
                        <p class="mb-0">ไม่มีไฟล์แนบ</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_ac_header d-flex align-items-center px-3 py-2 border-bottom">
                        <div class="o_ac_title flex-grow-1 text-truncate">
                            <span t-esc="current.name"/>
                        </div>
                        <button class="btn btn-sm btn-secondary" t-on-click="download">
                            <i class="fa fa-download me-1"/> ดาวน์โหลด
                        </button>
                    </div>

                    <div class="o_ac_viewer position-relative flex-grow-1">
                        <!-- Loading state covers any async render path -->
                        <div t-if="state.loading" class="o_ac_overlay">
                            <i class="fa fa-spinner fa-spin fa-2x text-white"/>
                        </div>

                        <!-- Error state wins over everything -->
                        <t t-if="state.error">
                            <div class="o_ac_unsupported text-center">
                                <i t-attf-class="fa fa-exclamation-triangle fa-4x text-warning mb-3 d-block"/>
                                <p class="mb-1">ไม่สามารถแสดงตัวอย่างได้</p>
                                <p class="text-muted small"><t t-esc="state.error"/></p>
                                <a class="btn btn-primary mt-2" t-att-href="contentUrl(current)" target="_blank">
                                    <i class="fa fa-download me-1"/> ดาวน์โหลดไฟล์
                                </a>
                            </div>
                        </t>
                        <t t-elif="isImage(current)">
                            <div class="o_ac_image_wrap">
                                <img class="o_ac_image" t-att-src="contentUrl(current)" t-att-alt="current.name"/>
                            </div>
                        </t>
                        <t t-elif="isPdf(current)">
                            <iframe class="o_ac_iframe" t-att-src="contentUrl(current)" frameborder="0"/>
                        </t>
                        <t t-elif="isDocx(current)">
                            <div class="o_ac_html_wrap">
                                <div t-if="state.htmlPreview" class="o_ac_html_preview" t-out="state.htmlPreview"/>
                            </div>
                        </t>
                        <t t-elif="isXlsx(current)">
                            <div class="o_ac_sheet_wrap d-flex flex-column">
                                <div t-if="state.sheets and state.sheets.length > 1" class="o_ac_sheet_tabs">
                                    <t t-foreach="state.sheets" t-as="sheet" t-key="sheet_index">
                                        <button class="o_ac_sheet_tab"
                                                t-att-class="{ active: sheet_index === state.activeSheet }"
                                                t-on-click="() => this.setSheet(sheet_index)">
                                            <t t-esc="sheet.name"/>
                                        </button>
                                    </t>
                                </div>
                                <div t-if="state.sheets" class="o_ac_html_preview o_ac_sheet_body" t-out="state.sheets[state.activeSheet].html"/>
                            </div>
                        </t>
                        <t t-elif="isPptx(current)">
                            <!-- PPTXjs renders into this div; key forces a fresh element per attachment switch -->
                            <div class="o_ac_pptx_wrap">
                                <div class="o_ac_pptx_container" t-ref="pptxContainer" t-key="state.renderKey"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="o_ac_unsupported text-center">
                                <i t-attf-class="fa fa-4x text-muted mb-3 d-block #{fileIcon(current)}"/>
                                <p class="mb-1">ไม่สามารถแสดงตัวอย่างไฟล์ประเภทนี้ได้</p>
                                <p class="text-muted small"><t t-esc="current.mimetype"/></p>
                                <a class="btn btn-primary mt-2" t-att-href="contentUrl(current)" target="_blank">
                                    <i class="fa fa-download me-1"/> ดาวน์โหลดไฟล์
                                </a>
                            </div>
                        </t>

                        <button t-if="count > 1"
                                class="o_ac_nav o_ac_prev btn btn-light"
                                t-on-click="prev"
                                title="Previous">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <button t-if="count > 1"
                                class="o_ac_nav o_ac_next btn btn-light"
                                t-on-click="next"
                                title="Next">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>

                    <div t-if="count > 1" class="o_ac_thumbs border-top">
                        <t t-foreach="props.attachments" t-as="att" t-key="att.id">
                            <div class="o_ac_thumb"
                                 t-att-class="{ o_ac_thumb_active: att_index === state.index }"
                                 t-on-click="() => this.goTo(att_index)"
                                 t-att-title="att.name">
                                <t t-if="isImage(att)">
                                    <img t-att-src="thumbnailUrl(att)" t-att-alt="att.name"/>
                                </t>
                                <t t-else="">
                                    <div class="o_ac_thumb_icon">
                                        <i t-attf-class="fa #{fileIcon(att)}"/>
                                    </div>
                                </t>
                                <div class="o_ac_thumb_name text-truncate"><t t-esc="att.name"/></div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </Dialog>
    </t>

</templates>
