<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="attachment_carousel.Field" owl="1">
        <div t-attf-class="oe_fileupload o_attachment_carousel_field {{props.className ? props.className : ''}}" aria-atomic="true">
            <div class="o_attachments">
                <t t-foreach="files" t-as="file" t-key="file_index">
                    <t t-set="editable" t-value="!props.readonly"/>
                    <div t-attf-class="o_attachment o_attachment_many2many o_ac_clickable d-flex flex-row align-items-center gap-1 #{ editable ? 'o_attachment_editable' : '' }"
                         t-att-title="file.name"
                         t-on-click="() => this.onFileClick(file_index)">
                        <div class="o_attachment_wrap">
                            <t t-set="ext" t-value="getExtension(file)"/>
                            <div class="o_image_box float-start" t-att-data-tooltip="'Preview ' + file.name">
                                <span class="o_image o_hover" t-att-data-mimetype="file.mimetype" t-att-data-ext="ext" role="img"/>
                            </div>
                            <div class="caption">
                                <span class="ml4"><t t-esc="file.name"/></span>
                            </div>
                            <div class="caption small">
                                <span class="ml4 small text-uppercase"><b><t t-esc="ext"/></b></span>
                            </div>
                            <div class="o_attachment_uploaded"><i class="text-success fa fa-check" role="img" aria-label="Uploaded" title="Uploaded"/></div>
                            <div t-if="editable" class="o_attachment_delete" t-on-click.stop="() => this.onFileRemove(file.id)">
                                <span class="text-white" role="img" aria-label="Delete" title="Delete">×</span>
                            </div>
                        </div>
                        <i class="fa fa-fw o_button_icon fa-warning" t-if="file.tooltip" t-att-data-tooltip="file.tooltip"/>
                    </div>
                </t>
            </div>
            <div t-if="!props.readonly" class="oe_add">
                <FileInput
                    acceptedFileExtensions="props.acceptedFileExtensions"
                    multiUpload="true"
                    onUpload.bind="onFileUploaded"
                    resModel="props.record.resModel"
                    resId="props.record.data.id or 0">
                    <button class="btn btn-secondary o_attach" data-tooltip="Attach">
                        <span class="fa fa-paperclip" aria-label="Attach"/> <t t-esc="props.uploadText"/>
                    </button>
                </FileInput>
            </div>
        </div>
    </t>

</templates>
