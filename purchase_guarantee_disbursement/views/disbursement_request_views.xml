<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form.guarantee</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_non_budget']" position="before">
                <field
                    name="purchase_guarantee_id"
                    readonly="1"
                    attrs="{'invisible': [('purchase_guarantee_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_disbursement_request_tree" model="ir.ui.view">
        <field name="model">disbursement.request</field>
        <field name="name">disbursement.request.tree.guarantee</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_non_budget']" position="after">
                <field name="purchase_guarantee_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
