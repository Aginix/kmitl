<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_guarantee_form" model="ir.ui.view">
        <field name="name">purchase.guarantee.form.disbursement</field>
        <field name="model">purchase.guarantee</field>
        <field
            name="inherit_id"
            ref="purchase_guarantee_kmitl.view_purchase_guarantee_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="has_active_return" invisible="1"/>
                <button
                    name="action_create_return_disbursement"
                    string="Return Guarantee"
                    type="object"
                    groups="disbursement.group_disbursement_user"
                    attrs="{'invisible': ['|', '|', ('is_monetary_guarantee', '=', False), ('has_active_return', '=', True), ('has_active_receipt', '=', False)]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disbursements"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    groups="disbursement.group_disbursement_user"
                    attrs="{'invisible': [('disbursement_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_count"
                        widget="statinfo"
                        string="Return Requests"
                    />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
