<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_move_form_reversal" model="ir.ui.view">
        <field name="name">budget.move.form.reversal</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_cancel']" position="after">
                <button name="action_reverse" string="กลับรายการ" type="object" attrs="{'invisible': [('can_reverse', '=', False)]}" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="can_reverse" invisible="1" />
                <field name="reversal_status" invisible="1" />
                <widget name="web_ribbon" title="กลับรายการแล้ว" bg_color="bg-danger" attrs="{'invisible': [('reversal_status', '!=', 'full')]}" />
                <widget name="web_ribbon" title="กลับรายการบางส่วน" bg_color="bg-warning" attrs="{'invisible': [('reversal_status', '!=', 'partial')]}" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_reversals" icon="fa-undo" attrs="{'invisible': [('reversal_count', '=', 0)]}">
                    <field name="reversal_count" widget="statinfo" string="กลับรายการ" />
                </button>
            </xpath>
            <xpath expr="//group[@name='general_info']/field[@name='user_id']" position="after">
                <field name="reversed_move_id" attrs="{'invisible': [('reversed_move_id', '=', False)]}" />
            </xpath>
            <!-- A reversal offsets the original's fiscal year (ADR-0020). The
                 attrs replace the field's own draft-only states, so keep them. -->
            <xpath expr="//group[@name='analytic_dimensions']/field[@name='account_fiscal_year_id']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('state', '!=', 'draft'), ('reversed_move_id', '!=', False)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
