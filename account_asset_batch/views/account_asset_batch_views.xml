<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View account.asset.batch View Tree -->
    <record id="view_account_asset_batch_tree" model="ir.ui.view">
        <field name="name">view.account.asset.batch.tree</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="account_fiscal_year_id" optional="show" />
                <field name="contract_number" optional="show" />
                <field name="purchase_id" optional="show" />
                <field name="department_id" optional="hide" />
                <field name="operating_unit_id" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </tree>
        </field>
    </record>

    <!-- Tree view for donation / transfer -->
    <record id="view_account_asset_batch_tree_donation_transfer" model="ir.ui.view">
        <field name="name">view.account.asset.batch.tree.donation.transfer</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="account_fiscal_year_id" />
                <field name="received_from_agency" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </tree>
        </field>
    </record>

    <!-- View account.asset.batch form -->
    <record id="view_account_asset_batch_form" model="ir.ui.view">
        <field name="name">view.account.asset.batch.form</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <form string="Asset Registration">
                <header>
                    <button
                        name="action_register_assets"
                        type="object"
                        string="Register Asset"
                        states="draft"
                        class="btn-primary"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_asset_items"
                            string="Asset"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                            attrs="{'invisible': [('state', '!=', 'done')]}"
                        >
                            <field
                                name="asset_count"
                                widget="statinfo"
                                string="Asset"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Done"
                        bg_color="bg-success"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    />
                    <h2>Account Asset Batch Form</h2>
                    <div class="oe_edit_only">
                        <label for="name" class="oe_inline"/>
                    </div>
                    <h1>
                        <field name="name" class="oe_inline" readonly="1"/>
                    </h1>
                    <group>
                        <field name="is_editable" invisible="1" />
                        <field
                            name="source_of_asset"
                            required="1"
                            readonly="1"
                            widget="radio"
                            options="{'horizontal': true}"
                            force_save="1"
                        />
                        <field name="date" required="1" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field name="account_fiscal_year_id" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field name="contract_number" attrs="{'invisible': [('purchase_id', '=', False)]}"/>
                        <field name="purchase_id" readonly="1" attrs="{'invisible': [('purchase_id', '=', False)]}"/>
                        <field name="partner_id" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field
                            name="received_from_agency"
                            attrs="{'invisible': [('source_of_asset', 'not in', ('donation', 'transfer'))], 'required': [('source_of_asset', 'in', ('donation', 'transfer'))], 'readonly': [('is_editable','=', False)]}"
                        />
                        <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit"/>
                        <field
                            name="department_id"
                            attrs="{'readonly': [('is_editable','=', False)]}"
                        />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="notes" />
                    </group>
                    <group string="Budget Details" >
                        <field name="analytic_distribution" widget="analytic_distribution" attrs="{'readonly': ['|', ('is_editable','=', False), ('purchase_id','!=', False)]}" groups="account_asset_batch.account_asset_batch_manager"/>
                        <field name="source_analytic_id" required="1" attrs="{'readonly': ['|', ('is_editable','=', False), ('purchase_id','!=', False)]}"/>
                        <field name="department_analytic_id" required="1" attrs="{'readonly': ['|', ('is_editable','=', False), ('purchase_id','!=', False)]}"/>
                        <field name="fund_analytic_id" required="1" attrs="{'readonly': ['|', ('is_editable','=', False), ('purchase_id','!=', False)]}"/>
                        <field name="activity_analytic_id" required="1" attrs="{'readonly': ['|', ('is_editable','=', False), ('purchase_id','!=', False)]}"/>
                    </group>
                    <notebook>
                        <page string="List">
                            <field
                                name="line_ids"
                                attrs="{'readonly': [('is_editable','=', False)]}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="name"
                                        placeholder="Dell Computer All in one Set"
                                    />
                                    <field name="profile_id" />
                                    <field name="gpsc_id" />
                                    <field name="amount" />
                                    <field name="price_per_unit" />
                                    <field name="amount_total" readonly="1" />
                                </tree>
                            </field>

                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1" />
                                <field
                                    class="fw-bold"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                    name="total_amount"
                                    readonly="1"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- View account.asset.batch search -->
    <record id="view_account_asset_batch_search" model="ir.ui.view">
        <field name="name">view.account.asset.batch.search</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Procurement -->
    <record id="action_asset_batch_procurement" model="ir.actions.act_window">
        <field name="name">Procurement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset', '=', 'procurement')]</field>
        <field name="context">{'default_source_of_asset': 'procurement', 'create': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_account_asset_batch_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_asset_batch_form')}),
        ]"/>
    </record>

    <!-- Action: Donation -->
    <record id="action_asset_batch_donation" model="ir.actions.act_window">
        <field name="name">Donation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset', '=', 'donation')]</field>
        <field name="context">{'default_source_of_asset': 'donation'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_account_asset_batch_tree_donation_transfer')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_asset_batch_form')}),
        ]"/>
    </record>

    <!-- Action: Transfer -->
    <record id="action_asset_batch_transfer" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset', '=', 'transfer')]</field>
        <field name="context">{'default_source_of_asset': 'transfer'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_account_asset_batch_tree_donation_transfer')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_asset_batch_form')}),
        ]"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_asset_procurement"
            name="Procurement"
            parent="account_asset_kmitl.menu_asset_registration_root"
            action="account_asset_batch.action_asset_batch_procurement"
            sequence="10"/>

    <menuitem id="menu_asset_donation"
            name="Donation"
            parent="account_asset_kmitl.menu_asset_registration_root"
            action="account_asset_batch.action_asset_batch_donation"
            sequence="20"/>

    <menuitem id="menu_asset_transfer"
            name="Transfer"
            parent="account_asset_kmitl.menu_asset_registration_root"
            action="account_asset_batch.action_asset_batch_transfer"
            sequence="30"/>
</odoo>
