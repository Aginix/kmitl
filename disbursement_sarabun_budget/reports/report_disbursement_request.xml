<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_disbursement_request_body" inherit_id="disbursement_sarabun.report_disbursement_request_body">
        <xpath expr="//tr[hasclass('o_field_source_analytic_id')]" position="before">
            <tr class="o_field_budget_commitment_id">
                <td>เลขที่ใบจองงบประมาณ</td>
                <td><span t-field="o.budget_commitment_id"/></td>
            </tr>
        </xpath>
        <xpath expr="//tr[hasclass('o_field_activity_analytic_id')]" position="after">
            <tr class="o_field_budget_account_id">
                <td>รหัสค่าใช้จ่าย</td>
                <td><span t-field="o.budget_account_id"/></td>
            </tr>
        </xpath>
    </template>
</odoo>
