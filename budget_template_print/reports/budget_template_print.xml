<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="budget_template_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout" t-lang="th_TH">
                    <style>
                        .table > :not(caption) > * > * {
                            padding: 0.3rem 0.3rem !importa;
                        }
                    </style>
                    <div class="page">
                        <div
                            id="oe_structure_budget_template_print_index_1"
                            class="oe_structure"
                        />
                        <div class="">
                            <h2>
                                <span t-field="o.name" />
                            </h2>
                        </div>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th
                                        class="text-center"
                                        scope="col"
                                        style="width: 10%"
                                    >
                                        รหัสงบประมาณ</th>
                                    <th scope="col">ชื่อรายการ</th>
                                    <!-- <th scope="col">รหัสบัญชี</th> -->
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line_id">
                                    <td class="text-center" style="width: 10%">
                                        <span t-field="line_id.code" />
                                    </td>
                                    <td>
                                        <div
                                            t-field="line_id.name"
                                            t-attf-style="padding-left: #{line_id.hierarchy_level * 24}px;"
                                        />
                                    </td>
                                    <!-- <td>
                                            <div t-foreach="line_id.account_ids" t-as="account">
                                                <span t-field="account.code" />
                                                <span t-field="account.name" />
                                            </div>
                                    </td> -->
                                </tr>
                            </tbody>
                        </table>
                        <div
                            id="oe_structure_budget_template_print_index_2"
                            class="oe_structure"
                        />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
