<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_account_payment_guarantee_type_tree" model="ir.ui.view">
            <field name="name">account.payment.guarantee.type.tree</field>
            <field name="model">account.payment.guarantee.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="account_id"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_account_payment_guarantee_type_form" model="ir.ui.view">
            <field name="name">account.payment.guarantee.type.form</field>
            <field name="model">account.payment.guarantee.type</field>
            <field name="arch" type="xml">
                <form string="Payment Guarantee Type">
                    <header/>
                    <sheet>
                        <widget name="web_ribbon" 
                                title="Archived" 
                                bg_color="bg-danger" 
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="account_id"/>
                                <field name="active"/>
                                <field name="color" widget="color"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Enter detailed description of this guarantee type..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_account_payment_guarantee_type_search" model="ir.ui.view">
            <field name="name">account.payment.guarantee.type.search</field>
            <field name="model">account.payment.guarantee.type</field>
            <field name="arch" type="xml">
                <search string="Payment Guarantee Types">
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="account_id"/>
                    <field name="description"/>
                    <separator/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_active" string="Status" context="{'group_by': 'active'}"/>
                        <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_account_payment_guarantee_type_kanban" model="ir.ui.view">
            <field name="name">account.payment.guarantee.type.kanban</field>
            <field name="model">account.payment.guarantee.type</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="account_id"/>
                    <field name="description"/>
                    <field name="color"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <t t-if="record.account_id.value">
                                            <div class="text-muted">
                                                <strong>Account:</strong> <field name="account_id"/>
                                            </div>
                                        </t>
                                        <t t-if="record.description.value">
                                            <div class="text-muted">
                                                <field name="description"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_account_payment_guarantee_type" model="ir.actions.act_window">
            <field name="name">Payment Guarantee Types</field>
            <field name="res_model">account.payment.guarantee.type</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_account_payment_guarantee_type_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Payment Guarantee Type!
                </p>
                <p>
                    Payment Guarantee Types help categorize different types of guarantee payments
                    such as receipts, returns, refunds, and adjustments.
                </p>
            </field>
        </record>
    </data>
</odoo>