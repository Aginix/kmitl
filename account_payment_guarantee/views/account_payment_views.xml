<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend account payment form view to add guarantee fields -->
        <record id="view_account_payment_form_guarantee" model="ir.ui.view">
            <field name="name">account.payment.form.guarantee</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <!-- Add guarantee fields after partner_id -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="is_guarantee_payment" widget="boolean_toggle"/>
                    <field name="guarantee_type_id" attrs="{'invisible': [('is_guarantee_payment', '=', False)]}"/>

                </xpath>

            </field>
        </record>

        <!-- Extend account payment tree view to show guarantee flag -->
        <record id="view_account_payment_tree_guarantee" model="ir.ui.view">
            <field name="name">account.payment.tree.guarantee</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <!-- Add guarantee flag column after partner -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="is_guarantee_payment" widget="boolean_toggle"/>
                    <field name="guarantee_type_id" optional="hide"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
