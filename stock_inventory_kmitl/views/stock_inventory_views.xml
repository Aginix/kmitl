<?xml version="1.0" encoding="utf-8"?>
  <odoo>
    <record id="view_stock_inventory_form" model="ir.ui.view">
        <field name="name">view.stock.inventory.form (KMITL)</field>
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="stock_inventory.view_inventory_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='exclude_sublocation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
  </odoo>
