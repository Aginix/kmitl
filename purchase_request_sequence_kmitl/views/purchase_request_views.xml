<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form_fy_lock" model="ir.ui.view">
        <field name="name">purchase.request.form (FY lock on numbering)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_fiscal_year_id']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('fiscal_year_locked', '=', True), ('is_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='account_fiscal_year_id']" position="after">
                <field name="fiscal_year_locked" invisible="1" />
            </xpath>

            <!-- The number is minted on the state transition out of draft;
                 until then ``name`` holds the untranslated "/" placeholder,
                 so show a translatable label instead of the raw sentinel. -->
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('is_name_editable', '=', False)], 'invisible': [('fiscal_year_locked', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//h1/field[@name='name']" position="after">
                <span
                    class="oe_inline"
                    attrs="{'invisible': [('fiscal_year_locked', '=', True)]}"
                >New</span>
            </xpath>
        </field>
    </record>
</odoo>
