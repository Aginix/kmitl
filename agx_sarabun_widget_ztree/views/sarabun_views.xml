                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sarabun_sequence_form" model="ir.ui.view">
        <field name="name">sarabun.document.sequence.form.ztree</field>
