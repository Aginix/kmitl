<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sarabun_document_form" model="ir.ui.view">
        <field name="name">sarabun.document.form.ztree</field>
        <field name="model">sarabun.document</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_document_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='unit']/field[@name='sender_department_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='routing_step_ids']/form/group[@name='step_who']/field[@name='position_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_group_field': 'department_id', 'ztree_expend_level': '2'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='routing_step_ids']/form/group[@name='step_who']/field[@name='department_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code'}</attribute>
            </xpath>
        </field>
    </record>

