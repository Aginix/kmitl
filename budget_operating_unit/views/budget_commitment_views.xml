<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View budget.commitment form -->
    <record id="view_budget_commitment_form" model="ir.ui.view">
        <field name="name">view.budget.commitment.form</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="operating_unit_id" widget="selection" groups="operating_unit.group_multi_operating_unit" />
                <!-- Names only: the editable tags (budget_operating_unit_access_all)
                     need to read every unit, which a unit user cannot. -->
                <field name="beneficiary_operating_unit_names" groups="operating_unit.group_multi_operating_unit" />
            </xpath>
        </field>
    </record>


    <!-- View budget.commitment tree -->
    <record id="view_budget_commitment_tree" model="ir.ui.view">
        <field name="name">view.budget.commitment.tree</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="operating_unit_id" optional="hide" groups="operating_unit.group_multi_operating_unit" />
            </xpath>
        </field>
    </record>

  </odoo>
