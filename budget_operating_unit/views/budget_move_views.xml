<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.move form -->
    <record id="view_budget_move_form" model="ir.ui.view">
        <field name="name">view.budget.move.form</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="operating_unit_id" widget="selection" groups="operating_unit.group_multi_operating_unit" />
            </xpath>
        </field>
    </record>


    <!-- View budget.move tree -->
    <record id="view_budget_move_tree" model="ir.ui.view">
        <field name="name">view.budget.move.tree</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="operating_unit_id" optional="hide" groups="operating_unit.group_multi_operating_unit" />
            </xpath>
        </field>
    </record>

</odoo>
