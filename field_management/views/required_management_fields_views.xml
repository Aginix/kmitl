<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_required_management_fields_tree" model="ir.ui.view">
        <field name="name">view.required.management.fields.tree</field>
        <field name="model">required.management.fields</field>
        <field name="arch" type="xml">
            <tree>
                <field name="model_id" />
                <field name="field_id" />
                <field name="model_name" />
                <field name="domain" />
            </tree>
        </field>
    </record>

    <record id="view_required_management_fields_form" model="ir.ui.view">
        <field name="name">view.required.management.fields.form</field>
        <field name="model">required.management.fields</field>
        <field name="arch" type="xml">
            <form string="Required Management Fields">
                <sheet>
                    <group>
                        <field name="model_id" invisible="1" />
                        <field name="model_name" invisible="1" />
                        <field name="management_id" invisible="1" />
                        <field name="used_field_ids" invisible="1" />
                        <field name="used_model" invisible="1" />
                        <field
                            name="field_id"
                            domain="[('model_id', '=', used_model),('id', 'not in', used_field_ids)]"
                        />
                        <field name="force_required" />
                    </group>

                    <notebook>
                        <page name="domain" string="Domain" attrs="{'invisible': [('force_required', '=', True)]}">
                            <group>
                                <field
                                    name="domain"
                                    widget="domain"
                                    options="{'model': 'model_name'}"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_required_management_fields_search" model="ir.ui.view">
        <field name="name">view.required.management.fields.search</field>
        <field name="model">required.management.fields</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="field_id"
                        name="field_id"
                        domain="[]"
                        context="{'group_by':'field_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_required_management_fields" model="ir.actions.act_window">
        <field name="name">Required Management Fields</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">required.management.fields</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Required Management Fields.
            </p>
        </field>
    </record>
</odoo>
