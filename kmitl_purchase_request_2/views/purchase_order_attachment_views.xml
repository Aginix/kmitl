<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.order.attachment View Tree -->
    <record id="view_purchase_order_attachment_tree" model="ir.ui.view">
        <field name="name">view.purchase.order.attachment.tree</field>
        <field name="model">purchase.order.attachment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View purchase.order.attachment form -->
    <record id="view_purchase_order_attachment_form" model="ir.ui.view">
        <field name="name">view.purchase.order.attachment.form</field>
        <field name="model">purchase.order.attachment</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Attachment">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View purchase.order.attachment search -->
    <record id="view_purchase_order_attachment_search" model="ir.ui.view">
        <field name="name">view.purchase.order.attachment.search</field>
        <field name="model">purchase.order.attachment</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action purchase.order.attachment -->
    <record id="action_purchase_order_attachment" model="ir.actions.act_window">
        <field name="name">Purchase Order Attachment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Order Attachment.
            </p>
        </field>
    </record>

</odoo>
