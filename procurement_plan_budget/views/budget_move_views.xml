<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.move form -->
    <record id="view_budget_move_form_procurement_plan" model="ir.ui.view">
        <field name="name">view.budget.move.form.procurement.plan</field>
        <field name="model">budget.move</field>
        <field name="inherit_id" ref="budget.view_budget_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="after">
                <field name="procurement_plan_analytic_id" options='{"no_open": True}' optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
