<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View procurement.plan form: budget code + commitment stat-button +
         relabel the states that this layer gives budget meaning to -->
    <record id="view_procurement_plan_form_budget" model="ir.ui.view">
        <field name="name">view.procurement.plan.form.budget</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_form"/>
        <field name="arch" type="xml">
            <button name="action_verify" position="attributes">
                <attribute name="string">จองงบประมาณ</attribute>
            </button>
            <field name="fund_analytic_id" position="after">
                <field name="budget_account_id" options="{'no_create': True, 'no_open': True}" invisible="context.get('hide_budget', False)" attrs="{'readonly': [('can_edit', '=', False)]}" />
                <field name="budget_amount" attrs="{'invisible': [('state', '=', 'draft')]}" />
                <div attrs="{'invisible': ['|', ('state', '!=', 'to_verify'), ('budget_amount', '>', 0)]}"
                     class="alert alert-warning" role="alert" colspan="2">
                    <strong>ยังไม่ได้รับการจัดสรรงบประมาณ</strong>
                    — โปรดรอให้งานแผนโอนงบเข้าแผน (ปรับเข้าแผน) ก่อนจึงจะจองงบประมาณได้
                </div>
            </field>
            <div name="button_box" position="inside">
                <field name="budget_commitment_count" invisible="1" />
                <button name="action_open_budget_commitments" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible': [('budget_commitment_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <field name="budget_commitment_count" />
                        <span class="o_stat_text">Budget Commitment</span>
                    </div>
                </button>
                <button name="action_open_budget_move_lines" type="object" class="oe_stat_button" icon="fa-exchange">
                    <field name="budget_move_line_count" widget="statinfo" string="Budget Move" />
                </button>
            </div>
        </field>
    </record>

    <!-- View procurement.plan tree: budget code column -->
    <record id="view_procurement_plan_tree_budget" model="ir.ui.view">
        <field name="name">view.procurement.plan.tree.budget</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_tree"/>
        <field name="arch" type="xml">
            <field name="total_price" position="after">
                <field name="budget_account_id" optional="hide" />
            </field>
        </field>
    </record>

    <!-- View procurement.plan search: filter/group by budget code -->
    <record id="view_procurement_plan_search_budget" model="ir.ui.view">
        <field name="name">view.procurement.plan.search.budget</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="budget_account_id" />
            </field>
            <filter name="group_by_state" position="before">
                <filter string="รหัสงบประมาณ" name="group_by_budget_account" context="{'group_by': 'budget_account_id'}" />
            </filter>
        </field>
    </record>

</odoo>
