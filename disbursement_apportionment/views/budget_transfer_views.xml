<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_transfer_form" model="ir.ui.view">
        <field name="name">budget.transfer.form (disbursement_apportionment)</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <field name="approval_date" position="after">
                <field name="disbursement_request_id" attrs="{'invisible': [('disbursement_request_id', '=', False)]}" />
            </field>
        </field>
    </record>
</odoo>
