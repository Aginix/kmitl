<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field
            name="name"
        >disbursement.request.form (advance_payment_disbursement)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <field name="payment_type_display" position="after">
                <!-- The line picker's domain reads it; the visible one is group-gated. -->
                <field name="operating_unit_id" invisible="1" />
            </field>
            <xpath
                expr="//field[@name='line_ids']/tree/field[@name='payment_type']"
                position="after"
            >
                <field
                    name="advance_payment_id"
                    context="{'advance_payment_picker': True}"
                    options="{'no_create': True, 'no_open': True}"
                    attrs="{'invisible': [('payment_type', '!=', 'advance')], 'required': [('payment_type', '=', 'advance')]}"
                />
                <field
                    name="advance_payment_amount_remaining"
                    optional="hide"
                    attrs="{'invisible': [('advance_payment_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
