<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advance_payment_form_disbursement" model="ir.ui.view">
        <field name="name">advance.payment.form.disbursement</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.advance_payment_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='usage_lines']//field[@name='usage_line_ids']" position="after">
                <separator string="ใบเบิก" />
                <field name="disbursement_request_ids" readonly="1" nolabel="1">
                    <tree>
                        <field name="name" />
                        <field name="partner_id" />
                        <field name="amount_total" />
                        <field name="state" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
