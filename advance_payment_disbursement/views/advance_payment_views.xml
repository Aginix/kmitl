<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Rendered as sudo into advance.payment.disbursement_request_html: a loan
         officer need not read disbursement requests. -->
    <template id="disbursement_request_table">
        <table class="table table-sm o_main_table">
            <thead>
                <tr>
                    <th>เลขที่ใบขอเบิก</th>
                    <th>เลขที่หนังสือ</th>
                    <th>วันที่ตัดงบ</th>
                    <th class="text-end">จำนวนเงิน</th>
                    <th>สถานะ</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="requests" t-as="request">
                    <td t-out="request.name" />
                    <td t-out="request.memo_number or ''" />
                    <td>
                        <span
                            t-field="request.budget_consumed_date"
                            t-options="{'widget': 'date'}"
                        />
                    </td>
                    <td class="text-end">
                        <span t-field="request.budget_consumed_amount" />
                    </td>
                    <td>
                        <span t-field="request.state" />
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <record id="view_advance_payment_form" model="ir.ui.view">
        <field name="name">advance.payment.form (advance_payment_disbursement)</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="can_view_disbursement_requests" invisible="1" />
                <button
                    name="action_view_disbursement_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': ['|', ('disbursement_request_count', '=', 0), ('can_view_disbursement_requests', '=', False)]}"
                >
                    <field
                        name="disbursement_request_count"
                        string="ใบเบิกชดใช้เงินยืม"
                        widget="statinfo"
                    />
                </button>
            </div>
            <group name="amount_summary" position="after">
                <group
                    name="disbursement_requests"
                    string="ใบเบิกชดใช้เงินยืม"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field name="disbursement_request_html" nolabel="1" colspan="2" />
                </group>
            </group>
        </field>
    </record>
</odoo>
