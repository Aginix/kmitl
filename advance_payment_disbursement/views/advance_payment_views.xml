<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advance_payment_form_disbursement" model="ir.ui.view">
        <field name="name">advance.payment.form.disbursement</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_cancel_wizard']" position="before">
                <button name="action_disburse"
                    string="ดำเนินการเบิกจ่าย"
                    type="object"
                    class="btn-primary"
                    attrs="{'invisible': [('state', '!=', 'approved')]}"
                    groups="advance_payment.group_advance_payment_manager" />
            </xpath>
            <xpath expr="//page[@name='return_lines']" position="before">
                <page string="รายการใช้เงิน" name="usage_lines">
                    <separator string="ใบเบิก" />
                    <field name="disbursement_request_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="amount_total" />
                            <field name="state" widget="badge"
                                decoration-info="state in ('draft', 'submitted')"
                                decoration-primary="state in ('signed', 'verified', 'approved')"
                                decoration-warning="state in ('bill_draft', 'payment_draft')"
                                decoration-success="state in ('bill_posted', 'payment_posted', 'done')"
                                decoration-danger="state == 'cancel'" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
