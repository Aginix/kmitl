#. module: advance_payment_disbursement
#: model:ir.model.fields.selection,name:advance_payment_disbursement.selection__disbursement_request_line__payment_type__advance
msgid "Advance"
msgstr "เงินยืม"

#. module: advance_payment_disbursement
#. odoo-python
#: code:addons/advance_payment_disbursement/models/disbursement_request_line.py:0
#, python-format
msgid ""
"Disbursement request lines of payment type Advance exist: they cannot be re-"
"typed silently."
msgstr ""
"มีรายการใบขอเบิกประเภทการจ่ายเงินเป็นเงินยืมอยู่ "
"จึงเปลี่ยนประเภทโดยอัตโนมัติไม่ได้"

#. module: advance_payment_disbursement
#. odoo-python
#: code:addons/advance_payment_disbursement/models/disbursement_request.py:0
#, python-format
msgid "Every Advance line must name the loan (เลขที่สัญญายืมเงิน) it clears."
msgstr "รายการเงินยืมทุกรายการต้องระบุเลขที่สัญญายืมเงินที่จะชดใช้"

#. module: advance_payment_disbursement
#. odoo-python
#: code:addons/advance_payment_disbursement/models/disbursement_request.py:0
#, python-format
msgid "Loan %(loan)s is not outstanding (ค้างชำระ): it cannot be cleared."
msgstr "สัญญายืมเงิน %(loan)s ไม่อยู่ในสถานะค้างชำระ จึงชดใช้ไม่ได้"

#. module: advance_payment_disbursement
#. odoo-python
#: code:addons/advance_payment_disbursement/models/disbursement_request_line.py:0
#, python-format
msgid "Only a line of payment type Advance may name a loan."
msgstr "ระบุสัญญายืมเงินได้เฉพาะรายการประเภทการจ่ายเงิน เงินยืม เท่านั้น"

#. module: advance_payment_disbursement
#. odoo-python
#: code:addons/advance_payment_disbursement/models/disbursement_request.py:0
#, python-format
msgid ""
"The lines clearing loan %(loan)s total %(amount)s, more than it still owes "
"(%(remaining)s)."
msgstr ""
"รายการชดใช้สัญญายืมเงิน %(loan)s รวม %(amount)s เกินยอดคงเหลือ "
"(%(remaining)s)"

#. module: advance_payment_disbursement
#. odoo-python
#: code:addons/advance_payment_disbursement/models/disbursement_request_line.py:0
#, python-format
msgid ""
"The payee of a line clearing loan %(loan)s must be its borrower, "
"%(borrower)s."
msgstr ""
"ผู้รับเงินของรายการชดใช้สัญญายืมเงิน %(loan)s ต้องเป็นผู้ยืม %(borrower)s "
"เท่านั้น"
