<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View procurement.plan form -->
    <record id="view_procurement_plan_form_analytic" model="ir.ui.view">
        <field name="name">view.procurement.plan.form.analytic</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='additional_info']" position="inside">
                <field name="analytic_account_id" groups="analytic.group_analytic_accounting" />
            </xpath>
        </field>
    </record>

  </odoo>
