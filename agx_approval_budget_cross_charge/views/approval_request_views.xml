<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.form (cross-charge)</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form" />
        <field name="arch" type="xml">
            <!-- ยืนยันงบประมาณ opens the ใบจองงบประมาณ as a dialog (ADR-0011). -->
            <xpath expr="//button[@name='action_reserve_budget']" position="attributes">
                <attribute name="context">{'budget_reserve_dialog': True}</attribute>
            </xpath>
            <!-- แก้ไขใบจอง: reserved, unused, at รอส่งขออนุมัติ or back from
                 e-Saraban (the server re-checks the window). -->
            <xpath expr="//button[@name='action_reserve_budget']" position="after">
                <field name="can_adjust_cross_charge" invisible="1" />
                <button
                    name="action_adjust_cross_charge"
                    type="object"
                    string="แก้ไขใบจอง"
                    attrs="{'invisible': [('can_adjust_cross_charge', '=', False)]}"
                    groups="agx_approval.group_approval_budget_commit"
                />
            </xpath>
        </field>
    </record>
</odoo>
