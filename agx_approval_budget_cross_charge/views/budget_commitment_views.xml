<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The คำขออนุมัติ's ยืนยันงบประมาณ / แก้ไขใบจอง dialog (agx_approval
         ADR-0011): the same ใบจองงบประมาณ form, วงเงิน locked to the request
         total; split, Primary Code and dimensions editable in the windows. -->
    <record id="budget_commitment_approval_dialog_form" model="ir.ui.view">
        <field name="name">budget.commitment.form (approval reserve dialog)</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view" />
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,reserved,partial,done"
                    />
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="replace" />
            <xpath expr="//field[@name='title']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//group[@name='basic_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='source_analytic_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('split_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='department_analytic_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('split_editable', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='fund_analytic_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('split_editable', '=', False)]}</attribute>
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_analytic_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('split_editable', '=', False)]}</attribute>
                <attribute name="required">1</attribute>
            </xpath>
            <!-- Code and dimensions editable in the request's windows: saving
                 a reserved slip re-cuts it in one step and copies them back
                 to the request (ADR-0011). -->
            <xpath expr="//field[@name='account_id']" position="before">
                <field name="approval_account_domain" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='account_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('split_editable', '=', False)]}</attribute>
                <attribute name="domain">approval_account_domain</attribute>
                <attribute name="string">รหัสหลัก</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="string">วงเงิน (ยอดรวมคำขอ)</attribute>
            </xpath>
            <xpath expr="//group[@name='budget_summary']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', '=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//notebook" position="replace" />
            <xpath expr="//div[hasclass('oe_chatter')]" position="replace" />
            <xpath expr="//sheet" position="after">
                <footer>
                    <button
                        name="action_confirm_approval_reserve"
                        string="ยืนยันจองงบประมาณ"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_save_approval_split"
                        string="บันทึก"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('state', '!=', 'reserved'), ('split_editable', '=', False)]}"
                    />
                    <button string="ปิด" special="cancel" class="btn-secondary" />
                </footer>
            </xpath>
        </field>
    </record>
</odoo>
