<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-inherit="web.Many2ManyBinaryField.attachment_preview"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_attachment_wrap')]" position="inside">
            <span
                t-if="file.outstanding_request_count"
                class="o_agx_annotation_request_badge"
                title="Outstanding change requests"
            >! <t t-esc="file.outstanding_request_count" /></span>
        </xpath>
    </t>

    <t t-inherit="mail.AttachmentCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_AttachmentCard_image')]" position="inside">
            <span
                t-if="attachmentCard.attachment.openRequestCount"
                class="o_agx_annotation_request_badge"
                title="Outstanding change requests"
            >! <t t-esc="attachmentCard.attachment.openRequestCount" /></span>
        </xpath>
    </t>

    <t t-inherit="mail.AttachmentImage" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_AttachmentImage')]" position="inside">
            <span
                t-if="attachmentImage.attachment.openRequestCount"
                class="o_agx_annotation_request_badge"
                title="Outstanding change requests"
            >! <t t-esc="attachmentImage.attachment.openRequestCount" /></span>
        </xpath>
    </t>

</templates>
