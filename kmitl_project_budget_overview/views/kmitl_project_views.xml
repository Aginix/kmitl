<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- One "บัญชีโครงการ" stat button in place of the movement and commitment
         buttons; it always shows คงเหลือ (ADR-0012). -->
    <record id="view_kmitl_project_form" model="ir.ui.view">
        <field name="name">kmitl.project.form.budget.overview</field>
        <field name="model">kmitl.project</field>
        <field
            name="inherit_id"
            ref="kmitl_project_budget_movement.view_kmitl_project_form"
        />
        <!-- Replaces buttons: apply after the movement extension (priority 99). -->
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <data>
                <button name="action_open_budget_movements" position="replace">
                    <button
                        name="action_open_budget_overview"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        attrs="{'invisible': [('analytic_account_id', '=', False)]}"
                        groups="kmitl_project.group_kmitl_project_user,budget.group_budget_viewer"
                    >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="budget_remaining" />
                            </span>
                            <span class="o_stat_text">คงเหลือ</span>
                        </div>
                    </button>
                </button>
                <button name="action_open_budget_commitments" position="replace" />
                <!-- The figures live in บัญชีโครงการ; the form keeps the
                     coordinate and the estimate. -->
                <xpath
                    expr="//group[@name='budget']/field[@name='budget_amount']"
                    position="attributes"
                >
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath
                    expr="//group[@name='budget']/field[@name='budget_reserved']"
                    position="attributes"
                >
                    <attribute name="attrs">{}</attribute>
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath
                    expr="//group[@name='budget']/field[@name='budget_remaining']"
                    position="attributes"
                >
                    <attribute name="attrs">{}</attribute>
                    <attribute name="invisible">1</attribute>
                </xpath>
            </data>
        </field>
    </record>

    <!-- บัญชีโครงการ: a read-only view of the project, opened from the stat
         button. Priority keeps it from becoming the default form. -->
    <record id="view_kmitl_project_budget_overview_form" model="ir.ui.view">
        <field name="name">kmitl.project.budget.overview.form</field>
        <field name="model">kmitl.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form
                string="บัญชีโครงการ"
                create="0"
                edit="0"
                delete="0"
                duplicate="0"
                class="o_kpbo_form"
            >
                <header>
                    <button
                        name="action_open_project_form"
                        type="object"
                        string="กลับไปหน้าโครงการ"
                        icon="fa-arrow-left"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <field name="state" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="analytic_account_id" invisible="1" />
                    <field name="budget_estimate" invisible="1" />
                    <field name="budget_amount" invisible="1" />
                    <field name="budget_reserved" invisible="1" />
                    <field name="budget_consumed" invisible="1" />
                    <field name="budget_reserved_total" invisible="1" />
                    <field name="budget_unreserved" invisible="1" />
                    <field name="budget_commitment_count" invisible="1" />
                    <field name="budget_off_target_count" invisible="1" />
                    <div class="oe_title">
                        <div class="text-muted">บัญชีโครงการ</div>
                        <h1><field name="key" readonly="1" /></h1>
                        <h4><field name="name" readonly="1" /></h4>
                    </div>
                    <group>
                        <group>
                            <field
                                name="account_fiscal_year_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                            <field
                                name="budget_account_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                            <field
                                name="department_analytic_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                        </group>
                        <group>
                            <field
                                name="source_analytic_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                            <field
                                name="fund_analytic_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                            <field
                                name="activity_analytic_id"
                                readonly="1"
                                options="{'no_open': True}"
                            />
                        </group>
                    </group>

                    <widget name="kmitl_project_budget_overview_summary" />

                    <div class="o_kpbo_alerts">
                        <div
                            class="alert alert-info mb-2"
                            role="status"
                            attrs="{'invisible': [('budget_pending_amount', '=', 0)]}"
                        >
                            <strong>รอโอน <field
                                    name="budget_pending_amount"
                                    class="d-inline"
                                /> บาท</strong>
                            — มีใบโอนอยู่ระหว่างดำเนินการ ยังไม่นับในยอดได้รับจัดสรร
                        </div>
                        <div
                            class="alert alert-danger mb-2"
                            role="alert"
                            attrs="{'invisible': ['|', ('state', '!=', 'in_progress'), ('budget_reserved', '>', 0)]}"
                        >
                            <strong>ยังไม่ได้จองงบประมาณ</strong>
                            — โครงการอนุมัติแล้วแต่การจองงบไม่สำเร็จ ต้องจองงบประมาณก่อนจึงจะเปิดใบขอซื้อ/ขอเบิกได้
                        </div>
                        <div
                            class="alert alert-warning mb-2"
                            role="alert"
                            attrs="{'invisible': ['|', '|', ('state', '!=', 'in_progress'), ('budget_reserved_total', '=', 0), ('budget_unreserved', '=', 0)]}"
                        >
                            <strong>ได้รับแต่ยังไม่ได้จอง <field
                                    name="budget_unreserved"
                                    class="d-inline"
                                /> บาท</strong>
                            — เงินที่จัดสรรเพิ่มหลังเริ่มเบิกจ่ายยังไม่อยู่ในใบจอง จึงยังใช้เปิดใบขอซื้อ/ขอเบิกไม่ได้ กรุณาติดต่อเจ้าหน้าที่งบประมาณ
                        </div>
                        <div
                            class="alert alert-warning mb-2"
                            role="alert"
                            attrs="{'invisible': ['|', ('state', '!=', 'complete'), ('budget_remaining', '&lt;=', 0)]}"
                        >
                            <strong>เงินค้างในมิติโครงการ <field
                                    name="budget_remaining"
                                    class="d-inline"
                                /> บาท</strong>
                            — โครงการปิดแล้ว เงินที่เหลือต้องโอนคืนงบลอย
                        </div>
                        <div
                            class="alert alert-danger mb-2"
                            role="alert"
                            attrs="{'invisible': [('budget_off_target_count', '=', 0)]}"
                        >
                            <strong>พิกัดไม่ตรงกับโครงการ</strong>
                            — มีรายการที่ติดมิติโครงการแต่รหัสงบ/มิติไม่ตรงกับโครงการ จึงไม่นับในยอด
                            <button
                                name="action_open_off_target_movements"
                                type="object"
                                string="ดูรายการ"
                                class="btn-link p-0 align-baseline"
                            />
                        </div>
                    </div>

                    <!-- Same buttons as the project header, which keeps them too. -->
                    <div class="o_kpbo_actions">
                        <button
                            string="จัดสรรงบประมาณ (งบลอย)"
                            name="action_open_floating_allocation"
                            type="object"
                            icon="fa-plus"
                            class="btn-outline-primary"
                            groups="budget.group_budget_user"
                            attrs="{'invisible': [('state', 'not in', ('to_verify', 'to_send', 'sent', 'returned', 'in_progress'))]}"
                        />
                        <button
                            string="โอนคืนงบลอย"
                            name="action_open_floating_return"
                            type="object"
                            icon="fa-undo"
                            class="btn-outline-primary"
                            groups="budget.group_budget_user"
                            attrs="{'invisible': ['|', ('analytic_account_id', '=', False), ('state', 'not in', ('draft', 'to_verify', 'returned', 'rejected', 'in_progress', 'complete', 'cancel'))]}"
                        />
                        <button
                            string="จองงบประมาณ"
                            name="action_retry_reserve_budget"
                            type="object"
                            icon="fa-thumb-tack"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('state', '!=', 'in_progress'), ('budget_reserved', '>', 0)]}"
                        />
                        <button
                            string="เปิดใบจอง"
                            name="action_open_budget_commitments"
                            type="object"
                            icon="fa-external-link"
                            class="btn-link"
                            groups="budget.group_budget_viewer"
                            attrs="{'invisible': [('budget_commitment_count', '=', 0)]}"
                        />
                    </div>

                    <notebook>
                        <page name="movements" string="การเคลื่อนไหวงบประมาณ">
                            <field name="budget_movement_ids" nolabel="1">
                                <tree
                                    create="0"
                                    delete="0"
                                    decoration-muted="status in ('other_year', 'off_target')"
                                >
                                    <field name="date" />
                                    <field name="name" />
                                    <field name="kind" />
                                    <field
                                        name="counterpart_department_id"
                                        options="{'no_open': True}"
                                    />
                                    <field name="source_name" />
                                    <field name="amount" />
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-success="status == 'posted'"
                                        decoration-warning="status == 'in_progress'"
                                        decoration-info="status == 'other_year'"
                                        decoration-danger="status == 'off_target'"
                                    />
                                </tree>
                            </field>
                            <div class="o_kpbo_footer">
                                <button
                                    name="action_open_budget_movements"
                                    type="object"
                                    string="ค้นหา/กรองแบบละเอียด"
                                    icon="fa-search"
                                    class="btn-link p-0"
                                />
                                <div class="o_kpbo_total">
                                    คงเหลือ
                                    <field name="budget_remaining" class="d-inline" />
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- A stored action keeps บัญชีโครงการ in the URL across a reload. -->
    <record id="action_kmitl_project_budget_overview" model="ir.actions.act_window">
        <field name="name">บัญชีโครงการ</field>
        <field name="res_model">kmitl.project</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kmitl_project_budget_overview_form" />
        <field name="target">current</field>
    </record>

</odoo>
