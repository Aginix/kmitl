<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="kmitl_project_budget_overview.Summary" owl="1">
        <div class="o_kpbo">
            <div class="o_kpbo_kpis">
                <div class="o_kpbo_kpi">
                    <div class="o_kpbo_label">ได้รับจัดสรร</div>
                    <div class="o_kpbo_value" t-esc="money(data.budget_amount)" />
                    <div t-if="data.budget_estimate" class="o_kpbo_sub">
                        ตั้งไว้ <t t-esc="money(data.budget_estimate)" /> (<t
                            t-esc="estimatePct"
                        />%)
                    </div>
                    <div t-else="" class="o_kpbo_sub">ยังไม่ได้ตั้งงบประมาณโครงการ</div>
                </div>
                <div class="o_kpbo_op">›</div>
                <div class="o_kpbo_kpi">
                    <div class="o_kpbo_label">จองแล้ว</div>
                    <div
                        class="o_kpbo_value"
                        t-esc="money(data.budget_reserved_total)"
                    />
                    <div class="o_kpbo_sub">
                        <t
                            t-if="data.budget_reserved_total"
                        >จองเมื่อโครงการได้รับอนุมัติ</t>
                        <t t-elif="data.budget_reserved">คืนเงินจองแล้ว</t>
                        <t t-else="">ยังไม่ได้จอง</t>
                    </div>
                </div>
                <div class="o_kpbo_op">›</div>
                <div class="o_kpbo_kpi">
                    <div class="o_kpbo_label">เบิกจ่ายแล้ว</div>
                    <div class="o_kpbo_value" t-esc="money(data.budget_consumed)" />
                    <div class="o_kpbo_sub">ตัดงบที่ผ่านแล้ว</div>
                </div>
                <div class="o_kpbo_op">=</div>
                <div
                    class="o_kpbo_kpi o_kpbo_hero"
                    t-att-class="{'o_kpbo_negative': data.budget_remaining &lt; 0}"
                >
                    <div class="o_kpbo_label">คงเหลือ</div>
                    <div class="o_kpbo_value" t-esc="money(data.budget_remaining)" />
                    <div class="o_kpbo_sub">ได้รับ − เบิกจ่าย</div>
                </div>
            </div>
            <t t-set="b" t-value="bar" />
            <t t-if="b.show">
                <div class="o_kpbo_bar">
                    <div
                        class="o_kpbo_seg_consumed"
                        t-att-style="'width: ' + b.consumed + '%'"
                    />
                    <div
                        class="o_kpbo_seg_remaining"
                        t-att-style="'width: ' + b.remaining + '%'"
                    />
                    <div
                        class="o_kpbo_seg_unreserved"
                        t-att-style="'width: ' + b.unreserved + '%'"
                    />
                </div>
                <div class="o_kpbo_legend">
                    <span t-if="b.consumed"><i
                            class="o_kpbo_seg_consumed"
                        />เบิกจ่ายแล้ว</span>
                    <span t-if="b.remaining"><i
                            class="o_kpbo_seg_remaining"
                        />คงเหลือ</span>
                    <span t-if="b.unreserved"><i
                            class="o_kpbo_seg_unreserved"
                        />คงเหลือ (ยังไม่ได้จอง)</span>
                    <span t-if="b.notReceived"><i
                            class="o_kpbo_seg_empty"
                        />ยังไม่ได้รับ (เทียบกับที่ตั้งไว้)</span>
                </div>
            </t>
        </div>
    </t>

</templates>
