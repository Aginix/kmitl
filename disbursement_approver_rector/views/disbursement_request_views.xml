<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_approver_rector)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <button name="action_draft" position="before">
                <button
                    name="action_approve"
                    string="Approve (Rector Delegate)"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('can_approve_rector', '=', False)]}"
                    confirm="Are you sure you want to approve this request?"
                    groups="disbursement.group_disbursement_rector_delegate"
                />
                <field name="can_approve_rector" invisible="1" />
            </button>
            <group id="dates" position="inside">
                <field
                    name="rector_approve_date"
                    string="Request Approved On"
                    widget="date"
                />
            </group>
            <group id="other_information" position="inside">
                <field
                    name="rector_approver_id"
                    attrs="{'invisible': [('rector_approver_id', '=', False)]}"
                />
            </group>
        </field>
    </record>
</odoo>
