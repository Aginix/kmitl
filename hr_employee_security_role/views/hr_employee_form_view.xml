<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_chatter')]" position="attributes">
                    <attribute
                        name='groups'
                    >hr_employee_security_role.group_hr_central_user</attribute>
                </xpath>
            </field>
        </record>

        <record model='ir.ui.menu' id='hr.menu_human_resources_configuration'>
            <field
                name="groups_id"
                eval="[(6, 0, [ref('hr_employee_security_role.group_hr_central_user')])]"
            />
        </record>
    </data>
</odoo>
