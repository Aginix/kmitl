<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="create_guarantee_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">create.guarantee.payment.wizard.form</field>
        <field name="model">create.guarantee.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Payment">
                <group>
                    <field name="purchase_guarantee_id" invisible="1"/>
                    <field name="kmitl_payment_type_id"/>
                </group>
                <footer>
                    <button
                        name="action_create_payment"
                        string="Create"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
