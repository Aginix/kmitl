<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Teach the base position_id to also appear in person mode as an optional
        signing capacity, WITHOUT duplicating the field node. The earlier version
        added a second <field name="position_id"> for the person-mode branch; that
        made the base position-mode dropdown collapse to zero options (both nodes
        share the same widget registration, so the inserted node's holder-filter
        domain leaked back onto the original). Single node + a target_mode-aware
        ternary domain is the robust fix.

        Position mode: domain is empty — identical to the pre-add-on behaviour
        (full list of positions). Person mode: domain filters to the pinned
        person's current holdings only (optional pick; nothing enforced).
    -->
    <record id="view_sarabun_document_form_person_capacity" model="ir.ui.view">
        <field name="name">sarabun.document.form.person.capacity</field>
        <field name="model">sarabun.document</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='routing_step_ids']/form/group[@name='step_who']/field[@name='position_id']" position="attributes">
                <attribute name="attrs">{'invisible': [('target_mode', 'not in', ('position', 'person'))], 'required': [('target_mode', '=', 'position')], 'readonly': [('is_originator', '=', True)]}</attribute>
                <attribute name="domain">[('holder_ids', 'in', [employee_id])] if target_mode == 'person' and employee_id else []</attribute>
            </xpath>
            <!--
                Show the capacity ตำแหน่ง on the Route tree too (optional="show"
                so users can hide it if the column list gets busy). In position
                mode this column duplicates เป้าหมาย; in person mode it is the
                only place the capacity shows at a glance.
            -->
            <xpath expr="//field[@name='routing_step_ids']/tree/field[@name='target_name']" position="after">
                <field name="position_id" string="ลงนามในฐานะ" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
