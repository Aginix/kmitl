<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Teach the base position_id to also appear in person mode as an optional
        signing capacity. Single-node + a target_mode-aware ternary domain avoids
        the duplicate-field dropdown-leak (both nodes share the same widget
        registration).

        Person-mode UX: pick the บุคลากร first, then the capacity ตำแหน่ง appears
        beneath — so position_id is moved below employee_id in the field order,
        and its invisibility rule has an extra guard that hides it in person mode
        until an employee is picked. Position mode: shows with the full dropdown
        exactly as before. Unit mode: hidden.
    -->
    <record id="view_sarabun_document_form_person_capacity" model="ir.ui.view">
        <field name="name">sarabun.document.form.person.capacity</field>
        <field name="model">sarabun.document</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_document_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='routing_step_ids']/form/group[@name='step_who']/field[@name='position_id']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('target_mode', 'not in', ('position', 'person')), '&amp;', ('target_mode', '=', 'person'), ('employee_id', '=', False)], 'required': ['&amp;', ('target_mode', '=', 'position'), ('is_originator', '=', False)]}</attribute>
                <attribute
                    name="domain"
                >[('holder_ids', 'in', [employee_id])] if target_mode == 'person' and employee_id else []</attribute>
            </xpath>
            <!--
                Move position_id to render AFTER employee_id so the person-mode
                sequence reads top-to-bottom: Target Mode → บุคลากร → ตำแหน่ง.
                Position mode is unaffected (employee_id is invisible so its row
                collapses — position_id visually sits right under target_mode as
                before).
            -->
            <xpath
                expr="//field[@name='routing_step_ids']/form/group[@name='step_who']/field[@name='employee_id']"
                position="after"
            >
                <xpath
                    expr="//field[@name='routing_step_ids']/form/group[@name='step_who']/field[@name='position_id']"
                    position="move"
                />
            </xpath>
            <!--
                Show the capacity ตำแหน่ง on the Route tree too (optional="show"
                so users can hide it if the column list gets busy). In position
                mode this column duplicates เป้าหมาย; in person mode it is the
                only place the capacity shows at a glance.
            -->
            <xpath
                expr="//field[@name='routing_step_ids']/tree/field[@name='target_name']"
                position="after"
            >
                <field name="position_id" string="ลงนามในฐานะ" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
