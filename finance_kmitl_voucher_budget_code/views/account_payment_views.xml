<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form_budget_code" model="ir.ui.view">
        <field name="name">account.payment.form.budget.code</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="finance_kmitl.view_account_payment_form_inherit" />
        <field name="arch" type="xml">
            <group name="budget_info" position="inside">
                <field name="is_budget_code_required" invisible="1" />
                <field
                    name="budget_account_id"
                    options="{'no_create': True}"
                    attrs="{'invisible': [('is_budget_code_required', '=', False), ('budget_account_id', '=', False)], 'required': [('is_budget_code_required', '=', True)], 'readonly': [('finance_state', '!=', 'draft')]}"
                />
            </group>
        </field>
    </record>
</odoo>
