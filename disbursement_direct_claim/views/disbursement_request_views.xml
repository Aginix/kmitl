<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_tree" model="ir.ui.view">
        <field name="name">disbursement.request.tree (disbursement_direct_claim)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_tree" />
        <field name="arch" type="xml">
            <field name="memo_number" position="after">
                <field name="is_direct_claim" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_direct_claim)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <!-- ตั้งเบิกตรง (disbursement ADR-0005): the external memo's number
                 and date are typed here; otherwise they are stamped. -->
            <xpath expr="//group[@name='disbursement_information']/field[@name='memo_number']" position="before">
                <field name="is_direct_claim" />
            </xpath>
            <xpath expr="//group[@name='disbursement_information']/field[@name='memo_number']" position="attributes">
                <attribute name="readonly" />
                <attribute name="attrs">{'readonly': ['|', ('is_direct_claim', '=', False), ('state', '!=', 'draft')], 'required': [('is_direct_claim', '=', True), ('state', '=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//group[@name='dates']/field[@name='sign_date']" position="attributes">
                <attribute name="readonly" />
                <attribute name="attrs">{'readonly': ['|', ('is_direct_claim', '=', False), ('state', '!=', 'draft')], 'required': [('is_direct_claim', '=', True), ('state', '=', 'draft')]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_disbursement_request_search" model="ir.ui.view">
        <field name="name">disbursement.request.search (disbursement_direct_claim)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search" />
        <field name="arch" type="xml">
            <filter name="tofix" position="before">
                <filter
                    string="Direct Claim"
                    name="direct_claim"
                    domain="[('is_direct_claim', '=', True)]"
                />
                <separator />
            </filter>
        </field>
    </record>
</odoo>
