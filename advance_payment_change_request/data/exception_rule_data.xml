<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Checked by Verify (action_verify) only: the method fails nothing
         elsewhere. -->
    <record
        id="excep_advance_payment_outstanding_change_requests"
        model="exception.rule"
    >
        <field name="name">ยังมีข้อแก้ไขที่ค้างอยู่</field>
        <field
            name="description"
        >ตรวจสอบได้เมื่อข้อแก้ไขของสัญญายืมเงินปิดครบแล้ว (ข้อแก้ไขที่ยังเปิดอยู่หรือตอบแล้วถือว่ายังค้างอยู่)</field>
        <field name="sequence">20</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_method</field>
        <field name="method">advance_payment_check_outstanding_change_requests</field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- ส่งกลับแก้ไข marker: linked by the send-back while Change requests are
         outstanding and cleared on the next state change, never evaluated (see
         advance_payment_return_exception). -->
    <record id="excep_advance_payment_sent_back_change_requests" model="exception.rule">
        <field name="name">มีข้อแก้ไขที่ต้องแก้</field>
        <field
            name="description"
        >สัญญายืมเงินถูกส่งกลับพร้อมข้อแก้ไขที่ยังค้างอยู่ ดูรายการได้ที่ข้อแก้ไขของสัญญา</field>
        <field name="sequence">81</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_py_code</field>
        <field name="code"># set by the send-back, never evaluated
failed = False</field>
        <field name="is_blocking" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
