<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_purchase_request_budget" model="res.groups">
        <field name="name">Purchase Request User : Budget</field>
        <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchase_request_user'))]" />
        <field name="category_id" ref="purchase_request.module_category_purchase_request" />
    </record>
    <record id="purchase_request_kmitl.group_purchase_request_user_all" model="res.groups">
        <field name="name">Purchase Request User : All Documents</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_budget'))]" />
        <field name="category_id" ref="purchase_request.module_category_purchase_request" />
    </record>

    <!-- rules -->
    <record id="purchase_request_budget_rule" model="ir.rule">
        <field name="name">Purchase Request User : Budget</field>
        <field name="model_id" ref="purchase_request.model_purchase_request" />
        <field name="groups" eval="[(6,0, [ref('purchase_request_budget.group_purchase_request_budget')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="purchase_request_budget_line_rule" model="ir.rule">
        <field name="name">Purchase Request User : Budget</field>
        <field name="model_id" ref="purchase_request.model_purchase_request_line" />
        <field name="groups" eval="[(6,0, [ref('purchase_request_budget.group_purchase_request_budget')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
