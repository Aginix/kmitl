<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form (Budget)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute
                    name="statusbar_visible"
                >draft,budget_validate,to_approve,approved,done,in_progress</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="before">
                <field name="hide_reserve_budget_button" invisible="1" />
                <button
                    name="action_reserve_budget"
                    type="object"
                    attrs="{'invisible':[('hide_reserve_budget_button', '=', True)]}"
                    string="Reserve Budget"
                    class="oe_highlight btn-success"
                    groups="budget.group_budget_commitment"
                />
            </xpath>
            <button name="button_approved" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible':[('state','!=','to_approve')]}</attribute>
            </button>
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_open_budget_commitment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible':[('budget_commitment_id','=',False)]}"
                >
                    <field name="budget_commitment_id" invisible="1" />
                    <div class="o_stat_info">
                        <span>Budget</span>
                    </div>
                </button>
                <button
                    name="action_view_budget_dashboard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bar-chart"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">สถานะงบ</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="before">
                <field name="product_id" invisible="1" />

                <!-- The reserved commitment, however it came to be: reserved by
                     this request or drawn from an existing slip. Shown to everyone
                     once a slip exists — users without budget.group_budget_commitment
                     never see the selection UI below, but they must still see the
                     ใบจองงบประมาณ their request ended up with. -->
                <group
                    name="budget_commitment_info_group" string="รหัสงบประมาณ"
                    attrs="{'invisible': [('budget_commitment_id', '=', False)]}"
                >
                    <field name="budget_commitment_state" invisible="1" />
                    <field
                        name="budget_commitment_id"
                        colspan="2" nolabel="1"
                        widget="budget_commitment_info" readonly="1"
                        options="{'no_create': True, 'no_open': True}"
                    />
                </group>

                <!-- Budget selection UI: reserved to budget officers. Users without
                     budget.group_budget_commitment never see this group nor its
                     heading — they only see the reserved commitment above. -->
                <group
                    name="budget_details" string="Budget Details"
                    groups="budget.group_budget_commitment"
                >
                    <field name="is_budget_editable" invisible="1" />
                    <!-- Ask which way first, then show only that way's fields. The
                         mode is a UI affordance: the server still keys draw-down off
                         reservation_commitment_id (ADR-0010). -->
                    <field
                        name="budget_selection_mode"
                        colspan="2" widget="radio" options="{'horizontal': True}"
                        attrs="{'invisible': [('is_budget_editable', '=', False)]}"
                    />
                    <button name="action_open_reservation_picker" type="object"
                        string="เลือกงบประมาณจากผังงบ (ดูยอดคงเหลือ)"
                        colspan="2" class="btn btn-primary mb-2" icon="fa-sitemap"
                        attrs="{'invisible': ['|', '|', ('is_budget_editable', '=', False), ('reservation_commitment_id', '!=', False), ('budget_selection_mode', '!=', 'normal')]}"/>
                    <field name="analytic_distribution" invisible="1" />
                    <field name="reservation_commitment_domain" invisible="1" />

                    <field
                        name="reservation_commitment_id"
                        colspan="2"
                        widget="budget_commitment_info"
                        domain="reservation_commitment_domain"
                        options="{'no_create': True, 'no_open': True}"
                        attrs="{'invisible': ['|', '&amp;', ('budget_selection_mode', '=', 'normal'), ('reservation_commitment_id', '=', False), '&amp;', '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel'), ('is_budget_editable', '=', False)], 'readonly': [('is_budget_editable', '=', False)]}"
                        placeholder="เลือกใบจองงบประมาณที่จะหยิบไปใช้"
                    />

                    <field
                        name="budget_account_id"
                        readonly="1" attrs="{'required': [('state', '=', 'to_verify'), ('budget_selection_mode', '=', 'normal')], 'invisible': ['|', ('budget_selection_mode', '!=', 'normal'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"
                        options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                    />
                    <field name="budget_account_id" invisible="1" />
                    <field
                        name="activity_analytic_id"
                        readonly="1" attrs="{'required': [('state', '=', 'to_verify'), ('budget_selection_mode', '=', 'normal')], 'invisible': ['|', ('budget_selection_mode', '!=', 'normal'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"
                        options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                    />
                    <field name="activity_analytic_id" invisible="1" />
                    <field
                        name="department_analytic_id"
                        readonly="1" attrs="{'required': [('state', '=', 'to_verify'), ('budget_selection_mode', '=', 'normal')], 'invisible': ['|', ('budget_selection_mode', '!=', 'normal'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"
                        options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                    />
                    <field name="department_analytic_id" invisible="1" />
                    <field
                        name="fund_analytic_id"
                        widget="selection"
                        readonly="1" attrs="{'required': [('state', '=', 'to_verify'), ('budget_selection_mode', '=', 'normal')], 'invisible': ['|', ('budget_selection_mode', '!=', 'normal'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"
                    />
                    <field name="fund_analytic_id" widget="selection" invisible="1" />
                    <field
                        name="source_analytic_id"
                        widget="selection"
                        readonly="1" attrs="{'required': [('state', '=', 'to_verify'), ('budget_selection_mode', '=', 'normal')], 'invisible': ['|', ('budget_selection_mode', '!=', 'normal'), '&amp;', ('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')]}"
                    />
                    <field name="source_analytic_id" widget="selection" invisible="1" />
                </group>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_product_id': product_id}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree (Budget)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="budget_account_id" optional="hide" />
                <field name="department_analytic_id" optional="hide" />
                <field name="source_analytic_id" optional="show" />
                <field name="activity_analytic_id" optional="hide" />
                <field name="fund_analytic_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
