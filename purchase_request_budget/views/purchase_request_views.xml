<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form (Budget)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <!-- state ที่โมดูลนี้เป็นเจ้าของ ต่อเข้า statusbar เอง -->
            <xpath expr="//form/header/field[@name='state']" position="attributes">
                <attribute
                    name="statusbar_visible"
                    add="to_verify_budget"
                    separator=","
                />
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="states" add="to_verify_budget" separator="," />
            </xpath>
            <!-- ตีกลับ to_verify_budget → to_verify: ปุ่มของผู้จองงบประมาณ พ.1
                 เอง (root ADR-0010) -->
            <xpath expr="//button[@name='button_return']" position="after">
                <button
                    name="button_return"
                    states="to_verify_budget"
                    string="Return"
                    type="object"
                    groups="purchase_request_budget.group_purchase_request_budget_commit"
                />
                <!-- ดึงกลับ to_verify_budget → to_verify: ผู้ตรวจสอบ พ.1 แก้สิ่งที่
                     ตรวจผิด ตราบที่ยังไม่ได้จองงบ (root ADR-0010) -->
                <button
                    name="action_recall_to_verify"
                    string="ดึงกลับ"
                    type="object"
                    attrs="{'invisible': ['|', ('state', '!=', 'to_verify_budget'), ('budget_commitment_state', 'not in', [False, 'cancel', 'draft'])]}"
                    groups="purchase_request_kmitl.group_purchase_request_verify"
                />
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="before">
                <field name="hide_reserve_budget_button" invisible="1" />
                <button
                    name="action_reserve_budget"
                    type="object"
                    attrs="{'invisible':[('hide_reserve_budget_button', '=', True)]}"
                    string="Reserve Budget"
                    class="oe_highlight btn-success"
                    groups="purchase_request_budget.group_purchase_request_budget_commit"
                />
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_open_budget_commitment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible':[('budget_commitment_id','=',False)]}"
                >
                    <field name="budget_commitment_id" invisible="1" />
                    <div class="o_stat_info">
                        <span>Budget</span>
                    </div>
                </button>
                <button
                    name="action_view_budget_dashboard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bar-chart"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">สถานะงบ</span>
                    </div>
                </button>
            </xpath>

            <!-- Asked first, as it steers the rest of the form: ปีงบประมาณ, then
                 จัดซื้อภายใต้ (asked of the requester, confirmed by the verifier —
                 root ADR-0011). The year filters which project/plan can be
                 picked; source bridges add that field after the radio. -->
            <xpath
                expr="//group[@name='purchase_request_details_group']"
                position="before"
            >
                <group name="procurement_under_group">
                    <group>
                        <field name="is_procurement_under_editable" invisible="1" />
                        <field
                            name="budget_selection_mode"
                            widget="radio"
                            attrs="{'readonly': [('is_procurement_under_editable', '=', False)]}"
                        />
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='budget_selection_mode']" position="before">
                <xpath expr="//field[@name='account_fiscal_year_id']" position="move" />
            </xpath>
            <xpath expr="//notebook" position="before">
                <field name="product_id" invisible="1" />

                <!-- The reserved commitment, however it came to be: reserved by
                     this request or drawn from an existing slip. Shown to everyone
                     once a slip exists — users outside the verify / budget-commit
                     groups never see the selection UI below, but they must still see the
                     ใบจองงบประมาณ their request ended up with. -->
                <group
                    name="budget_commitment_info_group"
                    string="รหัสงบประมาณ"
                    attrs="{'invisible': [('budget_commitment_id', '=', False)]}"
                >
                    <field name="budget_commitment_state" invisible="1" />
                    <field
                        name="budget_commitment_id"
                        colspan="2"
                        nolabel="1"
                        widget="budget_commitment_info"
                        readonly="1"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="budget_committed_by"
                        attrs="{'invisible': [('budget_committed_by', '=', False)]}"
                        options="{'no_open': True}"
                    />
                    <field
                        name="date_budget_committed"
                        attrs="{'invisible': [('date_budget_committed', '=', False)]}"
                    />
                </group>

                <!-- Budget selection UI: reserved to ผู้ตรวจสอบ พ.1 and ผู้จองงบประมาณ
                     พ.1, each editing while its own step is open (is_budget_editable,
                     root ADR-0010). Everyone else only sees the reserved commitment
                     above. -->
                <group
                    name="budget_details"
                    string="Budget Details"
                    groups="purchase_request_kmitl.group_purchase_request_verify,purchase_request_budget.group_purchase_request_budget_commit"
                >
                    <field name="is_budget_editable" invisible="1" />
                    <field name="analytic_distribution" invisible="1" />

                    <!-- Entered directly, no chart picker (root ADR-0010):
                         completeness and availability are checked at Reserve. A
                         project/plan fills them and they show read-only; its
                         ใบจอง is found at Reserve, never picked (root ADR-0011). -->
                    <field name="budget_account_domain" invisible="1" />
                    <field
                        name="budget_account_id"
                        domain="budget_account_domain"
                        attrs="{'invisible': [('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')], 'readonly': [('is_budget_editable', '=', False)]}"
                        options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                    />
                    <field
                        name="activity_analytic_id"
                        attrs="{'invisible': [('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')], 'readonly': [('is_budget_editable', '=', False)]}"
                        options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                    />
                    <field
                        name="department_analytic_id"
                        attrs="{'invisible': [('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')], 'readonly': [('is_budget_editable', '=', False)]}"
                        options="{'no_create_edit': True, 'no_open': True, 'no_create': True}"
                    />
                    <field
                        name="fund_analytic_id"
                        widget="selection"
                        attrs="{'invisible': [('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')], 'readonly': [('is_budget_editable', '=', False)]}"
                    />
                    <field
                        name="source_analytic_id"
                        widget="selection"
                        attrs="{'invisible': [('budget_commitment_id', '!=', False), ('budget_commitment_state', '!=', 'cancel')], 'readonly': [('is_budget_editable', '=', False)]}"
                    />
                </group>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_product_id': product_id}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree (Budget)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="budget_account_id" optional="hide" />
                <field name="department_analytic_id" optional="hide" />
                <field name="source_analytic_id" optional="show" />
                <field name="activity_analytic_id" optional="hide" />
                <field name="fund_analytic_id" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">view.purchase.request.search (Budget)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='state_to_verify']" position="after">
                <filter
                    name="state_to_verify_budget"
                    string="To Verify Budget"
                    domain="[('state','=','to_verify_budget')]"
                />
            </xpath>
        </field>
    </record>
</odoo>
