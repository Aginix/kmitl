<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,budget_validate,to_approve,approved,done,in_progress</attribute>
            </xpath>
            <xpath expr="//form//notebook/page[1]" position="after">
                <page string="จองงบประมาณ">
                    <group>
                        <field name="analytic_distribution" invisible="1" />
                        <field name="analytic_distribution" widget="analytic_distribution" invisible="0" groups="base.group_erp_manager" />
                        <field name="budget_account_id" />
                        <field name="budget_account_id" invisible="1" />
                        <field name="activity_analytic_id" />
                        <field name="department_analytic_id" />
                        <field name="fund_analytic_id" />
                        <field name="source_analytic_id" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="before">
                <button name="action_reserve_budget" type="object" attrs="{'invisible':[('state','!=','to_approve')]}" string="Reserve Budget" class="oe_highlight btn-success" />
            </xpath>
            <button name="button_approved" position="attributes">
                <attribute name="attrs">{'invisible':[('state','!=','to_approve')]}</attribute>
            </button>
            <xpath expr="//sheet/div[@class='oe_button_box']" position="inside">
                <button name="action_open_budget_commitment" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible':[('budget_commitment_id','=',False)]}">
                    <field name="budget_commitment_id" invisible="1"/>
                    <div class="o_stat_info">
                        <span>Budget</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="budget_account_id" optional="hide" />
                <field name="department_analytic_id" optional="hide"/>
                <field name="source_analytic_id" optional="show"/>
                <field name="activity_analytic_id" optional="hide"/>
                <field name="fund_analytic_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
