<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="จองงบประมาณ" groups="purchase_request_budget.group_purchase_request_budget">
                    <group>
                        <field name="can_edit_budget" invisible="1" />
                        <field name="budget_account_id" groups="purchase_request_budget.group_purchase_request_budget" attrs="{'readonly':[('can_edit_budget','=',False)]}" />
                        <field name="activity_analytic_id" groups="purchase_request_budget.group_purchase_request_budget" attrs="{'readonly':[('can_edit_budget','=',False)]}" />
                        <field name="department_analytic_id" groups="purchase_request_budget.group_purchase_request_budget" attrs="{'readonly':[('can_edit_budget','=',False)]}" />
                        <field name="fund_analytic_id" groups="purchase_request_budget.group_purchase_request_budget" attrs="{'readonly':[('can_edit_budget','=',False)]}" />
                        <field name="source_analytic_id" groups="purchase_request_budget.group_purchase_request_budget" attrs="{'readonly':[('can_edit_budget','=',False)]}" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_budget_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="before">
                <field name="can_edit_budget" invisible="1" />
                <button name="action_check_budget" type="object" attrs="{'invisible':['|', ('state','!=','to_approve'), ('can_edit_budget','=', False)]}" string="Check Budget" class="oe_highlight btn-info" groups="purchase_request_budget.group_purchase_request_budget" />
                <button name="action_reserve_budget" type="object" attrs="{'invisible':['|', ('state','!=','to_approve'), ('can_edit_budget','=', False)]}" string="Reserve Budget" class="oe_highlight btn-success" groups="purchase_request_budget.group_purchase_request_budget" />
            </xpath>
            <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="attrs">{'invisible':['|', ('state','!=','to_approve'), ('can_edit_budget','!=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
