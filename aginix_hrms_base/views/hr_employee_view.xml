<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_employee_filter_my_department" model="ir.ui.view">
            <field name="name">hr.employee.search filter_my_department</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter" />
            <field name="arch" type="xml">
                 <xpath expr="//filter[@name='group_category_ids']" position="after">
                    <filter
                        string="Master Department"
                        name="master_department_id"
                        domain="[]"
                        context="{'group_by': 'master_department_id'}"
                    />
                </xpath>
                <xpath expr="//search//filter[@name='my_department']" position="after">
                    <filter
                        name="member_of_master_department"
                        string="My Master Department"
                        domain="[('member_of_master_department', '=', True)]"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
