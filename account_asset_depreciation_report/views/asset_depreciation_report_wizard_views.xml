<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_depreciation_report_wizard_form" model="ir.ui.view">
        <field name="name">asset.depreciation.report.wizard.form</field>
        <field name="model">asset.depreciation.report.wizard</field>
        <field name="arch" type="xml">
            <form string="รายงานสำรวจทรัพย์สินและค่าเสื่อมราคา">
                <group>
                    <group>
                        <field name="date" />
                        <field name="account_fiscal_year_id" />
                        <field name="profile_id" required="1" />
                        <field name="source_of_asset" required="1" />
                    </group>
                    <group>
                        <field name="source_analytic_id" required="1" />
                        <field name="department_analytic_id" />
                        <div colspan="2" class="alert alert-warning show" role="alert">
                            Leave department empty to export data for all departments.
                        </div>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_generate_report"
                        string="สร้างรายงาน"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_depreciation_report_wizard" model="ir.actions.act_window">
        <field name="name">รายงานสำรวจทรัพย์สินและค่าเสื่อมราคา</field>
        <field name="res_model">asset.depreciation.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_asset_report"
        name="รายงาน"
        parent="account_asset_kmitl.menu_assets_management"
        sequence="50"
    />

    <menuitem
        id="menu_asset_depreciation_report"
        name="รายงานสำรวจทรัพย์สินและค่าเสื่อมราคา"
        parent="menu_asset_report"
        action="action_asset_depreciation_report_wizard"
        sequence="10"
    />
</odoo>
