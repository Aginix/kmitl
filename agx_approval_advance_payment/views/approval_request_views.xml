<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record
        id="approval_request_view_form_advance_payment"
        model="ir.ui.view"
    >
        <field name="name">approval.request.view.form.advance.payment</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval_disbursement.approval_request_view_form"
        />
        <field name="arch" type="xml">
            <!-- Borrowing is pulled from the loan side: the borrower opens
                 their own สัญญายืม and picks this request (ADR-0003). There is
                 deliberately no "Create Advance Payment" button here. -->

            <!-- Stat button: every loan drawn against this request -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_advance_payment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    attrs="{'invisible': [('advance_payment_count', '=', 0)]}"
                >
                    <field
                        name="advance_payment_count"
                        widget="statinfo"
                        string="สัญญายืมเงิน"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
