<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Loan type that pins the source reference to an Approval Request, so
             the borrower gets the request picker instead of the generic
             Reference widget (advance_payment ADR-0007). -->
        <record id="loan_type_approval_request" model="advance.payment.loan.type">
            <field name="name">ตามใบขออนุมัติค่าใช้จ่าย</field>
            <field name="reference_model">approval.request</field>
        </record>
    </data>

    <!-- A borrowing rule (advance_payment ADR-0030), maintained by the
         administrators from the Exception Rules menu — noupdate so an
         upgrade does not undo their edits. -->
    <data noupdate="1">
    <record id="excep_ar_not_approved" model="exception.rule">
        <field name="name">ใบขออนุมัติยังไม่ได้รับอนุมัติ</field>
        <field name="description">ใบขออนุมัติที่อ้างอิงต้องได้รับอนุมัติแล้วจึงจะยืมเงินได้</field>
        <field name="sequence">33</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_domain</field>
        <field
            name="domain"
        >[('approval_request_id', '!=', False), ('is_approval_request_approved', '=', False)]</field>
        <field name="is_blocking" eval="True"/>
        <field name="active" eval="True"/>
    </record>
    </data>
</odoo>
