<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form(PR approval Budget)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="before">
                <field name="can_edit_budget" invisible="1" />
            </button>
            <xpath expr="//button[@name='action_reserve_budget']" position="attributes">
                <attribute name="groups">purchase_request_approval_kmitl.group_purchase_request_budget</attribute>
                <attribute name="attrs">{'invisible':['|', ('state','!=','to_verify'), ('substate_sequence', '!=', 10)]}</attribute>
            </xpath>
            <field name="budget_account_id" position="attributes">
                <attribute name="attrs">{'readonly':[('can_edit_budget','=',False)]}</attribute>
            </field>
            <field name="activity_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly':[('can_edit_budget','=',False)]}</attribute>
            </field>
            <field name="department_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly':[('can_edit_budget','=',False)]}</attribute>
            </field>
            <field name="fund_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly':[('can_edit_budget','=',False)]}</attribute>
            </field>
            <field name="source_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly':[('can_edit_budget','=',False)]}</attribute>
            </field>
            <field name="substate_id" position="attributes">
                <attribute name="attrs">{'invisible':[('state','!=','to_verify')]}</attribute>
            </field>
        </field>
    </record>
</odoo>
