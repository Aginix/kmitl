<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_return_wizard_form" model="ir.ui.view">
        <field name="name">advance.payment.return.wizard.form</field>
        <field name="model">advance.payment.return.wizard</field>
        <field name="arch" type="xml">
            <form string="แจ้งคืนเงิน">
                <group name="amount_summary" string="สรุปยอดเงิน">
                    <field name="agreement_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="loan_amount"/>
                    <field name="amount_used"/>
                    <field name="amount_returned"/>
                    <field name="amount_remaining"/>
                </group>
                <group name="return_details" string="รายละเอียดการคืนเงิน">
                    <field name="amount"/>
                </group>
                <group name="return_evidence" string="หลักฐานการคืนเงิน">
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                </group>
                <group name="note" string="หมายเหตุ">
                    <field name="note" nolabel="1" placeholder="หมายเหตุเพิ่มเติม (ถ้ามี)"/>
                </group>
                <footer>
                    <button name="action_confirm_return" string="ส่งคำขอคืนเงิน" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
