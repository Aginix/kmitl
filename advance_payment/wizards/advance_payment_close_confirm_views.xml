<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_close_confirm_form" model="ir.ui.view">
        <field name="name">advance.payment.close.confirm.form</field>
        <field name="model">advance.payment.close.confirm</field>
        <field name="arch" type="xml">
            <form string="ยืนยันการปิดสัญญา">
                <group>
                    <div class="alert alert-warning" role="alert">
                        <field name="currency_id" invisible="1"/>
                        <p>
                            <strong>ยอดเงินคงเหลือ:</strong>
                            <field name="amount_remaining" class="oe_inline"/> บาท
                        </p>
                        <p>ยอดเงินยังคืนไม่ครบ ต้องการปิดสัญญาหรือไม่?</p>
                    </div>
                </group>
                <footer>
                    <button name="action_confirm" string="ยืนยันปิดสัญญา" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
