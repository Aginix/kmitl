<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_exception_confirm_form" model="ir.ui.view">
        <field name="name">advance.payment.exception.confirm.form</field>
        <field name="model">advance.payment.exception.confirm</field>
        <field name="inherit_id" ref="base_exception.view_exception_rule_confirm"/>
        <field name="arch" type="xml">
            <field name="exception_ids" position="before">
                <field name="related_model_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="action_advance_payment_exception_confirm" model="ir.actions.act_window">
        <field name="name">Advance Payment Exceptions</field>
        <field name="res_model">advance.payment.exception.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
