<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_cancel_wizard_form" model="ir.ui.view">
        <field name="name">advance.payment.cancel.wizard.form</field>
        <field name="model">advance.payment.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="ยกเลิก/ส่งกลับสัญญา">
                <group>
                    <field name="agreement_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>
                    <field name="reason" placeholder="กรุณาระบุเหตุผล..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="ยืนยัน" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
