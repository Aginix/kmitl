<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="excep_loan_amount_too_low" model="exception.rule">
        <field name="name">จำนวนเงินยืมต้องมากกว่า 0</field>
        <field name="description">จำนวนเงินยืมต้องมากกว่า 0 บาท</field>
        <field name="sequence">10</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[('loan_amount', '&lt;=', 0)]</field>
        <field name="is_blocking" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="excep_loan_amount_too_high" model="exception.rule">
        <field name="name">จำนวนเงินยืมเกินวงเงิน</field>
        <field name="description">จำนวนเงินยืมต้องไม่เกิน 50,000 บาท</field>
        <field name="sequence">20</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[('loan_amount', '&gt;', 50000)]</field>
        <field name="is_blocking" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="excep_missing_bank_account" model="exception.rule">
        <field name="name">ไม่ได้ระบุบัญชีธนาคาร</field>
        <field name="description">กรุณาระบุบัญชีธนาคารก่อนส่งขออนุมัติ</field>
        <field name="sequence">30</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[('bank_id', '=', False)]</field>
        <field name="is_blocking" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="excep_missing_reference" model="exception.rule">
        <field name="name">ไม่ได้ระบุเอกสารอ้างอิง</field>
        <field name="description">ประเภทเงินยืมนี้ต้องอ้างอิงเอกสารต้นทาง กรุณาระบุก่อนส่งคำขอ</field>
        <field name="sequence">31</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_domain</field>
        <field name="domain">[('reference_model', '=', False), ('loan_type_id.reference_model', '!=', False)]</field>
        <field name="is_blocking" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="excep_missing_manager" model="exception.rule">
        <field name="name">ไม่ได้ระบุผู้บังคับบัญชา</field>
        <field name="description">กรุณาระบุผู้บังคับบัญชาผู้เห็นชอบก่อนส่งคำขอ (ปกติระบบเติมให้จากผู้บังคับบัญชาของผู้ยืม หากไม่มีให้เลือกเอง)</field>
        <field name="sequence">32</field>
        <field name="model">advance.payment</field>
        <field name="exception_type">by_domain</field>
        <!-- Checks endorser_id, not employee_id.parent_id: the endorser is
             pickable now, so a borrower with no hr.employee manager can still
             name one and proceed. Scoped to the states before endorsement —
             past to_endorse the endorser is already named, so this must not
             block the loan officer's own corrections in to_verify. -->
        <field name="domain">['&amp;', ('state', 'in', ['draft', 'to_endorse']), ('endorser_id', '=', False)]</field>
        <field name="is_blocking" eval="True"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
