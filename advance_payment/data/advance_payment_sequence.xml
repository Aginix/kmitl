<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_advance_payment_agreement" model="ir.sequence">
            <field name="name">Advance Payment</field>
            <field name="code">advance.payment</field>
            <field name="prefix">ADV/%(year_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Formal contract number, assigned at the Effective Date. Simple
             format for now; a dedicated override module may customize it
             later (ADR-0001). -->
        <record id="seq_advance_payment_contract" model="ir.sequence">
            <field name="name">Advance Payment Contract</field>
            <field name="code">advance.payment.contract</field>
            <field name="prefix">APC/%(year_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
