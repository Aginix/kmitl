<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home Entry -->
    <template id="portal_my_home_advance_payment" name="Portal My Home: Advance Payment" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">คำขอยืมเงิน</t>
                <t t-set="url" t-value="'/my/advance-payments'"/>
                <t t-set="placeholder_count" t-value="'advance_payment_count'"/>
            </t>
        </xpath>
    </template>

    <!-- List View -->
    <template id="portal_my_advance_payments" name="My Advance Payments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">คำขอยืมเงิน</t>
            </t>

            <t t-if="not payments">
                <div class="alert alert-warning mt-3" role="alert">
                    ไม่มีรายการคำขอยืมเงิน
                </div>
            </t>
            <t t-if="payments" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>เลขที่</th>
                        <th>ประเภท</th>
                        <th class="text-end">จำนวนเงิน</th>
                        <th class="text-end">คงค้าง</th>
                        <th>สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="payments" t-as="payment">
                        <tr>
                            <td>
                                <a t-att-href="payment.get_portal_url()">
                                    <t t-esc="payment.name"/>
                                </a>
                            </td>
                            <td><span t-field="payment.type_id"/></td>
                            <td class="text-end">
                                <span t-out="'{:,.2f}'.format(payment.amount)"/>
                            </td>
                            <td class="text-end">
                                <span t-out="'{:,.2f}'.format(payment.amount_residual)"/>
                            </td>
                            <td>
                                <span t-field="payment.state" class="badge badge-pill"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Detail Page -->
    <template id="portal_advance_payment_page" name="Portal Advance Payment Page" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="row mt16 o_portal_advance_payment_sidebar">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>
                    <t t-set="title">
                        <h2 class="mb-0">
                            <b t-out="'{:,.2f}'.format(advance_payment.amount)"/>
                            <small class="ms-1" t-field="advance_payment.currency_id"/>
                        </h2>
                        <div class="small mt-1" t-field="advance_payment.state"/>
                    </t>
                    <t t-set="entries">
                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">
                            <li class="list-group-item flex-grow-1">
                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 me-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_download_btn"
                                           t-att-href="advance_payment.get_portal_url(report_type='pdf', download=True)"
                                           title="Download">
                                            <i class="fa fa-download"/> Download
                                        </a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_print_btn"
                                           t-att-href="advance_payment.get_portal_url(report_type='pdf')"
                                           title="Print" target="_blank">
                                            <i class="fa fa-print"/> Print
                                        </a>
                                    </div>
                                </div>
                            </li>
                            <li class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">พนักงาน</strong>
                                </div>
                                <span t-field="advance_payment.employee_id"/>
                            </li>
                            <li t-if="advance_payment.type_id" class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">ประเภทการยืม</strong>
                                </div>
                                <span t-field="advance_payment.type_id"/>
                            </li>
                            <li t-if="advance_payment.date_due" class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">กำหนดคืน</strong>
                                </div>
                                <span t-field="advance_payment.date_due" t-options='{"widget": "date"}'/>
                            </li>
                        </ul>
                    </t>
                </t>

                <!-- Main Content -->
                <div id="portal_advance_payment_content" class="col-12 col-lg">
                    <div class="o_portal_html_view shadow p-3">
                        <div class="o_portal_html_loader text-center">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>
                        </div>
                        <iframe id="advance_payment_html" class="mt8 mb8" width="100%" height="100%"
                                frameborder="0" scrolling="no"
                                t-att-src="advance_payment.get_portal_url(report_type='html')"/>
                    </div>
                    <!-- Chatter -->
                    <div id="advance_payment_communication" class="mt-4">
                        <h2>ประวัติ</h2>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="advance_payment"/>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
