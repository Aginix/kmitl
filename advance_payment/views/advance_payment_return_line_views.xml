<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_return_line_tree" model="ir.ui.view">
        <field name="name">advance.payment.return.line.tree</field>
        <field name="model">advance.payment.return.line</field>
        <field name="arch" type="xml">
            <tree string="รายการคืนเงิน">
                <field name="agreement_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="note"/>
                <field name="payment_id"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'pending_review'"
                    decoration-danger="state == 'rejected'"
                    decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_advance_payment_return_line_form" model="ir.ui.view">
        <field name="name">advance.payment.return.line.form</field>
        <field name="model">advance.payment.return.line</field>
        <field name="arch" type="xml">
            <form string="รายการคืนเงิน">
                <header>
                    <button name="action_confirm"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve"
                        string="อนุมัติ"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'pending_review')]}"
                        groups="advance_payment.group_advance_payment_responsible"/>
                    <button name="action_reject"
                        string="ตีกลับ"
                        type="object"
                        class="btn-danger"
                        attrs="{'invisible': [('state', '!=', 'pending_review')]}"
                        groups="advance_payment.group_advance_payment_responsible"/>
                    <button name="action_reset_to_draft"
                        string="แก้ไข"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'rejected')]}"
                        groups="advance_payment.group_advance_payment_user"/>
                    <button name="action_admin_reset"
                        string="ย้อนกลับเป็นร่าง"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                        groups="base.group_system"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,pending_review,done"/>
                </header>
                <sheet>
                    <group>
                        <group name="details" string="รายละเอียด">
                            <field name="agreement_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date"/>
                        </group>
                        <group name="payment_info" string="การชำระเงิน">
                            <field name="payment_id"
                                attrs="{'invisible': [('payment_id', '=', False)]}"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group name="note" string="หมายเหตุ">
                        <field name="note" colspan="2" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="สลิปเงิน" name="slip">
                            <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_advance_payment_return_line" model="ir.actions.act_window">
        <field name="name">รายการคืนเงิน</field>
        <field name="res_model">advance.payment.return.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
