<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_list" model="ir.ui.view">
        <field name="name">advance.payment.list</field>
        <field name="model">advance.payment</field>
        <field name="arch" type="xml">
            <tree string="สัญญายืมเงิน">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="loan_type_id"/>
                <field name="loan_amount"/>
                <field name="amount_used"/>
                <field name="amount_remaining"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state in ('submitted', 'in_progress')"
                    decoration-primary="state == 'approved'"
                    decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_advance_payment_form" model="ir.ui.view">
        <field name="name">advance.payment.form</field>
        <field name="model">advance.payment</field>
        <field name="arch" type="xml">
            <form string="สัญญายืมเงิน">
                <header>
                    <button name="action_submit"
                        string="ส่งเพื่อขออนุมัติ"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve"
                        string="อนุมัติ"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_open_usage_wizard"
                        string="บันทึกการใช้เงิน"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_open_return_wizard"
                        string="คืนเงิน"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,in_progress,done"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_payments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-credit-card"
                            attrs="{'invisible': [('payment_count', '=', 0)]}">
                            <field name="payment_count" string="Payments" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="ข้อมูลผู้ยืม">
                            <field name="requested_by"/>
                            <field name="department_id"/>
                        </group>
                        <group string="ข้อมูลการยืม">
                            <field name="reference"/>
                            <field name="method_id"/>
                            <field name="loan_type_id"/>
                            <field name="loan_reason"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="loan_amount"/>
                        </group>
                    </group>
                    <group string="ข้อมูลธนาคาร">
                        <field name="bank_id"/>
                        <field name="bank_account_number"/>
                    </group>
                    <group string="สรุปยอดเงิน" attrs="{'invisible': [('state', '=', 'draft')]}">
                        <field name="amount_used"/>
                        <field name="amount_remaining"/>
                    </group>
                    <notebook>
                        <page string="รายการใช้เงิน" name="usage_lines">
                            <field name="usage_line_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="เอกสารแนบ" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_advance_payment_search" model="ir.ui.view">
        <field name="name">advance.payment.search</field>
        <field name="model">advance.payment</field>
        <field name="arch" type="xml">
            <search string="สัญญายืมเงิน">
                <field name="name"/>
                <field name="requested_by"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Loan Type" name="group_loan_type" context="{'group_by':'loan_type_id'}"/>
                    <filter string="Requested By" name="group_requested_by" context="{'group_by':'requested_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_advance_payment" model="ir.actions.act_window">
        <field name="name">สัญญายืมเงิน</field>
        <field name="res_model">advance.payment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
