<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_list" model="ir.ui.view">
        <field name="name">advance.payment.list</field>
        <field name="model">advance.payment</field>
        <field name="arch" type="xml">
            <tree string="สัญญายืมเงิน" decoration-info="state == 'draft'"
                decoration-warning="state in ('submitted', 'in_progress')"
                decoration-primary="state == 'approved'"
                decoration-success="state == 'done'"
                decoration-danger="state == 'cancel'">
                <field name="create_date" optional="show" />
                <field name="name" />
                <field name="requested_by" />
                <field name="loan_type_id" />
                <field name="loan_amount" />
                <field name="amount_used" />
                <field name="amount_remaining" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state in ('submitted', 'in_progress')"
                    decoration-primary="state == 'approved'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'" />
                <field name="disbursement_state" optional="show" widget="badge"
                    decoration-warning="disbursement_state == 'pending'"
                    decoration-success="disbursement_state == 'paid'" />
                <field name="main_exception_id" optional="show" />
                <field name="reference" optional="hide" />
                <field name="loan_reason" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="view_advance_payment_form" model="ir.ui.view">
        <field name="name">advance.payment.form</field>
        <field name="model">advance.payment</field>
        <field name="arch" type="xml">
            <form string="สัญญายืมเงิน">
                <div class="alert alert-danger" role="alert" style="margin-bottom:0px;"
                    attrs="{'invisible': [('exceptions_summary','=',False)]}">
                    <p>
                        <strong>มีข้อผิดพลาดที่ต้องแก้ไข:</strong>
                    </p>
                    <field name="exceptions_summary" />
                </div>
                <div class="alert alert-warning" role="alert" style="margin-bottom:0px;"
                    attrs="{'invisible': ['|', ('disbursement_state', '!=', 'pending'), ('state', 'in', ['done', 'cancel'])]}">
                    <strong>คำขอได้รับอนุมัติแล้ว</strong> — รอฝ่ายการเงินดำเนินการเบิกจ่าย </div>
                <div class="alert alert-success" role="alert" style="margin-bottom:0px;"
                    attrs="{'invisible': ['|', ('disbursement_state', '!=', 'paid'), ('state', 'in', ['done', 'cancel'])]}">
                    <strong>เบิกจ่ายแล้ว</strong> — สัญญากำลังดำเนินการ </div>
                <header>
                    <button name="action_submit"
                        string="ส่งเพื่อขออนุมัติ"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="action_approve"
                        string="อนุมัติ"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'submitted')]}"
                        groups="advance_payment.group_advance_payment_manager" />
                    <button name="action_open_reject_wizard"
                        string="ส่งกลับแก้ไข"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'submitted')]}"
                        groups="advance_payment.group_advance_payment_manager" />
                    <button name="action_open_cancel_wizard"
                        string="ยกเลิกสัญญา"
                        type="object"
                        attrs="{'invisible': [('state', 'not in', ['submitted', 'approved', 'in_progress'])]}"
                        groups="advance_payment.group_advance_payment_manager" />
                    <button name="action_open_usage_wizard"
                        string="บันทึกการใช้เงิน"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'in_progress')]}" />
                    <button name="action_open_return_wizard"
                        string="แจ้งคืนเงิน"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'in_progress')]}" />
                    <button name="action_close"
                        string="ปิดสัญญา"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'in_progress')]}"
                        groups="advance_payment.group_advance_payment_manager" />
                    <button name="action_reopen"
                        string="เปิดสัญญาอีกครั้ง"
                        type="object"
                        confirm="ต้องการเปิดสัญญาอีกครั้งหรือไม่?"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                        groups="base.group_system" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,in_progress,done" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_payments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-credit-card"
                            attrs="{'invisible': [('payment_count', '=', 0)]}"
                            groups="advance_payment.group_advance_payment_manager">
                            <field name="payment_count" string="Payments" widget="statinfo" />
                        </button>
                        <button name="action_view_return_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-undo"
                            attrs="{'invisible': [('return_count', '=', 0)]}">
                            <field name="return_count" string="Returns" widget="statinfo" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="ข้อมูลผู้ยืม">
                            <field name="requested_by"
                                groups="advance_payment.group_advance_payment_manager" />
                            <field name="requested_by" readonly="1"
                                groups="!advance_payment.group_advance_payment_manager" />
                            <field name="department_id" widget="selection" />
                            <field name="requested_by_partner_id" invisible="1" />
                            <field name="bank_id"
                                domain="[('partner_id', '=', requested_by_partner_id)]"
                                widget="selection" />
                        </group>
                        <group string="ข้อมูลการยืม">
                            <field name="reference" />
                            <field name="loan_type_id" widget="selection" />
                            <field name="loan_reason" />
                            <field name="currency_id" invisible="1" />
                            <field name="loan_amount" />
                        </group>
                    </group>
                    <group string="มิติทางบัญชี">
                        <field name="department_analytic_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}" />
                        <field name="source_analytic_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}" />
                        <field name="fund_analytic_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}" />
                        <field name="activity_analytic_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}" />
                    </group>
                    <group string="สรุปยอดเงิน" attrs="{'invisible': [('state', '=', 'draft')]}">
                        <field name="amount_used" />
                        <field name="amount_returned" />
                        <field name="amount_remaining" />
                        <field name="disbursement_state" widget="badge"
                            attrs="{'invisible': [('disbursement_state', '=', False)]}"
                            decoration-warning="disbursement_state == 'pending'"
                            decoration-success="disbursement_state == 'paid'" />
                    </group>
                    <group string="เหตุผล" attrs="{'invisible': [('cancel_reason', '=', False)]}">
                        <field name="cancel_reason" readonly="1" nolabel="1" />
                    </group>
                    <notebook>
                        <page string="รายการใช้เงิน" name="usage_lines">
                            <field name="usage_line_ids" readonly="1">
                                <tree>
                                    <field name="date" />
                                    <field name="amount" />
                                    <field name="note" />
                                </tree>
                            </field>
                        </page>
                        <page string="รายการคืนเงิน" name="return_lines"
                            attrs="{'invisible': [('state', 'in', ['draft', 'submitted'])]}">
                            <field name="return_line_ids"
                                attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}">
                                <tree editable="bottom">
                                    <field name="date" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="amount" />
                                    <field name="note" />
                                    <field name="payment_id" optional="show" />
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-warning="state == 'confirmed'"
                                        decoration-success="state == 'paid'" />
                                    <button name="action_confirm"
                                        string="ยืนยัน"
                                        type="object"
                                        icon="fa-check"
                                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                                        groups="advance_payment.group_advance_payment_manager" />
                                </tree>
                            </field>
                        </page>
                        <page string="เอกสารแนบ" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_advance_payment_search" model="ir.ui.view">
        <field name="name">advance.payment.search</field>
        <field name="model">advance.payment</field>
        <field name="arch" type="xml">
            <search string="สัญญายืมเงิน">
                <field name="name" />
                <field name="requested_by" />
                <separator />
                <filter icon="fa-exclamation-circle" name="tofix" string="Exceptions"
                    domain="[('main_exception_id','!=',False)]" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state','=','draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]" />
                <filter string="Approved" name="approved" domain="[('state','=','approved')]" />
                <filter string="In Progress" name="in_progress"
                    domain="[('state','=','in_progress')]" />
                <filter string="Done" name="done" domain="[('state','=','done')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancel')]" />
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by':'state'}" />
                    <filter string="Loan Type" name="group_loan_type"
                        context="{'group_by':'loan_type_id'}" />
                    <filter string="Requested By" name="group_requested_by"
                        context="{'group_by':'requested_by'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_advance_payment" model="ir.actions.act_window">
        <field name="name">สัญญายืมเงิน</field>
        <field name="res_model">advance.payment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
