<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_method_list" model="ir.ui.view">
        <field name="name">advance.payment.method.list</field>
        <field name="model">advance.payment.method</field>
        <field name="arch" type="xml">
            <tree string="วิธีการจ่ายเงินยืม" editable="bottom">
                <field name="name"/>
                <field name="default_for_model"/>
                <field name="account_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_advance_payment_method_form" model="ir.ui.view">
        <field name="name">advance.payment.method.form</field>
        <field name="model">advance.payment.method</field>
        <field name="arch" type="xml">
            <form string="วิธีการจ่ายเงินยืม">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="default_for_model"/>
                        <field name="account_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advance_payment_method" model="ir.actions.act_window">
        <field name="name">วิธีการจ่ายเงินยืม</field>
        <field name="res_model">advance.payment.method</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
