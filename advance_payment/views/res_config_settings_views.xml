<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_advance_payment" model="ir.ui.view">
        <field name="name">res.config.settings.advance_payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-key="advance_payment"
                    string="ยืมเงินทดรองจ่าย"
                    groups="advance_payment.group_advance_payment_manager"
                >
                    <h2>ยืมเงินทดรองจ่าย</h2>
                    <div class="o_settings_container">
                        <div class="o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="advance_payment_default_return_days"/>
                                <div class="text-muted">
                                    จำนวนวันที่ต้องคืนเงินทดรองจ่ายโดยค่าเริ่มต้น
                                </div>
                                <field name="advance_payment_default_return_days"/>
                            </div>
                        </div>
                        <div class="o_setting_box w-100">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="advance_payment_loan_term"/>
                                <div class="text-muted">
                                    เงื่อนไขการยืมเงินที่แสดงในแบบฟอร์มการยืมเงินโดยค่าเริ่มต้น
                                </div>
                                <field name="advance_payment_loan_term" widget="text"/>
                            </div>
                        </div>
                        <div class="o_setting_box w-100">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="advance_payment_receivable_account_id"/>
                                <div class="text-muted">
                                    บัญชีลูกหนี้เงินยืมทดรองที่ใช้เมื่อสร้างรายการจ่ายเงินยืม
                                </div>
                                <field name="advance_payment_receivable_account_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
