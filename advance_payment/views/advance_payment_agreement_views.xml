<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_agreement_list" model="ir.ui.view">
        <field name="name">advance.payment.agreement.list</field>
        <field name="model">advance.payment.agreement</field>
        <field name="arch" type="xml">
            <list string="สัญญายืมเงิน">
                <field name="name"/>
                <field name="borrower_name"/>
                <field name="loan_type_id"/>
                <field name="loan_amount"/>
                <field name="amount_used"/>
                <field name="amount_remaining"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'in_progress'"
                    decoration-primary="state == 'in_review'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_advance_payment_agreement_form" model="ir.ui.view">
        <field name="name">advance.payment.agreement.form</field>
        <field name="model">advance.payment.agreement</field>
        <field name="arch" type="xml">
            <form string="สัญญายืมเงิน">
                <header>
                    <button name="action_confirm"
                        string="ยืนยันส่งข้อมูล"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft' or confirmed"/>
                    <button name="action_approve"
                        string="อนุมัติ"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft' or not confirmed"/>
                    <button name="action_open_usage_wizard"
                        string="บันทึกการใช้เงิน"
                        type="object"
                        invisible="state != 'in_progress'"/>
                    <button name="action_open_return_wizard"
                        string="คืนเงิน"
                        type="object"
                        invisible="state != 'in_progress'"/>
                    <button name="action_close"
                        string="ปิดสัญญา"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'in_review'"/>
                    <button name="action_cancel"
                        string="ยกเลิก"
                        type="object"
                        invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,in_review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="ข้อมูลผู้ยืม">
                            <field name="borrower_name"/>
                            <field name="academic_position"/>
                            <field name="department"/>
                            <field name="sub_department"/>
                        </group>
                        <group string="ข้อมูลการยืม">
                            <field name="origin_reference"/>
                            <field name="loan_type_id"/>
                            <field name="loan_reason"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="loan_amount"/>
                        </group>
                    </group>
                    <group string="ข้อมูลธนาคาร">
                        <field name="bank_id"/>
                        <field name="bank_account_number"/>
                    </group>
                    <group string="สรุปยอดเงิน" invisible="state == 'draft'">
                        <field name="amount_used"/>
                        <field name="amount_remaining"/>
                    </group>
                    <notebook>
                        <page string="รายการใช้เงิน" name="usage_lines">
                            <field name="usage_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="เอกสารแนบ" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_advance_payment_agreement_search" model="ir.ui.view">
        <field name="name">advance.payment.agreement.search</field>
        <field name="model">advance.payment.agreement</field>
        <field name="arch" type="xml">
            <search string="สัญญายืมเงิน">
                <field name="name"/>
                <field name="borrower_name"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="In Review" name="in_review" domain="[('state','=','in_review')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Loan Type" name="group_loan_type" context="{'group_by':'loan_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_advance_payment_agreement" model="ir.actions.act_window">
        <field name="name">สัญญายืมเงิน</field>
        <field name="res_model">advance.payment.agreement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
