<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_payment_usage_line_list" model="ir.ui.view">
        <field name="name">advance.payment.usage.line.list</field>
        <field name="model">advance.payment.usage.line</field>
        <field name="arch" type="xml">
            <tree string="รายการบันทึกการใช้เงินยืม">
                <field name="agreement_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_advance_payment_usage_line_form" model="ir.ui.view">
        <field name="name">advance.payment.usage.line.form</field>
        <field name="model">advance.payment.usage.line</field>
        <field name="arch" type="xml">
            <form string="รายการบันทึกการใช้เงินยืม">
                <sheet>
                    <group>
                        <field name="agreement_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                    <group name="attachments" string="เอกสารแนบ">
                        <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advance_payment_usage_line" model="ir.actions.act_window">
        <field name="name">รายการบันทึกการใช้เงินยืม</field>
        <field name="res_model">advance.payment.usage.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
