<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_advance_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})"/>

                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        p, span, div, td, th { font-size: 16pt; line-height: 1.3; }
                        .label-col { width: 35%; font-weight: bold; }
                        .signature-box { border-top: 1px solid #000; width: 180px; text-align: center; padding-top: 4px; }
                    </style>

                    <div class="page">
                        <!-- Logo -->
                        <div style="position: absolute; top: 0; left: 0;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 100px;" alt="Logo"/>
                        </div>

                        <div class="mt-5 pt-3 text-center">
                            <h3 class="fw-bolder">สัญญาการยืมเงิน</h3>
                            <div t-field="o.company_id.name"/>
                        </div>

                        <div class="my-4"/>

                        <!-- Document Info -->
                        <table class="table table-borderless table-sm">
                            <tbody>
                                <tr>
                                    <td class="label-col">เลขที่</td>
                                    <td><span t-out="o.name"/></td>
                                    <td class="label-col">ประเภทการยืม</td>
                                    <td><span t-field="o.type_id"/></td>
                                </tr>
                                <tr>
                                    <td class="label-col">พนักงาน</td>
                                    <td><span t-out="o.employee_name or o.employee_id.name"/></td>
                                    <td class="label-col">ฝ่าย/แผนก</td>
                                    <td><span t-out="o.department_name or o.department_id.name"/></td>
                                </tr>
                                <tr t-if="o.partner_bank_id">
                                    <td class="label-col">ธนาคาร</td>
                                    <td><span t-out="o.partner_bank_id.bank_id.name"/></td>
                                    <td class="label-col">เลขที่บัญชี</td>
                                    <td><span t-out="o.partner_bank_id.acc_number"/></td>
                                </tr>
                                <tr>
                                    <td class="label-col">จำนวนเงินที่ยืม</td>
                                    <td>
                                        <span t-out="'{:,.2f}'.format(o.amount)"/>
                                        <span class="ms-1" t-field="o.currency_id"/>
                                    </td>
                                    <td class="label-col">กำหนดคืนเงิน (วัน)</td>
                                    <td><span t-out="o.return_day"/></td>
                                </tr>
                                <tr t-if="o.reason">
                                    <td class="label-col">สาเหตุในการยืมเงิน</td>
                                    <td colspan="3"><span t-field="o.reason"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Loan Term -->
                        <t t-if="o.loan_term">
                            <div class="mt-3">
                                <strong>เงื่อนไขการยืมเงิน</strong>
                                <div class="border p-2 mt-1" t-out="o.loan_term"/>
                            </div>
                        </t>

                        <!-- Return Summary (if any returns) -->
                        <t t-if="o.return_ids">
                            <div class="mt-4">
                                <strong>รายการคืนเงิน</strong>
                                <table class="table table-bordered table-sm mt-2">
                                    <thead>
                                        <tr>
                                            <th class="text-center">วันที่คืน</th>
                                            <th class="text-center">ประเภท</th>
                                            <th class="text-end">จำนวนเงิน</th>
                                            <th class="text-center">สถานะ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.return_ids" t-as="r">
                                            <tr>
                                                <td class="text-center"><span t-field="r.date_return" t-options='{"widget": "date"}'/></td>
                                                <td class="text-center"><span t-field="r.return_type"/></td>
                                                <td class="text-end"><span t-out="'{:,.2f}'.format(r.amount)"/></td>
                                                <td class="text-center"><span t-field="r.state"/></td>
                                            </tr>
                                        </t>
                                        <tr class="fw-bold">
                                            <td colspan="2" class="text-end">รวมคืนแล้ว</td>
                                            <td class="text-end"><span t-out="'{:,.2f}'.format(o.amount_return)"/></td>
                                            <td/>
                                        </tr>
                                        <tr class="fw-bold">
                                            <td colspan="2" class="text-end">คงค้าง</td>
                                            <td class="text-end"><span t-out="'{:,.2f}'.format(o.amount_residual)"/></td>
                                            <td/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>

                        <!-- Signature Section -->
                        <div class="mt-5 row">
                            <div class="col text-center">
                                <div class="mb-5">ลงชื่อ .............................................</div>
                                <div class="signature-box mx-auto">ผู้ยืมเงิน</div>
                                <div class="mt-1">(<span t-out="o.employee_name or o.employee_id.name"/>)</div>
                                <div class="mt-1">วันที่ ........................................</div>
                            </div>
                            <div class="col text-center">
                                <div class="mb-5">ลงชื่อ .............................................</div>
                                <div class="signature-box mx-auto">ผู้อนุมัติ</div>
                                <div class="mt-1">( ............................................. )</div>
                                <div class="mt-1">วันที่ ........................................</div>
                            </div>
                            <div class="col text-center">
                                <div class="mb-5">ลงชื่อ .............................................</div>
                                <div class="signature-box mx-auto">เจ้าหน้าที่การเงิน</div>
                                <div class="mt-1">( ............................................. )</div>
                                <div class="mt-1">วันที่ ........................................</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
