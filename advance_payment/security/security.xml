<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_advance_payment" model="ir.module.category">
        <field name="name">Advance Payment</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_advance_payment_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_advance_payment"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_advance_payment_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_advance_payment"/>
        <field name="implied_ids" eval="[(4, ref('group_advance_payment_user'))]"/>
    </record>

    <record id="group_advance_payment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_advance_payment"/>
        <field name="implied_ids" eval="[(4, ref('group_advance_payment_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_advance_payment_responsible" model="res.groups">
        <field name="name">ผู้รับผิดชอบเงินยืม</field>
        <field name="category_id" ref="module_category_advance_payment"/>
    </record>

    <!-- Record Rules -->
    <record id="advance_payment_user_rule" model="ir.rule">
        <field name="name">Advance Payment: User sees own records</field>
        <field name="model_id" ref="model_advance_payment"/>
        <field name="groups" eval="[(4, ref('group_advance_payment_user'))]"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
    </record>

    <record id="advance_payment_officer_rule" model="ir.rule">
        <field name="name">Advance Payment: Officer sees all</field>
        <field name="model_id" ref="model_advance_payment"/>
        <field name="groups" eval="[(4, ref('group_advance_payment_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="advance_payment_manager_rule" model="ir.rule">
        <field name="name">Advance Payment: Manager sees all</field>
        <field name="model_id" ref="model_advance_payment"/>
        <field name="groups" eval="[(4, ref('group_advance_payment_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
