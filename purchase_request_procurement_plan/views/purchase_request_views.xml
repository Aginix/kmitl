<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View purchase.request form - the requester names the plan it is bought
         under (จัดซื้อภายใต้, root ADR-0011) + link back to it -->
    <record id="view_purchase_request_form_procurement_plan" model="ir.ui.view">
        <field name="name">view.purchase.request.form (Procurement Plan)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_budget.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_selection_mode']" position="after">
                <field name="procurement_plan_domain" invisible="1" />
                <field
                    name="procurement_plan_id"
                    domain="procurement_plan_domain"
                    options="{'no_create': True, 'no_open': True}"
                    attrs="{'invisible': [('budget_selection_mode', '!=', 'procurement_plan')], 'required': [('budget_selection_mode', '=', 'procurement_plan'), ('is_procurement_under_editable', '=', True)], 'readonly': [('is_procurement_under_editable', '=', False)]}"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_procurement_plan"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    attrs="{'invisible': [('procurement_plan_id', '=', False)]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Procurement Plan</span>
                    </div>
                </button>
            </xpath>
            <!-- No view domain on budget_account_id: the form binds it to
                 budget_account_domain, which already carries this module's
                 procurement_plan = False through _domain_budget_account_id. -->
        </field>
    </record>

</odoo>
