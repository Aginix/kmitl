#. module: purchase_request_vat_manual
#: model_terms:ir.ui.view,arch_db:purchase_request_vat_manual.purchase_request_vat_wizard_view_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                    <strong>Please note:</strong>\n"
"                    changing the VAT from the system-calculated amount is the\n"
"                    responsibility of the person making the change.\n"
"                    Kindly verify the new amount against the supporting documents\n"
"                    before confirming."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                    <strong>โปรดทราบ:</strong>\n"
"                    การแก้ไขภาษีมูลค่าเพิ่มให้ต่างจากที่ระบบคำนวณ ถือเป็นความรับผิดชอบของผู้แก้ไข\n"
"                    กรุณาตรวจสอบจำนวนเงินใหม่กับเอกสารประกอบให้ถูกต้องก่อนยืนยัน"

