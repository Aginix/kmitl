<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_kmitl_project_strategic_plan"
        inherit_id="kmitl_project.report_kmitl_project"
    >
        <xpath expr="//div[@id='kmitl']/div[hasclass('item-content')]" position="inside">
            <div>แผนบริหารสถาบัน : <span
                    t-out="o.institute_admin_plan_id.name or '-'"
                /></div>
            <div>ข้อตกลงการปฏิบัติงาน : <span
                    t-out="o.performance_agreement_id.name or '-'"
                /></div>
            <div>แผนกลยุทธ์/แผนบริหารส่วนงาน : <span
                    t-out="o.department_plan or '-'"
                /></div>
        </xpath>
    </template>
</odoo>
