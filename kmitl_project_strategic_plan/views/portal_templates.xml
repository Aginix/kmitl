<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="kmitl_project_portal_content_strategic_plan"
        inherit_id="kmitl_project.kmitl_project_portal_content"
    >
        <xpath expr="//dl[@id='strategic-plan']" position="inside">
            <dt class="col-sm-5">แผนบริหารสถาบัน</dt>
            <dd
                class="col-sm-7"
                t-out="kmitl_project.institute_admin_plan_id.name or '—'"
            />
            <dt class="col-sm-5">ข้อตกลงการปฏิบัติงาน</dt>
            <dd
                class="col-sm-7"
                t-out="kmitl_project.performance_agreement_id.name or '—'"
            />
            <dt class="col-sm-5">แผนกลยุทธ์/แผนบริหารส่วนงาน</dt>
            <dd class="col-sm-7" t-out="kmitl_project.department_plan or '—'" />
        </xpath>
    </template>
</odoo>
