<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="purchase_request_approval_own_viewer_rule" model="ir.rule">
        <field name="name">Purchase Request Approval: Own Viewer</field>
        <field name="model_id" ref="purchase_request_approval.model_purchase_request_approval" />
        <field name="groups" eval="[(4, ref('group_purchase_request_approval_own_viewer'))]" />
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="purchase_request_approval_line_own_viewer_rule" model="ir.rule">
        <field name="name">Purchase Request Approval Line: Own Viewer</field>
        <field name="model_id" ref="purchase_request_approval.model_purchase_request_approval_line" />
        <field name="groups" eval="[(4, ref('group_purchase_request_approval_own_viewer'))]" />
        <field name="domain_force">[('approval_id.requested_by', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

</odoo>
