<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="group_purchase_request_approval_own_viewer" model="res.groups">
        <field name="name">Purchase Request Approval: Own Viewer</field>
        <field name="comment">Read-only access to purchase.request.approval where the current user is the requester (requested_by).</field>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_approval_own_viewer'))]" />
    </record>

</odoo>
