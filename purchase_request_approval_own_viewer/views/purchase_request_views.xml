<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_purchase_request_form_own_viewer" model="ir.ui.view">
        <field name="name">view.purchase.request.form (own viewer)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_request_approval']" position="attributes">
                <attribute name="groups">purchase.group_purchase_user,purchase_request_approval_own_viewer.group_purchase_request_approval_own_viewer</attribute>
            </xpath>
        </field>
    </record>

</odoo>
