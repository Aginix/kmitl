<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- ส่งคืนผู้จัดทำ marker: linked by the send-back and cleared on the next
         state change, never evaluated (see SENT_BACK_RULE). -->
    <record id="excep_disbursement_sent_back" model="exception.rule">
        <field name="name">ส่งคืนผู้จัดทำ</field>
        <field
            name="description"
        >หมวดตรวจส่งคืนใบขอเบิกให้ผู้จัดทำแก้ไขแล้วส่งใหม่ ดูเหตุผลในประวัติของใบขอเบิก</field>
        <field name="sequence">80</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code"># set by the send-back, never evaluated
failed = False</field>
        <field name="is_blocking" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
