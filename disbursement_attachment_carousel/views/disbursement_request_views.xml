<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form_attachment_carousel" model="ir.ui.view">
        <field name="name">disbursement.request.form.attachment.carousel</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <!-- Swap the default many2many_binary chips for the clickable
                 carousel widget so any file opens the in-app viewer. -->
            <xpath expr="//group[@name='attachment']/field[@name='attachment_ids']" position="attributes">
                <attribute name="widget">attachment_carousel</attribute>
            </xpath>
        </field>
    </record>
</odoo>
