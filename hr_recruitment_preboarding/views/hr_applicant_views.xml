<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_view_form_preboarding" model="ir.ui.view">
        <field name="name">hr.applicant.form.preboarding</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_preboarding"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                >
                    <field name="preboarding_count" widget="statinfo" string="รายงานตัว"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
