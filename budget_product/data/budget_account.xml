<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <function model="budget.account" name="write">
            <value
                model="budget.account"
                eval="obj().search([('budget_type', '=', 'expense'), ('code', 'not in', ['51000', '51100', '5101010000', '51200', '5101020000', '5101030100', '5101030200', '5101040100', '5101040200', '5101050100', '52000', '5230000000', '52400', '5104010200', '5102010000', '5413000000', '5414000000', '5415000000', '5416000000', '07020','0702000000','0702000001', '0702000002', '5102020000', '5103010000', '5103020000', '5104010000', '5104020000', '5104030100', '5107010000', '5107010200', '5107010400', '5107010500', '5107010600', '5107010700', '5108000000', '5109000000', '5111000100', '52301', '52500', '52600', '53000', '53100', '54000', '54100', '5411000000', '5412000000', '55000', '55100'])]).ids"
            />
            <value eval="{'purchase_ok': True}" />
