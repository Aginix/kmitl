<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <function model="budget.account" name="write">
            <value
                model="budget.account"
                eval="obj().search([('budget_type', '=', 'expense'), ('root_id', 'in', [ref('budget.budget_account_52000'), ref('budget.budget_account_53000'), ref('budget.budget_account_54000'), ref('budget.budget_account_55000')])]).ids"
            />
            <value eval="{'purchase_ok': True}" />
        </function>

        <function model="budget.account" name="action_create_product">
            <function
                eval="[[('purchase_ok', '=', True)]]"
                model="budget.account"
                name="search"
            />
        </function>
    </data>
</odoo>
