<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Completion notice type (owned by the bridge, not core). When a หนังสือ
          reaches เสร็จสิ้น, agx_sarabun core is Todo-agnostic and has already
          cleared every routing Todo — so nobody tells the owner of the เรื่อง
          their letter is done. The bridge schedules ONE acknowledgement Todo of
          this type for that creator (sarabun.document._complete_document override),
          so the outcome lands in their unified inbox and clears by Mark as Read.

          todo_category is a mail_activity_todo field, so only this bridge — never
          core — may set it; acknowledgement = read-only, cleared by Mark as Read.
        -->
        <record id="mail_activity_sarabun_completed" model="mail.activity.type">
            <field name="name">Sarabun: เสร็จสิ้น (Completed)</field>
            <field name="icon">fa-check-circle</field>
            <field name="res_model">sarabun.document</field>
            <field name="category">default</field>
            <field name="todo_category">acknowledgement</field>
        </record>
    </data>
</odoo>
