<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="group_kmitl_project_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field
                name="category_id"
                ref="kmitl_project.module_category_kmitl_project"
            />
        </record>

        <record id="kmitl_project.group_kmitl_project_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_kmitl_project_viewer'))]" />
        </record>

        <!-- Read-only (1=1) rules: group rules are OR'ed per operation, so a
             viewer who is also an Own-Projects user reads every project and its
             lines but still writes only their own. -->
        <record id="kmitl_project_viewer_rule" model="ir.rule">
            <field name="name">KMITL Project: Viewer Read</field>
            <field name="model_id" ref="kmitl_project.model_kmitl_project" />
            <field name="groups" eval="[(4, ref('group_kmitl_project_viewer'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="project_plan_viewer_rule" model="ir.rule">
            <field name="name">Project Plan: Viewer Read</field>
            <field name="model_id" ref="kmitl_project.model_project_plan" />
