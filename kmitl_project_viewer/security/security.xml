            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="project_output_viewer_rule" model="ir.rule">
            <field name="name">Project Output: Viewer Read</field>
            <field name="model_id" ref="kmitl_project.model_project_output" />
            <field name="groups" eval="[(4, ref('group_kmitl_project_viewer'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="project_expected_outcome_viewer_rule" model="ir.rule">
