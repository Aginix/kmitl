            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="project_target_viewer_rule" model="ir.rule">
            <field name="name">Project Target: Viewer Read</field>
            <field name="model_id" ref="kmitl_project.model_project_target" />
