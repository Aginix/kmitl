            <field name="perm_unlink" eval="False" />
        </record>

        <record id="project_output_viewer_read_rule" model="ir.rule">
            <field name="name">Project Output: Viewer Read All</field>
            <field name="model_id" ref="kmitl_project.model_project_output" />
