<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Own Projects < Viewer < Officer < Manager -->
        <record id="group_kmitl_project_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field
                name="category_id"
                ref="kmitl_project.module_category_kmitl_project"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('kmitl_project.group_kmitl_project_user'))]"
            />
        </record>

        <record id="kmitl_project.group_kmitl_project_user_all" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_kmitl_project_viewer'))]" />
        </record>

        <!-- Read every project; write stays limited to own projects via the implied Own Projects rules -->
        <record id="kmitl_project_viewer_read_rule" model="ir.rule">
            <field name="name">KMITL Project Viewer: Read All</field>
            <field name="model_id" ref="kmitl_project.model_kmitl_project" />
            <field name="groups" eval="[(4, ref('group_kmitl_project_viewer'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="project_plan_viewer_read_rule" model="ir.rule">
            <field name="name">Project Plan: Viewer Read All</field>
