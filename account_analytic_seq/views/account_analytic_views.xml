<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View account.analytic form -->
    <record id="view_account_analytic_account_line_seq_form_inherit" model="ir.ui.view">
        <field
            name="name"
        >view.account.analytic.account.line_seq.form.inherit.form</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="line_seq" />
            </xpath>
        </field>
    </record>

  </odoo>
