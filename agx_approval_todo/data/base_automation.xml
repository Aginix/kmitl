<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: ให้แอดมินเปิด/ปิดกฎได้โดยไม่ถูก upgrade รีเซ็ต. ตรรกะจริง
         อยู่ใน Python (โมเดล approval.request) ไม่ได้อยู่ใน string นี้. -->
    <data noupdate="1">

        <!-- เข้าสถานะ to_verify → แจ้ง Todo ให้เจ้าหน้าที่จองงบประมาณ.
             filter_pre (ก่อนเขียน) = ยังไม่ใช่ to_verify, filter_domain
             (หลังเขียน) = เป็น to_verify → ยิงเฉพาะ "ตอนเปลี่ยนเข้า" to_verify. -->
        <record id="automation_notify_reserve_budget" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: แจ้งเจ้าหน้าที่จองงบประมาณเมื่อเข้าสถานะรอตรวจสอบ/จองงบประมาณ</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '!=', 'to_verify')]</field>
            <field name="filter_domain">[('state', '=', 'to_verify')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state')])]"
            />
            <field name="state">code</field>
            <field name="code">records._notify_reserve_budget_todo()</field>
        </record>

        <!-- ออกจากสถานะ to_verify (จองแล้ว → to_send, ดึงกลับ → draft,
             ยกเลิก → rejected ฯลฯ) → ล้าง Todo จองงบประมาณ. -->
        <record id="automation_clear_reserve_budget" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: ล้าง Todo จองงบประมาณเมื่อออกจากสถานะรอตรวจสอบ/จองงบประมาณ</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '=', 'to_verify')]</field>
            <field name="filter_domain">[('state', '!=', 'to_verify')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state')])]"
            />
            <field name="state">code</field>
            <field name="code">records._clear_reserve_budget_todo()</field>
        </record>

    </data>
</odoo>
