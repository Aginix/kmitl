<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_all_ou_advance_payment" model="res.groups">
        <field name="name">Access all OUs' advance payment</field>
        <field name="category_id" ref="operating_unit.module_operating_units"/>
    </record>

    <function model="ir.rule" name="write">
        <value
            eval="[ref('advance_payment_operating_unit.ir_rule_advance_payment_allowed_operating_units'),
                   ref('advance_payment_operating_unit.ir_rule_advance_payment_usage_line_allowed_operating_units'),
                   ref('advance_payment_operating_unit.ir_rule_advance_payment_return_line_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|',(1, '=', 1) if user.has_group('advance_payment_operating_unit_access_all.group_all_ou_advance_payment') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>
</odoo>
