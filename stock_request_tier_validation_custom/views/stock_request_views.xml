<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View stock.request form -->
    <record id="view_stock_request_form" model="ir.ui.view">
        <field name="name">view.stock.request.form</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request_aginix.view_stock_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_approved']" position="attributes">
              <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'submitted'), ('validation_status', '!=', 'validated')]}</attribute>
            </xpath>
        </field>
    </record>

  </odoo>