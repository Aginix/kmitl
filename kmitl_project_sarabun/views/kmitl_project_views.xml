<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmitl_project_form_sarabun" model="ir.ui.view">
        <field name="name">view.kmitl.project.form.sarabun</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_form" />
        <field name="arch" type="xml">
            <!-- Smart button: linked หนังสือ. The count/live fields it (and the
                 buttons/alerts below) rely on are declared after //header so they
                 sit OUTSIDE the group-restricted button_box (base.group_user) —
                 otherwise a field used in an ungrouped attrs is "restricted". -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_sarabun_documents"
                    class="oe_stat_button" icon="fa-file-text-o"
                    attrs="{'invisible': [('sarabun_document_count', '=', 0)]}"
                    string="หนังสือ" />
            </xpath>

            <!-- "สร้างหนังสือ" sits alongside the manager-only "อนุมัติ" fallback at
                 to_send when no live หนังสือ. -->
            <xpath expr="//button[@name='action_reserve_budget']" position="after">
                <button name="action_submit_to_sarabun" string="สร้างหนังสือ"
                    type="object" class="oe_highlight"
                    attrs="{'invisible': ['|', ('state', '!=', 'to_send'), ('sarabun_has_live_document', '=', True)]}" />
            </xpath>

            <!-- Manager may approve directly at to_send, bypassing the หนังสือ; hidden at
                 sent while a document is circulating. -->
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', '!=', 'to_send')]}</attribute>
            </xpath>

            <!-- Ungrouped field declarations + Sarabun status notice, between the
                 statusbar and the sheet. -->
            <xpath expr="//header" position="after">
                <field name="sarabun_document_count" invisible="1"/>
                <field name="sarabun_has_live_document" invisible="1"/>
                <field name="sarabun_is_draft" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1"/>
                    หนังสือถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                    <button name="action_view_sarabun_documents" type="object"
                            class="btn btn-sm btn-warning ms-2" string="เปิดหนังสือเพื่อส่ง"/>
                </div>
                <div class="alert alert-info mb-2" role="alert"
                     attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1"/>
                    สถานะการเดินหนังสือ: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_kmitl_project_tree_sarabun" model="ir.ui.view">
        <field name="name">view.kmitl.project.tree.sarabun</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="active_sarabun_document_id" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
