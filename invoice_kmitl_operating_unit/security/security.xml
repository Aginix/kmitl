<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_rule_invoice_kmitl_operating_units" model="ir.rule">
        <field name="model_id" ref="invoice_kmitl.model_kmitl_invoice"/>
        <field name="domain_force">['|',('operating_unit_id','=',False),('operating_unit_id','in',user.operating_unit_ids.ids)]</field>
        <field name="name">Invoice Operating Unit</field>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="ir_rule_invoice_submission_operating_units" model="ir.rule">
        <field name="model_id" ref="invoice_kmitl.model_kmitl_invoice_submission"/>
        <field name="domain_force">['|',('operating_unit_id','=',False),('operating_unit_id','in',user.operating_unit_ids.ids)]</field>
        <field name="name">Invoice Submission Operating Unit</field>
        <field name="global" eval="True"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
