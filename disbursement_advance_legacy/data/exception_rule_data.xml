<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Same as excep_disbursement_advance_internal_payee, whose code only
         names advance/prepaid. -->
    <record id="excep_disbursement_advance_legacy_internal_payee" model="exception.rule">
        <field name="name">เงินยืม (ระบบเก่า) ต้องจ่ายให้บุคลากรภายใน</field>
        <field name="description">ประเภทการจ่ายเงินเป็นเงินยืม (ระบบเก่า) กรุณาเลือกประเภทผู้รับเงินเป็นบุคลากรภายใน</field>
        <field name="sequence">12</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.payment_type == "advance_legacy" and not self.partner_type_id.is_internal:
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>
</odoo>
