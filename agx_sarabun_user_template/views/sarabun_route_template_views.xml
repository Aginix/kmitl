<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the core template form to surface owner + visibility fields. -->
    <record id="view_sarabun_route_template_form_inherit_user_template" model="ir.ui.view">
        <field name="name">sarabun.route.template.form.user_template</field>
        <field name="model">sarabun.route.template</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_route_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='sequence']]" position="inside">
                <field name="owner_id" readonly="1"/>
                <field name="visibility"/>
            </xpath>
            <!-- Require department_id when visibility=unit, so a "unit" template
                 can't silently become effectively-personal (matches nobody). -->
            <xpath expr="//group[field[@name='origin_model_id']]/field[@name='department_id']"
                   position="attributes">
                <attribute name="attrs">{'required': [('visibility','=','unit')]}</attribute>
            </xpath>
        </field>
    </record>

    <!-- User-facing "My Route Templates" — scoped by the read ir.rule;
         new records default to personal visibility so users don't accidentally
         publish templates they intend to keep private. -->
    <record id="action_sarabun_my_route_template" model="ir.actions.act_window">
        <field name="name">แม่แบบเส้นทางของฉัน (My Route Templates)</field>
        <field name="res_model">sarabun.route.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_visibility': 'personal'}</field>
    </record>

    <menuitem id="menu_sarabun_my_templates"
              name="แม่แบบเส้นทางของฉัน"
              parent="agx_sarabun.menu_sarabun_root"
              action="action_sarabun_my_route_template"
              groups="agx_sarabun.group_sarabun_user"
              sequence="15"/>
</odoo>
