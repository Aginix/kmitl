<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Override the core read rule (originally [(1,'=',1)]) with a
             visibility-aware domain. Users may read: any public template, any
             unit template (dept scoping now happens at the picker via the
             view-level domain on route_template_id, driven by the document's
             sender_department_id — not by the reading user's dept), and their
             own personal templates. -->
        <record id="agx_sarabun.sarabun_route_template_read_rule" model="ir.rule">
            <field name="domain_force">['|',
                ('visibility','in',['public','unit']),
                ('owner_id','=',user.id)]</field>
        </record>

        <!-- Managers bypass the user-group visibility rule — full access to all
             templates (read/write/create/unlink).  Required because group_sarabun_manager
             implies group_sarabun_user, so managers are subject to the user-group rules
             above; this manager rule ORs with them, restoring unconditional access. -->
        <record id="sarabun_route_template_manager_rule" model="ir.rule">
            <field name="name">Sarabun Route Template: Manager Full Access</field>
            <field name="model_id" ref="agx_sarabun.model_sarabun_route_template"/>
            <field name="groups" eval="[(4, ref('agx_sarabun.group_sarabun_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Users may write/create/unlink only their own templates (owner_id = user). -->
        <record id="sarabun_route_template_owner_write_rule" model="ir.rule">
            <field name="name">Sarabun Route Template: Owner Write</field>
            <field name="model_id" ref="agx_sarabun.model_sarabun_route_template"/>
            <field name="groups" eval="[(4, ref('agx_sarabun.group_sarabun_user'))]"/>
            <field name="domain_force">[('owner_id','=',user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Line model — read: scoped to readable templates (mirrors the
             template read rule above). -->
        <record id="sarabun_route_template_line_read_rule" model="ir.rule">
            <field name="name">Sarabun Route Template Line: User Read</field>
            <field name="model_id" ref="agx_sarabun.model_sarabun_route_template_line"/>
            <field name="groups" eval="[(4, ref('agx_sarabun.group_sarabun_user'))]"/>
            <field name="domain_force">['|',
                ('template_id.visibility','in',['public','unit']),
                ('template_id.owner_id','=',user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Line model — write/create/unlink: owner of the parent template only. -->
        <record id="sarabun_route_template_line_owner_write_rule" model="ir.rule">
            <field name="name">Sarabun Route Template Line: Owner Write</field>
            <field name="model_id" ref="agx_sarabun.model_sarabun_route_template_line"/>
            <field name="groups" eval="[(4, ref('agx_sarabun.group_sarabun_user'))]"/>
            <field name="domain_force">[('template_id.owner_id','=',user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Line model — manager full access (same rationale as template manager rule). -->
        <record id="sarabun_route_template_line_manager_rule" model="ir.rule">
            <field name="name">Sarabun Route Template Line: Manager Full Access</field>
            <field name="model_id" ref="agx_sarabun.model_sarabun_route_template_line"/>
            <field name="groups" eval="[(4, ref('agx_sarabun.group_sarabun_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>
    </data>
</odoo>
