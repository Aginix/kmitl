<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.two.submitted form -->
    <record id="view_purchase_request_two_submitted_form" model="ir.ui.view">
        <field name="name">view.purchase.request.two.submitted.form</field>
        <field name="model">purchase.request.two.submitted</field>
        <field name="inherit_id" ref="kmitl_purchase_request_2_new.view_purchase_request_two_submitted_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="validation_status" invisible="1"/>
                <field name="review_ids" invisible="1" />
            </xpath>

            <xpath expr="//button[@name='button_approved']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='button_rejected']" position="after">
                <field name="is_current_user_requester" invisible="1" />
                <field name="rejected" invisible="1" />
                <field name="validation_status" invisible="1" />
                <field name="need_validation" invisible="1" />
                <button name="request_validation" string="Request Validation" attrs="{'invisible': ['|', '|', '|',
        ('need_validation', '!=', True),
        ('validation_status', '=', 'pending'),
        ('rejected', '=', True),
        ('is_current_user_requester', '=', False)
    ]}" type="object" />
            </xpath>
        </field>
    </record>

</odoo>
