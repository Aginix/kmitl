<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View agreement form -->
    <record id="view_agreement_form" model="ir.ui.view">
        <field name="name">view.agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_open_new_version_wizard']" position="after">
                <field name="wa_invoice_plan_equal" invisible="1" />
                <field name="invoice_plan_count" invisible="1"  />
                <button name="%(purchase_work_acceptance_invoice_plan.action_view_wa_installment)d" attrs="{'invisible': [('wa_invoice_plan_equal', '=', True)]}" string="Create WA by Installment" type="action" class="oe_highlight" context="{'default_order_id': purchase_order_id, 'default_agreement_id': active_id}" />
            </xpath>

            <xpath expr="//button[@name='action_open_new_version_wizard']" position='after'>
                <button name="action_create_wa_from_agreement"
                    type="object"
                    string="Create WA"
                    class="oe_highlight"
                    attrs="{'invisible': [('wa_invoice_plan_equal', '=', False)]}"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_work_acceptances" type="object" class="oe_stat_button" icon="fa-clipboard" attrs="{'invisible': [('wa_count', '=', 0)]}">
                    <field name="wa_count" widget="statinfo" string="Work Acceptances"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- <record id="view_agreement_tree" model="ir.ui.view">
