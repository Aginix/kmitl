<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.invoice.plan form -->
    <record id="view_purchase_invoice_plan_form" model="ir.ui.view">
        <field name="name">view.purchase.invoice.plan.form</field>
        <field name="model">purchase.invoice.plan</field>
        <field name="inherit_id" ref="purchase_invoice_plan.view_purchase_invoice_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_date']" position="after">
              <field name="wa_id" string="Work Acceptance"/>
              <field name="wa_state" string="WA Status"/>
            </xpath>
        </field>
    </record>

  </odoo>