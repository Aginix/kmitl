<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View work.accepted.date.wizard form -->
    <record id="view_work_accepted_date_wizard_form" model="ir.ui.view">
        <field name="name">view.work.accepted.date.wizard.form</field>
        <field name="model">work.accepted.date.wizard</field>
        <field name="inherit_id" ref="purchase_work_acceptance.view_work_accepted_date_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Attachments">
                    <field name="document_ids">
                        <tree editable="bottom">
                            <field name="file" filename="file_name"/>
                            <field name="file_name"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

  </odoo>