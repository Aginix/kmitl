<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_category_view_form_archive" model="ir.ui.view">
        <field name="name">approval.category.view.form.archive</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="agx_approval.approval_category_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                    attrs="{'invisible': [('active', '=', True)]}" />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="active" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="approval_category_view_search_archive" model="ir.ui.view">
        <field name="name">approval.category.view.search.archive</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="agx_approval.approval_category_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search/group[@name='group_by']" position="before">
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
            </xpath>
        </field>
    </record>

</odoo>
