<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Printing the ใบขอเบิกเงิน is granted to selected users only.
         No category: an independent tick on top of whatever disbursement level
         the user holds. -->
    <record id="group_disbursement_printer" model="res.groups">
        <field name="name">Disbursement Printer</field>
        <field name="implied_ids" eval="[(4, ref('disbursement.group_disbursement_user'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    <!-- Read every disbursement request's หนังสือ, on its route or not, so the
         group can print it. Read-only; ORed with agx_sarabun's own rules. -->
    <record id="sarabun_document_disbursement_printer_rule" model="ir.rule">
        <field name="name">Sarabun Document: Disbursement Printer</field>
        <field name="model_id" ref="agx_sarabun.model_sarabun_document" />
        <field name="groups" eval="[(4, ref('group_disbursement_printer'))]" />
        <field name="domain_force">[('origin_model', '=', 'disbursement.request')]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
