<?xml version="1.0" encoding="utf-8" ?>
<!--
    OCA tracking_manager on kmitl.project: log the One2many lines (a line
    create/write/unlink is summarised on the project chatter) and the Many2many
    fields, which native Odoo 16 tracking silently skips. Child models are
    scoped to a curated field list so the note stays readable. noupdate so
    admins can re-tune from Settings > Technical > Models.
-->
<odoo noupdate="1">
    <record id="kmitl_project.model_kmitl_project" model="ir.model">
        <field name="active_custom_tracking" eval="True" />
    </record>
    <record
        id="kmitl_project.field_kmitl_project__methodology_ids"
        model="ir.model.fields"
    >
        <field name="custom_tracking" eval="True" />
