<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="ir_rule_purchase_request_approval_allowed_operating_units" model="ir.rule">
        <field name="name">PA from allowed operating units</field>
        <field name="model_id" ref="purchase_request_approval.model_purchase_request_approval"/>
        <field name="domain_force">
            ['|','|',(1,'=',1) if user.has_group('purchase_request.group_purchase_request_manager') else (0,'=',1),('operating_unit_id','in', user.operating_unit_ids.ids),('requesting_operating_unit_id','in', user.operating_unit_ids.ids)]
        </field>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="global" eval="True"/>
    </record>

</odoo>