<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form_sarabun" model="ir.ui.view">
        <field name="name">approval.request.form.sarabun</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form" />
        <field name="arch" type="xml">
            <!-- Add button_box before oe_title -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sarabun_document_count" invisible="1" />
                <field name="sarabun_has_live_document" invisible="1" />
                <button type="object" name="action_view_sarabun_documents" class="oe_stat_button" icon="fa-file-text-o" attrs="{'invisible': [('sarabun_document_count', '=', 0)]}" string="หนังสือ" />
            </xpath>

            <!-- Add Submit to Sarabun button after To Verify button -->
            <xpath expr="//button[@name='action_to_verify']" position="after">
                <button name="action_submit_to_sarabun" string="สร้างเอกสาร" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'submitted'), ('sarabun_has_live_document', '=', True)]}" />
            </xpath>

            <!-- Sarabun routing replaces direct approval. Hide the manual
                 Approve button to avoid double-approval paths. -->
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="approval_request_view_tree_sarabun" model="ir.ui.view">
        <field name="name">approval.request.tree.sarabun</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="active_sarabun_document_id" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
