<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form_sarabun" model="ir.ui.view">
        <field name="name">approval.request.form.sarabun</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form" />
        <field name="arch" type="xml">
            <!-- Add button_box before oe_title -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sarabun_document_count" invisible="1" />
                <field name="sarabun_has_live_document" invisible="1" />
                <button type="object" name="action_view_sarabun_documents" class="oe_stat_button" icon="fa-file-text-o" attrs="{'invisible': [('sarabun_document_count', '=', 0)]}" string="Documents" />
            </xpath>

            <!-- Add Submit to Sarabun button after To Verify button -->
            <xpath expr="//button[@name='action_to_verify']" position="after">
                <button name="action_submit_to_sarabun" string="Create Document" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'to_send'), ('sarabun_has_live_document', '=', True)]}" />
            </xpath>

            <!-- Sarabun status notification — rendered between the statusbar
                 and the sheet (out of the form body). -->
            <xpath expr="//header" position="after">
                <field name="sarabun_is_draft" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1"/>
                    Sarabun document has been created but not yet sent (Status: Draft)
                    <button name="action_view_sarabun_documents" type="object"
                            class="btn btn-sm btn-warning ms-2" string="Open Document to Send"/>
                </div>
                <div class="alert alert-info mb-2" role="alert"
                     attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1"/>
                    Sarabun routing status: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="approval_request_view_tree_sarabun" model="ir.ui.view">
        <field name="name">approval.request.tree.sarabun</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="active_sarabun_document_id" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
