<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Request Portal Home Entry -->
    <template id="portal_my_home_approval_request" name="Portal My Home: Approval Request" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Approval Requests</t>
                <t t-set="url" t-value="'/my/approval_requests'"/>
                <t t-set="placeholder_count" t-value="'approval_request_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Approval Request List View -->
    <template id="portal_my_approval_requests" name="My Approval Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Approval Requests</t>
            </t>

            <t t-if="not approval_requests">
                <div class="alert alert-warning mt-3" role="alert">
                    There are no approval requests.
                </div>
            </t>
            <t t-if="approval_requests" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Date</th>
                        <th>Department</th>
                        <th>Category</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="approval_requests" t-as="req">
                        <tr>
                            <td>
                                <a t-att-href="req.get_portal_url()">
                                    <t t-esc="req.name"/>
                                </a>
                            </td>
                            <td>
                                <span t-field="req.date"/>
                            </td>
                            <td>
                                <span t-field="req.department_analytic_id"/>
                            </td>
                            <td>
                                <span t-field="req.category_id"/>
                            </td>
                            <td>
                                <span t-field="req.state" class="badge badge-pill"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Approval Request Detail Page with iframe -->
    <template id="portal_approval_request_page" name="Portal Approval Request Page" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/web#model=approval.request&amp;id=%s&amp;action=&amp;view_type=form' % (approval_request.id)"/>
                </t>
            </t>

            <div class="row mt16 o_portal_approval_request_sidebar">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>
                    <t t-set="title">
                        <h2 class="mb-0">
                            <b t-field="approval_request.name"/>
                        </h2>
                    </t>

                    <t t-set="entries">
                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">
                            <li class="list-group-item flex-grow-1">
                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 me-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_download_btn" t-att-href="approval_request.get_portal_url(report_type='pdf', download=True)" title="Download">
                                            <i class="fa fa-download"/> Download
                                        </a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_print_btn o_portal_approval_request_print" t-att-href="approval_request.get_portal_url(report_type='pdf')" id="print_approval_request_report" title="Print" target="_blank">
                                            <i class="fa fa-print"/> Print
                                        </a>
                                    </div>
                                </div>
                            </li>
                            <li t-if="approval_request.owner_id" class="list-group-item flex-grow-1">
                                <div class="small mb-1">
                                    <strong class="text-muted">
                                        Request Owner
                                    </strong>
                                </div>
                                <div class="row">
                                    <div class="col flex-grow-0 pe-2">
                                        <img class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(approval_request.owner_id.avatar_128)" alt="Contact"/>
                                    </div>
                                    <div class="col ps-0">
                                        <span t-field="approval_request.owner_id" t-options='{"widget": "contact", "fields": ["name", "phone"], "no_marker": True}'/>
                                        <a href="#discussion" class="small">
                                            <i class="fa fa-fw fa-comments"/>
                                            <b>Send message</b>
                                        </a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </t>
                </t>
                <div id="portal_approval_request_content" class="col-12 col-lg">

                    <div class="o_portal_html_view shadow p-3">
                        <div class="o_portal_html_loader text-center">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>
                        </div>
                        <iframe id="approval_request_html" class="mt8 mb8" width="100%" height="100%" frameborder="0" scrolling="no" t-att-src="approval_request.get_portal_url(report_type='html')"/>
                    </div>
                    <!-- chatter -->
                    <div id="approval_request_communication" class="mt-4">
                        <h2>History</h2>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
