<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ADR-0007: append sarabun's เกษียน trail + signature block at the tail of the
         approval report (the origin embeds sarabun's block). Resolved from the origin
         via active_sarabun_document_id; renders nothing until steps complete.
         Targets the rendered report template, which lives in agx_approval (the report
         was moved there — see agx_approval commit #785); this file is registered,
         unlike the orphaned reports/report_approval_request.xml. -->
    <template id="report_approval_request_sarabun_endorsement"
              inherit_id="agx_approval.report_approval_request_document" priority="99">
        <xpath expr="//div[@class='page']" position="inside">
            <t t-call="agx_sarabun.sarabun_endorsement_block">
                <t t-set="doc" t-value="o.active_sarabun_document_id"/>
            </t>
        </xpath>
    </template>
</odoo>
