<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.budget View Tree -->
    <record id="view_project_budget_tree" model="ir.ui.view">
        <field name="name">view.project.budget.tree</field>
        <field name="model">project.budget</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="price_per_unit"/>
                <field name="unit_name"/>
                <field name="unit_multipier"/>
            </tree>
        </field>
    </record>

    <!-- View project.budget form -->
    <record id="view_project_budget_form" model="ir.ui.view">
        <field name="name">view.project.budget.form</field>
        <field name="model">project.budget</field>
        <field name="arch" type="xml">
            <form string="Project Budget">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="price_per_unit"/>
                            <field name="unit_name"/>
                            <field name="unit_multipier"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View project.budget search -->
    <record id="view_project_budget_search" model="ir.ui.view">
        <field name="name">view.project.budget.search</field>
        <field name="model">project.budget</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.budget -->
    <record id="action_project_budget" model="ir.actions.act_window">
        <field name="name">Project Budget</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.budget</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Budget.
            </p>
        </field>
    </record>

    <menuitem id="project_budget_config_menu" name="แตกตัวคูณ" action="action_project_budget" parent="project_kmitl_config_menu" sequence="30" />

</odoo>
