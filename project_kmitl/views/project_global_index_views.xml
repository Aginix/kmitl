<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.global.index View Tree -->
    <record id="view_project_global_index_tree" model="ir.ui.view">
        <field name="name">view.project.global.index.tree</field>
        <field name="model">project.global.index</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View project.global.index form -->
    <record id="view_project_global_index_form" model="ir.ui.view">
        <field name="name">view.project.global.index.form</field>
        <field name="model">project.global.index</field>
        <field name="arch" type="xml">
            <form string="Project Global Index">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View project.global.index search -->
    <record id="view_project_global_index_search" model="ir.ui.view">
        <field name="name">view.project.global.index.search</field>
        <field name="model">project.global.index</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.global.index -->
    <record id="action_project_global_index" model="ir.actions.act_window">
        <field name="name">Project Global Index</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.global.index</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Global Index.
            </p>
        </field>
    </record>

    <menuitem
        id="project_global_index_config_menu"
        name="ความสอดคล้องกับนโยบายสถาบัน Global Index"
        action="action_project_global_index"
        parent="project.menu_project_config"
        />

</odoo>
