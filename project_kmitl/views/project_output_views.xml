<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.output View Tree -->
    <record id="view_project_output_tree" model="ir.ui.view">
        <field name="name">view.project.output.tree</field>
        <field name="model">project.output</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View project.output form -->
    <record id="view_project_output_form" model="ir.ui.view">
        <field name="name">view.project.output.form</field>
        <field name="model">project.output</field>
        <field name="arch" type="xml">
            <form string="Project Output">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View project.output search -->
    <record id="view_project_output_search" model="ir.ui.view">
        <field name="name">view.project.output.search</field>
        <field name="model">project.output</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.output -->
    <record id="action_project_output" model="ir.actions.act_window">
        <field name="name">Project Output</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.output</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Output.
            </p>
        </field>
    </record>

</odoo>
