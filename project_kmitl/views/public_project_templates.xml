<odoo>
  <data>

    <template id="public_project_template" name="Public Project View">
        <t t-call="web.basic_layout">
            <div class="container mt-4 mb-4">
                <h2>
                    <span>ชื่อโครงการ: </span>
                    <span t-esc="project.name" />
                </h2>

                <div class="row mt-3">
                    <div class="col">
                        <strong>ปีงบประมาณ:</strong>
                        <div t-esc="project.date_range_fy_id.name" />
                    </div>
                    <div class="col">
                        <strong>ประเภทแหล่งเงิน:</strong>
                        <div t-esc="project.source" />
                    </div>
                    <div class="col">
                        <strong>หน่วยงาน:</strong>
                        <div t-esc="project.department_name" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col">
                        <strong>หัวหน้าโครงการ:</strong>
                        <div t-esc="project.project_manager_name" />
                    </div>
                    <div class="col">
                        <strong>ตำแหน่ง:</strong>
                        <div t-esc="project.project_manager_position" />
                    </div>
                    <div class="col">
                        <strong>เบอร์โทร:</strong>
                        <div t-esc="project.project_manager_tel" />
                    </div>
                    <div class="col">
                        <strong>อีเมล:</strong>
                        <div t-esc="project.project_manager_email" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col">
                        <strong>สถานที่:</strong>
                        <div t-esc="project.location" />
                    </div>
                </div>

                <div class="mt-4">
                    <h4>หลักการและเหตุผล</h4>
                    <div t-field="project.introduction" />
                </div>

                <div class="mt-4">
                    <h4>วัตถุประสงค์ของโครงการ</h4>
                    <ul>
                        <t t-foreach="project.objective_ids" t-as="obj">
                            <li><t t-esc="obj.name" /></li>
                        </t>
                    </ul>
                </div>

                <div class="mt-4">
                    <h4>ผลที่คาดว่าจะได้รับ</h4>
                    <div t-esc="project.expected_result" />
                </div>

                <div class="mt-4">
                    <h4>วิธีการ/เครื่องมือติดตามและประเมินผล</h4>
                    <ul>
                        <t t-foreach="project.evaluation_method_ids" t-as="eval">
                            <li><t t-esc="eval.name" /></li>
                        </t>
                    </ul>
                    <p><strong>เพิ่มเติม:</strong> <t
                                t-esc="project.evaluation_method_description"
                            /></p>
                </div>

                <div class="mt-4">
                    <h4>งบประมาณทั้งหมด</h4>
                    <p><t t-esc="project.total_budget" /> บาท</p>
                    <p><strong>สถานะ:</strong> <t t-esc="project.state" /></p>
                </div>

                <div class="mt-4">
                    <h4>เป้าหมาย / ผลผลิต / ผลลัพธ์</h4>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>ตัวชี้วัด</th>
                                <th>หน่วยนับ</th>
                                <th>เป้าหมาย ปี 2568</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="project.output_ids" t-as="out">
                                <tr>
                                    <td colspan="3"><strong>
                                        <t t-if="out.line_type == 'output'">ผลผลิต</t>
                                        <t t-else="">ผลลัพธ์</t>
                                    </strong></td>
                                </tr>
                                <tr>
                                    <td><t t-esc="out.name" /></td>
                                    <td class="text-end"><t t-esc="out.unit" /></td>
                                    <td class="text-end"><t t-esc="out.target" /></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="mt-4">
                    <h4>แผนการดำเนินงานและการใช้จ่ายงบประมาณ</h4>
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>ลำดับ</th>
                                <th>กิจกรรม</th>
                                <th>% งบประมาณ</th>
                                <th>จำนวนเงิน</th>
                                <th>ม.ค.</th>
                                <th>ก.พ.</th>
                                <th>มี.ค.</th>
                                <th>เม.ย.</th>
                                <th>พ.ค.</th>
                                <th>มิ.ย.</th>
                                <th>ก.ค.</th>
                                <th>ส.ค.</th>
                                <th>ก.ย.</th>
                                <th>ต.ค.</th>
                                <th>พ.ย.</th>
                                <th>ธ.ค.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="project.project_activity_ids" t-as="activity">
                                <tr>
                                    <td><t t-esc="activity.seq" /></td>
                                    <td><t t-esc="activity.name" /></td>
                                    <td class="text-end"><t
                                                t-esc="activity.percentage"
                                            />%</td>
                                    <td class="text-end"><t
                                                t-esc="activity.amount"
                                            /></td>
                                    <td class="text-center"><t
                                                t-if="activity.m1"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m2"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m3"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m4"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m5"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m6"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m7"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m8"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m9"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m10"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m11"
                                            >✔️</t></td>
                                    <td class="text-center"><t
                                                t-if="activity.m12"
                                            >✔️</t></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>


                <div class="mt-4">
                    <p><strong>แผนยุทธศาสตร์:</strong></p>
                    <ul>
                        <li>ระดับ 1: <t
                                    t-esc="project.national_strategy_id.name"
                                /></li>
                        <li>ระดับ 2: <t t-esc="project.master_plan_id.name" /></li>
                        <li>ระดับ 2 ฉ.13: <t t-esc="project.nesdc_plan_id.name" /></li>
                        <li>ระดับ 3: <t t-esc="project.kmitl_plan_id.name" /></li>
                    </ul>
                </div>
            </div>
        </t>
    </template>

  </data>
</odoo>
