<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.project form -->
    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">view.project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='label_tasks']" position="before">
                <field name="date_range_fy_id" widget="selection" required="1" />
            </xpath>
            <xpath expr="//div[@name='dates']" position="after">
                <field name="code" />
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="ความสอดคล้องกับยุทธศาสตร์">
                    <field name="national_strategy_id" />
                    <field name="master_plan_id" />
                    <field name="nesdc_plan_id" />
                    <field name="kmitl_plan_id" />
                </group>
                <group string="ความสอดคล้องกับนโยบายสถาบัน">
                    <group>
                        <field name="impact_ids" widget="many2many_checkboxes" />
                        <field name="global_index_ids" widget="many2many_checkboxes" />
                    </group>
                    <group>
                        <field name="fight_ids" widget="many2many_checkboxes" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='description']" position="replace">
                <page name="description" string="ข้อมูลโครงการ">
                    <group string="หลักการและเหตุผล">
                        <field name="description" nolabel="1" colspan="2" options="{'resizable': false}" placeholder="Project description..."/>
                    </group>
                    <separator string="วัตถุประสงค์โครงการ" />
                    <field name="objective_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                        </tree>
                    </field>
                    <group>
                        <field name="location" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='description']" position="after">
                <page name="project_plan" string="แผนการดำเนินงาน">
                    <group>
                        <field name="total_budget" />
                        <separator string="แผนการดำเนินงาน" />
                        <field name="plan_ids" nolabel="1" colspan="2" widget="project_plan">
                            <tree>
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="percentage" />
                                <field name="amount" />
                                <field name="m10" />
                                <field name="m11" />
                                <field name="m12" />
                                <field name="m1" />
                                <field name="m2" />
                                <field name="m3" />
                                <field name="m4" />
                                <field name="m5" />
                                <field name="m6" />
                                <field name="m7" />
                                <field name="m8" />
                                <field name="m9" />
                            </tree>
                        </field>
                    </group>

                </page>
            </xpath>
            <xpath expr="//page[@name='settings']" position="before">
                <page string="การดำเนินโครงการ">
                    <group>
                        <group string="การดำเนินโครงการ">
                            <field name="methodology_ids" widget="many2many_checkboxes" />
                            <field name="methodology_detail" string="รายละเอียด" />
                        </group>
                        <group string="วิธีการ/เครื่องมือติดตามและประเมินผล">
                            <field name="evaluation_ids" widget="many2many_checkboxes" string="วิธีการ" />
                            <field name="evaluation_detail" string="รายละเอียด" />
                        </group>
                    </group>
                    <group string="เป้าหมาย ผลผลิต และผลลัพธ์">
                        <group>
                            <separator string="ผลผลิต (Output)" />
                            <div colspan="2" class="alert alert-info" role="alert">
                                <i>ผลหรือสิ่งที่คาดว่าจะได้รับหรือประโยชน์จากการดำเนินโครงการ</i>
                            </div>
                            <field name="output_ids" nolabel="1" colspan="2" context="{'default_line_type': 'output'}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="line_type" invisible="1" />
                                    <field name="unit" />
                                    <field name="amount" />
                                </tree>
                            </field>
                        </group>
                        <group>
                            <separator string="ผลลัพธ์ (Outcome)" />
                            <div colspan="2" class="alert alert-info" role="alert">
                                <i>ผลที่ได้จากการบรรลุวัตถุประสงค์ของโครงการ</i>
                            </div>
                            <field name="outcome_ids" nolabel="1" colspan="2" context="{'default_line_type': 'outcome'}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="line_type" invisible="1" />
                                    <field name="unit" />
                                    <field name="amount" />
                                </tree>
                            </field>
                        </group>
                    </group>
                    <group string="กลุ่มเป้าหมาย/ผู้ดำเนินโครงการ">
                        <separator string="กลุ่มเป้าหมาย" />
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i>ระบุกลุ่มเป้าหมายหลักและจำนวนคน เพื่อกำหนดเป็นตัวชี้วัดและค่าเป้าหมายของโครงการ ซึ่งได้รับประโยชน์จากการดำเนินโครงการ</i>
                        </div>
                        <field name="target_ids" nolabel="1" colspan="2" context="{'default_line_type': 'target'}">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="line_type" invisible="1" />
                                <field name="amount"/>
                            </tree>
                        </field>
                        <separator string="ผู้เข้าร่วมโครงการ" />
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i>ระบุกลุ่มผู้เข้าร่วมโครงการและจำนวนคน ซึ่งมีส่วนได้ส่วนเสียและได้รับประโยชน์หลังจากดำเนินโครงการแล้ว  แต่ไม่นับเป็นค่าเป้าหมายของโครงการ</i>
                        </div>
                        <field name="participant_ids" nolabel="1" colspan="2" context="{'default_line_type': 'participant'}">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="line_type" invisible="1" />
                                <field name="amount"/>
                            </tree>
                        </field>
                        <separator string="ผู้ดำเนินโครงการ และวิทยากร" />
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i>ระบุจำนวนผู้ดำเนินโครงการและวิทยากร เพื่อนำไปคำนวณเป็นค่าใช้จ่ายเพิ่ม รวมกับค่าใช้จ่ายของกลุ่มเป้าหมาย/ผู้เข้าร่วมโครงการ แต่ไม่นับเป็นค่าเป้าหมายของโครงการ</i>
                        </div>
                        <field name="organizer_ids" nolabel="1" colspan="2" context="{'default_line_type': 'organizer'}">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="line_type" invisible="1" />
                                <field name="amount"/>
                            </tree>
                        </field>
                    </group>
                    <group string="ผลที่คาดว่าจะได้รับ">
                        <div colspan="2" class="alert alert-info" role="alert">
                            <i>ผลที่เกิดโดยตรงทันทีที่สิ้นสุดโครงการ  และผลที่จะเกิดตามมาในระยะยาว</i>
                        </div>
                        <field name="expected_outcome_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                            </tree>
                        </field>
                    </group>
                </page>
                <page name="attachment" string="เอกสารประกอบการพิจารณาโครงการ">
                    <div class="alert alert-info" role="alert">
                        <li>
                            <b>ค่าจ้างเหมาบริการ</b> เช่น จ้างออแกไนซ์เซอร์, ใบเสนอราคา
                        </li>
                        <li>
                            <b>ค่าครุภัณฑ์</b> เช่น ใบเสนอราคา, รายละเอียดคุณลักษณะ (spec), แผนการจัดซื้อจัดจ้าง</li>
                        <li>
                            <b>ปรับปรุง/สิ่งก่อสร้าง</b> เช่น แบบรูปรายการ, แบบประมาณราคากลาง, แผนการจัดซื้อจัดจ้าง, โครงการตามผังแม่บทสถาบัน, แผนผังแสดงพื้นที่ที่จะดำเนินการ
                        </li>
                        <li>แบบฟอร์มรายงานโครงการหรือกิจกรรม (แบบ วต)</li>
                        <li>เอกสารอื่น ๆ</li>
                    </div>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <!-- View project.project tree -->
    <record id="view_project_project_tree" model="ir.ui.view">
        <field name="name">view.project.project.tree</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="date_range_fy_id" optional="show" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
