<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View project.project form -->
    <record id="view_project_project_inherit_form" model="ir.ui.view">
        <field name="name">view.project.project.inherit.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath
                expr="//form/header/button[@name='%(project.project_share_wizard_action)d'][1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//form/header/button[@name='%(project.project_share_wizard_action)d'][2]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_submit"
                    type="object"
                    string="แบบร่างเสนอเจ้าภาพ"
                    class="btn-primary"
                    attrs="{'invisible': [('state', '!=', 'draft')]}"
                />
                <button
                    name="action_validate"
                    type="object"
                    string="ตรวจสอบยืนยัน"
                    class="btn-primary"
                    attrs="{'invisible': [('state', '!=', 'submit')]}"
                />
                <button
                    name="action_approve"
                    type="object"
                    string="อนุมัติโครงงาน"
                    class="btn-primary"
                    attrs="{'invisible': [('state', '!=', 'validate')]}"
                />
                <button
                    type="object"
                    name="action_open_public"
                    class="btn-primary"
                    string="Public"
                    icon="fa-globe"
                />
                <button
                    name="action_cancel"
                    type="object"
                    string="ยกเลิก"
                    class="btn-primary"
                    attrs="{'invisible': [('state', '!=', 'approve')]}"
                />
                <field name="state" widget="statusbar" />
            </xpath>
            <xpath expr="//notebook" position="before">
                <group>
                    <group>
                        <field name="name" />
                        <field name="responsible_id" widget="many2one_avatar_user" />
                        <field name="introduction" />
                    </group>
                    <group>
                        <field name="date_range_fy_id" />
                        <field name="source" />
                    </group>
                </group>
                <group string="ความสอดคล้องกับยุทธศาสตร์">
                    <group>
                        <field name="national_strategy_id" />
                        <field name="master_plan_id" />
                        <field name="nesdc_plan_id" />
                        <field name="kmitl_plan_id" />
                    </group>
                </group>

                <group string="ความสอดคล้องกับนโยบายสถาบัน">
                    <group>
                        <field name="impact_ids" widget="many2many_tags" />
                        <field name="global_index_ids" widget="many2many_tags" />

                    </group>
                    <group>
                        <field name="okr_1" widget="many2many_tags" />
                        <field name="fight_ids" widget="many2many_tags" />
                    </group>
                </group>

                <group>
                    <field name="objective_ids">
                        <tree editable="bottom">
                            <field name="name" />
                        </tree>
                    </field>
                </group>

                <group name="project" string="โครงการ">
                    <group>
                        <field name="project_manager_name" />
                        <field name="project_manager_position" />
                        <field name="project_manager_tel" />
                        <field name="project_manager_email" />
                        <field name="location" />
                    </group>
                    <group>
                        <field name="department_id" />
                        <field name="department_name" />
                    </group>
                </group>

                <group>
                    <field name="methodology" />
                    <field name="methodology_description" />
                    <field name="target_ids" />
                    <field name="output_ids" widget="table_output">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="line_type" />
                            <field name="unit" />
                            <field name="target" />
                        </tree>
                    </field>
                </group>
                <group>
                    <field name="project_activity_ids" widget="table_activity">
                        <tree>
                            <field name="seq" />
                            <field name="name" />
                            <field name="percentage" />
                            <field name="amount" />
                            <field name="line_type" invisible="1" />
                            <field name="m10" />
                            <field name="m11" />
                            <field name="m12" />
                            <field name="m1" />
                            <field name="m2" />
                            <field name="m3" />
                            <field name="m4" />
                            <field name="m5" />
                            <field name="m6" />
                            <field name="m7" />
                            <field name="m8" />
                            <field name="m9" />
                            <field name="percentage" invisible="1" />
                        </tree>
                    </field>
                    <field name="expected_result" />
                    <field name="evaluation_method_ids" widget="many2many_tags" />
                    <field name="evaluation_method_description" />
                </group>
                <group>
                    <group>
                        <field name="total_budget" />
                    </group>
                    <group>
                        <field name="attachment_ids" filename="ชื่อไฟล์" />
                    </group>
                </group>

            </xpath>
        </field>
    </record>

    <record id="view_form_project_activity" model="ir.ui.view">
        <field name="name">project.activity.form</field>
        <field name="model">project.activity</field>
        <field name="arch" type="xml">
            <form string="กิจกรรม / ขั้นตอน">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="seq" />
                        <field name="amount" />
                        <field name="line_type" />
                        <field name="percentage" />
                        <field name="project_kmitl_id" invisible="1" />
                    </group>

                    <group string="ระบุเดือนที่ดำเนินการ">
                        <group>
                            <separator string="ไตรมาสที่ 1 (ต.ค. - ธ.ค.)" />
                            <field name="m10" />
                            <field name="m11" />
                            <field name="m12" />
                        </group>

                        <group>
                            <separator string="ไตรมาสที่ 2 (ม.ค. - มี.ค.)" />
                            <field name="m1" />
                            <field name="m2" />
                            <field name="m3" />
                        </group>
                    </group>

                    <group>
                        <group>
                            <separator string="ไตรมาสที่ 3 (เม.ย. - มิ.ย.)" />
                            <field name="m4" />
                            <field name="m5" />
                            <field name="m6" />
                        </group>
                        <group>
                            <separator string="ไตรมาสที่ 4 (ก.ค. - ก.ย.)" />
                            <field name="m7" />
                            <field name="m8" />
                            <field name="m9" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_project_tree_inherit_form" model="ir.ui.view">
        <field name="name">project.project.tree.inherit.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="date_range_fy_id" />
            </xpath>
        </field>
    </record>

    <record id="project.open_view_project_all" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">project.project</field>
            <field name="domain">[]</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="project.view_project" />
            <field name="search_view_id" ref="project.view_project_project_filter" />
            <field name="target">main</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No projects found. Let's create one!
                </p>
                <p>
                    Create projects to organize your tasks. Define a different workflow for each project.
                </p>
            </field>
        </record>

  </odoo>
