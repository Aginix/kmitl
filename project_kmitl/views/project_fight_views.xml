<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.fight View Tree -->
    <record id="view_project_fight_tree" model="ir.ui.view">
        <field name="name">view.project.fight.tree</field>
        <field name="model">project.fight</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="name_th" />
            </tree>
        </field>
    </record>

    <!-- View project.fight form -->
    <record id="view_project_fight_form" model="ir.ui.view">
        <field name="name">view.project.fight.form</field>
        <field name="model">project.fight</field>
        <field name="arch" type="xml">
            <form string="Project Fight">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name_th" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View project.fight search -->
    <record id="view_project_fight_search" model="ir.ui.view">
        <field name="name">view.project.fight.search</field>
        <field name="model">project.fight</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.fight -->
    <record id="action_project_fight" model="ir.actions.act_window">
        <field name="name">Project Fight</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.fight</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Fight.
            </p>
        </field>
    </record>

    <menuitem
        id="project_fight_config_menu"
        name="ความสอดคล้องกับค่านิยม"
        action="action_project_fight"
        parent="project.menu_project_config"
        />

</odoo>
