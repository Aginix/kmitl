<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View project.expected.outcome View Tree -->
    <record id="view_project_expected_outcome_tree" model="ir.ui.view">
        <field name="name">view.project.expected.outcome.tree</field>
        <field name="model">project.expected.outcome</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View project.expected.outcome form -->
    <record id="view_project_expected_outcome_form" model="ir.ui.view">
        <field name="name">view.project.expected.outcome.form</field>
        <field name="model">project.expected.outcome</field>
        <field name="arch" type="xml">
            <form string="Project Expected Outcome">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View project.expected.outcome search -->
    <record id="view_project_expected_outcome_search" model="ir.ui.view">
        <field name="name">view.project.expected.outcome.search</field>
        <field name="model">project.expected.outcome</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action project.expected.outcome -->
    <record id="action_project_expected_outcome" model="ir.actions.act_window">
        <field name="name">Project Expected Outcome</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.expected.outcome</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Project Expected Outcome.
            </p>
        </field>
    </record>

</odoo>
