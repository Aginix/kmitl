<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="project_kmitl_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure" />
                        <h2 class="mt-4">
                            <span>ชื่อโครงการ # </span>
                            <span t-field="doc.name" />
                        </h2>
                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>ปีงบประมาณ:</strong>
                                <p class="m-0" t-field="doc.date_range_fy_id.name" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>ประเภทแหล่งเงิน:</strong>
                                <p class="m-0" t-field="doc.source" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>หน่วยงาน:</strong>
                                <p class="m-0" t-field="doc.department_name" />
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>หัวหน้าโครงการ:</strong>
                                <p class="m-0" t-field="doc.project_manager_name" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>ตำแหน่ง:</strong>
                                <p class="m-0" t-field="doc.project_manager_position" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>เบอร์โทร:</strong>
                                <p class="m-0" t-field="doc.project_manager_tel" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>อีเมล:</strong>
                                <p class="m-0" t-field="doc.project_manager_email" />
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>สถานที่:</strong>
                                <p class="m-0" t-field="doc.location" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>หลักการและเหตุผล:</strong>
                                <p class="m-0" t-field="doc.introduction" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>วัตถุประสงค์ของโครงการ:</strong>
                                <t t-foreach="doc.objective_ids" t-as="obj">
                                    <p class="m-0" t-field="obj.name" />
                                </t>
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>ผลที่คาดว่าจะได้รับ:</strong>
                                <p class="m-0" t-field="doc.expected_result" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>หลักการและเหตุผล:</strong>
                                <t t-foreach="doc.evaluation_method_ids" t-as="obj">
                                    <p class="m-0" t-field="obj.name" />
                                </t>
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>เพิ่มเติม:</strong>
                                <p
                                    class="m-0"
                                    t-field="doc.evaluation_method_description"
                                />
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>งบประมาณทั้งหมด:</strong>
                                <p class="m-0" t-field="doc.total_budget" />
                            </div>
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong>สถานะโครงการ:</strong>
                                <p class="m-0" t-field="doc.state" />
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-4 mb-4">
                            <thead style="display: table-row-group">
                                <tr class="table-primary">
                                    <th class="text-start text-danger">ตัวชี้วัด</th>
                                    <th class="text-end text-danger">หน่วยนับ</th>
                                    <th
                                        class="text-end text-danger"
                                    >เป้าหมาย ปีงบประมาณ 2568</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.output_ids" t-as="output">
                                    <tr>
                                        <td colspan="3" style="font-weight: bold;">
                                            <t
                                                t-if="output.line_type == 'output'"
                                            >ผลผลิต</t>
                                            <t t-else="">ผลลัพธ์</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><span t-field="output.name" /></td>
                                        <td class="text-end"><span
                                                t-field="output.unit"
                                            /></td>
                                        <td class="text-end"><span
                                                t-field="output.target"
                                            /></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="table table-bordered table-sm mt-4 mb-4">
                            <thead class="table-light">
                                <tr>
                                    <th>ลำดับ</th>
                                    <th>กิจกรรม</th>
                                    <th>% งบประมาณ</th>
                                    <th>จำนวนเงิน</th>
                                    <th>ม.ค.</th>
                                    <th>ก.พ.</th>
                                    <th>มี.ค.</th>
                                    <th>เม.ย.</th>
                                    <th>พ.ค.</th>
                                    <th>มิ.ย.</th>
                                    <th>ก.ค.</th>
                                    <th>ส.ค.</th>
                                    <th>ก.ย.</th>
                                    <th>ต.ค.</th>
                                    <th>พ.ย.</th>
                                    <th>ธ.ค.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.project_activity_ids" t-as="activity">
                                    <tr>
                                        <td><t t-esc="activity.seq" /></td>
                                        <td><t t-esc="activity.name" /></td>
                                        <td class="text-end"><t
                                                t-esc="activity.percentage"
                                            />%</td>
                                        <td class="text-end"><t
                                                t-esc="activity.amount"
                                            /></td>
                                        <td class="text-center"><t
                                                t-if="activity.m1"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m2"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m3"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m4"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m5"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m6"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m7"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m8"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m9"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m10"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m11"
                                            >✔️</t></td>
                                        <td class="text-center"><t
                                                t-if="activity.m12"
                                            >✔️</t></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong
                                >ความสอดคล้องกับยุทธศาสตร์ แผนระดับที่ 1:</strong>
                                <p
                                    class="m-0"
                                    t-field="doc.national_strategy_id.name"
                                />
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong
                                >ความสอดคล้องกับยุทธศาสตร์ แผนระดับที่ 2:</strong>
                                <p class="m-0" t-field="doc.master_plan_id.name" />
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong
                                >ความสอดคล้องกับยุทธศาสตร์ แผนระดับที่ 2 ฉบับที่ 13:</strong>
                                <p class="m-0" t-field="doc.nesdc_plan_id.name" />
                            </div>
                        </div>

                        <div class="row mt-2 mb-2" id="informations">
                            <div class="col-auto col-3 mw-100 mb-2">
                                <strong
                                >ความสอดคล้องกับยุทธศาสตร์ แผนระดับที่ 3:</strong>
                                <p class="m-0" t-field="doc.kmitl_plan_id.name" />
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="project_kmitl_report_temp" model="ir.actions.report">
        <field name="name">Project KMITL</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_kmitl.project_kmitl_report_template</field>
        <field name="report_file">project_kmitl.project_kmitl_report_template</field>
        <field name="print_report_name">'Project - ' + object.name</field>
        <field name="binding_model_id" ref="project_kmitl.model_project_project" />
        <field name="binding_type">report</field>
    </record>

</odoo>
