<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form View -->
    <record id="view_kris_allocation_config_form" model="ir.ui.view">
        <field name="name">kris.allocation.config.form</field>
        <field name="model">kris.allocation.config</field>
        <field name="arch" type="xml">
            <form string="Allocation Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name" />
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" />
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="is_home_department" />
                            <field name="department_analytic_id"
                                   attrs="{'invisible': [('is_home_department', '=', True)], 'required': [('is_home_department', '=', False)]}"
                                   options="{'no_create': True}" />
                            <field name="account_id" />
                            <field name="percentage" />
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_percentage" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_kris_allocation_config_tree" model="ir.ui.view">
        <field name="name">kris.allocation.config.tree</field>
        <field name="model">kris.allocation.config</field>
        <field name="arch" type="xml">
            <tree string="Allocation Configurations">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="total_percentage" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_kris_allocation_config" model="ir.actions.act_window">
        <field name="name">Allocation Configurations</field>
        <field name="res_model">kris.allocation.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Allocation Configuration
            </p>
        </field>
    </record>
</odoo>
