<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_kris_project_tree" model="ir.ui.view">
        <field name="name">kris.project.tree</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <tree string="Research Projects">
                <field name="name" />
                <field name="project_name" />
                <field name="researcher_id" />
                <field name="funding_organization_id" optional="show" />
                <field name="account_fiscal_year_id" options="{'no_open': True}" />
                <field name="grant_amount" />
                <field name="total_received" />
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('done', 'cancel')" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_kris_project_form" model="ir.ui.view">
        <field name="name">kris.project.form</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <form string="Research Project">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="action_done" string="Mark as Done" type="object"
                            attrs="{'invisible': [('state', '!=', 'active')]}" />
                    <button name="action_cancel" string="Cancel" type="object"
                            attrs="{'invisible': [('state', 'in', ('done', 'cancel'))]}" />
                    <button name="action_draft" string="Reset to Draft" type="object"
                            class="btn btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'cancel')]}" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipts" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="receipt_count" widget="statinfo"
                                   string="Receipts" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <h2>
                            <field name="project_name" placeholder="Project Name" />
                        </h2>
                    </div>
                    <group>
                        <group string="Project Information">
                            <field name="researcher_id" />
                            <field name="funding_organization_id" />
                            <field name="user_id" />
                            <field name="account_fiscal_year_id" />
                        </group>
                        <group string="Financial Information">
                            <field name="currency_id" groups="base.group_multi_currency" />
                            <field name="grant_amount" />
                            <field name="total_received" />
                            <field name="department_analytic_id"
                                   options="{'no_create': True}" />
                            <field name="allocation_config_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details">
                            <field name="description" placeholder="Project description..." />
                        </page>
                        <page string="Funding Receipts" name="receipts">
                            <field name="funding_receipt_ids" readonly="1">
                                <tree>
                                    <field name="name" />
                                    <field name="date" />
                                    <field name="ref" />
                                    <field name="amount" />
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'confirmed'"
                                           decoration-success="state == 'posted'"
                                           decoration-danger="state == 'cancel'" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_kris_project_search" model="ir.ui.view">
        <field name="name">kris.project.search</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <search string="Research Projects">
                <field name="name" string="Number"
                       filter_domain="['|', ('name', 'ilike', self), ('project_name', 'ilike', self)]" />
                <field name="researcher_id" />
                <field name="funding_organization_id" />
                <field name="account_fiscal_year_id" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Active" name="active" domain="[('state', '=', 'active')]" />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]" />
                <group expand="0" string="Group By">
                    <filter string="Fiscal Year" name="fiscal_year"
                            context="{'group_by': 'account_fiscal_year_id'}" />
                    <filter string="State" name="state"
                            context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_kris_project" model="ir.actions.act_window">
        <field name="name">Research Projects</field>
        <field name="res_model">kris.project</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Research Project
            </p>
            <p>
                Research projects track external grants and link to funding receipts.
            </p>
        </field>
    </record>
</odoo>
