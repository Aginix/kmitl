<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_kris_funding_receipt_tree" model="ir.ui.view">
        <field name="name">kris.funding.receipt.tree</field>
        <field name="model">kris.funding.receipt</field>
        <field name="arch" type="xml">
            <tree string="Funding Receipts">
                <field name="name" />
                <field name="date" />
                <field name="project_id" />
                <field name="researcher_id" optional="show" />
                <field name="ref" optional="show" />
                <field name="amount" />
                <field name="account_fiscal_year_id" options="{'no_open': True}" />
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancel'" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_kris_funding_receipt_form" model="ir.ui.view">
        <field name="name">kris.funding.receipt.form</field>
        <field name="model">kris.funding.receipt</field>
        <field name="arch" type="xml">
            <form string="Funding Receipt">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            groups="kris.group_kris_finance" />
                    <button name="action_post" string="Post to Journal" type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"
                            confirm="Are you sure you want to post this receipt to the journal?"
                            groups="kris.group_kris_manager" />
                    <button name="action_cancel" string="Cancel" type="object"
                            attrs="{'invisible': [('state', 'in', ('posted', 'cancel'))]}" />
                    <button name="action_draft" string="Reset to Draft" type="object"
                            class="btn btn-secondary"
                            attrs="{'invisible': [('state', 'not in', ('confirmed', 'cancel'))]}"
                            groups="kris.group_kris_manager" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,posted" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                attrs="{'invisible': [('move_id', '=', False)]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Receipt Information">
                            <field name="project_id"
                                   options="{'no_create': True}" />
                            <field name="researcher_id" readonly="1" />
                            <field name="funding_organization_id" readonly="1" />
                            <field name="date" />
                            <field name="ref" />
                            <field name="account_fiscal_year_id" readonly="1"
                                   options="{'no_open': True}" />
                            <field name="currency_id"
                                   groups="base.group_multi_currency" />
                            <field name="amount" />
                        </group>
                        <group string="Accounting Configuration">
                            <field name="department_analytic_id" readonly="1"
                                   options="{'no_open': True}" />
                            <field name="allocation_config_id"
                                   options="{'no_create': True}" />
                            <field name="journal_id"
                                   options="{'no_create': True}" />
                            <field name="bank_account_id"
                                   options="{'no_create': True}" />
                            <field name="move_id" readonly="1"
                                   options="{'no_open': True}"
                                   attrs="{'invisible': [('move_id', '=', False)]}" />
                            <field name="company_id"
                                   groups="base.group_multi_company" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Audit Trail" name="audit">
                            <group>
                                <field name="confirmed_by" readonly="1" />
                                <field name="confirmed_date" readonly="1" />
                                <field name="posted_by" readonly="1" />
                                <field name="posted_date" readonly="1" />
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..." />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_kris_funding_receipt_search" model="ir.ui.view">
        <field name="name">kris.funding.receipt.search</field>
        <field name="model">kris.funding.receipt</field>
        <field name="arch" type="xml">
            <search string="Funding Receipts">
                <field name="name" string="Number"
                       filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]" />
                <field name="project_id" />
                <field name="researcher_id" />
                <field name="account_fiscal_year_id" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]" />
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]" />
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]" />
                <group expand="0" string="Group By">
                    <filter string="Project" name="project"
                            context="{'group_by': 'project_id'}" />
                    <filter string="Fiscal Year" name="fiscal_year"
                            context="{'group_by': 'account_fiscal_year_id'}" />
                    <filter string="State" name="state"
                            context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_kris_funding_receipt" model="ir.actions.act_window">
        <field name="name">Funding Receipts</field>
        <field name="res_model">kris.funding.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Funding Receipt
            </p>
            <p>
                Funding receipts record incoming external grants and post them to the journal.
            </p>
        </field>
    </record>
</odoo>
