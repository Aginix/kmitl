<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_kris_project" model="ir.sequence">
            <field name="name">KRIS Research Project</field>
            <field name="code">kris.project</field>
            <field name="prefix">KP/%(year_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_kris_funding_receipt" model="ir.sequence">
            <field name="name">KRIS Funding Receipt</field>
            <field name="code">kris.funding.receipt</field>
            <field name="prefix">KR/%(year_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
