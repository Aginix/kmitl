<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail_activity_todo_discuss.DiscussTodoPanel" owl="1">
        <div class="o_DiscussTodoPanel" t-attf-class="{{ className }}" t-ref="root">
            <div class="o_DiscussTodoPanel_header d-flex align-items-center my-1">
                <div class="o_DiscussTodoPanel_title d-flex align-items-baseline mx-1 btn p-0 text-start text-700 opacity-100-hover opacity-75"
                    t-on-click="toggle"
                >
                    <i class="small" t-att-class="state.isOpen ? 'fa fa-chevron-down' : 'fa fa-chevron-right'"/>
                    <span class="btn-sm p-0 text-uppercase fw-bolder ms-1">Todos</span>
                </div>
                <div class="flex-grow-1"/>
                <div class="o_DiscussTodoPanel_counter badge rounded-pill text-bg-primary me-3"
                    t-if="state.totalCount > 0"
                    t-esc="state.totalCount"
                />
            </div>
            <div class="o_DiscussTodoPanel_content" t-if="state.isOpen">
                <t t-if="state.todos.length === 0">
                    <div class="text-muted small mx-4 mb-2">No pending todos</div>
                </t>
                <t t-else="">
                    <div class="o_DiscussTodoPanel_items">
                        <t t-foreach="state.todos" t-as="todo" t-key="todo.id">
                            <button class="o_DiscussTodoPanel_item btn d-flex align-items-center w-100 py-1 px-0 border-0 rounded-0 fw-normal text-dark"
                                t-on-click="() => this.onTodoClick(todo)"
                                t-att-title="todo.summary"
                            >
                                <img t-if="todo.icon" t-att-src="todo.icon" class="o_DiscussTodoPanel_icon ms-4 me-2" alt=""/>
                                <i t-else="" class="fa fa-fw fa-check-square-o ms-4 me-2"/>
                                <div class="o_DiscussTodoPanel_itemText flex-grow-1 text-start text-truncate">
                                    <div class="text-truncate" t-esc="todo.summary"/>
                                    <small class="text-muted text-truncate d-block" t-if="todo.res_name" t-esc="todo.res_name"/>
                                </div>
                                <small t-if="todo.date_deadline"
                                    class="o_DiscussTodoPanel_deadline ms-1 me-3 text-nowrap"
                                    t-att-class="{
                                        'text-danger': todo.state === 'overdue',
                                        'text-warning': todo.state === 'today',
                                        'text-muted': todo.state === 'planned',
                                    }"
                                    t-esc="todo.date_deadline"
                                />
                            </button>
                        </t>
                    </div>
                    <div class="o_DiscussTodoPanel_viewAll mx-4 my-1">
                        <a href="#" class="small text-primary" t-on-click.prevent="onViewAllClick">
                            <i class="fa fa-list me-1"/>
                            <t t-if="state.totalCount > state.shownCount">
                                View all (<t t-esc="state.totalCount"/>)
                            </t>
                            <t t-else="">View all</t>
                        </a>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <!-- Inject the Todo panel into the Discuss sidebar, right after the
         Inbox/Starred/History mailbox category. -->
    <t t-name="mail_activity_todo_discuss.DiscussSidebar" t-inherit="mail.DiscussSidebar" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_DiscussSidebar_categoryMailbox')]" position="after">
            <hr class="o_DiscussSidebar_separator w-100 border-top"/>
            <DiscussTodoPanel className="'o_DiscussSidebar_category o_DiscussSidebar_categoryTodo flex-shrink-0'"/>
        </xpath>
    </t>

</templates>
