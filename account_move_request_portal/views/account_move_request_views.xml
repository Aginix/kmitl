<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_request_form" model="ir.ui.view">
        <field name="name">account.move.request.form.portal</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_preview"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-globe">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Preview</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
