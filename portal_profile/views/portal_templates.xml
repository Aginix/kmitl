<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Add "My Profile" link to portal home -->
    <template
        id="portal_my_home_profile"
        name="Portal My Home: Profile"
        inherit_id="portal.portal_my_home"
        priority="40"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t
                    t-set="icon"
                    t-value="'/portal_profile/static/src/img/profile.svg'"
                />
                <t t-set="title">My Profile</t>
                <t t-set="url" t-value="'/my/profile'" />
            </t>
        </xpath>
    </template>

    <!-- Change Edit button to link to /my/profile -->
    <template
        id="portal_layout_inherit_profile"
        name="Portal Layout: Profile Edit"
        inherit_id="portal.portal_layout"
    >
        <xpath
            expr="//div[hasclass('o_portal_my_details')]//a[@href='/my/account']"
            position="attributes"
        >
            <attribute name="href">/my/profile</attribute>
        </xpath>
    </template>

    <!-- Profile form page -->
    <template id="portal_my_profile" name="My Profile">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Profile</t>
            </t>

            <div class="container mt-3">
                <!-- Error messages -->
                <div t-if="error_message" class="alert alert-danger" role="alert">
                    <t t-foreach="error_message" t-as="err"><t t-esc="err" /><br /></t>
                </div>

                <form action="/my/profile" method="post">
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />

                    <!-- Name Info -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Name Info</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="title"
                                    >Title</label>
                                    <select name="title" class="form-select">
                                        <option value="">-- Select --</option>
                                        <t t-foreach="titles or []" t-as="t">
                                            <option
                                                t-att-value="t.id"
                                                t-att-selected="t.id == profile.title.id or None"
                                            >
                                                <t t-esc="t.name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="first_name"
                                    >First Name (TH)</label>
                                    <input
                                        type="text"
                                        name="first_name"
                                        class="form-control"
                                        t-att-value="profile.first_name or ''"
                                        required="required"
                                    />
                                </div>
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="middle_name"
                                    >Middle Name (TH)</label>
                                    <input
                                        type="text"
                                        name="middle_name"
                                        class="form-control"
                                        t-att-value="profile.middle_name or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="last_name"
                                    >Last Name (TH)</label>
                                    <input
                                        type="text"
                                        name="last_name"
                                        class="form-control"
                                        t-att-value="profile.last_name or ''"
                                        required="required"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="first_name_en"
                                    >First Name (EN)</label>
                                    <input
                                        type="text"
                                        name="first_name_en"
                                        class="form-control"
                                        t-att-value="profile.first_name_en or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="middle_name_en"
                                    >Middle Name (EN)</label>
                                    <input
                                        type="text"
                                        name="middle_name_en"
                                        class="form-control"
                                        t-att-value="profile.middle_name_en or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-4">
                                    <label
                                        class="col-form-label"
                                        for="last_name_en"
                                    >Last Name (EN)</label>
                                    <input
                                        type="text"
                                        name="last_name_en"
                                        class="form-control"
                                        t-att-value="profile.last_name_en or ''"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact &amp; Address -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Contact &amp; Address</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="email"
                                    >Email</label>
                                    <input
                                        type="email"
                                        name="email"
                                        class="form-control"
                                        t-att-value="profile.email or ''"
                                        required="required"
                                    />
                                </div>
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="phone"
                                    >Phone</label>
                                    <input
                                        type="tel"
                                        name="phone"
                                        class="form-control"
                                        t-att-value="profile.phone or ''"
                                        required="required"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-12">
                                    <label
                                        class="col-form-label"
                                        for="street"
                                    >Address</label>
                                    <input
                                        type="text"
                                        name="street"
                                        class="form-control"
                                        t-att-value="profile.street or ''"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-12">
                                    <label
                                        class="col-form-label"
                                        for="zip_id"
                                    >ZIP Location</label>
                                    <select name="zip_id" class="form-select">
                                        <option value="">-- Select --</option>
                                        <t t-foreach="zips or []" t-as="z">
                                            <option
                                                t-att-value="z.id"
                                                t-att-selected="z.id == profile.zip_id.id or None"
                                            >
                                                <t t-esc="z.display_name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Info -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Personal Info</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="birthday"
                                    >Birthday</label>
                                    <input
                                        type="date"
                                        name="birthday"
                                        class="form-control"
                                        t-att-value="profile.birthday or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="nationality_id"
                                    >Nationality</label>
                                    <select name="nationality_id" class="form-select">
                                        <option value="">-- Select --</option>
                                        <t t-foreach="countries or []" t-as="country">
                                            <option
                                                t-att-value="country.id"
                                                t-att-selected="country.id == profile.nationality_id.id or None"
                                            >
                                                <t t-esc="country.name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="marital"
                                    >Marital Status</label>
                                    <select
                                        name="marital"
                                        id="marital"
                                        class="form-select"
                                    >
                                        <option value="">-- Select --</option>
                                        <option
                                            value="single"
                                            t-att-selected="profile.marital == 'single' or None"
                                        >Single</option>
                                        <option
                                            value="married"
                                            t-att-selected="profile.marital == 'married' or None"
                                        >Married</option>
                                        <option
                                            value="divorced"
                                            t-att-selected="profile.marital == 'divorced' or None"
                                        >Divorced</option>
                                        <option
                                            value="widowed"
                                            t-att-selected="profile.marital == 'widowed' or None"
                                        >Widowed</option>
                                    </select>
                                </div>
                            </div>
                            <div
                                id="spouse_fields"
                                class="row"
                                t-attf-style="{{ '' if profile.marital == 'married' else 'display: none;' }}"
                            >
                                <div class="mb-3 col-lg-3">
                                    <label
                                        class="col-form-label"
                                        for="spouse_prefix"
                                    >Spouse Prefix</label>
                                    <input
                                        type="text"
                                        name="spouse_prefix"
                                        class="form-control"
                                        t-att-value="profile.spouse_prefix or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-3">
                                    <label
                                        class="col-form-label"
                                        for="spouse_first_name"
                                    >Spouse First Name</label>
                                    <input
                                        type="text"
                                        name="spouse_first_name"
                                        class="form-control"
                                        t-att-value="profile.spouse_first_name or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-3">
                                    <label
                                        class="col-form-label"
                                        for="spouse_middle_name"
                                    >Spouse Middle Name</label>
                                    <input
                                        type="text"
                                        name="spouse_middle_name"
                                        class="form-control"
                                        t-att-value="profile.spouse_middle_name or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-3">
                                    <label
                                        class="col-form-label"
                                        for="spouse_last_name"
                                    >Spouse Last Name</label>
                                    <input
                                        type="text"
                                        name="spouse_last_name"
                                        class="form-control"
                                        t-att-value="profile.spouse_last_name or ''"
                                    />
                                </div>
                            </div>
                            <script>
                                document.getElementById('marital').addEventListener('change', function() {
                                    document.getElementById('spouse_fields').style.display = this.value === 'married' ? '' : 'none';
                                });
                            </script>
                        </div>
                    </div>

                    <!-- Emergency Contact -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Emergency Contact</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="emergency_contact_name"
                                    >Name</label>
                                    <input
                                        type="text"
                                        name="emergency_contact_name"
                                        class="form-control"
                                        t-att-value="profile.emergency_contact_name or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="emergency_contact_relation"
                                    >Relation</label>
                                    <input
                                        type="text"
                                        name="emergency_contact_relation"
                                        class="form-control"
                                        t-att-value="profile.emergency_contact_relation or ''"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="emergency_contact_phone"
                                    >Phone</label>
                                    <input
                                        type="tel"
                                        name="emergency_contact_phone"
                                        class="form-control"
                                        t-att-value="profile.emergency_contact_phone or ''"
                                    />
                                </div>
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="emergency_contact_email"
                                    >Email</label>
                                    <input
                                        type="email"
                                        name="emergency_contact_email"
                                        class="form-control"
                                        t-att-value="profile.emergency_contact_email or ''"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Health -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Health</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label
                                    class="col-form-label"
                                    for="chronic_disease"
                                >Chronic Disease</label>
                                <textarea
                                    name="chronic_disease"
                                    class="form-control"
                                    rows="3"
                                ><t t-esc="profile.chronic_disease or ''" /></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Academic -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Academic Position</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="academic_position"
                                    >Position</label>
                                    <select
                                        name="academic_position"
                                        class="form-select"
                                    >
                                        <option value="">-- Select --</option>
                                        <option
                                            value="professor"
                                            t-att-selected="profile.academic_position == 'professor' or None"
                                        >Professor</option>
                                        <option
                                            value="associate_professor"
                                            t-att-selected="profile.academic_position == 'associate_professor' or None"
                                        >Associate Professor</option>
                                        <option
                                            value="assistant_professor"
                                            t-att-selected="profile.academic_position == 'assistant_professor' or None"
                                        >Assistant Professor</option>
                                        <option
                                            value="lecturer"
                                            t-att-selected="profile.academic_position == 'lecturer' or None"
                                        >Lecturer</option>
                                    </select>
                                </div>
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                        for="academic_position_date"
                                    >Appointed Date</label>
                                    <input
                                        type="date"
                                        name="academic_position_date"
                                        class="form-control"
                                        t-att-value="profile.academic_position_date or ''"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- OCSC -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">OCSC</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <div class="form-check">
                                        <input
                                            type="checkbox"
                                            name="has_ocsc_exam"
                                            class="form-check-input"
                                            id="has_ocsc_exam"
                                            t-att-checked="profile.has_ocsc_exam or None"
                                        />
                                        <label
                                            class="form-check-label"
                                            for="has_ocsc_exam"
                                        >Has OCSC Exam</label>
                                    </div>
                                </div>
                            </div>
                            <div
                                id="ocsc_exam_details"
                                t-attf-style="{{ '' if profile.has_ocsc_exam else 'display: none;' }}"
                            >
                                <div class="row">
                                    <div class="mb-3 col-lg-4">
                                        <label
                                            class="col-form-label"
                                            for="ocsc_exam_level"
                                        >Exam Level</label>
                                        <select
                                            name="ocsc_exam_level"
                                            class="form-select"
                                        >
                                            <option value="">-- Select --</option>
                                            <option
                                                value="bachelor"
                                                t-att-selected="profile.ocsc_exam_level == 'bachelor' or None"
                                            >Bachelor</option>
                                            <option
                                                value="master"
                                                t-att-selected="profile.ocsc_exam_level == 'master' or None"
                                            >Master</option>
                                        </select>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label
                                            class="col-form-label"
                                            for="ocsc_exam_date"
                                        >Exam Date</label>
                                        <input
                                            type="date"
                                            name="ocsc_exam_date"
                                            class="form-control"
                                            t-att-value="profile.ocsc_exam_date or ''"
                                        />
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label
                                            class="col-form-label"
                                            for="ocsc_exam_number"
                                        >Exam Number</label>
                                        <input
                                            type="text"
                                            name="ocsc_exam_number"
                                            class="form-control"
                                            t-att-value="profile.ocsc_exam_number or ''"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <script>
                            document.getElementById('has_ocsc_exam').addEventListener('change', function() {
                                document.getElementById('ocsc_exam_details').style.display = this.checked ? '' : 'none';
                            });
                        </script>
                    </div>

                    <!-- Education History -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Education History</h5>
                        </div>
                        <div class="card-body">
                            <t
                                t-foreach="[('doctor', 'Doctoral Degree'), ('master', 'Master\'s Degree'), ('bachelor', 'Bachelor\'s Degree'), ('under_bachelor', 'Under Bachelor\'s Degree')]"
                                t-as="edu_level"
                            >
                                <t t-set="edu_key" t-value="edu_level[0]" />
                                <t t-set="edu_label" t-value="edu_level[1]" />
                                <t
                                    t-set="edu_rec"
                                    t-value="education_by_level.get(edu_key)"
                                />
                                <h6 class="mt-3"><t t-esc="edu_label" /></h6>
                                <div class="row">
                                    <div class="mb-3 col-lg-6">
                                        <label class="col-form-label">Program</label>
                                        <input
                                            type="text"
                                            t-attf-name="edu_#{edu_key}_program"
                                            class="form-control"
                                            t-att-value="edu_rec.program if edu_rec else ''"
                                        />
                                    </div>
                                    <div class="mb-3 col-lg-6">
                                        <label class="col-form-label">Major</label>
                                        <input
                                            type="text"
                                            t-attf-name="edu_#{edu_key}_major"
                                            class="form-control"
                                            t-att-value="edu_rec.major if edu_rec else ''"
                                        />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-lg-4">
                                        <label
                                            class="col-form-label"
                                        >Institution</label>
                                        <input
                                            type="text"
                                            t-attf-name="edu_#{edu_key}_institution"
                                            class="form-control"
                                            t-att-value="edu_rec.institution if edu_rec else ''"
                                        />
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label class="col-form-label">Country</label>
                                        <select
                                            t-attf-name="edu_#{edu_key}_country_id"
                                            class="form-select"
                                        >
                                            <option value="">-- Select --</option>
                                            <t
                                                t-foreach="countries or []"
                                                t-as="country"
                                            >
                                                <option
                                                    t-att-value="country.id"
                                                    t-att-selected="edu_rec and country.id == edu_rec.country_id.id or None"
                                                >
                                                    <t t-esc="country.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label
                                            class="col-form-label"
                                        >Graduation Date</label>
                                        <input
                                            type="date"
                                            t-attf-name="edu_#{edu_key}_graduation_date"
                                            class="form-control"
                                            t-att-value="edu_rec.graduation_date if edu_rec else ''"
                                        />
                                    </div>
                                </div>
                                <hr t-if="not edu_level_last" />
                            </t>
                        </div>
                    </div>

                    <!-- Work History -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Work History</h5>
                        </div>
                        <div class="card-body">
                            <t t-if="profile.work_history_ids">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Company</th>
                                            <th>Job Title / Description</th>
                                            <th>Salary</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Duration</th>
                                            <th />
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t
                                            t-foreach="profile.work_history_ids"
                                            t-as="wh"
                                        >
                                            <tr>
                                                <td><t t-esc="wh.company_name" /></td>
                                                <td><t t-esc="wh.job_title" /></td>
                                                <td><t
                                                        t-esc="'{:,.0f}'.format(wh.salary)"
                                                        t-if="wh.salary"
                                                    /></td>
                                                <td><t t-esc="wh.date_start" /></td>
                                                <td><t
                                                        t-esc="wh.date_end or 'Present'"
                                                    /></td>
                                                <td><t t-esc="wh.duration" /></td>
                                                <td>
                                                    <a
                                                        t-attf-href="/my/profile/work_history/delete?id=#{wh.id}"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Are you sure?');"
                                                    >
                                                        <i class="fa fa-trash" />
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="text-muted">No work history records.</p>
                            </t>
                            <hr />
                            <h6>Add Work History</h6>
                            <div class="row">
                                <div class="mb-3 col-lg-6">
                                    <label class="col-form-label">Company</label>
                                    <input
                                        type="text"
                                        name="wh_company_name"
                                        class="form-control"
                                    />
                                </div>
                                <div class="mb-3 col-lg-6">
                                    <label
                                        class="col-form-label"
                                    >Job Title / Description</label>
                                    <input
                                        type="text"
                                        name="wh_job_title"
                                        class="form-control"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-lg-4">
                                    <label class="col-form-label">Salary</label>
                                    <input
                                        type="number"
                                        name="wh_salary"
                                        class="form-control"
                                        step="0.01"
                                    />
                                </div>
                                <div class="mb-3 col-lg-4">
                                    <label class="col-form-label">Start Date</label>
                                    <input
                                        type="date"
                                        name="wh_date_start"
                                        class="form-control"
                                    />
                                </div>
                                <div class="mb-3 col-lg-4">
                                    <label class="col-form-label">End Date</label>
                                    <input
                                        type="date"
