<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">

        <!-- เจ้าหน้าที่งานแผน (หน่วยงาน) — add procurement plan user access -->
        <record id="budget_role.role_planning_officer_department" model="res.users.role">
            <field
                name="implied_ids"
                eval="[(4, ref('procurement_plan.group_procurement_plan_user'))]"
            />
        </record>

        <!-- เจ้าหน้าที่งานแผน (แอดมิน) — add procurement plan manager access -->
        <record id="budget_role.role_planning_officer_admin" model="res.users.role">
            <field
                name="implied_ids"
                eval="[(4, ref('procurement_plan.group_procurement_plan_manager'))]"
            />
        </record>

    </data>
</odoo>
