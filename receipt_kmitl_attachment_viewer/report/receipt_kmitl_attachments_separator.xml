<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Separator page printed before each receipt's attachments when a
        remittance's whole batch of attachments is combined into one PDF
        (kmitl.receipt.remittance._build_attachments_pdf).
    -->
    <template id="report_receipt_kmitl_attachments_separator_document">
        <t t-call="web.basic_layout">
            <div class="page">
                <h2>ใบเสร็จ / Receipt <span t-field="o.name"/></h2>
                <div>
                    <strong>ผู้จ่าย / Payer: </strong>
                    <span t-esc="o.customer_name or (o.partner_id and o.partner_id.name) or ''"/>
                </div>
                <div>
                    <strong>จำนวนเงิน / Amount: </strong>
                    <span t-esc="'{:,.2f}'.format(o.amount_total)"/>
                </div>
                <t t-set="skipped" t-value="(skipped_map or {}).get(str(o.id), [])"/>
                <div t-if="skipped" class="mt16">
                    <strong>ไฟล์แนบที่ไม่รองรับ (ข้าม) / Unsupported attachments (skipped):</strong>
                    <ul>
                        <li t-foreach="skipped" t-as="fname" t-esc="fname"/>
                    </ul>
                </div>
            </div>
        </t>
    </template>

    <template id="report_receipt_kmitl_attachments_separator">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="receipt_kmitl_attachment_viewer.report_receipt_kmitl_attachments_separator_document"/>
            </t>
        </t>
    </template>

    <template id="report_receipt_kmitl_no_attachments">
        <t t-call="web.html_container">
            <div class="page text-center" style="margin-top: 300px;">
                <h2>ไม่มีไฟล์แนบ / No attachments</h2>
            </div>
        </t>
    </template>

    <record id="action_report_receipt_kmitl_attachments_separator" model="ir.actions.report">
        <field name="name">Receipt Attachments Separator</field>
        <field name="model">kmitl.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">receipt_kmitl_attachment_viewer.report_receipt_kmitl_attachments_separator</field>
        <field name="report_file">receipt_kmitl_attachment_viewer.report_receipt_kmitl_attachments_separator</field>
        <field name="paperformat_id" ref="receipt_kmitl.paperformat_receipt_kmitl"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_receipt_kmitl_no_attachments" model="ir.actions.report">
        <field name="name">Receipt Remittance No Attachments</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">receipt_kmitl_attachment_viewer.report_receipt_kmitl_no_attachments</field>
        <field name="report_file">receipt_kmitl_attachment_viewer.report_receipt_kmitl_no_attachments</field>
        <field name="paperformat_id" ref="receipt_kmitl.paperformat_receipt_kmitl"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
