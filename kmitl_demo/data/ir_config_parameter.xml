<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ปิดการสมัครสมาชิก -->
    <function
        model="ir.config_parameter"
        name="set_param"
        eval="('auth_signup.invitation_scope', 'b2b')"
    />
    <!-- ปิด Reset Password -->
    <function
        model="ir.config_parameter"
        name="set_param"
        eval="('auth_signup.reset_password', 'False')"
    />
    <!-- เปิดให้จองงบติดลบได้ -->
    <record id="demo_budget_allow_negative" model="ir.config_parameter">
        <field name="key">budget.allow_negative</field>
        <field name="value" eval="True" />
    </record>
</odoo>
