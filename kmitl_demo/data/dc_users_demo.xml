        <record id="portal_user_greenarrow" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_oliver_queen_portal"/>
            <field name="login">greenarrow</field>
            <field name="password">greenarrow</field>
            <field name="signature"><![CDATA[<span>-- <br/>Oliver Queen<br/>CEO, Queen Industries</span>]]></field>
            <field name="groups_id" eval="[Command.clear()]"/>
        </record>

        <record id="base.group_portal" model="res.groups">
            <field name="users" eval="[Command.link(ref('portal_user_greenarrow'))]"/>
