        <!-- Portal User - Oliver Queen (Green Arrow) -->
        <record id="partner_oliver_queen_portal" model="res.partner">
            <field name="name">Oliver Queen</field>
            <field name="company_name">Queen Industries</field>
            <field name="street">1500 Queen Street</field>
            <field name="city">Star City</field>
            <field name="state_id" model="res.country.state" search="[('code','ilike','WA')]"/>
            <field name="zip">98101</field>
            <field name="country_id" ref="base.us"/>
