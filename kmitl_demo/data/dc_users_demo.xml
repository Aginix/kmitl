<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Bruce Wayne (Batman) -->
        <record id="partner_bruce_wayne" model="res.partner">
            <field name="name">Bruce Wayne</field>
            <field name="company_name">Wayne Enterprises</field>
            <field name="street">1007 Mountain Drive</field>
            <field name="city">Gotham City</field>
            <field name="state_id" model="res.country.state" search="[('code','ilike','NJ')]"/>
            <field name="zip">08701</field>
            <field name="country_id" ref="base.us"/>
            <field name="tz">America/New_York</field>
            <field name="email">bruce.wayne@wayneenterprises.com</field>
            <field name="phone">(555) 123-4567</field>
            <field name="function">CEO</field>
        </record>

        <record id="user_batman" model="res.users">
            <field name="partner_id" ref="partner_bruce_wayne"/>
            <field name="login">batman</field>
            <field name="password">batman</field>
            <field name="signature" type="html"><span>-- <br/>Bruce Wayne<br/>CEO, Wayne Enterprises</span></field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[Command.set([ref('base.group_system'), ref('base.group_partner_manager')])]"/>
        </record>

