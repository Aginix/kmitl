<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The banks the institute itself pays from are reference data in
         account_kmitl (Finance ▸ Settings ▸ Banks); these are the extra ones
         demo vendors bank at. -->
    <!-- Thai Commercial Banks -->
    <record id="bank_bbl" model="res.bank">
        <field name="name">ธนาคารกรุงเทพ (Bangkok Bank)</field>
        <field name="bic">BKKBTHBK</field>
        <field name="street">333 ถนนสีลม</field>
        <field name="city">กรุงเทพมหานคร</field>
        <field name="zip">10500</field>
        <field name="country" ref="base.th" />
    </record>

    <record id="bank_tmb" model="res.bank">
        <field name="name">ธนาคารทหารไทยธนชาต (TMBThanachart Bank)</field>
        <field name="bic">TMBKTHBK</field>
        <field name="street">3000 ถนนพหลโยธิน</field>
        <field name="city">กรุงเทพมหานคร</field>
        <field name="zip">10900</field>
        <field name="country" ref="base.th" />
    </record>

    <record id="bank_cimb" model="res.bank">
        <field name="name">ธนาคารซีไอเอ็มบีไทย (CIMB Thai Bank)</field>
        <field name="bic">UBOBTHBK</field>
        <field name="street">44 ถนนหลังสวน</field>
        <field name="city">กรุงเทพมหานคร</field>
        <field name="zip">10330</field>
        <field name="country" ref="base.th" />
    </record>

</odoo>
