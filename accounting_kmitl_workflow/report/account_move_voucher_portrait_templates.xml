<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ใบสำคัญรายการบัญชี ฉบับแนวตั้ง — the portrait voucher laid out like the
        form the accounting office files (ใบสำคัญตั้งเจ้าหนี้). The landscape
        report_account_move_voucher stays as it is; this one sits beside it.
    -->
    <template id="report_account_move_voucher_portrait">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang='th_TH')"/>
                <t t-set="thai" t-value="o.env['thai.date.mixin']"/>
                <t t-set="lines" t-value="o._kmitl_voucher_lines()"/>
                <t t-set="dims" t-value="o._kmitl_voucher_dimensions()"/>
                <t t-set="no_dim" t-value="o.env['account.analytic.account']"/>
                <t t-set="dept" t-value="dims.get('departments', no_dim)"/>
                <t t-set="dept_root" t-value="o._kmitl_voucher_ancestors(dept)[:1]"/>
                <t t-set="title" t-value="{'in_invoice': 'ใบสำคัญตั้งเจ้าหนี้', 'out_invoice': 'ใบสำคัญตั้งลูกหนี้'}.get(o.move_type, 'ใบสำคัญรายการบัญชี')"/>
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .kv-p { font-family: "THSarabunNew", Arial, sans-serif; font-size: 15pt; color: #000; line-height: 1.05; }
                            .kv-p div, .kv-p span, .kv-p td, .kv-p th { line-height: 1.05; }
                            /* The forms are borderless; override any report-wide table grid. */
                            .kv-p table, .kv-p thead, .kv-p tbody, .kv-p tr, .kv-p th, .kv-p td { border: 0 !important; }
                            .kv-p .ctr { text-align: center; }
                            .kv-p .num { text-align: right; white-space: nowrap; }
                            .kv-p .b { font-weight: 700; }
                            .kv-p .dot { display: inline-block; white-space: nowrap; min-width: 150px; border-bottom: 1px dotted #000; padding: 0 4px; vertical-align: baseline; }
                            .kv-p .dot.wide { min-width: 300px; }

                            /* Header */
                            .kv-p .kv-faculty { text-align: right; }
                            .kv-p .kv-org { font-size: 18pt; font-weight: 700; }
                            .kv-p .kv-title { font-size: 18pt; font-weight: 700; display: inline-block; padding-bottom: 4px; border-bottom: 2px solid #000; margin-bottom: 8px; }

                            /* Key / value */
                            .kv-p table.kv { width: 100%; }
                            .kv-p table.kv td { padding: 0 2px !important; vertical-align: bottom; }
                            .kv-p table.kv td.lbl { white-space: nowrap; text-align: right; width: 1%; }

                            /* Budget details — the same table as the DR (disbursement_sarabun). */
                            .kv-p table.budget { width: 100%; border-collapse: collapse; }
                            .kv-p table.budget td { border: 1px solid #bfbfbf !important; padding: 2px 4px !important; vertical-align: top; }
                            .kv-p table.budget td:first-child { width: 30%; }

                            /* Accounting lines */
                            .kv-p table.items { width: 100%; margin-top: 10px; }
                            .kv-p table.items th { font-weight: 700; padding: 2px 4px !important; }
                            .kv-p table.items td { padding: 1px 4px !important; vertical-align: top; }
                            /* Grey grid like the budget table; only the header is darker. */
                            .kv-p table.items td { border: 1px solid #bfbfbf !important; }
                            .kv-p table.items th { border: 1px solid #808080 !important; background-color: #e9e9e9; }
                            .kv-p table.items tr.total td { font-weight: 700; }

                            /* Signatures */
                            .kv-p table.sign { width: 100%; margin-top: 14px; page-break-inside: avoid; }
                            .kv-p table.sign td { width: 50%; text-align: center; vertical-align: top; padding: 0 6px !important; }
                            /* Same signature size as the sarabun signature block. */
                            .kv-p .sig-space { height: 60px; }
                            .kv-p .sig-space img { max-height: 60px; }
                            .kv-p .sig-date { font-size: 13pt; }
                        </style>

                        <div class="kv-p">

                            <!-- Header -->
                            <div class="kv-faculty">คณะ/สำนัก : <span t-out="dept_root.name or ''"/></div>
                            <div class="ctr">
                                <div class="kv-org" t-out="o.company_id.name"/>
                                <div class="kv-title" t-out="title"/>
                            </div>

                            <!-- Document numbers -->
                            <table class="kv">
                                <tr>
                                    <td style="width: 50%;"/>
                                    <td class="lbl">เลขที่ใบสำคัญ :</td>
                                    <td><span class="dot" t-out="o.name if o.name != '/' else ''"/></td>
                                </tr>
                                <tr>
                                    <td/>
                                    <td class="lbl">เลขที่อ้างอิง :</td>
                                    <td><span class="dot" t-out="o.ref or ''"/></td>
                                </tr>
                            </table>

                            <!-- Meta -->
                            <table class="kv mt-2">
                                <tr>
                                    <td class="lbl">วันที่พิมพ์รายงาน :</td>
                                    <td><span class="dot" t-out="thai.format_date_thai(context_timestamp(datetime.datetime.now())).replace('พ.ศ. ', '')"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">ผู้ขาย/ผู้ซื้อ/ผู้เบิก :</td>
                                    <td><span class="dot wide" t-out="o.partner_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">ประเภทรายการ :</td>
                                    <td><span class="dot wide" t-out="o.journal_id.name"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">วันที่ตั้งหนี้ :</td>
                                    <td><span class="dot" t-out="thai.format_date_thai(o.invoice_date or o.date).replace('พ.ศ. ', '')"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">วันที่ครบกำหนด :</td>
                                    <td><span class="dot" t-out="thai.format_date_thai(o.invoice_date_due).replace('พ.ศ. ', '') if o.is_invoice(include_receipts=True) else ''"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">มูลค่า :</td>
                                    <td><span class="dot" t-out="'{:,.2f}'.format(sum(lines.mapped('debit')))"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">รหัสงบประมาณ :</td>
                                    <td><span class="dot" t-out="', '.join(dict.fromkeys(lines.filtered(lambda l: l.analytic_distribution and l.account_id.internal_group in ('expense', 'income')).mapped('account_id.code')))"/></td>
                                </tr>
                            </table>

                            <!-- Financial dimensions, shown as the DR shows them: each
                                 account by its display name, "[code] parent / … / child". -->
                            <div class="mt-3 mb-1">รายละเอียดงบประมาณ</div>
                            <table class="budget">
                                <tr t-foreach="[('sources', 'แหล่งเงิน'), ('departments', 'ส่วนงาน'), ('funds', 'กองทุน'), ('activities', 'ด้าน/แผนงาน/กิจกรรม'), ('kmitl_project', 'โครงการ')]" t-as="row">
                                    <td t-out="row[1]"/>
                                    <td t-out="dims.get(row[0], no_dim).display_name or ''"/>
                                </tr>
                                <tr>
                                    <td>หลักสูตร/สาขาวิชา</td>
                                    <td/>
                                </tr>
                            </table>

                            <!-- Accounting lines -->
                            <table class="items">
                                <thead style="display: table-header-group;">
                                    <tr>
                                        <th class="ctr" style="width: 17%;">รหัสบัญชี</th>
                                        <th class="ctr" style="width: 53%;">รายการ</th>
                                        <th class="ctr" style="width: 15%;">เดบิต</th>
                                        <th class="ctr" style="width: 15%;">เครดิต</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="lines" t-as="line">
                                        <td t-out="line.account_id.code"/>
                                        <td t-out="line.account_id.name"/>
                                        <td class="num" t-out="'{:,.2f}'.format(line.debit) if line.debit else ''"/>
                                        <td class="num" t-out="'{:,.2f}'.format(line.credit) if line.credit else ''"/>
                                    </tr>
                                    <tr class="total">
                                        <td/>
                                        <td class="ctr">(<span t-out="o.currency_id.with_context(lang='th_TH').amount_to_text(sum(lines.mapped('debit')))"/>)</td>
                                        <td class="num" t-out="'{:,.2f}'.format(sum(lines.mapped('debit')))"/>
                                        <td class="num" t-out="'{:,.2f}'.format(sum(lines.mapped('credit')))"/>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Narration -->
                            <div class="mt-2">
                                <span class="b">หมายเหตุ</span>
                                <t t-if="not is_html_empty(o.narration)"><span t-field="o.narration"/></t>
                            </div>

                            <!-- Workflow signatures: the maker both prepares and checks
                                 (ผู้จัดทำ/ผู้ตรวจสอบ), the approver posts. Each signs only
                                 by their own act: the maker while the entry stays submitted
                                 (a recalled or rejected draft keeps submitted_by), the
                                 approver once approved. Printed with the employee's own signature
                                 image, Thai name and position, as on the paper form. -->
                            <t t-set="maker" t-value="o.submitted_by if o.state in ('submitted', 'posted') else o.submitted_by.browse()"/>
                            <table class="sign">
                                <tr>
                                    <td><div class="b">ผู้จัดทำ/ผู้ตรวจสอบ</div></td>
                                    <td><div class="b">ผู้อนุมัติการบันทึกบัญชี</div></td>
                                </tr>
                                <tr>
                                    <t t-foreach="[(maker, o.submitted_date), (o.approved_by, o.approved_date)]" t-as="signer">
                                        <t t-set="emp" t-value="signer[0].employee_id"/>
                                        <td>
                                            <div class="sig-space"><img t-if="signer[0] and emp.signature" t-att-src="image_data_uri(emp.signature)" alt="signature"/></div>
                                            <div>( <span t-out="emp.name or signer[0].name or '…………………………………'"/> )</div>
                                            <div t-if="signer[0]" t-out="emp.job_title or emp.job_id.name or ''"/>
                                            <div t-if="signer[0]" class="sig-date" t-out="thai.format_datetime_thai_sign(signer[1])"/>
                                        </td>
                                    </t>
                                </tr>
                            </table>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
