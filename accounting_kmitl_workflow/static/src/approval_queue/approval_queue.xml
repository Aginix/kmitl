<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="accounting_kmitl_workflow.MultiRecordSelect" owl="1">
        <div class="o_kmitl_ms" t-ref="root">
            <div class="o_kmitl_ms_box form-control">
                <span t-foreach="selected" t-as="rec" t-key="rec.id"
                      class="badge text-bg-primary o_kmitl_ms_tag">
                    <t t-esc="rec.name"/>
                    <span class="o_kmitl_ms_x" t-on-click="() => this.remove(rec.id)">×</span>
                </span>
                <input t-if="inputVisible" type="text" class="o_kmitl_ms_input"
                       t-att-placeholder="props.placeholder"
                       t-att-value="state.query"
                       t-on-focus="onFocus"
                       t-on-input="onInput"/>
            </div>
            <div class="o_kmitl_ms_dropdown" t-if="state.open and state.options.length">
                <div t-foreach="state.options" t-as="opt" t-key="opt.id"
                     class="o_kmitl_ms_option" t-on-click="() => this.add(opt)">
                    <t t-esc="opt.name"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="accounting_kmitl_workflow.ApprovalQueue" owl="1">
        <div class="o_approval_queue o_action_manager p-3">
            <div class="d-flex align-items-center mb-3">
                <h2 class="me-auto mb-0"><t t-esc="labels.title"/></h2>
                <button class="btn btn-primary" t-att-disabled="!state.selectedIds.length"
                        t-on-click="approveSelected">
                    <t t-esc="labels.approveSelected"/>
                    (<t t-esc="state.selectedIds.length"/>)
                </button>
            </div>

            <!-- Filter bar (mirrors the trial-balance report) -->
            <div class="o_aq_filters row g-2 mb-3">
                <div class="col-md-3">
                    <label class="o_form_label"><t t-esc="labels.fiscalYear"/></label>
                    <select class="form-select" t-on-change="onFiscalYearChange">
                        <option value="">/</option>
                        <option t-foreach="fiscalYears" t-as="fy" t-key="fy.id"
                                t-att-value="fy.id"
                                t-att-selected="isFiscalYearSelected(fy.id)">
                            <t t-esc="fy.name"/>
                        </option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="o_form_label"><t t-esc="labels.dateFrom"/></label>
                    <input type="date" class="form-control"
                           t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                </div>
                <div class="col-md-2">
                    <label class="o_form_label"><t t-esc="labels.dateTo"/></label>
                    <input type="date" class="form-control"
                           t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>

                <div class="col-md-3">
                    <label class="o_form_label"><t t-esc="labels.departments"/></label>
                    <MultiRecordSelect resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'departments']]"
                        placeholder="labels.departments" selected="state.departments"
                        onChange="(sel) => this.onSelectionChange('departments', sel)"/>
                </div>
                <div class="col-md-3">
                    <label class="o_form_label"><t t-esc="labels.sources"/></label>
                    <MultiRecordSelect resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'sources']]"
                        placeholder="labels.sources" selected="state.sources"
                        onChange="(sel) => this.onSelectionChange('sources', sel)"/>
                </div>
                <div class="col-md-3">
                    <label class="o_form_label"><t t-esc="labels.funds"/></label>
                    <MultiRecordSelect resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'funds']]"
                        placeholder="labels.funds" selected="state.funds"
                        onChange="(sel) => this.onSelectionChange('funds', sel)"/>
                </div>
                <div class="col-md-3">
                    <label class="o_form_label"><t t-esc="labels.activities"/></label>
                    <MultiRecordSelect resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'activities']]"
                        placeholder="labels.activities" selected="state.activities"
                        onChange="(sel) => this.onSelectionChange('activities', sel)"/>
                </div>

                <div class="col-12">
                    <button class="btn btn-link p-0" t-on-click="toggleAdvanced">
                        <i t-att-class="state.showAdvanced ? 'fa fa-caret-down me-1' : 'fa fa-caret-right me-1'"/>
                        <t t-if="state.showAdvanced"><t t-esc="labels.hideFilters"/></t>
                        <t t-else=""><t t-esc="labels.moreFilters"/></t>
                    </button>
                </div>
                <t t-if="state.showAdvanced">
                    <div class="col-md-3">
                        <label class="o_form_label"><t t-esc="labels.journals"/></label>
                        <MultiRecordSelect resModel="'account.journal'"
                            domain="[['company_id', '=', companyId]]"
                            placeholder="labels.journals" selected="state.journals"
                            onChange="(sel) => this.onSelectionChange('journals', sel)"/>
                    </div>
                    <div class="col-md-3">
                        <label class="o_form_label"><t t-esc="labels.partners"/></label>
                        <MultiRecordSelect resModel="'res.partner'"
                            placeholder="labels.partners" selected="state.partners"
                            onChange="(sel) => this.onSelectionChange('partners', sel)"/>
                    </div>
                </t>
            </div>

            <t t-if="state.loading">
                <div class="text-center p-5">
                    <span class="spinner-border" role="status"/>
                </div>
            </t>
            <t t-elif="!state.moves.length">
                <div class="text-center text-muted p-5">
                    <t t-esc="labels.empty"/>
                </div>
            </t>
            <t t-else="">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 32px;">
                                <input type="checkbox" t-att-checked="allSelected"
                                       t-on-click.stop="toggleSelectAll"/>
                            </th>
                            <th style="width: 24px;"/>
                            <th><t t-esc="labels.number"/></th>
                            <th><t t-esc="labels.date"/></th>
                            <th><t t-esc="labels.partner"/></th>
                            <th><t t-esc="labels.journal"/></th>
                            <th><t t-esc="labels.submittedBy"/></th>
                            <th class="text-end"><t t-esc="labels.total"/></th>
                            <th class="text-end"><t t-esc="labels.actions"/></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.moves" t-as="move" t-key="move.id">
                            <tr class="o_aq_row" t-on-click="() => this.toggleExpand(move)">
                                <td>
                                    <input type="checkbox" t-att-checked="isSelected(move.id)"
                                           t-on-click.stop="() => this.toggleSelect(move.id)"/>
                                </td>
                                <td>
                                    <i class="fa" t-att-class="state.expandedId === move.id ? 'fa-caret-down' : 'fa-caret-right'"/>
                                </td>
                                <td t-esc="move.name"/>
                                <td t-esc="move.date"/>
                                <td t-esc="displayName(move.partner_id)"/>
                                <td t-esc="displayName(move.journal_id)"/>
                                <td t-esc="displayName(move.submitted_by)"/>
                                <td class="text-end" t-esc="formatCurrency(move.amount_total)"/>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            t-on-click.stop="() => this.openMove(move)">
                                        <i class="fa fa-external-link me-1"/><t t-esc="labels.open"/>
                                    </button>
                                    <button class="btn btn-sm btn-success me-1"
                                            t-on-click.stop="() => this.approve(move)">
                                        <t t-esc="labels.approve"/>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            t-on-click.stop="() => this.reject(move)">
                                        <t t-esc="labels.reject"/>
                                    </button>
                                </td>
                            </tr>
                            <tr t-if="state.expandedId === move.id" class="o_aq_detail">
                                <td colspan="9" class="p-0">
                                    <div class="p-3 bg-light border-top">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <div><strong><t t-esc="labels.date"/>:</strong> <t t-esc="move.date"/></div>
                                                <div><strong><t t-esc="labels.submitted"/>:</strong>
                                                    <t t-esc="displayName(move.submitted_by)"/> <t t-esc="move.submitted_date"/></div>
                                            </div>
                                            <div class="col-md-6">
                                                <div><strong><t t-esc="labels.department"/>:</strong> <t t-esc="displayName(move.department_analytic_id)"/></div>
                                                <div><strong><t t-esc="labels.source"/>:</strong> <t t-esc="displayName(move.source_analytic_id)"/></div>
                                                <div><strong><t t-esc="labels.fund"/>:</strong> <t t-esc="displayName(move.fund_analytic_id)"/></div>
                                                <div><strong><t t-esc="labels.activity"/>:</strong> <t t-esc="displayName(move.activity_analytic_id)"/></div>
                                            </div>
                                        </div>
                                        <div t-if="plainText(move.narration)" class="mb-2">
                                            <strong><t t-esc="labels.narration"/>:</strong> <t t-esc="plainText(move.narration)"/>
                                        </div>
                                        <table class="table table-sm table-bordered mb-0 bg-white">
                                            <thead>
                                                <tr>
                                                    <th><t t-esc="labels.account"/></th>
                                                    <th><t t-esc="labels.label"/></th>
                                                    <th class="text-end"><t t-esc="labels.debit"/></th>
                                                    <th class="text-end"><t t-esc="labels.credit"/></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="state.linesByMove[move.id] || []" t-as="line" t-key="line.id">
                                                    <tr>
                                                        <td t-esc="displayName(line.account_id)"/>
                                                        <td t-esc="line.name"/>
                                                        <td class="text-end" t-esc="formatCurrency(line.debit)"/>
                                                        <td class="text-end" t-esc="formatCurrency(line.credit)"/>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </div>
    </t>

</templates>
