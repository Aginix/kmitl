<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Auditor (ผู้ตรวจสอบการเบิกจ่าย) — the payment audit station.
         root/admin are members so the route is operable out of the box (same
         convention as group_disbursement_manager / group_finance_kmitl_manager). -->
    <record id="group_disbursement_payment_auditor" model="res.groups">
        <field name="name">Disbursement Auditor</field>
        <field name="category_id" ref="disbursement_finance_kmitl.module_category_disbursement_payment" />
        <field name="implied_ids" eval="[(4, ref('disbursement.group_disbursement_user'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
</odoo>
