<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_support_request_form_sarabun" model="ir.ui.view">
        <field name="name">budget.support.request.form.sarabun</field>
        <field name="model">budget.support.request</field>
        <field name="inherit_id" ref="budget_support_request.view_budget_support_request_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sarabun_document_count" invisible="1"/>
                <field name="sarabun_has_live_document" invisible="1"/>
                <button type="object" name="action_view_sarabun_documents"
                        class="oe_stat_button" icon="fa-file-text-o"
                        attrs="{'invisible': [('sarabun_document_count', '=', 0)]}"
                        string="หนังสือ"/>
            </xpath>

            <xpath expr="//button[@name='action_submit']" position="after">
                <button name="action_submit_to_sarabun" type="object"
                        string="สร้างหนังสือ" class="btn-primary"
                        attrs="{'invisible': ['|', ('state', '!=', 'submitted'), ('sarabun_has_live_document', '=', True)]}"/>
            </xpath>

            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,submitted,sent,approved,in_progress,done</attribute>
            </xpath>

            <xpath expr="//widget[@name='web_ribbon'][1]" position="before">
                <widget name="web_ribbon" title="Returned" bg_color="bg-warning" attrs="{'invisible': [('state', '!=', 'returned')]}"/>
                <widget name="web_ribbon" title="Rejected" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
            </xpath>

            <!-- Sarabun status notification — rendered between the statusbar
                 and the sheet (out of the form body). -->
            <xpath expr="//header" position="after">
                <field name="sarabun_is_draft" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1"/>
                    หนังสือสารบรรณถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                    <button name="action_view_sarabun_documents" type="object"
                            class="btn btn-sm btn-warning ms-2" string="เปิดหนังสือเพื่อส่ง"/>
                </div>
                <div class="alert alert-info mb-2" role="alert"
                     attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1"/>
                    สถานะการเดินหนังสือสารบรรณ: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>

        </field>
    </record>

    <record id="view_budget_support_request_tree_sarabun" model="ir.ui.view">
        <field name="name">budget.support.request.tree.sarabun</field>
        <field name="model">budget.support.request</field>
        <field name="inherit_id" ref="budget_support_request.view_budget_support_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-info">state == 'sent'</attribute>
                <attribute name="decoration-muted">state == 'returned'</attribute>
                <attribute name="decoration-danger">state in ('rejected', 'cancelled')</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-info">state == 'sent'</attribute>
                <attribute name="decoration-muted">state == 'returned'</attribute>
                <attribute name="decoration-danger">state in ('rejected', 'cancelled')</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_budget_support_request_search_sarabun" model="ir.ui.view">
        <field name="name">budget.support.request.search.sarabun</field>
        <field name="model">budget.support.request</field>
        <field name="inherit_id" ref="budget_support_request.view_budget_support_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='pending_approval']" position="after">
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
            </xpath>
            <xpath expr="//filter[@name='cancelled']" position="before">
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

</odoo>
