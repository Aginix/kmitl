#: code:addons/budget_support_request_sarabun/models/budget_support_request.py:0
#, python-format
msgid ""
"This request has a letter out for signature. Recall or void it before "
"cancelling."
msgstr ""
"คำขอนี้มีหนังสืออยู่ระหว่างเวียนลงนาม "
"กรุณาดึงกลับหรือยกเลิกการส่งหนังสือก่อนยกเลิกคำขอ"

#. module: budget_support_request_sarabun
#. odoo-python
#: code:addons/budget_support_request_sarabun/models/budget_support_request.py:0
#: code:addons/budget_support_request_sarabun/models/budget_support_request.py:0
#, python-format
msgid ""
"This request has a letter out for signature. Recall or void it before "
"resetting to draft."
msgstr ""
"คำขอนี้มีหนังสืออยู่ระหว่างเวียนลงนาม "
"กรุณาดึงกลับหรือยกเลิกการส่งหนังสือก่อนนำคำขอกลับเป็นแบบร่าง"

#. module: budget_support_request_sarabun
#: model:ir.model.fields,help:budget_support_request_sarabun.field_budget_support_request__sarabun_has_live_document
msgid ""
"True while a non-terminal Document exists "
"(draft/circulating/completed/returned). Gate the 'create หนังสือ' button on "
"this — NOT on sarabun_document_count — so a fresh one can be issued after a "
"terminal outcome (rejected/cancelled), while a returned doc is revised in "
"place."
msgstr ""
"เป็นจริงเมื่อยังมีหนังสือที่ยังไม่สิ้นสุด "
"(ร่าง/กำลังเวียน/เสร็จสมบูรณ์/ตีกลับ) ใช้ควบคุมปุ่ม 'สร้างหนังสือ' (ไม่ใช่ "
"sarabun_document_count) เพื่อให้ออกหนังสือฉบับใหม่ได้หลังหนังสือสิ้นสุด "
"(ปฏิเสธ/ยกเลิก) ส่วนหนังสือที่ถูกตีกลับให้แก้ไขในฉบับเดิม"

