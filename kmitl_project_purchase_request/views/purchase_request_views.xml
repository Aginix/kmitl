<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Purchase request form - the requester names the project it is bought
         under (จัดซื้อภายใต้, root ADR-0011) + link back to it -->
    <record id="view_purchase_request_form_kmitl_project" model="ir.ui.view">
        <field name="name">view.purchase.request.form (KMITL Project)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_budget.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_selection_mode']" position="after">
                <field
                    name="kmitl_project_id"
                    options="{'no_create': True, 'no_open': True}"
                    attrs="{'invisible': [('budget_selection_mode', '!=', 'project')], 'required': [('budget_selection_mode', '=', 'project'), ('is_procurement_under_editable', '=', True)], 'readonly': [('is_procurement_under_editable', '=', False)]}"
                />
                <field
                    name="kmitl_project_remaining"
                    attrs="{'invisible': [('kmitl_project_id', '=', False)]}"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="use_project" invisible="1" />
                <button
                    name="action_view_kmitl_project"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-folder-open-o"
                    attrs="{'invisible': [('kmitl_project_id', '=', False)]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">โครงการ/กิจกรรม</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- No project_analytic_id on the form: the four financial dimensions are
         shown only for the ผังงบประมาณ source, and a project พ.1's dimensions —
         including its own โครงการ/กิจกรรม dimension — are read off the
         budget_commitment_info card instead (budget ADR-0010). -->

</odoo>
