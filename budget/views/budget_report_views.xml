<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget Report Form View -->
    <record id="budget_report_form_view" model="ir.ui.view">
        <field name="name">budget.report.form</field>
        <field name="model">budget.report</field>
        <field name="arch" type="xml">
            <form string="Budget Report">
                <header>
                    <button name="action_generate_report" string="Generate Report" type="object" class="oe_highlight"/>
                    <button name="action_export_excel" string="Export to Excel" type="object"/>
                    <button name="action_print_report" string="Print" type="object"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Budget Report"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Report Configuration">
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="date_range_fy_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Display Options">
                            <field name="group_by_level"/>
                            <field name="show_hierarchy"/>
                            <field name="hide_zero_amounts"/>
                            <field name="include_commitments"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Filters">
                            <group>
                                <group string="Analytic Filters">
                                    <field name="activity_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="department_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="fund_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="source_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                                <group string="Budget Filters">
                                    <field name="budget_account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="budget_type"/>
                                </group>
                            </group>
                        </page>

                        <page string="Report Results">
                            <group>
                                <group string="Summary Totals">
                                    <field name="total_budget"/>
                                    <field name="total_actual"/>
                                    <field name="total_commitment"/>
                                    <field name="total_available"/>
                                </group>
                            </group>

                            <field name="line_ids">
                                <tree string="Report Lines" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="line_type"/>
                                    <field name="budget_amount" sum="Budget"/>
                                    <field name="actual_amount" sum="Actual"/>
                                    <field name="commitment_amount" sum="Commitment"/>
                                    <field name="available_amount" sum="Available"/>
                                    <field name="variance_amount" sum="Variance"/>
                                    <field name="variance_percentage" widget="percentage"/>
                                    <field name="utilization_percentage" widget="percentage"/>
                                    <button name="action_drill_down" string="Drill Down" type="object" icon="fa-search-plus"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Budget Report Tree View -->
    <record id="budget_report_tree_view" model="ir.ui.view">
        <field name="name">budget.report.tree</field>
        <field name="model">budget.report</field>
        <field name="arch" type="xml">
            <tree string="Budget Reports">
                <field name="name"/>
                <field name="report_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_budget" sum="Total Budget"/>
                <field name="total_actual" sum="Total Actual"/>
                <field name="total_commitment" sum="Total Commitment"/>
                <field name="total_available" sum="Total Available"/>
            </tree>
        </field>
    </record>

    <!-- Budget Report Search View -->
    <record id="budget_report_search_view" model="ir.ui.view">
        <field name="name">budget.report.search</field>
        <field name="model">budget.report</field>
        <field name="arch" type="xml">
            <search string="Budget Reports">
                <field name="name"/>
                <field name="report_type"/>
                <field name="date_range_fy_id"/>

                <group expand="0" string="Group By">
                    <filter string="Report Type" name="group_type" context="{'group_by': 'report_type'}"/>
                    <filter string="Fiscal Year" name="group_fy" context="{'group_by': 'date_range_fy_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Budget Report Action -->
    <record id="budget_report_action" model="ir.actions.act_window">
        <field name="name">Budget Reports</field>
        <field name="res_model">budget.report</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="budget_report_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget report!
            </p>
            <p>
                Budget reports provide comprehensive analysis of your budget data with multiple
                dimensions and flexible filtering options.
            </p>
        </field>
    </record>

    <!-- Budget Report Line Tree View (for detailed drill-down) -->
    <record id="budget_report_line_tree_view" model="ir.ui.view">
        <field name="name">budget.report.line.tree</field>
        <field name="model">budget.report.line</field>
        <field name="arch" type="xml">
            <tree string="Report Lines" create="false" edit="false">
                <field name="name"/>
                <field name="level"/>
                <field name="line_type" widget="badge"/>
                <field name="budget_amount" sum="Budget"/>
                <field name="actual_amount" sum="Actual"/>
                <field name="commitment_amount" sum="Commitment"/>
                <field name="available_amount" sum="Available"/>
                <field name="variance_amount" sum="Variance"/>
                <field name="variance_percentage" widget="percentage"/>
                <field name="utilization_percentage" widget="percentage"/>
                <field name="activity_analytic_id"/>
                <field name="department_analytic_id"/>
                <field name="fund_analytic_id"/>
                <field name="budget_account_id"/>
                <button name="action_drill_down" string="Details" type="object" icon="fa-search-plus"/>
                <button name="action_view_commitments" string="Commitments" type="object" icon="fa-bookmark"/>
            </tree>
        </field>
    </record>

    <!-- Budget Report Action for Wizard -->
    <record id="budget_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Generate Budget Report</field>
        <field name="res_model">budget.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_name': 'Budget Report'}</field>
    </record>

    <!-- Menu Items -->

    <menuitem id="budget_report_generate_menu"
              name="Generate Report"
              parent="budget_reporting_menu"
              action="budget_report_wizard_action"
              sequence="10"/>

    <menuitem id="budget_report_list_menu"
              name="View Reports"
              parent="budget_reporting_menu"
              action="budget_report_action"
              sequence="20"/>

</odoo>
