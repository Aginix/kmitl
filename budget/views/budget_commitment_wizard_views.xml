<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="budget_commitment_amount_wizard_form" model="ir.ui.view">
        <field name="name">budget.commitment.amount.wizard.form</field>
        <field name="model">budget.commitment.amount.wizard</field>
        <field name="arch" type="xml">
            <form string="Budget Commitment Amount">
                <group>
                    <field name="commitment_id" invisible="1"/>
                    <field name="wizard_type" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="remaining_amount" readonly="1" attrs="{'invisible': [('wizard_type', '!=', 'obligate')]}"/>
                    <field name="obligated_amount" readonly="1" attrs="{'invisible': [('wizard_type', '!=', 'consume')]}"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
