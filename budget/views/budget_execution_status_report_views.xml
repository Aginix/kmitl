<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget Execution Status Report Wizard Form View -->
    <record id="budget_execution_status_report_form_view" model="ir.ui.view">
        <field name="name">budget.execution.status.report.form</field>
        <field name="model">budget.execution.status.report</field>
        <field name="arch" type="xml">
            <form string="Budget Execution Status Report">
                <header>
                    <button name="action_generate_report" string="Generate Report" type="object" class="oe_highlight"/>
                    <button name="action_export_excel" string="Export to Excel" type="object"/>
                    <button name="action_print_report" string="Print Report" type="object"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Budget Execution Status Report"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Report Configuration">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="date_range_fy_id" options="{'no_create': True}"/>
                            <field name="budget_type"/>
                        </group>
                        <group string="Summary Totals">
                            <field name="total_initial_appropriation" widget="monetary"/>
                            <field name="total_current_budget" widget="monetary"/>
                            <field name="total_used" widget="monetary"/>
                            <field name="total_remaining" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Filters">
                            <group>
                                <group string="Analytic Filters">
                                    <field name="activity_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="department_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="fund_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="source_analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                                <group string="Budget Filters">
                                    <field name="budget_account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Report Results">
                            <group>
                                <group string="Summary Statistics">
                                    <field name="total_requested" widget="monetary"/>
                                    <field name="total_reserved" widget="monetary"/>
                                    <field name="total_obligated" widget="monetary"/>
                                    <field name="total_disbursed" widget="monetary"/>
                                    <field name="total_returned" widget="monetary"/>
                                </group>
                            </group>

                            <field name="line_ids">
                                <tree string="Budget Execution Status" create="false" edit="false" decoration-danger="remaining_budget &lt; 0" decoration-warning="utilization_percentage &gt; 90">
                                    <field name="budget_account_code"/>
                                    <field name="budget_account_name"/>
                                    <field name="activity_code"/>
                                    <field name="fund_code"/>
                                    <field name="initial_appropriation" sum="Total Initial"/>
                                    <field name="current_budget" sum="Total Current"/>
                                    <field name="total_requested" sum="Total Requested"/>
                                    <field name="reserved_amount" sum="Total Reserved"/>
                                    <field name="obligated_amount" sum="Total Obligated"/>
                                    <field name="disbursed_amount" sum="Total Disbursed"/>
                                    <field name="total_used" sum="Total Used"/>
                                    <field name="remaining_budget" sum="Total Remaining"/>
                                    <field name="utilization_percentage" widget="percentage"/>
                                    <field name="returned_amount" sum="Total Returned"/>
                                    <button name="action_view_budget_moves" string="Moves" type="object" icon="fa-list"/>
                                    <button name="action_view_commitments" string="Commitments" type="object" icon="fa-bookmark"/>
                                    <button name="action_view_appropriations" string="Appropriations" type="object" icon="fa-plus-circle"/>
                                    <button name="action_view_disbursements" string="Disbursements" type="object" icon="fa-money"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Budget Execution Status Report Tree View -->
    <record id="budget_execution_status_report_tree_view" model="ir.ui.view">
        <field name="name">budget.execution.status.report.tree</field>
        <field name="model">budget.execution.status.report</field>
        <field name="arch" type="xml">
            <tree string="Budget Execution Status Reports">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date_range_fy_id"/>
                <field name="total_current_budget" sum="Total Budget"/>
                <field name="total_used" sum="Total Used"/>
                <field name="total_remaining" sum="Total Remaining"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Budget Execution Status Report Search View -->
    <record id="budget_execution_status_report_search_view" model="ir.ui.view">
        <field name="name">budget.execution.status.report.search</field>
        <field name="model">budget.execution.status.report</field>
        <field name="arch" type="xml">
            <search string="Budget Execution Status Reports">
                <field name="name"/>
                <field name="date_range_fy_id"/>
                <field name="budget_type"/>

                <filter string="Current Fiscal Year" name="current_fy"
                        domain="[('date_range_fy_id.date_from', '&lt;=', context_today()), ('date_range_fy_id.date_to', '&gt;=', context_today())]"/>

                <group expand="0" string="Group By">
                    <filter string="Fiscal Year" name="group_fy" context="{'group_by': 'date_range_fy_id'}"/>
                    <filter string="Budget Type" name="group_type" context="{'group_by': 'budget_type'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Budget Execution Status Line Tree View (for detailed view) -->
    <record id="budget_execution_status_line_tree_view" model="ir.ui.view">
        <field name="name">budget.execution.status.line.tree</field>
        <field name="model">budget.execution.status.line</field>
        <field name="arch" type="xml">
            <tree string="Budget Execution Status Details" create="false" edit="false" decoration-danger="remaining_budget &lt; 0" decoration-warning="utilization_percentage &gt; 90" decoration-info="utilization_percentage &gt; 75">
                <field name="budget_account_code"/>
                <field name="budget_account_name"/>
                <field name="activity_code"/>
                <field name="activity_name"/>
                <field name="department_code"/>
                <field name="fund_code"/>
                <field name="fund_name"/>
                <field name="source_code"/>

                <!-- The 9 required status categories -->
                <field name="initial_appropriation" sum="งบประมาณจัดสรรต้นปี"/>
                <field name="current_budget" sum="งบประมาณ (a)"/>
                <field name="total_requested" sum="ขอใช้ทั้งหมด"/>
                <field name="reserved_amount" sum="จองเงิน (b)"/>
                <field name="obligated_amount" sum="ผูกพัน (c)"/>
                <field name="disbursed_amount" sum="เบิกจ่ายแล้ว (d)"/>
                <field name="total_used" sum="รวม (e)"/>
                <field name="remaining_budget" sum="งบประมาณคงเหลือ (f)"/>
                <field name="returned_amount" sum="ส่งคืนเงินเหลือจ่าย"/>

                <!-- Percentage indicators -->
                <field name="utilization_percentage" widget="percentage"/>
                <field name="disbursed_percentage" widget="percentage"/>

                <!-- Action buttons -->
                <button name="action_view_budget_moves" string="All Moves" type="object" icon="fa-list"/>
                <button name="action_view_commitments" string="Commitments" type="object" icon="fa-bookmark"/>
                <button name="action_view_appropriations" string="Appropriations" type="object" icon="fa-plus-circle"/>
                <button name="action_view_disbursements" string="Disbursements" type="object" icon="fa-money"/>
            </tree>
        </field>
    </record>

    <!-- Budget Execution Status Line Form View -->
    <record id="budget_execution_status_line_form_view" model="ir.ui.view">
        <field name="name">budget.execution.status.line.form</field>
        <field name="model">budget.execution.status.line</field>
        <field name="arch" type="xml">
            <form string="Budget Execution Status Detail">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_budget_moves" icon="fa-list">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Budget</span>
                                <span class="o_stat_text">Moves</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_commitments" icon="fa-bookmark">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Budget</span>
                                <span class="o_stat_text">Commitments</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group string="Budget Account">
                            <field name="budget_account_id"/>
                            <field name="budget_account_code"/>
                            <field name="budget_account_name"/>
                        </group>
                        <group string="Analytics">
                            <field name="activity_analytic_id"/>
                            <field name="department_analytic_id"/>
                            <field name="fund_analytic_id"/>
                            <field name="source_analytic_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Budget Status">
                            <group>
                                <group string="Budget Allocation">
                                    <field name="initial_appropriation" widget="monetary"/>
                                    <field name="current_budget" widget="monetary"/>
                                    <field name="total_requested" widget="monetary"/>
                                </group>
                                <group string="Budget Usage">
                                    <field name="reserved_amount" widget="monetary"/>
                                    <field name="obligated_amount" widget="monetary"/>
                                    <field name="disbursed_amount" widget="monetary"/>
                                    <field name="total_used" widget="monetary"/>
                                </group>
                            </group>

                            <group>
                                <group string="Budget Balance">
                                    <field name="remaining_budget" widget="monetary"/>
                                    <field name="returned_amount" widget="monetary"/>
                                </group>
                                <group string="Utilization">
                                    <field name="utilization_percentage" widget="percentage"/>
                                    <field name="reserved_percentage" widget="percentage"/>
                                    <field name="obligated_percentage" widget="percentage"/>
                                    <field name="disbursed_percentage" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Budget Execution Status Report Action -->
    <record id="action_budget_execution_status_report" model="ir.actions.act_window">
        <field name="name">Budget Execution Status Report</field>
        <field name="res_model">budget.execution.status.report</field>
        <field name="view_mode">form,tree</field>
        <field name="view_id" ref="budget_execution_status_report_form_view"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate Budget Execution Status Report
            </p>
            <p>
                Track budget through all execution stages from appropriation to disbursement.
                Monitor reserved, obligated, and disbursed amounts with detailed analytics.
            </p>
        </field>
    </record>

    <!-- Budget Execution Status Report Wizard Action -->
    <record id="action_budget_execution_status_wizard" model="ir.actions.act_window">
        <field name="name">Generate Budget Execution Status Report</field>
        <field name="res_model">budget.execution.status.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_name': 'Budget Execution Status Report'}</field>
    </record>

    <!-- Budget Execution Status Line Action -->
    <record id="action_budget_execution_status_line" model="ir.actions.act_window">
        <field name="name">Budget Execution Status Details</field>
        <field name="res_model">budget.execution.status.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="budget_execution_status_line_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No budget execution status data found!
            </p>
            <p>
                Generate a budget execution status report to see detailed budget tracking information.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="budget_execution_status_report_menu"
              name="รายงานสถานะการใช้งบประมาณ"
              parent="budget_reporting_menu"
              action="action_budget_execution_status_wizard"
              sequence="10"/>

    <menuitem id="budget_execution_status_report_list_menu"
              name="รายงานสถานะที่สร้างแล้ว"
              parent="budget_reporting_menu"
              action="action_budget_execution_status_report"
              sequence="15"/>

</odoo>
