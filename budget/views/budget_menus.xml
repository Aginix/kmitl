<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <menuitem id="budget_root_menu" name="Budgeting" sequence="10">

        <menuitem
            id="budget_appropriation_management"
            name="จัดสรรงบประมาณ"
            sequence="30"
        >
            <menuitem
                id="budget_appropriation_menu"
                name="การจัดสรรงบประมาณ"
                sequence="1"
            >
                <menuitem
                    id="action_view_move_budget_appropriation_type_menu_action"
                    name="รายการจัดการ"
                    action="action_view_move_budget_appropriation_type"
                />
                <menuitem
                    id="action_view_move_budget_appropriation_year_menu_action"
                    name="จัดสรรต้นปี"
                    action="action_view_move_budget_appropriation_type"
                />
            </menuitem>
        </menuitem>

        <menuitem id="budget_commitment_management" name="จองงบประมาณ" sequence="30">
            <menuitem id="budget_commitment_menu" name="จองงบประมาณ" sequence="1">
                <menuitem
                    id="action_budget_commitment_menu_action"
                    name="รายการจองงบประมาณ"
                    action="action_budget_commitment"
                />
            </menuitem>
        </menuitem>

        <menuitem id="budget_move" name="บัญชีงบประมาณ" sequence="40">
            <menuitem id="budget_move_menu" name="บัญชีงบประมาณ" sequence="1">
                <menuitem
                    id="action_budget_move_menu_action"
                    name="รายการบันทึกสมุดบัญชีงบประมาณ"
                    action="action_budget_move"
                />
                <menuitem
                    id="action_budget_move_line_menu_action"
                    name="รายการบันทึกสมุดบัญชีงบประมาณ (แบบแจกแจง)"
                    action="action_budget_move_line"
                />
            </menuitem>
        </menuitem>

        <menuitem id="budget_transfer_management" name="โอนงบประมาณ" sequence="50">
            <menuitem id="budget_transfer_menu" name="โอนงบประมาณ" sequence="1">
                <menuitem
                    id="action_my_budget_transfers_menu"
                    name="คำขอโอนงบประมาณของฉัน"
                    action="action_my_budget_transfers"
                    sequence="1"
                />
                <menuitem
                    id="action_budget_transfers_pending_menu"
                    name="รอการอนุมัติ"
                    action="action_budget_transfers_pending"
                    groups="budget.group_budget_transfer_approver"
                    sequence="2"
                />
                <menuitem
                    id="action_budget_transfer_menu"
                    name="คำขอโอนงบประมาณทั้งหมด"
                    action="action_budget_transfer"
                    groups="budget.group_budget_transfer_approver"
                    sequence="3"
                />
            </menuitem>
        </menuitem>

        <menuitem id="budget_reporting_menu" name="รายงาน" sequence="90" />
        <menuitem id="budget_config_menu" name="การกำหนดค่า" sequence="99" groups="budget.group_budget_manager">
            <menuitem
                id="action_budget_account_menu_action"
                name="รหัสงบประมาณ"
                action="action_budget_account"
            />
            <menuitem
                id="action_budget_journal_menu_action"
                name="ประเภทสมุดบัญชีงบประมาณ"
                action="action_budget_journal"
            />
        </menuitem>
    </menuitem>
</odoo>
