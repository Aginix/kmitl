<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View budget.procurement View Tree -->
    <record id="view_budget_procurement_tree" model="ir.ui.view">
        <field name="name">view.budget.procurement.tree</field>
        <field name="model">budget.procurement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View budget.procurement form -->
    <record id="view_budget_procurement_form" model="ir.ui.view">
        <field name="name">view.budget.procurement.form</field>
        <field name="model">budget.procurement</field>
        <field name="arch" type="xml">
            <form string="Budget Procurement">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View budget.procurement search -->
    <record id="view_budget_procurement_search" model="ir.ui.view">
        <field name="name">view.budget.procurement.search</field>
        <field name="model">budget.procurement</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action budget.procurement -->
    <record id="action_budget_procurement" model="ir.actions.act_window">
        <field name="name">Budget Procurement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">budget.procurement</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Budget Procurement.
            </p>
        </field>
    </record>

</odoo>
