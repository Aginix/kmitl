<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Budget Configuration Settings Form View -->
    <record id="res_config_settings_view_form_budget" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.budget</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Budget" string="Budget" data-key="budget" groups="budget.group_budget_manager">
                    <h2>การตั้งค่างบประมาณ</h2>
                    <div class="row mt16 o_settings_container" name="budget_settings">
                        <div class="col-12 col-lg-6 o_setting_box" id="budget_overview_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="budget_overview_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="budget_overview_enabled"/>
                                <div class="text-muted">
                                    แสดงหน้าภาพรวม (การ์ดตามประเภทงบ + การเคลื่อนไหวล่าสุด) เป็นหน้าแรกเมื่อเข้าโมดูลงบประมาณ — ปิดเพื่อซ่อนเมนูภาพรวม
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="budget_allow_negative_setting">
                            <div class="o_setting_left_pane">
                                <field name="budget_allow_negative"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="budget_allow_negative"/>
                                <div class="text-muted">
                                    อนุญาตให้มีรายการที่ทำให้งบประมาณติดลบ
                                </div>
                                <div class="content-group mt16" attrs="{'invisible': [('budget_allow_negative', '=', False)]}">
                                    <div class="text-warning">
                                        <i class="fa fa-warning" /> คำเตือน: การอนุญาตให้งบประมาณติดลบอาจทำให้เกิดปัญหาในการควบคุมงบประมาณ
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_budget_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'budget', 'bin_size': False}</field>
    </record>

    <!-- Menu item for Budget Settings -->
    <menuitem id="menu_budget_config_settings" name="การตั้งค่า" parent="budget.budget_config_menu" action="action_budget_configuration" sequence="0" groups="budget.group_budget_manager" />
</odoo>
