<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget Commitment Tree View -->
    <record id="budget_commitment_tree_view" model="ir.ui.view">
        <field name="name">budget.commitment.tree</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <tree string="Budget Commitments">
                <field name="name"/>
                <field name="date"/>
                <field name="date_range_fy_id"/>
                <field name="department_analytic_id"/>
                <field name="source_analytic_id"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="consumed_amount" sum="Consumed Amount"/>
                <field name="remaining_amount" sum="Remaining Amount"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('confirmed', 'reserved')" decoration-warning="state == 'draft'" decoration-danger="state == 'cancel'"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Budget Commitment Form View -->
    <record id="budget_commitment_form_view" model="ir.ui.view">
        <field name="name">budget.commitment.form</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <form string="Budget Commitment">
                <header>
                    <button name="action_check_budget_availability" string="Check Budget" type="object" class="btn-info" attrs="{'invisible': [('state', 'not in', ['draft', 'confirmed'])]}" help="Check budget availability for all commitment lines"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('show_confirm_button', '=', False), ('state', '!=', 'draft')]}"/>
                    <button name="action_reserve" string="Reserve Budget" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('show_reserve_button', '=', False), ('state', '!=', 'confirmed')]}"/>
                    <button name="action_done" string="Mark as Done" type="object" attrs="{'invisible': [('state', 'not in', ['consumed'])]}"/>
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" attrs="{'invisible': [('show_reset_to_draft_button', '=', False)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,reserved,consumed,done"/>
                </header>

                <field name="show_confirm_button" invisible="1"/>
                <field name="show_reserve_button" invisible="1"/>
                <field name="show_reset_to_draft_button" invisible="1"/>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_budget_moves" icon="fa-money">
                            <field string="Budget Moves" name="budget_move_ids" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="BC00001"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="ref"/>
                            <field name="description" placeholder="Commitment description..."/>
                        </group>
                        <group>
                            <field name="date_range_fy_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="department_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="source_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Commitment Lines">
                            <field name="line_ids">
                                <tree decoration-danger="budget_availability_status == 'insufficient'" decoration-warning="budget_availability_status == 'warning'" decoration-success="budget_availability_status == 'sufficient'">
                                    <field name="activity_analytic_id" options="{'no_create': True}"/>
                                    <field name="fund_analytic_id" options="{'no_create': True}"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="available_budget_amount" sum="Total Available" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="budget_availability_status" widget="badge" decoration-danger="budget_availability_status == 'insufficient'" decoration-warning="budget_availability_status == 'warning'" decoration-success="budget_availability_status == 'sufficient'"/>
                                    <field name="consumed_amount" sum="Consumed Amount"/>
                                    <field name="remaining_amount" sum="Remaining Amount" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <div class="alert alert-info" role="status">
                                <strong>Budget Availability Guide:</strong>
                                <ul class="mb-0">
                                    <li>
                                        <span class="badge badge-success">Sufficient</span> - Budget is available for this commitment</li>
                                    <li>
                                        <span class="badge badge-warning">Warning</span> - Less than 50% of commitment amount is available</li>
                                    <li>
                                        <span class="badge badge-danger">Insufficient</span> - Not enough budget available</li>
                                </ul>
                            </div>

                        </page>

                        <page string="Summary">
                            <group>
                                <group string="Amounts">
                                    <field name="total_amount"/>
                                    <field name="consumed_amount"/>
                                    <field name="remaining_amount"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Budget Commitment Search View -->
    <record id="budget_commitment_search_view" model="ir.ui.view">
        <field name="name">budget.commitment.search</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <search string="Budget Commitments">
                <field name="name"/>
                <field name="ref"/>
                <field name="department_analytic_id"/>
                <field name="source_analytic_id"/>
                <field name="user_id"/>
                <field name="date_range_fy_id"/>

                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Consumed" name="consumed" domain="[('state', '=', 'consumed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>

                <separator/>
                <filter string="My Commitments" name="my_commitments" domain="[('user_id', '=', uid)]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_analytic_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_analytic_id'}"/>
                    <filter string="Fiscal Year" name="group_fy" context="{'group_by': 'date_range_fy_id'}"/>
                    <filter string="Responsible User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Budget Commitment Line Form View -->
    <record id="budget_commitment_line_form_view" model="ir.ui.view">
        <field name="name">budget.commitment.line.form</field>
        <field name="model">budget.commitment.line</field>
        <field name="arch" type="xml">
            <form string="Budget Commitment Line">
                <group>
                    <group>
                        <field name="date_range_fy_id" readonly="1" />
                        <field name="department_analytic_id" readonly="1" />
                        <field name="source_analytic_id" readonly="1" />
                        <field name="activity_analytic_id" options="{'no_create': True}"/>
                        <field name="fund_analytic_id" options="{'no_create': True}"/>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="amount" widget="monetary"/>
                        <field name="notes"/>
                    </group>
                    <group>
                        <field name="available_budget_amount" sum="Total Available" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="budget_availability_status" widget="badge" decoration-danger="budget_availability_status == 'insufficient'" decoration-warning="budget_availability_status == 'warning'" decoration-success="budget_availability_status == 'sufficient'" />
                        <field name="consumed_amount" sum="Consumed Amount"/>
                        <field name="remaining_amount" sum="Remaining Amount" optional="show"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Budget Commitment Action -->
    <record id="action_budget_commitment" model="ir.actions.act_window">
        <field name="name">Budget Commitments</field>
        <field name="res_model">budget.commitment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="budget_commitment_search_view"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget commitment!
            </p>
            <p>
                Budget commitments allow you to reserve budget amounts for future spending.
                This helps with budget planning and ensures funds are available when needed.
            </p>
        </field>
    </record>

</odoo>
