<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget Commitment Tree View -->
    <record id="budget_commitment_tree_view" model="ir.ui.view">
        <field name="name">budget.commitment.tree</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <tree string="Budget Commitments">
                <field name="name" optional="show" />
                <field name="date" optional="hide" />
                <field name="account_fiscal_year_id" optional="show" />
                <field name="source_analytic_id"/>
                <field name="department_analytic_id"/>
                <field name="activity_analytic_id"/>
                <field name="fund_analytic_id"/>
                <field name="account_id"/>
                <field name="amount" sum="Total Amount"/>

                <field name="consumed_amount" sum="Consumed Amount" optional="show" />
                <field name="remaining_amount" sum="Remaining Amount" optional="show" />
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'reserved'" decoration-muted="state == 'obligated'" decoration-warning="state == 'draft'" decoration-danger="state == 'cancel'"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
            </tree>
        </field>
    </record>

    <!-- Budget Commitment Form View -->
    <record id="budget_commitment_form_view" model="ir.ui.view">
        <field name="name">budget.commitment.form</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <form string="Budget Commitment">
                <header>
                    <button name="action_check_budget_availability" string="Check Budget" type="object" class="btn-info" attrs="{'invisible': [('state', '!=', 'draft')]}" help="Check budget availability for this commitment"/>
                    <button name="action_reserve" string="Reserve Budget" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_obligate" string="Obligate Budget" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'reserved')]}" help="Mark this commitment as obligated - firm commitment"/>
                    <button name="action_done" string="Mark as Done" type="object" attrs="{'invisible': [('state', '!=', 'obligated')]}" help="Close this commitment and release any remaining budget"/>
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" attrs="{'invisible': [('state', 'not in', ['cancel'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reserved,obligated,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_budget_moves" icon="fa-money">
                            <field string="Budget Moves" name="budget_move_ids" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="date"/>
                            <field name="account_fiscal_year_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="ref"/>
                        </group>
                        <group string="Budget Details">
                            <field name="department_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="source_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="activity_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="fund_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="account_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Budget Analysis" name="budget_analysis">
                        <group>
                            <field name="consumed_amount" widget="monetary" readonly="1"/>
                            <field name="remaining_amount" widget="monetary" readonly="1"/>
                        </group>
                        <group attrs="{'invisible': [('state', '!=', 'draft')]}">
                            <field name="available_budget_amount" widget="monetary" decoration-danger="budget_availability_status == 'insufficient'" decoration-warning="budget_availability_status == 'warning'" decoration-success="budget_availability_status == 'sufficient'"/>
                            <field name="budget_availability_status" widget="badge" decoration-danger="budget_availability_status == 'insufficient'" decoration-warning="budget_availability_status == 'warning'" decoration-success="budget_availability_status == 'sufficient'"/>
                            <field name="budget_availability_percentage" widget="percentage"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="description" string="Description">
                            <group>
                                <group>
                                    <field name="description" placeholder="Commitment description..."/>
                                </group>
                                <group>
                                    <field name="notes" placeholder="Additional notes..."/>
                                </group>
                            </group>
                        </page>
                        <page name="extra" string="Extra Info">
                            <group>
                                <group></group>
                                <group></group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Budget Commitment Search View -->
    <record id="budget_commitment_search_view" model="ir.ui.view">
        <field name="name">budget.commitment.search</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <search string="Budget Commitments">
                <field name="name"/>
                <field name="ref"/>
                <field name="account_id"/>
                <field name="activity_analytic_id"/>
                <field name="department_analytic_id"/>
                <field name="fund_analytic_id"/>
                <field name="source_analytic_id"/>
                <field name="user_id"/>
                <field name="account_fiscal_year_id"/>

                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>

                <separator/>
                <filter string="My Commitments" name="my_commitments" domain="[('user_id', '=', uid)]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Budget Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Activity" name="group_activity" context="{'group_by': 'activity_analytic_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_analytic_id'}"/>
                    <filter string="Fund" name="group_fund" context="{'group_by': 'fund_analytic_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_analytic_id'}"/>
                    <filter string="Fiscal Year" name="group_fy" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter string="Responsible User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
                <searchpanel>
                    <field name="account_id" icon="fa-book" enable_counters="1" />
                    <field name="account_fiscal_year_id" icon="fa-calendar" enable_counters="1" />
                    <field name="source_analytic_id" icon="fa-money" enable_counters="1" order="code asc" />
                    <field name="department_analytic_id" icon="fa-users" enable_counters="1" order="code asc" />
                    <field name="activity_analytic_id" icon="fa-bullseye" enable_counters="1" order="code asc" />
                    <field name="fund_analytic_id" icon="fa-database" enable_counters="1" order="code asc" />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Budget Commitment Action -->
    <record id="action_budget_commitment" model="ir.actions.act_window">
        <field name="name">Budget Commitments</field>
        <field name="res_model">budget.commitment</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="budget_commitment_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget commitment!
            </p>
            <p>
                Budget commitments allow you to reserve budget amounts for future spending.
                This helps with budget planning and ensures funds are available when needed.
            </p>
        </field>
    </record>

</odoo>
