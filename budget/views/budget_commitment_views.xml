<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget Commitment Tree View -->
    <record id="budget_commitment_tree_view" model="ir.ui.view">
        <field name="name">budget.commitment.tree</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <tree string="Budget Commitments" decoration-danger="budget_availability_status == 'insufficient'" decoration-warning="budget_availability_status == 'warning'" decoration-success="budget_availability_status == 'sufficient'">
                <field name="name"/>
                <field name="date"/>
                <field name="date_range_fy_id"/>
                <field name="account_id"/>
                <field name="activity_analytic_id"/>
                <field name="department_analytic_id"/>
                <field name="fund_analytic_id"/>
                <field name="source_analytic_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="available_budget_amount" sum="Total Available" widget="monetary"/>
                <field name="budget_availability_status" widget="badge"
                       decoration-danger="budget_availability_status == 'insufficient'"
                       decoration-warning="budget_availability_status == 'warning'"
                       decoration-success="budget_availability_status == 'sufficient'"/>
                <field name="consumed_amount" sum="Consumed Amount"/>
                <field name="remaining_amount" sum="Remaining Amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('confirmed', 'reserved')"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancel'"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Budget Commitment Form View -->
    <record id="budget_commitment_form_view" model="ir.ui.view">
        <field name="name">budget.commitment.form</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <form string="Budget Commitment">
                <header>
                    <button name="action_check_budget_availability" string="Check Budget" type="object"
                            class="btn-info" attrs="{'invisible': [('state', 'not in', ['draft', 'confirmed'])]}"
                            help="Check budget availability for this commitment"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_reserve" string="Reserve Budget" type="object"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            attrs="{'invisible': [('state', 'not in', ['consumed'])]}"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            attrs="{'invisible': [('state', 'not in', ['cancel'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,reserved,consumed,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_budget_moves" icon="fa-money">
                            <field string="Budget Moves" name="budget_move_ids" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="BC00001"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="date"/>
                            <field name="date_range_fy_id" options="{'no_create': True}"/>
                            <field name="user_id"/>
                            <field name="ref"/>
                        </group>
                        <group string="Budget Details">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="4-Dimensional Analytics">
                        <group>
                            <field name="activity_analytic_id" options="{'no_create': True}"/>
                            <field name="fund_analytic_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="department_analytic_id" options="{'no_create': True}"/>
                            <field name="source_analytic_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group string="Budget Analysis" name="budget_analysis">
                        <group>
                            <field name="available_budget_amount" widget="monetary" 
                                   decoration-danger="budget_availability_status == 'insufficient'"
                                   decoration-warning="budget_availability_status == 'warning'"
                                   decoration-success="budget_availability_status == 'sufficient'"/>
                            <field name="budget_availability_status" widget="badge"
                                   decoration-danger="budget_availability_status == 'insufficient'"
                                   decoration-warning="budget_availability_status == 'warning'"
                                   decoration-success="budget_availability_status == 'sufficient'"/>
                            <field name="budget_availability_percentage" widget="percentage"/>
                        </group>
                        <group>
                            <field name="consumed_amount" widget="monetary" readonly="1"/>
                            <field name="remaining_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>

                    <group string="Additional Information">
                        <field name="description" placeholder="Commitment description..."/>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Budget Commitment Search View -->
    <record id="budget_commitment_search_view" model="ir.ui.view">
        <field name="name">budget.commitment.search</field>
        <field name="model">budget.commitment</field>
        <field name="arch" type="xml">
            <search string="Budget Commitments">
                <field name="name"/>
                <field name="ref"/>
                <field name="account_id"/>
                <field name="activity_analytic_id"/>
                <field name="department_analytic_id"/>
                <field name="fund_analytic_id"/>
                <field name="source_analytic_id"/>
                <field name="user_id"/>
                <field name="date_range_fy_id"/>

                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Consumed" name="consumed" domain="[('state', '=', 'consumed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>

                <separator/>
                <filter string="My Commitments" name="my_commitments" domain="[('user_id', '=', uid)]"/>
                <filter string="Insufficient Budget" name="insufficient" domain="[('budget_availability_status', '=', 'insufficient')]"/>
                <filter string="Warning Budget" name="warning" domain="[('budget_availability_status', '=', 'warning')]"/>
                <filter string="Sufficient Budget" name="sufficient" domain="[('budget_availability_status', '=', 'sufficient')]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Budget Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Activity" name="group_activity" context="{'group_by': 'activity_analytic_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_analytic_id'}"/>
                    <filter string="Fund" name="group_fund" context="{'group_by': 'fund_analytic_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_analytic_id'}"/>
                    <filter string="Fiscal Year" name="group_fy" context="{'group_by': 'date_range_fy_id'}"/>
                    <filter string="Responsible User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Budget Status" name="group_budget_status" context="{'group_by': 'budget_availability_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Budget Commitment Action -->
    <record id="action_budget_commitment" model="ir.actions.act_window">
        <field name="name">Budget Commitments</field>
        <field name="res_model">budget.commitment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="budget_commitment_search_view"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget commitment!
            </p>
            <p>
                Budget commitments allow you to reserve budget amounts for future spending.
                This helps with budget planning and ensures funds are available when needed.
            </p>
        </field>
    </record>

</odoo>