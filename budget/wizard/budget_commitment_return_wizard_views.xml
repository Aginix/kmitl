<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="budget_commitment_return_wizard_form" model="ir.ui.view">
        <field name="name">budget.commitment.return.wizard.form</field>
        <field name="model">budget.commitment.return.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งคืนเงินเหลือจ่าย" class="o_bcr_form">
                <!-- Read by the budget_commitment_return widget (record.data). -->
                <field name="commitment_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="step" invisible="1" />
                <field name="commitment_label" invisible="1" />
                <field name="commitment_dims" invisible="1" />
                <field name="total_reserved" invisible="1" />
                <field name="total_consumed" invisible="1" />
                <field name="available_to_consume" invisible="1" />
                <field name="return_amount" invisible="1" />
                <field name="returned_amount" invisible="1" />
                <field name="return_ref" invisible="1" />
                <field name="return_date" invisible="1" />
                <field name="return_user_id" invisible="1" />
                <widget name="budget_commitment_return" />
                <div
                    class="o_bcr_inputs"
                    attrs="{'invisible': [('step', '!=', 'review')]}"
                >
                    <group>
                        <field name="date" />
                        <field name="name" />
                    </group>
                </div>
                <footer>
                    <button
                        name="action_confirm"
                        string="ยืนยันส่งคืน"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('step', '!=', 'review')]}"
                    />
                    <button
                        string="ยกเลิก"
                        class="btn-secondary"
                        special="cancel"
                        attrs="{'invisible': [('step', '!=', 'review')]}"
                    />
                    <button
                        string="เสร็จสิ้น"
                        class="btn-primary"
                        special="cancel"
                        attrs="{'invisible': [('step', '!=', 'done')]}"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
