#. module: budget
#: model:mail.template,body_html:budget.email_template_budget_transfer_submitted
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear Budget Approver,\n"
"                    </p>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        A new budget transfer request has been submitted and requires your approval.\n"
"                    </p>\n"
"                    <br>\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F2F3; width:100%; margin: 16px 0px 16px 0px;\">\n"
"                        <tr>\n"
"                            <td style=\"background-color:#875A7B; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;\">\n"
"                                Transfer Details\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 16px 16px 16px 16px;\">\n"
"                                <table>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Transfer Number:</td>\n"
"                                        <td>{{ object.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Requested by:</td>\n"
"                                        <td>{{ object.user_id.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Date:</td>\n"
"                                        <td>{{ object.date }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Amount:</td>\n"
"                                        <td style=\"color: #875A7B; font-weight: bold;\">{{ object.amount | safe }} {{ object.currency_id.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Transfer Type:</td>\n"
"                                        <td>{{ dict(object._fields['transfer_type']._description_selection(object.env))[object.transfer_type] }}</td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    \n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F8F9FA; width:100%; margin: 16px 0px 16px 0px;\">\n"
"                        <tr>\n"
"                            <td style=\"background-color:#17A2B8; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;\">\n"
"                                Transfer Reason\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 16px 16px 16px 16px;\">\n"
"                                {{ object.reason | safe }}\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    \n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Please review and approve/reject this transfer request.\n"
"                    </p>\n"
"                    <br>\n"
"                    <div style=\"text-align: center;\">\n"
"                        <a href=\"/web#id=%7B%7B%20object.id%20%7D%7D&amp;model=budget.transfer&amp;view_type=form\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">\n"
"                            Review Transfer Request\n"
"                        </a>\n"
"                    </div>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Best regards,<br>\n"
"                        {{ user.name }}<br>\n"
"                        {{ user.company_id.name }}\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: budget
#: model:mail.template,body_html:budget.email_template_budget_transfer_approved
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear {{ object.user_id.name }},\n"
"                    </p>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Good news! Your budget transfer request has been approved.\n"
"                    </p>\n"
"                    <br>\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #D4F6E8; width:100%; margin: 16px 0px 16px 0px;\">\n"
"                        <tr>\n"
"                            <td style=\"background-color:#28A745; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;\">\n"
"                                ✓ Transfer Approved\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 16px 16px 16px 16px;\">\n"
"                                <table>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Transfer Number:</td>\n"
"                                        <td>{{ object.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Approved by:</td>\n"
"                                        <td>{{ object.approver_id.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Approval Date:</td>\n"
"                                        <td>{{ object.approval_date }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Amount:</td>\n"
"                                        <td style=\"color: #28A745; font-weight: bold;\">{{ object.amount | safe }} {{ object.currency_id.name }}</td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    \n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Your transfer is now ready to be posted. A manager will complete the posting process shortly.\n"
"                    </p>\n"
"                    <br>\n"
"                    <div style=\"text-align: center;\">\n"
"                        <a href=\"/web#id=%7B%7B%20object.id%20%7D%7D&amp;model=budget.transfer&amp;view_type=form\" style=\"background-color: #28A745; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">\n"
"                            View Transfer\n"
"                        </a>\n"
"                    </div>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Best regards,<br>\n"
"                        {{ user.name }}<br>\n"
"                        {{ user.company_id.name }}\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: budget
#: model:mail.template,body_html:budget.email_template_budget_transfer_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear {{ object.user_id.name }},\n"
"                    </p>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        We regret to inform you that your budget transfer request has been rejected.\n"
"                    </p>\n"
"                    <br>\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F8D7DA; width:100%; margin: 16px 0px 16px 0px;\">\n"
"                        <tr>\n"
"                            <td style=\"background-color:#DC3545; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;\">\n"
"                                ✗ Transfer Rejected\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 16px 16px 16px 16px;\">\n"
"                                <table>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Transfer Number:</td>\n"
"                                        <td>{{ object.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Rejected by:</td>\n"
"                                        <td>{{ object.approver_id.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Rejection Date:</td>\n"
"                                        <td>{{ object.approval_date }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Amount:</td>\n"
"                                        <td>{{ object.amount | safe }} {{ object.currency_id.name }}</td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    \n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #FFF3CD; width:100%; margin: 16px 0px 16px 0px;\">\n"
"                        <tr>\n"
"                            <td style=\"background-color:#856404; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;\">\n"
"                                Rejection Reason\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 16px 16px 16px 16px;\">\n"
"                                {{ object.rejection_reason | safe }}\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    \n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Please review the rejection reason and feel free to submit a new transfer request if needed.\n"
"                    </p>\n"
"                    <br>\n"
"                    <div style=\"text-align: center;\">\n"
"                        <a href=\"/web#id=%7B%7B%20object.id%20%7D%7D&amp;model=budget.transfer&amp;view_type=form\" style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">\n"
"                            View Transfer\n"
"                        </a>\n"
"                    </div>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Best regards,<br>\n"
"                        {{ user.name }}<br>\n"
"                        {{ user.company_id.name }}\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: budget
#: model:mail.template,body_html:budget.email_template_budget_transfer_posted
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear {{ object.user_id.name }},\n"
"                    </p>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Your budget transfer has been successfully completed and posted to the budget system.\n"
"                    </p>\n"
"                    <br>\n"
"                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #D1ECF1; width:100%; margin: 16px 0px 16px 0px;\">\n"
"                        <tr>\n"
"                            <td style=\"background-color:#17A2B8; padding: 8px 16px 8px 16px; font-weight: bold; color: #fff;\">\n"
"                                ✓ Transfer Completed\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"padding: 16px 16px 16px 16px;\">\n"
"                                <table>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Transfer Number:</td>\n"
"                                        <td>{{ object.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Amount:</td>\n"
"                                        <td style=\"color: #17A2B8; font-weight: bold;\">{{ object.amount | safe }} {{ object.currency_id.name }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Posted Date:</td>\n"
"                                        <td>{{ object.write_date }}</td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding-right: 20px; font-weight: bold;\">Budget Moves Created:</td>\n"
"                                        <td>{{ object.budget_move_ids | length }} move(s)</td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    \n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        The budget amounts have been successfully transferred and are now available for use in the destination accounts.\n"
"                    </p>\n"
"                    <br>\n"
"                    <div style=\"text-align: center;\">\n"
"                        <a href=\"/web#id=%7B%7B%20object.id%20%7D%7D&amp;model=budget.transfer&amp;view_type=form\" style=\"background-color: #17A2B8; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\">\n"
"                            View Transfer\n"
"                        </a>\n"
"                    </div>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Thank you for using the budget transfer system.\n"
"                    </p>\n"
"                    <br>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Best regards,<br>\n"
"                        Budget Management System<br>\n"
"                        {{ user.company_id.name }}\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

