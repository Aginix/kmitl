#: model_terms:ir.ui.view,arch_db:budget.budget_execution_status_report_document
msgid ""
"<small>\n"
"                                    <strong>หมายเหตุ:</strong><br/>\n"
"                                    - งบประมาณจัดสรรต้นปี: จำนวนงบประมาณที่ได้จากการจัดสรรงบประมาณต้นปี ไม่รวมการปรับปรุง/โอนเงิน<br/>\n"
"                                    - งบประมาณ (a): ยอดรวมงบประมาณที่มีการปรับปรุงล่าสุด<br/>\n"
"                                    - จองเงิน (b): เงินที่ได้รับจัดสรรตามแผน/เงินที่ขออนุมัติเบิกจ่าย<br/>\n"
"                                    - ผูกพัน (c): จำนวนเงินตามสัญญา/เงินยืม/รอเบิกจ่าย<br/>\n"
"                                    - เบิกจ่ายแล้ว (d): อนุมัติเบิกจ่าย/ลงบัญชีเรียบร้อยแล้ว<br/>\n"
"                                    - รวม (e) = (b) + (c) + (d)<br/>\n"
"                                    - งบประมาณคงเหลือ (f) = (a) - (e)\n"
"                                </small>"
msgstr ""

