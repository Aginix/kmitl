<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Budget Execution Status V2 Action -->
        <record id="action_budget_execution_status_v2" model="ir.actions.client">
            <field name="name">Budget Execution Status Report (V2)</field>
            <field name="tag">budget_execution_status_v2</field>
            <field name="target">main</field>
            <field name="context">{
                'search_default_current_fiscal_year': 1,
                'search_default_expense': 1,
            }</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_budget_execution_status_v2"
                  name="Execution Status (V2)"
                  parent="budget.menu_budget_reports"
                  action="action_budget_execution_status_v2"
                  sequence="15"/>
                  
        <!-- Add to Favorites by default -->
        <record id="filter_budget_execution_status_v2_default" model="ir.filters">
            <field name="name">Current Fiscal Year</field>
            <field name="model_id">budget.execution.status.report</field>
            <field name="user_id" eval="False"/>
            <field name="is_default" eval="True"/>
            <field name="action_id" ref="action_budget_execution_status_v2"/>
            <field name="context">{
                'search_default_current_fiscal_year': 1,
                'search_default_expense': 1,
            }</field>
        </record>
    </data>
</odoo>