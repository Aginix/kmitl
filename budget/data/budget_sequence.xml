<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_budget_commitment" model="ir.sequence">
            <field name="name">Budget Commitment</field>
            <field name="code">budget.commitment</field>
            <field name="prefix">BC</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">standard</field>
        </record>

        <record id="seq_type_budget_move" model="ir.sequence">
            <field name="name">Budget Move</field>
            <field name="code">budget.move</field>
            <field name="prefix">BM/%(year_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="active" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
