<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Exception rules for budget.selection.wizard
        =============================================
        These rules are evaluated when user clicks "บันทึก" in the wizard.

        Validation logic uses shared helpers from budget.exception.mixin,
        so any model inheriting the mixin can reuse the same checks
        in its own exception rules.

        Available helpers (from budget.exception.mixin):
            - self._get_budget_account() → budget.account record
            - self._has_5_digit_budget_code() → bool
    -->

    <record id="budget_selection_excep_5_digit_code" model="exception.rule">
        <field name="name">ไม่สามารถเลือกรหัสงบประมาณที่มี 5 หลักได้ กรุณาเลือกรหัสงบประมาณย่อย</field>
        <field name="description">รหัสงบประมาณ</field>
        <field name="model">budget.selection.wizard</field>
        <field name="exception_type">by_py_code</field>
        <field name="code"><![CDATA[
if self._has_5_digit_budget_code():
    failed = True
]]>
        </field>
    </record>
</odoo>
