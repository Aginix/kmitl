<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Budget Transfer Security Groups -->
        <record id="group_budget_transfer_user" model="res.groups">
            <field name="name">Budget Transfer User</field>
            <field name="category_id" ref="base.module_category_accounting_and_finance"/>
            <field name="comment">Can create and view own budget transfers</field>
        </record>
        
        <record id="group_budget_transfer_approver" model="res.groups">
            <field name="name">Budget Transfer Approver</field>
            <field name="category_id" ref="base.module_category_accounting_and_finance"/>
            <field name="implied_ids" eval="[(4, ref('group_budget_transfer_user'))]"/>
            <field name="comment">Can approve/reject budget transfers</field>
        </record>
        
        <record id="group_budget_transfer_manager" model="res.groups">
            <field name="name">Budget Transfer Manager</field>
            <field name="category_id" ref="base.module_category_accounting_and_finance"/>
            <field name="implied_ids" eval="[(4, ref('group_budget_transfer_approver'))]"/>
            <field name="comment">Full access to budget transfer management</field>
        </record>
        
        <!-- Add transfer groups to existing budget users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_budget_transfer_user'))]"/>
        </record>
        
    </data>
</odoo>