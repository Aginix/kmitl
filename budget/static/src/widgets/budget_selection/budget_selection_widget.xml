<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="budget.BudgetSelectionWidget" owl="1">
        <div class="budget_selection_widget">
            <button t-if="isEditable"
                class="btn btn-sm btn-primary mt-1"
                t-on-click="onSelectBudget">
                เลือกงบประมาณ
            </button>
            <table t-if="hasBudgetData" class="table table-sm table-borderless mb-1">
                <tr t-if="budgetAccountName">
                    <td class="text-muted" style="width: 160px;">รหัสงบประมาณ</td>
                    <td t-esc="budgetAccountName"/>
                </tr>
                <tr t-if="activityName">
                    <td class="text-muted py-2">ด้าน/แผนงาน/กิจกรรม</td>
                    <td class="py-2" t-esc="activityName"/>
                </tr>
                <tr t-if="departmentName">
                    <td class="text-muted py-2">ส่วนงาน</td>
                    <td class="py-2" t-esc="departmentName"/>
                </tr>
                <tr t-if="fundName">
                    <td class="text-muted py-2">กองทุน</td>
                    <td class="py-2" t-esc="fundName"/>
                </tr>
                <tr t-if="sourceName">
                    <td class="text-muted py-2">แหล่งเงิน</td>
                    <td class="py-2" t-esc="sourceName"/>
                </tr>
            </table>
            <span t-if="!hasBudgetData" class="text-muted">ยังไม่ได้เลือกงบประมาณ</span>

        </div>
    </t>

</templates>
