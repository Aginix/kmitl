<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="budget.BudgetReservationPicker" owl="1">
        <div class="o_budget_reservation_picker d-flex flex-column">
            <div t-if="state.loading" class="text-muted p-3">กำลังโหลด…</div>
            <div t-else="" class="o_brp_body flex-grow-1">
                <table class="table table-sm o_brp_table mb-0">
                    <thead>
                        <tr>
                            <th>รหัสงบประมาณ</th>
                            <th class="text-end o_brp_num">คงเหลือ</th>
                            <th class="text-end o_brp_num">
                                <t t-if="selectMode">เลือก</t>
                                <t t-else="">จองงบ</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="visibleRows" t-as="row" t-key="row.id">
                            <tr t-att-class="{
                                    'o_brp_group': row.has_children,
                                    'table-danger': isOver(row),
                                    'table-active': selectMode &amp;&amp; state.selectedId === row.id,
                                }">
                                <td t-att-style="'padding-left:' + (8 + row.level * 18) + 'px'">
                                    <span t-if="row.has_children" class="o_brp_toggle me-1"
                                          t-on-click="() => this.toggleRow(row)">
                                        <i t-att-class="state.collapsed[row.id] ? 'fa fa-caret-right' : 'fa fa-caret-down'"/>
                                    </span>
                                    <span class="fw-bold me-1" t-esc="row.code"/>
                                    <span t-esc="row.name"/>
                                    <span t-if="row.cross_chargeable" class="badge text-bg-light ms-1"
                                          title="ถัวจ่ายได้">ถัว</span>
                                </td>
                                <td class="text-end o_brp_num">
                                    <span t-if="row.available !== null" t-esc="format(row.available)"/>
                                </td>
                                <td class="text-end o_brp_num">
                                    <t t-if="row.selectable">
                                        <input t-if="selectMode" type="radio" name="o_brp_pick"
                                               class="o_brp_radio form-check-input"
                                               t-att-checked="state.selectedId === row.id"
                                               t-on-change="() => this.selectRow(row)"/>
                                        <input t-else="" type="number" min="0" step="0.01"
                                               class="o_brp_amount form-control form-control-sm text-end"
                                               t-att-value="state.amounts[row.id] || ''"
                                               t-on-input="(ev) => this.onAmountInput(row, ev)"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div class="o_brp_footer d-flex justify-content-end gap-2 p-2 border-top">
                <button class="btn btn-secondary" t-on-click="() => this.close()">ยกเลิก</button>
                <button class="btn btn-primary" t-on-click="() => this.confirm()">ยืนยัน</button>
            </div>
        </div>
    </t>

</templates>
