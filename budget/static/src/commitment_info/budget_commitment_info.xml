<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- The standard Many2one picker, with the selected reservation's details
         appended underneath as label | value rows. Values are the full
         "[code] complete_name" and wrap rather than truncate. -->
    <t
        t-name="budget.BudgetCommitmentInfoField"
        t-inherit="web.Many2OneField"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="." position="inside">
            <div t-if="info.data" class="o_budget_commitment_info mt-2">

                <div class="o_bci_header">
                    <span class="fw-semibold text-nowrap" t-esc="info.data.name" />
                    <span class="o_bci_title flex-grow-1" t-esc="info.data.title" />
                    <span class="o_bci_state" t-esc="info.data.state_label" />
                    <a
                        t-att-href="commitmentUrl()"
                        target="_blank"
                        class="o_bci_open"
                        title="เปิดใบจองในแท็บใหม่"
                    >
                        <i class="fa fa-external-link" />
                    </a>
                </div>

                <div class="o_bci_rows">
                    <div
                        t-foreach="info.data.rows"
                        t-as="row"
                        t-key="row_index"
                        class="o_bci_row"
                    >
                        <span class="o_bci_label" t-esc="row.label" />
                        <div class="o_bci_value">
                            <table t-if="row.lines" class="o_bci_lines">
                                <thead>
                                    <tr>
                                        <th>รหัสงบประมาณ</th>
                                        <th class="text-end">จำนวนเงิน</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr
                                        t-foreach="row.lines"
                                        t-as="line"
                                        t-key="line_index"
                                    >
                                        <td>
                                            <t
                                                t-call="budget.BudgetCommitmentInfoValue"
                                            >
                                                <t
                                                    t-set="bciValue"
                                                    t-value="line.value"
                                                />
                                            </t>
                                        </td>
                                        <td
                                            class="text-end text-nowrap"
                                            t-esc="line.amount"
                                        />
                                    </tr>
                                </tbody>
                            </table>
                            <t t-else="">
                                <t t-call="budget.BudgetCommitmentInfoValue">
                                    <t t-set="bciValue" t-value="row.value" />
                                </t>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="o_bci_amounts">
                    <div
                        t-foreach="info.data.amounts"
                        t-as="amount"
                        t-key="'amount_' + amount_index"
                        class="o_bci_amount"
                    >
                        <span class="o_bci_label" t-esc="amount.label" />
                        <span class="o_bci_money" t-esc="amount.value" />
                    </div>
                </div>

            </div>
        </xpath>
    </t>

    <t t-name="budget.BudgetCommitmentInfoValue" owl="1">
        <t t-set="parts" t-value="splitCode(bciValue)" />
        <span t-if="parts.code" class="o_bci_code">[<t t-esc="parts.code" />]</span>
        <span t-att-class="bciValue === '-' ? 'o_bci_empty' : ''" t-esc="parts.name" />
    </t>

</templates>
