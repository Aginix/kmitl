<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The standard Many2one picker, with the selected reservation's details
         appended underneath so the user can confirm they picked the right slip.

         Nothing is cut off: a value like "[5104010109] งบดำเนินงาน / ค่าวัสดุ /
         … / ค่าวัสดุคอมพิวเตอร์" is shown as its code and leaf name in bold, with
         the hierarchy path wrapped underneath in small text — the leaf is what
         the reader is checking, the path is context. Hierarchical values take a
         full-width row; short ones (ปีงบประมาณ) share a row. -->
    <t t-name="budget.BudgetCommitmentInfoField" t-inherit="web.Many2OneField"
        t-inherit-mode="primary" owl="1">
        <xpath expr="." position="inside">
            <div t-if="info.data" class="o_budget_commitment_info card mt-2">
                <div class="card-body p-2">

                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="fa fa-bookmark text-primary mt-1" title="ใบจองงบประมาณ"/>
                        <div class="flex-grow-1">
                            <strong t-esc="info.data.name"/>
                            <div t-if="info.data.title" class="o_budget_commitment_info_title"
                                t-esc="info.data.title"/>
                        </div>
                        <!-- bg-info + text-dark, not text-bg-info: Odoo 16 ships
                             Bootstrap 5.1.3 and text-bg-* only exists from 5.2. -->
                        <span class="badge rounded-pill bg-info text-dark text-nowrap"
                            t-esc="info.data.state_label"/>
                    </div>

                    <div class="row g-2">
                        <t t-foreach="info.data.rows" t-as="row" t-key="row_index">
                            <t t-set="parts" t-value="splitName(row.value)"/>
                            <div t-att-class="parts.path ? 'col-12' : 'col-12 col-md-6'">
                                <small class="d-block text-muted lh-1 mb-1" t-esc="row.label"/>
                                <div class="o_budget_commitment_info_value">
                                    <span t-if="parts.code"
                                        class="badge bg-light text-dark border font-monospace me-1"
                                        t-esc="parts.code"/>
                                    <span class="fw-semibold" t-esc="parts.leaf"/>
                                </div>
                                <small t-if="parts.path"
                                    class="d-block text-muted o_budget_commitment_info_path"
                                    t-esc="parts.path"/>
                            </div>
                        </t>
                    </div>

                    <!-- Per-code lines of a ถัวจ่าย reservation, when an add-on
                         sends them (budget_commitment_cross_charge). -->
                    <div t-if="info.data.lines and info.data.lines.length" class="border-top mt-2 pt-2">
                        <small class="d-block text-muted mb-1" t-esc="info.data.lines_label"/>
                        <table class="table table-sm mb-0 o_budget_commitment_info_lines">
                            <tbody>
                                <tr t-foreach="info.data.lines" t-as="line" t-key="line_index">
                                    <td class="text-nowrap ps-0">
                                        <i t-if="line.primary" class="fa fa-star text-warning me-1" title="รหัสหลัก"/>
                                        <span class="badge bg-light text-dark border font-monospace"
                                            t-esc="line.code"/>
                                    </td>
                                    <td class="w-100" t-esc="line.name"/>
                                    <td class="text-end text-nowrap pe-0" t-esc="line.amount"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div t-foreach="info.data.amounts" t-as="amount"
                        t-key="'amount_' + amount_index"
                        class="d-flex justify-content-between align-items-baseline gap-2 border-top mt-2 pt-2">
                        <small class="text-muted" t-esc="amount.label"/>
                        <span class="fw-bold text-nowrap" t-esc="amount.value"/>
                    </div>

                </div>
            </div>
        </xpath>
    </t>

</templates>
