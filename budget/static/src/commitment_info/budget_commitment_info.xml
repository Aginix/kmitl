<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The standard Many2one picker, with the selected reservation's details
         appended underneath so the user can confirm they picked the right slip. -->
    <t t-name="budget.BudgetCommitmentInfoField" t-inherit="web.Many2OneField"
        t-inherit-mode="primary" owl="1">
        <xpath expr="." position="inside">
            <div t-if="info.data" class="o_budget_commitment_info card mt-2">
                <div class="card-body p-2">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-bookmark text-primary me-2" title="ใบจองงบประมาณ"/>
                        <strong t-esc="info.data.name"/>
                        <span t-if="info.data.title" class="ms-1 text-muted">
                            — <t t-esc="info.data.title"/>
                        </span>
                        <span class="badge rounded-pill text-bg-info ms-auto"
                            t-esc="info.data.state_label"/>
                    </div>
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr t-foreach="info.data.rows" t-as="row" t-key="row_index">
                                <td class="text-muted ps-0 py-1" style="width: 40%"
                                    t-esc="row.label"/>
                                <td class="py-1" t-esc="row.value"/>
                            </tr>
                            <tr t-foreach="info.data.amounts" t-as="amount"
                                t-key="'amount_' + amount_index">
                                <td class="text-muted ps-0 py-1" t-esc="amount.label"/>
                                <td class="py-1 text-end fw-bold"
                                    t-att-class="amount.highlight ? 'text-success' : ''"
                                    t-esc="amount.value"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>
    </t>

</templates>
