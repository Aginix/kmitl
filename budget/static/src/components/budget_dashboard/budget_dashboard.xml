<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="budget.BudgetDashboard" class="o_action budget_dashboard" owl="1">
        <!-- Control Panel -->
        <div class="o_control_panel d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom">
            <div class="d-flex align-items-center">
                <h4 class="mb-0">Dashboard</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <!-- Fiscal Year Filter (Required) -->
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0">ปีงบประมาณ:</label>
                    <select
                        class="form-select form-select-sm"
                        style="width: auto;"
                        t-on-change="onFiscalYearChange"
                    >
                        <t t-foreach="state.filterOptions.fiscal_years" t-as="fy" t-key="fy.id">
                            <option
                                t-att-value="fy.id"
                                t-att-selected="state.filters.fiscal_year_id === fy.id"
                            >
                                <t t-esc="fy.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <!-- Source Filter (Required) -->
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0">แหล่งเงิน:</label>
                    <select
                        class="form-select form-select-sm"
                        style="width: auto;"
                        t-on-change="onSourceChange"
                    >
                        <t t-foreach="state.filterOptions.sources" t-as="src" t-key="src.id">
                            <option
                                t-att-value="src.id"
                                t-att-selected="state.filters.source_id === src.id"
                            >
                                <t t-if="src.code"><t t-esc="src.code"/> - </t><t t-esc="src.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="o_content p-4" style="overflow-y: auto;">
            <!-- Loading State -->
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <div t-else="">
                <!-- Stats Cards -->
                <div class="row g-4 mb-4">
                    <!-- งบประมาณจัดสรรทั้งหมด -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-primary">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                        <i class="fa fa-money fa-2x text-primary"/>
                                    </div>
                                    <div>
                                        <h6 class="card-subtitle text-muted mb-1">งบประมาณจัดสรรทั้งหมด</h6>
                                        <h3 class="card-title mb-0 text-primary">
                                            <t t-esc="formatCurrency(state.stats.total_appropriation)"/>
                                        </h3>
                                    </div>
                                </div>
                                <p class="card-text text-muted small mb-0">
                                    ยอดรวมงบประมาณที่จัดสรรแล้ว (Posted)
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- งบประมาณคงเหลือ -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-success">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                        <i class="fa fa-balance-scale fa-2x text-success"/>
                                    </div>
                                    <div>
                                        <h6 class="card-subtitle text-muted mb-1">งบประมาณคงเหลือ</h6>
                                        <h3 class="card-title mb-0 text-success">
                                            <t t-esc="formatCurrency(state.stats.total_balance)"/>
                                        </h3>
                                    </div>
                                </div>
                                <p class="card-text text-muted small mb-0">
                                    ยอดคงเหลือจากทุกประเภทรายการ (Posted)
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- ร้อยละการเบิกจ่าย -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-warning">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                                        <i class="fa fa-percent fa-2x text-warning"/>
                                    </div>
                                    <div>
                                        <h6 class="card-subtitle text-muted mb-1">ร้อยละการเบิกจ่าย</h6>
                                        <h3 class="card-title mb-0 text-warning">
                                            <t t-esc="formatPercent(state.stats.disbursement_percent)"/>%
                                        </h3>
                                    </div>
                                </div>
                                <p class="card-text text-muted small mb-0">
                                    เบิกจ่าย <t t-esc="formatCurrency(state.stats.disbursement)"/> บาท
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Budget Breakdown Charts -->
                <h5 class="mb-3">ผลการเบิกจ่ายตามประเภทงบ</h5>
                <div class="row g-4">
                    <t t-foreach="state.stats.budget_breakdown" t-as="category" t-key="category_index">
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <t t-esc="category.name"/>
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div t-att-id="'budget-chart-' + category_index" style="width: 100%; height: 200px;"/>
                                    <div class="mt-2 small">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">จัดสรร:</span>
                                            <span><t t-esc="formatCurrency(category.appropriation)"/></span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-danger">เบิกจ่าย:</span>
                                            <span class="text-danger"><t t-esc="formatCurrency(category.disbursement)"/></span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-success">คงเหลือ:</span>
                                            <span class="text-success"><t t-esc="formatCurrency(category.balance)"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </div>
</templates>
