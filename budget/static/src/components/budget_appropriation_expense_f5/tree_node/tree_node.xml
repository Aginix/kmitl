<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <div t-name="budget.ExpenseF5TreeNode" t-att-class="nodeClass" owl="1">
        <div class="node-content d-flex align-items-center py-2 px-3" t-att-style="indentStyle">
            <!-- Expand/Collapse Button -->
            <button 
                t-if="hasChildren"
                type="button" 
                class="btn btn-sm btn-link expand-toggle p-0 me-2"
                t-on-click="onToggle"
                t-att-title="isExpanded ? 'ย่อ' : 'ขยาย'">
                <i t-att-class="expandIcon"/>
            </button>
            <div t-if="!hasChildren" class="expand-spacer me-2" style="width: 16px;"/>

            <!-- Node Icon -->
            <div class="node-icon me-3">
                <i t-att-class="nodeIcon" t-attf-class="text-{{node.type}}"/>
            </div>

            <!-- Node Info -->
            <div class="node-info flex-grow-1">
                <div class="d-flex align-items-center">
                    <!-- Node Title -->
                    <div class="node-title flex-grow-1">
                        <div class="node-name">
                            <strong t-esc="node.name"/>
                            <span t-if="node.code" class="node-code text-muted ms-2">
                                (<t t-esc="node.code"/>)
                            </span>
                        </div>
                        <div t-if="levelLabel" class="node-type text-muted small">
                            <t t-esc="levelLabel"/>
                        </div>
                    </div>

                    <!-- Node Stats -->
                    <div class="node-stats d-flex align-items-center">
                        <!-- Line Count -->
                        <span t-if="node.line_count > 0" class="badge badge-light me-2">
                            <i class="fa fa-list-ul me-1"/>
                            <t t-esc="node.line_count"/> รายการ
                        </span>

                        <!-- Amount -->
                        <div class="node-amount">
                            <span class="amount-value" t-attf-class="text-{{node.total_amount >= 0 ? 'success' : 'danger'}}">
                                <strong t-esc="formatCurrency(node.total_amount)"/>
                                <span class="currency-symbol ms-1" t-esc="props.currencySymbol or '฿'"/>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Progress Bar (for visual representation of amount proportion) -->
                <div t-if="props.totalAmount and props.totalAmount > 0" class="progress mt-2" style="height: 4px;">
                    <div 
                        class="progress-bar" 
                        t-attf-class="bg-{{node.type}}"
                        t-att-style="'width: ' + getProgressPercentage() + '%'"
                        role="progressbar">
                    </div>
                </div>

                <!-- Line Details (for line type nodes) -->
                <div t-if="node.type === 'line' and node.line_data" class="line-details mt-2 small">
                    <div class="row">
                        <div class="col-md-6">
                            <strong>บัญชี:</strong> 
                            <t t-esc="node.line_data.account.code"/> - <t t-esc="node.line_data.account.name"/>
                        </div>
                        <div t-if="node.line_data.note" class="col-md-6">
                            <strong>หมายเหตุ:</strong> <t t-esc="node.line_data.note"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</templates>