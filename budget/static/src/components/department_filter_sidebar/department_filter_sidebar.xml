<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <div
        t-name="budget.DepartmentFilterSidebar"
        class="department-filter-sidebar"
        owl="1"
    >
        <div class="sidebar-header">
            <div class="d-flex align-items-center">
                <h6 class="mb-0 flex-grow-1">
                    <i class="fa fa-building me-1" /> ส่วนงาน
                    <span
                        t-if="props.selectedIds.length > 0"
                        class="badge bg-primary ms-2"
                    >
                        <t t-esc="props.selectedIds.length" />
                    </span>
                </h6>
                <button
                    type="button"
                    class="btn-close"
                    aria-label="Close"
                    t-on-click="props.onClose"
                    t-if="props.onClose"
                />
            </div>
            <div class="btn-group btn-group-sm mt-2">
                <button
                    type="button"
                    class="btn btn-link p-1"
                    t-on-click="expandAll"
                    title="ขยายทั้งหมด"
                >
                    <i class="fa fa-expand" />
                </button>
                <button
                    type="button"
                    class="btn btn-link p-1"
                    t-on-click="collapseAll"
                    title="ย่อทั้งหมด"
                >
                    <i class="fa fa-compress" />
                </button>
                <button
                    t-if="props.selectedIds.length > 0"
                    type="button"
                    class="btn btn-link p-1 text-danger"
                    t-on-click="clearSelection"
                    title="ล้างการเลือก"
                >
                    <i class="fa fa-times" />
                </button>
            </div>
        </div>

        <div class="sidebar-search">
            <div class="input-group input-group-sm">
                <span class="input-group-text">
                    <i class="fa fa-search" />
                </span>
                <input
                    type="text"
                    class="form-control"
                    placeholder="ค้นหาส่วนงาน..."
                    t-on-input="onSearchInput"
                />
            </div>
        </div>

        <div class="sidebar-content">
            <div t-if="state.loading" class="text-center p-3">
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="sr-only">กำลังโหลด...</span>
                </div>
            </div>

            <div
                t-elif="filteredDepartments.length === 0"
                class="text-center text-muted p-3"
            >
                <i class="fa fa-search fa-2x mb-2" />
                <div>ไม่พบส่วนงานที่ค้นหา</div>
            </div>

            <ul t-else="" class="department-tree">
                <t t-foreach="filteredDepartments" t-as="dept" t-key="dept.id">
                    <t t-call="budget.DepartmentTreeNode">
                        <t t-set="department" t-value="dept" />
                        <t t-set="level" t-value="0" />
                    </t>
                </t>
            </ul>
        </div>
    </div>

    <!-- Recursive template for department tree nodes -->
    <t t-name="budget.DepartmentTreeNode" owl="1">
        <li class="department-node" t-att-data-level="level">
            <div
                class="node-content"
                t-att-class="{ 'selected': department.isSelected, 'has-data': department.has_data }"
                t-on-click="(e) => this.toggleDepartment(department, e)"
            >

                <span
                    class="node-toggle"
                    t-att-style="'margin-left: ' + (level * 20) + 'px'"
                    t-on-click.stop="() => this.toggleExpand(department.id)"
                >
                    <i
                        t-if="department.children and department.children.length > 0"
                        t-att-class="isExpanded(department.id) ? 'fa fa-caret-down' : 'fa fa-caret-right'"
                    />
                    <i t-else="" class="fa fa-circle-o node-leaf" />
                </span>

                <div class="form-check d-inline-flex align-items-center flex-grow-1">
                    <input
                        type="checkbox"
                        class="form-check-input me-2"
                        t-att-checked="department.isSelected"
                        t-att-id="'dept_checkbox_' + department.id"
                        t-on-click.stop="(e) => this.toggleDepartment(department, e)"
                    />
                    <label
                        class="form-check-label flex-grow-1 mb-0"
                        t-att-for="'dept_checkbox_' + department.id"
                    >
                        <span class="dept-code" t-if="department.code">
                            <t t-esc="department.code" />
                        </span>
                        <span class="dept-name">
                            <t t-esc="department.name" />
                        </span>
                        <t t-if="department.has_data">
                            <i
                                class="fa fa-circle text-success ms-1"
                                style="font-size: 6px;"
                                title="มีข้อมูลงบประมาณ"
                            />
                        </t>
                    </label>
                </div>
            </div>

            <ul
                t-if="isExpanded(department.id) and department.children and department.children.length > 0"
                class="department-children"
            >
                <t
                    t-foreach="department.children"
                    t-as="childDept"
                    t-key="childDept.id"
                >
                    <t t-call="budget.DepartmentTreeNode">
                        <t t-set="department" t-value="childDept" />
                        <t t-set="level" t-value="level + 1" />
                    </t>
                </t>
            </ul>
        </li>
    </t>
</templates>
