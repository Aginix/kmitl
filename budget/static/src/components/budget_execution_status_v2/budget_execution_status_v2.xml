<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget.BudgetExecutionStatusV2" owl="1">
        <div class="o_budget_execution_status_v2 h-100 d-flex flex-column">
            <!-- Custom Filter Panel -->
            <div t-if="state.showFilterPanel" class="o_budget_filter_panel bg-white border-bottom p-3">
                <div class="row g-3">
                    <!-- Fiscal Year -->
                    <div class="col-md-3">
                        <label class="form-label">Fiscal Year</label>
                        <select class="form-select form-select-sm" 
                                t-on-change="onFiscalYearChange"
                                t-att-value="state.filters.date_range_fy_id">
                            <option value="">All Years</option>
                            <t t-foreach="state.filterOptions.fiscal_years" t-as="fy" t-key="fy.id">
                                <option t-att-value="fy.id" 
                                        t-att-selected="fy.id === state.filters.date_range_fy_id">
                                    <t t-esc="fy.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    
                    <!-- Date Range -->
                    <div class="col-md-2">
                        <label class="form-label">Date From</label>
                        <input type="date" 
                               class="form-control form-control-sm"
                               t-att-value="state.filters.date_from"
                               t-on-change="(e) => { state.filters.date_from = e.target.value; onFilterChange(); }"/>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date To</label>
                        <input type="date" 
                               class="form-control form-control-sm"
                               t-att-value="state.filters.date_to"
                               t-on-change="(e) => { state.filters.date_to = e.target.value; onFilterChange(); }"/>
                    </div>
                    
                    <!-- Budget Type -->
                    <div class="col-md-2">
                        <label class="form-label">Budget Type</label>
                        <select class="form-select form-select-sm"
                                t-att-value="state.filters.budget_type"
                                t-on-change="(e) => { state.filters.budget_type = e.target.value; onFilterChange(); }">
                            <option value="expense">Expense</option>
                            <option value="revenue">Revenue</option>
                        </select>
                    </div>
                    
                    <!-- Apply Button -->
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary btn-sm w-100" 
                                t-on-click="onFilterChange"
                                t-att-disabled="state.isRefreshing">
                            <i class="fa fa-filter"/> Apply Filters
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Main Content Area -->
            <div class="o_content flex-grow-1 d-flex flex-column">
                <!-- Top Action Bar -->
                <div class="o_budget_action_bar d-flex justify-content-between align-items-center p-2 bg-white border-bottom">
                    <!-- Left: View Controls -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Filter Toggle -->
                        <button class="btn btn-outline-secondary btn-sm"
                                t-on-click="toggleFilterPanel"
                                t-att-class="{'active': state.showFilterPanel}">
                            <i class="fa fa-filter"/> Filters
                        </button>
                        
                        <!-- View Mode Toggle -->
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary"
                                    t-att-class="{'active': state.viewMode === 'hierarchical'}"
                                    t-on-click="() => state.viewMode = 'hierarchical'"
                                    title="Hierarchical View">
                                <i class="fa fa-sitemap"/> Hierarchical
                            </button>
                            <button class="btn btn-outline-primary"
                                    t-att-class="{'active': state.viewMode === 'flat'}"
                                    t-on-click="() => state.viewMode = 'flat'"
                                    title="Flat View">
                                <i class="fa fa-list"/> Flat List
                            </button>
                        </div>
                        
                        <!-- Expand/Collapse -->
                        <div class="btn-group btn-group-sm" t-if="state.viewMode === 'hierarchical'">
                            <button class="btn btn-outline-secondary"
                                    t-on-click="expandAll"
                                    title="Expand All">
                                <i class="fa fa-expand"/>
                            </button>
                            <button class="btn btn-outline-secondary"
                                    t-on-click="collapseAll"
                                    title="Collapse All">
                                <i class="fa fa-compress"/>
                            </button>
                        </div>
                        
                        <!-- Options -->
                        <div class="form-check form-switch ms-3">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   id="showZeroValues"
                                   t-att-checked="state.showZeroValues"
                                   t-on-change="toggleZeroValues"/>
                            <label class="form-check-label" for="showZeroValues">
                                Show Zero Values
                            </label>
                        </div>
                        
                        <!-- Auto Refresh -->
                        <div class="form-check form-switch ms-2">
                            <input class="form-check-input" 
                                   type="checkbox" 
                                   id="autoRefresh"
                                   t-att-checked="state.autoRefresh"
                                   t-on-change="toggleAutoRefresh"/>
                            <label class="form-check-label" for="autoRefresh">
                                Auto-refresh
                                <small t-if="state.lastRefreshTime" class="text-muted ms-1">
                                    (Last: <t t-esc="formatDate(state.lastRefreshTime)"/>)
                                </small>
                            </label>
                        </div>
                    </div>
                    
                    <!-- Right: Actions & Search -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Search -->
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <span class="input-group-text">
                                <i class="fa fa-search"/>
                            </span>
                            <input type="text" 
                                   class="form-control" 
                                   placeholder="Search..."
                                   t-att-value="state.searchTerm"
                                   t-on-input="onSearch"/>
                        </div>
                        
                        <!-- Action Buttons -->
                        <button class="btn btn-primary btn-sm"
                                t-on-click="onRefresh"
                                t-att-disabled="state.isRefreshing">
                            <i class="fa fa-refresh" t-att-class="{'fa-spin': state.isRefreshing}"/>
                            Refresh
                        </button>
                        
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-success"
                                    t-on-click="onExportExcel"
                                    title="Export to Excel">
                                <i class="fa fa-file-excel-o"/> Excel
                            </button>
                            <button class="btn btn-info"
                                    t-on-click="onPrint"
                                    title="Print Report">
                                <i class="fa fa-print"/> Print
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Summary Cards -->
                <div class="o_budget_summary_cards d-flex gap-2 p-2 bg-light border-bottom" 
                     t-if="!state.isLoading and state.summary">
                    <div class="card flex-fill">
                        <div class="card-body p-2">
                            <h6 class="card-subtitle mb-1 text-muted">Current Budget</h6>
                            <h5 class="card-title mb-0">
                                <t t-esc="formatCurrency(state.summary.total_current_budget)"/>
                            </h5>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body p-2">
                            <h6 class="card-subtitle mb-1 text-muted">Reserved</h6>
                            <h5 class="card-title mb-0 text-warning">
                                <t t-esc="formatCurrency(state.summary.total_reserved)"/>
                            </h5>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body p-2">
                            <h6 class="card-subtitle mb-1 text-muted">Obligated</h6>
                            <h5 class="card-title mb-0 text-info">
                                <t t-esc="formatCurrency(state.summary.total_obligated)"/>
                            </h5>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body p-2">
                            <h6 class="card-subtitle mb-1 text-muted">Disbursed</h6>
                            <h5 class="card-title mb-0 text-success">
                                <t t-esc="formatCurrency(state.summary.total_disbursed)"/>
                            </h5>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body p-2">
                            <h6 class="card-subtitle mb-1 text-muted">Remaining</h6>
                            <h5 class="card-title mb-0"
                                t-att-class="{
                                    'text-danger': state.summary.total_remaining &lt; 0,
                                    'text-success': state.summary.total_remaining >= 0
                                }">
                                <t t-esc="formatCurrency(state.summary.total_remaining)"/>
                            </h5>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body p-2">
                            <h6 class="card-subtitle mb-1 text-muted">Utilization</h6>
                            <h5 class="card-title mb-0"
                                t-att-class="{
                                    'text-danger': state.summary.utilization_percentage > 100,
                                    'text-warning': state.summary.utilization_percentage > 90,
                                    'text-success': state.summary.utilization_percentage &lt;= 90
                                }">
                                <t t-esc="formatPercentage(state.summary.utilization_percentage)"/>
                            </h5>
                        </div>
                    </div>
                </div>
                
                <!-- Main Table Container -->
                <div class="flex-grow-1 overflow-auto" t-ref="tableContainer">
                    <!-- Loading State -->
                    <div t-if="state.isLoading" class="d-flex justify-content-center align-items-center h-100">
                        <div class="text-center">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Loading report data...</p>
                        </div>
                    </div>
                    
                    <!-- Error State -->
                    <div t-elif="state.error" class="alert alert-danger m-3" role="alert">
                        <h5 class="alert-heading">Error</h5>
                        <p t-esc="state.error"/>
                        <hr/>
                        <button class="btn btn-outline-danger btn-sm" t-on-click="onRefresh">
                            <i class="fa fa-refresh"/> Try Again
                        </button>
                    </div>
                    
                    <!-- Data Table -->
                    <table t-else="" class="table table-sm table-hover table-bordered mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="sortable" width="30%" t-on-click="() => onSort('name')">
                                    Item
                                    <i t-if="state.sortConfig.field === 'name'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="10%" t-on-click="() => onSort('initial_appropriation')">
                                    Initial Budget
                                    <i t-if="state.sortConfig.field === 'initial_appropriation'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="10%" t-on-click="() => onSort('current_budget')">
                                    Current Budget
                                    <i t-if="state.sortConfig.field === 'current_budget'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="9%" t-on-click="() => onSort('reserved_amount')">
                                    Reserved
                                    <i t-if="state.sortConfig.field === 'reserved_amount'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="9%" t-on-click="() => onSort('obligated_amount')">
                                    Obligated
                                    <i t-if="state.sortConfig.field === 'obligated_amount'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="9%" t-on-click="() => onSort('disbursed_amount')">
                                    Disbursed
                                    <i t-if="state.sortConfig.field === 'disbursed_amount'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="9%" t-on-click="() => onSort('total_used')">
                                    Total Used
                                    <i t-if="state.sortConfig.field === 'total_used'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-end sortable" width="9%" t-on-click="() => onSort('remaining_budget')">
                                    Remaining
                                    <i t-if="state.sortConfig.field === 'remaining_budget'" 
                                       t-att-class="'fa fa-sort-' + (state.sortConfig.direction === 'asc' ? 'asc' : 'desc')"/>
                                </th>
                                <th class="text-center" width="5%">%</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.displayData" t-as="row" t-key="row.key">
                                <tr t-att-class="'budget-row-' + getStatusClass(row)">
                                    <td>
                                        <div class="d-flex align-items-center"
                                             t-att-style="'padding-left: ' + (row._level * 20) + 'px'">
                                            <!-- Expand/Collapse button -->
                                            <button t-if="row._hasChildren and state.viewMode === 'hierarchical'"
                                                    type="button"
                                                    class="btn btn-link btn-sm p-0 me-2"
                                                    style="width: 20px;"
                                                    t-on-click="() => toggleNode(row.key)">
                                                <i t-att-class="row._isExpanded ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                            </button>
                                            <div t-else="" style="width: 20px;" class="me-2"/>
                                            
                                            <!-- Type Icon -->
                                            <i t-att-class="{
                                                'fa fa-folder text-primary me-2': row.type === 'activity',
                                                'fa fa-bank text-info me-2': row.type === 'fund',
                                                'fa fa-book text-success me-2': row.type === 'account'
                                            }"/>
                                            
                                            <!-- Name and Code -->
                                            <span t-att-class="{
                                                'fw-bold': row.type === 'activity' and row._level === 0,
                                                'text-primary': row.type === 'activity',
                                                'text-secondary': row.type === 'fund'
                                            }">
                                                <t t-if="row.code" t-esc="row.code"/> - <t t-esc="row.name"/>
                                            </span>
                                            
                                            <!-- Child count badge -->
                                            <span t-if="row._hasChildren" class="badge bg-secondary ms-2">
                                                <t t-esc="row.childCount || row.children?.length || 0"/>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="formatCurrency(row.totals?.initial_appropriation || 0)"/>
                                    </td>
                                    <td class="text-end fw-bold">
                                        <t t-esc="formatCurrency(row.totals?.current_budget || 0)"/>
                                    </td>
                                    <td class="text-end text-warning">
                                        <t t-esc="formatCurrency(row.totals?.reserved_amount || 0)"/>
                                    </td>
                                    <td class="text-end text-info">
                                        <t t-esc="formatCurrency(row.totals?.obligated_amount || 0)"/>
                                    </td>
                                    <td class="text-end text-success">
                                        <t t-esc="formatCurrency(row.totals?.disbursed_amount || 0)"/>
                                    </td>
                                    <td class="text-end fw-bold">
                                        <t t-esc="formatCurrency(row.totals?.total_used || 0)"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-att-class="{
                                            'text-danger fw-bold': row.totals?.remaining_budget &lt; 0,
                                            'text-warning': row.utilization > 90 and row.totals?.remaining_budget >= 0,
                                            'text-success': row.totals?.remaining_budget > 0 and row.utilization &lt;= 90
                                        }">
                                            <t t-esc="formatCurrency(row.totals?.remaining_budget || 0)"/>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar"
                                                 t-att-class="{
                                                     'bg-danger': row.utilization > 100,
                                                     'bg-warning': row.utilization > 90 and row.utilization &lt;= 100,
                                                     'bg-success': row.utilization &lt;= 90
                                                 }"
                                                 role="progressbar"
                                                 t-att-style="'width: ' + Math.min(row.utilization || 0, 100) + '%'"
                                                 t-att-aria-valuenow="row.utilization || 0"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                <span class="small fw-bold">
                                                    <t t-esc="formatPercentage(row.utilization || 0)"/>
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                            
                            <!-- Empty state -->
                            <tr t-if="!state.displayData.length">
                                <td colspan="9" class="text-center py-5">
                                    <div>
                                        <i class="fa fa-folder-open-o fa-3x text-muted mb-3"/>
                                        <h5>No Data Found</h5>
                                        <p class="text-muted">No budget execution data matches your current filters.</p>
                                        <button class="btn btn-primary btn-sm" t-on-click="onRefresh">
                                            <i class="fa fa-refresh"/> Refresh Data
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Footer Status Bar -->
                <div class="o_budget_footer d-flex justify-content-between align-items-center p-2 bg-light border-top">
                    <div>
                        <span class="text-muted">
                            Period: <strong><t t-esc="formatDate(state.filters.date_from)"/></strong> to 
                            <strong><t t-esc="formatDate(state.filters.date_to)"/></strong>
                        </span>
                        <span class="ms-3 text-muted">
                            Records: <strong><t t-esc="state.displayData.length"/></strong>
                        </span>
                    </div>
                    <div class="text-muted">
                        <small>
                            Currency: THB | 
                            <t t-if="state.lastRefreshTime">
                                Last updated: <t t-esc="state.lastRefreshTime.toLocaleTimeString()"/>
                            </t>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>