<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="budget.BudgetExecutionStatusV2" owl="1">
        <div class="budget-execution-status-v2">
            <!-- Simple header with fiscal year filter -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Budget Execution Status Report</h2>
                <div class="d-flex align-items-center gap-3">
                    <label class="mb-0">Fiscal Year:</label>
                    <select class="form-select form-select-sm" style="width: 200px;"
                            t-on-change="onFiscalYearChange"
                            t-att-value="state.filters.date_range_fy_id">
                        <option value="">-- Select --</option>
                        <t t-foreach="state.fiscalYears" t-as="fy" t-key="fy.id">
                            <option t-att-value="fy.id" t-esc="fy.name"/>
                        </t>
                    </select>
                </div>
            </div>

            <!-- Loading indicator -->
            <div t-if="state.isLoading" class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                <p class="mt-3">Loading report data...</p>
            </div>

            <!-- Main content -->
            <div t-else="">
                <!-- Summary cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h6 class="text-muted">Total Budget</h6>
                                <h4 class="text-primary" t-esc="formatCurrency(state.summary.total_appropriation)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h6 class="text-muted">Used</h6>
                                <h4 class="text-success" t-esc="formatCurrency(state.summary.total_consumed)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h6 class="text-muted">Remaining</h6>
                                <h4 class="text-info" t-esc="formatCurrency(state.summary.total_remaining)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h6 class="text-muted">Utilization</h6>
                                <h4 t-att-class="getUtilizationClass(state.summary.total_utilization)" 
                                    t-esc="formatPercentage(state.summary.total_utilization)"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data table -->
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th style="width: 40%">Account / Activity</th>
                                <th class="text-end">Budget</th>
                                <th class="text-end">Used</th>
                                <th class="text-end">Remaining</th>
                                <th class="text-end">Utilization</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data" t-as="account" t-key="account.id">
                                <!-- Account row -->
                                <tr class="fw-bold">
                                    <td>
                                        <t t-if="account.children and account.children.length">
                                            <i class="fa fa-fw"
                                               t-att-class="isNodeExpanded(account.id) ? 'fa-caret-down' : 'fa-caret-right'"
                                               t-on-click="() => toggleNode(account.id)"
                                               style="cursor: pointer;"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-fw"/>
                                        </t>
                                        <span t-esc="account.name"/>
                                    </td>
                                    <td class="text-end" t-esc="formatCurrency(account.appropriation)"/>
                                    <td class="text-end" t-esc="formatCurrency(account.consumed)"/>
                                    <td class="text-end" t-esc="formatCurrency(account.remaining)"/>
                                    <td class="text-end" t-att-class="getUtilizationClass(account.utilization)"
                                        t-esc="formatPercentage(account.utilization)"/>
                                </tr>
                                
                                <!-- Activity rows (children) -->
                                <t t-if="isNodeExpanded(account.id) and account.children">
                                    <t t-foreach="account.children" t-as="activity" t-key="activity.id">
                                        <tr>
                                            <td style="padding-left: 2rem;">
                                                <i class="fa fa-fw"/>
                                                <span t-esc="activity.name"/>
                                            </td>
                                            <td class="text-end" t-esc="formatCurrency(activity.appropriation)"/>
                                            <td class="text-end" t-esc="formatCurrency(activity.consumed)"/>
                                            <td class="text-end" t-esc="formatCurrency(activity.remaining)"/>
                                            <td class="text-end" t-att-class="getUtilizationClass(activity.utilization)"
                                                t-esc="formatPercentage(activity.utilization)"/>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>