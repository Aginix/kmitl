<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t
        t-name="budget.NoteLineRenderer"
        t-inherit="web.ListRenderer"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//t[@t-foreach='state.columns']/th" position="attributes">
            <attribute
                name="t-if"
            >column.type === 'field' and column.name != 'note'</attribute>
        </xpath>
    </t>

    <t
        t-name="budget.ListRenderer.RecordRow"
        t-inherit="web.ListRenderer.RecordRow"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//t[@t-foreach='getColumns(record)']/t/td" position="attributes">
            <attribute name="t-if">column.name != 'note'</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='getColumns(record)']/t/td" position="inside">
            <div
                t-if="column.name == 'account_id' and record.data.note"
                style="width: 100%;"
                class="o_note_textarea"
            >
                <t t-out="record.data.note" />
            </div>
        </xpath>
    </t>
</templates>
