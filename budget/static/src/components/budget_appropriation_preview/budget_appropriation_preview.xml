<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <div t-name="budget.BudgetAppropriationPreview" class="o_action budget_appropriation_preview" owl="1">
        
        <!-- Control Panel -->
        <ControlPanel display="controlPanelDisplay">
            <t t-set-slot="control-panel-bottom-left-buttons">
                <div class="o_cp_buttons">
                    <div class="btn-group me-2">
                        <button 
                            type="button" 
                            class="btn btn-secondary"
                            t-on-click="onRefresh"
                            title="รีเฟรช">
                            <i class="fa fa-refresh"/>
                        </button>
                        <button 
                            type="button" 
                            class="btn btn-secondary"
                            t-on-click="onExpandAll"
                            title="ขยายทั้งหมด">
                            <i class="fa fa-expand"/>
                        </button>
                        <button 
                            type="button" 
                            class="btn btn-secondary"
                            t-on-click="onCollapseAll"
                            title="ย่อทั้งหมด">
                            <i class="fa fa-compress"/>
                        </button>
                    </div>
                    <div class="btn-group">
                        <button 
                            type="button" 
                            class="btn btn-primary"
                            t-on-click="onPrint"
                            title="พิมพ์">
                            <i class="fa fa-print"/> พิมพ์
                        </button>
                        <button 
                            type="button" 
                            class="btn btn-success"
                            t-on-click="onExport"
                            title="ส่งออก">
                            <i class="fa fa-download"/> ส่งออก
                        </button>
                    </div>
                </div>
            </t>
            <t t-set-slot="control-panel-bottom-right">
                <div class="o_cp_searchview">
                    <div class="input-group">
                        <input 
                            type="text" 
                            class="form-control"
                            placeholder="ค้นหา..."
                            t-on-input="onSearch"
                            t-att-value="state.searchTerm"/>
                        <span class="input-group-text">
                            <i class="fa fa-search"/>
                        </span>
                    </div>
                </div>
            </t>
        </ControlPanel>

        <div class="o_content">
            <!-- Loading State -->
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center p-5">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="sr-only">กำลังโหลด...</span>
                    </div>
                    <div>กำลังโหลดข้อมูล...</div>
                </div>
            </div>

            <!-- Error State -->
            <div t-if="state.error and !state.loading" class="alert alert-danger m-3">
                <h4 class="alert-heading">เกิดข้อผิดพลาด</h4>
                <p t-esc="state.error"/>
                <hr/>
                <button class="btn btn-outline-danger" t-on-click="onRefresh">
                    <i class="fa fa-refresh"/> ลองใหม่
                </button>
            </div>

            <!-- Main Content -->
            <div t-if="!state.loading and !state.error" class="budget_appropriation_content">
                <!-- Summary Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <SummaryCard 
                            move="move"
                            summary="summary"
                            currencySymbol="currencySymbol"/>
                    </div>
                </div>

                <!-- Hierarchy Tree -->
                <div class="row">
                    <div class="col-12">
                        <div class="card budget-hierarchy-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fa fa-sitemap me-2"/>
                                    โครงสร้างการจัดสรรงบประมาณ
                                </h5>
                                <div class="hierarchy-stats">
                                    <span class="badge badge-info me-2">
                                        รายการทั้งหมด: <t t-esc="summary.total_lines || 0"/>
                                    </span>
                                    <span class="badge badge-success">
                                        ยอดรวม: <t t-esc="formatCurrency(totalAmount)"/> <t t-esc="currencySymbol"/>
                                    </span>
                                </div>
                            </div>
                            <div class="card-body budget-tree-container">
                                <!-- Tree Structure -->
                                <div t-if="hierarchy.length > 0" class="budget-tree">
                                    <t t-foreach="hierarchy" t-as="rootNode" t-key="rootNode.key">
                                        <t t-call="budget.HierarchyNode">
                                            <t t-set="node" t-value="rootNode"/>
                                            <t t-set="level" t-value="0"/>
                                        </t>
                                    </t>
                                </div>

                                <!-- Empty State -->
                                <div t-if="hierarchy.length === 0" class="budget-tree-empty text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa fa-folder-open fa-3x mb-3"/>
                                        <h4>ไม่มีข้อมูล</h4>
                                        <p>ไม่พบรายการจัดสรรงบประมาณ</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recursive Hierarchy Node Template -->
    <t t-name="budget.HierarchyNode" owl="1">
        <div t-attf-class="tree-node level-{{level}} {{node.type}}">
            <div class="node-content d-flex align-items-center py-2 px-3" t-att-style="'margin-left: ' + (level * 24) + 'px'">
                <!-- Expand/Collapse Button -->
                <button 
                    t-if="node.children and node.children.length > 0"
                    type="button" 
                    class="btn btn-sm btn-link expand-toggle p-0 me-2"
                    t-on-click="() => this.onToggleNode(node.key)"
                    t-att-title="isNodeExpanded(node.key) ? 'ย่อ' : 'ขยาย'">
                    <i t-att-class="isNodeExpanded(node.key) ? 'fa fa-chevron-down' : 'fa fa-chevron-right'"/>
                </button>
                <div t-if="!node.children or node.children.length === 0" class="expand-spacer me-2" style="width: 16px;"/>

                <!-- Node Icon -->
                <div class="node-icon me-3">
                    <i t-att-class="getNodeIcon(node.type)" t-attf-class="text-{{node.type}}"/>
                </div>

                <!-- Node Info -->
                <div class="node-info flex-grow-1">
                    <div class="d-flex align-items-center">
                        <!-- Node Title -->
                        <div class="node-title flex-grow-1">
                            <div class="node-name">
                                <strong t-esc="node.name"/>
                                <span t-if="node.code" class="node-code text-muted ms-2">
                                    (<t t-esc="node.code"/>)
                                </span>
                            </div>
                            <div class="node-type text-muted small">
                                <t t-esc="getNodeTypeLabel(node.type)"/>
                            </div>
                        </div>

                        <!-- Node Stats -->
                        <div class="node-stats d-flex align-items-center">
                            <!-- Line Count -->
                            <span t-if="node.line_count > 0" class="badge badge-light me-2">
                                <i class="fa fa-list-ul me-1"/>
                                <t t-esc="node.line_count"/> รายการ
                            </span>

                            <!-- Amount -->
                            <div class="node-amount">
                                <span class="amount-value" t-attf-class="text-{{node.total_amount >= 0 ? 'success' : 'danger'}}">
                                    <strong t-esc="formatCurrency(node.total_amount)"/>
                                    <span class="currency-symbol ms-1" t-esc="currencySymbol"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div t-if="totalAmount and totalAmount > 0" class="progress mt-2" style="height: 4px;">
                        <div 
                            class="progress-bar" 
                            t-attf-class="bg-{{node.type}}"
                            t-att-style="'width: ' + Math.min(100, (node.total_amount / totalAmount) * 100) + '%'"
                            role="progressbar">
                        </div>
                    </div>

                    <!-- Line Details (for line type nodes) -->
                    <div t-if="node.type === 'line' and node.line_data" class="line-details mt-2 small">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>บัญชี:</strong> 
                                <t t-esc="node.line_data.account.code"/> - <t t-esc="node.line_data.account.name"/>
                            </div>
                            <div t-if="node.line_data.note" class="col-md-6">
                                <strong>หมายเหตุ:</strong> <t t-esc="node.line_data.note"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Children -->
            <div t-if="isNodeExpanded(node.key) and node.children and node.children.length > 0" class="tree-children">
                <t t-foreach="node.children" t-as="childNode" t-key="childNode.key">
                    <t t-call="budget.HierarchyNode">
                        <t t-set="node" t-value="childNode"/>
                        <t t-set="level" t-value="level + 1"/>
                    </t>
                </t>
            </div>
        </div>
    </t>
</templates>