<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budget Execution Status Report Paper Format -->
    <record id="budget_execution_status_paperformat" model="report.paperformat">
        <field name="name">Budget Execution Status Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <!-- Budget Execution Status Report Action -->
    <record id="budget_execution_status_report_print" model="ir.actions.report">
        <field name="name">Budget Execution Status Report</field>
        <field name="model">budget.execution.status.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget.budget_execution_status_report_document</field>
        <field name="report_file">budget.budget_execution_status_report_document</field>
        <field name="binding_model_id" ref="model_budget_execution_status_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="budget_execution_status_paperformat"/>
    </record>

    <!-- Main Report Template -->
    <template id="budget_execution_status_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <!-- Report Header -->
                        <div class="row">
                            <div class="col-12 text-center">
                                <h2>รายงานสถานะการใช้งบประมาณรายจ่าย</h2>
                                <h3>Budget Execution Status Report</h3>
                                <p>
                                    <strong>ช่วงเวลา:</strong> 
                                    <span t-field="o.date_from"/> ถึง <span t-field="o.date_to"/>
                                </p>
                                <p t-if="o.date_range_fy_id">
                                    <strong>ปีงบประมาณ:</strong> <span t-field="o.date_range_fy_id.name"/>
                                </p>
                            </div>
                        </div>

                        <!-- Summary Section -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>สรุปภาพรวม (Summary)</h4>
                                <table class="table table-sm table-bordered">
                                    <tbody>
                                        <tr>
                                            <td><strong>งบประมาณจัดสรรต้นปี</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_initial_appropriation" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td><strong>งบประมาณปัจจุบัน (a)</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_current_budget" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>ขอใช้ทั้งหมด</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_requested" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td><strong>จองเงิน (b)</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_reserved" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>ผูกพัน (c)</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_obligated" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td><strong>เบิกจ่ายแล้ว (d)</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_disbursed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr class="table-info">
                                            <td><strong>รวม (e) = (b)+(c)+(d)</strong></td>
                                            <td class="text-right">
                                                <strong><span t-field="o.total_used" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                            </td>
                                            <td><strong>งบประมาณคงเหลือ (f) = (a)-(e)</strong></td>
                                            <td class="text-right">
                                                <strong><span t-field="o.total_remaining" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>ส่งคืนเงินเหลือจ่าย</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.total_returned" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td><strong>การใช้งบประมาณ (%)</strong></td>
                                            <td class="text-right">
                                                <t t-if="o.total_current_budget != 0">
                                                    <span t-esc="round((o.total_used / o.total_current_budget) * 100, 2)"/>%
                                                </t>
                                                <t t-else="">0.00%</t>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Detail Section -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>รายละเอียด (Details)</h4>
                                
                                <!-- Group lines by budget account for better readability -->
                                <t t-set="grouped_lines" t-value="{}"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-set="account_key" t-value="line.budget_account_id.code + ' - ' + line.budget_account_id.name"/>
                                    <t t-if="account_key not in grouped_lines">
                                        <t t-set="grouped_lines" t-value="grouped_lines.update({account_key: []}) or grouped_lines"/>
                                    </t>
                                    <t t-set="dummy" t-value="grouped_lines[account_key].append(line)"/>
                                </t>

                                <t t-foreach="grouped_lines.items()" t-as="account_group">
                                    <t t-set="account_name" t-value="account_group[0]"/>
                                    <t t-set="account_lines" t-value="account_group[1]"/>
                                    
                                    <div class="mt-3">
                                        <h5 class="text-primary"><span t-esc="account_name"/></h5>
                                        
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th rowspan="2" class="text-center align-middle">กิจกรรม<br/>Activity</th>
                                                    <th rowspan="2" class="text-center align-middle">กองทุน<br/>Fund</th>
                                                    <th rowspan="2" class="text-center align-middle">งบประมาณ<br/>จัดสรรต้นปี</th>
                                                    <th rowspan="2" class="text-center align-middle">งบประมาณ<br/>(a)</th>
                                                    <th rowspan="2" class="text-center align-middle">ขอใช้<br/>ทั้งหมด</th>
                                                    <th colspan="3" class="text-center">การใช้งบประมาณ</th>
                                                    <th rowspan="2" class="text-center align-middle">รวม<br/>(e)</th>
                                                    <th rowspan="2" class="text-center align-middle">คงเหลือ<br/>(f)</th>
                                                    <th rowspan="2" class="text-center align-middle">ส่งคืน</th>
                                                    <th rowspan="2" class="text-center align-middle">%</th>
                                                </tr>
                                                <tr>
                                                    <th class="text-center">จองเงิน<br/>(b)</th>
                                                    <th class="text-center">ผูกพัน<br/>(c)</th>
                                                    <th class="text-center">เบิกจ่าย<br/>(d)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="account_lines" t-as="line">
                                                    <tr t-att-class="'table-danger' if line.remaining_budget &lt; 0 else ('table-warning' if line.utilization_percentage &gt; 90 else '')">
                                                        <td>
                                                            <t t-if="line.activity_code">
                                                                <small><span t-field="line.activity_code"/></small><br/>
                                                            </t>
                                                            <span t-field="line.activity_name"/>
                                                        </td>
                                                        <td>
                                                            <t t-if="line.fund_code">
                                                                <small><span t-field="line.fund_code"/></small><br/>
                                                            </t>
                                                            <span t-field="line.fund_name"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.initial_appropriation" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.current_budget" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.total_requested" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.reserved_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.obligated_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.disbursed_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <strong><span t-field="line.total_used" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                        </td>
                                                        <td class="text-right">
                                                            <strong t-att-class="'text-danger' if line.remaining_budget &lt; 0 else 'text-success'">
                                                                <span t-field="line.remaining_budget" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                            </strong>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.returned_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-esc="round(line.utilization_percentage, 2)"/>%
                                                        </td>
                                                    </tr>
                                                </t>
                                                
                                                <!-- Subtotal for this account -->
                                                <tr class="table-secondary">
                                                    <td colspan="2"><strong>รวม <span t-esc="account_name"/></strong></td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.initial_appropriation for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.current_budget for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.total_requested for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.reserved_amount for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.obligated_amount for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.disbursed_amount for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.total_used for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.remaining_budget for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <strong><span t-esc="sum([l.returned_amount for l in account_lines])" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-set="account_current_budget" t-value="sum([l.current_budget for l in account_lines])"/>
                                                        <t t-set="account_total_used" t-value="sum([l.total_used for l in account_lines])"/>
                                                        <strong>
                                                            <t t-if="account_current_budget != 0">
                                                                <span t-esc="round((account_total_used / account_current_budget) * 100, 2)"/>%
                                                            </t>
                                                            <t t-else="">0.00%</t>
                                                        </strong>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <p><strong>วันที่พิมพ์:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                            </div>
                            <div class="col-6 text-right">
                                <p><strong>หน่วย:</strong> <span t-field="o.currency_id.name"/></p>
                            </div>
                        </div>

                        <!-- Legend -->
                        <div class="row mt-2">
                            <div class="col-12">
                                <small>
                                    <strong>หมายเหตุ:</strong><br/>
                                    - งบประมาณจัดสรรต้นปี: จำนวนงบประมาณที่ได้จากการจัดสรรงบประมาณต้นปี ไม่รวมการปรับปรุง/โอนเงิน<br/>
                                    - งบประมาณ (a): ยอดรวมงบประมาณที่มีการปรับปรุงล่าสุด<br/>
                                    - จองเงิน (b): เงินที่ได้รับจัดสรรตามแผน/เงินที่ขออนุมัติเบิกจ่าย<br/>
                                    - ผูกพัน (c): จำนวนเงินตามสัญญา/เงินยืม/รอเบิกจ่าย<br/>
                                    - เบิกจ่ายแล้ว (d): อนุมัติเบิกจ่าย/ลงบัญชีเรียบร้อยแล้ว<br/>
                                    - รวม (e) = (b) + (c) + (d)<br/>
                                    - งบประมาณคงเหลือ (f) = (a) - (e)
                                </small>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>