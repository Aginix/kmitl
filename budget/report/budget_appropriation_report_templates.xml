<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_budget_appropriation_document">
        <t t-call="web.basic_layout">
            <style>
                    .budget-appropriation-report {
                        font-family: 'TH SarabunPSK', 'Sarabun', Arial, sans-serif;
                        margin-left: 48pt;
                        margin-right: 48pt;
                    }

                    .budget-appropriation-report h3 {
                        margin: 0;
                        font-size: 10pt;
                        font-weight: 600;
                        line-height: 1.7;
                    }

                    .report-header {
                        text-align: center;
                        padding: 15px;
                        margin-bottom: 1rem;
                    }

                    .document-ref {
                        float: right;
                        font-size: 10pt;
                        text-align: right;
                        margin-bottom: 10px;
                    }

                    .institution-info {
                        clear: both;
                    }

                    .institution-info h4 {
                        margin: 0;
                        font-size: 12pt;
                        font-weight: normal;
                    }

                    .report-table {
                        width: 100%;
                        font-size: 9pt;
                        border-collapse: collapse;
                    }

                    .report-table thead tr {
                    }

                    .report-table th {
                        text-align: center;
                        padding: 5px;
                    }

                    .report-table .items-column {
                        width: 65%;
                    }

                    .report-table .code-column {
                        width: 15%;
                    }

                    .report-table .amount-column {
                        width: 10%;
                    }

                    .report-header table {
                        margin-top: 4px;
                    }

                    .report-header td {
                        padding-left: 4px;
                        padding-right: 4px;
                        font-size: 10pt;
                        font-weight: 600;
                        line-height: 1.7;
                    }

                    .hierarchy-row td {
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                    }

                    .account-content {
                        font-weight: 500;
                    }

                    .node-content {
                        font-weight: bold;
                    }

                    .node-code {
                        font-weight: 500;
                    }

                    .line-note {
                        margin-left: 15px;
                        font-weight: 500;
                    }

                    .amount-cell {
                        text-align: right;
                        font-variant-numeric: tabular-nums;
                        border-bottom: 1px solid black;
                    }

                    .code-cell {
                        text-align: right;
                    }

                    .code-content {
                        margin-right: 8px;
                    }

                    .total-row {
                        font-weight: bold;
                    }

                    .total-row td {
                        padding: 5px;
                    }

                    .total-label {
                        text-align: center;
                    }

                    .total-amount {
                        text-align: right;
                        font-variant-numeric: tabular-nums;
                    }

                    /* Account level indentation - CSS Custom Properties for dynamic calculation */
                    :root {
                        --indent-base: 8px; /* Base indentation per level */
                    }

                    .account-indent {
                        /* Will be set dynamically via inline style with calc() */
                    }

                    /* Print styles */

                    .budget-appropriation-report {
                        font-size: 8pt;
                    }

                    .document-ref {
                        font-size: 9pt;
                    }

                    .institution-info h4 {
                        font-size: 11pt;
                    }

                    table, td {
                        border: 0px;
                    }

            </style>


            <div class="page budget-appropriation-report">
                <div class="report-header">
                    <div class="document-ref">
                        <div>F5-P-วง-003</div>
                    </div>

                    <div class="institution-info">
                        <h3 t-esc="o.source_analytic_id.name" />
                        <h3>ประมาณการ                            <t t-esc="o.journal_id.name" />
 ประจำปีงบประมาณ พ.ศ.                            <t t-esc="o.date_range_fy_id.name" />
                        </h3>
                        <h3>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</h3>
                        <h3 t-esc="o.department_analytic_id.complete_name" />
                        <div style="margin: 0 auto;">
                            <table style="margin: 0 auto;">
                                <tbody>
                                    <tr>
                                        <td align="right">วงเงิน</td>
                                        <td align="right"><t t-esc="'{:,}'.format(int(o.total_amount))" /></td>
                                        <td>บาท</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Main Table -->
                <table class="report-table">
                    <thead>
                        <tr>
                            <th class="items-column" rowspan="2"></th>
                            <th class="code-column" rowspan="2"></th>
                            <th style="text-align: text-center" colspan="2">แหล่งเงิน (หน่วย : บาท)</th>
                        </tr>
                        <tr>
                            <th class="amount-column">งบประมาณ</th>
                            <th class="amount-column">รวมทั้งสิ้น</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="report_obj" t-value="o.env['budget.appropriation.report']"/>
                        <t t-set="hierarchy_data" t-value="report_obj.get_hierarchical_data(o.id, {'hide_department': True})"/>

                        <t t-if="hierarchy_data.get('hierarchy')">
                            <t t-call="budget.report_hierarchy_rows">
                                <t t-set="nodes" t-value="hierarchy_data['hierarchy']"/>
                                <t t-set="level" t-value="0"/>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>


    <!-- Recursive template for hierarchy rows -->
    <template id="budget.report_hierarchy_rows">
        <t t-foreach="nodes" t-as="node">
            <tr class="hierarchy-row">
                <td>
                    <div t-att-style="'margin-left: ' + str(12 * (level - 4)) + 'px;' if node.get('type') == 'account' else ''" class="account-indent">
                        <t t-if="node.get('type') == 'account'">
                            <span class="account-content" t-esc="node.get('name', '')"/>
                            <t t-if="node.get('line_details')">
                                <t t-foreach="node.get('line_details', [])" t-as="detail">
                                    <t t-if="detail.get('note')">
                                        <div class="line-note" t-esc="detail.get('note', '')"/>
                                    </t>
                                </t>
                            </t>
                        </t>
                        <t t-else="">
                            <span class="node-content" t-esc="node.get('name', '')"/>
                        </t>
                    </div>
                </td>
                <!-- <t t-if="node.get('type') != 'account'"> -->
                <td class="code-cell">
                    <span class="code-content" t-esc="node.get('code', '')"></span>
                </td>
                <!-- </t> -->
                <td class="amount-cell">
                    <t t-if="node.get('total_amount', 0) != 0">
                        <span t-esc="'{:,}'.format(int(node.get('total_amount', 0)))"/>
                    </t>
                </td>
                <td class="amount-cell">
                    <t t-if="node.get('total_amount', 0) != 0">
                        <span t-esc="'{:,}'.format(int(node.get('total_amount', 0)))"/>
                    </t>
                </td>
            </tr>

            <!-- Recursive call for children -->
            <t t-if="node.get('children')">
                <t t-call="budget.report_hierarchy_rows">
                    <t t-set="nodes" t-value="node.get('children', [])"/>
                    <t t-set="level" t-value="level + 1"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Main report template -->
    <template id="report_budget_appropriation">
        <t t-call="web.html_container">
            <!-- <t t-call-assets="web.assets_common" t-js="false" /> -->
            <t t-foreach="docs" t-as="o">
                <t t-call="budget.report_budget_appropriation_document"/>
            </t>
        </t>
    </template>
</odoo>
