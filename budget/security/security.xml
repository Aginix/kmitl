<odoo>
    <data noupdate="0">

        <record id="module_category_budget" model="ir.module.category">
            <field name="name">Budget</field>
            <field name="description">User groups for managing and using budgets</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_budget_viewer" model="res.groups">
            <field name="name">Budget Viewer</field>
            <field name="category_id" ref="budget.module_category_budget"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Read-only access to budget data</field>
        </record>

        <record id="group_budget_user" model="res.groups">
            <field name="name">Budget User</field>
            <field name="category_id" ref="budget.module_category_budget"/>
            <field name="implied_ids" eval="[(4, ref('group_budget_viewer'))]"/>
        </record>

        <record id="group_budget_manager" model="res.groups">
            <field name="name">Budget Manager</field>
            <field name="category_id" ref="budget.module_category_budget"/>
            <field name="implied_ids" eval="[(4, ref('group_budget_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_budget_commitment" model="res.groups">
            <field name="name">Can reserve/commit budget</field>
            <field name="category_id" ref="base.module_category_hidden" />
            <!-- Self-sufficient reserve role: grant the read access the reservation
                 flow + picker need, so this group can reserve budget without also
                 being a Budget User (write ACLs added in ir.model.access.csv). -->
            <field name="implied_ids" eval="[(4, ref('group_budget_viewer'))]"/>
        </record>
    </data>
</odoo>
