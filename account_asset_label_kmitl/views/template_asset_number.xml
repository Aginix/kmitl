<odoo>
    <template id="report_simple_asset_number_kmitl">
        <t t-set="profile" t-value="asset.profile_id" />
        <style>
            .asset-card {
                width: 400px;
                height: 200px;
                border-radius: 10px;
                overflow: hidden;
                font-size: 13px;
                font-family: 'TH SarabunPSK', 'Sarabun', Arial, sans-serif;
                border: 1px solid #e85d14;
                display: inline-block;
                margin: 6px;
            }
            .asset-header {
                background-color: #e85d14;
                color: white;
                padding: 10px 15px;
                font-size: 16px;
                font-weight: bold;
            }
            .asset-body {
                padding: 10px 15px;
            }
            .asset-label {
                font-weight: bold;
            }
        </style>
        <div class="asset-card">
            <div class="asset-header">เลขครุภัณฑ์ : <t t-esc="asset.number" /></div>
            <div class="asset-body">
                <div class="row">
                    <div class="col-8 mt-2" style="font-size: 13px">
                        <div>
                            <p class="fw-bold" t-esc="asset.name"></p>
                        </div>
                        <div class="mt-3">
                            <strong class="asset-label">สัญญาเลขที่ :</strong>
                            <t t-esc="asset.purchase_id.contract_number or '-'" />
                        </div>

                        <div>
                            <strong class="asset-label">ประเภทครุภัณฑ์ :</strong>
                            <t t-esc="asset.profile_id.name or '-'" />
                        </div>

                        <div>
                            <strong class="asset-label">Service Tag :</strong>
                            <t t-esc="asset.asset_serial_number or '-'" />
                        </div>
                    </div>
                    <div class="col-4" style="text-align: center">
                        <img
                            t-if="asset.company_id.logo"
                            t-att-src="image_data_uri(asset.company_id.logo)"
                            style="width: 55px; margin-bottom: 15px"
                            alt="Logo"
                            class="mt-1"
                        />
                        <t t-if="asset.number">
                            <t t-if="profile.barcode_type == 'barcode'">
                                <img
                                    alt="Barcode"
                                    t-if="len(asset.number) == 13"
                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=55&amp;height=55' % ('EAN13', quote_plus(asset.number or ''))"
                                    style="display: block; margin: 0 auto"
                                />
                                <img
                                    alt="Barcode"
                                    t-elif="len(asset.number) == 8"
                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=55&amp;height=55' % ('EAN8', quote_plus(asset.number or ''))"
                                    style="display: block; margin: 0 auto"
                                />
                                <img
                                    alt="Barcode"
                                    t-else=""
                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=55&amp;height=55' % ('Code128', quote_plus(asset.number or ''))"
                                    style="display: block; margin: 0 auto"
                                />
                            </t>
                            <t t-elif="profile.barcode_type == 'qr'">
                                <img
                                    alt="QRcode"
                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=55&amp;height=55' % ('QR', quote_plus(asset.number or ''))"
                                    style="display: block; margin: 0 auto"
                                />
                            </t>
                        </t>
                        <t t-else="">
                            <span class="text-muted">No number available</span>
                        </t>
                        <div style="font-size: 9px; margin-top: 5px">(Lorem ipsum)</div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template
        id="report_asset_number_inherit"
        inherit_id="account_asset_number.report_asset_number"
    >
        <xpath
            expr="//t[@t-call='account_asset_number.report_simple_asset_number']"
            position="replace"
        >
            <t t-call="account_asset_label_kmitl.report_simple_asset_number_kmitl" />
        </xpath>
    </template>
</odoo>
