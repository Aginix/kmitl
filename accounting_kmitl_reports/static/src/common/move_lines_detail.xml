<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="accounting_kmitl_reports.MoveLinesDetail" owl="1">
        <div class="p-3 bg-light border-top o_kmitl_move_detail">
            <div class="row mb-2" t-if="props.maker or headerDims.length">
                <div class="col-md-6">
                    <div t-if="props.maker">
                        <strong><t t-esc="labels.maker" />:</strong>
                        <t t-esc="props.maker" />
                        <span class="text-muted ms-1" t-esc="props.makerDate" />
                    </div>
                </div>
                <div class="col-md-6 o_kmitl_dims" t-if="headerDims.length">
                    <div t-foreach="headerDims" t-as="dim" t-key="dim_index">
                        <strong><t t-esc="dim.label" />:</strong>
                        <t t-esc="dim.value" />
                    </div>
                </div>
            </div>
            <div t-if="props.narration" class="mb-2">
                <strong><t t-esc="labels.narration" />:</strong>
                <t t-esc="props.narration" />
            </div>
            <table class="table table-sm table-bordered mb-0 bg-white o_kmitl_move_detail_table">
                <thead>
                    <tr>
                        <th><t t-esc="labels.account" /></th>
                        <th><t t-esc="labels.label" /></th>
                        <th><t t-esc="labels.partner" /></th>
                        <th class="text-end"><t t-esc="labels.debit" /></th>
                        <th class="text-end"><t t-esc="labels.credit" /></th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.lines" t-as="ml" t-key="ml.id">
                        <td t-esc="ml.account" />
                        <td t-esc="ml.label" />
                        <td t-esc="ml.partner" />
                        <td class="text-end" t-esc="format(ml.debit)" />
                        <td class="text-end" t-esc="format(ml.credit)" />
                    </tr>
                </tbody>
            </table>
            <div t-if="props.onOpen" class="mt-2">
                <a href="#" t-on-click.prevent.stop="() => props.onOpen()">
                    <i class="fa fa-external-link me-1" /><t t-esc="labels.open" />
                </a>
            </div>
        </div>
    </t>

</templates>
