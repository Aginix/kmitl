<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="accounting_kmitl_reports.GeneralLedger" owl="1">
        <div class="o_kmitl_general_ledger o_action_manager p-3">
            <div class="o_kmitl_gl_header d-flex align-items-center mb-3">
                <h2 class="m-0 flex-grow-1"><t t-esc="labels.title" /></h2>
                <button class="btn btn-link me-2" t-on-click="changeCriteria">
                    <i class="fa fa-sliders me-1" /><t t-esc="labels.changeCriteria" />
                </button>
                <button class="btn btn-secondary me-2" t-on-click="exportCsv">
                    <i class="fa fa-file-text-o me-1" /><t t-esc="labels.exportCsv" />
                </button>
                <button class="btn btn-secondary me-2" t-on-click="exportXlsx">
                    <i class="fa fa-file-excel-o me-1" /><t t-esc="labels.exportExcel" />
                </button>
                <button class="btn btn-primary" t-on-click="printPdf">
                    <i class="fa fa-file-pdf-o me-1" /><t t-esc="labels.printPdf" />
                </button>
            </div>

            <!-- Filter bar (mirrors the Trial Balance) -->
            <div class="o_kmitl_gl_filterpanel mb-3">
                <div class="o_kmitl_gl_filters row g-2">
                <div class="col-md-3">
                    <label class="o_form_label">Fiscal Year</label>
                    <select class="form-select" t-on-change="onFiscalYearChange">
                        <option value="">/</option>
                        <option
                            t-foreach="fiscalYears"
                            t-as="fy"
                            t-key="fy.id"
                            t-att-value="fy.id"
                            t-att-selected="fy.id === state.fiscalYearId"
                        >
                            <t t-esc="fy.name" />
                        </option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="o_form_label">Date From</label>
                    <input
                        type="date"
                        class="form-control"
                        t-att-value="state.dateFrom"
                        t-on-change="onDateFromChange"
                    />
                </div>
                <div class="col-md-2">
                    <label class="o_form_label">Date To</label>
                    <input
                        type="date"
                        class="form-control"
                        t-att-value="state.dateTo"
                        t-on-change="onDateToChange"
                    />
                </div>
                <div class="col-md-5 d-flex align-items-end gap-3">
                    <div class="form-check">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            id="kmitl_gl_posted"
                            t-att-checked="state.onlyPosted"
                            t-on-change="onTogglePosted"
                        />
                        <label class="form-check-label" for="kmitl_gl_posted">Posted entries only</label>
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            id="kmitl_gl_hide0"
                            t-att-checked="state.hideAt0"
                            t-on-change="onToggleHide"
                        />
                        <label class="form-check-label" for="kmitl_gl_hide0">Hide accounts at 0</label>
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            id="kmitl_gl_expand_all"
                            t-att-checked="state.expandAll"
                            t-on-change="onToggleExpandAll"
                        />
                        <label class="form-check-label" for="kmitl_gl_expand_all">Expand all</label>
                    </div>
                </div>

                <!-- KMITL accounting dimensions -->
                <div class="col-md-3">
                    <label class="o_form_label">Departments</label>
                    <MultiRecordSelect
                        resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'departments']]"
                        placeholder="labels.departments"
                        selected="state.departments"
                        onChange="(sel) => this.onSelectionChange('departments', sel)"
                        withOnlySelf="true"
                        onlySelf="state.dimOnlySelf.departments"
                        onOnlySelfChange="(val) => this.onToggleDimOnlySelf('departments', val)"
                    />
                </div>
                <div class="col-md-3">
                    <label class="o_form_label">Sources</label>
                    <MultiRecordSelect
                        resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'sources']]"
                        placeholder="labels.sources"
                        selected="state.sources"
                        onChange="(sel) => this.onSelectionChange('sources', sel)"
                        withOnlySelf="true"
                        onlySelf="state.dimOnlySelf.sources"
                        onOnlySelfChange="(val) => this.onToggleDimOnlySelf('sources', val)"
                    />
                </div>
                <div class="col-md-3">
                    <label class="o_form_label">Funds</label>
                    <MultiRecordSelect
                        resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'funds']]"
                        placeholder="labels.funds"
                        selected="state.funds"
                        onChange="(sel) => this.onSelectionChange('funds', sel)"
                        withOnlySelf="true"
                        onlySelf="state.dimOnlySelf.funds"
                        onOnlySelfChange="(val) => this.onToggleDimOnlySelf('funds', val)"
                    />
                </div>
                <div class="col-md-3">
                    <label class="o_form_label">Activities</label>
                    <MultiRecordSelect
                        resModel="'account.analytic.account'"
                        domain="[['root_plan_id.code', '=', 'activities']]"
                        placeholder="labels.activities"
                        selected="state.activities"
                        onChange="(sel) => this.onSelectionChange('activities', sel)"
                        withOnlySelf="true"
                        onlySelf="state.dimOnlySelf.activities"
                        onOnlySelfChange="(val) => this.onToggleDimOnlySelf('activities', val)"
                    />
                </div>

                <!-- Standard filters (collapsed by default) -->
                <div class="col-12">
                    <button class="btn btn-link p-0 o_kmitl_gl_more" t-on-click="toggleAdvanced">
                        <i
                            t-att-class="state.showAdvanced ? 'fa fa-caret-down me-1' : 'fa fa-caret-right me-1'"
                        />
                        <t t-if="state.showAdvanced">Hide journal / partner / account filters</t>
                        <t t-else="">More filters</t>
                    </button>
                </div>
                <t t-if="state.showAdvanced">
                    <div class="col-md-3">
                        <label class="o_form_label">Journals</label>
                        <MultiRecordSelect
                            resModel="'account.journal'"
                            domain="[['company_id', '=', companyId]]"
                            placeholder="labels.journals"
                            selected="state.journals"
                            onChange="(sel) => this.onSelectionChange('journals', sel)"
                        />
                    </div>
                    <div class="col-md-3">
                        <label class="o_form_label">Partners</label>
                        <MultiRecordSelect
                            resModel="'res.partner'"
                            placeholder="labels.partners"
                            selected="state.partners"
                            onChange="(sel) => this.onSelectionChange('partners', sel)"
                        />
                    </div>
                    <div class="col-md-3">
                        <label class="o_form_label">Accounts</label>
                        <MultiRecordSelect
                            resModel="'account.account'"
                            domain="[['company_id', '=', companyId]]"
                            placeholder="labels.accounts"
                            selected="state.accounts"
                            onChange="(sel) => this.onSelectionChange('accounts', sel)"
                        />
                    </div>
                    <div class="col-md-3">
                        <label class="o_form_label">Account code range</label>
                        <div class="d-flex gap-1">
                            <MultiRecordSelect
                                resModel="'account.account'"
                                domain="[['company_id', '=', companyId]]"
                                placeholder="labels.accountFrom"
                                single="true"
                                selected="state.accountFrom"
                                onChange="(sel) => this.onSelectionChange('accountFrom', sel)"
                            />
                            <MultiRecordSelect
                                resModel="'account.account'"
                                domain="[['company_id', '=', companyId]]"
                                placeholder="labels.accountTo"
                                single="true"
                                selected="state.accountTo"
                                onChange="(sel) => this.onSelectionChange('accountTo', sel)"
                            />
                        </div>
                    </div>
                </t>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="text-center p-5">
                    <span class="spinner-border" role="status" />
                </div>
            </t>
            <t t-elif="!state.sections.length">
                <div class="text-center text-muted p-5">
                    <t t-esc="labels.empty" />
                </div>
            </t>
            <t t-else="">
                <div t-if="showPager" class="o_kmitl_gl_pager d-flex align-items-center justify-content-end gap-2 mb-2">
                    <label class="o_form_label m-0 me-1"><t t-esc="labels.rowsPerPage" /></label>
                    <select class="form-select form-select-sm w-auto" t-on-change="setPageSize">
                        <option value="100" t-att-selected="state.pageSize === 100">100</option>
                        <option value="250" t-att-selected="state.pageSize === 250">250</option>
                        <option value="500" t-att-selected="state.pageSize === 500">500</option>
                    </select>
                    <div class="btn-group btn-group-sm ms-2">
                        <button
                            class="btn btn-outline-secondary"
                            t-att-disabled="isFirstPage"
                            t-att-aria-label="labels.prevPage"
                            t-on-click="prevPage"
                        >
                            <i class="fa fa-chevron-left" />
                        </button>
                        <span class="btn btn-outline-secondary disabled">
                            <t t-esc="state.page + 1" /> / <t t-esc="pageCount" />
                        </span>
                        <button
                            class="btn btn-outline-secondary"
                            t-att-disabled="isLastPage"
                            t-att-aria-label="labels.nextPage"
                            t-on-click="nextPage"
                        >
                            <i class="fa fa-chevron-right" />
                        </button>
                    </div>
                </div>
                <div
                    t-foreach="pagedSections"
                    t-as="acc"
                    t-key="acc.id"
                    class="o_kmitl_gl_account mb-3"
                >
                    <div class="o_kmitl_gl_acc_head">
                        <span class="o_kmitl_gl_acc_code"><t t-esc="acc.code" /></span>
                        <span class="o_kmitl_gl_acc_name"><t t-esc="acc.name" /></span>
                    </div>
                    <table class="table table-sm table-hover align-middle o_kmitl_gl_table mb-0">
                        <thead>
                            <tr>
                                <th style="width: 24px;" />
                                <th><t t-esc="labels.date" /></th>
                                <th><t t-esc="labels.issue" /></th>
                                <th><t t-esc="labels.account" /></th>
                                <th><t t-esc="labels.remark" /></th>
                                <th class="text-end"><t t-esc="labels.debit" /></th>
                                <th class="text-end"><t t-esc="labels.credit" /></th>
                                <th class="text-end"><t t-esc="labels.balance" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="acc.showOpening" class="o_kmitl_gl_opening">
                                <td />
                                <td colspan="6" class="fst-italic"><t t-esc="labels.opening" /></td>
                                <td class="text-end" t-att-class="negClass(acc.initial_balance)" t-esc="format(acc.initial_balance)" />
                            </tr>
                            <tr t-else="" class="o_kmitl_gl_opening">
                                <td />
                                <td colspan="6" class="fst-italic"><t t-esc="labels.broughtForward" /></td>
                                <td class="text-end" t-att-class="negClass(acc.broughtForward)" t-esc="formatTotal(acc.broughtForward)" />
                            </tr>
                            <t t-foreach="acc.lines" t-as="line" t-key="line.id">
                                <tr class="o_kmitl_gl_row" t-att-class="line_index % 2 ? 'o_kmitl_gl_stripe' : ''" t-on-click="() => this.toggleExpand(line)">
                                    <td>
                                        <i
                                            class="fa"
                                            t-att-class="state.expanded[line.id] ? 'fa-caret-down' : 'fa-caret-right'"
                                        />
                                    </td>
                                    <td class="text-nowrap" t-esc="line.date" />
                                    <td t-esc="line.issue" />
                                    <td t-esc="line.account" />
                                    <td t-esc="line.narration" />
                                    <td class="text-end" t-esc="format(line.debit)" />
                                    <td class="text-end" t-esc="format(line.credit)" />
                                    <td class="text-end" t-att-class="negClass(line.balance)" t-esc="format(line.balance)" />
                                </tr>
                                <tr t-if="state.expanded[line.id]" class="o_kmitl_gl_detail">
                                    <td colspan="8" class="p-0">
                                        <MoveLinesDetail
                                            lines="state.linesByMove[line.entry_id] || []"
                                            narration="line.narration"
                                            maker="line.maker"
                                            makerDate="line.maker_date"
                                            onOpen="() => this.openEntry(line)"
                                        />
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="acc.showCarried" class="o_kmitl_gl_ending fw-bold">
                                <td />
                                <td colspan="4"><t t-esc="labels.carried" /></td>
                                <td class="text-end" t-esc="formatTotal(acc.final_debit)" />
                                <td class="text-end" t-esc="formatTotal(acc.final_credit)" />
                                <td class="text-end" t-att-class="negClass(acc.final_balance)" t-esc="formatTotal(acc.final_balance)" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>

</templates>
