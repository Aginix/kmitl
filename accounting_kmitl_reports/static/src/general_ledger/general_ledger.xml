<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="accounting_kmitl_reports.GeneralLedger" owl="1">
        <div class="o_kmitl_general_ledger o_action_manager p-3">
            <div class="d-flex align-items-center mb-3">
                <h2 class="me-auto mb-0">
                    <t t-esc="labels.title" />
                    <small class="text-muted ms-2" t-if="state.dateFrom">
                        <t t-esc="state.dateFrom" /> – <t t-esc="state.dateTo" />
                    </small>
                </h2>
                <button class="btn btn-link" t-on-click="changeCriteria">
                    <i class="fa fa-sliders me-1" /><t t-esc="labels.changeCriteria" />
                </button>
                <button class="btn btn-secondary ms-2" t-on-click="exportXlsx">
                    <i class="fa fa-file-excel-o me-1" /><t t-esc="labels.exportExcel" />
                </button>
                <button class="btn btn-primary ms-2" t-on-click="printPdf">
                    <i class="fa fa-file-pdf-o me-1" /><t t-esc="labels.printPdf" />
                </button>
            </div>

            <t t-if="state.loading">
                <div class="text-center p-5">
                    <span class="spinner-border" role="status" />
                </div>
            </t>
            <t t-elif="!state.accounts.length">
                <div class="text-center text-muted p-5">
                    <t t-esc="labels.empty" />
                </div>
            </t>
            <t t-else="">
                <table class="table table-hover align-middle o_kmitl_gl_table">
                    <thead>
                        <tr>
                            <th style="width: 24px;" />
                            <th><t t-esc="labels.account" /></th>
                            <th class="text-end"><t t-esc="labels.opening" /></th>
                            <th class="text-end"><t t-esc="labels.debit" /></th>
                            <th class="text-end"><t t-esc="labels.credit" /></th>
                            <th class="text-end"><t t-esc="labels.ending" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.accounts" t-as="acc" t-key="acc.id">
                            <tr class="o_kmitl_gl_row" t-on-click="() => this.toggleExpand(acc)">
                                <td>
                                    <i
                                        class="fa"
                                        t-att-class="state.expandedId === acc.id ? 'fa-caret-down' : 'fa-caret-right'"
                                    />
                                </td>
                                <td>
                                    <strong><t t-esc="acc.code" /></strong> - <t t-esc="acc.name" />
                                </td>
                                <td class="text-end" t-esc="format(acc.initial_balance)" />
                                <td class="text-end" t-esc="format(acc.period_debit)" />
                                <td class="text-end" t-esc="format(acc.period_credit)" />
                                <td class="text-end fw-bold" t-esc="format(acc.final_balance)" />
                            </tr>
                            <tr t-if="state.expandedId === acc.id" class="o_kmitl_gl_detail">
                                <td colspan="6" class="p-0">
                                    <div class="p-3 bg-light border-top">
                                        <table class="table table-sm table-bordered mb-0 bg-white o_kmitl_gl_detail_table">
                                            <thead>
                                                <tr>
                                                    <th><t t-esc="labels.date" /></th>
                                                    <th><t t-esc="labels.entry" /></th>
                                                    <th><t t-esc="labels.journal" /></th>
                                                    <th><t t-esc="labels.partner" /></th>
                                                    <th><t t-esc="labels.label" /></th>
                                                    <th class="text-end"><t t-esc="labels.debit" /></th>
                                                    <th class="text-end"><t t-esc="labels.credit" /></th>
                                                    <th class="text-end"><t t-esc="labels.balance" /></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="o_kmitl_gl_opening">
                                                    <td colspan="7" class="text-end fst-italic">
                                                        <t t-esc="labels.opening" />
                                                    </td>
                                                    <td class="text-end" t-esc="format(acc.initial_balance)" />
                                                </tr>
                                                <tr t-foreach="acc.lines" t-as="line" t-key="line.id">
                                                    <td t-esc="line.date" />
                                                    <td>
                                                        <a
                                                            href="#"
                                                            t-on-click.prevent="() => this.openEntry(line)"
                                                            t-att-title="labels.open"
                                                        >
                                                            <t t-esc="line.entry" />
                                                        </a>
                                                    </td>
                                                    <td t-esc="line.journal" />
                                                    <td t-esc="line.partner" />
                                                    <td t-esc="line.ref_label" />
                                                    <td class="text-end" t-esc="format(line.debit)" />
                                                    <td class="text-end" t-esc="format(line.credit)" />
                                                    <td class="text-end" t-esc="format(line.balance)" />
                                                </tr>
                                                <tr class="o_kmitl_gl_ending fw-bold">
                                                    <td colspan="5" class="text-end"><t t-esc="labels.ending" /></td>
                                                    <td class="text-end" t-esc="format(acc.final_debit)" />
                                                    <td class="text-end" t-esc="format(acc.final_credit)" />
                                                    <td class="text-end" t-esc="format(acc.final_balance)" />
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </div>
    </t>

</templates>
