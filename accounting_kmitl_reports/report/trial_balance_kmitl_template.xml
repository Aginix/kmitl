<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="trial_balance_kmitl">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="header" style="border-bottom: 1px solid #000;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="width: 70px; border: none; vertical-align: top;">
                                <img
                                    t-if="res_company.logo"
                                    t-att-src="image_data_uri(res_company.logo)"
                                    style="max-height: 60px; max-width: 60px;"
                                    alt="Logo"
                                />
                            </td>
                            <td style="border: none; text-align: center; vertical-align: middle; line-height: 1.6;">
                                <div style="font-size: 14pt; font-weight: bold; margin-bottom: 4px;">
                                    <t t-out="res_company.display_name" />
                                </div>
                                <div style="font-size: 16pt; font-weight: bold; margin-bottom: 6px;">Trial Balance</div>
                                <div style="font-size: 12pt;">
                                    <span>From</span>
                                    <t t-out="date_from_label" />
                                    <span>to</span>
                                    <t t-out="date_to_label" />
                                </div>
                            </td>
                            <td style="width: 70px; border: none;" />
                        </tr>
                    </table>
                </div>

                <div class="footer" style="text-align: right; font-size: 10pt;">
                    <span class="page" />/<span class="topage" />
                </div>

                <div class="article">
                    <style>
                        table.kmitl-trial-balance {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 9pt;
                        }
                        table.kmitl-trial-balance th,
                        table.kmitl-trial-balance td {
                            border: 1px solid #000;
                            padding: 3px 5px;
                        }
                        table.kmitl-trial-balance thead th {
                            background-color: #f0f0f0;
                            text-align: center;
                            font-weight: bold;
                        }
                        table.kmitl-trial-balance td.text-right,
                        table.kmitl-trial-balance th.text-right {
                            text-align: right;
                        }
                        table.kmitl-trial-balance tfoot td {
                            font-weight: bold;
                            background-color: #f0f0f0;
                        }
                    </style>
                    <table class="kmitl-trial-balance">
                        <thead style="display: table-header-group;">
                            <tr>
                                <th rowspan="2" style="width: 22%;">Account</th>
                                <th colspan="3">Opening</th>
                                <th colspan="3">During Period</th>
                                <th colspan="3">Ending</th>
                            </tr>
                            <tr>
                                <th class="text-right">Debit</th>
                                <th class="text-right">Credit</th>
                                <th class="text-right">Balance</th>
                                <th class="text-right">Debit</th>
                                <th class="text-right">Credit</th>
                                <th class="text-right">Balance</th>
                                <th class="text-right">Debit</th>
                                <th class="text-right">Credit</th>
                                <th class="text-right">Balance</th>
                            </tr>
                        </thead>
                        <tfoot style="display: table-footer-group;">
                            <tr>
                                <td>Total</td>
                                <td class="text-right" t-out="format_amount(totals['opening_debit'])" />
                                <td class="text-right" t-out="format_amount(totals['opening_credit'])" />
                                <td class="text-right" t-out="format_amount(totals['opening_balance'])" />
                                <td class="text-right" t-out="format_amount(totals['period_debit'])" />
                                <td class="text-right" t-out="format_amount(totals['period_credit'])" />
                                <td class="text-right" t-out="format_amount(totals['period_balance'])" />
                                <td class="text-right" t-out="format_amount(totals['ending_debit'])" />
                                <td class="text-right" t-out="format_amount(totals['ending_credit'])" />
                                <td class="text-right" t-out="format_amount(totals['ending_balance'])" />
                            </tr>
                        </tfoot>
                        <tbody>
                            <tr t-foreach="rows" t-as="row">
                                <td>
                                    <t t-out="row['code']" /> - <t t-out="row['name']" />
                                </td>
                                <td class="text-right" t-out="format_amount(row['opening_debit'])" />
                                <td class="text-right" t-out="format_amount(row['opening_credit'])" />
                                <td class="text-right" t-out="format_amount(row['opening_balance'])" />
                                <td class="text-right" t-out="format_amount(row['period_debit'])" />
                                <td class="text-right" t-out="format_amount(row['period_credit'])" />
                                <td class="text-right" t-out="format_amount(row['period_balance'])" />
                                <td class="text-right" t-out="format_amount(row['ending_debit'])" />
                                <td class="text-right" t-out="format_amount(row['ending_credit'])" />
                                <td class="text-right" t-out="format_amount(row['ending_balance'])" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
