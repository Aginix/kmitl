<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Entry-point wizard: pick the accounts (GL) and the period, then open
         the OWL report (which still exposes the full in-screen filter bar). -->
    <record id="view_general_ledger_wizard_kmitl_form" model="ir.ui.view">
        <field name="name">general.ledger.report.wizard.kmitl.form</field>
        <field name="model">general.ledger.report.wizard.kmitl</field>
        <field name="arch" type="xml">
            <form string="General Ledger">
                <field name="company_id" invisible="1" />
                <group>
                    <group>
                        <field
                            name="fiscal_year_id"
                            options="{'no_create': True}"
                            domain="[('company_id', '=', company_id)]"
                        />
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </group>
                <separator string="Accounts" />
                <field
                    name="account_ids"
                    nolabel="1"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    domain="[('company_id', '=', company_id), ('deprecated', '=', False)]"
                    placeholder="Leave empty for all accounts"
                />
                <footer>
                    <button
                        name="action_view_general_ledger"
                        type="object"
                        string="View Report"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_general_ledger_wizard_kmitl" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">general.ledger.report.wizard.kmitl</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_general_ledger_wizard_kmitl_form" />
        <field name="target">new</field>
    </record>
</odoo>
