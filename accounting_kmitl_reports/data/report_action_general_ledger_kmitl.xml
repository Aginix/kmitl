<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_general_ledger_kmitl" model="report.paperformat">
        <field name="name">KMITL General Ledger A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">4</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_general_ledger_kmitl" model="ir.actions.report">
        <field name="name">General Ledger</field>
        <field name="model">general.ledger.report.wizard.kmitl</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">accounting_kmitl_reports.general_ledger_kmitl</field>
        <field name="report_file">accounting_kmitl_reports.general_ledger_kmitl</field>
        <field name="paperformat_id" ref="paperformat_general_ledger_kmitl" />
        <field name="binding_model_id" eval="False" />
    </record>

    <record id="action_report_general_ledger_kmitl_xlsx" model="ir.actions.report">
        <field name="name">General Ledger (XLSX)</field>
        <field name="model">general.ledger.report.wizard.kmitl</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">accounting_kmitl_reports.general_ledger_xlsx</field>
        <field name="report_file">accounting_kmitl_reports.general_ledger_xlsx</field>
        <field name="binding_model_id" eval="False" />
    </record>

    <record id="action_report_general_ledger_kmitl_csv" model="ir.actions.report">
        <field name="name">General Ledger (CSV)</field>
        <field name="model">general.ledger.report.wizard.kmitl</field>
        <field name="report_type">csv</field>
        <field name="report_name">accounting_kmitl_reports.general_ledger_csv</field>
        <field name="report_file">accounting_kmitl_reports.general_ledger_csv</field>
        <field name="encoding">utf-8-sig</field>
        <field name="binding_model_id" eval="False" />
    </record>
</odoo>
