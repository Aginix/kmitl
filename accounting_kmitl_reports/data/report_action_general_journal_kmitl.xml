<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_general_journal_kmitl" model="report.paperformat">
        <field name="name">KMITL General Journal A4 Landscape</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">28</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_general_journal_kmitl" model="ir.actions.report">
        <field name="name">General Journal</field>
        <field name="model">general.journal.report.wizard.kmitl</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">accounting_kmitl_reports.general_journal_kmitl</field>
        <field name="report_file">accounting_kmitl_reports.general_journal_kmitl</field>
        <field name="paperformat_id" ref="paperformat_general_journal_kmitl" />
        <field name="binding_model_id" eval="False" />
    </record>

    <record id="action_report_general_journal_kmitl_xlsx" model="ir.actions.report">
        <field name="name">General Journal (XLSX)</field>
        <field name="model">general.journal.report.wizard.kmitl</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">accounting_kmitl_reports.general_journal_xlsx</field>
        <field name="report_file">accounting_kmitl_reports.general_journal_xlsx</field>
        <field name="binding_model_id" eval="False" />
    </record>

    <record id="action_report_general_journal_kmitl_csv" model="ir.actions.report">
        <field name="name">General Journal (CSV)</field>
        <field name="model">general.journal.report.wizard.kmitl</field>
        <field name="report_type">csv</field>
        <field name="report_name">accounting_kmitl_reports.general_journal_csv</field>
        <field name="report_file">accounting_kmitl_reports.general_journal_csv</field>
        <field name="encoding">utf-8-sig</field>
        <field name="binding_model_id" eval="False" />
    </record>
</odoo>
