<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <!-- Cash Flow Statement (งบกระแสเงินสด) -->
    <!-- Skeleton with 3 sections: operating / investing / financing.       -->
    <!-- KPI expressions filter on account_type by default; adjust the      -->
    <!-- account selectors per KMITL chart of accounts to classify accounts -->
    <!-- into the right activity bucket.                                    -->
    <record id="report_cf_kmitl" model="mis.report">
        <field name="name">งบกระแสเงินสด</field>
        <field name="style_id" ref="style_kmitl_default" />
    </record>

    <!-- ================================================================= -->
    <!-- 1. กิจกรรมดำเนินงาน (Operating Activities)                          -->
    <!-- ================================================================= -->
    <record id="kpi_cf_operating" model="mis.report.kpi">
        <field name="report_id" ref="report_cf_kmitl" />
        <field name="name">cf_operating</field>
        <field name="description">กระแสเงินสดจากกิจกรรมดำเนินงาน</field>
        <field name="expression">balp[('account_type', 'in', ('income_other', 'expense', 'expense_depreciation', 'expense_direct_cost', 'asset_receivable', 'liability_payable'))][]</field>
        <field name="auto_expand_accounts">true</field>
        <field name="auto_expand_accounts_style_id" ref="style_kmitl_detail" />
        <field name="style_id" ref="style_kmitl_section" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">10</field>
        <field name="split_after" eval="True" />
    </record>

    <!-- ================================================================= -->
    <!-- 2. กิจกรรมลงทุน (Investing Activities)                              -->
    <!-- ================================================================= -->
    <record id="kpi_cf_investing" model="mis.report.kpi">
        <field name="report_id" ref="report_cf_kmitl" />
        <field name="name">cf_investing</field>
        <field name="description">กระแสเงินสดจากกิจกรรมลงทุน</field>
        <field name="expression">balp[('account_type', 'in', ('asset_fixed', 'asset_non_current'))][]</field>
        <field name="auto_expand_accounts">true</field>
        <field name="auto_expand_accounts_style_id" ref="style_kmitl_detail" />
        <field name="style_id" ref="style_kmitl_section" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">20</field>
        <field name="split_after" eval="True" />
    </record>

    <!-- ================================================================= -->
    <!-- 3. กิจกรรมจัดหาเงิน (Financing Activities)                          -->
    <!-- ================================================================= -->
    <record id="kpi_cf_financing" model="mis.report.kpi">
        <field name="report_id" ref="report_cf_kmitl" />
        <field name="name">cf_financing</field>
        <field name="description">กระแสเงินสดจากกิจกรรมจัดหาเงิน</field>
        <field name="expression">balp[('account_type', 'in', ('liability_non_current', 'liability_credit_card', 'equity', 'equity_unaffected'))][]</field>
        <field name="auto_expand_accounts">true</field>
        <field name="auto_expand_accounts_style_id" ref="style_kmitl_detail" />
        <field name="style_id" ref="style_kmitl_section" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">30</field>
        <field name="split_after" eval="True" />
    </record>

    <!-- ================================================================= -->
    <!-- เงินสดเพิ่ม(ลด)สุทธิ (Net change in cash)                            -->
    <!-- ================================================================= -->
    <record id="kpi_cf_net_change" model="mis.report.kpi">
        <field name="report_id" ref="report_cf_kmitl" />
        <field name="name">cf_net_change</field>
        <field name="description">เงินสดเพิ่ม(ลด)สุทธิ</field>
        <field name="expression">cf_operating + cf_investing + cf_financing</field>
        <field name="auto_expand_accounts">false</field>
        <field name="style_id" ref="style_kmitl_subsection" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="sequence">40</field>
    </record>

    <!-- เงินสดต้นงวด (Cash at beginning) -->
    <record id="kpi_cf_cash_start" model="mis.report.kpi">
        <field name="report_id" ref="report_cf_kmitl" />
        <field name="name">cf_cash_start</field>
        <field name="description">เงินสดต้นงวด</field>
        <field name="expression">bali[('account_type', 'in', ('asset_cash',))][]</field>
        <field name="auto_expand_accounts">false</field>
        <field name="style_id" ref="style_kmitl_detail" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="sequence">50</field>
    </record>

    <!-- เงินสดปลายงวด (Cash at end) -->
    <record id="kpi_cf_cash_end" model="mis.report.kpi">
        <field name="report_id" ref="report_cf_kmitl" />
        <field name="name">cf_cash_end</field>
        <field name="description">เงินสดปลายงวด</field>
        <field name="expression">bale[('account_type', 'in', ('asset_cash',))][]</field>
        <field name="auto_expand_accounts">false</field>
        <field name="style_id" ref="style_kmitl_total" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">none</field>
        <field name="sequence">60</field>
    </record>

</odoo>
