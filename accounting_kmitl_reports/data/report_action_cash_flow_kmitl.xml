<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_cash_flow_kmitl" model="report.paperformat">
        <field name="name">KMITL Cash Flow A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">50</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_cash_flow_kmitl" model="ir.actions.report">
        <field name="name">Cash Flow Statement</field>
        <field name="model">cash.flow.report.wizard.kmitl</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">accounting_kmitl_reports.cash_flow_kmitl</field>
        <field name="report_file">accounting_kmitl_reports.cash_flow_kmitl</field>
        <field name="paperformat_id" ref="paperformat_cash_flow_kmitl" />
        <field name="binding_model_id" eval="False" />
    </record>

    <record id="action_report_cash_flow_kmitl_xlsx" model="ir.actions.report">
        <field name="name">Cash Flow Statement (XLSX)</field>
        <field name="model">cash.flow.report.wizard.kmitl</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">accounting_kmitl_reports.cash_flow_xlsx</field>
        <field name="report_file">accounting_kmitl_reports.cash_flow_xlsx</field>
        <field name="binding_model_id" eval="False" />
    </record>

    <record id="action_report_cash_flow_kmitl_csv" model="ir.actions.report">
        <field name="name">Cash Flow Statement (CSV)</field>
        <field name="model">cash.flow.report.wizard.kmitl</field>
        <field name="report_type">csv</field>
        <field name="report_name">accounting_kmitl_reports.cash_flow_csv</field>
        <field name="report_file">accounting_kmitl_reports.cash_flow_csv</field>
        <field name="encoding">utf-8-sig</field>
        <field name="binding_model_id" eval="False" />
    </record>
</odoo>
