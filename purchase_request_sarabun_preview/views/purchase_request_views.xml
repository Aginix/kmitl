<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_request_form_sarabun_preview" model="ir.ui.view">
        <field name="name">purchase.request.form.sarabun.preview</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_sarabun.view_purchase_request_form_sarabun"/>
        <field name="arch" type="xml">
            <!-- The หนังสือ this request sends to e-Saraban, before and after
                 Create Sarabun. -->
            <xpath expr="//button[@name='button_draft']" position="before">
                <button name="action_preview_sarabun_document"
                        string="ดูตัวอย่างเอกสาร"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
            </xpath>
        </field>
    </record>

</odoo>
