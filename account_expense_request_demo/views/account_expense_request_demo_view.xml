<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_account_expense_request_demo_tree" model="ir.ui.view">
        <field name="name">account.expense.request.demo.tree</field>
        <field name="model">account.expense.request.demo</field>
        <field name="arch" type="xml">
            <tree string="Expense Requests">
                <field name="name" />
                <field name="requester_id" />
                <field name="date" />
                <field name="amount_total" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'done')" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_account_expense_request_demo_form" model="ir.ui.view">
        <field name="name">account.expense.request.demo.tree</field>
        <field name="model">account.expense.request.demo</field>
        <field name="arch" type="xml">
            <form string="Expense Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <!-- <button name="action_approve" string="Approve" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'submitted')]}" /> -->
                    <button name="action_draft" string="Reset to draft" type="object" class="btn btn-secondary" attrs="{'invisible': [('state', '!=', 'submitted')]}" groups="account.group_account_manager" />
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '!=', 'approved')]}" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="requester_id" />
                            <field name="approver_id" />
                            <field name="responsible_id" />
                            <field name="department_id" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                            <field name="source_analytic_id" options="{'no_create': True, 'no_open': True}" />
                            <field name="department_analytic_id" options="{'no_create': True, 'no_open': True}" />
                            <field name="fund_analytic_id" options="{'no_create': True, 'no_open': True}" />
                            <field name="activity_analytic_id" options="{'no_create': True, 'no_open': True}" />
                            <field name="budget_account_id" required="1" options="{'no_create': True, 'no_open': True}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="รายละเอียด" name="detail">
                            <group>
                                <field name="amount_total" />
                                <field name="description" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_account_expense_request_demo_search" model="ir.ui.view">
        <field name="name">account.expense.request.demo.search</field>
        <field name="model">account.expense.request.demo</field>
        <field name="arch" type="xml">
            <search string="Expense Requests">
                <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]" />
                <field name="requester_id" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]" />
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]" />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="date" string="Date" date="date" />
                <group expand="0" string="Group By">
                    <filter string="Date" name="date" context="{'group_by': 'date'}" />
                    <filter string="State" name="state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_account_expense_request_demo" model="ir.actions.act_window">
        <field name="name">Expense Requests</field>
        <field name="res_model">account.expense.request.demo</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Expense Request
            </p>
            <p>
                Expense requests are used to hold information before creating Move Request.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_account_expense_request_demo" name="Expense Requests" parent="account.menu_finance_entries" action="action_account_expense_request_demo" sequence="10" />
</odoo>
