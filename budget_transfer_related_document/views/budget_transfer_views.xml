<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_transfer_form" model="ir.ui.view">
        <field name="name">budget.transfer.form.related.document</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <notebook position="before">
                <group name="related_documents" string="เอกสารอ้างอิง">
                    <field
                        name="related_document_ids"
                        nolabel="1"
                        colspan="2"
                        context="{'tree_view_ref': 'agx_related_document.view_related_document_embedded_tree', 'default_res_model': 'budget.transfer'}"
                        attrs="{'readonly': [('state', 'in', ['posted', 'cancelled'])]}"
                    />
                </group>
            </notebook>
        </field>
    </record>
</odoo>
