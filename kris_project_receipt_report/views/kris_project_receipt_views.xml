<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- TREE (readonly)                                              -->
    <!-- ============================================================ -->
    <record id="view_kris_project_receipt_tree_report" model="ir.ui.view">
        <field name="name">kris.project.receipt.tree.report</field>
        <field name="model">kris.project.receipt</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" string="Receipts">
                <field name="currency_id" invisible="1"/>
                <field name="project_id" string="Project Number"/>
                <field name="project_name" string="Project Name"/>
                <field name="project_category_id" string="Project Category"/>
                <field name="date" string="Receipt Date"/>
                <field name="installment_id" string="Installment"/>
                <field name="name" string="Receipt Number"/>
                <field name="amount" string="Amount" sum="Total"/>
                <field name="net_amount" string="Net Amount" sum="Net Total"/>
                <field name="note" string="Note" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- PIVOT                                                        -->
    <!-- ============================================================ -->
    <record id="view_kris_project_receipt_pivot_report" model="ir.ui.view">
        <field name="name">kris.project.receipt.pivot.report</field>
        <field name="model">kris.project.receipt</field>
        <field name="arch" type="xml">
            <pivot string="Receipts (Pivot)" sample="1">
                <field name="fiscal_year_id" type="row"/>
                <field name="project_category_id" type="col"/>
                <field name="amount" type="measure"/>
                <field name="net_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM (readonly, primary inherit)                             -->
    <!-- ============================================================ -->
    <record id="view_kris_project_receipt_form_readonly" model="ir.ui.view">
        <field name="name">kris.project.receipt.form.readonly</field>
        <field name="model">kris.project.receipt</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_receipt_form"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH + SearchPanel                                         -->
    <!-- ============================================================ -->
    <record id="view_kris_project_receipt_search_report" model="ir.ui.view">
        <field name="name">kris.project.receipt.search.report</field>
        <field name="model">kris.project.receipt</field>
        <field name="arch" type="xml">
            <search string="Receipts">
                <field name="name" string="Receipt Number"/>
                <field name="project_id"/>
                <field name="installment_id"/>
                <field name="fiscal_year_id"/>
                <field name="project_category_id"/>

                <filter name="this_year"
                        string="This Year"
                        domain="[
                            ('date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                            ('date', '&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d')),
                        ]"/>
                <filter name="last_year"
                        string="Last Year"
                        domain="[
                            ('date', '&gt;=', (context_today() + relativedelta(years=-1, month=1, day=1)).strftime('%Y-%m-%d')),
                            ('date', '&lt;=', (context_today() + relativedelta(years=-1, month=12, day=31)).strftime('%Y-%m-%d')),
                        ]"/>

                <group expand="0" string="Group By">
                    <filter name="gb_date" string="Month/Year"
                            context="{'group_by': 'date'}"/>
                    <filter name="gb_fiscal" string="Fiscal Year"
                            context="{'group_by': 'fiscal_year_id'}"/>
                    <filter name="gb_type" string="Project Category"
                            context="{'group_by': 'project_category_id'}"/>
                    <filter name="gb_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="gb_installment" string="Installment"
                            context="{'group_by': 'installment_id'}"/>
                </group>

                <searchpanel>
                    <field name="fiscal_year_id"
                           string="Fiscal Year"
                           select="one"
                           icon="fa-calendar"/>
                    <field name="project_category_id"
                           string="Project Category"
                           select="one"
                           icon="fa-tag"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                       -->
    <!-- ============================================================ -->
    <record id="action_kris_project_receipt_report" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">kris.project.receipt</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="search_view_id" ref="view_kris_project_receipt_search_report"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_kris_project_receipt_tree_report')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_kris_project_receipt_pivot_report')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kris_project_receipt_form_readonly')}),
        ]"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No receipts yet</p>
            <p>Receipts will appear here when recorded from a project.</p>
        </field>
    </record>

</odoo>
