<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record model="ir.ui.view" id="resource_education_program_form_view">
    <field name="name">resource.education.program.form (in
      resource_education_program)</field>
    <field name="model">resource.education.program</field>
    <field name="arch" type="xml">
      <form>
        <header />
        <sheet>
          <group>
            <field name="name" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record model="ir.ui.view" id="resource_education_program_search_view">
    <field name="name">resource.education.program.search (in
      resource_education_program)</field>
    <field name="model">resource.education.program</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
      </search>
    </field>
  </record>
  <record model="ir.ui.view" id="resource_education_program_tree_view">
    <field name="name">resource.education.program.tree (in
      resource_education_program)</field>
    <field name="model">resource.education.program</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
      </tree>
    </field>
  </record>
  <record model="ir.actions.act_window" id="resource_education_program_act_window">
    <field name="name">Program List</field>
    <field name="res_model">resource.education.program</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>
