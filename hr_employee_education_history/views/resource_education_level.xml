<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record model="ir.ui.view" id="resource_education_level_form_view">
    <field name="name">resource.education.level.form (in
      resource_education_level)</field>
    <field name="model">resource.education.level</field>
    <field name="arch" type="xml">
      <form>
        <header />
        <sheet>
          <group>
            <field name="name" />
            <field name="level" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record model="ir.ui.view" id="resource_education_level_search_view">
    <field name="name">resource.education.level.search (in
      resource_education_level)</field>
    <field name="model">resource.education.level</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="level" />
      </search>
    </field>
  </record>
  <record model="ir.ui.view" id="resource_education_level_tree_view">
    <field name="name">resource.education.level.tree (in
      resource_education_level)</field>
    <field name="model">resource.education.level</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="level" />
      </tree>
    </field>
  </record>
  <record model="ir.actions.act_window" id="resource_education_level_act_window">
    <field name="name">Education Level</field>
    <field name="res_model">resource.education.level</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>
