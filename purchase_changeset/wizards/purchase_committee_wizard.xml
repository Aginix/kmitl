<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_purchase_committee_wizard_form" model="ir.ui.view">
        <field name="name">purchase.committee.wizard.form</field>
        <field name="model">purchase.committee.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Committee Wizard">
                <sheet>
                    <group>
                        <field name="purchase_id" invisible="1" />
                    </group>
                    <field name="partner_ref" />
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
