<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form.operating_unit</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </field>
        </field>
    </record>

    <record id="view_disbursement_request_tree" model="ir.ui.view">
        <field name="name">disbursement.request.tree.operating_unit</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_tree" />
        <field name="arch" type="xml">
            <field name="source_analytic_id" position="after">
                <field
                    name="operating_unit_id"
                    optional="hide"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </field>
        </field>
    </record>

    <record id="view_disbursement_request_search" model="ir.ui.view">
        <field name="name">disbursement.request.search.operating_unit</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search" />
        <field name="arch" type="xml">
            <filter name="group_source" position="after">
                <filter
                    string="Operating Unit"
                    name="group_operating_unit"
                    domain="[]"
                    context="{'group_by': 'operating_unit_id'}"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </filter>
        </field>
    </record>

</odoo>
