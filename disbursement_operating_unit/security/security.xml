<?xml version="1.0" encoding="utf-8" ?>
<!-- No noupdate wrapper on purpose: disbursement_operating_unit_access_all
     rewrites these domains in place, so an upgrade has to be able to reset
     them before that overlay is re-applied. -->
<odoo>

    <record id="ir_rule_disbursement_request_allowed_operating_units" model="ir.rule">
        <field name="name">Disbursement request from allowed operating units</field>
        <field name="model_id" ref="disbursement.model_disbursement_request" />
        <field name="domain_force">
            ['|', ('operating_unit_id','=',False),
            ('operating_unit_id','in', user.operating_unit_ids.ids)]
        </field>
        <field name="global" eval="True" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record
        id="ir_rule_disbursement_request_line_allowed_operating_units"
        model="ir.rule"
    >
        <field
            name="name"
        >Disbursement request line from allowed operating units</field>
        <field name="model_id" ref="disbursement.model_disbursement_request_line" />
        <field name="domain_force">
            ['|', ('operating_unit_id','=',False),
            ('operating_unit_id','in', user.operating_unit_ids.ids)]
        </field>
        <field name="global" eval="True" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record
        id="ir_rule_disbursement_request_signature_allowed_operating_units"
        model="ir.rule"
    >
        <field
            name="name"
        >Disbursement request signature from allowed operating units</field>
        <field
            name="model_id"
            ref="disbursement.model_disbursement_request_signature"
        />
        <field name="domain_force">
            ['|', ('operating_unit_id','=',False),
            ('operating_unit_id','in', user.operating_unit_ids.ids)]
        </field>
        <field name="global" eval="True" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

</odoo>
