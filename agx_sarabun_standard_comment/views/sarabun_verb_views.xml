<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sarabun_verb_form" model="ir.ui.view">
        <field name="name">sarabun.verb.form.standard.comment</field>
        <field name="model">sarabun.verb</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_verb_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='พฤติกรรม (Behaviour)']" position="after">
                <group string="ข้อความมาตรฐาน (Standard comment)">
                    <field name="default_standard_comment_id"
                           options="{'no_create': True, 'no_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
