<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sarabun_step_act_wizard_form" model="ir.ui.view">
        <field name="name">sarabun.step.act.wizard.form.standard.comment</field>
        <field name="model">sarabun.step.act.wizard</field>
        <field name="inherit_id" ref="agx_sarabun.view_sarabun_step_act_wizard_form" />
        <field name="arch" type="xml">
            <!-- Shown wherever a comment box is: ตีกลับ reason or ความเห็นในการลงนาม. -->
            <xpath expr="//label[@for='note']" position="before">
                <field
                    name="standard_comment_id"
                    string="ข้อความมาตรฐาน"
                    placeholder="----- เลือกความเห็นมาตรฐาน -----"
                    widget="selection"
                    attrs="{'invisible': [('disposition', '=', 'complete'), ('step_allow_sign_comment', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
