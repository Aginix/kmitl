<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form_assignment" model="ir.ui.view">
        <field name="name">purchase.request.form.assignment</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <!-- The Assign to me / Assign… / Unassign buttons are injected
                 above the sheet by assignment.mixin's get_view (see
                 templates/assignment_templates.xml) — nothing in the header. -->
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="attrs" />
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_search_assignment" model="ir.ui.view">
        <field name="name">purchase.request.search.assignment</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <filter
                    name="unassigned"
                    string="Unassigned"
                    domain="[('assigned_to', '=', False)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
