<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Top-level "My Work" landing spot for procurement officers. Each action
         reuses the document's existing views, pinned to the current user via
         the shared "assigned_to_me" search filter. -->
    <menuitem
        id="menu_my_procurement_work_root"
        name="งานของฉัน"
        sequence="15"
        groups="purchase_request.group_purchase_request_user,purchase.group_purchase_user"
    />

    <record id="action_my_purchase_requests" model="ir.actions.act_window">
        <field name="name">ใบขอซื้อของฉัน</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_assigned_to_me': 1}</field>
    </record>
    <menuitem
        id="menu_my_purchase_requests"
        parent="menu_my_procurement_work_root"
        action="action_my_purchase_requests"
        sequence="10"
        groups="purchase_request.group_purchase_request_user"
    />

    <record id="action_my_purchase_approvals" model="ir.actions.act_window">
        <field name="name">การอนุมัติของฉัน</field>
        <field name="res_model">purchase.request.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_assigned_to_me': 1}</field>
    </record>
    <menuitem
        id="menu_my_purchase_approvals"
        parent="menu_my_procurement_work_root"
        action="action_my_purchase_approvals"
        sequence="20"
        groups="purchase_request.group_purchase_request_user"
    />

    <record id="action_my_purchase_orders" model="ir.actions.act_window">
        <field name="name">ใบสั่งซื้อของฉัน</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_assigned_to_me': 1}</field>
    </record>
    <menuitem
        id="menu_my_purchase_orders"
        parent="menu_my_procurement_work_root"
        action="action_my_purchase_orders"
        sequence="30"
        groups="purchase.group_purchase_user"
    />
</odoo>
