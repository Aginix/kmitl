<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='purchase_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="bill_from_purchase_order_settings">
                    <div class="o_setting_left_pane">
                        <field name="group_enable_create_bill"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_enable_create_bill"/>
                        <div class="text-muted">
                                    Enable the 'Create Bill' button in Purchase Orders
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
