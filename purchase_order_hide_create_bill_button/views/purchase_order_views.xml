<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_invoice'][1]" position="attributes">
                <attribute name="groups">purchase_order_hide_create_bill_button.group_enable_create_bill</attribute>
            </xpath>
            <xpath expr="//button[@name='action_create_invoice'][2]" position="attributes">
                <attribute name="groups">purchase_order_hide_create_bill_button.group_enable_create_bill</attribute>
            </xpath>
        </field>
    </record>
</odoo>
