<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="before">
                <group>
                    <group>
                        <field name="is_vat_editable" invisible="1" />
                        <field name="vat_included" attrs="{'readonly': [('is_vat_editable','=', False)]}" />
                        <field name="tax_id" widget="selection" attrs="{'invisible': [('vat_included', '=', 'exclusive')], 'required': [('vat_included', '=', 'inclusive')], 'readonly': [('is_editable','=', False)]}" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="price_subtotal" widget="monetary" invisible="1" />
                <field name="price_total" widget="monetary" invisible="1"/>
                <field name="price_tax" widget="monetary" optional="hide" />
            </xpath>
            <field name="product_uom_id" position="after">
                <field name="price_unit" />
            </field>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="replace">
                <group class="oe_subtotal_footer oe_right">
                    <field name="currency_id" invisible="1" />
                    <field name="estimated_cost" invisible="1" />
                    <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" colspan="2" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
