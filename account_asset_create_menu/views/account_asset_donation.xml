<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Donation Tree -->
    <record id="view_asset_batch_tree_donation" model="ir.ui.view">
        <field name="name">account.asset.batch.tree.donation</field>
        <field name="model">account.asset.batch</field>
        <!-- <field name="priority" eval="5"/> -->
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Document No."/>
                <field name="account_fiscal_year_id"/>
                <field name="received_from_agency" string="Received From"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    
    <record id="view_account_asset_batch_form_donation" model="ir.ui.view">
        <field name="name">account.asset.batch.form.donation</field>
        <field name="model">account.asset.batch</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <form string="Asset Registration - Donation">
                <header>
                    <button
                        name="action_register_assets"
                        type="object"
                        string="Register Asset"
                        states="draft"
                        class="btn-primary"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_asset_items"
                            string="Asset"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                            attrs="{'invisible': [('state', '!=', 'done')]}"
                        >
                            <field name="asset_count" widget="statinfo" string="Asset"/>
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Done"
                        bg_color="bg-success"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    />
                    <div class="oe_edit_only">
                        <label for="name" class="oe_inline"/>
                    </div>
                    <h1>
                        <field name="name" class="oe_inline" readonly="1"/>
                    </h1>
                    <group>
                        <field name="is_editable" invisible="1"/>
                        <field name="date" invisible="1"/>
                        <field name="purchase_id" invisible="1"/>
                        <field name="contract_number" invisible="1"/>
                        <field name="source_of_asset" readonly="1" force_save="1"/>
                        <field name="received_from_agency" required="1" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field name="account_fiscal_year_id" required="1" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field name="operating_unit_id" attrs="{'readonly': [('is_editable','=', False)]}" groups="operating_unit.group_multi_operating_unit"/>
                        <field name="department_id" attrs="{'readonly': [('is_editable','=', False)]}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="List">
                            <field name="line_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Dell Computer All in one Set"/>
                                    <field name="profile_id"/>
                                    <field name="gpsc_id"/>
                                    <field name="amount"/>
                                    <field name="price_per_unit"/>
                                    <field name="amount_total" readonly="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1"/>
                                <field
                                    class="fw-bold"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                    name="total_amount"
                                    readonly="1"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_asset_batch_donation" model="ir.actions.act_window">
        <field name="name">Donation</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset','=','donation')]</field>
        <field name="context">{'default_source_of_asset':'donation'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_asset_batch_tree_donation')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_asset_batch_form_donation')}),
        ]"/>
    </record>
</odoo>