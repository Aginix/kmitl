<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Procurement Tree -->
    <record id="view_asset_batch_tree_procurement" model="ir.ui.view">
        <field name="name">account.asset.batch.tree.procurement</field>
        <field name="model">account.asset.batch</field>
        <!-- <field name="priority" eval="10"/> -->
        <field name="arch" type="xml">
            <tree create="0">
                <field name="name" string="Document No."/>
                <field name="account_fiscal_year_id"/>
                <field name="contract_number" string="Contract Reference"/>
                <field name="purchase_id" string="PO Reference"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_asset_batch_procurement" model="ir.actions.act_window">
        <field name="name">Procurement</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset','=','procurement')]</field>
        <field name="context">{'default_source_of_asset':'procurement'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_asset_batch_tree_procurement')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account_asset_purchase.view_account_asset_batch_form')}),
        ]"/>
    </record>
</odoo>