<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- Procurement Tree -->
    <record id="view_asset_batch_tree_procurement" model="ir.ui.view">
        <field name="name">account.asset.batch.tree.procurement</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="name"/>
                <field name="account_fiscal_year_id"/>
                <field name="contract_number"/>
                <field name="purchase_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Donation Tree -->
    <record id="view_asset_batch_tree_donation" model="ir.ui.view">
        <field name="name">account.asset.batch.tree.donation</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="account_fiscal_year_id"/>
                <field name="received_from_agency"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Transfer Tree -->
    <record id="view_asset_batch_tree_transfer" model="ir.ui.view">
        <field name="name">account.asset.batch.tree.transfer</field>
        <field name="model">account.asset.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="account_fiscal_year_id"/>
                <field name="received_from_agency"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_asset_batch_procurement" model="ir.actions.act_window">
        <field name="name">Procurement</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset','=','procurement')]</field>
        <field name="context">{'default_source_of_asset':'procurement'}</field>
        <field name="views" eval="[
            (ref('view_asset_batch_tree_procurement'), 'tree'),
            (ref('view_account_asset_batch_form'), 'form')
        ]"/>
    </record>

    <record id="action_asset_batch_donation" model="ir.actions.act_window">
        <field name="name">Donation</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset','=','donation')]</field>
        <field name="context">{'default_source_of_asset':'donation'}</field>
        <field name="views" eval="[
            (ref('view_asset_batch_tree_donation'), 'tree'),
            (ref('view_account_asset_batch_form'), 'form')
        ]"/>
        
    </record>

    <record id="action_asset_batch_transfer" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="res_model">account.asset.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('source_of_asset','=','transfer')]</field>
        <field name="context">{'default_source_of_asset':'transfer'}</field>
        <field name="views" eval="[
            (ref('view_asset_batch_tree_transfer'), 'tree'),
            (ref('view_account_asset_batch_form'), 'form')
        ]"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_asset_registration_root"
            name="Create Asset"
            parent="account_asset_usability_kmitl.menu_assets_management"
            sequence="25"/>

    <menuitem id="menu_asset_procurement"
            name="Procurement"
            parent="menu_asset_registration_root"
            action="action_asset_batch_procurement"
            sequence="5"/>

    <menuitem id="menu_asset_donation"
            name="Donation"
            parent="menu_asset_registration_root"
            action="action_asset_batch_donation"
            sequence="15"/>

    <menuitem id="menu_asset_transfer"
            name="Transfer"
            parent="menu_asset_registration_root"
            action="action_asset_batch_transfer"
            sequence="25"/>

  </odoo>