<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category: post-bill payment-execution roles -->
        <record id="module_category_disbursement_payment" model="ir.module.category">
            <field name="name">Disbursement Payment</field>
            <field name="description">Roles for the post-bill payment-execution workflow (audit → authorize → pay → clear)</field>
            <field name="sequence">22</field>
        </record>

        <!-- Auditor (ผู้ตรวจสอบการเบิกจ่าย) — step 2.
             root/admin are members so the workflow is operable out of the box
             (same convention as group_disbursement_manager /
             group_finance_kmitl_manager). -->
        <record id="group_disbursement_payment_auditor" model="res.groups">
            <field name="name">Disbursement Auditor</field>
            <field name="category_id" ref="disbursement_finance_kmitl.module_category_disbursement_payment"/>
            <field name="implied_ids" eval="[(4, ref('disbursement.group_disbursement_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Authorizer / rector delegate (ผู้อนุมัติเบิกจ่าย) — step 3 -->
        <record id="group_disbursement_payment_authorizer" model="res.groups">
            <field name="name">Disbursement Authorizer</field>
            <field name="category_id" ref="disbursement_finance_kmitl.module_category_disbursement_payment"/>
            <field name="implied_ids" eval="[(4, ref('disbursement.group_disbursement_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Finance officer (เจ้าหน้าที่การเงินจ่าย) — steps 4-5 -->
        <record id="group_disbursement_payment_finance" model="res.groups">
            <field name="name">Disbursement Finance</field>
            <field name="category_id" ref="disbursement_finance_kmitl.module_category_disbursement_payment"/>
            <field name="implied_ids" eval="[(4, ref('finance_kmitl.group_finance_kmitl_user_out'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
