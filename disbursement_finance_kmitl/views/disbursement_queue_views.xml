<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- The three payment-execution lists are the same list of ใบขอเบิก seen by
         three facts (has payment lines, has no vouchers yet, is settled), so they
         share one tree and differ only in the domain of the action that opens
         them. The domains are about what exists, never about who touched the
         request before: where a request sits, and who is to act next, is the
         station's business (the station card is the desk's worklist). Each act's
         batch press sits in the tree's header, where core puts a press that acts
         on the ticked rows.

         This replaced an OWL screen. What a list gives back is everything the
         office already knows how to do — search, group, pivot, export, optional
         columns, a filter of their own saved on the view — none of which a
         hand-written table had. -->
    <record id="view_disbursement_request_queue_tree" model="ir.ui.view">
        <field name="name">disbursement.request.queue.tree</field>
        <field name="model">disbursement.request</field>
        <!-- ir.ui.view is ordered by (priority, name) and default_view() takes the
             first primary view: at equal priority this name would sort before
             "disbursement.request.tree" and silently become the default list of
             every action that does not pin a view_id. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree create="false" default_order="date desc, id desc">
                <!-- One press per act, each shown only to the office that takes
                     that step. They can share a header because the batch methods
                     filter by the act's flag themselves (_payment_batch), so a
                     press only ever acts on the rows it is offered on and reports
                     the rest back row by row. -->
                <header>
                    <button
                        name="action_audit_batch"
                        type="object"
                        string="Audit Selected"
                        class="btn-primary"
                        groups="disbursement_finance_kmitl.group_disbursement_payment_auditor"
                    />
                    <button
                        name="action_authorize_batch"
                        type="object"
                        string="Authorize Selected"
                        class="btn-primary"
                        groups="disbursement_finance_kmitl.group_disbursement_payment_authorizer"
                    />
                    <button
                        name="action_submit_payments_batch"
                        type="object"
                        string="Submit Selected"
                        class="btn-primary"
                        groups="accounting_kmitl.group_accounting_kmitl_user"
                    />
                </header>
                <field name="name" />
                <field name="date" />
                <field name="payee_display" />
                <field name="user_id" optional="show" />
                <!-- Shown so the auditor can see which requests are still missing
                     the เรื่องที่จ่าย that gives every payee its paying account —
                     auditing one without it is refused, and a batch would
                     otherwise fail row by row with no way to tell in advance. -->
                <field name="payment_subject_id" optional="show" />
                <field name="bill_count" optional="show" />
                <field name="amount_total" sum="Total" optional="hide" />
                <field name="amount_wht" sum="Withholding Tax" optional="hide" />
                <field name="amount_net" sum="Net Total" />
                <field name="department_analytic_id" optional="show" />
                <field name="source_analytic_id" optional="show" />
                <field name="account_fiscal_year_id" optional="hide" />
                <field name="payment_auditor_id" optional="hide" />
                <field name="payment_audit_date" optional="hide" />
                <field name="payment_status_display" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state in ('submitted', 'signed')"
                    decoration-primary="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"
                />
                <field name="settlement_stage" invisible="1" />
                <!-- The single-record press, beside the row it acts on, for the
                     request that is looked at rather than swept up in a batch. -->
                <button
                    name="action_audit"
                    type="object"
                    string="Audit"
                    icon="fa-check"
                    attrs="{'invisible': [('can_audit_payment', '=', False)]}"
                    groups="disbursement_finance_kmitl.group_disbursement_payment_auditor"
                />
                <button
                    name="action_authorize"
                    type="object"
                    string="Authorize"
                    icon="fa-check-circle"
                    confirm="Authorize this disbursement? The payment vouchers will be raised and numbered for every payee at once, ready to go to the bank."
                    attrs="{'invisible': [('can_authorize_payment', '=', False)]}"
                    groups="disbursement_finance_kmitl.group_disbursement_payment_authorizer"
                />
                <field name="can_audit_payment" invisible="1" />
                <field name="can_authorize_payment" invisible="1" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="action_dr_audit_queue" model="ir.actions.act_window">
        <field name="name">Requests with Payment Lines</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_disbursement_request_queue_tree" />
        <field
            name="search_view_id"
            ref="disbursement.view_disbursement_request_search"
        />
        <field name="domain">[('state', 'in', ('signed', 'in_progress', 'done')), ('payment_line_ids', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No disbursement request has payment lines yet.
            </p>
            <p>
                A request has payment lines once the accounting office has posted
                its bills: the payment subject and the audit are done on them.
            </p>
        </field>
    </record>

    <record id="action_dr_authorize_queue" model="ir.actions.act_window">
        <field name="name">Requests without Vouchers</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_disbursement_request_queue_tree" />
        <field
            name="search_view_id"
            ref="disbursement.view_disbursement_request_search"
        />
        <field name="domain">[('state', 'in', ('signed', 'in_progress')), ('payment_line_ids', '!=', False), ('payment_ids', '=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Every request with payment lines already has its vouchers.
            </p>
            <p>
                Requests with payment lines and no voucher yet: the authorization
                is what raises the payment vouchers.
            </p>
        </field>
    </record>

    <!-- The accounting office's end of the Hand-over: requests the finance office
         has paid, whose vouchers are waiting in draft to be booked. Lives in the
         Accounting app because the work is theirs, and the voucher-level list
         (Accounting ▸ ใบจ่ายรอบันทึกบัญชี) catches the payments made by hand, which
         have no request to navigate by. -->
    <record id="action_dr_book_queue" model="ir.actions.act_window">
        <field name="name">Book Disbursement Payments</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_disbursement_request_queue_tree" />
        <field
            name="search_view_id"
            ref="disbursement.view_disbursement_request_search"
        />
        <field name="domain">[('settlement_stage', '=', 'settled')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No disbursement request is waiting to be booked.
            </p>
            <p>
                Requests the finance office has paid in full, waiting for the
                accounting maker to submit their payment vouchers.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_dr_book_queue"
        name="Book Disbursement Payments"
        parent="accounting_kmitl.menu_accounting_root"
        action="action_dr_book_queue"
        sequence="23"
        groups="accounting_kmitl.group_accounting_kmitl_user"
    />

    <!-- The payment execution is the treasury office's, so both its screens
         live in the Finance app. The audit is a clerk's step in the paying run,
         so it sits with the rest of that run under Payment Out; the
         authorisation is an approver's, so it gets its own heading. The
         approval of the *request* (ผอ.กองคลัง, the rector's delegate) stays in
         the Disbursement app — see finance_kmitl/docs/adr/0005. -->

    <!-- Neither round-2 group implies a finance-office group: an auditor holds no
         rights on a payment voucher and an authorizer holds none on the books, and
         neither should gain any by being given a screen. But the Finance app and
         its Payment Out branch are gated on those finance groups, so without this
         the two would be shown a door inside a room they cannot enter. The groups
         are added rather than set (4, not 6) so the finance groups survive; note
         that finance_kmitl's own menuitem sets the whole list, so upgrading it
         alone drops these two until this module is upgraded too. -->
    <record id="finance_kmitl.menu_payment_root" model="ir.ui.menu">
        <field
            name="groups_id"
            eval="[(4, ref('disbursement_finance_kmitl.group_disbursement_payment_auditor')), (4, ref('disbursement_finance_kmitl.group_disbursement_payment_authorizer'))]"
        />
    </record>
    <record id="finance_kmitl.menu_finance_payment_out" model="ir.ui.menu">
        <field
            name="groups_id"
            eval="[(4, ref('disbursement_finance_kmitl.group_disbursement_payment_auditor'))]"
        />
    </record>

    <menuitem
        id="menu_dr_audit_queue"
        name="Requests with Payment Lines"
        parent="finance_kmitl.menu_finance_payment_out"
        action="action_dr_audit_queue"
        sequence="20"
        groups="disbursement_finance_kmitl.group_disbursement_payment_auditor"
    />

    <menuitem
        id="menu_finance_approver"
        name="Approver"
        parent="finance_kmitl.menu_payment_root"
        sequence="30"
        groups="disbursement_finance_kmitl.group_disbursement_payment_authorizer"
    />

    <menuitem
        id="menu_dr_authorize_queue"
        name="Requests without Vouchers"
        parent="menu_finance_approver"
        action="action_dr_authorize_queue"
        sequence="10"
        groups="disbursement_finance_kmitl.group_disbursement_payment_authorizer"
    />

</odoo>
