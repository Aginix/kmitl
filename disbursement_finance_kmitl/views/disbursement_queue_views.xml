<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- The payment-phase worklists are the same list of ใบขอเบิก stopped at
         different work stations, so they share one tree and differ only in the
         action that opens them. Each station (disbursement_wst_payment_*) derives
         its own primary view from this one to add the press that is its own, and
         owns its action and menu: this bridge names no station.

         This replaced an OWL screen. What a list gives back is everything the
         office already knows how to do — search, group, pivot, export, optional
         columns, a filter of their own saved on the view — none of which a
         hand-written table had. -->
    <record id="view_disbursement_request_queue_tree" model="ir.ui.view">
        <field name="name">disbursement.request.queue.tree</field>
        <field name="model">disbursement.request</field>
        <!-- ir.ui.view is ordered by (priority, name) and default_view() takes the
             first primary view: at equal priority this name would sort before
             "disbursement.request.tree" and silently become the default list of
             every action that does not pin a view_id. Same guard as
             disbursement.view_disbursement_request_approved_tree. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree create="false" default_order="date desc, id desc">
                <field name="name" />
                <field name="date" />
                <field name="partner_id" />
                <field name="user_id" optional="show" />
                <!-- Shown so the auditor can see which requests are still missing
                     the เรื่องที่จ่าย that gives every payee its paying account —
                     auditing one without it is refused, and a batch would
                     otherwise fail row by row with no way to tell in advance. -->
                <field name="payment_subject_id" optional="show" />
                <field name="bill_count" optional="show" />
                <field name="amount_total" sum="Total" optional="hide" />
                <field name="amount_wht" sum="Withholding Tax" optional="hide" />
                <field name="amount_net" sum="Net Total" />
                <field name="department_analytic_id" optional="show" />
                <field name="source_analytic_id" optional="show" />
                <field name="account_fiscal_year_id" optional="hide" />
                <field name="payment_status_display" optional="hide" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>
</odoo>
