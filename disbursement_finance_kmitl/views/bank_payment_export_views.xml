<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- The trail from an e-payment file back to the ใบขอเบิก it pays. The same
         trail already exists from a voucher and from its journal entry, but not
         from the file — so an officer holding one had to open its rows one at a
         time to find out what the money was for. -->
    <record id="bank_payment_export_view_form_inherit_disbursement" model="ir.ui.view">
        <field name="name">bank.payment.export.form.disbursement_finance_kmitl</field>
        <field name="model">bank.payment.export</field>
        <field
            name="inherit_id"
            ref="finance_kmitl.bank_payment_export_view_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disbursement_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Disbursement Requests <field
                                name="disbursement_request_count"
                                nolabel="1"
                            /></span>
                        <!-- Named only when there is one to name. With several the
                             field is empty and the line simply collapses, which is
                             the honest answer — no attrs needed to say it. -->
                        <span class="o_stat_text text-muted small"><field
                                name="disbursement_request_name"
                                nolabel="1"
                            /></span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- And per row, because the header can only name one request and a file
         routinely carries several: this is what says which payee came from which
         ใบขอเบิก. Kept beside the sending-account columns, which answer the other
         half of "where did this row come from". -->
    <record
        id="bank_payment_export_line_view_tree_inherit_disbursement"
        model="ir.ui.view"
    >
        <field
            name="name"
        >bank.payment.export.line.tree.disbursement_finance_kmitl</field>
        <field name="model">bank.payment.export.line</field>
        <field
            name="inherit_id"
            ref="finance_kmitl.bank_payment_export_line_view_tree_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_amount']" position="before">
                <field name="disbursement_request_id" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
