<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- DR action for finance queue (requests authorized and awaiting payment) -->
    <record id="action_disbursement_request_finance" model="ir.actions.act_window">
        <field name="name">Disbursement Requests</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_payment_authorized": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ไม่มีใบขอเบิกที่รอทำการจ่ายเงิน
            </p>
            <p>
                ใบขอเบิกที่ได้รับอนุมัติเบิกจ่ายแล้ว รอเจ้าหน้าที่การเงินสร้างใบจ่าย/ส่งธนาคาร
            </p>
        </field>
    </record>

    <!-- DR menu in the Finance app (DR is the navigation document) -->
    <menuitem
        id="menu_finance_disbursement_request"
        name="Disbursement Requests"
        parent="finance_kmitl.menu_payment_root"
        action="action_disbursement_request_finance"
        sequence="5"
    />

    <!-- Tree: colour the badge for the new payment-execution states -->
    <record id="view_disbursement_request_tree_inherit_finance" model="ir.ui.view">
        <field name="name">disbursement.request.tree.inherit.finance_kmitl</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_status']" position="attributes">
                <attribute name="decoration-warning">display_status in ('submitted', 'signed', 'bill_draft', 'payment_draft', 'bills_posted', 'payment_audited')</attribute>
                <attribute name="decoration-primary">display_status in ('verified', 'bill_posted', 'payment_authorized')</attribute>
                <attribute name="decoration-success">display_status in ('approved', 'payment_posted', 'done', 'paid', 'cleared')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search: add filters for the post-bill payment-execution states -->
    <record id="view_disbursement_request_search_inherit_finance" model="ir.ui.view">
        <field name="name">disbursement.request.search.inherit.finance_kmitl</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='done']" position="after">
                <filter string="Payment Audited" name="payment_audited"
                        domain="[('state', '=', 'payment_audited')]"/>
                <filter string="Authorized (to pay)" name="payment_authorized"
                        domain="[('state', '=', 'payment_authorized')]"/>
                <filter string="Paid" name="paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter string="Cleared" name="cleared"
                        domain="[('state', '=', 'cleared')]"/>
            </xpath>
        </field>
    </record>

    <!-- Form view: statusbar + payment-execution buttons + smart buttons -->
    <record id="view_disbursement_request_form_inherit_finance" model="ir.ui.view">
        <field name="name">disbursement.request.form.inherit.finance_kmitl</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <!-- Extend the status bar with the post-bill payment states -->
            <xpath expr="//field[@name='display_status']" position="attributes">
                <attribute name="statusbar_visible">draft,submitted,signed,verified,approved,bills_posted,payment_audited,payment_authorized,paid,cleared</attribute>
            </xpath>

            <!-- Payment-execution buttons, placed before Reset to draft -->
            <xpath expr="//button[@name='action_draft']" position="before">
                <button name="action_audit"
                        string="ตรวจสอบการเบิกจ่าย"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'bills_posted')]}"
                        groups="disbursement_finance_kmitl.group_disbursement_payment_auditor"/>
                <button name="action_authorize"
                        string="อนุมัติเบิกจ่าย"
                        type="object"
                        class="oe_highlight"
                        confirm="ยืนยันอนุมัติให้เบิกจ่ายเงินตามใบขอเบิกนี้?"
                        attrs="{'invisible': [('state', '!=', 'payment_audited')]}"
                        groups="disbursement_finance_kmitl.group_disbursement_payment_authorizer"/>
                <button name="action_create_payment"
                        string="Create Payment"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '!=', 'payment_authorized'), ('payment_count', '>', 0)]}"
                        groups="disbursement_finance_kmitl.group_disbursement_payment_finance"/>
                <button name="action_confirm_paid"
                        string="ยืนยันจ่ายสำเร็จ"
                        type="object"
                        class="oe_highlight"
                        confirm="ยืนยันว่าธนาคารจ่ายเงินสำเร็จครบทุกรายการแล้ว?"
                        attrs="{'invisible': ['|', ('state', '!=', 'payment_authorized'), ('payment_count', '=', 0)]}"
                        groups="disbursement_finance_kmitl.group_disbursement_payment_finance"/>
            </xpath>

            <!-- Payment classification: subject chosen by the auditor.
                 Editable until the audit is confirmed. -->
            <xpath expr="//group[@name='disbursement_information']" position="inside">
                <field name="payment_subject_id"
                       options="{'no_create': True}"
                       attrs="{'readonly': [('state', 'not in', ('draft', 'submitted', 'signed', 'verified', 'approved', 'bills_posted'))], 'required': [('state', '=', 'bills_posted')]}"
                       force_save="1"/>
            </xpath>

            <!-- Payment page: per-line method / payee bank, editable by the
                 auditor at bills_posted (base line_ids is readonly then). -->
            <xpath expr="//page[@name='wht']" position="after">
                <page string="การจ่ายเงิน" name="payment_classification"
                      attrs="{'invisible': [('state', 'not in', ('bills_posted', 'payment_audited', 'payment_authorized', 'paid', 'cleared'))]}">
                    <field name="payment_line_ids" nolabel="1"
                           attrs="{'readonly': [('state', '!=', 'bills_posted')]}">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="partner_id" readonly="1" string="Payee"/>
                            <field name="partner_bank_id"
                                   domain="[('partner_id', '=', partner_id)]"/>
                            <field name="payment_method"/>
                            <field name="price_total" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- Payment smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        attrs="{'invisible': [('payment_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">รายการจ่ายเงิน <field name="payment_count" nolabel="1" /></span>
                        <span class="o_stat_text text-muted small"><field name="payment_status_display" nolabel="1" /></span>
                    </div>
                </button>
                <button name="action_view_payment_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        attrs="{'invisible': [('payment_move_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">รายการล้างหนี้ <field name="payment_move_count" nolabel="1" /></span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
