<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sarabun_reset_wizard_form" model="ir.ui.view">
        <field name="name">sarabun.reset.wizard.form</field>
        <field name="model">sarabun.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="รีเซ็ต (Reset to Draft)">
                <field name="document_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    รีเซ็ตเอกสารกลับเป็นร่าง โดยคงเลขหนังสือและเส้นทางเดิม
                    (การลงนามเดิมจะถูกเก็บเป็นประวัติ) — Admin override (ADR-0011).
                </div>
                <group>
                    <field name="reason" placeholder="ระบุเหตุผล / reason..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="ยืนยัน (Confirm)"
                            class="btn-primary"/>
                    <button string="ยกเลิก (Cancel)" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
