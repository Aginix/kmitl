<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='logs']" position="before">
              <page name="document" string="Attachment">
                    <field name="attachment_ids" 
                          attrs="{'readonly': [('is_editable','=', False)]}" 
                          context="{'default_res_model': 'purchase.request'}">
                        <tree default_order="attachment_type, sequence">
                            <field name="sequence" widget="handle"/>
                            <field name="attachment_type" required="1"/>
                            <field name="name" string="File Name" required="1"/>
                            <field name="description"/>
                        </tree>
                        <form>
                            <sheet>
                                <group>
                                    <field name="res_model" invisible="1" readonly="0"/>
                                    <field name="res_id" invisible="1" readonly="0"/>
                                    <field name="attachment_type" required="1"/>
                                    <field name="name" placeholder="File Name (auto-filled from upload)" required="1" invisible="1"/>
                                    <field name="datas" filename="name" required="1"/>
                                    <field name="description" placeholder="Description"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

  </odoo>