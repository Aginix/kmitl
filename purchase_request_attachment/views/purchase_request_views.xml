<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='logs']" position="before">
              <page name="document" string="Attachment">
                  <field name="attachment_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                      <tree editable="bottom">
                          <field name="attachment_type" required="1"/>
                          <field name="file_name"/>
                          <field name="upload_file" filename="file_name" required="1"/>
                          <field name="description"/>
                      </tree>
                  </field>
                </page>
            </xpath>
        </field>
    </record>

  </odoo>