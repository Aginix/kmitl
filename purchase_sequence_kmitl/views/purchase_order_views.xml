<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The PO number embeds the ปีงบประมาณ (%(year_be)s of the fiscal year's
         date_to) and is minted in create(), so the fiscal year can only be
         picked while the record is still new. Once saved it is frozen — see
         the write() guard in models/purchase_order.py. -->
    <record id="view_purchase_order_form_fiscal_year" model="ir.ui.view">
        <field name="name">purchase.order.form (fiscal year editable on create)</field>
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_order_kmitl.view_purchase_order_form_invoice_plan"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='information_section']//field[@name='account_fiscal_year_id']"
                position="attributes"
            >
                <attribute name="readonly" />
                <attribute name="required">1</attribute>
                <attribute name="attrs">{'readonly': [('id', '!=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
