<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_approver_director)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <button name="action_draft" position="before">
                <button
                    name="action_approve_finance"
                    string="Endorse (Finance Director)"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('can_approve_director', '=', False)]}"
                    groups="disbursement.group_disbursement_finance_director"
                />
                <field name="can_approve_director" invisible="1" />
            </button>
            <group id="other_information" position="inside">
                <field
                    name="finance_approver_id"
                    attrs="{'invisible': [('finance_approver_id', '=', False)]}"
                />
                <field
                    name="finance_approve_date"
                    attrs="{'invisible': [('finance_approver_id', '=', False)]}"
                />
            </group>
        </field>
    </record>
</odoo>
