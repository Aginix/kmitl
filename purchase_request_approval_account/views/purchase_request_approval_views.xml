<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">view.form(Approval Account Move Request)</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_to_approve']" position="after">
                <field name="use_purchase_order" invisible="1" />
                <field name="purchase_count" invisible="1" />
                <button
                    name="approval_make_purchase_order"
                    string="Create Purchase Order"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', '|', ('use_purchase_order', '=', False), ('purchase_count', '&gt;', 0), ('state', 'not in', ['approved'])]}"
                />
                <button
                    name="action_move_request"
                    string="Create Bill"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', '|', ('use_purchase_order', '=', True), ('move_request_count', '&gt;', 0), ('state', 'not in', ['approved'])]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_purchase_order"
                    type="object"
                    icon="fa-book"
                    class="oe_highlight"
                    attrs="{'invisible': [('purchase_count', '=', 0)]}"
                >
                    <field
                        name="purchase_count"
                        widget="statinfo"
                        string="Purchase Orders"
                    />
                </button>
                <button
                    name="action_view_move_request"
                    type="object"
                    icon="fa-exchange"
                    class="oe_highlight"
                    attrs="{'invisible': [('move_request_count', '=', 0)]}"
                >
                    <field
                        name="move_request_count"
                        widget="statinfo"
                        string="Account Move Request"
                    />
                </button>
            </xpath>
            <xpath expr="//div" position="after">
                <group>
                    <group>
                        <field
                            name="use_purchase_order"
                            attrs="{'readonly': [('state', 'not in', ['draft'])]}"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_approval_tree" model="ir.ui.view">
        <field name="name">view.tree(Approval Account Move Request)</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requested_by']" position="before">
                <field name="billing_status"/>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="after">
                <field name="display_purchase_order"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_approval_search" model="ir.ui.view">
        <field name="name">view.search(Approval Account Move Request)</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="billing_status" string="Bill Status" />
            </xpath>
        </field>
    </record>
</odoo>
