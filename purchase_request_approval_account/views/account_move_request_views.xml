<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_request_form" model="ir.ui.view">
        <field name="name">view.account.move.request.form</field>
        <field name="model">account.move.request</field>
        <field
            name="inherit_id"
            ref="account_move_request.view_account_move_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="purchase_request_approval_id" invisible="1" />
                <button
                    name="action_view_purchase_approval"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-contract"
                    string="PA"
                    attrs="{'invisible': [('purchase_request_approval_id', '=', False)]}"
                ></button>
            </xpath>
        </field>
    </record>
</odoo>
