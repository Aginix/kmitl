<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form (Vendor KMITL)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='warning_prepaid']" position="before">
                <group>
                    <group>
                        <field name="is_required_partner_id" invisible="1" />
                        <field name="partner_id" attrs="{'invisible': [('is_required_partner_id', '!=', True)], 'required': [('is_required_partner_id', '=', True)], 'readonly': [('is_editable','=', False)]}" options="{'no_create_edit': True, 'no_open': True, 'no_create': True}" />
                        <div attrs="{'invisible': [('is_required_partner_id', '!=', True)]}" colspan="2" class="alert alert-warning show" role="alert">If vendor name not found, contact procurement staff to add the information</div>
                    </group>
                </group>

            </xpath>
        </field>
    </record>

</odoo>
