<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_master_summary_print_wizard_form" model="ir.ui.view">
        <field name="name">budget.appropriation.master.summary.print.wizard.form</field>
        <field name="model">budget.appropriation.master.summary.print.wizard</field>
        <field name="arch" type="xml">
            <form string="พิมพ์แยกหน่วยงาน">
                <group>
                    <field name="master_summary_id" invisible="1" />
                    <field name="select_all" widget="boolean_toggle" />
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="include" widget="boolean_toggle" />
                        <field name="compilation_id" invisible="1" />
                        <field name="department_analytic_id" readonly="1" />
                        <field name="code_page" />
                    </tree>
                </field>
                <footer>
                    <button
                        name="action_print"
                        string="พิมพ์"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
