<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Partial template for F3-W-วง-003 และ F6-W-วง-003 content (reusable) -->
    <template id="report_f3w_f6w_revenue_content">
        <style>
            .f3w_f6w .table-bordered td {
                border-color: #000 !important;
            }
            .f3w_f6w .table {
                border-color: #000 !important;
            }
            p,
            span,
            div,
            strong {
                font-size: 14pt;
                line-height: 1.4;
            }
            .page:not(.landscape) {
                padding: 6mm 6mm !important;
            }
        </style>
        <div class="page f3w_f6w" t-att-contenteditable="'true' if o.env.context.get('html_preview', False) else None">
            <t t-call="budget_appropriation_summary.report_print_button"/>
            <t t-call="budget_appropriation_summary.report_page_label">
                <t t-set="page_label" t-value="'F3-W-วง-003 และ F6-W-วง-003'"/>
            </t>
            <t t-call="budget_appropriation_summary.report_council_header"/>
            <div class="text-center fw-bold">
                <h3>
                    สรุปเปรียบเทียบประมาณการรายรับ - รายจ่าย
                </h3>
                <h3>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</h3>
                <h3>จําแนกตามหน่วยงาน ปีงบประมาณ พ.ศ.                    <t t-out="o.compare_summary_id.account_fiscal_year_id.name"/>
 และ                    <t t-out="o.account_fiscal_year_id.name"/>
                </h3>
            </div>
            <div style="height: 24pt;"/>
            <div>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr style="height:0; visibility:collapse; line-height:0;">
                          <td style="width: auto;"/>
                          <td style="width: 74pt;"/>
                          <td style="width: 32pt;"/>
                          <td style="width: 74pt;"/>
                          <td style="width: 32pt;"/>
                          <td style="width: 74pt;"/>
                          <td style="width: 32pt;"/>
                        </tr>
                        <tr>
                            <th class="text-center" rowspan="2">หน่วยงาน</th>
                            <th class="text-center" colspan="2">
                              ปีงบประมาณ <t t-out="o.compare_summary_id.account_fiscal_year_id.name"/>
                            </th>
                            <th class="text-center" colspan="2">
                              ปีงบประมาณ <t t-out="o.account_fiscal_year_id.name"/>
                            </th>
                            <th class="text-center" colspan="2">+ เพิ่ม - ลด</th>
                        </tr>
                        <tr>
                            <th class="text-center">เงินรายได้</th>
                            <th class="text-center">%</th>
                            <th class="text-center">เงินรายได้</th>
                            <th class="text-center">%</th>
                            <th class="text-center">เงินรายได้</th>
                            <th class="text-center">%</th>
                        </tr>
                    </thead>
                    <tbody class="category">
                        <t t-foreach="o.f4w_revenue_data['departments']" t-as="row">
                            <tr class="border-0 fw-bold">
                                <td class="border-0 border-start">
                                    <t t-out="row['name']"/>
                                </td>
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.0f}'.format(row['compare_amount'])"/>
                                </td>
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.2f}'.format(row['compare_percentage'])"/>
                                </td>
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.0f}'.format(row['amount'])"/>
                                </td>
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.2f}'.format(row['percentage'])"/>
                                </td>
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.0f}'.format(row['diff_amount'])"/>
                                </td>
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.2f}'.format(row['diff_percentage'])"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td class="text-center">
                                รวมทั้งสิ้น
                            </td>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.0f}'.format(o.f4w_revenue_data['summary']['compare_total_amount'])"/>
                            </td>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.2f}'.format(100)"/>
                            </td>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.0f}'.format(o.f4w_revenue_data['summary']['total_amount'])"/>
                            </td>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.2f}'.format(100)"/>
                            </td>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.0f}'.format(o.f4w_revenue_data['summary']['diff_amount'])"/>
                            </td>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.2f}'.format(o.f4w_revenue_data['summary']['diff_percentage'])"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </template>

    <!-- Main F3-W-วง-003 และ F6-W-วง-003 report template -->
    <template id="report_f3w_f6w_revenue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang='th_TH')" />
                    <t t-call="budget_appropriation_summary.report_common_styles" />
                    <t t-call="budget_appropriation_summary.report_preview_styles" />
                    <t t-call="budget_appropriation_summary.report_f3w_f6w_revenue_content" />
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_f3w_f6w_revenue" model="ir.actions.report">
        <field name="name">F3-W-วง-003 และ F6-W-วง-003 - สรุปเปรียบเทียบรายรับ-รายจ่าย</field>
        <field name="model">budget.appropriation.master.summary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_summary.report_f3w_f6w_revenue</field>
        <field name="report_file">budget_appropriation_summary.report_f3w_f6w_revenue</field>
        <field name="paperformat_id" ref="paperformat_portrait" />
    </record>
</odoo>
