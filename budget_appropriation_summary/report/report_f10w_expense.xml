<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Partial template for F10-W content (reusable) -->
    <template id="report_f10w_expense_content">
        <style>
            .f10w .level-0 td:first-child {
                font-weight: bold;
            }
            .f10w .level-0 td:first-child {
                text-decoration: underline;
            }
            .f10w .level-1 td:first-child {
                padding-left: 8pt;
                font-weight: bold;
            }
            .f10w .level-1 td:first-child {
                text-decoration: underline;
            }
            .f10w .level-2 td:first-child {
                padding-left: 12pt;
            }
            .f10w .level-3 td:first-child {
                padding-left: 16pt;
            }
            .table {
                border-color: #000 !important;
            }
            .table &gt; :not(:first-child) {
                border-top: 0;
            }
            .table tbody td, .table tbody tr {
                border-top: 0;
                border-bottom: 0;
            }
            .table tbody .summary-row {
                border-top: 1px solid black !important;
                border-bottom: 1px solid black !important;
            }
            .table tfoot .page-bottom-line td {
                border-top: 1pt solid #000 !important;
                padding: 0;
                height: 0;
                line-height: 0;
                font-size: 0;
            }
            p,
            span,
            div {
                font-size: 14pt;
                line-height: 1.1;
            }
            @media print {
                @page {
                    size: A4 landscape;
                    padding: 6mm 0mm !important;
                }
            }
        </style>
        <div class="page f10w landscape" t-att-contenteditable="'true' if o.env.context.get('html_preview', False) else None">
            <t t-call="budget_appropriation_summary.report_print_button"/>
            <t t-call="budget_appropriation_summary.report_page_label">
                <t t-set="page_label" t-value="'F10-W-วง-003'"/>
            </t>
            <t t-call="budget_appropriation_summary.report_council_header"/>
            <div class="text-center" style="font-weight: bold">
                <h3>
                    สรุปประมาณการรายจ่าย ปีงบประมาณ พ.ศ. <t t-out="o.account_fiscal_year_id.name"/>
                </h3>
                <h3>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</h3>
                <h3>จําแนกตามแผนงานและงบรายจ่าย</h3>
            </div>
            <div style="height: 24pt;"/>
            <div>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 33%;">แผนงาน/กิจกรรม</th>
                            <t t-foreach="o.f10w_expense_data['columns']" t-as="column">
                                <th class="text-center"><t t-out="column['name']"/></th>
                            </t>
                            <th class="text-center">รวมทุกงบรายจ่าย</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.f10w_expense_data['rows']" t-as="row">
                            <tr t-attf-class="level-#{row['level']}">
                                <td t-esc="row['name']"/>
                                <t t-foreach="o.f10w_expense_data['columns']" t-as="column">
                                    <td class="text-end" contenteditable="false">
                                        <t t-out="'{0:,.0f}'.format(row['columns'][column['code']])"/>
                                    </td>
                                </t>
                                <td class="text-end fw-bold" contenteditable="false">
                                    <t t-if="row['level'] in [0, 1]">
                                        <t t-out="'{0:,.0f}'.format(row['total'])"/>
                                    </t>
                                    <t t-else="">
                                        <t t-out="'{0:,.0f}'.format(row['total'])"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <tr class="summary-row" style="font-weight: bold;">
                            <td class="text-center">
                                รวมทั้งสิ้น
                            </td>
                            <t t-foreach="o.f10w_expense_data['columns']" t-as="column">
                                <td class="text-end" contenteditable="false">
                                    <t t-out="'{0:,.0f}'.format(o.f10w_expense_data['column_totals'][column['code']])"/>
                                </td>
                            </t>
                            <td class="text-end" contenteditable="false">
                                <t t-out="'{0:,.0f}'.format(o.f10w_expense_data['summary']['total_amount'])"/>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="page-bottom-line">
                            <td t-att-colspan="2 + len(o.f10w_expense_data['columns'])">&#160;</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </template>

    <!-- Main F10-W report template -->
    <template id="report_f10w_expense">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang='th_TH')" />
                    <t t-call="budget_appropriation_summary.report_common_styles" />
                    <t t-set="is_landscape" t-value="True" />
                    <t t-call="budget_appropriation_summary.report_preview_styles" />
                    <t t-call="budget_appropriation_summary.report_f10w_expense_content" />
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_f10w_expense" model="ir.actions.report">
        <field name="name">F10-W - สรุปประมาณการรายจ่าย (แผนงาน)</field>
        <field name="model">budget.appropriation.master.summary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_summary.report_f10w_expense</field>
        <field name="report_file">budget_appropriation_summary.report_f10w_expense</field>
        <field name="paperformat_id" ref="paperformat_landscape" />
    </record>
</odoo>
