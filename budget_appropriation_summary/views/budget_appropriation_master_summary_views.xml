<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Form View -->
    <record id="view_budget_appropriation_master_summary_form" model="ir.ui.view">
        <field name="name">budget.appropriation.master.summary.form</field>
        <field name="model">budget.appropriation.master.summary</field>
        <field name="arch" type="xml">
            <form string="สรุปภาพรวมสถาบัน">
                <header>
                    <button
                        name="action_confirm"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_done"
                        string="เสร็จสิ้น"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'confirmed')]}"
                    />
                    <button
                        name="action_draft"
                        string="กลับไปร่าง"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field
                                name="account_fiscal_year_id"
                                widget="selection"
                                required="1"
                            />
                            <field
                                name="source_analytic_id"
                                widget="radio"
                                required="1"
                            />
                        </group>
                        <group>
                            <field name="amount_revenue_total" />
                            <field name="amount_expense_total" />
                        </group>
                    </group>
                    <notebook>
                        <page string="รวมเล่มหน่วยงาน" name="compilations">
                            <field
                                name="compilation_ids"
                                domain="[
                                    ('account_fiscal_year_id', '=', account_fiscal_year_id),
                                    ('source_analytic_id', '=', source_analytic_id),
                                ]"
                                context="{
                                    'default_account_fiscal_year_id': account_fiscal_year_id,
                                    'default_source_analytic_id': source_analytic_id,
                                }"
                                widget="many2many"
                            >
                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="department_analytic_id" />
                                    <field
                                        name="amount_revenue_total"
                                        sum="รวมรายรับ"
                                    />
                                    <field
                                        name="amount_expense_total"
                                        sum="รวมรายจ่าย"
                                    />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>
                        <page string="หมายเหตุ" name="note">
                            <field name="note" placeholder="หมายเหตุ..." />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_budget_appropriation_master_summary_tree" model="ir.ui.view">
        <field name="name">budget.appropriation.master.summary.tree</field>
        <field name="model">budget.appropriation.master.summary</field>
        <field name="arch" type="xml">
            <tree string="สรุปภาพรวมสถาบัน">
                <field name="name" />
                <field name="source_analytic_id" />
                <field name="account_fiscal_year_id" />
                <field name="amount_revenue_total" sum="รวมรายรับ" />
                <field name="amount_expense_total" sum="รวมรายจ่าย" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_budget_appropriation_master_summary_search" model="ir.ui.view">
        <field name="name">budget.appropriation.master.summary.search</field>
        <field name="model">budget.appropriation.master.summary</field>
        <field name="arch" type="xml">
            <search string="ค้นหาสรุปภาพรวมสถาบัน">
                <field name="name" />
                <field name="account_fiscal_year_id" />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Confirmed"
                    name="confirmed"
                    domain="[('state', '=', 'confirmed')]"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <group expand="0" string="Group By">
                    <filter
                        string="ปีงบประมาณ"
                        name="group_by_fiscal_year"
                        context="{'group_by': 'account_fiscal_year_id'}"
                    />
                    <filter
                        string="สถานะ"
                        name="group_by_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record
        id="action_budget_appropriation_master_summary"
        model="ir.actions.act_window"
    >
        <field name="name">สรุปภาพรวมสถาบัน</field>
        <field name="res_model">budget.appropriation.master.summary</field>
        <field name="view_mode">tree,form</field>
        <field
            name="search_view_id"
            ref="view_budget_appropriation_master_summary_search"
        />
    </record>

</odoo>
