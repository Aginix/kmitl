<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Form View -->
    <record id="view_budget_appropriation_compilation_form" model="ir.ui.view">
        <field name="name">budget.appropriation.compilation.form</field>
        <field name="model">budget.appropriation.compilation</field>
        <field name="arch" type="xml">
            <form string="รวมเล่มหน่วยงาน">
                <header>
                    <button
                        name="action_confirm"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_done"
                        string="เสร็จสิ้น"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'confirmed')]}"
                    />
                    <button
                        name="action_draft"
                        string="กลับไปร่าง"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_f4_report"
                            string="ดูรายงาน F4"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            attrs="{'invisible': [('revenue_appropriation_ids', '=', [])]}"
                        />
                        <button
                            name="action_print_f4_report"
                            string="พิมพ์ F4"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-print"
                            attrs="{'invisible': [('revenue_appropriation_ids', '=', [])]}"
                        />
                        <button
                            name="action_open_f5_report"
                            string="รายงาน F5"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            attrs="{'invisible': [('expense_appropriation_ids', '=', [])]}"
                        />
                        <button
                            name="action_open_f23w_report"
                            string="รายงาน F23"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            attrs="{'invisible': [('use_f23', '=', False)]}"
                        />
                        <!-- <button
                            name="action_print_f23w_report"
                            string="พิมพ์ F23"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-print"
                            attrs="{'invisible': [('use_f23', '=', False)]}"
                        /> -->
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field
                                name="account_fiscal_year_id"
                                widget="selection"
                                required="1"
                            />
                            <field
                                name="source_analytic_id"
                                widget="radio"
                                required="1"
                            />
                            <field name="department_analytic_id" required="1" />
                            <field name="user_id" readonly="1" />
                            <field name="use_f23" />
                            <field name="code_page" />
                        </group>
                        <group>
                            <field name="master_summary_id" />
                            <field name="amount_revenue_total" />
                            <field name="amount_expense_total" />

                        </group>
                    </group>
                    <notebook>
                        <page string="ประมาณการรายรับ" name="revenue_appropriations">
                            <field
                                name="revenue_appropriation_ids"
                                domain="[
                                    ('account_fiscal_year_id', '=', account_fiscal_year_id),
                                    ('budget_type', '=', 'revenue'),
                                    ('state', '!=', 'cancel'),
                                    '|',
                                        ('source_analytic_id', '=', source_analytic_id),
                                        ('source_analytic_id', '=', False),
                                    '|',
                                        ('department_analytic_id', '=', department_analytic_id),
                                        ('department_analytic_id.parent_path', 'like', str(department_analytic_id) + '/%'),
                                ]"
                                attrs="{'readonly': ['|', '|', ('account_fiscal_year_id', '=', False), ('source_analytic_id', '=', False), ('department_analytic_id', '=', False)]}"
                                context="{'can_edit': False}"
                            >
                                <tree decoration-info="state == 'review'" decoration-danger="state == 'draft'" decoration-success="state == 'posted'" default_order="department_analytic_id, id" limit="1000">
                                    <field name="state" widget="badge" decoration-info="state == 'review'" decoration-danger="state == 'draft'" decoration-success="state == 'posted'" />
                                    <field name="name" />
                                    <field name="date" invisible="1" />
                                    <field name="department_analytic_id" />
                                    <field name="source_analytic_id" invisible="1" />
                                    <field name="amount_total" sum="รายรับรวม" />
                                    <field name="amount_deduct" sum="หัก" />
                                    <field name="amount_net" sum="รายรับสุทธิ" />
                                </tree>
                            </field>
                        </page>
                        <page string="ประมาณการรายจ่าย" name="expense_appropriations">
                            <field
                                name="expense_appropriation_ids"
                                domain="[
                                    ('account_fiscal_year_id', '=', account_fiscal_year_id),
                                    ('budget_type', '=', 'expense'),
                                    ('state', '!=', 'cancel'),
                                    '|',
                                        ('source_analytic_id', '=', source_analytic_id),
                                        ('source_analytic_id', '=', False),
                                    '|',
                                        ('department_analytic_id', '=', department_analytic_id),
                                        ('department_analytic_id.parent_path', 'like', str(department_analytic_id) + '/%'),
                                ]"
                                attrs="{'readonly': ['|', '|', ('account_fiscal_year_id', '=', False), ('source_analytic_id', '=', False), ('department_analytic_id', '=', False)]}"
                            >
                                <tree decoration-info="state == 'review'" decoration-danger="state == 'draft'" decoration-success="state == 'posted'" default_order="department_analytic_id, id" limit="1000">
                                    <field name="state" widget="badge" decoration-info="state == 'review'" decoration-danger="state == 'draft'" decoration-success="state == 'posted'" />
                                    <field name="name" />
                                    <field name="date" invisible="1" />
                                    <field name="department_analytic_id" />
                                    <field name="source_analytic_id" invisible="1" />
                                    <field name="amount_net" sum="รวม" />
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right" name="summary_by_budget_type" string="สรุปตามประเภทงบ">
                              <field name="reserve_fund_amount" />
                              <field name="personnel_expense_amount" />
                              <field name="operating_expense_amount" />
                              <field name="capital_expenditure_amount" />
                              <field name="subsidy_amount" />
                              <field name="other_expenditure_amount" />
                              <field style="text-decoration-line: underline; text-decoration-style: double;" name="amount_expense_total" />
                            </group>
                        </page>
                        <page string="รายงาน F23-W" name="f23w_report" attrs="{'invisible': [('use_f23', '=', False)]}">
                            <style>
                                td.o_data_cell[name='analytic_account_id'] span {
                                    white-space: normal !important;
                                }
                            </style>

                            <group>
                                <group>
                                    <field name="revenue_net" />
                                    <field name="code_0702000002" />
                                    <field name="code_0702000003" />
                                    <field name="treasury_replenishment_amount" help="คำนวณจากรหัสงบประมาณ (0702000001, 5108000038)" />
                                    <field name="maintenance_amount" help="คำนวณจากรายการที่ติ๊กเลือก เป็นงบค่าดูแลและบำรุงรักษา" />
                                    <field name="capital_budget_amount" help="คำนวณจากรายการที่ติ๊กเลือก เป็นงบลงทุน" />
                                    <field name="recurrent_budget_amount" />
                                    <field name="external_funding_amount" />
                                </group>
                            </group>

                            <group name="education" string="ด้านการศึกษา (Education)">
                                <field name="education_impact_line_ids" nolabel="1" colspan="2"
                                        context="{'default_impact_type': 'education'}">
                                    <tree editable="bottom">
                                        <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                        <field name="impact_type" invisible="1"/>
                                        <field name="project_okr_amount" sum="จัดสรรโครงการ OKR"/>
                                        <field name="management_amount" sum="ค่าใช้จ่ายบริหาร"/>
                                    </tree>
                                </field>
                            </group>
                            <group name="academic" string="ด้านการวิจัย (Academic)">
                                <field name="academic_impact_line_ids" nolabel="1" colspan="2"
                                        context="{'default_impact_type': 'academic'}">
                                    <tree editable="bottom">
                                        <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                        <field name="impact_type" invisible="1"/>
                                        <field name="project_okr_amount" sum="จัดสรรโครงการ OKR"/>
                                        <field name="management_amount" sum="ค่าใช้จ่ายบริหาร"/>
                                    </tree>
                                </field>
                            </group>
                            <group name="industrial" string="ด้านอุตสาหกรรม (Industrial)">
                                <field name="industrial_impact_line_ids" nolabel="1" colspan="2"
                                        context="{'default_impact_type': 'industrial'}">
                                    <tree editable="bottom">
                                        <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                        <field name="impact_type" invisible="1"/>
                                        <field name="project_okr_amount" sum="จัดสรรโครงการ OKR"/>
                                        <field name="management_amount" sum="ค่าใช้จ่ายบริหาร"/>
                                    </tree>
                                </field>
                            </group>
                            <group name="social" string="ด้านสังคม (Social)">
                                <field name="social_impact_line_ids" nolabel="1" colspan="2"
                                        context="{'default_impact_type': 'social'}">
                                    <tree editable="bottom">
                                        <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                        <field name="impact_type" invisible="1"/>
                                        <field name="project_okr_amount" sum="จัดสรรโครงการ OKR"/>
                                        <field name="management_amount" sum="ค่าใช้จ่ายบริหาร"/>
                                    </tree>
                                </field>
                            </group>

                        </page>
                        <page string="หมายเหตุ" name="note">
                            <field name="note" placeholder="หมายเหตุ..." />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_budget_appropriation_compilation_tree" model="ir.ui.view">
        <field name="name">budget.appropriation.compilation.tree</field>
        <field name="model">budget.appropriation.compilation</field>
        <field name="arch" type="xml">
            <tree string="รวมเล่มหน่วยงาน">
                <field name="name" />
                <field name="department_analytic_id" />
                <field name="source_analytic_id" />
                <field name="account_fiscal_year_id" />
                <field name="amount_revenue_total" sum="รวมรายรับ" />
                <field name="amount_expense_total" sum="รวมรายจ่าย" />
                <field name="state" />
                <field name="revenue_appropriation_ids" invisible="1" />
                <field name="expense_appropriation_ids" invisible="1" />
                <field name="use_f23" invisible="1" />
                <button
                    name="action_open_f4_report"
                    type="object"
                    icon="fa-file-text-o"
                    string="F4"
                    title="เปิดรายงาน F4"
                    attrs="{'invisible': [('revenue_appropriation_ids', '=', [])]}"
                />
                <button
                    name="action_open_f5_report_html"
                    type="object"
                    icon="fa-file-text-o"
                    string="F5"
                    title="เปิดรายงาน F5"
                    attrs="{'invisible': [('expense_appropriation_ids', '=', [])]}"
                />
                <button
                    name="action_open_f23w_report"
                    type="object"
                    icon="fa-file-text-o"
                    string="F23"
                    title="เปิดรายงาน F23"
                    attrs="{'invisible': [('use_f23', '=', False)]}"
                />
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_budget_appropriation_compilation_kanban" model="ir.ui.view">
        <field name="name">budget.appropriation.compilation.kanban</field>
        <field name="model">budget.appropriation.compilation</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_budget_appropriation_compilation_kanban" sample="1">
                <field name="currency_id" />
                <field name="state" />
                <field name="revenue_appropriation_ids" />
                <field name="expense_appropriation_ids" />
                <field name="use_f23" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title fs-5">
                                          <div>
                                            ปีงบประมาณ <field name="account_fiscal_year_id"/>
                                          </div>
                                          <field name="department_analytic_id"/>
                                        </strong>
                                    </div>
                                    <field
                                        name="state"
                                        widget="label_selection"
                                        options="{'classes': {'draft': 'default', 'confirmed': 'warning', 'done': 'success'}}"
                                    />
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="source_analytic_id" />
                                    <span class="text-muted">
                                        — <field name="account_fiscal_year_id" />
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span>รายรับ: <field
                                                name="amount_revenue_total"
                                                widget="monetary"
                                            /></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span>รายจ่าย: <field
                                                name="amount_expense_total"
                                                widget="monetary"
                                            /></span>
                                    </div>
                                </div>
                                <div class="mt-2 d-flex flex-wrap gap-1">
                                    <button
                                        t-if="record.revenue_appropriation_ids.raw_value.length &gt; 0"
                                        name="action_open_f4_report"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary"
                                        title="เปิดรายงาน F4"
                                    >
                                        <i class="fa fa-file-text-o me-1" />F4
                                    </button>
                                    <button
                                        t-if="record.expense_appropriation_ids.raw_value.length &gt; 0"
                                        name="action_open_f5_report_html"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary"
                                        title="เปิดรายงาน F5"
                                    >
                                        <i class="fa fa-file-text-o me-1" />F5
                                    </button>
                                    <button
                                        t-if="record.use_f23.raw_value"
                                        name="action_open_f23w_report"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary"
                                        title="เปิดรายงาน F23"
                                    >
                                        <i class="fa fa-file-text-o me-1" />F23
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
                <t t-name="nocontent">
                    <div class="o_nocontent_help">
                        <p class="o_view_nocontent_smiling_face">
                            เริ่มต้นรวบรวมเล่มงบประมาณของหน่วยงาน
                        </p>
                        <p>
                            รวมเล่มหน่วยงานใช้สำหรับรวบรวมประมาณการรายรับและรายจ่าย
                            ของแต่ละหน่วยงานตามแหล่งเงินและปีงบประมาณ
                            เพื่อนำไปใช้ในการสรุปภาพรวมงบประมาณทั้งสถาบัน
                        </p>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_budget_appropriation_compilation_search" model="ir.ui.view">
        <field name="name">budget.appropriation.compilation.search</field>
        <field name="model">budget.appropriation.compilation</field>
        <field name="arch" type="xml">
            <search string="ค้นหารวมเล่มหน่วยงาน">
                <field name="name" />
                <field name="department_analytic_id" />
                <field name="account_fiscal_year_id" />
                <filter
                    string="ปีงบประมาณปัจจุบัน"
                    name="current_fiscal_year"
                    domain="[
                        ('account_fiscal_year_id.date_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                        ('account_fiscal_year_id.date_to', '&gt;=', context_today().strftime('%Y-%m-%d')),
                    ]"
                />
                <separator />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Confirmed"
                    name="confirmed"
                    domain="[('state', '=', 'confirmed')]"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <group expand="0" name="group_by" string="Group By">
                    <filter
                        string="แหล่งเงิน"
                        name="group_by_source"
                        context="{'group_by': 'source_analytic_id'}"
                    />
                    <filter
                        string="ปีงบประมาณ"
                        name="group_by_fiscal_year"
                        context="{'group_by': 'account_fiscal_year_id'}"
                    />
                    <filter
                        string="หน่วยงาน"
                        name="group_by_department"
                        context="{'group_by': 'department_analytic_id'}"
                    />
                    <filter
                        string="สถานะ"
                        name="group_by_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
                <searchpanel>
                    <field name="account_fiscal_year_id" icon="fa-calendar" enable_counters="1" order="date_from desc" />
                    <field name="department_analytic_id" icon="fa-users" limit="0" order="code asc" />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_appropriation_compilation" model="ir.actions.act_window">
        <field name="name">รวมเล่มหน่วยงาน</field>
        <field name="res_model">budget.appropriation.compilation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_group_by_source': 1}</field>
        <field
            name="search_view_id"
            ref="view_budget_appropriation_compilation_search"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                เริ่มต้นรวบรวมเล่มงบประมาณของหน่วยงาน
            </p>
            <p>
                รวมเล่มหน่วยงานใช้สำหรับรวบรวมประมาณการรายรับและรายจ่าย
                ของแต่ละหน่วยงานตามแหล่งเงินและปีงบประมาณ
                เพื่อนำไปใช้ในการสรุปภาพรวมงบประมาณทั้งสถาบัน
            </p>
            <p class="oe_view_nocontent_create">
                คลิก <b>สร้าง</b> เพื่อเริ่มรวบรวมเล่มงบประมาณหน่วยงาน
            </p>
        </field>
    </record>

</odoo>
