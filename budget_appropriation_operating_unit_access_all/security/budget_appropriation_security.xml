<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <function model="ir.rule" name="write">
        <value
            eval="[ref('budget_appropriation_operating_unit.ir_rule_budget_appropriation_allowed_operating_units'),
                   ref('budget_appropriation_operating_unit.ir_rule_budget_appropriation_line_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|',(1, '=', 1) if user.has_group('budget_operating_unit_access_all.group_all_ou_budget') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>
</odoo>
