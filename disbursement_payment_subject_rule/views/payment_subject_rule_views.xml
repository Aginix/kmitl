<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_payment_subject_rule_tree" model="ir.ui.view">
        <field name="name">disbursement.payment.subject.rule.tree</field>
        <field name="model">disbursement.payment.subject.rule</field>
        <field name="arch" type="xml">
            <tree string="Payment Subject Rules" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="partner_type_id" options="{'no_create': True}" />
                <field name="source_analytic_id" options="{'no_create': True}" />
                <field name="department_analytic_id" options="{'no_create': True}" />
                <field name="fund_analytic_id" options="{'no_create': True}" />
                <field name="activity_analytic_id" options="{'no_create': True}" />
                <field name="payment_type" />
                <field
                    name="payment_subject_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="action_disbursement_payment_subject_rule" model="ir.actions.act_window">
        <field name="name">Payment Subject Rules</field>
        <field name="res_model">disbursement.payment.subject.rule</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a rule to pick the payment subject of a disbursement request automatically</p>
            <p>Leave a criterion empty to match any value. Rules are matched top to bottom and the first match wins; a rule on a parent department, fund or activity covers all of its children.</p>
            <p>The subject is filled in once the bills are posted, only when none has been chosen yet, and the auditor can still change it.</p>
        </field>
    </record>

    <menuitem
        id="menu_disbursement_payment_subject_rule"
        name="Payment Subject Rules"
        parent="finance_kmitl.menu_settings_payment_data"
        action="action_disbursement_payment_subject_rule"
        sequence="25"
    />
</odoo>
