<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View batch.subcomponent.wizard form -->
    <record id="view_batch_subcomponent_wizard_form" model="ir.ui.view">
        <field name="name">batch.subcomponent.wizard.form</field>
        <field name="model">batch.subcomponent.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Subcomponents">
                <group>
                    <field name="batch_line_id" readonly="1"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" string="Subcomponents">
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="number"/>
                    </tree>
                </field>
                <footer>
                    <button name="confirm" type="object" string="Add" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
