<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.asset.batch.subcomponent View Tree -->
    <record id="view_account_asset_batch_subcomponent_tree" model="ir.ui.view">
        <field name="name">view.account.asset.batch.subcomponent.tree</field>
        <field name="model">account.asset.batch.subcomponent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View account.asset.batch.subcomponent form -->
    <record id="view_account_asset_batch_subcomponent_form" model="ir.ui.view">
        <field name="name">view.account.asset.batch.subcomponent.form</field>
        <field name="model">account.asset.batch.subcomponent</field>
        <field name="arch" type="xml">
            <form string="Account Asset Batch Subcomponent">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View account.asset.batch.subcomponent search -->
    <record id="view_account_asset_batch_subcomponent_search" model="ir.ui.view">
        <field name="name">view.account.asset.batch.subcomponent.search</field>
        <field name="model">account.asset.batch.subcomponent</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action account.asset.batch.subcomponent -->
    <record id="action_account_asset_batch_subcomponent" model="ir.actions.act_window">
        <field name="name">Account Asset Batch Subcomponent</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.batch.subcomponent</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Account Asset Batch Subcomponent.
            </p>
        </field>
    </record>

</odoo>
