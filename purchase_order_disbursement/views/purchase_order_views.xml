<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_invoice'][1]" position="after">
                <field name="hide_create_disbursement_request_button" invisible="1" />
                <button name="action_disbursement_request" type="object" string="Create bill" attrs="{'invisible': [('hide_create_disbursement_request_button', '=', True)]}" class="btn-primary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_disbursement_request" type="object" class="oe_stat_button" icon="fa-exchange" attrs="{'invisible':[('disbursement_request_ids','=',[])]}">
                    <field name="disbursement_request_count" widget="statinfo" string="Disbursement Requests"/>
                    <field name='disbursement_request_ids' invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Tree -->
    <record id="view_purchase_order_tree" model="ir.ui.view">
        <field name="name">view.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_kmitl.view_purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="disbursement_request_ids" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
