<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View disbursement.request form -->
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">view.disbursement.request.form</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference_model']" position="after">
                <field name="purchase_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        string="Purchase Order"
                        attrs="{'invisible': [('reference_model', '!=', 'purchase.order')]}">
                </button>
            </xpath>
        </field>
    </record>

    <!-- Tree View for Purchase submenu (different columns from main tree) -->
    <record id="view_disbursement_request_tree_purchase" model="ir.ui.view">
        <field name="name">disbursement.request.tree.purchase</field>
        <field name="model">disbursement.request</field>
        <field name="arch" type="xml">
            <tree string="Disbursement Requests">
                <field name="name" optional="show" />
                <field name="partner_id" optional="show" />
                <field name="user_id" optional="show" />
                <field name="date" optional="show" />
                <field name="ref" optional="show" />
                <field name="amount_total" optional="show" />
                <field name="display_status" widget="badge"
                    decoration-info="display_status == 'draft'"
                    decoration-warning="display_status in ('submitted', 'signed', 'bill_draft', 'payment_draft')"
                    decoration-primary="display_status in ('verified', 'bill_posted')"
                    decoration-success="display_status in ('approved', 'payment_posted', 'done')"
                    decoration-danger="display_status == 'cancel'"
                    optional="show" />
                <field name="source_analytic_id" optional="show" />
                <field name="department_analytic_id" optional="show" />
            </tree>
        </field>
    </record>

    <!-- Action for Purchase submenu: show all statuses (no pre_approval filter) -->
    <record id="action_disbursement_request_purchase" model="ir.actions.act_window">
        <field name="name">รายการขอเบิก</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_disbursement_request_tree_purchase"/>
    </record>

    <!-- Disbursement Requests submenu for Purchase Contract -->
    <menuitem id="menu_disbursement_request_sub_purchase" name="Disbursement Requests" parent="purchase_kmitl.menu_purchase_contract_root" action="action_disbursement_request_purchase" sequence="20"/>
  </odoo>
