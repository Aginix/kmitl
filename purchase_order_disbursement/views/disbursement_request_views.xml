<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View disbursement.request form -->
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">view.disbursement.request.form</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_type_id']" position="before">
                <field name="purchase_id" attrs="{'invisible': [('purchase_id', '=', False)]}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        string="Purchase Order"
                        attrs="{'invisible': [('purchase_id', '=', False)]}">
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_disbursement_request_search" model="ir.ui.view">
        <field name="name">disbursement.request.search (purchase_order_disbursement)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="purchase_id"/>
            </field>
        </field>
    </record>

    <!-- Tree View for Purchase submenu (different columns from main tree) -->
    <record id="view_disbursement_request_tree_purchase" model="ir.ui.view">
        <field name="name">disbursement.request.tree.purchase</field>
        <field name="model">disbursement.request</field>
        <field name="arch" type="xml">
            <tree string="Disbursement Requests">
                <field name="name" optional="show" />
                <field name="payee_display" optional="show" />
                <field name="user_id" optional="show" />
                <field name="date" optional="show" />
                <field name="purchase_id" optional="show" />
                <field name="amount_total" optional="show" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state in ('submitted', 'signed')"
                    decoration-primary="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"
                    optional="show" />
                <field name="settlement_stage" widget="badge"
                    decoration-info="settlement_stage == 'none'"
                    decoration-warning="settlement_stage == 'billed'"
                    decoration-primary="settlement_stage == 'settled'"
                    decoration-success="settlement_stage == 'booked'"
                    optional="show" />
                <field name="source_analytic_id" optional="show" />
                <field name="department_analytic_id" optional="show" />
            </tree>
        </field>
    </record>

    <!-- Action for Purchase submenu: show all statuses (no pre_approval filter) -->
    <record id="action_disbursement_request_purchase" model="ir.actions.act_window">
        <field name="name">รายการขอเบิก</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_disbursement_request_tree_purchase"/>
    </record>

    <!-- Disbursement Requests submenu for Purchase Contract -->
    <menuitem id="menu_disbursement_request_sub_purchase" name="Disbursement Requests" parent="purchase_kmitl.menu_purchase_contract_root" action="action_disbursement_request_purchase" sequence="20"/>
  </odoo>
