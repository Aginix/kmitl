<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form (partner_student_kmitl)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_type_kmitl.view_res_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_student" invisible="1" />
                <label
                    for="student_code"
                    attrs="{'invisible': [('is_student', '=', False), ('student_code', '=', False)]}"
                />
                <div
                    class="o_row"
                    attrs="{'invisible': [('is_student', '=', False), ('student_code', '=', False)]}"
                >
                    <field name="student_code" />
                </div>
                <field name="student_faculty" attrs="{'invisible': [('student_code', '=', False)]}" />
                <field name="student_curriculum" attrs="{'invisible': [('student_code', '=', False)]}" />
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">res.partner.search (partner_student_kmitl)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="student_code" />
            </xpath>
        </field>
    </record>
</odoo>
