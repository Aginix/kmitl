<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="receipt_kmitl.ReceiptDashboard" owl="1">
        <div class="o_expense_container position-sticky start-0 d-flex o_form_statusbar">
            <t t-foreach="Object.entries(state.data)" t-as="entry" t-key="entry[0]">
                <t t-set="key" t-value="entry[0]"/>
                <t t-set="data" t-value="entry[1]"/>
                <div class="o_expense_card o_arrow_button flex-grow-1 d-flex flex-column p-3 border-bottom text-center">
                    <span t-esc="renderMonetaryField(data.amount, data.currency)" class="h2 m-0 text-odoo"/>
                    <b class="mx-2" t-esc="data.description"/>
                </div>
                <div t-if="key !== 'reported'" class="o_expense_card o_arrow_button flex-grow-1 d-flex flex-column p-3 border-bottom text-center">
                    <i class="fa fa-angle-right fa-3x"/>
                </div>
            </t>
        </div>
    </t>
</templates>
