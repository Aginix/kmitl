<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_remittance_reject_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.reject.form</field>
        <field name="model">kmitl.receipt.remittance.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Remittance">
                <group>
                    <field name="remittance_id"/>
                    <field name="reason" placeholder="กรุณาระบุเหตุผลที่ตีกลับ"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Reject"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
