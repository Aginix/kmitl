<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_preview_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.preview.form</field>
        <field name="model">kmitl.receipt.preview</field>
        <field name="arch" type="xml">
            <form string="Receipt Preview">
                <sheet>
                    <field name="receipt_id" invisible="1"/>
                    <field name="preview_html" nolabel="1" colspan="2"/>
                </sheet>
                <footer>
                    <button name="action_confirm_print"
                            type="object"
                            string="Confirm Print"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
