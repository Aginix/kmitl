<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_allocation_create_wizard_form" model="ir.ui.view">
        <field name="name">receipt.kmitl.allocation.wizard.form</field>
        <field name="model">receipt.kmitl.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Suspense Allocation">
                <group>
                    <field name="date"/>
                    <field name="journal_id"/>
                    <field name="note"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="receipt_id" readonly="1"/>
                        <field name="description" readonly="1"/>
                        <field name="receipt_type_id" readonly="1"/>
                        <field name="suspense_account_id" readonly="1"/>
                        <field name="amount" readonly="1"/>
                        <field name="income_account_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="receipt_line_id" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create_allocation"
                            type="object"
                            string="Create Draft Allocation"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_allocation_create_from_receipts" model="ir.actions.act_window">
        <field name="name">Create Suspense Allocation</field>
        <field name="res_model">receipt.kmitl.allocation.wizard</field>
        <field name="binding_model_id" ref="model_receipt_kmitl"/>
        <field name="binding_view_types">list</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_allocation_create_from_receipt_lines" model="ir.actions.act_window">
        <field name="name">Create Suspense Allocation</field>
        <field name="res_model">receipt.kmitl.allocation.wizard</field>
        <field name="binding_model_id" ref="model_receipt_kmitl_line"/>
        <field name="binding_view_types">list</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
