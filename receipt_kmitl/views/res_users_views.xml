<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form_receipt_kmitl" model="ir.ui.view">
        <field name="name">res.users.form.receipt.kmitl</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="KMITL Receipt" name="receipt_kmitl"
                      groups="receipt_kmitl.group_receipt_kmitl_cashier">
                    <group>
                        <field name="kmitl_department_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
