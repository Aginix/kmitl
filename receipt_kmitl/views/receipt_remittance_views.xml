<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_remittance_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.tree</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="account_fiscal_year_id" optional="hide"/>
                <field name="department_analytic_id"/>
                <field name="receipt_count" string="#"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="user_id" optional="show"/>
                <field name="submitted_by" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_receipt_remittance_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.form</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull_pending_receipts"
                            type="object"
                            string="Pull Pending Receipts"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_submit"
                            type="object"
                            string="Submit to Treasury"
                            class="btn-primary"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            states="submitted"
                            groups="receipt_kmitl.group_receipt_kmitl_treasury_officer"/>
                    <button name="action_post"
                            type="object"
                            string="Post Journal Entries"
                            class="btn-primary"
                            states="approved"
                            groups="receipt_kmitl.group_receipt_kmitl_treasury_officer"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            attrs="{'invisible': [('state', 'in', ['draft', 'cancelled'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            attrs="{'invisible': [('state', 'in', ['posted', 'cancelled'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            states="cancelled"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entries"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                attrs="{'invisible': [('move_count', '=', 0)]}">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_view_receipts"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="receipt_count" widget="statinfo" string="Receipts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="account_fiscal_year_id"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="department_analytic_id"
                                   options="{'no_create': True}"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_id"
                                   readonly="1"
                                   groups="!receipt_kmitl.group_receipt_kmitl_manager"/>
                            <field name="user_id"
                                   readonly="0"
                                   groups="receipt_kmitl.group_receipt_kmitl_manager"/>
                            <field name="submitted_by"
                                   attrs="{'invisible': [('state','=','draft')]}"/>
                            <field name="approved_by"
                                   attrs="{'invisible': [('state','not in',['approved','posted'])]}"/>
                            <field name="posted_by"
                                   attrs="{'invisible': [('state','!=','posted')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipts" name="receipts">
                            <field name="receipt_ids" widget="many2many" domain="[('state', '=', 'to_submit')]">
                                <tree edit="false">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="payment_method_id"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_receipt_remittance_pivot" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.pivot</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <pivot string="Receipt Remittances">
                <field name="department_analytic_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_receipt_remittance_search" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.search</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_analytic_id"/>
                <field name="account_fiscal_year_id"/>
                <field name="submitted_by"/>
                <field name="user_id"/>
                <separator/>
                <filter string="My Submissions" name="my_submissions"
                        domain="[('submitted_by','=',uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Posted" name="posted" domain="[('state','=','posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by':'department_analytic_id'}"/>
                    <filter string="Fiscal Year" name="group_fiscal_year" context="{'group_by':'account_fiscal_year_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date:month'}"/>
                    <filter string="Submitted By" name="group_submitted_by" context="{'group_by':'submitted_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_receipt_remittance" model="ir.actions.act_window">
        <field name="name">Receipt Remittances</field>
        <field name="res_model">kmitl.receipt.remittance</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_receipt_remittance_search"/>
    </record>
</odoo>
