<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_remittance_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.tree</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="department_analytic_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_receipt_remittance_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.form</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull_pending_receipts"
                            type="object"
                            string="Pull Pending Receipts"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_submit"
                            type="object"
                            string="Submit to Treasury"
                            class="btn-primary"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_done"
                            type="object"
                            string="Review &amp; Post"
                            class="btn-primary"
                            states="submitted"
                            groups="receipt_kmitl.group_receipt_kmitl_treasury_officer"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancelled'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            attrs="{'invisible': [('state', '!=', 'cancelled')]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="department_analytic_id"
                                   options="{'no_create': True}"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="submitted_by"
                                   attrs="{'invisible': [('state','=','draft')]}"/>
                            <field name="done_by"
                                   attrs="{'invisible': [('state','!=','done')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipts" name="receipts">
                            <field name="receipt_ids"
                                   attrs="{'readonly': [('state','!=','draft')]}">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="payment_method_id"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state"/>
                                    <button name="action_detach"
                                            type="object"
                                            string="Detach"
                                            icon="fa-chain-broken"
                                            groups="receipt_kmitl.group_receipt_kmitl_user"
                                            attrs="{'column_invisible': [('parent.state', '!=', 'submitted')]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_receipt_remittance_search" model="ir.ui.view">
        <field name="name">kmitl.receipt.remittance.search</field>
        <field name="model">kmitl.receipt.remittance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_analytic_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by':'department_analytic_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_receipt_remittance" model="ir.actions.act_window">
        <field name="name">Receipt Remittances</field>
        <field name="res_model">kmitl.receipt.remittance</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_receipt_remittance_search"/>
    </record>
</odoo>
