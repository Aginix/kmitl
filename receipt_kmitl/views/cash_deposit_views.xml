<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_cash_deposit_tree" model="ir.ui.view">
        <field name="name">receipt.kmitl.cash.deposit.tree</field>
        <field name="model">receipt.kmitl.cash.deposit</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_cash_deposit_form" model="ir.ui.view">
        <field name="name">receipt.kmitl.cash.deposit.form</field>
        <field name="model">receipt.kmitl.cash.deposit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull_pending_receipts"
                            type="object"
                            string="Pull Pending Receipts"
                            states="draft"/>
                    <button name="action_submit"
                            type="object"
                            string="Submit to Treasury"
                            class="btn-primary"
                            states="draft"/>
                    <button name="action_post"
                            type="object"
                            string="Review &amp; Post"
                            class="btn-primary"
                            states="submitted"
                            groups="receipt_kmitl.group_receipt_kmitl_central_finance"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            attrs="{'invisible': [('state', 'in', ['posted', 'cancelled'])]}"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            attrs="{'invisible': [('state', 'not in', ['submitted', 'cancelled'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_central_finance"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="department_id"
                                   options="{'no_create': True}"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="submitted_by"
                                   attrs="{'invisible': [('state','=','draft')]}"/>
                            <field name="posted_by"
                                   attrs="{'invisible': [('state','!=','posted')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipts" name="receipts">
                            <field name="receipt_ids"
                                   attrs="{'readonly': [('state','!=','draft')]}">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="payment_method_id"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cash_deposit" model="ir.actions.act_window">
        <field name="name">Cash Deposits</field>
        <field name="res_model">receipt.kmitl.cash.deposit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
