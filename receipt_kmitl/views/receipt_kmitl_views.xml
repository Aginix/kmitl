<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_kmitl_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.tree</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'to_submit'"
                  decoration-success="state == 'done'"
                  js_class="receipt_kmitl_dashboard_tree">
                <field name="name"/>
                <field name="date"/>
                <field name="department_analytic_id"/>
                <field name="user_id"/>
                <field name="customer_name"/>
                <field name="partner_id" optional="hide"/>
                <field name="payment_method_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="remittance_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_submit'"
                       decoration-warning="state in ('submitted', 'approved')"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_receipt_kmitl_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.form</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_remittance"
                            type="object"
                            string="View Report"
                            class="btn-primary"
                            attrs="{'invisible': [('remittance_id', '=', False)]}"/>
                    <button name="action_to_submit"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            states="to_submit"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            states="cancelled"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_print_original"
                            type="object"
                            string="Print Original"
                            icon="fa-print"
                            attrs="{'invisible': [('state', 'in', ['draft', 'cancelled'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_print_copy"
                            type="object"
                            string="Print Copy"
                            icon="fa-copy"
                            attrs="{'invisible': [('state', 'in', ['draft', 'cancelled'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_submit,submitted,approved,done"/>
                </header>
                <sheet>
                    <field name="remittance_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                attrs="{'invisible': [('move_id', '=', False)]}"
                                groups="receipt_kmitl.group_receipt_kmitl_remittance_approver">
                            <field name="move_id" widget="statinfo" string="Journal Entry"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="header" string="Receipt Info">
                            <field name="date"/>
                            <field name="account_fiscal_year_id" widget="selection"/>
                            <field name="department_analytic_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="payment_method_id"
                                   widget="selection"/>
                            <field name="user_id" readonly="1"
                                   groups="!receipt_kmitl.group_receipt_kmitl_manager"/>
                            <field name="user_id" readonly="0"
                                   groups="receipt_kmitl.group_receipt_kmitl_manager"/>
                            <field name="description"/>
                        </group>
                        <group name="customer" string="Payer">
                            <field name="is_walkin"/>
                            <div colspan="2" class="alert alert-info mb-0 py-2" role="alert"
                                 attrs="{'invisible': [('is_walkin', '=', False)]}">
                                <i class="fa fa-info-circle"/>
                                Walk-in customer: receipt for a general customer without specific payer details.
                            </div>
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   attrs="{'readonly': ['|', ('is_walkin', '=', True), ('state', '!=', 'draft')]}"/>
                            <field name="customer_name"/>
                            <field name="customer_tax_id"
                                   attrs="{'invisible': [('is_walkin', '=', True)]}"/>
                            <field name="customer_branch_code"
                                   attrs="{'invisible': [('is_walkin', '=', True)]}"/>
                            <field name="customer_address"
                                   attrs="{'invisible': [('is_walkin', '=', True)]}"/>
                        </group>
                    </group>
                    <group name="analytic_dimensions" string="Analytic Dimensions">
                        <group>
                            <field name="fund_analytic_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="source_analytic_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="activity_analytic_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="kmitl_project_analytic_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="procurement_plan_analytic_id"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group name="footer">
                              <group>
                                <label for="note" string="Notes"/>
                                <field name="note" nolabel="1" colspan="2" placeholder="Notes"/>
                              </group>
                            </group>
                            <group name="attachments" string="Attachments">
                                <field name="attachment_ids" nolabel="1" colspan="2"
                                       widget="many2many_binary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_receipt_kmitl_pivot" model="ir.ui.view">
        <field name="name">kmitl.receipt.pivot</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <pivot string="Receipts">
                <field name="department_analytic_id" type="row"/>
                <field name="payment_method_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_receipt_kmitl_search" model="ir.ui.view">
        <field name="name">kmitl.receipt.search</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="department_analytic_id"/>
                <field name="customer_name"/>
                <field name="payment_method_id"/>
                <field name="account_fiscal_year_id"/>
                <field name="user_id"/>
                <field name="remittance_id"/>
                <separator/>
                <filter string="My Receipts" name="my_receipts"
                        domain="[('user_id','=',uid)]"/>
                <filter string="Walk-in" name="walkin"
                        domain="[('is_walkin','=',True)]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Yesterday" name="yesterday"
                        domain="[('date','=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="To Submit" name="to_submit" domain="[('state','=','to_submit')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Pending Remittance" name="pending_remittance"
                        domain="[('state','=','to_submit'),('remittance_id','=',False)]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by':'department_analytic_id'}"/>
                    <filter string="Fiscal Year" name="group_fiscal_year" context="{'group_by':'account_fiscal_year_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date:day'}"/>
                    <filter string="Payment Method" name="group_method" context="{'group_by':'payment_method_id'}"/>
                    <filter string="Issued By" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_receipt_kmitl_my" model="ir.actions.act_window">
        <field name="name">My Receipts</field>
        <field name="res_model">kmitl.receipt</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_receipt_kmitl_search"/>
        <field name="context">{'search_default_my_receipts': 1}</field>
    </record>

    <record id="action_receipt_kmitl" model="ir.actions.act_window">
        <field name="name">All Receipts</field>
        <field name="res_model">kmitl.receipt</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_receipt_kmitl_search"/>
        <field name="context">{'search_default_group_date': 1}</field>
    </record>
</odoo>
