<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_kmitl_tree" model="ir.ui.view">
        <field name="name">receipt.kmitl.tree</field>
        <field name="model">receipt.kmitl</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'issued'"
                  decoration-success="state == 'reclassified'">
                <field name="name"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'issued'"
                       decoration-warning="state == 'deposited'"
                       decoration-success="state == 'reclassified'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_receipt_kmitl_form" model="ir.ui.view">
        <field name="name">receipt.kmitl.form</field>
        <field name="model">receipt.kmitl</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_issue"
                            type="object"
                            string="Issue Receipt"
                            class="btn-primary"
                            states="draft"/>
                    <button name="action_open_cancel_wizard"
                            type="object"
                            string="Cancel..."
                            states="issued"
                            groups="receipt_kmitl.group_receipt_kmitl_cashier"/>
                    <button name="action_open_refund_wizard"
                            type="object"
                            string="Refund..."
                            attrs="{'invisible': [('state', 'not in', ['deposited', 'reclassified'])]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,deposited,reclassified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Header">
                            <field name="date"/>
                            <field name="department_id"
                                   options="{'no_create': True}"/>
                            <field name="journal_id"/>
                            <field name="payment_method"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="customer_tax_id"/>
                            <field name="customer_branch_code"/>
                            <field name="customer_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="receipt_type_id"/>
                                    <field name="name"/>
                                    <field name="suspense_account_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="department_analytic_id" optional="hide"/>
                                    <field name="fund_analytic_id" optional="show"/>
                                    <field name="source_analytic_id" optional="show"/>
                                    <field name="activity_analytic_id" optional="show"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"/>
                                    <field name="income_account_id" optional="hide" readonly="1"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state" invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                        <page string="Accounting" name="accounting"
                              attrs="{'invisible': [('move_id', '=', False)]}">
                            <group>
                                <field name="move_id" readonly="1"/>
                                <field name="cash_deposit_id" readonly="1"/>
                                <field name="cancel_reason" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                                <field name="cancelled_by" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                                <field name="cancelled_date" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_receipt_kmitl_search" model="ir.ui.view">
        <field name="name">receipt.kmitl.search</field>
        <field name="model">receipt.kmitl</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <field name="customer_name"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Issued" name="issued" domain="[('state','=','issued')]"/>
                <filter string="Deposited" name="deposited" domain="[('state','=','deposited')]"/>
                <filter string="Reclassified" name="reclassified" domain="[('state','=','reclassified')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Pending Allocation" name="pending_allocation"
                        domain="[('state','=','deposited')]"/>
                <separator/>
                <filter string="Cash" name="cash" domain="[('payment_method','=','cash')]"/>
                <filter string="Bank Transfer" name="transfer" domain="[('payment_method','=','transfer')]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                    <filter string="Payment Method" name="group_method" context="{'group_by':'payment_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_receipt_kmitl" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">receipt.kmitl</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_receipt_kmitl_search"/>
    </record>
</odoo>
