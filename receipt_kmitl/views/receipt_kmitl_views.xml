<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_receipt_kmitl_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.tree</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="department_analytic_id"/>
                <field name="partner_id"/>
                <field name="payment_method_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="remittance_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_receipt_kmitl_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.form</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_post"
                            type="object"
                            string="Post"
                            class="btn-primary"
                            states="confirmed"
                            groups="receipt_kmitl.group_receipt_kmitl_treasury_officer"/>
                    <button name="action_correct"
                            type="object"
                            string="แก้ไขใบเสร็จ"
                            attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('remittance_id', '!=', False)]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'confirmed'])]}"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            states="cancelled"
                            groups="receipt_kmitl.group_receipt_kmitl_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,posted"/>
                </header>
                <sheet>
                    <field name="remittance_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="header" string="Header">
                            <field name="date"/>
                            <field name="account_fiscal_year_id"/>
                            <field name="department_analytic_id"
                                   options="{'no_create': True}"/>
                            <field name="payment_method_id"
                                   widget="selection"/>
                            <field name="user_id" readonly="1"
                                   groups="!receipt_kmitl.group_receipt_kmitl_manager"/>
                            <field name="user_id" readonly="0"
                                   groups="receipt_kmitl.group_receipt_kmitl_manager"/>
                            <field name="description"/>
                        </group>
                        <group name="customer" string="Customer">
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="customer_name"/>
                            <field name="customer_tax_id"/>
                            <field name="customer_branch_code"/>
                            <field name="customer_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="department_analytic_id" optional="hide"/>
                                    <field name="fund_analytic_id" optional="show"/>
                                    <field name="source_analytic_id" optional="show"/>
                                    <field name="activity_analytic_id" optional="show"/>
                                    <field name="kmitl_project_analytic_id" optional="hide"/>
                                    <field name="procurement_plan_analytic_id" optional="hide"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group name="footer">
                              <group>
                                <label for="note" string="Notes"/>
                                <field name="note" nolabel="1" colspan="2" placeholder="หมายเหตุ" />
                              </group>
                            </group>
                        </page>
                        <page string="Accounting" name="accounting"
                              groups="receipt_kmitl.group_receipt_kmitl_treasury_officer"
                              attrs="{'invisible': ['&amp;', ('move_id', '=', False), ('remittance_id', '=', False)]}">
                            <group>
                                <field name="move_id" readonly="1"/>
                                <field name="remittance_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_receipt_kmitl_search" model="ir.ui.view">
        <field name="name">kmitl.receipt.search</field>
        <field name="model">kmitl.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="department_analytic_id"/>
                <field name="customer_name"/>
                <field name="payment_method_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Posted" name="posted" domain="[('state','=','posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Pending Remittance" name="pending_remittance"
                        domain="[('state','=','confirmed'),('remittance_id','=',False)]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by':'department_analytic_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                    <filter string="Payment Method" name="group_method" context="{'group_by':'payment_method_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_receipt_kmitl" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">kmitl.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_receipt_kmitl_search"/>
    </record>
</odoo>
