<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_allocation_tree" model="ir.ui.view">
        <field name="name">receipt.kmitl.allocation.tree</field>
        <field name="model">receipt.kmitl.allocation</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_allocation_form" model="ir.ui.view">
        <field name="name">receipt.kmitl.allocation.form</field>
        <field name="model">receipt.kmitl.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post"
                            type="object"
                            string="Post"
                            class="btn-primary"
                            states="draft"
                            groups="receipt_kmitl.group_receipt_kmitl_manager"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            states="draft"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="journal_id"
                                   attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="move_id" attrs="{'invisible': [('move_id','=',False)]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids"
                                   attrs="{'readonly': [('state','!=','draft')]}">
                                <tree editable="bottom">
                                    <field name="receipt_id" readonly="1"/>
                                    <field name="receipt_line_id"/>
                                    <field name="receipt_type_id" readonly="1"/>
                                    <field name="suspense_account_id" readonly="1"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="income_account_id"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           optional="hide"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_allocation" model="ir.actions.act_window">
        <field name="name">Suspense Allocations</field>
        <field name="res_model">receipt.kmitl.allocation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
