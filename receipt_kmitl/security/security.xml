<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_receipt_kmitl" model="ir.module.category">
            <field name="name">Receipt KMITL</field>
            <field name="description">User groups for KMITL receipt management</field>
            <field name="sequence">15</field>
        </record>

        <!-- Tier: Viewer -> User -> Manager (each implies the one below) -->
        <record id="group_receipt_kmitl_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="receipt_kmitl.module_category_receipt_kmitl"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="group_receipt_kmitl_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="receipt_kmitl.module_category_receipt_kmitl"/>
            <field name="implied_ids" eval="[(4, ref('group_receipt_kmitl_viewer'))]"/>
        </record>

        <!-- Remittance Approver: independent checkbox (no category), implies User.
             Carries real accounting rights so action_done is not sudo'd. -->
        <record id="group_receipt_kmitl_remittance_approver" model="res.groups">
            <field name="name">Remittance Approver</field>
            <field name="category_id" eval="False"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_receipt_kmitl_user'), ref('account.group_account_invoice')])]"/>
        </record>

        <record id="group_receipt_kmitl_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="receipt_kmitl.module_category_receipt_kmitl"/>
            <field name="implied_ids" eval="[(4, ref('group_receipt_kmitl_user')), (4, ref('group_receipt_kmitl_remittance_approver'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
