<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!--
            Default receipt types. Each must be configured with a real
            suspense_account_id after installation by the central finance
            manager (master data setup).
        -->
        <record id="receipt_type_tuition" model="receipt.kmitl.type">
            <field name="name">Education Fees</field>
            <field name="code">EDU</field>
            <field name="sequence">10</field>
        </record>
        <record id="receipt_type_academic_service" model="receipt.kmitl.type">
            <field name="name">Academic Service Fees</field>
            <field name="code">ACAD_SVC</field>
            <field name="sequence">20</field>
        </record>
        <record id="receipt_type_card" model="receipt.kmitl.type">
            <field name="name">ID / Card Fees</field>
            <field name="code">CARD</field>
            <field name="sequence">30</field>
        </record>
        <record id="receipt_type_fine" model="receipt.kmitl.type">
            <field name="name">Fines</field>
            <field name="code">FINE</field>
            <field name="sequence">40</field>
        </record>
        <record id="receipt_type_other" model="receipt.kmitl.type">
            <field name="name">Other Income</field>
            <field name="code">OTHER</field>
            <field name="sequence">99</field>
        </record>
    </data>
</odoo>
