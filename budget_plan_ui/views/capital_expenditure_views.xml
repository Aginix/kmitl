<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_capital_expenditure_tree" model="ir.ui.view">
        <field name="name">view.capital.expenditure.tree</field>
        <field name="model">capital.expenditure</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="amount" />
            </tree>
        </field>
    </record>

    <record id="view_capital_expenditure_form" model="ir.ui.view">
        <field name="name">capital.expenditure.form</field>
        <field name="model">capital.expenditure</field>
        <field name="arch" type="xml">
            <form string="แผนการจัดซื้อจัดจ้าง">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="expected_purchase_date" />
                        <field name="note" />
                        <field name="payment" />
                        <field name="budget_plan_line_id" />
                    </group>
                    <group>
                        <field
                            name="amount"
                            attrs="{'invisible': [('payment', '=', 'installment')]}"
                        />
                    </group>
                    <group>
                        <field
                            name="line_ids"
                            attrs="{'invisible': [('payment', '=', 'single')]}"
                        >
                            <tree editable="bottom">
                                <field name="installment_date" />
                                <field name="installment_amount" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_plan_search" model="ir.ui.view">
        <field name="name">view.capital.expenditure.search</field>
        <field name="model">capital.expenditure</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_capital_expenditure" model="ir.actions.act_window">
        <field name="name">Capital Expenditure</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">capital.expenditure</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Plan.
            </p>
        </field>
    </record>

    <record id="inherit_procurement_form" model="ir.ui.view">
        <field name="name">procurement.plan.view.form.inherit</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <field name="budget_plan_line_id" />
                <field name="hide_header" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('hide_header', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_range_fy_id']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('hide_header', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='source_analytic_id']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('hide_header', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_analytic_id']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('hide_header', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='department_analytic_id']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('hide_header', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='budget_plan_line_id']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('hide_header', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

    <menuitem
        id="action_procurement_menu_action"
        name="procurement"
        action="procurement_plan.action_procurement_plan"
        parent="budget.budget_root_menu"
        sequence="89"
    />

</odoo>
