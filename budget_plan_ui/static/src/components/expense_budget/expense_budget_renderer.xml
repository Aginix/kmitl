<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="budget_plan_ui.expense_budget_renderer" owl="1">
        <div class="text-center mt-3">
            <h5>
                <span t-esc="state.templateName" />
            </h5>
            <h5>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</h5>
        </div>

        <!-- ตารางแสดงกิจกรรม -->
        <Budget_table data="state.activityList" type="'activity'" />

        <!-- แสดงกิจกรรมที่เลือก -->
        <div class="mt-3">
            <t t-if="!!state.selectedActivity">
                <h4 class="text-danger blink-text">
                    คุณกำลังทำรายการ 
                    <span t-esc="state.selectedCode" />
                </h4>
                <t t-foreach="state.activity_selected_list" t-as="activity" t-key="activity.id">
                    <h4 class="text-danger blink-text">
                        <span t-esc="activity.name" />
                    </h4>
                </t>
            </t>
            <t t-else="">
                <h4 class="text-danger blink-text">กรุณาเลือกกิจกรรม</h4>
            </t>
        </div>

        <!-- dropdown เลือกงบประมาณ -->
        <div class="text-center o_select_budget_plan mt-3" t-if="!!state.selectedActivity">
            <div class="d-flex col-6 mx-auto">
                <span style="width: 150px">งบประมาณ :</span>
                <select class="form-select" t-on-change="onBudgetChange">
                    <option value="0">กรุณาเลือกงบ...</option>
                    <t t-foreach="state.templateLines" t-as="plan" t-key="plan.id">
                        <t t-if="!plan.parent_id">
                            <option t-att-value="plan.id" t-esc="plan.name" />
                        </t>
                    </t>
                </select>
            </div>
        </div>

        <!-- loading -->
        <t t-if="state.loading">
            <div class="d-flex justify-content-center mt-5">
                <div class="loader"></div>
            </div>
        </t>

        <Budget_table
            t-if="!state.loading and !!state.selectedActivity"
            data="state.mergedLines"
            isShow="true"
            type="'expense'"
            t-key="state.refreshKey"
        />
    </t>

</templates>