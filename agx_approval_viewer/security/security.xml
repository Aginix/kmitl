<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Own ⊂ Viewer ⊂ User ⊂ Manager: creates/edits own requests (via
             Own) and reads every other request. -->
        <record id="group_approval_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="agx_approval.module_category_approval" />
            <field
                name="implied_ids"
                eval="[(4, ref('agx_approval.group_approval_own'))]"
            />
        </record>

        <record id="agx_approval.group_approval_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_approval_viewer'))]" />
        </record>

        <!-- Read-only permissive rule: ORs out the inherited "own only" rule
             for reads; write/create/unlink stay limited to own requests. -->
        <record id="approval_request_viewer_read_all_rule" model="ir.rule">
            <field name="name">Approval Request: viewers read all</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="groups" eval="[(4, ref('group_approval_viewer'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
    </data>
</odoo>
