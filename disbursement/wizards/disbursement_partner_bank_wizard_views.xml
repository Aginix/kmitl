<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="disbursement_partner_bank_wizard_form" model="ir.ui.view">
        <field name="name">disbursement.partner.bank.wizard.form</field>
        <field name="model">disbursement.partner.bank.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Bank Accounts">
                <field name="request_id" invisible="1" />
                <p class="text-muted">The account is added to the payee and filled in on the request's lines. Existing accounts are not changed.</p>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="partner_id" force_save="1" />
                        <field name="bank_id" options="{'no_create': True, 'no_open': True}" />
                        <field name="acc_number" />
                        <field name="acc_holder_name" />
                    </tree>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Add" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
