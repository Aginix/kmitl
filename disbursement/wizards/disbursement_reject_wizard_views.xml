<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="disbursement_reject_wizard_form" model="ir.ui.view">
        <field name="name">disbursement.reject.wizard.form</field>
        <field name="model">disbursement.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval">
                <field name="request_id" invisible="1" />
                <group>
                    <field name="reason" placeholder="Reason for rejecting this approval…" />
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
