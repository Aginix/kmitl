<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_disbursement_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <!-- Thai context -->
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})"/>
                    <t t-set="currency" t-value="o.currency_id"/>

                    <!-- CSS styling -->
                    <style>
                        * {
                        font-family: "THSarabunNew", Arial, sans-serif;
                        --bs-body-font-size: 16pt;
                        }
                        table.budget tr td:first-child {
                        width: 30%;
                        }
                        p,
                        span,
                        div {
                        font-size: 16pt;
                        line-height: 1.2;
                        }
                    </style>

                    <div class="page">
                        <!-- Company Logo (top-left) -->
                        <div style="position: absolute; top: 0px; left: 0px">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 110px" alt="Logo" />
                        </div>

                        <div class="oe_structure" />
                        <div style="height: 1px" />

                        <div class="page-header mt-5 mb-5">
                            <h3 class="text-center fw-bolder" style="line-height: 1.575">
                                ใบขอเบิกเงิน
                            </h3>
                        </div>

                        <div class="my-5" />
                        <div class="my-5" />

                        <!-- Document Information -->
                        <div class="row pt-8">
                            <div class="col-8">
                                เลขที่                                <span class="ms-2 fw-normal" t-out="o.name"/>
                            </div>
                            <div class="col">
                                วันที่                                <span class="ms-2 fw-normal" t-field="o.date"/>
                            </div>
                        </div>

                        <div class="row" t-if="o.ref">
                            <div class="col">
                                อ้างอิง                                <span class="ms-2" t-out="o.ref"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                วิธีการจ่ายเงิน:
                                <span class="ms-2" t-field="o.payment_type"/>
                            </div>
                        </div>

                        <!-- Financial Dimensions (Budget Module) -->
                        <div class="my-5" />

                        <table class="table table-bordered border table-sm budget">
                            <tbody>
                                <tr class="o_field_budget_commitment_id">
                                    <td>เลขที่ใบจองงบประมาณ</td>
                                    <td>
                                        <span t-field="o.budget_commitment_id" />
                                    </td>
                                </tr>
                                <tr class="o_field_budget_account_id">
                                    <td>รหัสงบประมาณค่าใช้จ่าย</td>
                                    <td>
                                        <span t-field="o.budget_account_id" />
                                    </td>
                                </tr>
                                <tr class="o_field_source_analytic_id">
                                    <td>แหล่งเงิน</td>
                                    <td>
                                        <span t-field="o.source_analytic_id" />
                                    </td>
                                </tr>
                                <tr class="o_field_department_analytic_id">
                                    <td>หน่วยงาน</td>
                                    <td>
                                        <span t-field="o.department_analytic_id" />
                                    </td>
                                </tr>
                                <tr class="o_field_activity_analytic_id">
                                    <td>ด้าน/แผนงาน/กิจกรรม</td>
                                    <td>
                                        <span t-field="o.activity_analytic_id" />
                                    </td>
                                </tr>
                                <tr class="o_field_fund_analytic_id">
                                    <td>กองทุน</td>
                                    <td>
                                        <span t-field="o.fund_analytic_id" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="my-4"/>

                        <!-- Line items grouped by partner (name list) -->
                        <t>
                            <t t-set="partners" t-value="o.line_ids.mapped('partner_id')"/>
                            <t t-set="global_row_no" t-value="1"/>
                            <t t-foreach="partners" t-as="partner">
                                <div class="row mt-3 mb-2">
                                    <div class="col">
                                        <strong>ผู้รับเงิน:                                            <span t-out="partner.name"/>
                                        </strong>
                                    </div>
                                </div>
                                <t t-set="partner_lines" t-value="o.line_ids.filtered(lambda l: l.partner_id == partner)"/>
                                <t t-set="partner_bank" t-value="partner_lines[0].partner_bank_id if partner_lines else False"/>
                                <div class="row mb-2" t-if="partner_bank">
                                    <div class="col">
                                        ธนาคาร                                        <span class="ms-2" t-out="partner_bank.bank_id.name"/>
                                        เลขที่บัญชี                                        <span class="ms-2" t-out="o._get_masked_acc_number(partner_bank.acc_number)"/>
                                    </div>
                                </div>
                                <table class="table table-bordered table-sm mb-4">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 8%">ลำดับ</th>
                                            <th class="text-center">รายละเอียด</th>
                                            <th class="text-center">จำนวน</th>
                                            <th class="text-end">ราคาต่อหน่วย</th>
                                            <th class="text-end">จำนวนเงิน</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="partner_lines" t-as="line">
                                            <tr>
                                                <td class="text-center" style="width: 8%" t-out="global_row_no"/>
                                                <td t-out="line.name"/>
                                                <td class="text-center" t-out="'{0:,.2f}'.format(line.quantity)"/>
                                                <td class="text-end" t-out="'{0:,.2f} ฿'.format(line.price_unit)"/>
                                                <td class="text-end" t-out="'{0:,.2f} ฿'.format(line.price_subtotal)"/>
                                            </tr>
                                            <t t-set="global_row_no" t-value="global_row_no + 1"/>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- Totals Section (shared) -->
                        <table class="table table-bordered table-sm mb-4">
                            <tbody>
                                <tr>
                                    <td t-att-rowspan="o.amount_tax and 3 or 1" class="text-center align-middle" style="width: 50%">

                                        <div class="mt-2">
                                            (                                            <t t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.amount_total)"/>
)
                                        </div>
                                    </td>
                                    <td class="text-center" style="width: 25%">
                                        <span t-if="o.amount_tax">ราคาก่อนรวมภาษีมูลค่าเพิ่ม</span>
                                        <span t-else="">รวมเป็นเงิน</span>
                                    </td>
                                    <td class="text-end" style="width: 25%" t-out="'{0:,.2f} ฿'.format(o.amount_untaxed if o.amount_tax else o.amount_total)"/>
                                </tr>
                                <tr t-if="o.amount_tax">
                                    <td class="text-center">ภาษีมูลค่าเพิ่ม (VAT 7%)</td>
                                    <td class="text-end" t-out="'{0:,.2f} ฿'.format(o.amount_tax)"/>
                                </tr>
                                <tr t-if="o.amount_tax">
                                    <td class="text-center">ราคาสุทธิ</td>
                                    <td class="text-end" t-out="'{0:,.2f} ฿'.format(o.amount_total)"/>
                                </tr>
                            </tbody>
                        </table>

                        <div class="my-4"/>

                        <div class="row" t-if="o.note">
                            <div class="col">
                                <strong>หมายเหตุ:</strong>
                                <span class="ms-2" t-out="o.note"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Signature Template -->
    <template id="report_disbursement_request_signature">
        <div class="my-5">
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ                    <t t-out="'.' * 80"/>
 ผู้ขอเบิก</div>
                <div class="text-center my-2">
                    (                    <span t-out="o.create_uid.name"/>
 )
                </div>
                <div class="text-center">
                    วันที่ ......../......../..........
                </div>
            </div>
        </div>

        <div class="my-5"/>

        <div class="my-5">
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ                    <t t-out="'.' * 80"/>
 ผู้อนุมัติ</div>
                <div class="text-center my-2">
                    ( ........................................... )
                </div>
                <div class="text-center">
                    วันที่ ......../......../..........
                </div>
            </div>
        </div>
    </template>
</odoo>
