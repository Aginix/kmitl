<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Guards checked on Submit, in place of hard field
         constraints: they never lock an already-submitted request when a
         partner is re-typed or loses an account later, and the user can open
         the partner from the line to fix it. -->

    <!-- Every payee must be of the request's ประเภทผู้รับเงิน — e.g. the header
         type was changed after the lines were entered. -->
    <record id="excep_disbursement_line_partner_type" model="exception.rule">
        <field name="name">ผู้รับเงินไม่ตรงกับประเภทผู้รับเงินของใบขอเบิก</field>
        <field name="description">มีรายการที่ผู้รับเงินไม่ได้เป็นประเภทผู้รับเงินตามที่ระบุบนใบขอเบิก กรุณาเปลี่ยนผู้รับเงินหรือประเภทผู้รับเงินให้ตรงกัน</field>
        <field name="sequence">10</field>
        <field name="model">disbursement.request.line</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.partner_id.partner_type_id != self.request_id.partner_type_id:
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- Payment normally goes by bank transfer, so every payee should have an
         account. Not blocking: a payee paid in cash (disbursement_finance_kmitl
         cash paying account) needs none, and an exception manager may ignore
         the rule for that request. -->
    <record id="excep_disbursement_line_partner_bank" model="exception.rule">
        <field name="name">ผู้รับเงินยังไม่มีบัญชีธนาคาร</field>
        <field name="description">มีรายการที่ผู้รับเงินยังไม่มีบัญชีธนาคาร กรุณาเปิดผู้รับเงินจากรายการเพื่อเพิ่มบัญชีธนาคาร</field>
        <field name="sequence">11</field>
        <field name="model">disbursement.request.line</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.partner_id and not self.partner_bank_id and self._requires_partner_bank():
    failed = True
        </field>
        <field name="is_blocking" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
