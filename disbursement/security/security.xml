<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_disbursement" model="ir.module.category">
            <field name="name">Disbursement</field>
            <field name="description">User groups for managing disbursement requests</field>
            <field name="sequence">15</field>
        </record>

        <!-- User Group -->
        <!-- Inherit account (Billing) + budget groups so disbursement users
             can read the related models the DR form relies on (account,
             tax, journal, fiscal year, bills) and read/commit budget
             (obligate on approve, reverse on cancel). Cascades to head /
             officer / manager, which imply this group. -->
        <record id="group_disbursement_user" model="res.groups">
            <field name="name">Disbursement User</field>
            <field name="category_id" ref="disbursement.module_category_disbursement"/>
            <field name="implied_ids" eval="[(6, 0, [
                ref('base.group_user'),
                ref('account.group_account_invoice'),
                ref('budget.group_budget_user'),
            ])]"/>
        </record>

        <!-- Head Group (inherits from User) -->
        <record id="group_disbursement_head" model="res.groups">
            <field name="name">Disbursement Head</field>
            <field name="category_id" ref="disbursement.module_category_disbursement"/>
            <field name="implied_ids" eval="[(4, ref('group_disbursement_user'))]"/>
        </record>

        <!-- Officer Group (inherits from Head) -->
        <record id="group_disbursement_officer" model="res.groups">
            <field name="name">Disbursement Officer</field>
            <field name="category_id" ref="disbursement.module_category_disbursement"/>
            <field name="implied_ids" eval="[(4, ref('group_disbursement_head'))]"/>
        </record>

        <!-- Manager Group (inherits from Officer) -->
        <record id="group_disbursement_manager" model="res.groups">
            <field name="name">Disbursement Manager</field>
            <field name="category_id" ref="disbursement.module_category_disbursement"/>
            <field name="implied_ids" eval="[(4, ref('group_disbursement_officer'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
