<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_disbursement" model="ir.module.category">
            <field name="name">Disbursement</field>
            <field name="description">User groups for managing disbursement requests</field>
            <field name="sequence">15</field>
        </record>

        <!-- User Group -->
        <record id="group_disbursement_user" model="res.groups">
            <field name="name">Disbursement User</field>
            <field name="category_id" ref="disbursement.module_category_disbursement"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <!-- Manager Group (inherits from User) -->
        <record id="group_disbursement_manager" model="res.groups">
            <field name="name">Disbursement Manager</field>
            <field name="category_id" ref="disbursement.module_category_disbursement"/>
            <field name="implied_ids" eval="[(4, ref('group_disbursement_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
