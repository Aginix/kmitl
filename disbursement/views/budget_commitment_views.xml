<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.commitment form -->
    <record id="view_budget_commitment_form_inherit" model="ir.ui.view">
        <field name="name">view.budget.commitment.form (disbursement)</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="disbursement_request_count" invisible="1" />
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_disbursement_requests"
                    icon="fa-file-invoice-dollar"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_request_count"
                        widget="statinfo"
                        string="Disbursement Requests"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
