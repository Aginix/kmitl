<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Sarabun form view template (ADR-0007): the standard FormView + a PDF-preview
         toggle button in the control panel and an <iframe> that replaces the form
         sheet when previewing (the sheet is hidden via CSS). -->
    <t t-name="agx_sarabun.SarabunDocumentFormView" t-inherit="web.FormView"
       t-inherit-mode="primary" owl="1">
        <!-- Toggle button — lives in the control-panel button area so it stays
             reachable in BOTH modes (the form's own button box is hidden while previewing). -->
        <xpath expr="//t[@t-set-slot='layout-buttons']" position="inside">
            <button t-if="model.root.resId" type="button"
                    class="btn btn-secondary o_sarabun_preview_toggle ms-2"
                    t-on-click.stop="() => this.toggleSarabunPreview()">
                <t t-if="showPreview">✎ แก้ไข (ฟอร์ม)</t>
                <t t-else="">📄 ดูเอกสาร (PDF)</t>
            </button>
        </xpath>
        <!-- PDF preview iframe, rendered only while previewing. Pinned to the main
             content Renderer (archInfo="archInfo"), not the dialog-footer one. -->
        <xpath expr="//t[@t-component='props.Renderer'][@archInfo='archInfo']" position="after">
            <iframe t-if="showPreview" class="o_sarabun_pdf_preview"
                    t-att-src="sarabunPreviewUrl" title="Sarabun PDF Preview"/>
        </xpath>
    </t>

</templates>
