<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="agx_sarabun.SarabunSystray" owl="1">
        <Dropdown
            position="'bottom-end'"
            onStateChanged="(state) => this.onDropdownToggle(state.open)"
        >
            <t t-set-slot="toggler">
                <span class="o_sarabun_systray_dropdown_toggle">
                    <i class="fa fa-file-text-o" role="img" aria-label="Sarabun" title="Sarabun Documents"/>
                    <t t-if="state.totalCount > 0">
                        <span class="o_notification_counter badge rounded-pill" t-esc="state.totalCount"/>
                    </t>
                </span>
            </t>
            <div class="o_sarabun_systray_dropdown" style="min-width: 320px;">
                <div class="o_sarabun_systray_header d-flex align-items-center px-3 py-2 border-bottom">
                    <span class="fw-bold">Sarabun Inbox</span>
                    <span class="ms-auto badge rounded-pill bg-primary" t-if="state.totalCount > 0" t-esc="state.totalCount"/>
                </div>
                <t t-if="state.documents.length === 0">
                    <div class="o_sarabun_systray_empty text-muted text-center py-4">
                        <i class="fa fa-check-circle fa-2x mb-2 d-block"/>
                        <span>No documents to review</span>
                    </div>
                </t>
                <t t-else="">
                    <div class="o_sarabun_systray_items" style="max-height: 350px; overflow-y: auto;">
                        <t t-foreach="state.documents" t-as="doc" t-key="doc.id">
                            <DropdownItem
                                onSelected="() => this.onDocumentClick(doc)"
                                class="'o_sarabun_systray_item px-3 py-2'"
                            >
                                <div class="d-flex align-items-start">
                                    <i class="fa fa-file-text-o me-2 mt-1 text-muted"/>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-truncate" t-esc="doc.subject or 'No Subject'"/>
                                        <div class="small text-muted d-flex">
                                            <span t-esc="doc.name"/>
                                            <span class="mx-1">•</span>
                                            <span t-esc="doc.date"/>
                                        </div>
                                        <div class="small text-muted text-truncate" t-if="doc.document_type" t-esc="doc.document_type"/>
                                    </div>
                                </div>
                            </DropdownItem>
                        </t>
                    </div>
                    <div class="border-top px-3 py-2 text-center">
                        <a href="#" class="text-primary" t-on-click.prevent="onViewAllClick">
                            <i class="fa fa-inbox me-1"/>View All
                        </a>
                    </div>
                </t>
            </div>
        </Dropdown>
    </t>

</templates>
