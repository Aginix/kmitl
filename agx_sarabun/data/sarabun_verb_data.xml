<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Built-in routing verbs (ADR-0008). noupdate so admin relabels survive
         upgrades; the engine references these by xmlid and by the three behaviour
         flags: gating (คุมคิว) / show_signature (แสดงลายเซ็น) / is_signature
         (ลายเซ็นเชิงอำนาจ — closes the recall window). Invariant: is_signature ⇒
         show_signature. -->
    <data noupdate="1">
        <!-- ผู้จัดทำที่ลงนาม — the drafter signs at send. show_signature so it renders
             in the signature block; NOT is_signature (an originator signature is not an
             approval, so the engine excludes it from has_signed / strongest_verb —
             recall stays open); NOT gating (auto-completed at send). -->
        <record id="verb_originate" model="sarabun.verb">
            <field name="name">ลงนามผู้จัดทำ (เจ้าของเรื่อง)</field>
            <field name="sequence">5</field>
            <field name="rank">1</field>
            <field name="gating" eval="False"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- ผู้จัดทำที่ไม่ลงนาม — a เจ้าหน้าที่ธุรการ/งานสารบรรณ who ร่าง but does not
             sign (leaving the หัวหน้าส่วนงาน to ตรวจสอบ + ลงนามส่งออก). Name in the
             Route, no signature on the letter. -->
        <record id="verb_prepare" model="sarabun.verb">
            <field name="name">จัดทำ/ร่าง (ไม่ลงนาม)</field>
            <field name="sequence">6</field>
            <field name="rank">1</field>
            <field name="gating" eval="False"/>
            <field name="show_signature" eval="False"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- UAT verb catalogue (ADR-0008 / CONTEXT §Step verbs). The earlier
             behaviour-derived 6 were replaced 6→8 on UAT feedback: the labels are the
             human instruction the actor reads, so distinct instructions earn distinct
             records even when the three axes coincide. Load-bearing xmlids/flags are
             preserved (verb_acknowledge / verb_verify / verb_endorse / verb_sign_approve
             — the engine defaults and 60+ tests reference them); verb_consider /
             verb_forward are re-labelled + re-flagged; the old ส่งต่อ (Forward) is
             dropped (verb_forward is repurposed to ตรวจสอบและลงนามกำกับ). -->

        <!-- รับทราบ (read-only) — for information; no gate, no signature. -->
        <record id="verb_acknowledge" model="sarabun.verb">
            <field name="name">รับทราบ/ถือปฏิบัติ/จัดเก็บเข้าแฟ้ม (อ่านอย่างเดียว)</field>
            <field name="sequence">10</field>
            <field name="rank">1</field>
            <field name="gating" eval="False"/>
            <field name="show_signature" eval="False"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- รับทราบและลงนาม — an acknowledgement that also puts a signature on the
             letter; still non-gating (never blocks the chain). -->
        <record id="verb_acknowledge_sign" model="sarabun.verb">
            <field name="name">รับทราบและลงนาม</field>
            <field name="sequence">11</field>
            <field name="rank">1</field>
            <field name="gating" eval="False"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- ตรวจเอกสาร — an intermediate actor must check before the หนังสือ moves on,
             but carries no signature (name in the Route only). Gating. -->
        <record id="verb_verify" model="sarabun.verb">
            <field name="name">ตรวจเอกสาร</field>
            <field name="sequence">15</field>
            <field name="rank">2</field>
            <field name="gating" eval="True"/>
            <field name="show_signature" eval="False"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- ผ่านเรื่อง / กลั่นกรอง — a screening gate the matter must pass; the screener
             signs (ลงนามกำกับ). Gating + show_signature; not the authoritative sign. -->
        <record id="verb_consider" model="sarabun.verb">
            <field name="name">ผ่านเรื่อง/กลั่นกรอง</field>
            <field name="sequence">16</field>
            <field name="rank">2</field>
            <field name="gating" eval="True"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- ตรวจสอบและลงนามกำกับ — verify and countersign. Gating + show_signature;
             not the authoritative sign (does not close recall). -->
        <record id="verb_forward" model="sarabun.verb">
            <field name="name">ตรวจสอบและลงนามกำกับ</field>
            <field name="sequence">17</field>
            <field name="rank">2</field>
            <field name="gating" eval="True"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- พิจารณา / ให้ความเห็นและลงนามกำกับ — give an opinion and countersign, passing
             upward. Gating + show_signature; may also ตีกลับ / ปฏิเสธ; not the
             authoritative sign (does not close recall). -->
        <record id="verb_endorse" model="sarabun.verb">
            <field name="name">พิจารณา/ให้ความเห็นและลงนามกำกับ</field>
            <field name="sequence">20</field>
            <field name="rank">2</field>
            <field name="gating" eval="True"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="False"/>
        </record>

        <!-- ลงนามในใบปะหน้า / เอกสารเพื่อลงนาม — the authoritative signature that issues
             the หนังสือ (ส่งออก), in the step's Position capacity. Gating + show_signature
             + is_signature (closes the recall window). -->
        <record id="verb_sign_approve" model="sarabun.verb">
            <field name="name">ลงนามในใบปะหน้า/เอกสารเพื่อลงนาม</field>
            <field name="sequence">30</field>
            <field name="rank">3</field>
            <field name="gating" eval="True"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="True"/>
        </record>

        <!-- อนุมัติ / อนุญาต / เห็นชอบและลงนามกำกับ — an approving authority's decision and
             signature. Also authoritative (is_signature); a หนังสือ may have more than one
             authoritative sign, the first to occur closes ดึงกลับ / ยกเลิก. -->
        <record id="verb_approve" model="sarabun.verb">
            <field name="name">อนุมัติ/อนุญาต/เห็นชอบและลงนามกำกับ</field>
            <field name="sequence">31</field>
            <field name="rank">3</field>
            <field name="gating" eval="True"/>
            <field name="show_signature" eval="True"/>
            <field name="is_signature" eval="True"/>
        </record>
    </data>
</odoo>
