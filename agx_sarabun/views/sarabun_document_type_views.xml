<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sarabun_document_type_tree" model="ir.ui.view">
        <field name="name">sarabun.document.type.tree</field>
        <field name="model">sarabun.document.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_sarabun_document_type_form" model="ir.ui.view">
        <field name="name">sarabun.document.type.form</field>
        <field name="model">sarabun.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. บันทึกข้อความกองคลัง"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="sequence"/>
                            <field name="origin_model_id" options="{'no_create': True}"
                                   attrs="{'invisible': [('kind', '!=', 'from_record')]}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Bindings">
                        <div colspan="2" class="text-muted">
                            Register sequence (P3), default seed route (P2) and report
                            template (P5) bindings are added in their phases.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sarabun_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">sarabun.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
