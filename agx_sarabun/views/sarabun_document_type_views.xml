<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="sarabun_document_type_view_tree" model="ir.ui.view">
        <field name="name">sarabun.document.type.view.tree</field>
        <field name="model">sarabun.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="sequence_id"/>
                <field name="default_route_template_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="sarabun_document_type_view_form" model="ir.ui.view">
        <field name="name">sarabun.document.type.view.form</field>
        <field name="model">sarabun.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Internal Memo"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence_id"/>
                            <field name="default_route_template_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description of this document type..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sarabun_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">sarabun.document.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a document type
            </p>
        </field>
    </record>
</odoo>
