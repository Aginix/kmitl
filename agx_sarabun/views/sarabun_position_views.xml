<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sarabun_position_tree" model="ir.ui.view">
        <field name="name">sarabun.position.tree</field>
        <field name="model">sarabun.position</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="holder_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_sarabun_position_form" model="ir.ui.view">
        <field name="name">sarabun.position.form</field>
        <field name="model">sarabun.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. คณบดีคณะวิศวกรรมศาสตร์"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <separator string="ผู้ดำรงตำแหน่ง (Current Holders)"/>
                    <field name="holder_ids">
                        <tree>
                            <field name="name"/>
                            <field name="work_email"/>
                            <field name="department_id"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sarabun_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">sarabun.position</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
