<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sarabun_position_tree" model="ir.ui.view">
        <field name="name">sarabun.position.tree</field>
        <field name="model">sarabun.position</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="holder_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_sarabun_position_form" model="ir.ui.view">
        <field name="name">sarabun.position.form</field>
        <field name="model">sarabun.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. คณบดีคณะวิศวกรรมศาสตร์"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="department_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Current Holders" help="Whoever holds this post acts/signs in its capacity. Multi-holder = first-to-act. Interim รักษาการ: add the acting user here temporarily.">
                        <field name="holder_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sarabun_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">sarabun.position</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
