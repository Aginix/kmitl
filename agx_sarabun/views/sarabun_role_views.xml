<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="sarabun_role_view_tree" model="ir.ui.view">
        <field name="name">sarabun.role.view.tree</field>
        <field name="model">sarabun.role</field>
        <field name="arch" type="xml">
            <tree string="Roles">
                <field name="sequence" widget="handle"/>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="role_category"/>
                <field name="role_type"/>
                <field name="user_ids" widget="many2many_tags" attrs="{'invisible': [('role_type', '!=', 'static')]}"/>
                <field name="dynamic_method" attrs="{'invisible': [('role_type', '!=', 'dynamic')]}"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="sarabun_role_view_form" model="ir.ui.view">
        <field name="name">sarabun.role.view.form</field>
        <field name="model">sarabun.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., อธิการบดี"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="role_category" widget="radio"/>
                        </group>
                        <group>
                            <field name="role_type" widget="radio"/>
                        </group>
                    </group>
                    <group name="static_role_settings" string="Static Role Settings" attrs="{'invisible': [('role_type', '!=', 'static')]}">
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                    <group name="dynamic_role_settings" string="Dynamic Role Settings" attrs="{'invisible': [('role_type', '!=', 'dynamic')]}">
                        <field name="dynamic_method"/>
                    </group>
                    <group name="department_scope" string="Department Scope">
                        <field name="department_ids" widget="many2many_tags" colspan="2" nolabel="1"/>
                        <span class="text-muted" colspan="2">Leave empty to make this role available for all departments.</span>
                    </group>
                    <group>
                        <field name="description" placeholder="Description of this role..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="sarabun_role_view_search" model="ir.ui.view">
        <field name="name">sarabun.role.view.search</field>
        <field name="model">sarabun.role</field>
        <field name="arch" type="xml">
            <search string="Roles">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Executive" name="executive" domain="[('role_category', '=', 'executive')]"/>
                <filter string="Academic" name="academic" domain="[('role_category', '=', 'academic')]"/>
                <separator/>
                <filter string="Static" name="static" domain="[('role_type', '=', 'static')]"/>
                <filter string="Dynamic" name="dynamic" domain="[('role_type', '=', 'dynamic')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'role_category'}"/>
                    <filter string="Role Type" name="group_type" context="{'group_by': 'role_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sarabun_role" model="ir.actions.act_window">
        <field name="name">Roles/Positions</field>
        <field name="res_model">sarabun.role</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first role/position
            </p>
            <p>
                Roles define organizational positions that can be used in document routing.
                Examples: อธิการบดี, รองอธิการบดี, คณบดี, หัวหน้าภาควิชา
            </p>
        </field>
    </record>
</odoo>
