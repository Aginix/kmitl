<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View (Default) -->
    <record id="sarabun_document_view_tree" model="ir.ui.view">
        <field name="name">sarabun.document.view.tree</field>
        <field name="model">sarabun.document</field>
        <field name="arch" type="xml">
            <tree string="Documents" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="document_type_id"/>
                <field name="subject"/>
                <field name="sender_display" string="From"/>
                <field name="recipient" string="To"/>
                <field name="urgency" optional="hide"/>
                <field name="routing_progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Tree View for Incoming Documents (กล่องขาเข้า) -->
    <record id="sarabun_document_view_tree_incoming" model="ir.ui.view">
        <field name="name">sarabun.document.view.tree.incoming</field>
        <field name="model">sarabun.document</field>
        <field name="arch" type="xml">
            <tree string="Incoming Documents" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="document_type_id"/>
                <field name="subject"/>
                <field name="sender_display" string="From"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="urgency" optional="hide"/>
                <field name="routing_progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Tree View for Outgoing Documents (กล่องขาออก) -->
    <record id="sarabun_document_view_tree_outgoing" model="ir.ui.view">
        <field name="name">sarabun.document.view.tree.outgoing</field>
        <field name="model">sarabun.document</field>
        <field name="arch" type="xml">
            <tree string="Outgoing Documents" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="document_type_id"/>
                <field name="subject"/>
                <field name="recipient" string="To"/>
                <field name="urgency" optional="hide"/>
                <field name="routing_progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="sarabun_document_view_form" model="ir.ui.view">
        <field name="name">sarabun.document.view.form</field>
        <field name="model">sarabun.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_send" string="Send" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_origin" type="object" class="oe_stat_button" icon="fa-link" attrs="{'invisible': [('origin_model', '=', False)]}">
                            <field name="origin_reference" widget="statinfo" string="Origin"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-paperclip" name="%(base.action_attachment)d" type="action" context="{'default_res_model': 'sarabun.document', 'default_res_id': id}">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title" invisible="1">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Document Form Layout (like บันทึกข้อความ) -->
                    <group>
                        <group>
                            <field name="document_type_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="urgency" widget="selection" />
                            <field name="secrecy" widget="selection" />
                        </group>
                    </group>

                    <group string="Document Information">
                        <!-- Sender Department (ต้นทาง) -->
                        <label for="sender_department_id" string="From (ต้นทาง)"/>
                        <div class="o_row">
                            <field name="sender_department_id" options="{'no_create': True}" style="width: 60%;"/>
                            <field name="sender_suffix" placeholder="หน่วยงานย่อย/เบอร์ต่อ" style="width: 35%;"/>
                        </div>
                        <field name="sender_department_name" invisible="1"/>
                        <field name="sender_display" invisible="1"/>

                        <!-- Document Sequence -->
                        <label for="document_sequence_id" string="Specify Document No."/>
                        <div class="o_row">
                            <field name="document_sequence_id" class="oe_inline" options="{'no_create': True}" domain="['|', ('department_ids', '=', False), ('department_ids', 'in', [sender_department_id])]"/>
                            <button name="action_select_number" string="Select" type="object" class="btn-link" icon="fa-list-ol" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('document_sequence_id', '=', False)]}"/>
                        </div>

                        <!-- Document Number -->
                        <label for="name" string="Document No."/>
                        <div class="o_row">
                            <field name="name" class="oe_inline" readonly="1"/>
                            <label for="date" string="Date"/>
                            <field name="date"/>
                        </div>

                        <field name="subject" placeholder="Enter subject..."/>

                        <!-- Recipient (ปลายทาง) -->
                        <label for="recipient" string="To (เรียน)"/>
                        <div class="o_row">
                            <field name="recipient" placeholder="Enter recipient name/department..." style="width: 80%;"/>
                            <button name="action_lookup_recipient" string="Lookup" type="object" class="btn-link" icon="fa-search" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        </div>
                    </group>

                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" placeholder="Enter document content..."/>
                        </page>

                        <page string="Routing" name="routing">
                            <group>
                                <field name="route_template_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <!-- Route Definition (editable in draft) -->
                            <field name="routing_line_ids" attrs="{'invisible': [('state', '!=', 'draft')]}">
                                <tree string="Routing" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="routing_type"/>
                                    <field name="recipient_type"/>
                                    <field name="user_id" attrs="{'invisible': [('recipient_type', '!=', 'user')], 'required': [('recipient_type', '=', 'user')]}"/>
                                    <field name="department_text" attrs="{'invisible': [('recipient_type', '!=', 'department')]}"/>
                                    <field name="department_id" attrs="{'invisible': [('recipient_type', '!=', 'department')]}" optional="hide" string="Route To (System)"/>
                                    <field name="role_id" attrs="{'invisible': [('recipient_type', '!=', 'role')], 'required': [('recipient_type', '=', 'role')]}"/>
                                </tree>
                            </field>
                            <!-- Recipients Status (readonly after sent) -->
                            <field name="recipient_ids" attrs="{'invisible': [('state', '=', 'draft')]}" readonly="1">
                                <tree string="Recipients" decoration-muted="state == 'waiting'" decoration-info="state == 'pending'" decoration-success="state in ('acknowledged', 'approved')" decoration-danger="state == 'rejected'">
                                    <field name="sequence" string="#"/>
                                    <field name="routing_type"/>
                                    <field name="recipient_name" string="Recipient"/>
                                    <field name="state" widget="badge"/>
                                    <field name="sent_date" optional="show"/>
                                    <field name="read_date" optional="hide"/>
                                    <field name="actioned_date" optional="show"/>
                                    <field name="signed_as_text" optional="show"/>
                                    <field name="actioned_by" optional="hide"/>
                                    <field name="comment" optional="hide"/>
                                </tree>
                            </field>
                            <group attrs="{'invisible': [('state', '!=', 'sent')]}">
                                <field name="routing_progress" widget="progressbar"/>
                            </group>
                        </page>

                        <page string="References" name="references">
                            <span />
                            <group string="Referenced Documents">
                                <field name="referenced_document_ids" colspan="2" nolabel="1" attrs="{'readonly': [('state', 'not in', ['draft'])]}">
                                    <tree>
                                        <field name="name"/>
                                        <field name="subject"/>
                                        <field name="date"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Other References">
                                <field name="reference_ids" colspan="2" nolabel="1" attrs="{'readonly': [('state', 'not in', ['draft'])]}">
                                    <tree editable="bottom">
                                        <field name="res_model"/>
                                        <field name="res_id"/>
                                        <field name="res_name"/>
                                        <button name="action_view_reference" type="object" icon="fa-external-link" title="View Reference"/>
                                    </tree>
                                </field>
                            </group>
                        </page>

                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" attrs="{'readonly': [('state', 'not in', ['draft'])]}"/>
                        </page>

                        <page string="Other Information" name="other_informations">
                            <group>
                                <group>
                                    <field name="sender_user_id" readonly="1"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                    <!-- Hidden fields -->
                    <field name="origin_model" invisible="1"/>
                    <field name="origin_res_id" invisible="1"/>
                    <field name="document_type_code" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <!-- <field name="activity_ids" widget="mail_activity" /> -->
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="sarabun_document_view_search" model="ir.ui.view">
        <field name="name">sarabun.document.view.search</field>
        <field name="model">sarabun.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name"/>
                <field name="subject"/>
                <field name="sender_display" string="Sender"/>
                <field name="sender_department_id"/>
                <field name="recipient"/>
                <field name="document_type_id"/>
                <separator/>
                <filter string="My Documents" name="my_documents" domain="[('sender_user_id', '=', uid)]"/>
                <filter string="To Me" name="to_me" domain="[('recipient_ids.user_id', '=', uid)]"/>
                <filter string="Pending Action" name="pending_action" domain="[('recipient_ids.user_id', '=', uid), ('recipient_ids.state', '=', 'pending')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('urgency', 'in', ['urgent', 'very_urgent', 'immediate'])]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Document Type" name="group_type" context="{'group_by': 'document_type_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Sender Department" name="group_sender" context="{'group_by': 'sender_department_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="sarabun_document_view_kanban" model="ir.ui.view">
        <field name="name">sarabun.document.view.kanban</field>
        <field name="model">sarabun.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="subject"/>
                <field name="sender_display"/>
                <field name="recipient"/>
                <field name="sender_user_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="urgency"/>
                <field name="routing_progress"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span t-if="record.urgency.raw_value != 'normal'" class="badge badge-warning">
                                        <field name="urgency"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="subject"/>
                                    <div class="text-muted small">
                                        <span>From: </span><field name="sender_display"/>
                                    </div>
                                    <div class="text-muted small" t-if="record.recipient.raw_value">
                                        <span>To: </span><field name="recipient"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="sender_user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom" t-if="record.state.raw_value == 'sent'">
                                    <field name="routing_progress" widget="progressbar"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_sarabun_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">sarabun.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_my_documents': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document
            </p>
            <p>
                Start by creating an internal memo or circular to send to colleagues.
            </p>
        </field>
    </record>

    <record id="action_sarabun_document_inbox" model="ir.actions.act_window">
        <field name="name">Inbox</field>
        <field name="res_model">sarabun.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('recipient_ids.user_id', '=', uid), ('recipient_ids.state', '=', 'pending')]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('sarabun_document_view_tree_incoming')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sarabun_document_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sarabun_document_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending documents
            </p>
            <p>
                Documents requiring your action will appear here.
            </p>
        </field>
    </record>

    <!-- Outgoing Documents (ขาออก) - Documents I sent -->
    <record id="action_sarabun_document_outgoing" model="ir.actions.act_window">
        <field name="name">Outgoing Documents</field>
        <field name="res_model">sarabun.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('sender_user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('sarabun_document_view_tree_outgoing')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sarabun_document_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sarabun_document_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first outgoing document
            </p>
            <p>
                Documents you create and send will appear here.
            </p>
        </field>
    </record>

    <!-- Incoming Documents (ขาเข้า) - Documents sent to me -->
    <record id="action_sarabun_document_incoming" model="ir.actions.act_window">
        <field name="name">Incoming Documents</field>
        <field name="res_model">sarabun.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('routing_line_ids.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('sarabun_document_view_tree_incoming')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sarabun_document_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sarabun_document_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                No incoming documents
            </p>
            <p>
                Documents sent to you will appear here.
            </p>
        </field>
    </record>
</odoo>
