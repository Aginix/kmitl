<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Inbox -->
    <record id="sarabun_document_recipient_view_tree" model="ir.ui.view">
        <field name="name">sarabun.document.recipient.view.tree</field>
        <field name="model">sarabun.document.recipient</field>
        <field name="arch" type="xml">
            <tree string="My Pending Documents" decoration-info="state == 'new'" decoration-success="state in ('acknowledged', 'approved')" decoration-danger="state == 'rejected'">
                <field name="document_id"/>
                <field name="document_subject"/>
                <field name="routing_type"/>
                <field name="recipient_name"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state in ('acknowledged', 'approved')" decoration-danger="state == 'rejected'"/>
                <field name="create_date" string="Sent Date"/>
                <field name="read_date" optional="show"/>
                <field name="signed_as_text" optional="show"/>
                <field name="actioned_date" optional="hide"/>
                <button name="action_acknowledge" string="Acknowledge" type="object" icon="fa-check" attrs="{'invisible': ['|', ('state', '!=', 'new'), ('routing_type', '=', 'approve')]}"/>
                <button name="action_approve" string="Approve" type="object" icon="fa-thumbs-up" class="text-success" attrs="{'invisible': ['|', ('state', '!=', 'new'), ('routing_type', '!=', 'approve')]}"/>
                <button name="action_reject" string="Reject" type="object" icon="fa-thumbs-down" class="text-danger" attrs="{'invisible': [('state', '!=', 'new')]}"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="sarabun_document_recipient_view_form" model="ir.ui.view">
        <field name="name">sarabun.document.recipient.view.form</field>
        <field name="model">sarabun.document.recipient</field>
        <field name="arch" type="xml">
            <form string="Document Recipient">
                <header>
                    <button name="action_acknowledge" string="Acknowledge" type="object" class="btn-primary" attrs="{'invisible': ['|', ('state', '!=', 'new'), ('routing_type', '=', 'approve')]}"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" attrs="{'invisible': ['|', ('state', '!=', 'new'), ('routing_type', '!=', 'approve')]}"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" attrs="{'invisible': [('state', '!=', 'new')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="document_id" readonly="1"/>
                            <field name="document_subject" readonly="1"/>
                            <field name="routing_type" readonly="1"/>
                            <field name="recipient_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" string="Sent Date" readonly="1"/>
                            <field name="read_date" readonly="1"/>
                            <field name="actioned_date" readonly="1"/>
                            <field name="actioned_by" readonly="1"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('signed_as_text', '=', False)]}">
                        <field name="signed_as_text" readonly="1"/>
                    </group>
                    <group attrs="{'invisible': [('comment', '=', False)]}">
                        <field name="comment" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="sarabun_document_recipient_view_search" model="ir.ui.view">
        <field name="name">sarabun.document.recipient.view.search</field>
        <field name="model">sarabun.document.recipient</field>
        <field name="arch" type="xml">
            <search string="Recipients">
                <field name="document_id"/>
                <field name="document_subject"/>
                <separator/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="Acknowledged" name="acknowledged" domain="[('state', '=', 'acknowledged')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Unread" name="unread" domain="[('read_date', '=', False), ('state', '=', 'new')]"/>
                <filter string="Read" name="read" domain="[('read_date', '!=', False)]"/>
                <separator/>
                <filter string="For Acknowledgement" name="acknowledge" domain="[('routing_type', '=', 'acknowledge')]"/>
                <filter string="For Approval" name="approve" domain="[('routing_type', '=', 'approve')]"/>
                <separator/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'routing_type'}"/>
                    <filter string="Document" name="group_document" context="{'group_by': 'document_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Inbox (My Pending) -->
    <record id="action_sarabun_recipient_inbox" model="ir.actions.act_window">
        <field name="name">Inbox</field>
        <field name="res_model">sarabun.document.recipient</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'new')]</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending documents
            </p>
            <p>
                Documents requiring your action will appear here.
            </p>
        </field>
    </record>
</odoo>
