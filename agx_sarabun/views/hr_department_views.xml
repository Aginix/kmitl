<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit hr.department form to add sarabun_officer_ids -->
    <record id="hr_department_view_form_inherit_sarabun" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.sarabun</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="sarabun_officer_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="use_central_correspondence"/>
            </xpath>
        </field>
    </record>
</odoo>
