<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sarabun Document Portal List -->
    <template id="portal_my_home_sarabun_document" name="Portal My Home: Sarabun Document" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Sarabun Documents</t>
                <t t-set="url" t-value="'/my/sarabun_documents'"/>
                <t t-set="placeholder_count" t-value="'sarabun_document_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Sarabun Document List View -->
    <template id="portal_my_sarabun_documents" name="My Documents">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Documents</t>
            </t>

            <t t-if="not sarabun_documents">
                <div class="alert alert-warning mt-3" role="alert">
                    There are no documents.
                </div>
            </t>

            <t t-if="sarabun_documents" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Subject</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="values" t-as="doc">
                        <tr>
                            <td>
                                <a t-att-href="doc.get_portal_url()">
                                    <t t-esc="doc.name"/>
                                </a>
                            </td>
                            <td><t t-esc="doc.subject"/></td>
                            <td><span t-field="doc.date"/></td>
                            <td><span t-field="doc.state" class="badge badge-pill"/></td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Sarabun Document Detail Page with iframe -->
    <template id="portal_sarabun_document_page" name="Portal Document Page" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/web#model=sarabun.document&amp;id=%s&amp;view_type=form' % (sarabun_document.id)"/>
                </t>
            </t>

            <div class="row mt16 o_portal_sarabun_document_sidebar">
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-auto d-print-none'"/>
                    <t t-set="title">
                        <h2 class="mb-0"><t t-esc="sarabun_document.name"/></h2>
                        <div class="small text-muted"><t t-esc="sarabun_document.subject"/></div>
                    </t>

                    <t t-set="entries">
                        <ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column">
                            <li class="list-group-item flex-grow-1">
                                <div class="o_download_pdf btn-toolbar flex-sm-nowrap">
                                    <div class="btn-group flex-grow-1 me-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_download_btn" t-att-href="sarabun_document.get_portal_url(report_type='pdf', download=True)">
                                            <i class="fa fa-download"/> Download
                                        </a>
                                    </div>
                                    <div class="btn-group flex-grow-1 mb-1">
                                        <a class="btn btn-secondary btn-block o_print_btn" t-att-href="sarabun_document.get_portal_url(report_type='pdf')" target="_blank">
                                            <i class="fa fa-print"/> Print
                                        </a>
                                    </div>
                                </div>
                            </li>
                            <li class="list-group-item flex-grow-1">
                                <div class="small text-muted mb-1">From</div>
                                <div class="fw-bold"><t t-esc="sarabun_document.sender_display"/></div>
                            </li>
                            <li class="list-group-item flex-grow-1">
                                <div class="small text-muted mb-1">To</div>
                                <div class="fw-bold"><t t-esc="sarabun_document.recipient"/></div>
                            </li>
                        </ul>
                    </t>
                </t>

                <div id="portal_sarabun_document_content" class="col-12 col-lg">
                    <div class="o_portal_html_view shadow p-3">
                        <div class="o_portal_html_loader text-center">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>
                        </div>
                        <iframe id="sarabun_document_html" class="mt8 mb8" width="100%" height="100%" frameborder="0" scrolling="no" t-att-src="sarabun_document.get_portal_url(report_type='html')"/>
                    </div>

                    <div id="sarabun_document_communication" class="mt-4">
                        <h2>History</h2>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
