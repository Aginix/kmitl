<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document Sequence Tree View -->
    <record id="sarabun_document_sequence_view_tree" model="ir.ui.view">
        <field name="name">sarabun.document.sequence.view.tree</field>
        <field name="model">sarabun.document.sequence</field>
        <field name="arch" type="xml">
            <tree string="Document Sequences">
                <field name="name"/>
                <field name="code"/>
                <field name="prefix"/>
                <field name="is_shared"/>
                <field name="next_number"/>
                <field name="reserved_count"/>
                <field name="used_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Document Sequence Form View -->
    <record id="sarabun_document_sequence_view_form" model="ir.ui.view">
        <field name="name">sarabun.document.sequence.view.form</field>
        <field name="model">sarabun.document.sequence</field>
        <field name="arch" type="xml">
            <form string="Document Sequence">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list-ol" name="action_view_numbers" type="object">
                            <field name="used_count" widget="statinfo" string="Used"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-bookmark" name="action_view_reserved" type="object">
                            <field name="reserved_count" widget="statinfo" string="Reserved"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Sequence Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="configuration" string="Configuration">
                            <field name="code"/>
                            <field name="prefix" placeholder="e.g., สจล./"/>
                            <field name="suffix"/>
                            <field name="padding"/>
                            <field name="reset_period"/>
                            <field name="current_year"/>
                        </group>
                        <group name="statistics" string="Statistics">
                            <field name="next_number"/>
                            <field name="is_shared"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Department Access" name="departments">
                            <group>
                                <field name="department_ids" widget="many2many_tags" options="{'no_create': True}" nolabel="1"/>
                            </group>
                            <p class="text-muted">
                                Leave empty to allow all departments to use this sequence.
                            </p>
                        </page>
                        <page string="Document Types" name="document_types">
                            <group>
                                <field name="document_type_ids" widget="many2many_tags" options="{'no_create': True}" nolabel="1"/>
                            </group>
                            <p class="text-muted">
                                Leave empty to allow all document types.
                            </p>
                        </page>
                        <page string="Numbers" name="numbers">
                            <field name="number_ids">
                                <tree string="Numbers" decoration-info="state == 'reserved'" decoration-success="state == 'used'" decoration-muted="state == 'cancelled'">
                                    <field name="number"/>
                                    <field name="year"/>
                                    <field name="formatted_number"/>
                                    <field name="state" widget="badge" decoration-info="state == 'reserved'" decoration-success="state == 'used'" decoration-danger="state == 'cancelled'"/>
                                    <field name="reserved_by_id" optional="show"/>
                                    <field name="reserved_date" optional="hide"/>
                                    <field name="document_id" optional="show"/>
                                    <field name="used_date" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document Sequence Search View -->
    <record id="sarabun_document_sequence_view_search" model="ir.ui.view">
        <field name="name">sarabun.document.sequence.view.search</field>
        <field name="model">sarabun.document.sequence</field>
        <field name="arch" type="xml">
            <search string="Document Sequences">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Shared" name="shared" domain="[('is_shared', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Document Number Tree View -->
    <record id="sarabun_document_number_view_tree" model="ir.ui.view">
        <field name="name">sarabun.document.number.view.tree</field>
        <field name="model">sarabun.document.number</field>
        <field name="arch" type="xml">
            <tree string="Document Numbers" decoration-info="state == 'reserved'" decoration-success="state == 'used'" decoration-muted="state == 'cancelled'">
                <field name="sequence_id"/>
                <field name="number"/>
                <field name="year"/>
                <field name="formatted_number"/>
                <field name="state" widget="badge" decoration-info="state == 'reserved'" decoration-success="state == 'used'" decoration-danger="state == 'cancelled'"/>
                <field name="reserved_by_id"/>
                <field name="document_id"/>
            </tree>
        </field>
    </record>

    <!-- Document Number Form View -->
    <record id="sarabun_document_number_view_form" model="ir.ui.view">
        <field name="name">sarabun.document.number.view.form</field>
        <field name="model">sarabun.document.number</field>
        <field name="arch" type="xml">
            <form string="Document Number">
                <header>
                    <button name="action_cancel_reservation" string="Cancel Reservation" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'reserved')]}"/>
                </header>
                <sheet>
                    <group>
                        <group name="number_info" string="Number Info">
                            <field name="sequence_id"/>
                            <field name="number"/>
                            <field name="year"/>
                            <field name="formatted_number"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group name="reservation" string="Reservation">
                            <field name="reserved_by_id"/>
                            <field name="reserved_date"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <group name="usage" string="Usage" attrs="{'invisible': [('state', '!=', 'used')]}">
                        <field name="document_id"/>
                        <field name="used_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Document Number Search View -->
    <record id="sarabun_document_number_view_search" model="ir.ui.view">
        <field name="name">sarabun.document.number.view.search</field>
        <field name="model">sarabun.document.number</field>
        <field name="arch" type="xml">
            <search string="Document Numbers">
                <field name="sequence_id"/>
                <field name="number"/>
                <field name="document_id"/>
                <separator/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Used" name="used" domain="[('state', '=', 'used')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Current Year" name="current_year" domain="[('year', '=', context_today().year)]"/>
                <separator/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Sequence" name="group_sequence" context="{'group_by': 'sequence_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_sarabun_document_sequence" model="ir.actions.act_window">
        <field name="name">Document Sequences</field>
        <field name="res_model">sarabun.document.sequence</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document sequence
            </p>
            <p>
                Document sequences are used to generate document numbers automatically.
                You can configure different sequences for different departments.
            </p>
        </field>
    </record>

    <record id="action_sarabun_document_number" model="ir.actions.act_window">
        <field name="name">Document Numbers</field>
        <field name="res_model">sarabun.document.number</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No document numbers yet
            </p>
            <p>
                Numbers are created when documents are sent or when numbers are reserved.
            </p>
        </field>
    </record>
</odoo>
