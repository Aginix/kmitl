<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Endorsement block (บล็อกลายเซ็น) — ADR-0007, amended by ADR-0008.
         A reusable layout the SOURCE report t-calls at its own tail
         (the origin embeds sarabun's block; sarabun no longer wraps
         the origin). Also used by the no-source own report below.
         Expects `doc` (a sarabun.document) in context — self-limiting:
         renders only positive-done show_signature steps (SIGNATURES
         ONLY, no เกษียน trail), so an unsent/early document shows nothing.
         ============================================================ -->
    <template id="sarabun_endorsement_block">
        <t t-if="doc">
            <!-- ลงนาม/อนุมัติ — SIGNATURES ONLY (ADR-0008): every positive-done
                 show_signature step (signing ผู้จัดทำ + เห็นชอบ + ลงนาม-อนุมัติ). No verb
                 heading — one signature per row, right-aligned, stacked downward:
                 signature image + (ชื่อ) + ตำแหน่ง + วันที่ (พ.ศ.) + ความเห็น. Non-signing
                 verbs (ตรวจสอบ / พิจารณา / ส่งต่อ, a non-signing ผู้จัดทำ) render nothing —
                 the routing trail is audit-only. Academic prefix / time / sign method /
                 sign code stay phase-2. -->
            <div style="margin-top:24px;">
                <div t-foreach="doc._signature_block_steps()" t-as="sig"
                     style="text-align:center; width:300px; margin-left:auto; margin-bottom:20px;">
                    <!-- ชื่อ / ตำแหน่ง / ลายเซ็น read from the per-step snapshot frozen at
                         signing (ADR-0009), falling back to live master data for legacy /
                         in-flight rows — so a later HR / position / signature edit never
                         rewrites an already-signed หนังสือ. -->
                    <t t-set="sig_image" t-value="sig.signed_signature or sig.acted_by_id.employee_id.signature"/>
                    <div t-if="sig_image">
                        <img t-att-src="image_data_uri(sig_image)" style="max-height:60px;"/>
                    </div>
                    <div t-else="" style="height:60px;"/>
                    <div t-if="sig.note" style="font-size:0.9em; color:#555;">
                        <span t-out="sig.note"/>
                    </div>
                    <div>(<span t-out="sig.signed_name or sig.acted_by_id.employee_id.name or sig.acted_by_id.name"/>)</div>
                    <!-- capacity/position only (never the person name, already shown
                         above): snapshot → signed capacity → targeted Position → blank. -->
                    <div t-out="sig.signed_position_name or sig.signed_as_position_id.name or sig.position_id.name"/>
                    <div t-if="sig.acted_date"
                         t-out="doc.format_datetime_thai_sign(sig.acted_date)"/>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         Covering note (บันทึกนำ) — the optional เนื้อหา a from_record
         หนังสือ carries above its origin's report. A delegated (has-source)
         report t-calls this at the TOP of its page, mirroring how it
         t-calls the endorsement block at the tail. Expects `doc` in
         context; renders nothing unless the drafter ticked แนบเนื้อหา
         (include_content) AND wrote a body — so a plain from_record
         document adds nothing.
         ============================================================ -->
    <template id="sarabun_covering_note">
        <t t-if="doc and doc.include_content and doc.content">
            <div style="margin-bottom:12px;">
                <div t-field="doc.content"/>
            </div>
        </t>
    </template>

    <!-- ============================================================
         Standalone document report (no-source) — ADR-0007.
         For a composed หนังสือ with no source report (บันทึกข้อความ /
         หนังสือเวียน — a planned seam; every real Document today has a
         source report). Renders the official header + เนื้อหา (content)
         body + the same endorsement block. The full regulation
         บันทึกข้อความ layout (ครุฑ / ด่วน / หมายเหตุ) is still to be
         designed.
         ============================================================ -->
    <record id="action_report_sarabun_document" model="ir.actions.report">
        <field name="name">หนังสือสารบรรณ</field>
        <field name="model">sarabun.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agx_sarabun.report_sarabun_document</field>
        <field name="report_file">agx_sarabun.report_sarabun_document</field>
        <field name="paperformat_id" ref="paperformat_sarabun_a4"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_sarabun_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: 'Sarabun','THSarabunNew',sans-serif;">
                        <h3 class="text-center" style="margin-bottom:4px;">บันทึกข้อความ</h3>
                        <table style="width:100%; margin-bottom:8px;">
                            <tr>
                                <td style="width:75%;">
                                    <strong>ส่วนราชการ</strong>
                                    <span t-out="doc.sender_department_id.complete_name or doc.sender_department_id.name"/>
                                    <span t-if="doc.sender_suffix" t-out="' ' + doc.sender_suffix"/>
                                </td>
                                <td style="width:25%;">
                                    <strong>ที่</strong> <span t-field="doc.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>วันที่</strong> <span t-field="doc.date"/>
                                </td>
                            </tr>
                            <tr><td colspan="2"><strong>เรื่อง</strong> <span t-field="doc.subject"/></td></tr>
                            <tr>
                                <td colspan="2">
                                    <strong t-out="doc.addressee_prefix_id.name or 'เรียน'"/>
                                    <span t-out="doc.addressee"/>
                                </td>
                            </tr>
                        </table>

                        <!-- อ้างถึง / สิ่งที่ส่งมาด้วย -->
                        <div t-if="doc.reference_document_ids or doc.reference_line_ids" style="margin-bottom:6px;">
                            <strong>อ้างถึง</strong>
                            <ul style="margin:0;">
                                <li t-foreach="doc.reference_document_ids" t-as="r"><span t-out="r.display_name"/></li>
                                <li t-foreach="doc.reference_line_ids" t-as="rl"><span t-out="rl.text"/></li>
                            </ul>
                        </div>
                        <div t-if="doc.enclosure_attachment_ids" style="margin-bottom:6px;">
                            <strong>สิ่งที่ส่งมาด้วย</strong>
                            <ol style="margin:0;">
                                <li t-foreach="doc.enclosure_attachment_ids" t-as="e"><span t-out="e.name"/></li>
                            </ol>
                        </div>

                        <!-- เนื้อหา (body) — the composed content. -->
                        <div t-if="doc.include_content and doc.content" style="margin:8px 0;">
                            <div t-field="doc.content"/>
                        </div>

                        <!-- เกษียน trail + signature block(s) -->
                        <t t-call="agx_sarabun.sarabun_endorsement_block"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
