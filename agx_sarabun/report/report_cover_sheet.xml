<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ใบปะหน้าสารบรรณ (Cover sheet): the official header only. Merged FIRST with
         the origin's delegated report (the body); the route + signatures are a
         separate sheet appended LAST (report_sarabun_route_document). -->
    <record id="action_report_sarabun_cover" model="ir.actions.report">
        <field name="name">ใบปะหน้าสารบรรณ (Cover Sheet)</field>
        <field name="model">sarabun.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agx_sarabun.report_sarabun_cover_document</field>
        <field name="report_file">agx_sarabun.report_sarabun_cover_document</field>
        <field name="paperformat_id" ref="paperformat_sarabun_a4"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_sarabun_cover_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: 'Sarabun','THSarabunNew',sans-serif;">
                        <h3 class="text-center" style="margin-bottom:4px;">บันทึกข้อความ</h3>
                        <table style="width:100%; margin-bottom:8px;">
                            <tr>
                                <td style="width:75%;">
                                    <strong>ส่วนราชการ</strong>
                                    <span t-out="doc.sender_department_id.complete_name or doc.sender_department_id.name"/>
                                    <span t-if="doc.sender_suffix" t-out="' ' + doc.sender_suffix"/>
                                </td>
                                <td style="width:25%;">
                                    <strong>ที่</strong> <span t-field="doc.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>วันที่</strong> <span t-field="doc.date"/>
                                    <span t-if="doc.urgency != 'normal'"
                                          t-out="' [' + dict(doc._fields['urgency'].selection).get(doc.urgency) + ']'"
                                          style="color:#c00;font-weight:bold;"/>
                                    <span t-if="doc.secrecy != 'normal'"
                                          t-out="' [' + dict(doc._fields['secrecy'].selection).get(doc.secrecy) + ']'"
                                          style="color:#c00;font-weight:bold;"/>
                                </td>
                            </tr>
                            <tr><td colspan="2"><strong>เรื่อง</strong> <span t-field="doc.subject"/></td></tr>
                            <tr>
                                <td colspan="2">
                                    <strong>เรียน</strong> <span t-out="doc.addressee"/>
                                    <span t-if="doc.through" t-out="' (ผ่าน ' + doc.through + ')'"/>
                                </td>
                            </tr>
                        </table>

                        <!-- อ้างถึง / สิ่งที่ส่งมาด้วย -->
                        <div t-if="doc.reference_document_ids or doc.reference_line_ids" style="margin-bottom:6px;">
                            <strong>อ้างถึง</strong>
                            <ul style="margin:0;">
                                <li t-foreach="doc.reference_document_ids" t-as="r"><span t-out="r.display_name"/></li>
                                <li t-foreach="doc.reference_line_ids" t-as="rl"><span t-out="rl.text"/></li>
                            </ul>
                        </div>
                        <div t-if="doc.enclosure_ids" style="margin-bottom:6px;">
                            <strong>สิ่งที่ส่งมาด้วย</strong>
                            <ol style="margin:0;">
                                <li t-foreach="doc.enclosure_ids" t-as="e"><span t-out="e.description"/></li>
                            </ol>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- เส้นทางเอกสาร + ลายมือชื่อ (Route & Signatures): appended LAST to the frozen
         ฉบับลงนาม so the full path and every signer/acknowledger's signature sit at
         the end of the whole document. -->
    <record id="action_report_sarabun_route" model="ir.actions.report">
        <field name="name">เส้นทางเอกสารและลายมือชื่อ (Route &amp; Signatures)</field>
        <field name="model">sarabun.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agx_sarabun.report_sarabun_route_document</field>
        <field name="report_file">agx_sarabun.report_sarabun_route_document</field>
        <field name="paperformat_id" ref="paperformat_sarabun_a4"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_sarabun_route_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: 'Sarabun','THSarabunNew',sans-serif;">
                        <h4 class="text-center" style="margin-bottom:2px;">เส้นทางเอกสาร (Document Route)</h4>
                        <div class="text-center" style="margin-bottom:10px;">
                            <small>
                                <strong>ที่</strong> <span t-field="doc.name"/>
                                <span t-if="doc.subject" t-out="' — ' + doc.subject"/>
                            </small>
                        </div>

                        <!-- เส้นทาง: every step of the current attempt in order -->
                        <table style="width:100%; border-collapse:collapse;" class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">ขั้น</th>
                                    <th style="text-align:left;">ผู้รับ / ตำแหน่ง</th>
                                    <th style="text-align:left;">การดำเนินการ</th>
                                    <th style="text-align:center;">สถานะ</th>
                                    <th style="text-align:left;">ผู้ดำเนินการ</th>
                                    <th style="text-align:center;">วันที่</th>
                                    <th style="text-align:left;">ความเห็น (เกษียน)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.routing_step_ids.sorted('order')" t-as="step">
                                    <td style="text-align:center;" t-out="step.order"/>
                                    <td>
                                        <span t-out="step.signed_as_position_id.name or step.target_name"/>
                                        <span t-if="step.for_info"> (สำเนา)</span>
                                    </td>
                                    <td t-out="dict(step._fields['verb'].selection).get(step.verb)"/>
                                    <td style="text-align:center;" t-out="dict(step._fields['state'].selection).get(step.state)"/>
                                    <td t-out="step.acted_by_id.employee_id.name or step.acted_by_id.name or ''"/>
                                    <td style="text-align:center;">
                                        <span t-if="step.acted_date" t-field="step.acted_date"/>
                                    </td>
                                    <td t-out="step.note or ''"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ลายมือชื่อ: everyone who acted (รับทราบ / เห็นชอบ / ลงนาม-อนุมัติ) -->
                        <h4 style="margin-top:24px;">ลายมือชื่อ</h4>
                        <div t-if="not doc._acted_signature_steps()" class="text-muted">
                            <em>ยังไม่มีการลงนาม</em>
                        </div>
                        <div class="row" style="margin-top:8px;">
                            <div t-foreach="doc._acted_signature_steps()" t-as="sig" class="col-4 text-center"
                                 style="margin-bottom:20px;">
                                <div t-if="sig.acted_by_id.employee_id.signature">
                                    <img t-att-src="image_data_uri(sig.acted_by_id.employee_id.signature)"
                                         style="max-height:60px;"/>
                                </div>
                                <div t-else="" style="height:60px;"/>
                                <div>
                                    <!-- academic prefix (academic_standing_title) deferred to a later phase -->
                                    (<span t-out="sig.acted_by_id.employee_id.name or sig.acted_by_id.name"/>)
                                </div>
                                <div t-if="sig.signed_as_position_id" t-out="sig.signed_as_position_id.name"/>
                                <div t-else="" class="text-muted">
                                    <small t-out="dict(sig._fields['verb'].selection).get(sig.verb)"/>
                                </div>
                                <div t-if="sig.acted_date">
                                    <span t-out="sig.acted_date.day"/>/<span t-out="sig.acted_date.month"/>/<span
                                        t-out="sig.acted_date.year + 543"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
