<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reject Wizard Form -->
    <record id="sarabun_routing_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.routing.reject.wizard.form</field>
        <field name="model">sarabun.routing.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Document">
                <group>
                    <field name="routing_line_id" invisible="1"/>
                    <field name="comment" placeholder="Please provide the reason for rejection..." required="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Forward Wizard Form -->
    <record id="sarabun_routing_forward_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.routing.forward.wizard.form</field>
        <field name="model">sarabun.routing.forward.wizard</field>
        <field name="arch" type="xml">
            <form string="Forward Document">
                <group>
                    <field name="routing_line_id" invisible="1"/>
                    <field name="forward_type" widget="radio"/>
                </group>
                <group>
                    <field name="forward_to_user_id" attrs="{'invisible': [('forward_type', '!=', 'user')], 'required': [('forward_type', '=', 'user')]}"/>
                    <field name="forward_to_department_id" attrs="{'invisible': [('forward_type', '!=', 'department')], 'required': [('forward_type', '=', 'department')]}"/>
                </group>
                <group>
                    <field name="comment" placeholder="Optional comment..."/>
                </group>
                <footer>
                    <button name="action_forward" string="Forward" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Department Lookup Wizard Form -->
    <record id="sarabun_department_lookup_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.department.lookup.wizard.form</field>
        <field name="model">sarabun.department.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Department">
                <group>
                    <field name="department_id" options="{'no_create': True}"/>
                    <field name="target_model" invisible="1"/>
                    <field name="target_record_id" invisible="1"/>
                    <field name="target_field" invisible="1"/>
                </group>
                <footer>
                    <button name="action_select" string="Select" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Department Lookup -->
    <record id="action_sarabun_department_lookup" model="ir.actions.act_window">
        <field name="name">Select Department</field>
        <field name="res_model">sarabun.department.lookup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Number Selection Wizard Form -->
    <record id="sarabun_number_selection_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.number.selection.wizard.form</field>
        <field name="model">sarabun.number.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Document Number">
                <group>
                    <field name="document_id" invisible="1"/>
                    <field name="sequence_id" invisible="1"/>
                    <field name="selection_mode" widget="radio"/>
                </group>
                <group name="number_information" string="Number Information">
                    <field name="next_auto_number" readonly="1"/>
                </group>
                <group name="reserved_number" string="Reserved Number" attrs="{'invisible': [('selection_mode', '!=', 'reserved')]}">
                    <field name="reserved_number_id" domain="[('sequence_id', '=', sequence_id), ('state', '=', 'reserved')]" options="{'no_create': True}"/>
                </group>
                <group name="available_gap_numbers" string="Available (Gap) Numbers" attrs="{'invisible': [('selection_mode', '!=', 'available')]}">
                    <field name="selected_available_number"/>
                    <p class="text-muted">
                        Enter an available number from gaps in the sequence.
                        Numbers before the next auto number that are not used or reserved.
                    </p>
                </group>
                <group name="manual_entry" string="Manual Entry" attrs="{'invisible': [('selection_mode', '!=', 'manual')]}">
                    <field name="manual_number"/>
                    <button name="action_reserve_number" string="Reserve This Number" type="object" class="btn-link" icon="fa-bookmark"/>
                </group>
                <group name="preview" string="Preview" attrs="{'invisible': [('formatted_preview', '=', '')]}">
                    <field name="formatted_preview" readonly="1" class="oe_inline"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Number Selection -->
    <record id="action_sarabun_number_selection" model="ir.actions.act_window">
        <field name="name">Select Document Number</field>
        <field name="res_model">sarabun.number.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Recipient Reject Wizard Form -->
    <record id="sarabun_recipient_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.recipient.reject.wizard.form</field>
        <field name="model">sarabun.recipient.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Document">
                <group>
                    <field name="recipient_id" invisible="1"/>
                    <field name="comment" placeholder="Please provide the reason for rejection..." required="1"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Signing Position Wizard Form -->
    <record id="sarabun_signing_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.signing.wizard.form</field>
        <field name="model">sarabun.signing.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Signing Position">
                <group>
                    <field name="routing_line_id" invisible="1"/>
                    <field name="recipient_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>
                    <field name="available_role_ids" invisible="1"/>
                </group>
                <group name="document_information" string="Document Information">
                    <field name="document_name" readonly="1"/>
                    <field name="document_subject" readonly="1"/>
                </group>
                <group name="select_position_to_sign_as" string="Select Position to Sign As">
                    <field name="selected_role_id" widget="radio" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Signing Position -->
    <record id="action_sarabun_signing_wizard" model="ir.actions.act_window">
        <field name="name">Select Signing Position</field>
        <field name="res_model">sarabun.signing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Route Selection Wizard Form -->
    <record id="sarabun_route_selection_wizard_view_form" model="ir.ui.view">
        <field name="name">sarabun.route.selection.wizard.form</field>
        <field name="model">sarabun.route.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Route">
                <group>
                    <field name="document_id" invisible="1"/>
                    <field name="available_template_ids" invisible="1"/>
                    <field name="origin_info" readonly="1" attrs="{'invisible': [('origin_info', '=', '')]}"/>
                </group>
                <group name="available_routes" string="Available Routes">
                    <field name="selected_template_id" widget="radio" options="{'horizontal': false}" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Apply Route" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Route Selection -->
    <record id="action_sarabun_route_selection" model="ir.actions.act_window">
        <field name="name">Select Route</field>
        <field name="res_model">sarabun.route.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
