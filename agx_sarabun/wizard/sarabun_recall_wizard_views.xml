<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sarabun_recall_wizard_form" model="ir.ui.view">
        <field name="name">sarabun.recall.wizard.form</field>
        <field name="model">sarabun.recall.wizard</field>
        <field name="arch" type="xml">
            <form string="ดึงกลับ / ยกเลิกการส่ง">
                <field name="document_id" invisible="1"/>
                <group>
                    <!-- Locked by the header button (⏪ ดึงกลับแบบร่าง / 🚫 ยกเลิกการส่ง /
                         🔙 ดึงกลับ); the reason is optional only for 🔙 ดึงกลับ. -->
                    <field name="mode" invisible="1"/>
                    <field name="reason" placeholder="ระบุเหตุผล / reason..."
                           attrs="{'required': [('mode', '!=', 'take_back')]}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="ยืนยัน (Confirm)"
                            class="btn-primary"/>
                    <button string="ยกเลิก (Cancel)" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
