<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sarabun_step_act_wizard_form" model="ir.ui.view">
        <field name="name">sarabun.step.act.wizard.form</field>
        <field name="model">sarabun.step.act.wizard</field>
        <field name="arch" type="xml">
            <form string="Act on Step">
                <field name="step_id" invisible="1" />
                <field name="document_id" invisible="1" />
                <field name="is_sign" invisible="1" />
                <field name="needs_target" invisible="1" />
                <field name="is_return" invisible="1" />
                <field name="step_target_mode" invisible="1" />
                <field name="step_show_signature" invisible="1" />
                <field name="step_allow_sign_comment" invisible="1" />
                <group>
                    <field name="target_name" string="Step" readonly="1" />
                    <field name="step_verb" options="{'no_open': True}" />
                    <field name="sign_date_display" />
                    <!-- Locked by the header button that opened the wizard. -->
                    <field name="disposition" invisible="1" />
                    <!-- เหตุผลตีกลับ (plain text) — only for ตีกลับ. -->
                    <label
                        for="note"
                        string="เหตุผล"
                        attrs="{'invisible': [('disposition', '=', 'complete')]}"
                    />
                    <div
                        name="comment"
                        attrs="{'invisible': [('disposition', '=', 'complete')]}"
                    >
                        <field
                            name="note"
                            attrs="{'required': [('disposition', '!=', 'complete')]}"
                            placeholder="เหตุผล..."
                            nolabel="1"
                        />
                    </div>
                </group>
                <!-- ความเห็นในการลงนาม + files (verb.allow_sign_comment), both optional. -->
                <group
                    name="sign_comment"
                    string="ความเห็นในการลงนาม"
                    attrs="{'invisible': ['|', ('disposition', '!=', 'complete'), ('step_allow_sign_comment', '=', False)]}"
                >
                    <div name="sign_comment_box" colspan="2">
                        <field
                            name="sign_comment"
                            nolabel="1"
                            placeholder="ความเห็น (ถ้ามี)..."
                        />
                    </div>
                    <field name="sign_attachment_ids" widget="many2many_binary" />
                </group>
                <group attrs="{'invisible': [('is_sign', '=', False)]}">
                    <field
                        name="signed_as_position_id"
                        string="Sign in capacity"
                        attrs="{'readonly': [('step_target_mode', '=', 'position')]}"
                        domain="[('holder_ids.user_id', '=', uid)]"
                        options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                    />
                </group>
                <group
                    string="Target"
                    attrs="{'invisible': [('needs_target', '=', False)]}"
                >
                    <field name="target_mode" />
                    <field
                        name="target_position_id"
                        attrs="{'invisible': [('target_mode', '!=', 'position')]}"
                        options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                    />
                    <field
                        name="target_employee_id"
                        attrs="{'invisible': [('target_mode', '!=', 'person')]}"
                        options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                    />
                    <field
                        name="target_department_id"
                        attrs="{'invisible': [('target_mode', '!=', 'unit')]}"
                        options="{'no_open': True, 'no_create': True, 'no_edit': True}"
                    />
                    <field
                        name="new_verb"
                        widget="selection"
                        attrs="{'invisible': [('disposition', '!=', 'direct')]}"
                    />
                    <field
                        name="new_for_info"
                        attrs="{'invisible': [('disposition', '!=', 'direct')]}"
                    />
                </group>
                <group
                    string="Return to"
                    attrs="{'invisible': [('is_return', '=', False)]}"
                >
                    <field name="destination" />
                    <field
                        name="resume_step_id"
                        attrs="{'invisible': [('destination', '!=', 'resume_step')], 'required': [('destination', '=', 'resume_step')]}"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="ยืนยัน"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
