<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ADR-0007: narrow the primary inbox to the notification scope. Oversight
         Todos (view scope minus notification scope) live in a second menu below.
         The base action is retargeted rather than duplicated so existing links
         (mail_activity_todo.view_my_todo_tree etc.) keep working. -->
    <record id="mail_activity_todo.action_my_todos" model="ir.actions.act_window">
        <field
            name="domain"
        >[('is_my_todo', '=', True), ('is_my_primary_todo', '=', True)]</field>
    </record>

    <!-- Oversight inbox — group Todos I can see but that fall outside my
         notification scope. Open to every internal user: after ADR-0007 even
         a regular multi-OU member can narrow their notification scope and
         create oversight Todos, so gating on group_all_ou_todo /
         group_manager_operating_unit would strand those Todos. Users without
         any oversight just see the empty-state screen. -->
    <record id="action_my_oversight_todos" model="ir.actions.act_window">
        <field name="name">Oversight</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">tree,form</field>
        <field
            name="domain"
        >[('is_my_todo', '=', True), ('is_my_primary_todo', '=', False)]</field>
        <field name="search_view_id" ref="mail_activity_todo.view_my_todo_search" />
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'sequence': 1, 'view_mode': 'tree', 'view_id': ref('mail_activity_todo.view_my_todo_tree')}),
                   (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('mail_activity_todo.view_my_todo_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">งานอยู่นอกขอบเขตแจ้งเตือนของคุณ ไม่มีอะไรค้าง</p>
            <p>Group Todos in Operating Units you can see but haven't opted to be notified for.</p>
        </field>
    </record>

    <menuitem
        id="menu_todo_oversight"
        name="อื่นๆ ที่เกี่ยวข้อง"
        parent="mail_activity_todo.menu_my_todos_root"
        action="action_my_oversight_todos"
        sequence="5"
    />

    <!-- ===== Inbox list: add OU / role columns + Claim/Release ===== -->
    <record id="view_my_todo_tree_role_unit" model="ir.ui.view">
        <field name="name">mail.activity.todo.tree.role.unit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail_activity_todo.view_my_todo_tree" />
        <field name="arch" type="xml">
            <field name="res_model_id" position="after">
                <field
                    name="operating_unit_id"
                    string="Operating Unit"
                    optional="show"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
                <field name="responsible_role_id" optional="hide" />
            </field>
            <button name="action_mark_unread" position="after">
                <button
                    name="action_claim"
                    type="object"
                    string="Claim"
                    icon="fa-hand-paper-o"
                    attrs="{'invisible': ['|', ('responsible_role_id', '=', False), ('user_id', '!=', False)]}"
                />
                <button
                    name="action_unclaim"
                    type="object"
                    string="Release"
                    icon="fa-hand-o-up"
                    attrs="{'invisible': ['|', ('responsible_role_id', '=', False), ('user_id', '=', False)]}"
                />
            </button>
        </field>
    </record>

    <!-- ===== Inbox form: add OU / role fields + Claim/Release ===== -->
    <record id="view_my_todo_form_role_unit" model="ir.ui.view">
        <field name="name">mail.activity.todo.form.role.unit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail_activity_todo.view_my_todo_form" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field
                    name="operating_unit_id"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
                <field name="responsible_role_id" />
            </field>
            <button name="action_mark_unread" position="after">
                <button
                    name="action_claim"
                    type="object"
                    string="Claim (รับเรื่อง)"
                    class="btn-secondary"
                    icon="fa-hand-paper-o"
                    attrs="{'invisible': ['|', ('responsible_role_id', '=', False), ('user_id', '!=', False)]}"
                />
                <button
                    name="action_unclaim"
                    type="object"
                    string="Release"
                    icon="fa-hand-o-up"
                    attrs="{'invisible': ['|', ('responsible_role_id', '=', False), ('user_id', '=', False)]}"
                />
            </button>
        </field>
    </record>

    <!-- ===== Inbox search: OU field, group filters, OU groupby + panel ===== -->
    <record id="view_my_todo_search_role_unit" model="ir.ui.view">
        <field name="name">mail.activity.todo.search.role.unit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail_activity_todo.view_my_todo_search" />
        <field name="arch" type="xml">
            <field name="activity_type_id" position="after">
                <field
                    name="operating_unit_id"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
            </field>
            <filter name="planned" position="after">
                <separator />
                <filter
                    name="personal"
                    string="Assigned to me"
                    domain="[('user_id', '!=', False)]"
                />
                <filter
                    name="group"
                    string="Group"
                    domain="[('responsible_role_id', '!=', False)]"
                />
            </filter>
            <filter name="group_deadline" position="after">
                <filter
                    name="group_ou"
                    string="Operating Unit"
                    context="{'group_by': 'operating_unit_id'}"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
            </filter>
            <searchpanel position="inside">
                <field
                    name="operating_unit_id"
                    string="Operating Unit"
                    select="multi"
                    enable_counters="1"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
            </searchpanel>
        </field>
    </record>

    <!-- ===== Completed log: add OU / role columns + OU filters ===== -->
    <record id="view_todo_log_tree_role_unit" model="ir.ui.view">
        <field name="name">todo.log.tree.role.unit</field>
        <field name="model">todo.log</field>
        <field name="inherit_id" ref="mail_activity_todo.view_todo_log_tree" />
        <field name="arch" type="xml">
            <field name="res_model_id" position="after">
                <field
                    name="operating_unit_id"
                    optional="show"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
                <field name="responsible_role_id" optional="hide" />
            </field>
        </field>
    </record>

    <!-- ===== Chatter "Schedule Activity" popup: route to a role ===== -->
    <record id="mail_activity_view_form_popup_role_unit" model="ir.ui.view">
        <field name="name">mail.activity.view.form.popup.role.unit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field
                    name="responsible_role_id"
                    options="{'no_create': True, 'no_open': True}"
                    help="Route this Todo to everyone holding this role in the record's operating unit. Picking a role clears 'Assigned to'."
                />
                <field
                    name="operating_unit_id"
                    attrs="{'invisible': [('responsible_role_id', '=', False)]}"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
            </field>
        </field>
    </record>

    <record id="view_todo_log_search_role_unit" model="ir.ui.view">
        <field name="name">todo.log.search.role.unit</field>
        <field name="model">todo.log</field>
        <field name="inherit_id" ref="mail_activity_todo.view_todo_log_search" />
        <field name="arch" type="xml">
            <field name="res_name" position="after">
                <field
                    name="operating_unit_id"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
            </field>
            <filter name="group_completed_by" position="after">
                <filter
                    name="group_ou"
                    string="Operating Unit"
                    context="{'group_by': 'operating_unit_id'}"
                    groups="mail_activity_todo_role_unit.group_all_ou_todo"
                />
            </filter>
        </field>
    </record>

</odoo>
