<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
      Alert box injected above the sheet of any form whose model inherits
      ``todo.assignable``. Only visible when the current user has a group Todo
      on the record they could Claim (has_claimable_todo compute). Same shape
      as base_tier_validation's tier_validation_label — an alert with inline
      buttons that render mixed with the form's own buttons.
    -->
    <template id="todo_assignment_alert">
        <div>
            <field name="has_claimable_todo" invisible="1" />
            <div
                class="alert alert-warning mb-0 pb-1 px-4"
                role="alert"
                attrs="{'invisible': [('has_claimable_todo', '=', False)]}"
            >
                <p>
                    <i class="fa fa-hand-paper-o" /> งานนี้รอผู้รับผิดชอบ
                    <button
                        name="action_claim_todo_on_record"
                        string="มอบหมายให้ฉัน"
                        type="object"
                        class="btn-sm btn-primary mx-1"
                        icon="fa-user"
                    />
                    <button
                        name="action_reassign_todo_on_record"
                        string="มอบหมายให้..."
                        type="object"
                        class="btn-sm btn-secondary mx-1"
                        icon="fa-share"
                    />
                </p>
            </div>
        </div>
    </template>

</odoo>
