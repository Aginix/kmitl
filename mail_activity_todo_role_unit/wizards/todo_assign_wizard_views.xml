<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_todo_assign_wizard_form" model="ir.ui.view">
        <field name="name">todo.assign.wizard.form</field>
        <field name="model">todo.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="มอบหมายให้...">
                <sheet>
                    <field name="candidate_user_ids" invisible="1" />
                    <field name="activity_ids" invisible="1" />
                    <group>
                        <field
                            name="user_id"
                            domain="[('id', 'in', candidate_user_ids)]"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="ยืนยัน"
                        class="btn-primary"
                    />
                    <button special="cancel" string="ยกเลิก" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
