<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
      "Access all OUs' Todos" — the Operating Unit dimension on the Todos inbox
      and the Completed history is shown only to holders of this group (gated at
      the view level). Regular users still route by role ∩ their own OU
      server-side (ADR-0002), so hiding the column never changes which Todos
      they receive. Standalone like the other *_operating_unit_access_all groups:
      assign it deliberately to cross-OU / oversight users.
    -->
    <record id="group_all_ou_todo" model="res.groups">
        <field name="name">Access all OUs' Todos</field>
        <field name="category_id" ref="operating_unit.module_operating_units" />
    </record>

    <!--
      Read-only access to res.users.role for every internal user. base_user_role
      gates the role model to ERP managers, but Todo routing needs regular users
      to (a) display the Responsible Role on group Todos in the inbox and (b)
      pick a role in the "Schedule Activity" popup to route a Todo to it. Read
      only — creating/assigning roles stays ERP-manager territory. Role names are
      no more sensitive than res.groups, which is already user-readable in core.
    -->
    <record id="access_res_users_role_todo_read" model="ir.model.access">
        <field name="name">res.users.role: read for Todo role routing</field>
        <field name="model_id" ref="base_user_role.model_res_users_role" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!--
      Group Todos completed by a role-in-unit are visible to current holders of
      that role in that operating unit (ADR-0002/0004). This rule is OR-combined
      with the core's personal rule (mail_activity_todo.todo_log_own_rule), so a
      user sees their own completions plus the group history of roles they hold.
      role/OU ids are read via the sudo-computed todo_role_ids (an ir.rule cannot
      sudo, and role_ids is ERP-manager restricted).
    -->
    <!--
      Notification-rule preferences are per-user (ADR-0007) — a user only ever
      touches their own row. Admins (ERP manager) still see all for support.
    -->
    <record id="rule_todo_notify_rule_own" model="ir.rule">
        <field name="name">Todo notify rule: own</field>
        <field name="model_id" ref="model_res_users_todo_notify_rule" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="rule_todo_notify_rule_admin" model="ir.rule">
        <field name="name">Todo notify rule: admin</field>
        <field name="model_id" ref="model_res_users_todo_notify_rule" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]" />
    </record>

    <record id="todo_log_role_unit_rule" model="ir.rule">
        <field name="name">Completed Todos: role-in-unit</field>
        <field name="model_id" ref="mail_activity_todo.model_todo_log" />
        <field
            name="domain_force"
        >['&amp;', ('responsible_role_id', 'in', user.todo_role_ids.ids), ('operating_unit_id', 'in', user.operating_unit_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
