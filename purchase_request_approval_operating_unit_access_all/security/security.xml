<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <function model="ir.rule" name="write">
        <value
            eval="[ref('purchase_request_approval_operating_unit.ir_rule_purchase_request_approval_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|','|',(1, '=', 1) if user.has_group('purchase_request_approval_operating_unit.group_all_ou_purchase_request_approval') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids),('requesting_operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>

</odoo>
