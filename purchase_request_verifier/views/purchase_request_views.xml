<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form (Verifier)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form" />
        <field name="arch" type="xml">
            <!-- ผู้ยืนยันตรวจสอบ (ADR-0011): next to the requester, editable until
                 the request ends — not tied to is_editable -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="verifier_candidate_ids" invisible="1" />
                <!-- the visible OU field is gated on multi-OU: without this one a
                     plain requester's new form never loads the default OU, so the
                     candidates (and the dropdown) come up empty -->
                <field name="operating_unit_id" invisible="1" />
                <xpath expr="//field[@name='assigned_to']" position="move" />
            </xpath>
            <field name="assigned_to" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                <attribute
                    name="attrs"
                >{'readonly': [('state', 'in', ('done', 'rejected', 'cancelled'))], 'required': [('state', '=', 'to_verify')]}</attribute>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.list.select (Verifier)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <filter name="assigned_to_me" position="attributes">
                <attribute name="string">รอฉันยืนยันตรวจสอบ</attribute>
                <attribute
                    name="domain"
                >[('assigned_to', '=', uid), ('state', '=', 'to_verify')]</attribute>
            </filter>
        </field>
    </record>
</odoo>
