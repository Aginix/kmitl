<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">

        <!-- จองงบประมาณ — can reserve/commit budget -->
        <record id="role_budget_commitment" model="res.users.role">
            <field name="name">จองงบประมาณ</field>
            <field
                name="implied_ids"
                eval="[(4, ref('budget.group_budget_commitment'))]"
            />
        </record>

        <!-- เจ้าหน้าที่งานแผน (หน่วยงาน) — Planning officer (department) -->
        <record id="role_planning_officer_department" model="res.users.role">
            <field name="name">เจ้าหน้าที่งานแผน (หน่วยงาน)</field>
            <field
                name="implied_ids"
                eval="[
                    (4, ref('budget.group_budget_user')),
                    (4, ref('account.group_account_readonly')),
                ]"
            />
        </record>

        <!-- เจ้าหน้าที่งานแผน (แอดมิน) — Planning officer (admin) -->
        <record id="role_planning_officer_admin" model="res.users.role">
            <field name="name">เจ้าหน้าที่งานแผน (แอดมิน)</field>
            <field
                name="implied_ids"
                eval="[
                    (4, ref('budget.group_budget_manager')),
                    (4, ref('account.group_account_readonly')),
                    (4, ref('budget_operating_unit_access_all.group_all_ou_budget')),
                    (4, ref('analytic_operating_unit_access_all.group_all_ou_analytic')),
                ]"
            />
        </record>

    </data>
</odoo>
