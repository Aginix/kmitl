<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: add department_analytic_id and extra_analytic_id -->
    <record id="view_kris_project_form_budget" model="ir.ui.view">
        <field name="name">kris.project.form.budget</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field
                    name="department_analytic_id"
                    attrs="{'readonly': [('can_edit', '=', False)]}"
                />
            </xpath>
            <xpath expr="//field[@name='extra_value']" position="after">
                <field
                    name="extra_analytic_id"
                    attrs="{'readonly': [('can_edit', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <!-- Tree view: add department_analytic_id column -->
    <record id="view_kris_project_tree_budget" model="ir.ui.view">
        <field name="name">kris.project.tree.budget</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="department_analytic_id"/>
            </xpath>
        </field>
    </record>

    <!-- Search view: add group-by filter for department -->
    <record id="view_kris_project_search_budget" model="ir.ui.view">
        <field name="name">kris.project.search.budget</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    name="group_department"
                    string="Department"
                    context="{'group_by': 'department_analytic_id'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
