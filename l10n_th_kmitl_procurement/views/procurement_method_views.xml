<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View procurement.method View Tree -->
    <record id="view_procurement_method_tree" model="ir.ui.view">
        <field name="name">view.procurement.method.tree</field>
        <field name="model">procurement.method</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View procurement.method form -->
    <record id="view_procurement_method_form" model="ir.ui.view">
        <field name="name">view.procurement.method.form</field>
        <field name="model">procurement.method</field>
        <field name="arch" type="xml">
            <form string="Procurement Method">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View procurement.method search -->
    <record id="view_procurement_method_search" model="ir.ui.view">
        <field name="name">view.procurement.method.search</field>
        <field name="model">procurement.method</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action procurement.method -->
    <record id="action_procurement_method" model="ir.actions.act_window">
        <field name="name">Procurement Method</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">procurement.method</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Procurement Method.
            </p>
        </field>
    </record>

</odoo>
