<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Placeholder approving position, seeded with no holder — assign the real
         head-of-department holder in Configuration ▸ Positions before go-live.
         noupdate="1" so the holder assignment survives module upgrades. -->
    <data noupdate="1">
        <record id="position_dr_approver" model="sarabun.position">
            <field name="name">ผู้อนุมัติเบิกจ่าย (Disbursement Approver)</field>
            <field name="code">DR_APPROVER</field>
        </record>
    </data>

    <data noupdate="0">
        <!-- Route Template for Disbursement Request -->
        <record id="route_template_disbursement_request" model="sarabun.route.template">
            <field name="name">Disbursement Request Head Approval</field>
            <field name="description">Route disbursement request to head of department for approval</field>
            <field name="sequence">10</field>
            <field name="origin_model">disbursement.request</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Head-of-department approver — targets a Position (canonical). Change the
             approver by reassigning the position's holders, not by editing this line. -->
        <record id="route_template_line_dr_head_approve" model="sarabun.route.template.line">
            <field name="template_id" ref="route_template_disbursement_request"/>
            <field name="order">10</field>
            <field name="verb" ref="agx_sarabun.verb_sign_approve"/>
            <field name="target_mode">position</field>
            <field name="position_id" ref="position_dr_approver"/>
        </record>
    </data>

</odoo>
