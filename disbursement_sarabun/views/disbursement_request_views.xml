<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="disbursement_request_form_sarabun" model="ir.ui.view">
        <field name="name">disbursement.request.form.sarabun</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <!-- Submit to Sarabun button: visible when submitted and no active Sarabun -->
            <xpath expr="//button[@name='action_sign']" position="before">
                <field name="sarabun_has_live_document" invisible="1"/>
                <button name="action_submit_to_sarabun"
                        string="Submit to Sarabun"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '!=', 'submitted'), ('sarabun_has_live_document', '=', True)]}"
                        groups="disbursement.group_disbursement_user"/>
            </xpath>

            <!-- Hide Send button when disbursement_sarabun is installed -->
            <xpath expr="//button[@name='action_sign']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Sarabun smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sarabun_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        attrs="{'invisible': [('sarabun_document_count', '=', 0)]}">
                    <field name="sarabun_document_count" widget="statinfo" string="Sarabun"/>
                </button>
            </xpath>

            <!-- Sarabun status notification on the origin record -->
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="sarabun_is_draft" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1"/>
                    หนังสือสารบรรณถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                </div>
                <div class="alert alert-info mb-2" role="alert"
                     attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1"/>
                    สถานะการเดินหนังสือสารบรรณ: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
