<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_1200000000" model="product.template">
        <field name="default_code">1200000000</field>
        <field name="name">อาคาร สิ่งก่อสร้าง</field>
        <field name="categ_id" ref="product_category_building"/>
        <field name="detailed_type">consu</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="purchase_request_ok">True</field>
    </record>

    <function model="product.template" name="write">
        <value eval="ref('product_kmitl.product_template_1200000000')"/>
        <value model="base" eval="{
        'property_account_expense_id': obj().env['account.account'].search([('code', '=', obj().env.ref('account_kmitl.a_1200000000').code)]),
        'property_account_income_id': obj().env['account.account'].search([('code', '=', obj().env.ref('account_kmitl.a_4121040031').code)])
        }"/>
    </function>

   
</odoo>
