<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_inherit_tier" model="ir.ui.view">
        <field name="name">purchase.request.tier.validation.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="validation_status" invisible="1" />
            </field>

            <xpath expr="//button[hasclass('o_button_approved')]" position="before">
                <field name="review_ids" invisible="1" />
            </xpath>

            <xpath expr="//button[hasclass('o_button_approved')]" position="attributes">
                <attribute name="attrs">{'invisible':['|', ('validation_status', 'in', ('pending', 'rejected')),('review_ids', '!=', False)]}</attribute>
                <attribute name="states"></attribute>
            </xpath>

            <xpath expr="//button[@name='button_rejected']" position="after">
                <field name="is_current_user_requester" invisible="1" />
                <field name="rejected" invisible="1" />
                <field name="validation_status" invisible="1" />
                <field name="need_validation" invisible="1" />
                <button name="request_validation" string="Request Validation" class="btn-primary" attrs="{'invisible': ['|', '|', '|',
        ('need_validation', '!=', True),
        ('validation_status', '=', 'pending'),
        ('rejected', '=', True),
        ('is_current_user_requester', '=', False)
    ]}" type="object" />
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="states">to_approve,validation,rejected,done</attribute>
            </xpath>

            <xpath expr="//button[@name='button_rejected']" position="before">
                <button string="ส่งคำขออนุมัติ" name="button_tier_to_approve" type="object" class="btn-primary" states="draft" />
            </xpath>

            <xpath expr="//button[@name='button_rejected']" position="attributes">
                <attribute name="attrs">{'invisible':['|', ('validation_status', 'in', ('pending', 'rejected')),('state', 'not in', ['to_approve', 'validation'])]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_filter" model="ir.ui.view">
        <field name="name">purchase.request.select - purchase_request_tier_validation</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <search position="inside">
                <group expand="0" string="Need actions">
                    <filter name="needs_review" string="Needs my Review" domain="[('reviewer_ids','in',uid), ('state', 'not in', ['done', 'cancel'])]" help="My Purchases to review" />
                    <filter name="tier_validated" string="Validated" domain="[('validated', '=', True)]" help="Purchase Requests validated and ready to be confirmed" />
                </group>
            </search>
        </field>
    </record>
</odoo>
