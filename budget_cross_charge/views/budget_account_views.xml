<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_account_form_cross_charge" model="ir.ui.view">
        <field name="name">budget.account.form.cross.charge</field>
        <field name="model">budget.account</field>
        <field name="inherit_id" ref="budget.view_budget_account_form"/>
        <field name="arch" type="xml">
            <field name="budgetable" position="after">
                <field name="cross_chargeable"/>
            </field>
        </field>
    </record>

    <record id="view_budget_account_search_cross_charge" model="ir.ui.view">
        <field name="name">budget.account.search.cross.charge</field>
        <field name="model">budget.account</field>
        <field name="inherit_id" ref="budget.view_budget_account_search"/>
        <field name="arch" type="xml">
            <filter name="non_budgetable" position="after">
                <filter string="ถัวจ่ายได้" name="cross_chargeable"
                    domain="[('cross_chargeable', '=', True)]"/>
            </filter>
        </field>
    </record>

</odoo>
