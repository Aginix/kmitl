<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rich list view for the "Search More…" dialog of the
         partner_autocomplete widget. The widget injects this view via
         tree_view_ref so searching beyond the dropdown still shows the columns
         that matter (type, tax id, address, contact), not the bare default
         partner list. -->
    <record id="res_partner_autocomplete_view_tree" model="ir.ui.view">
        <field name="name">res.partner.autocomplete.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Contacts">
                <field name="company_type" string="Type"/>
                <field name="display_name" string="Name"/>
                <field name="email" optional="show"/>
                <field name="phone" class="o_force_ltr" optional="show"/>
                <field name="vat" string="Tax ID" optional="show"/>
                <field name="contact_address" string="Address" optional="show"/>
                <field name="is_company" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Search view for the same dialog: a plain search-bar plus a searchpanel
         facet on company_type. The facet is generic (Individual/Company);
         partner_type_kmitl_autocomplete replaces it with the KMITL partner
         type when that module is installed. -->
    <record id="res_partner_autocomplete_view_search" model="ir.ui.view">
        <field name="name">res.partner.autocomplete.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Contacts">
                <field name="name" string="Name"/>
                <field name="vat"/>
                <field name="email"/>
                <field name="phone"/>
                <searchpanel>
                    <field name="company_type" string="Type" select="one" icon="fa-user-o"/>
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>
