<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order form -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='button_done']" position="attributes">
              <attribute name="string">lock</attribute>
            </xpath>  

            <xpath expr="//button[@name='action_create_invoice']" position="after">
                <button name="action_create_agreement_from_po"
                        string="Create Agreement"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '!=', 'purchase'), ('agreement_count', '>', 0)]}"/>
            </xpath>

        </field>
    </record>

  </odoo>