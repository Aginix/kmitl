<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View agreement form -->
    <record id="view_agreement_form" model="ir.ui.view">
        <field name="name">view.agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//h1" position="after">
                <label for="purchase_order_id" string="PO Ref"/>
                <h2>
                    <field name="purchase_order_id" readonly='True'/>
                </h2>
            </xpath>

            <xpath expr="//button[@name='create_new_version']" position="attributes">
                <attribute name="name">action_open_new_version_wizard</attribute>
            </xpath>

            <xpath expr="//field[@name='agreement_type_id']" position="after">
                <field name="contract_type" readonly="1" />
            </xpath>

            <xpath expr="//field[@name='agreement_type_id']" position="attributes">
                <attribute name="required">False</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='agreement_subtype_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='assigned_user_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>

            <xpath expr="//field[@name='assigned_user_id']" position="after">
                <field name="project_ids" widget="selection"/>
            </xpath>

            <xpath expr="//field[@name='description']" position="before">
                <label for="description" string="Description"/>
            </xpath>

            <xpath expr="//group[field[@name='field_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//p[contains(text(), 'add dynamic fields')]" position="replace">
                <p invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='parties']" position="attributes">
                <attribute name="string"></attribute>
            </xpath>

            <xpath expr="//group[@name='cust_parties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='parties']//p" position="replace">
                <p invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='partner_left']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='contact_right']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='signature_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='to_review_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='change_notice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='notification_address_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='termination_requested']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='termination_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='structure']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='child_agreements']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='performance']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='expiration_notice']" position="after">
                <field name="contract_type" invisible="1" readonly="0" />
                <field name="verify_datetime" />
                <field name="work_start_date" attrs="{'invisible': [('contract_type', '!=', 'contract_construction')]}" />
                <field name="work_end_date" attrs="{'invisible': [('contract_type', '!=', 'contract_construction')]}" />
            </xpath>

            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="price_unit" />
                <field name="price_subtotal" />
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="invoice" string="Invoice">
                    <field name="invoice_plan_ids">
                        <tree>
                            <field name="installment"/>
                            <field name="plan_date"/>
                            <field name="percent"/>
                            <field name="amount"/>
                        </tree>
                    </field>
                </page>

                <page name="committee" string="Committee">

                    <field name="pr1_total" invisible='1'/>
                    <separator string="Work Acceptance Committee"/>
                    <field name="work_acceptance_committee_ids" readonly="1">
                        <tree>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="approve_role"/>
                            <field name="department_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </tree>
                    </field>

                    <div attrs="{'invisible': [('pr1_total', '&lt;', 100000)]}">
                        <separator string="TOR Committee"/>
                        <field name="tor_committee_ids" readonly="1">
                            <tree>
                                <field name="employee_id"/>
                                <field name="name"/>
                                <field name="approve_role"/>
                                <field name="department_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="note"/>
                            </tree>
                        </field>

                        <separator string="Price Determine Committee"/>
                        <field name="price_determine_committee_ids" readonly="1">
                            <tree>
                                <field name="employee_id"/>
                                <field name="name"/>
                                <field name="approve_role"/>
                                <field name="department_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="note"/>
                            </tree>
                        </field>


                        <separator string="Evaluation Committee"/>
                        <field name="evaluation_committee_ids" readonly="1">
                            <tree>
                                <field name="employee_id"/>
                                <field name="name"/>
                                <field name="approve_role"/>
                                <field name="department_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </div>
                </page>

                <page name="document" string="Attachment">
                        <separator string="Attachment"/>
                        <field name="document_ids">
                            <tree>
                                <field name="file" filename="file_name" />
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>
                        <separator string="Attachment Reversion"/>
                        <field name="reversion_document_ids">
                            <tree>
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>
                </page>

                <page name="fee" string="Fee">
                    <group name="fee">
                        <field name="fee" />
                    </group>
                </page>

                <!-- <page name="extended_history" string="Extended history">

                </page> -->
            </xpath>

        </field>
    </record>


