<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_direct_claim_budget)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement_budget.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <field name="budget_commitment_id" position="after">
                <field name="budget_direct_move_id" attrs="{'invisible': [('budget_direct_move_id', '=', False)]}" />
            </field>
            <!-- Without a reservation the budget code is what gets consumed. -->
            <xpath expr="//group[@name='budget_information']/field[@name='budget_account_id']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('budget_commitment_id', '!=', False), ('state', '!=', 'draft')], 'required': [('is_direct_claim', '=', True), ('budget_commitment_id', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
