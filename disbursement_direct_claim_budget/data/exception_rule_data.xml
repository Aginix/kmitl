<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ตั้งเบิกตรง (disbursement ADR-0005): a reservation is optional; without
         one the claim is consumed directly from the pool on the final
         approval. Blocking, checked on submit; the posting re-checks
         availability. -->
    <record id="excep_disbursement_direct_claim_budget_account" model="exception.rule">
        <field name="name">ใบขอเบิกตั้งเบิกตรงยังไม่ระบุรหัสงบประมาณ</field>
        <field name="description">ใบขอเบิกแบบตั้งเบิกตรงต้องระบุรหัสงบประมาณค่าใช้จ่ายเพื่อใช้ตัดงบประมาณ</field>
        <field name="sequence">22</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.is_direct_claim and not self.budget_commitment_id and not self.budget_account_id:
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>
    <record id="excep_disbursement_direct_claim_budget_available" model="exception.rule">
        <field name="name">งบประมาณคงเหลือไม่พอสำหรับใบขอเบิกตั้งเบิกตรง</field>
        <field name="description">งบประมาณคงเหลือตามมิติและรหัสงบประมาณที่ระบุไม่พอสำหรับยอดเบิก</field>
        <field name="sequence">23</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.is_direct_claim and self._direct_claim_budget_shortfall():
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>
</odoo>
