<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_advance_payment_form_contract_pdf" model="ir.ui.view">
        <field name="name">advance.payment.form.contract.pdf</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                    name="%(action_report_advance_payment_contract)d"
                    type="action"
                    string="พิมพ์สัญญา"
                />
            </xpath>
        </field>
    </record>

</odoo>
