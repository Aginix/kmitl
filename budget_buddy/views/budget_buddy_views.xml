<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_buddy_tree" model="ir.ui.view">
        <field name="name">budget.buddy.tree</field>
        <field name="model">budget.buddy</field>
        <field name="arch" type="xml">
            <tree string="Buddy ดูแลหน่วยงาน" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="user_id" options="{'no_create': True}" />
                <field name="department_analytic_id" options="{'no_create': True}" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="view_budget_buddy_search" model="ir.ui.view">
        <field name="name">budget.buddy.search</field>
        <field name="model">budget.buddy</field>
        <field name="arch" type="xml">
            <search string="Buddy ดูแลหน่วยงาน">
                <field name="user_id" />
                <field name="department_analytic_id" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_user"
                        string="Buddy"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="group_by_department"
                        string="ส่วนงาน"
                        context="{'group_by': 'department_analytic_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_budget_buddy" model="ir.actions.act_window">
        <field name="name">Buddy ดูแลหน่วยงาน</field>
        <field name="res_model">budget.buddy</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p
                class="o_view_nocontent_smiling_face"
            >กำหนดเจ้าหน้าที่ Buddy ที่ดูแลแต่ละส่วนงาน</p>
            <p>Buddy ที่ดูแลส่วนงานหลักจะดูแลส่วนงานย่อยทั้งหมดด้วย</p>
        </field>
    </record>

    <menuitem
        id="menu_budget_buddy"
        name="Buddy ดูแลหน่วยงาน"
        parent="budget.budget_config_menu"
        action="action_budget_buddy"
        sequence="60"
    />

</odoo>
