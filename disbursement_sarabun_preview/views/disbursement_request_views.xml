<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="disbursement_request_form_sarabun_preview" model="ir.ui.view">
        <field name="name">disbursement.request.form.sarabun.preview</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <!-- ADR 0007: the หนังสือ this request sends to e-Saraban, before and
                 after Submit to Sarabun. -->
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button name="action_preview_sarabun_document"
                        string="ดูตัวอย่างเอกสาร"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'cancel')]}"/>
            </xpath>
        </field>
    </record>

</odoo>
