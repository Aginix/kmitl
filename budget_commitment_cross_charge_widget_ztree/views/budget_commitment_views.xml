<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="budget_commitment_form_view" model="ir.ui.view">
        <field name="name">budget.commitment.form (cross-charge ztree)</field>
        <field name="model">budget.commitment</field>
        <field
            name="inherit_id"
            ref="budget_commitment_cross_charge.budget_commitment_form_view"
        />
        <field name="arch" type="xml">
            <!-- The ถัว row's code from the budget-code tree; codes outside the
                 row domain (parents, unflagged or unfunded codes) show greyed
                 out only to keep the tree connected. -->
            <xpath
                expr="//field[@name='split_ids']/tree/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '4', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
