<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add a โครงการ/กิจกรรม row after รหัสค่าใช้จ่าย in the ใบขอเบิก PDF,
         shown only when the disbursement is raised under a project.
         priority 20: inherits apply by (priority, id), and on live DBs this view
         is older than disbursement_budget's, which adds the anchor row. -->
    <template id="report_disbursement_request_kmitl_project" inherit_id="disbursement_pdf.report_disbursement_request" priority="20">
        <xpath expr="//tr[hasclass('o_field_budget_account_id')]" position="after">
            <tr class="o_field_kmitl_project_analytic_id" t-if="o.kmitl_project_analytic_id">
                <td>โครงการ/กิจกรรม</td>
                <td>
                    <span t-field="o.kmitl_project_analytic_id"/>
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
