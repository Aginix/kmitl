<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- KMITL project form: "สร้างใบขอเบิก" header button + ใบขอเบิก smart button -->
    <record id="view_kmitl_project_form_disbursement" model="ir.ui.view">
        <field name="name">view.kmitl.project.form.disbursement</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_disbursement_request" type="object" string="สร้างใบขอเบิก" class="btn-primary" attrs="{'invisible': [('can_create_disbursement', '=', False)]}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="can_create_disbursement" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_disbursement_requests" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible': [('disbursement_request_count', '=', 0)]}">
                    <field name="disbursement_request_count" widget="statinfo" string="ใบขอเบิก"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
