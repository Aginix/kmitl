<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- If the disbursement draws a project budget code (budget.account.is_project),
         it must carry the project dimension. Blocking so it can't be ignored —
         the โครงการ/กิจกรรม dimension is mandatory for project spending. Checked on
         submit via the base.exception framework the DR already uses. -->
    <record id="excep_disbursement_project_dimension" model="exception.rule">
        <field name="name">ต้องระบุมิติโครงการ/กิจกรรมสำหรับรหัสงบประมาณโครงการ</field>
        <field name="description">รหัสงบประมาณค่าใช้จ่ายเป็นประเภทโครงการ แต่ใบขอเบิกยังไม่ได้ระบุมิติโครงการ/กิจกรรม</field>
        <field name="sequence">60</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.budget_account_id.is_project and not self.kmitl_project_analytic_id:
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- A project budget code drives the line account automatically: the GL
         account sharing the budget code. If there is none the lines stay
         blank — block on submit with a clear message instead of a raw
         "account required" error. -->
    <record id="excep_disbursement_project_no_product" model="exception.rule">
        <field name="name">รหัสงบประมาณโครงการยังไม่ได้ผูกรหัสบัญชี</field>
        <field name="description">รหัสงบประมาณค่าใช้จ่ายเป็นประเภทโครงการ แต่ไม่มีรหัสบัญชีที่ตรงกับรหัสงบประมาณ จึงกำหนดรหัสบัญชีให้บรรทัดใบขอเบิกไม่ได้</field>
        <field name="sequence">61</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.budget_account_id.is_project and self.line_ids.filtered(lambda l: not l.account_id):
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- A DR linked to a kmitl.project may only be submitted while that project
         is actively running. Blocking — a project that is not yet in_progress
         (e.g. still in draft / to_verify / to_send / sent) or is already
         complete / cancelled must not accept new disbursements. -->
    <record id="excep_disbursement_project_in_progress" model="exception.rule">
        <field name="name">โครงการ/กิจกรรมต้องอยู่ในสถานะ "กำลังดำเนินการ" จึงจะเบิกจ่ายได้</field>
        <field name="description">ใบขอเบิกเชื่อมโยงกับโครงการ/กิจกรรมที่ยังไม่ได้อยู่ในสถานะกำลังดำเนินการ จึงไม่สามารถส่งขออนุมัติได้</field>
        <field name="sequence">62</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
project = self.kmitl_project_id.sudo()
if project and project.state != 'in_progress':
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- Keep a project's disbursements within its reserved Project Budget: the
         total claimed by all its non-cancelled DRs must not exceed budget_amount
         (the disbursement analog of the พ.1 headroom cap, ADR-0007). Blocking. -->
    <record id="excep_disbursement_project_over_budget" model="exception.rule">
        <field name="name">ยอดเบิกจ่ายรวมเกินงบประมาณที่โครงการได้รับจัดสรร</field>
        <field name="description">ยอดรวมของใบขอเบิกทั้งหมดภายใต้โครงการ/กิจกรรมนี้เกินงบประมาณที่จัดสรรให้โครงการ (budget_amount)</field>
        <field name="sequence">63</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self._exceeds_project_budget():
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- Expense-line claims (kmitl_project ADR-0013): under the project's
         ควบคุมตามรายจ่าย every line names an expense line of the project and
         stays within what is left of it. A line of another project / an income
         line is refused whatever the switch. All blocking. -->
    <record id="excep_disbursement_line_project_budget_line_missing" model="exception.rule">
        <field name="name">ต้องเลือกรายจ่ายของโครงการ</field>
        <field name="description">โครงการนี้ควบคุมตามรายจ่าย ทุกรายการของใบขอเบิกต้องเลือกรายจ่ายของโครงการที่จะเบิก</field>
        <field name="sequence">64</field>
        <field name="model">disbursement.request.line</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self._kmitl_project_budget_line_missing():
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <record id="excep_disbursement_line_project_budget_line_mismatch" model="exception.rule">
        <field name="name">รายจ่ายที่เลือกไม่ใช่รายจ่ายของโครงการนี้</field>
        <field name="description">มีรายการที่เลือกรายจ่ายของโครงการอื่น หรือเลือกรายการรายรับ กรุณาเลือกรายจ่ายของโครงการของใบขอเบิกนี้</field>
        <field name="sequence">65</field>
        <field name="model">disbursement.request.line</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self._kmitl_project_budget_line_mismatch():
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <record id="excep_disbursement_line_project_budget_line_exceeded" model="exception.rule">
        <field name="name">ยอดเบิกเกินจำนวนเงินของรายจ่ายโครงการ</field>
        <field name="description">ยอดเบิกรวมของรายจ่ายนี้ (ใบขอเบิกที่ส่งแล้วรวมกับใบนี้) เกินจำนวนเงินที่โครงการวางแผนไว้ กรุณาลดยอดเบิกหรือขอปรับแผนโครงการ</field>
        <field name="sequence">66</field>
        <field name="model">disbursement.request.line</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self._kmitl_project_budget_line_exceeded():
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>
</odoo>
