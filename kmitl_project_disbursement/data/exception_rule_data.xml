<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- If the disbursement draws a project budget code (budget.account.is_project),
         it must carry the project dimension. Blocking so it can't be ignored —
         the โครงการ/กิจกรรม dimension is mandatory for project spending. Checked on
         submit via the base.exception framework the DR already uses. -->
    <record id="excep_disbursement_project_dimension" model="exception.rule">
        <field name="name">ต้องระบุมิติโครงการ/กิจกรรมสำหรับรหัสงบประมาณโครงการ</field>
        <field name="description">รหัสงบประมาณค่าใช้จ่ายเป็นประเภทโครงการ แต่ใบขอเบิกยังไม่ได้ระบุมิติโครงการ/กิจกรรม</field>
        <field name="sequence">60</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.budget_account_id.is_project and not self.kmitl_project_analytic_id:
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- A project budget code drives the line product automatically from
         budget.account.product_id (see disbursement_request_line). If that budget
         account has no product bound, the product cannot be resolved — block on
         submit with a clear message instead of a raw "product required" error. -->
    <record id="excep_disbursement_project_no_product" model="exception.rule">
        <field name="name">รหัสงบประมาณโครงการยังไม่ได้ผูกสินค้า (product)</field>
        <field name="description">รหัสงบประมาณค่าใช้จ่ายเป็นประเภทโครงการ แต่ยังไม่ได้ผูกสินค้า (product) จึงกำหนดรหัสบัญชีให้บรรทัดใบขอเบิกไม่ได้</field>
        <field name="sequence">61</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self.budget_account_id.is_project and not self.budget_account_id.product_id:
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- A DR linked to a kmitl.project may only be submitted while that project
         is actively running. Blocking — a project that is not yet in_progress
         (e.g. still in draft / to_verify / to_send / sent) or is already
         complete / cancelled must not accept new disbursements. -->
    <record id="excep_disbursement_project_in_progress" model="exception.rule">
        <field name="name">โครงการ/กิจกรรมต้องอยู่ในสถานะ "กำลังดำเนินการ" จึงจะเบิกจ่ายได้</field>
        <field name="description">ใบขอเบิกเชื่อมโยงกับโครงการ/กิจกรรมที่ยังไม่ได้อยู่ในสถานะกำลังดำเนินการ จึงไม่สามารถส่งขออนุมัติได้</field>
        <field name="sequence">62</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
project = self.kmitl_project_id.sudo()
if project and project.state != 'in_progress':
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>

    <!-- Keep a project's disbursements within its reserved Project Budget: the
         total claimed by all its non-cancelled DRs must not exceed budget_amount
         (the disbursement analog of the พ.1 headroom cap, ADR-0007). Blocking. -->
    <record id="excep_disbursement_project_over_budget" model="exception.rule">
        <field name="name">ยอดเบิกจ่ายรวมเกินงบประมาณที่โครงการได้รับจัดสรร</field>
        <field name="description">ยอดรวมของใบขอเบิกทั้งหมดภายใต้โครงการ/กิจกรรมนี้เกินงบประมาณที่จัดสรรให้โครงการ (budget_amount)</field>
        <field name="sequence">63</field>
        <field name="model">disbursement.request</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
if self._exceeds_project_budget():
    failed = True
        </field>
        <field name="is_blocking" eval="True" />
        <field name="active" eval="True" />
    </record>
</odoo>
