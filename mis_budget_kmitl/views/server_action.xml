<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Server Action budget_template -->
    <record id="model_budget_template_action" model="ir.actions.server">
        <field name="name">Generate Report</field>
        <field name="model_id" ref="budget.model_budget_template"/>
        <field name="binding_model_id" ref="budget.model_budget_template"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.generate_report()</field>
    </record>

        <!-- Server Action budget_appropriation -->
    <record id="model_budget_appropriation_action" model="ir.actions.server">
        <field name="name">Generate Report</field>
        <field name="model_id" ref="budget.model_budget_appropriation"/>
        <field name="binding_model_id" ref="budget.model_budget_appropriation"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.generate_report()</field>
    </record>


</odoo>
