<odoo>
    <data noupdate="0">

        <record id="module_category_procurement_plan" model="ir.module.category">
            <field name="name">Procurement Plan</field>
            <field name="description">User groups for managing and using procurement plans</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_procurement_plan_user" model="res.groups">
            <field name="name">Procurement Plan User</field>
            <field name="category_id" ref="procurement_plan.module_category_procurement_plan"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="group_procurement_plan_manager" model="res.groups">
            <field name="name">Procurement Plan Manager</field>
            <field name="category_id" ref="procurement_plan.module_category_procurement_plan"/>
            <field name="implied_ids" eval="[(4, ref('group_procurement_plan_user'))]"/>
        </record>

    </data>
</odoo>
