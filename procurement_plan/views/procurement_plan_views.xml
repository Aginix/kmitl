<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View procurement.plan View Tree -->
    <record id="view_procurement_plan_tree" model="ir.ui.view">
        <field name="name">view.procurement.plan.tree</field>
        <field name="model">procurement.plan</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'procurement'" decoration-success="state == 'done'" decoration-warning="state in ('validate', 'pending')">
                <field name="date_range_fy_id" />
                <field name="name" />
                <field name="description" />
                <field name="amount" optional="hide" />
                <field name="unit" optional="hide" />
                <field name="price_per_unit" optional="hide" />
                <field name="total_price" sum="รวมทั้งหมด" widget="monetary" />
                <field name="procurement_method_id" optional="show" />
                <field name="state" widget="badge" decoration-info="state == 'procurement'" decoration-success="state == 'done'" decoration-warning="state in ('validate', 'pending')" />
            </tree>
        </field>
    </record>

    <!-- View procurement.plan form -->
    <record id="view_procurement_plan_form" model="ir.ui.view">
        <field name="name">view.procurement.plan.form</field>
        <field name="model">procurement.plan</field>
        <field name="arch" type="xml">
            <form string="Procurement Plan">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validate,pending,procurement,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group name="basic">
                            <field name="description" placeholder="e.g. ครุภัณฑ์วิทยาศาสตร์และการแพทย์, ปรับปรุงห้องปฏิบัติการฟิสิกส์" />
                            <field name="procurement_method_id" />
                            <field name="user_id" widget="many2one_avatar_user" required="1" />
                            <field name="price_per_unit" string="ราคา" />
                            <label for="amount" string="จำนวน" />
                            <div class="o_row">
                                <field name="amount" />
                                <field name="unit" placeholder="e.g. ชิ้น, รายการ, ตัว, ชุด" />
                            </div>
                            <field name="total_price" string="รวมทั้งสิ้น" />
                            <field name="note" placeholder="Notes..." />
                        </group>
                        <group>
                            <field name="date_range_fy_id" required="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="ข้อมูลแผนการดำเนินงาน">
                            <group>
                                <field name="purchase_request_eta" />
                                <field name="procurement_announcement_eta" />
                                <field name="approval_signing_eta" />
                                <field name="contract_order_signing_eta" />
                                <field name="acceptance_eta" />
                            </group>
                        </page>
                        <page string="การเบิกจ่าย">
                            <field name="payment_ids">
                                <tree editable="bottom">
                                    <field name="number" width="1" />
                                    <field name="number_of_days" width="3" />
                                    <field name="month" width="3" />
                                    <field name="amount" width="3" />
                                </tree>
                            </field>
                        </page>
                        <page name="additional_info" string="Additional Info">
                            <group>
                                <field name="company_id" invisible="1" />
                                <field name="currency_id" invisible="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- View procurement.plan search -->
    <record id="view_procurement_plan_search" model="ir.ui.view">
        <field name="name">view.procurement.plan.search</field>
        <field name="model">procurement.plan</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action procurement.plan -->
    <record id="action_procurement_plan" model="ir.actions.act_window">
        <field name="name">Procurement Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">procurement.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Procurement Plan.
            </p>
        </field>
    </record>

</odoo>
