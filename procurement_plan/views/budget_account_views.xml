<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View budget.account tree -->
    <record id="view_budget_account_inherit_tree" model="ir.ui.view">
        <field name="name">view.budget.account.tree</field>
        <field name="model">budget.account</field>
        <field name="inherit_id" ref="budget.view_budget_account_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budgetable']" position="after">
                <field name="procurement_plan" attrs="{'invisible': [('budget_type', '!=', 'expense')]}" />
            </xpath>
        </field>
    </record>

    <!-- View budget.account form -->
    <record id="view_budget_account_inherit_form" model="ir.ui.view">
        <field name="name">view.budget.account.form</field>
        <field name="model">budget.account</field>
        <field name="inherit_id" ref="budget.view_budget_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budgetable']" position="after">
                <field name="procurement_plan" attrs="{'invisible': [('budget_type', '!=', 'expense')]}" />
            </xpath>
        </field>
    </record>

</odoo>
