<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_procurement_plan_report" model="ir.actions.client">
        <field name="name">ภาพรวมแผนจัดซื้อจัดจ้าง</field>
        <field name="res_model">procurement.plan</field>
        <field name="tag">procurement_plan_report</field>
    </record>

    <record id="action_procurement_plan_dashboard" model="ir.actions.client">
        <field name="name">Dashboard แผนจัดซื้อจัดจ้าง</field>
        <field name="tag">procurement_plan_dashboard</field>
        <field name="target">main</field>
    </record>

    <menuitem id="procurement_plan_root_menu" name="Procurement Plan" sequence="3" web_icon="procurement_plan,static/description/logo.png" groups="procurement_plan.group_procurement_plan_user">
        <menuitem
            id="action_procurement_plan_menu_action"
            name="Procurement Plan"
            action="action_procurement_plan"
        />
        <menuitem
            id="action_procurement_plan_report_menu"
            name="รายงาน"
        >
        <menuitem
            id="action_procurement_plan_dashboard_menu_action"
            name="Dashboard"
            action="action_procurement_plan_dashboard"
            sequence="1"/>
        <menuitem
            id="action_procurement_plan_report_menu_action"
            name="ภาพรวมแผนจัดซื้อจัดจ้าง"
            action="action_procurement_plan_report"
            sequence="10"/>
        </menuitem>

    </menuitem>

    <menuitem
        id="budget_procurement_plan_inherit_menu"
        name="แผนจัดซื้อจัดจ้าง"
        sequence="88"
        parent="budget.budget_root_menu"
        action="procurement_plan.action_procurement_plan"
    />
</odoo>
