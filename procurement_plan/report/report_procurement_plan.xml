<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_procurement_plan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>แบบฟอร์มแผนจัดซื้อจัดจ้าง</h2>
                        <p>
                            <strong>ชื่อแผน:</strong>
                            <t t-esc="doc.name"/>
                        </p>
                        <p>
                            <strong>วิธีจัดซื้อ:</strong>
                            <t t-esc="doc.procurement_method_id.display_name"/>
                        </p>
                        <p>
                            <strong>งวดปี:</strong>
                            <t t-esc="doc.date_range_fy_id.display_name"/>
                        </p>
                        <p>
                            <strong>รายละเอียด:</strong>
                            <t t-esc="doc.note"/>
                        </p>

                        <table class="table table-sm mt-3">
                            <thead>
                                <tr>
                                    <th>จำนวน</th>
                                    <th>หน่วยนับ</th>
                                    <th>ราคาต่อหน่วย</th>
                                    <th>วงเงินรวม</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <t t-esc="doc.amount"/>
                                    </td>
                                    <td>
                                        <t t-esc="doc.unit"/>
                                    </td>
                                    <td>
                                        <t t-esc="doc.price_per_unit"/>
                                    </td>
                                    <td>
                                        <t t-esc="doc.total_price"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-3">การเบิกจ่าย</h4>
                        <t t-if="doc.payment_ids">
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        <th>งวด</th>
                                        <th>จำนวนวัน</th>
                                        <th>เดือน</th>
                                        <th>จำนวนเงิน</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.payment_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <t t-esc="line.number"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.number_of_days"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.month"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.amount"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>

        </t>
    </template>

    <record id="action_report_procurement_plan_pdf" model="ir.actions.report">
        <field name="name">Procurement Plan</field>
        <field name="model">procurement.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">procurement_plan.report_procurement_plan_document</field>
        <field name="report_file">procurement_plan.report_procurement_plan_document</field>
        <field name="binding_model_id" ref="procurement_plan.model_procurement_plan" />
        <field name="print_report_name">'Procurement Plan - %s' % (object.name)</field>
        <field name="binding_type">report</field>
    </record>
</odoo>
