<odoo>
    <!--
        แผนจัดซื้อจัดจ้าง (Procurement Plan) — printable document per plan.
        Plain style (no Bootstrap grid/utilities): all layout comes from the
        <style> block below so the document reads cleanly on paper.
    -->

    <!-- Helper: render one dimension as "label : [code] complete-name". -->
    <template id="dim_row">
        <div class="dim">
            <span class="dim-label"><t t-out="label" /> :</span>
            <span t-if="acc">
                <t
                    t-out="(acc.code and '[%s] ' % acc.code or '') + acc.complete_name"
                />
            </span>
            <span t-if="not acc">-</span>
        </div>
    </template>

    <template id="report_procurement_plan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.currency_id" />
                    <t
                        t-set="print_dt"
                        t-value="context_timestamp(datetime.datetime.now())"
                    />
                    <t
                        t-set="state_labels"
                        t-value="{'draft': 'แบบร่าง', 'to_verify': 'รอตรวจสอบข้อมูล', 'verified': 'รอดำเนินการ', 'in_progress': 'อยู่ในระหว่างดำเนินการ', 'done': 'จัดซื้อจัดจ้างเสร็จสิ้น', 'cancel': 'ยกเลิก'}"
                    />
                    <t
                        t-set="month_labels"
                        t-value="{'1': 'มกราคม', '2': 'กุมภาพันธ์', '3': 'มีนาคม', '4': 'เมษายน', '5': 'พฤษภาคม', '6': 'มิถุนายน', '7': 'กรกฎาคม', '8': 'สิงหาคม', '9': 'กันยายน', '10': 'ตุลาคม', '11': 'พฤศจิกายน', '12': 'ธันวาคม'}"
                    />
                    <t
                        t-set="eta_rows"
                        t-value="[('ขอซื้อขอจ้าง', o.purchase_request_eta), ('ประกาศจัดซื้อจัดจ้าง', o.procurement_announcement_eta), ('ลงนามอนุมัติ', o.approval_signing_eta), ('ลงนามสัญญา/ใบสั่ง', o.contract_order_signing_eta), ('ตรวจรับ', o.acceptance_eta)]"
                    />
                    <t t-set="payments" t-value="o.payment_ids.sorted('number')" />
                    <style>
                        * { font-family: "THSarabunNew", Arial, sans-serif; }
                        .page { color: #000; font-size: 15pt; line-height: 1.25; position: relative; }
                        .logo { position: absolute; top: 0; left: 0; max-height: 60pt; max-width: 160pt; }
                        .org-name { text-align: center; font-weight: bold; font-size: 16pt; }
                        .doc-title { text-align: center; font-weight: bold; font-size: 18pt; margin: 6pt 0 12pt 0; line-height: 1.4; }
                        table.meta { width: 100%; border-collapse: collapse; margin-bottom: 8pt; border: none; }
                        table.meta td { padding: 1pt 4pt; font-size: 15pt; vertical-align: top; border: none; }
                        table.meta td.k { width: 90pt; color: #333; }
                        table.detail { width: 100%; border-collapse: collapse; margin-bottom: 8pt; }
                        table.detail th, table.detail td { border: 1px solid #000; padding: 3pt 6pt; font-size: 15pt; vertical-align: top; }
                        table.detail th { text-align: center; font-weight: bold; background: #e9e9e9; }
                        .seq { width: 40pt; text-align: center; }
                        .num { width: 70pt; text-align: center; }
                        .amt { width: 110pt; text-align: right; white-space: nowrap; }
                        .dim { padding-left: 8pt; }
                        .dim-label { font-weight: bold; }
                        tr.total td { font-weight: bold; }
                        .summary { width: 100%; border-collapse: collapse; margin-bottom: 2pt; border: none; }
                        .summary td { padding: 2pt 4pt; font-size: 15pt; border: none; }
                        .summary td.k { color: #333; }
                        .summary td.v { text-align: right; white-space: nowrap; }
                        .in-words { text-align: right; font-style: italic; margin-bottom: 12pt; }
                        .print-date { text-align: right; font-size: 12pt; color: #555; margin-top: 12pt; }
                    </style>

                    <div class="page">
                        <img
                            class="logo"
                            t-if="o.company_id.logo"
                            t-att-src="image_data_uri(o.company_id.logo)"
                        />
                        <div class="org-name" t-out="o.company_id.name" />

                        <div class="doc-title">
                            แผนจัดซื้อจัดจ้าง<br />
                            ประจำปีงบประมาณ พ.ศ. <span
                                t-out="o.account_fiscal_year_id.name or '............'"
                            />
                        </div>

                        <table class="meta" border="0">
                            <tr>
                                <td class="k">เลขที่</td>
                                <td><span
                                        t-out="o.name if o.name and o.name != '/' else '-'"
                                    /></td>
                                <td class="k">สถานะ</td>
                                <td><span
                                        t-out="state_labels.get(o.state, o.state)"
                                    /></td>
                            </tr>
                            <tr>
                                <td class="k">ชื่อรายการ</td>
                                <td colspan="3"><span
                                        t-out="o.description or '-'"
                                    /></td>
                            </tr>
                            <tr>
                                <td class="k">จำนวน</td>
                                <td><span t-out="'{:,}'.format(o.amount)" /> <span
                                        t-out="o.unit or ''"
                                    /></td>
                                <td class="k">ผู้รับผิดชอบ</td>
                                <td><span t-out="o.user_id.name or '-'" /></td>
                            </tr>
                            <tr t-if="o.note">
                                <td class="k">หมายเหตุ</td>
                                <td colspan="3"><span t-out="o.note" /></td>
                            </tr>
                        </table>

                        <table class="detail">
                            <tr>
                                <th>มิติงบประมาณ</th>
                            </tr>
                            <tr>
                                <td>
                                    <t t-call="procurement_plan.dim_row">
                                        <t t-set="label" t-value="'ส่วนงาน'" />
                                        <t
                                            t-set="acc"
                                            t-value="o.department_analytic_id"
                                        />
                                    </t>
                                    <t t-call="procurement_plan.dim_row">
                                        <t t-set="label" t-value="'แหล่งเงิน'" />
                                        <t t-set="acc" t-value="o.source_analytic_id" />
                                    </t>
                                    <t t-call="procurement_plan.dim_row">
                                        <t t-set="label" t-value="'กองทุน'" />
                                        <t t-set="acc" t-value="o.fund_analytic_id" />
                                    </t>
                                    <t t-call="procurement_plan.dim_row">
                                        <t
                                            t-set="label"
                                            t-value="'ด้าน/แผนงาน/กิจกรรม'"
                                        />
                                        <t
                                            t-set="acc"
                                            t-value="o.activity_analytic_id"
                                        />
                                    </t>
                                    <t
                                        t-if="o.analytic_account_id"
                                        t-call="procurement_plan.dim_row"
                                    >
                                        <t
                                            t-set="label"
                                            t-value="'แผนจัดซื้อจัดจ้าง'"
                                        />
                                        <t
                                            t-set="acc"
                                            t-value="o.analytic_account_id"
                                        />
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <table class="summary" border="0">
                            <tr>
                                <td class="k">วงเงินรวม</td>
                                <td class="v"><span
                                        t-out="'{:,.2f}'.format(o.total_price)"
                                    /> บาท</td>
                            </tr>
                        </table>
                        <div class="in-words" t-if="o.total_price">
                            (<t
                                t-out="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.total_price)"
                            />)
                        </div>

                        <table class="detail">
                            <thead>
                                <tr>
                                    <th class="seq">ที่</th>
                                    <th>ขั้นตอนการดำเนินงาน</th>
                                    <th>เดือนที่คาดว่าจะดำเนินการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="eta_rows" t-as="row">
                                    <td class="seq" t-out="row_index + 1" />
                                    <td t-out="row[0]" />
                                    <td t-out="month_labels.get(row[1], '-')" />
                                </tr>
                            </tbody>
                        </table>

                        <table class="detail">
                            <thead>
                                <tr>
                                    <th class="seq">งวดที่</th>
                                    <th class="num">จำนวนวัน</th>
                                    <th>เดือนที่เบิกจ่าย</th>
                                    <th class="amt">จำนวนเงิน (บาท)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="payments" t-as="payment">
                                    <td class="seq" t-out="payment.number" />
                                    <td
                                        class="num"
                                        t-out="payment.number_of_days or '-'"
                                    />
                                    <td t-out="month_labels.get(payment.month, '-')" />
                                    <td
                                        class="amt"
                                        t-out="'{:,.2f}'.format(payment.amount)"
                                    />
                                </tr>
                                <tr t-if="not payments">
                                    <td class="seq">-</td>
                                    <td colspan="2">ไม่มีรายการ</td>
                                    <td class="amt" />
                                </tr>
                                <tr class="total" t-if="payments">
                                    <td colspan="3" style="text-align: right;">รวม</td>
                                    <td
                                        class="amt"
                                        t-out="'{:,.2f}'.format(sum(payments.mapped('amount')))"
                                    />
                                </tr>
                            </tbody>
                        </table>

                        <div class="print-date">
                            พิมพ์เอกสารเมื่อ <t
                                t-out="print_dt.strftime('%d/%m/') + str(print_dt.year + 543) + ' ' + print_dt.strftime('%H:%M:%S') + ' น.'"
                            />
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
