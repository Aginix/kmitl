<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.form.line View Tree -->
    <record id="view_purchase_request_form_line_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.form.line.tree</field>
        <field name="model">purchase.request.form.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="pr2_id"/>
            </tree>
        </field>
    </record>

    <!-- View purchase.request.form.line form -->
    <record id="view_purchase_request_form_line_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form.line.form</field>
        <field name="model">purchase.request.form.line</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Form Line">
                <sheet>
                    <div class="oe_title">
                        <label for="pr2_id"/>
                        <h1>
                            <field name="pr2_id" placeholder="Name..."/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="taxes"/>
                            <field name="subtotal"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_uom" domain="[('category_id', '=', product_uom_category_id)]"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- <record id="view_purchase_request_form_line_search" model="ir.ui.view">
        <field name="name">view.purchase.request.form.line.search</field>
        <field name="model">purchase.request.form.line</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record> -->

    <!-- Action purchase.request.form.line -->
    <record id="action_purchase_request_form_line" model="ir.actions.act_window">
        <field name="name">Purchase Request Form Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.form.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Form Line.
            </p>
        </field>
    </record>

</odoo>
