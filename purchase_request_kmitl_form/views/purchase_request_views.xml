<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_done']" position="after">
                <button name="button_create_pr2" states="approved" string="สร้าง PR2" type="object" class="btn-secondary" />
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_purchase_request_2_form"
        name="Purchase Requests Form"
        parent="purchase_request.parent_menu_purchase_request"
    />
    <menuitem
        id="menu_purchase_request_2_form_act"
        sequence="10"
        parent="menu_purchase_request_2_form"
        action="purchase_request_kmitl_form.action_purchase_request_form"
    />

  </odoo>
