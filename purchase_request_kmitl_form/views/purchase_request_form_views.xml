<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.form View Tree -->
    <record id="view_purchase_request_form_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.form.tree</field>
        <field name="model">purchase.request.form</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="ref"/>
                <field name="vendor" />
                <field name="payment_type" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- View purchase.request.form form -->
    <record id="view_purchase_request_form_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form.form</field>
        <field name="model">purchase.request.form</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Form">
                <header>
                    <button name="button_submit" string="submit" states="draft" type="object" class="btn-primary" />
                    <button name="button_approve" string="approve" states="submit" type="object" class="btn-primary" />
                    <button name="button_create_po" string="สร้าง PO" states="approve" type="object" class="btn-secondary" />
                    <button name="button_create" string="ส่งคำขออนุมัติ" states="submit" type="object" class="btn-secondary" />
                    <button name="button_reject" string="reject" states="submit" type="object" class="btn-secondary" />
                    <button name="button_reset" string="reset" states="submit,approve,reject" type="object" class="btn-secondary" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <field name="vendor" required="1" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="purchase_type" required="1" />
                        <field name="purchase_request_name" required="1" />
                        <field name="payment_type" />
                        <field name="purchase_request_id" readonly="1" />
                        <field name="approve_by" readonly="1" />
                        <field name="approve_date" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Product Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="taxes"/>
                                    <field name="subtotal"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="product_uom" domain="[('category_id', '=', product_uom_category_id)]"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_untaxed" readonly="1"/>
                        <field name="amount_tax" readonly="1"/>
                        <field name="amount_total" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- <record id="view_purchase_request_form_search" model="ir.ui.view">
        <field name="name">view.purchase.request.form.search</field>
        <field name="model">purchase.request.form</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record> -->

    <!-- Action purchase.request.form -->
    <record id="action_purchase_request_form" model="ir.actions.act_window">
        <field name="name">Purchase Request Form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Form.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_purchase_request_2_form_act"
        sequence="10"
        parent="menu_purchase_request_2_form"
        action="purchase_request_kmitl_form.action_purchase_request_form"
    />
</odoo>
