<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="substate_id" widget="statusbar" options="{'clickable': 1}" readonly="0" />
                <field name="substate_updated" invisible="1" />
                <button name="action_set_substate" type="object" string="ใส่งบประมาณเสร็จสิ้น" class="btn-primary" attrs="{'invisible': ['|',('substate_updated','=',True),('state', '!=', 'to_approve')]}" groups="purchase_request_substate.group_purchase_request_substate_manager" />
                <button name="action_reset_substate" type="object" string="Reset งบประมาณ" class="btn-secondary" attrs="{'invisible': ['|',('substate_updated','=',False),('state', '!=', 'to_approve')]}" groups="purchase_request_substate.group_purchase_request_substate_manager" />
            </xpath>
        </field>
    </record>
</odoo>
