<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kris_project_state_wizard_form" model="ir.ui.view">
        <field name="name">kris.project.state.wizard.form</field>
        <field name="model">kris.project.state.wizard</field>
        <field name="arch" type="xml">
            <form string="ปรับสถานะโครงการ">
                <field name="current_state" invisible="1" />
                <field name="new_state" invisible="1" />
                <group>
                    <field
                        name="new_state_from_in_progress"
                        widget="radio"
                        attrs="{'invisible': [('current_state', '!=', 'in_progress')], 'required': [('current_state', '=', 'in_progress')]}"
                    />
                    <field
                        name="new_state_from_suspended"
                        widget="radio"
                        attrs="{'invisible': [('current_state', '!=', 'suspended')], 'required': [('current_state', '=', 'suspended')]}"
                    />
                    <field
                        name="note"
                        placeholder="ระบุเหตุผลของการปรับสถานะ..."
                        attrs="{'required': [('new_state', 'not in', ('done', False))]}"
                    />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kris_project_state_wizard" model="ir.actions.act_window">
        <field name="name">ปรับสถานะโครงการ</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">kris.project.state.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
