<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="kris_project.Many2ManyBinaryDocTypeField" owl="1">
        <div t-attf-class="oe_fileupload w-100 {{props.className ? props.className : ''}}" aria-atomic="true">
            <div class="o_attachments_doctype d-flex flex-column gap-2">
                <t t-foreach="files" t-as="file" t-key="file.id">
                    <t t-set="editable" t-value="!props.readonly"/>
                    <t t-set="ext" t-value="getExtension(file)"/>
                    <div class="o_attachment_row d-flex flex-row align-items-center border rounded p-2" t-att-title="file.name">
                        <div class="o_image_box" t-att-data-tooltip="'Download ' + file.name">
                            <a t-att-href="getUrl(file.id)" aria-label="Download" download="">
                                <span class="o_image" t-att-data-mimetype="file.mimetype" t-att-data-ext="ext" role="img"/>
                            </a>
                        </div>
                        <div class="flex-grow-1 ms-2 text-truncate">
                            <div class="text-truncate">
                                <a t-att-href="getUrl(file.id)" download="">
                                    <b t-esc="file.name"/>
                                </a>
                                <span class="badge text-bg-light text-uppercase ms-1" t-esc="ext"/>
                            </div>
                            <div class="small text-muted">
                                <span>Document Type: </span>
                                <span t-if="file.documentTypeName" class="badge text-bg-secondary" t-esc="file.documentTypeName"/>
                                <span t-else="" class="fst-italic">-</span>
                            </div>
                        </div>
                        <div t-if="editable" class="o_attachment_delete btn btn-link text-danger" t-on-click.stop="() => this.onFileRemove(file.id)" title="Delete">
                            <span class="fa fa-trash" role="img" aria-label="Delete"/>
                        </div>
                    </div>
                </t>
            </div>
            <div t-if="!props.readonly" class="oe_add mt-2">
                <button class="btn btn-secondary o_attach" data-tooltip="Attach" t-on-click="onAddClick">
                    <span class="fa fa-paperclip me-1" aria-label="Attach"/> <t t-esc="props.uploadText"/>
                </button>
            </div>
        </div>
    </t>

</templates>
