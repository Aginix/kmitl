<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="kris_project.AttachmentDocTypeDialog" owl="1">
        <Dialog title="env._t('Add Attachment')" size="'md'">
            <div class="mb-3">
                <label class="o_form_label">File</label>
                <input type="file" t-ref="fileInput" class="form-control"/>
            </div>
            <div class="mb-3">
                <label class="o_form_label">Document Type</label>
                <select class="form-select" t-model="state.documentTypeId">
                    <option value="">--</option>
                    <t t-foreach="docTypes" t-as="dt" t-key="dt.id">
                        <option t-att-value="dt.id" t-esc="dt.name"/>
                    </t>
                </select>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave">Save</button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
