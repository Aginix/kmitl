<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ============================================ -->
        <!-- SECURITY GROUPS                              -->
        <!-- ============================================ -->

        <!-- Module Category -->
        <record id="module_category_kris_project" model="ir.module.category">
            <field name="name">KRIS Project</field>
            <field name="description">Revenue tracking for KRIS academic service and research projects</field>
            <field name="sequence">21</field>
        </record>

        <!-- Viewer: Project Manager, read-only access to own projects -->
        <record id="group_kris_project_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="module_category_kris_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Read-only access to projects the user manages (manager_id).</field>
        </record>

        <!-- Officer: KRIS staff, full access to all projects -->
        <record id="group_kris_project_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="category_id" ref="module_category_kris_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager: KRIS admin, full access + configuration -->
        <record id="group_kris_project_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_kris_project"/>
            <field name="implied_ids" eval="[(4, ref('group_kris_project_officer'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- ============================================ -->
        <!-- RECORD RULES for kris.project               -->
        <!-- ============================================ -->

        <!-- Global: Multi-company -->
        <record id="kris_project_company_rule" model="ir.rule">
            <field name="name">KRIS Project: Multi-company</field>
            <field name="model_id" ref="model_kris_project"/>
            <field name="domain_force">[
                '|', ('company_id', '=', False), ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Viewer: projects the user manages -->
        <record id="kris_project_viewer_rule" model="ir.rule">
            <field name="name">KRIS Project Viewer: Managed Projects</field>
            <field name="model_id" ref="model_kris_project"/>
            <field name="groups" eval="[(4, ref('group_kris_project_viewer'))]"/>
            <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>        </record>

        <!-- Officer & Manager: full access -->
        <record id="kris_project_full_rule" model="ir.rule">
            <field name="name">KRIS Project: Full Access</field>
            <field name="model_id" ref="model_kris_project"/>
            <field name="groups" eval="[(4, ref('group_kris_project_officer')), (4, ref('group_kris_project_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ============================================ -->
        <!-- RECORD RULES for kris.project.installment   -->
        <!-- ============================================ -->

        <record id="kris_project_installment_viewer_rule" model="ir.rule">
            <field name="name">KRIS Project Installment Viewer: Managed Projects</field>
            <field name="model_id" ref="model_kris_project_installment"/>
            <field name="groups" eval="[(4, ref('group_kris_project_viewer'))]"/>
            <field name="domain_force">[('project_id.manager_id.user_id', '=', user.id)]</field>        </record>

        <record id="kris_project_installment_full_rule" model="ir.rule">
            <field name="name">KRIS Project Installment: Full Access</field>
            <field name="model_id" ref="model_kris_project_installment"/>
            <field name="groups" eval="[(4, ref('group_kris_project_officer')), (4, ref('group_kris_project_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ============================================ -->
        <!-- RECORD RULES for kris.project.receipt       -->
        <!-- ============================================ -->

        <record id="kris_project_receipt_viewer_rule" model="ir.rule">
            <field name="name">KRIS Project Receipt Viewer: Managed Projects</field>
            <field name="model_id" ref="model_kris_project_receipt"/>
            <field name="groups" eval="[(4, ref('group_kris_project_viewer'))]"/>
            <field name="domain_force">[('project_id.manager_id.user_id', '=', user.id)]</field>        </record>

        <record id="kris_project_receipt_full_rule" model="ir.rule">
            <field name="name">KRIS Project Receipt: Full Access</field>
            <field name="model_id" ref="model_kris_project_receipt"/>
            <field name="groups" eval="[(4, ref('group_kris_project_officer')), (4, ref('group_kris_project_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ============================================ -->
        <!-- RECORD RULES for kris.project.allocation.line -->
        <!-- ============================================ -->

        <record id="kris_project_allocation_viewer_rule" model="ir.rule">
            <field name="name">KRIS Project Allocation Viewer: Managed Projects</field>
            <field name="model_id" ref="model_kris_project_allocation_line"/>
            <field name="groups" eval="[(4, ref('group_kris_project_viewer'))]"/>
            <field name="domain_force">[('project_id.manager_id.user_id', '=', user.id)]</field>        </record>

        <record id="kris_project_allocation_full_rule" model="ir.rule">
            <field name="name">KRIS Project Allocation: Full Access</field>
            <field name="model_id" ref="model_kris_project_allocation_line"/>
            <field name="groups" eval="[(4, ref('group_kris_project_officer')), (4, ref('group_kris_project_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ============================================ -->
        <!-- RECORD RULES for kris.project.installment.allocation -->
        <!-- ============================================ -->

        <record id="kris_project_installment_allocation_viewer_rule" model="ir.rule">
            <field name="name">KRIS Project Installment Allocation Viewer: Managed Projects</field>
            <field name="model_id" ref="model_kris_project_installment_allocation"/>
            <field name="groups" eval="[(4, ref('group_kris_project_viewer'))]"/>
            <field name="domain_force">[('installment_id.project_id.manager_id.user_id', '=', user.id)]</field>        </record>

        <record id="kris_project_installment_allocation_full_rule" model="ir.rule">
            <field name="name">KRIS Project Installment Allocation: Full Access</field>
            <field name="model_id" ref="model_kris_project_installment_allocation"/>
            <field name="groups" eval="[(4, ref('group_kris_project_officer')), (4, ref('group_kris_project_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ============================================ -->
        <!-- RECORD RULES for kris.project.receipt.allocation -->
        <!-- ============================================ -->

        <record id="kris_project_receipt_allocation_viewer_rule" model="ir.rule">
            <field name="name">KRIS Project Receipt Allocation Viewer: Managed Projects</field>
            <field name="model_id" ref="model_kris_project_receipt_allocation"/>
            <field name="groups" eval="[(4, ref('group_kris_project_viewer'))]"/>
            <field name="domain_force">[('receipt_id.project_id.manager_id.user_id', '=', user.id)]</field>        </record>

        <record id="kris_project_receipt_allocation_full_rule" model="ir.rule">
            <field name="name">KRIS Project Receipt Allocation: Full Access</field>
            <field name="model_id" ref="model_kris_project_receipt_allocation"/>
            <field name="groups" eval="[(4, ref('group_kris_project_officer')), (4, ref('group_kris_project_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
