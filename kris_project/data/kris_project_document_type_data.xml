<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="doctype_receipt" model="ir.attachment.document.type">
        <field name="name">เอกสารเบิกจ่ายและใบเสร็จ</field>
        <field name="sequence">20</field>
        <field
            name="res_model_ids"
            eval="[(6, 0, [ref('kris_project.model_kris_project'),
                           ref('kris_project.model_kris_project_receipt')])]"
        />
    </record>

    <record id="doctype_purchase" model="ir.attachment.document.type">
        <field name="name">จัดซื้อจัดจ้าง</field>
        <field name="sequence">30</field>
        <field
            name="res_model_ids"
            eval="[(6, 0, [ref('kris_project.model_kris_project'),
                           ref('kris_project.model_kris_project_receipt')])]"
        />
    </record>

    <record id="doctype_contract" model="ir.attachment.document.type">
        <field name="name">สัญญา</field>
        <field name="sequence">10</field>
        <field
            name="res_model_ids"
            eval="[(6, 0, [ref('kris_project.model_kris_project'),
                           ref('kris_project.model_kris_project_receipt')])]"
        />
    </record>

</odoo>
