<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- kris.project.allocation.item                                 -->
    <!-- ============================================================ -->

    <record id="view_kris_project_allocation_item_tree" model="ir.ui.view">
        <field name="name">kris.project.allocation.item.tree</field>
        <field name="model">kris.project.allocation.item</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_allocation_item_form" model="ir.ui.view">
        <field name="name">kris.project.allocation.item.form</field>
        <field name="model">kris.project.allocation.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kris_project_allocation_item" model="ir.actions.act_window">
        <field name="name">Allocation Item</field>
        <field name="res_model">kris.project.allocation.item</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- kris.project.allocation.template                             -->
    <!-- ============================================================ -->

    <record id="view_kris_project_allocation_template_tree" model="ir.ui.view">
        <field name="name">kris.project.allocation.template.tree</field>
        <field name="model">kris.project.allocation.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_allocation_template_form" model="ir.ui.view">
        <field name="name">kris.project.allocation.template.form</field>
        <field name="model">kris.project.allocation.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <separator string="List"/>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="item_id"/>
                            <field name="allocation_pct" string="Allocation %"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kris_project_allocation_template" model="ir.actions.act_window">
        <field name="name">Allocation Template</field>
        <field name="res_model">kris.project.allocation.template</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
