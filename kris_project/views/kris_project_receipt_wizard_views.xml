<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kris_project_receipt_wizard_form" model="ir.ui.view">
        <field name="name">kris.project.receipt.wizard.form</field>
        <field name="model">kris.project.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Revenue Record">
                <field name="currency_id" invisible="1"/>
                <field name="available_installment_ids" invisible="1"/>
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="name"/>
                    <field
                        name="installment_id"
                        domain="[('id', 'in', available_installment_ids)]"
                    />
                    <field name="date"/>
                    <field name="equipment_cost_in_installment"/>
                    <field name="amount"/>
                    <field name="net_amount" readonly="1"/>
                    <field name="note"/>
                </group>
                <separator string="Allocation based on revenue."/>
                <field name="allocation_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="allocation_line_id" invisible="1"/>
                        <field name="name" readonly="1" string="Allocator"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button
                        name="action_save"
                        string="Save"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
