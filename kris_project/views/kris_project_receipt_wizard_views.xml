<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kris_project_receipt_wizard_form" model="ir.ui.view">
        <field name="name">kris.project.receipt.wizard.form</field>
        <field name="model">kris.project.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Revenue Record">
                <field name="currency_id" invisible="1" />
                <group>
                    <field name="project_id" readonly="1" />
                    <field name="name" />
                    <field
                        name="installment_id"
                        domain="[('project_id', '=', project_id)]"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                    <field name="date" />
                    <field name="equipment_cost_in_installment" />
                    <field name="amount" />
                    <field name="extra_income" />
                    <field name="net_amount" readonly="1" />
                    <field name="note" />
                </group>
                <notebook>
                    <page string="Allocation">
                        <field name="allocation_ids">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="allocation_line_id" invisible="1" />
                                <field name="name" readonly="1" string="Allocator" />
                                <field name="remaining_amount" readonly="1" />
                                <field name="amount" />
                                <field name="currency_id" invisible="1" />
                            </tree>
                        </field>
                    </page>
                    <page string="Attachments">
                        <group name="attachment" string="Attachment">
                            <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                nolabel="1"
                                colspan="2"
                            />
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button
                        name="action_save"
                        string="Save"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
