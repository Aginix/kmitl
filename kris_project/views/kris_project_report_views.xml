<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- INSTALLMENT REPORT (flatten installment_ids)                -->
    <!-- ============================================================ -->

    <record id="view_kris_project_installment_report_pivot" model="ir.ui.view">
        <field name="name">kris.project.installment.report.pivot</field>
        <field name="model">kris.project.installment.report</field>
        <field name="arch" type="xml">
            <pivot string="Installment Analysis" sample="1" disable_linking="True">
                <field name="account_fiscal_year_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
                <field name="maintenance_fee" type="measure"/>
                <field name="amount_net" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kris_project_installment_report_graph" model="ir.ui.view">
        <field name="name">kris.project.installment.report.graph</field>
        <field name="model">kris.project.installment.report</field>
        <field name="arch" type="xml">
            <graph string="Installment Analysis" sample="1" type="bar">
                <field name="account_fiscal_year_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kris_project_installment_report_tree" model="ir.ui.view">
        <field name="name">kris.project.installment.report.tree</field>
        <field name="model">kris.project.installment.report</field>
        <field name="arch" type="xml">
            <tree string="Installment Analysis" create="0" edit="0" delete="0">
                <field name="currency_id" invisible="1"/>
                <field name="project_id"/>
                <field name="project_name" optional="show"/>
                <field name="project_category_id" optional="show"/>
                <field name="project_type_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="account_fiscal_year_id" optional="show"/>
                <field name="department_analytic_id_lvl1" optional="show"/>
                <field name="department_analytic_id_lvl2" optional="hide"/>
                <field name="department_analytic_id_lvl3" optional="hide"/>
                <field name="due_date" optional="show"/>
                <field name="state" optional="show"/>
                <field name="amount" sum="รวม" optional="show"/>
                <field name="maintenance_fee" sum="รวม" optional="show"/>
                <field name="extra_income" sum="รวม" optional="hide"/>
                <field name="amount_net" sum="รวม" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_installment_report_search" model="ir.ui.view">
        <field name="name">kris.project.installment.report.search</field>
        <field name="model">kris.project.installment.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="project_name"/>
                <field name="manager_id"/>
                <field name="department_analytic_id"/>
                <field name="project_category_id"/>
                <field name="project_type_id"/>
                <filter name="received" string="รับเงินแล้ว" domain="[('state', '=', 'received')]"/>
                <filter name="partial" string="รับบางส่วน" domain="[('state', '=', 'partial')]"/>
                <filter name="pending" string="รอรับเงิน" domain="[('state', '=', 'pending')]"/>
                <separator/>
                <filter name="due_date" string="Date Due" date="due_date"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_fiscal_year" string="Fiscal Year" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter name="group_category" string="Project Category" context="{'group_by': 'project_category_id'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_state" string="Installment State" context="{'group_by': 'state'}"/>
                    <filter name="group_dept_lvl1" string="ส่วนงาน Lv.1" context="{'group_by': 'department_analytic_id_lvl1'}"/>
                    <filter name="group_dept_lvl2" string="ส่วนงาน Lv.2" context="{'group_by': 'department_analytic_id_lvl2'}"/>
                    <filter name="group_dept_lvl3" string="ส่วนงาน Lv.3" context="{'group_by': 'department_analytic_id_lvl3'}"/>
                    <filter name="group_due_date" string="Date Due" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kris_project_installment_report" model="ir.actions.act_window">
        <field name="name">รายงานงวดงาน</field>
        <field name="res_model">kris.project.installment.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_kris_project_installment_report_search"/>
    </record>

    <!-- ============================================================ -->
    <!-- REVENUE / RECEIPT REPORT (flatten receipt_ids)              -->
    <!-- ============================================================ -->

    <record id="view_kris_project_receipt_report_pivot" model="ir.ui.view">
        <field name="name">kris.project.receipt.report.pivot</field>
        <field name="model">kris.project.receipt.report</field>
        <field name="arch" type="xml">
            <pivot string="Revenue Analysis" sample="1" disable_linking="True">
                <field name="account_fiscal_year_id" type="row"/>
                <field name="project_category_id" type="col"/>
                <field name="project_value" type="measure"/>
                <field name="amount" type="measure"/>
                <field name="net_amount" type="measure"/>
                <field name="revenue_remaining" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kris_project_receipt_report_graph" model="ir.ui.view">
        <field name="name">kris.project.receipt.report.graph</field>
        <field name="model">kris.project.receipt.report</field>
        <field name="arch" type="xml">
            <graph string="Revenue Analysis" sample="1" type="bar">
                <field name="date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kris_project_receipt_report_tree" model="ir.ui.view">
        <field name="name">kris.project.receipt.report.tree</field>
        <field name="model">kris.project.receipt.report</field>
        <field name="arch" type="xml">
            <tree string="Revenue Analysis" create="0" edit="0" delete="0">
                <field name="currency_id" invisible="1"/>
                <field name="project_id"/>
                <field name="project_name" optional="show"/>
                <field name="installment_id" optional="show"/>
                <field name="project_category_id" optional="show"/>
                <field name="project_type_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="account_fiscal_year_id" optional="show"/>
                <field name="department_analytic_id_lvl1" optional="show"/>
                <field name="department_analytic_id_lvl2" optional="hide"/>
                <field name="department_analytic_id_lvl3" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="project_value" sum="รวม" optional="show"/>
                <field name="amount" sum="รวม" optional="show"/>
                <field name="equipment_cost_in_installment" sum="รวม" optional="hide"/>
                <field name="extra_income" sum="รวม" optional="hide"/>
                <field name="net_amount" sum="รวม" optional="show"/>
                <field name="revenue_remaining" sum="รวม" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_receipt_report_search" model="ir.ui.view">
        <field name="name">kris.project.receipt.report.search</field>
        <field name="model">kris.project.receipt.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="project_name"/>
                <field name="manager_id"/>
                <field name="department_analytic_id"/>
                <field name="project_category_id"/>
                <field name="project_type_id"/>
                <filter name="date" string="Receipt Date" date="date"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_fiscal_year" string="Fiscal Year" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter name="group_category" string="Project Category" context="{'group_by': 'project_category_id'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_dept_lvl1" string="ส่วนงาน Lv.1" context="{'group_by': 'department_analytic_id_lvl1'}"/>
                    <filter name="group_dept_lvl2" string="ส่วนงาน Lv.2" context="{'group_by': 'department_analytic_id_lvl2'}"/>
                    <filter name="group_dept_lvl3" string="ส่วนงาน Lv.3" context="{'group_by': 'department_analytic_id_lvl3'}"/>
                    <filter name="group_date" string="Receipt Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kris_project_receipt_report" model="ir.actions.act_window">
        <field name="name">รายงานรายได้/ใบเสร็จ</field>
        <field name="res_model">kris.project.receipt.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_kris_project_receipt_report_search"/>
    </record>

    <!-- ============================================================ -->
    <!-- ALLOCATION REPORT (flatten allocation_line_ids)             -->
    <!-- ============================================================ -->

    <record id="view_kris_project_allocation_report_pivot" model="ir.ui.view">
        <field name="name">kris.project.allocation.report.pivot</field>
        <field name="model">kris.project.allocation.report</field>
        <field name="arch" type="xml">
            <pivot string="Allocation Analysis" sample="1" disable_linking="True">
                <field name="department_analytic_id_lvl1" type="row"/>
                <field name="name" type="col"/>
                <field name="estimated_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kris_project_allocation_report_graph" model="ir.ui.view">
        <field name="name">kris.project.allocation.report.graph</field>
        <field name="model">kris.project.allocation.report</field>
        <field name="arch" type="xml">
            <graph string="Allocation Analysis" sample="1" type="bar">
                <field name="name"/>
                <field name="actual_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kris_project_allocation_report_tree" model="ir.ui.view">
        <field name="name">kris.project.allocation.report.tree</field>
        <field name="model">kris.project.allocation.report</field>
        <field name="arch" type="xml">
            <tree string="Allocation Analysis" create="0" edit="0" delete="0">
                <field name="currency_id" invisible="1"/>
                <field name="project_id"/>
                <field name="project_name" optional="show"/>
                <field name="name" optional="show"/>
                <field name="project_category_id" optional="show"/>
                <field name="project_type_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
                <field name="account_fiscal_year_id" optional="show"/>
                <field name="department_analytic_id" optional="show"/>
                <field name="department_analytic_id_lvl1" optional="hide"/>
                <field name="department_analytic_id_lvl2" optional="hide"/>
                <field name="department_analytic_id_lvl3" optional="hide"/>
                <field name="estimated_amount" sum="รวม" optional="show"/>
                <field name="actual_amount" sum="รวม" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_allocation_report_search" model="ir.ui.view">
        <field name="name">kris.project.allocation.report.search</field>
        <field name="model">kris.project.allocation.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="project_name"/>
                <field name="manager_id"/>
                <field name="item_id"/>
                <field name="department_analytic_id"/>
                <field name="project_category_id"/>
                <field name="project_type_id"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_allocator" string="Allocator" context="{'group_by': 'name'}"/>
                    <filter name="group_fiscal_year" string="Fiscal Year" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter name="group_category" string="Project Category" context="{'group_by': 'project_category_id'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_dept_lvl1" string="ส่วนงาน Lv.1" context="{'group_by': 'department_analytic_id_lvl1'}"/>
                    <filter name="group_dept_lvl2" string="ส่วนงาน Lv.2" context="{'group_by': 'department_analytic_id_lvl2'}"/>
                    <filter name="group_dept_lvl3" string="ส่วนงาน Lv.3" context="{'group_by': 'department_analytic_id_lvl3'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kris_project_allocation_report" model="ir.actions.act_window">
        <field name="name">รายงานการจัดสรร</field>
        <field name="res_model">kris.project.allocation.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_kris_project_allocation_report_search"/>
    </record>

</odoo>
