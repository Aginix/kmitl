<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kris_project_expense_type_tree" model="ir.ui.view">
        <field name="name">kris.project.expense.type.tree</field>
        <field name="model">kris.project.expense.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_ids" widget="many2many_tags"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_expense_type_form" model="ir.ui.view">
        <field name="name">kris.project.expense.type.form</field>
        <field name="model">kris.project.expense.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kris_project_expense_type" model="ir.actions.act_window">
        <field name="name">Expense Type</field>
        <field name="res_model">kris.project.expense.type</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
