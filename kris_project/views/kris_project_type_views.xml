<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- CATEGORY (ประเภทโครงการ)                                      -->
    <!-- ============================================================ -->

    <record id="view_kris_project_category_form" model="ir.ui.view">
        <field name="name">kris.project.category.form</field>
        <field name="model">kris.project.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <separator string="Project Type"/>
                    <field name="type_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kris_project_category_tree" model="ir.ui.view">
        <field name="name">kris.project.category.tree</field>
        <field name="model">kris.project.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="action_kris_project_category" model="ir.actions.act_window">
        <field name="name">Project Category</field>
        <field name="res_model">kris.project.category</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
