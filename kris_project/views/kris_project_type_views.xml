<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kris_project_type_tree" model="ir.ui.view">
        <field name="name">kris.project.type.tree</field>
        <field name="model">kris.project.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
            </tree>
        </field>
    </record>

    <record id="view_kris_project_type_search" model="ir.ui.view">
        <field name="name">kris.project.type.search</field>
        <field name="model">kris.project.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="academic_service" string="งานบริการวิชาการ"
                    domain="[('category', '=', 'academic_service')]"/>
                <filter name="research" string="งานวิจัย"
                    domain="[('category', '=', 'research')]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_category" string="หมวดหมู่"
                        context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kris_project_type" model="ir.actions.act_window">
        <field name="name">ประเภทโครงการ</field>
        <field name="res_model">kris.project.type</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_kris_project_type_search"/>
    </record>

</odoo>
