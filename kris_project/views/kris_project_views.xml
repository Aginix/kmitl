<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- RECEIPT FORM VIEW                                             -->
    <!-- ============================================================ -->

    <record id="view_kris_project_receipt_form" model="ir.ui.view">
        <field name="name">kris.project.receipt.form</field>
        <field name="model">kris.project.receipt</field>
        <field name="arch" type="xml">
            <form string="Revenue Record">
                <field name="currency_id" invisible="1"/>
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="name"/>
                    <field name="installment_id"/>
                    <field name="date"/>
                    <field name="deductible_cost_in_installment"/>
                    <field name="amount"/>
                    <field name="extra_income"/>
                    <field name="net_amount" readonly="1"/>
                    <field name="note"/>
                </group>
                <separator string="Allocation based on revenue."/>
                <field name="allocation_ids">
                    <tree create="0" delete="0" editable="bottom">
                        <field name="allocation_line_id" invisible="1" />
                        <field name="name" string="Allocator" />
                        <field name="remaining_amount" readonly="1" />
                        <field name="amount" />
                        <field name="currency_id" invisible="1" />
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- INSTALLMENT FORM VIEW                                       -->
    <!-- ============================================================ -->

    <record id="view_kris_project_installment_form" model="ir.ui.view">
        <field name="name">kris.project.installment.form</field>
        <field name="model">kris.project.installment</field>
        <field name="arch" type="xml">
            <form string="Installment">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group name="installment_infomation" string="Installment Infomation">
                        <field name="project_id" readonly="1"/>
                        <field name="name"/>
                        <field name="due_date"/>
                        <field name="state" widget="badge"
                            decoration-info="state == 'pending'"
                            decoration-warning="state == 'partial'"
                            decoration-success="state == 'received'"
                        />
                    </group>
                    <group name="finance" string="Finance">
                        <field name="amount"/>
                        <field name="deduction_guarantee"/>
                        <field name="deduction_advance"/>
                        <field name="extra_income"/>
                        <field name="received_from_employer" readonly="1"/>
                        <field name="maintenance_fee" readonly="1"/>
                        <field name="extra_deduction"/>
                        <field name="amount_net" readonly="1"/>
                    </group>
                </group>
                <separator string="Installment allocation"/>
                <field name="allocation_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="allocation_line_id" invisible="1"/>
                        <field name="name" readonly="1" string="Allocator"/>
                        <field name="estimated_amount" readonly="1"/>
                        <field name="allocated_amount" readonly="1"/>
                        <field name="remaining_amount" readonly="1"/>
                        <field name="amount" sum="รวม"/>
                        <field name="currency_id" invisible="1"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                    -->
    <!-- ============================================================ -->

    <record id="view_kris_project_form" model="ir.ui.view">
        <field name="name">kris.project.form</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <form class="kris_project_form">
                <header>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        states="draft"
                        groups="kris_project.group_kris_project_officer"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        states="draft"
                        groups="kris_project.group_kris_project_officer"
                    />
                    <button
                        name="%(kris_project.action_kris_project_state_wizard)d"
                        string="Change Project Status"
                        type="action"
                        class="btn-primary"
                        states="in_progress,suspended"
                        groups="kris_project.group_kris_project_officer"
                        context="{'active_id': active_id, 'active_model': 'kris.project'}"
                    />
                    <button
                        name="action_draft"
                        string="Reset to Draft"
                        type="object"
                        states="cancel,in_progress,done,terminated,conditional_close"
                        groups="kris_project.group_kris_project_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,in_progress,done"
                        attrs="{'invisible': [('state', 'in', ('terminated', 'conditional_close', 'cancel'))]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,in_progress"
                        attrs="{'invisible': [('state', 'not in', ('terminated', 'conditional_close', 'cancel'))]}"
                    />
                </header>
                <div class="alert alert-danger" role="alert" style="margin-bottom:0px;"
                    attrs="{'invisible': [('exceptions_summary', '=', False)]}">
                    <p><strong>Exception:</strong></p>
                    <field name="exceptions_summary"/>
                </div>
                <sheet>
                    <field name="can_edit" invisible="1"/>
                    <field name="installment_editable" invisible="1"/>
                    <field name="warn_allocation_mismatch" invisible="1"/>
                    <field name="warn_installment_maintenance_mismatch" invisible="1"/>
                    <field name="warn_installment_total_mismatch" invisible="1"/>
                    <field name="warn_extra_overshoot" invisible="1"/>
                    <field name="warn_cancel_with_receipts" invisible="1"/>
                    <field name="warn_maintenance_exceeds_expense" invisible="1"/>
                    <field name="warn_expense_exceeds_value" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                        attrs="{'invisible': [('warn_cancel_with_receipts', '=', False)]}">
                        โครงการนี้มีการบันทึกรายรับแล้ว โปรดตรวจสอบก่อนยกเลิกโครงการ
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h1>
                            <field
                                name="project_name"
                                placeholder="Project Name..."
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                        </h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group name="project_information" string="Project Information">
                            <field
                                name="project_category_id"
                                widget="selection"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <field
                                name="project_type_id"
                                widget="radio"
                                domain="[('category_id', '=', project_category_id)]"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <field
                                name="manager_id"
                                required="1"
                                widget="employee_detail_many2one"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />

                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <field
                                name="department_analytic_id"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                        </group>
                        <group name="contract_information" string="Contract Information">
                            <field
                                name="contract_number"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <label for="date_contract_start" string="Date Start" />
                            <div name="date_contract_start_div" class="o_row">
                                <field name="date_contract_start"
                                    widget="daterange"
                                    options='{"related_end_date": "date_contract_end"}'
                                    attrs="{'readonly': [('can_edit', '=', False)]}" />
                                <i
                                    class="fa fa-long-arrow-right mx-2 oe_edit_only"
                                    aria-label="Arrow icon"
                                    title="Arrow"
                                />
                                <field name="date_contract_end"
                                    widget="daterange"
                                    options='{"related_start_date": "date_contract_start"}'
                                    attrs="{'readonly': [('can_edit', '=', False)]}" />
                            </div>
                            <label for="project_duration"/>
                            <div>
                                <field name="project_duration" class="oe_inline"/> Day
                            </div>
                            <field
                                name="account_fiscal_year_id"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                        </group>
                    </group>
                    <group>
                        <group name="client_funding_organization" string="Client/Funding Organization">
                            <field
                                name="client_name"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <field
                                name="client_location"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <field
                                name="client_tax_number"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                            <field
                                name="client_org_type"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab 1: มูลค่าและงวดงาน -->
                        <page string="Financials" name="financials">
                            <group>
                                <group name="project_value" string="1. Project Value">
                                    <field
                                        name="project_value"
                                        attrs="{'readonly': [('can_edit', '=', False)]}"
                                    />
                                    <field
                                        name="extra_value"
                                        attrs="{'readonly': [('can_edit', '=', False)]}"
                                    />
                                    <field
                                        name="extra_analytic_id"
                                        attrs="{'readonly': [('can_edit', '=', False)]}"
                                    />
                                    <field name="operating_expense" readonly="1"/>
                                </group>
                                <group name="allocation" string="Allocation">
                                    <field name="allocatable_value" readonly="1"/>
                                    <field
                                        name="maintenance_deduction_type"
                                        attrs="{'readonly': [('can_edit', '=', False)]}"
                                        widget="radio"
                                    />
                                    <field
                                        name="maintenance_deduction_pct"
                                        attrs="{
                                            'invisible': [('maintenance_deduction_type', '!=', 'custom')],
                                            'readonly': [('can_edit', '=', False)]
                                        }"
                                    />
                                    <field
                                        name="maintenance_deduction_fixed_amount"
                                        attrs="{
                                            'invisible': [('maintenance_deduction_type', '!=', 'fixed')],
                                            'readonly': [('can_edit', '=', False)]
                                        }"
                                    />
                                    <field name="maintenance_deduction_amount" readonly="1"/>
                                </group>
                            </group>
                            <separator string="ค่าใช้จ่าย (หักก่อนคิดค่าบำรุง)" name="expense_line_separator" />
                            <div class="alert alert-danger mb-2" role="alert"
                                attrs="{'invisible': [('warn_expense_exceeds_value', '=', False)]}"
                            >
                                ยอดค่าใช้จ่ายรวมเกินมูลค่าโครงการ กรุณาตรวจสอบรายการค่าใช้จ่าย
                            </div>
                            <field
                                name="expense_line_ids"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                                context="{'default_project_id': active_id}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="expense_type_id"
                                        domain="['|', ('category_ids', '=', False), ('category_ids', 'in', parent.project_category_id)]"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                    />
                                    <field name="amount" sum="รวม"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <separator string="2. Allocate Income" name="allocation_separator" />
                            <group>
                                <group>
                                    <field name="maintenance_deduction_amount"
                                        readonly="1"
                                        string="Maintenance Deduction Value"
                                    />
                                </group>
                            </group>
                            <div class="alert alert-danger mb-2" role="alert"
                                attrs="{'invisible': [('warn_maintenance_exceeds_expense', '=', False)]}"
                            >
                                มูลค่าหักค่าบำรุงเกินค่าดำเนินการ (Operating Expense) กรุณาตรวจสอบวิธีคิดค่าบำรุง
                            </div>
                            <div class="mb-3"
                                attrs="{'invisible': [('can_edit', '=', False)]}"
                                groups="kris_project.group_kris_project_officer"
                            >
                                <field
                                    name="allocation_template_id"
                                    nolabel="1"
                                    class="d-inline-block me-2"
                                    style="min-width: 250px;"
                                    placeholder="Choose Template..."
                                />
                                <button
                                    name="action_apply_allocation_template"
                                    string="Template"
                                    type="object"
                                    class="btn-secondary"
                                />
                            </div>
                            <div class="alert alert-danger mb-2" role="alert"
                                attrs="{'invisible': [('warn_allocation_mismatch', '=', False)]}"
                            >
                                The total allocated revenue does not equal the value minus maintenance fees. กรุณาตรวจสอบการจัดสรร
                            </div>
                            <field
                                name="allocation_line_ids"
                                attrs="{'readonly': [('can_edit', '=', False)]}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_id"
                                        attrs="{'readonly': [('is_locked', '=', True)]}"
                                    />
                                    <field name="department_analytic_id"
                                        attrs="{'readonly': [('is_locked', '=', True)]}"
                                    />
                                    <field name="is_locked" invisible="1"/>
                                    <field name="allocation_pct" string="Allocation %" readonly="1" sum="รวม"/>
                                    <field name="estimated_amount" sum="รวม"/>
                                    <field name="actual_amount" readonly="1" sum="รวม"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <separator string="3. Contract payment installments" name="installment_separator" />
                            <group>
                                <field
                                    name="no_installment_tracking"
                                    attrs="{'readonly': [('can_edit', '=', False)]}"
                                />
                            </group>
                            <div class="alert alert-danger mb-2" role="alert"
                                attrs="{'invisible': [('warn_extra_overshoot', '=', False)]}"
                            >
                                ยอดค่า Extra รวมทุกงวดเกินจากยอดค่า Extra โครงการ กรุณาตรวจสอบการกำหนดค่า Extra แต่ละงวด
                            </div>
                            <div class="alert alert-danger mb-2" role="alert"
                                attrs="{'invisible': [('warn_installment_total_mismatch', '=', False)]}"
                            >
                                The sum of the amounts received in each payment installment does not equal the project value. Please check the payment installments.
                            </div>
                            <div class="alert alert-danger mb-2" role="alert"
                                attrs="{'invisible': [('warn_installment_maintenance_mismatch', '=', False)]}"
                            >
                                The sum of institutional maintenance fees in the work period does not equal the value after deduction of maintenance fees. Please check the allocation for each period.
                            </div>
                            <div class="mb-3"
                                attrs="{'invisible': [('installment_editable', '=', False)]}"
                                groups="kris_project.group_kris_project_officer"
                            >
                                <button
                                    name="action_add_installment"
                                    string="Add Installment"
                                    type="object"
                                    class="btn-secondary"
                                />
                            </div>
                            <field
                                name="installment_ids"
                                attrs="{'readonly': [('installment_editable', '=', False)]}"
                            >
                                <tree create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="deduction_guarantee" sum="รวม" optional="show"/>
                                    <field name="deduction_advance" sum="รวม" optional="show"/>
                                    <field name="received_from_employer" sum="รวม" optional="show"/>
                                    <field name="maintenance_fee" sum="รวม" optional="show"/>
                                    <field name="extra_deduction" sum="รวม" optional="show"/>
                                    <field name="extra_income" sum="รวม" optional="show"/>
                                    <field name="amount_net" sum="รวม" optional="show"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'pending'"
                                        decoration-warning="state == 'partial'"
                                        decoration-success="state == 'received'"
                                    />
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group>
                                <field name="total_installment_amount" readonly="1"/>
                            </group>
                        </page>

                        <!-- Tab 2: รายรับ -->
                        <page string="Revenue" name="receipts">
                            <group>
                                <group>
                                    <field name="total_received_amount" readonly="1"/>
                                    <field name="total_net_received" readonly="1"/>
                                    <field name="revenue_remaining" readonly="1"/>
                                    <field
                                        name="over_revenue"
                                        readonly="1"
                                        attrs="{'invisible': [('over_revenue', '=', 0.0)]}"
                                    />
                                </group>
                            </group>
                            <separator string="Revenue Record"/>
                            <div class="mb-3"
                                attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"
                                groups="kris_project.group_kris_project_officer"
                            >
                                <button
                                    name="action_add_receipt"
                                    string="Add Revenue"
                                    type="object"
                                    class="btn-secondary"
                                />
                            </div>
                            <field
                                name="receipt_ids"
                            >
                                <tree create="0">
                                    <field name="project_id" invisible="1"/>
                                    <field name="project_state" invisible="1"/>
                                    <field name="name"/>
                                    <field name="installment_id"/>
                                    <field name="date"/>
                                    <field name="deductible_cost_in_installment" sum="รวม"/>
                                    <field name="amount" sum="รวม"/>
                                    <field name="net_amount" sum="รวม"/>
                                    <field name="note"/>
                                    <field name="currency_id" invisible="1"/>
                                    <button
                                        name="action_delete"
                                        type="object"
                                        icon="fa-trash"
                                        title="Delete"
                                        attrs="{'invisible': [('project_state', 'in', ['done', 'cancel'])]}"
                                        groups="kris_project.group_kris_project_officer"
                                    />
                                </tree>
                            </field>
                        </page>

                        <!-- Tab 3: เอกสารแนบ -->
                        <page string="Attachment" name="attachments">
                            <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                string="File"
                            />
                        </page>

                        <!-- Tab 4: หมายเหตุ -->
                        <page string="Note" name="notes">
                            <field name="note" placeholder="Note..." nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- TREE VIEW                                                    -->
    <!-- ============================================================ -->

    <record id="view_kris_project_tree" model="ir.ui.view">
        <field name="name">kris.project.tree</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="main_exception_id"
                decoration-muted="state == 'cancel'"
            >
                <field name="currency_id" invisible="1"/>
                <field name="name"/>
                <field name="project_name"/>
                <field name="contract_number" optional="hide"/>
                <field name="project_category_id" optional="show"/>
                <field name="project_type_id" optional="hide"/>
                <field name="manager_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="department_analytic_id" optional="show"/>
                <field name="client_name" optional="hide"/>
                <field name="account_fiscal_year_id" optional="show"/>
                <field name="project_value" sum="รวม" optional="show"/>
                <field name="total_received_amount" sum="รวม" optional="show"/>
                <field name="revenue_remaining" sum="รวม" optional="hide"/>
                <field name="main_exception_id" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"
                />
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW                                                  -->
    <!-- ============================================================ -->

    <record id="view_kris_project_search" model="ir.ui.view">
        <field name="name">kris.project.search</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Project"
                    filter_domain="['|', '|', '|', ('name', 'ilike', self), ('project_name', 'ilike', self), ('contract_number', 'ilike', self), ('client_name', 'ilike', self)]"/>
                <field name="project_name" string="Project Name"/>
                <field name="contract_number"/>
                <field name="client_name"/>
                <field name="manager_id"/>
                <field name="department_analytic_id"/>
                <field name="user_id"/>
                <field name="project_category_id"/>
                <field name="project_type_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancel" string="Cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter
                    name="has_exceptions"
                    string="มี Exception"
                    domain="[('main_exception_id', '!=', False)]"
                />
                <filter
                    name="my_projects"
                    string="My Project"
                    domain="[('user_id', '=', uid)]"
                />
                <separator/>
                <filter name="contract_start" string="Contract Start Date" date="date_contract_start"/>
                <!-- Group By -->
                <group expand="0" name="group_by" string="จัดกลุ่มตาม">
                    <filter name="group_category" string="Project Category" context="{'group_by': 'project_category_id'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_fiscal_year" string="Fiscal Year" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_analytic_id'}"/>
                </group>
                <searchpanel>
                    <field name="account_fiscal_year_id" icon="fa-calendar" enable_counters="1"/>
                    <field name="project_category_id" icon="fa-folder" enable_counters="1"/>
                    <field name="department_analytic_id" icon="fa-building-o" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- PIVOT VIEW                                                   -->
    <!-- ============================================================ -->

    <record id="view_kris_project_pivot" model="ir.ui.view">
        <field name="name">kris.project.pivot</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <pivot string="KRIS Project Analysis" disable_linking="True">
                <field name="project_category_id" type="row"/>
                <field name="project_type_id" type="row"/>
                <field name="project_value" type="measure"/>
                <field name="maintenance_deduction_amount" type="measure"/>
                <field name="total_received_amount" type="measure"/>
                <field name="total_net_received" type="measure"/>
                <field name="revenue_remaining" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                       -->
    <!-- ============================================================ -->

    <record id="action_kris_project_exception_rule" model="ir.actions.act_window">
        <field name="name">Exception Rules</field>
        <field name="res_model">exception.rule</field>
