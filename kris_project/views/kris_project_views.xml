<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- INSTALLMENT FORM VIEW                                       -->
    <!-- ============================================================ -->

    <record id="view_kris_project_installment_form" model="ir.ui.view">
        <field name="name">kris.project.installment.form</field>
        <field name="model">kris.project.installment</field>
        <field name="arch" type="xml">
            <form string="งวดงาน">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group string="ข้อมูลงวด">
                        <field name="project_id" readonly="1"/>
                        <field name="name"/>
                        <field name="due_date"/>
                        <field name="state" widget="badge"
                            decoration-info="state == 'pending'"
                            decoration-success="state == 'received'"
                        />
                    </group>
                    <group string="การเงิน">
                        <field name="amount"/>
                        <field name="deduction_guarantee"/>
                        <field name="deduction_advance"/>
                        <field name="received_from_employer" readonly="1"/>
                        <field name="maintenance_fee" readonly="1"/>
                        <field name="extra_deduction"/>
                        <field name="amount_net" readonly="1"/>
                    </group>
                </group>
                <separator string="การจัดสรรตามงวด"/>
                <field name="allocation_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="allocation_line_id" string="ผู้รับจัดสรร" readonly="1"/>
                        <field name="amount" sum="รวม"/>
                        <field name="currency_id" invisible="1"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                    -->
    <!-- ============================================================ -->

    <record id="view_kris_project_form" model="ir.ui.view">
        <field name="name">kris.project.form</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_confirm"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                        states="draft"
                    />
                    <button
                        name="action_done"
                        string="เสร็จสิ้น"
                        type="object"
                        class="btn-primary"
                        states="confirmed"
                    />
                    <button
                        name="action_cancel"
                        string="ยกเลิก"
                        type="object"
                        states="draft,confirmed"
                    />
                    <button
                        name="action_draft"
                        string="รีเซ็ตเป็นร่าง"
                        type="object"
                        states="cancel"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field
                                name="project_name"
                                placeholder="ชื่อโครงการ..."
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                        </h2>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group string="ข้อมูลโครงการ">
                            <field
                                name="project_category_id"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="project_type_id"
                                domain="[('category_id', '=', project_category_id)]"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="partner_id"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="client_org_type"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="leader_id"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="faculty_id"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="department_id"
                                domain="[('parent_id', '=', faculty_id)]"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                        </group>
                        <group string="ข้อมูลสัญญา">
                            <field
                                name="contract_number"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="date_contract_start"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="date_contract_end"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="project_duration"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                            <field
                                name="account_fiscal_year_id"
                                attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab 1: มูลค่าและงวดงาน -->
                        <page string="มูลค่าและงวดงาน" name="financials">
                            <group>
                                <group string="มูลค่าโครงการ">
                                    <field
                                        name="project_value"
                                        attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                                    />
                                    <field
                                        name="equipment_cost"
                                        attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                                    />
                                    <field
                                        name="operating_expense"
                                        attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                                    />
                                </group>
                                <group string="การจัดสรร">
                                    <field name="allocatable_value" readonly="1"/>
                                    <field
                                        name="maintenance_deduction_type"
                                        attrs="{'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]}"
                                        widget="radio"
                                    />
                                    <field
                                        name="maintenance_deduction_pct"
                                        attrs="{
                                            'invisible': [('maintenance_deduction_type', '!=', 'custom')],
                                            'readonly': [('state', 'in', ['confirmed', 'done', 'cancel'])]
                                        }"
                                    />
                                    <field name="maintenance_deduction_amount" readonly="1"/>
                                </group>
                            </group>
                            <separator string="งวดงานตามสัญญา"/>
                            <div class="mb-3"
                                attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"
                            >
                                <button
                                    name="action_add_installment"
                                    string="เพิ่มงวด"
                                    type="object"
                                    class="btn-secondary"
                                />
                            </div>
                            <field
                                name="installment_ids"
                                attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"
                            >
                                <tree create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount" sum="รวม"/>
                                    <field name="deduction_guarantee" sum="รวม" optional="show"/>
                                    <field name="deduction_advance" sum="รวม" optional="show"/>
                                    <field name="received_from_employer" sum="รวม" optional="show"/>
                                    <field name="maintenance_fee" sum="รวม" optional="show"/>
                                    <field name="extra_deduction" sum="รวม" optional="show"/>
                                    <field name="amount_net" sum="รวม" optional="show"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'pending'"
                                        decoration-success="state == 'received'"
                                    />
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group>
                                <field name="total_installment_amount" readonly="1"/>
                            </group>
                        </page>

                        <!-- Tab 2: รายรับ -->
                        <page string="รายรับ" name="receipts">
                            <group>
                                <group>
                                    <field name="total_received_amount" readonly="1"/>
                                    <field name="total_net_received" readonly="1"/>
                                    <field name="revenue_remaining" readonly="1"/>
                                </group>
                            </group>
                            <separator string="บันทึกรายรับ"/>
                            <div class="mb-3"
                                attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"
                            >
                                <button
                                    name="action_add_receipt"
                                    string="เพิ่มรายรับ"
                                    type="object"
                                    class="btn-secondary"
                                />
                            </div>
                            <field
                                name="receipt_ids"
                                attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"
                            >
                                <tree create="0">
                                    <field name="project_id" invisible="1"/>
                                    <field name="name"/>
                                    <field name="installment_id"/>
                                    <field name="date"/>
                                    <field name="equipment_cost_in_installment" sum="รวม"/>
                                    <field name="amount" sum="รวม"/>
                                    <field name="net_amount" sum="รวม"/>
                                    <field name="note"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Tab 3: การจัดสรรรายได้ -->
                        <page string="การจัดสรรรายได้" name="allocation">
                            <group>
                                <group>
                                    <field name="maintenance_deduction_amount"
                                        readonly="1"
                                        string="มูลค่าหักค่าบำรุงที่นำมาจัดสรร"
                                    />
                                </group>
                            </group>
                            <div class="mb-3"
                                attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"
                            >
                                <field
                                    name="allocation_template_id"
                                    nolabel="1"
                                    class="d-inline-block me-2"
                                    style="min-width: 250px;"
                                    placeholder="เลือกแม่แบบ..."
                                />
                                <button
                                    name="action_apply_allocation_template"
                                    string="นำแม่แบบมาใช้"
                                    type="object"
                                    class="btn-secondary"
                                />
                            </div>
                            <field
                                name="allocation_line_ids"
                                attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_id"/>
                                    <field name="allocation_pct" string="% จัดสรร" readonly="1" sum="รวม"/>
                                    <field name="estimated_amount" sum="รวม"/>
                                    <field name="actual_amount" readonly="1" sum="รวม"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Tab 4: เอกสารแนบ -->
                        <page string="เอกสารแนบ" name="attachments">
                            <field
                                name="attachment_ids"
                                widget="many2many_binary"
                                string="ไฟล์แนบ"
                            />
                        </page>

                        <!-- Tab 5: หมายเหตุ -->
                        <page string="หมายเหตุ" name="notes">
                            <field name="note" placeholder="หมายเหตุ..." nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- TREE VIEW                                                    -->
    <!-- ============================================================ -->

    <record id="view_kris_project_tree" model="ir.ui.view">
        <field name="name">kris.project.tree</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="project_name"/>
                <field name="project_category_id"/>
                <field name="project_type_id" optional="show"/>
                <field name="partner_id"/>
                <field name="leader_id" optional="show"/>
                <field name="faculty_id"/>
                <field name="project_value" sum="รวม"/>
                <field name="total_received_amount" sum="รวม" optional="show"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'confirmed'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"
                />
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW                                                  -->
    <!-- ============================================================ -->

    <record id="view_kris_project_search" model="ir.ui.view">
        <field name="name">kris.project.search</field>
        <field name="model">kris.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="เลขที่เอกสาร"/>
                <field name="project_name" string="ชื่อโครงการ"/>
                <field name="partner_id"/>
                <field name="leader_id"/>
                <field name="project_category_id"/>
                <field name="project_type_id"/>
                <separator/>
                <filter name="draft" string="ร่าง" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="ยืนยัน" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="เสร็จสิ้น" domain="[('state', '=', 'done')]"/>
                <filter name="cancel" string="ยกเลิก" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter
                    name="my_projects"
                    string="โครงการของฉัน"
                    domain="[('user_id', '=', uid)]"
                />
                <!-- Group By -->
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_category" string="ประเภทโครงการ" context="{'group_by': 'project_category_id'}"/>
                    <filter name="group_type" string="ประเภทย่อย" context="{'group_by': 'project_type_id'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_faculty" string="คณะ" context="{'group_by': 'faculty_id'}"/>
                    <filter name="group_fiscal_year" string="ปีงบประมาณ" context="{'group_by': 'account_fiscal_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                       -->
    <!-- ============================================================ -->

    <record id="action_kris_project" model="ir.actions.act_window">
        <field name="name">โครงการ KRIS</field>
        <field name="res_model">kris.project</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_kris_project_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างโครงการ KRIS ใหม่
            </p>
            <p>
                บันทึกข้อมูลโครงการบริการวิชาการและวิจัยหลังลงนามสัญญา
            </p>
        </field>
    </record>

</odoo>
