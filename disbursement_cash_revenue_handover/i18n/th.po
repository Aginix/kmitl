msgstr "โอนเงินและรายได้"

#. module: disbursement_cash_revenue_handover
#: model:ir.model.fields,field_description:disbursement_cash_revenue_handover.field_disbursement_request__cash_revenue_handover_count
msgid "Handover Count"
msgstr "จำนวนใบโอน"

#. module: disbursement_cash_revenue_handover
