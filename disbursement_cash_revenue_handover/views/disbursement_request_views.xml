<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart button to the handover entry. Shown from the moment it exists so
         the accountant can post it before approving the bill — which is the
         whole point of raising it early. -->
    <record id="view_disbursement_request_form_inherit_handover" model="ir.ui.view">
        <field name="name">disbursement.request.form.inherit.cash_revenue_handover</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cash_revenue_handover"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        groups="accounting_kmitl.group_accounting_kmitl_user"
                        attrs="{'invisible': [('cash_revenue_handover_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Cash &amp; Revenue Handover</span>
                    </div>
                </button>
                <field name="cash_revenue_handover_count" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
