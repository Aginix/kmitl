<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_central_funding_tree" model="ir.ui.view">
        <field name="name">kmitl.central.funding.tree</field>
        <field name="model">kmitl.central.funding</field>
        <field name="arch" type="xml">
            <tree>
                <field name="account_fiscal_year_id"/>
                <field name="source_analytic_id"/>
                <field name="bank_account_id"/>
                <field name="revenue_account_id"/>
                <field name="central_department_analytic_id"/>
                <field name="central_fund_analytic_id"/>
                <field name="central_activity_level"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_central_funding_form" model="ir.ui.view">
        <field name="name">kmitl.central.funding.form</field>
        <field name="model">kmitl.central.funding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <group>
                        <group string="Money Held Centrally">
                            <field name="source_analytic_id" options="{'no_create': True}"/>
                            <field name="account_fiscal_year_id" options="{'no_create': True}"/>
                            <field name="bank_account_id" options="{'no_create': True}"/>
                            <field name="revenue_account_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Central Dimensions">
                            <field name="central_department_analytic_id" options="{'no_create': True}"/>
                            <field name="central_fund_analytic_id" options="{'no_create': True}"/>
                            <field name="central_activity_level"/>
                        </group>
                        <group string="Bookkeeping">
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted mt-3">
                        <span>A disbursement carrying this source of funds in this fiscal year, raised by any department other than the central one, is funded by a draft handover entry when its vendor bill is created.</span>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_central_funding_search" model="ir.ui.view">
        <field name="name">kmitl.central.funding.search</field>
        <field name="model">kmitl.central.funding</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_analytic_id"/>
                <field name="account_fiscal_year_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter
                        name="group_fiscal_year"
                        string="Fiscal Year"
                        context="{'group_by': 'account_fiscal_year_id'}"
                    />
                    <filter
                        name="group_source"
                        string="Source of Funds"
                        context="{'group_by': 'source_analytic_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_central_funding" model="ir.actions.act_window">
        <field name="name">Central Funding Profiles</field>
        <field name="res_model">kmitl.central.funding</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up a central funding profile</p>
            <p>One row per source of funds and fiscal year, saying where the money is held and under which dimensions. A source with no row here is never handed over.</p>
        </field>
    </record>

</odoo>
