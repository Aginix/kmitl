<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_form_coordinator_sarabun" model="ir.ui.view">
        <field name="name">view.kmitl.project.form.coordinator.sarabun</field>
        <field name="model">kmitl.project</field>
        <field
            name="inherit_id"
            ref="kmitl_project_sarabun.view_kmitl_project_form_sarabun"
        />
        <field name="arch" type="xml">
            <!-- Ungrouped, beside the bridge's own invisible fields after //header. -->
            <xpath expr="//field[@name='sarabun_is_draft']" position="after">
                <field name="can_submit_sarabun" invisible="1" />
            </xpath>
            <xpath
                expr="//button[@name='action_submit_to_sarabun']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': ['|', '|', ('state', '!=', 'to_send'), ('sarabun_has_live_document', '=', True), ('can_submit_sarabun', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
