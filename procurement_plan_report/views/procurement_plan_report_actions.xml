<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- One OWL component (tag procurement_plan_report) serves all three form
         types; each action fixes its report_type via context. -->
    <record id="action_procurement_plan_report_construction" model="ir.actions.client">
        <field name="name">รายงานแผนจัดซื้อ — สิ่งก่อสร้าง</field>
        <field name="tag">procurement_plan_report_form</field>
        <field name="context">{'report_type': 'construction'}</field>
    </record>

    <record id="action_procurement_plan_report_equipment" model="ir.actions.client">
        <field name="name">รายงานแผนจัดซื้อ — ครุภัณฑ์ (งวดเดียว)</field>
        <field name="tag">procurement_plan_report_form</field>
        <field name="context">{'report_type': 'equipment'}</field>
    </record>

    <record id="action_procurement_plan_report_equipment_multi" model="ir.actions.client">
        <field name="name">รายงานแผนจัดซื้อ — ครุภัณฑ์ (หลายงวด)</field>
        <field name="tag">procurement_plan_report_form</field>
        <field name="context">{'report_type': 'equipment_multi'}</field>
    </record>
</odoo>
