<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_stock_request_security" model="ir.module.category">
        <field name="name">Stock Request</field>
        <field name="description">Security category for Stock Request Security</field>
        <field name="parent_id" ref="base.module_category_inventory_inventory"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_stock_request_user" model="res.groups">
        <field name="name">Stock Request User : Own Documents Only</field>
        <field name="category_id" ref="category_stock_request_security"/>
    </record>

    <record id="group_stock_request_approver" model="res.groups">
        <field name="name">Stock Request User : All Documents</field>
        <field name="category_id" ref="category_stock_request_security"/>
        <field name="implied_ids" eval="[(4, ref('stock_request_aginix.group_stock_request_user'))]"/>
    </record>

    <record id="stock_request_rule" model="ir.rule">
        <field name="name">Stock Request User : Own Documents Only</field>
        <field name="model_id" ref="model_stock_request" />
        <field name="groups" eval="[(6,0, [ref('group_stock_request_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('user_id','=',user.id)]</field>
    </record>

    <record id="stock_request_line_rule" model="ir.rule">
        <field name="name">Stock Request Line User</field>
        <field name="model_id" ref="model_stock_request_line" />
        <field name="groups" eval="[(6,0, [ref('group_stock_request_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('request_id.user_id','=',user.id)]</field>
    </record>

    <record id="stock_request_approver_rule" model="ir.rule">
        <field name="name">stock Request User : All Documents</field>
        <field name="model_id" ref="model_stock_request" />
        <field name="groups" eval="[(6,0, [ref('group_stock_request_approver')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    
    <record id="stock_request_approver_line_rule" model="ir.rule">
        <field name="name">stock Request User : All Documents</field>
        <field name="model_id" ref="model_stock_request_line" />
        <field name="groups" eval="[(6,0, [ref('group_stock_request_approver')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

</odoo>
