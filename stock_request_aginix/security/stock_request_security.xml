<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_stock_request_security" model="ir.module.category">
        <field name="name">Stock Request</field>
        <field name="description">Security category for Stock Request Security</field>
        <field name="parent_id" ref="base.module_category_inventory_inventory"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_stock_request_user" model="res.groups">
        <field name="name">Stock Request User : Own Documents Only</field>
        <field name="category_id" ref="category_stock_request_security"/>
    </record>

    <record id="group_stock_request_approver" model="res.groups">
        <field name="name">Stock Request User : All Documents</field>
        <field name="category_id" ref="category_stock_request_security"/>
        <field name="implied_ids" eval="[(4, ref('stock_request_security.group_stock_request_user'))]"/>
    </record>

    <record id="group_stock_request_manager" model="res.groups">
        <field name="name">Stock Request Manager</field>
        <field name="category_id" ref="category_stock_request_security"/>
        <field name="implied_ids" eval="[(4, ref('stock_request_security.group_stock_request_approver'))]"/>
    </record>
</odoo>
