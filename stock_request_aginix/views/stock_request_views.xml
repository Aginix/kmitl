<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View stock.request View Tree -->
    <record id="view_stock_request_tree" model="ir.ui.view">
        <field name="name">view.stock.request.tree</field>
        <field name="model">stock.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- View stock.request form -->
    <record id="view_stock_request_form" model="ir.ui.view">
        <field name="name">view.stock.request.form</field>
        <field name="model">stock.request</field>
        <field name="arch" type="xml">
            <form string="Stock Request">
                <header>
                    <button name="action_requested" string="Requested" type="object" states="draft"/>
                    <button name="action_approved" string="Approved" type="object" states="requested"/>
                    <button name="action_create_picking"
                            type="object"
                            string="Create Picking"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('picking_id', '!=', False), ('state', '!=', 'approved')]}"/>
                    <field name="picking_id" invisible="1"/>
                    <button name="action_done" string="Done" type="object" states="approved"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                attrs="{'invisible': [('picking_id', '=', False)]}">
                            <field name="picking_id" invisible="1"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Picking</span>
                            </div>
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Done"
                        bg_color="bg-success"
                        attrs="{'invisible': [('state', '!=', 'done')]}"
                    />
                    <div class="oe_title">
                        <label for="name" string="Stock request Order" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group name="left">
                            <field name="picking_type_id"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="user_id"/>
                        </group>
                        <group name="right">
                            <field name="request_date"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="request_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="qty_done" readonly="1" attrs="{'column_invisible': [('parent.picking_id', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_request_search" model="ir.ui.view">
        <field name="name">view.stock.request.search</field>
        <field name="model">stock.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Request Number"/>
                <field name="user_id" string="Requestor"/>
                <field name="responsible_id" string="Responsible"/>
                <field name="location_id" string="Source Location"/>
                <field name="location_dest_id" string="Destination Location"/>
                <field name="request_date" string="Request Date"/>
                
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_requested" string="Requested" domain="[('state', '=', 'requested')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                
                <separator/>
                <filter name="filter_my_requests" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <filter name="filter_my_responsibility" string="My Responsibility" domain="[('responsible_id', '=', uid)]"/>
                
                <separator/>
                <filter name="filter_has_picking" string="Has Picking" domain="[('picking_id', '!=', False)]"/>
                <filter name="filter_no_picking" string="No Picking" domain="[('picking_id', '=', False)]"/>
                
                <separator/>
                <filter name="filter_today" string="Today" domain="[('request_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_week" string="This Week" domain="[('request_date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month" string="This Month" domain="[('request_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Requestor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter name="group_location" string="Source Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_location_dest" string="Destination Location" context="{'group_by': 'location_dest_id'}"/>
                    <filter name="group_request_date" string="Request Date" context="{'group_by': 'request_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action stock.request -->
    <record id="action_stock_request" model="ir.actions.act_window">
        <field name="name">Stock Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Stock Request.
            </p>
        </field>
    </record>

</odoo>
