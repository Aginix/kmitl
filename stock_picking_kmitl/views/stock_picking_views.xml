<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View stock.picking form -->
    <record id="view_stock_picking_form" model="ir.ui.view">
        <field name="name">view.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_product_forecast_report']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_show_details']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

  </odoo>