<?xml version="1.0" encoding="utf-8"?>
  <odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_order_account_move_request.view_purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_move_request']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'purchase'), ('use_invoice_plan','=',True)]}</attribute>
            </xpath>
        </field>
    </record>
  </odoo>
