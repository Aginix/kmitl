<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: related journal entries smart button -->
    <record id="view_disbursement_request_form_inherit_accounting" model="ir.ui.view">
        <field name="name">disbursement.request.form.inherit.accounting_kmitl</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <!-- Move-line smart button. The old "ใบตั้งหนี้" bill button used
                 to live here alongside it; it is now folded into the unified
                 "รายการบัญชี" button in disbursement_finance_kmitl. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_related_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        attrs="{'invisible': [('related_move_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">รายการบันทึกบัญชี <field name="related_move_count" nolabel="1" /></span>
                    </div>
                </button>
                <!-- Referenced by the Create Bill attrs of the billing station,
                     invisible so it does not render as a button. -->
                <field name="bill_count" invisible="1" />
            </xpath>
        </field>
    </record>

</odoo>
