<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- DR action for accountant queue (default filter: awaiting a bill) -->
    <record id="action_disbursement_request_accounting" model="ir.actions.act_window">
        <field name="name">Disbursement Requests</field>
        <field name="res_model">disbursement.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_awaiting_bill": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ไม่มีใบขอเบิกที่รอตั้งหนี้
            </p>
            <p>
                ใบขอเบิกที่อยู่ในวงจรและยังไม่มีใบตั้งหนี้ รอเจ้าหน้าที่บัญชีตั้งหนี้
            </p>
        </field>
    </record>

    <!-- DR menu under the เจ้าหนี้ (payable) menu — first document in the
         payable workflow (ใบขอเบิก → ใบตั้งหนี้ → ใบล้างเจ้าหนี้) -->
    <menuitem
        id="menu_accounting_disbursement_request"
        name="Disbursement Requests"
        parent="accounting_kmitl.menu_payable"
        action="action_disbursement_request_accounting"
        sequence="5"
    />

    <!-- Form view: add Create Bill button + Bills smart button -->
    <record id="view_disbursement_request_form_inherit_accounting" model="ir.ui.view">
        <field name="name">disbursement.request.form.inherit.accounting_kmitl</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <!-- Create Bill (an act of the accounting desk) before Reset to
                 draft, which is the stable anchor of the header. Bills are
                 posted through the account.move approval (Approve = post),
                 not from the request, so there is no "Post Bills" button. -->
            <xpath expr="//button[@name='action_draft']" position="before">
                <button name="action_create_bill"
                        string="Create Bill"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('can_create_bill', '=', False), ('bill_count', '>', 0)]}"
                        groups="accounting_kmitl.group_accounting_kmitl_user"/>
            </xpath>

            <!-- Move-line smart button. The old "ใบตั้งหนี้" bill button used
                 to live here alongside it; it is now folded into the unified
                 "รายการบัญชี" button in disbursement_finance_kmitl. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_related_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        attrs="{'invisible': [('related_move_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">รายการบันทึกบัญชี <field name="related_move_count" nolabel="1" /></span>
                    </div>
                </button>
                <!-- Referenced by the Create Bill attrs above, invisible so
                     they do not render as buttons. -->
                <field name="bill_count" invisible="1" />
                <field name="can_create_bill" invisible="1" />
            </xpath>
        </field>
    </record>

    <!-- The accountant's queue: in the circuit and not billed yet. -->
    <record id="view_disbursement_request_search_inherit_accounting" model="ir.ui.view">
        <field name="name">disbursement.request.search.inherit.accounting_kmitl</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='in_progress']" position="after">
                <filter name="awaiting_bill"
                        string="Awaiting Billing"
                        domain="[('state', 'in', ('signed', 'in_progress')), ('settlement_stage', '=', 'none'), ('bill_ids', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
