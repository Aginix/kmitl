msgstr "%(user)s ไม่ใช่ผู้ตรวจสอบคำขออนุมัติของคำขอ %(request)s"

#. module: agx_approval_verifier
#: model:ir.model,name:agx_approval_verifier.model_approval_request
msgid "Approval Request"
msgstr "คำขออนุมัติค่าใช้จ่าย"

#. module: agx_approval_verifier
#. odoo-python
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#, python-format
msgid "Approval request %s was sent back"
msgstr "คำขออนุมัติเลขที่ %s ถูกตีกลับ"

#. module: agx_approval_verifier
#: model:ir.model.fields,help:agx_approval_verifier.field_approval_request__date_verified
msgid ""
"Date the request was confirmed past Awaiting Verification. Cleared when it "
"comes back to Awaiting Verification or Draft."
msgstr ""
"วันที่ยืนยันตรวจสอบ (รอตรวจสอบข้อมูล → ขั้นถัดไป) "
"ล้างเมื่อคำขอย้อนกลับมารอตรวจสอบข้อมูลหรือแบบร่าง"

#. module: agx_approval_verifier
#: model:mail.activity.type,name:agx_approval_verifier.mail_activity_request_returned
msgid "Fix Returned Approval Request"
msgstr "แก้ไขคำขออนุมัติที่ถูกตีกลับ"

#. module: agx_approval_verifier
#: model:mail.activity.type,summary:agx_approval_verifier.mail_activity_request_returned
msgid "Fix and resubmit the approval request"
msgstr "แก้ไขและส่งคำขออนุมัติใหม่"

#. module: agx_approval_verifier
#. odoo-python
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#, python-format
msgid "Please set the Verifier before submitting the request."
msgstr "กรุณาระบุผู้ตรวจสอบก่อนส่งคำขอ"

#. module: agx_approval_verifier
#. odoo-python
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#, python-format
msgid "Please verify approval request %s"
msgstr "กรุณาตรวจสอบคำขออนุมัติเลขที่ %s"

#. module: agx_approval_verifier
#. odoo-python
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#: code:addons/agx_approval_verifier/models/approval_request.py:0
#, python-format
msgid "Request %s is awaiting verification: a Verifier is required."
msgstr "คำขอ %s อยู่ระหว่างรอตรวจสอบข้อมูล ต้องระบุผู้ตรวจสอบ"

#. module: agx_approval_verifier
#: model:ir.model.fields,help:agx_approval_verifier.field_approval_request__verifier_id
msgid ""
"The Request Verifier named on this request, who gets its Todo when it "
"reaches Awaiting Verification. Advisory only: any Request Verifier may still"
" confirm or send the request back."
msgstr ""
"ผู้ตรวจสอบคำขอที่ระบุให้ตรวจสอบคำขอนี้ — รับ Todo "
"เมื่อคำขอเข้าสถานะรอตรวจสอบข้อมูล ไม่ได้ล็อกสิทธิ์: "
"ผู้ตรวจสอบคำขอคนอื่นยังยืนยันตรวจสอบหรือตีกลับได้"

#. module: agx_approval_verifier
#: model:ir.model.fields,field_description:agx_approval_verifier.field_approval_request__date_verified
msgid "Verified Date"
msgstr "วันที่ตรวจสอบ"

#. module: agx_approval_verifier
#: model:ir.model.fields,field_description:agx_approval_verifier.field_approval_request__verifier_id
msgid "Verifier"
msgstr "ผู้ตรวจสอบ"

#. module: agx_approval_verifier
#: model:ir.model.fields,field_description:agx_approval_verifier.field_approval_request__verifier_candidate_ids
msgid "Verifier Candidates"
msgstr "ผู้ตรวจสอบที่เลือกได้"

#. module: agx_approval_verifier
#: model:mail.activity.type,name:agx_approval_verifier.mail_activity_verify_request
msgid "Verify Approval Request"
msgstr "ตรวจสอบคำขออนุมัติ"

#. module: agx_approval_verifier
#: model:mail.activity.type,summary:agx_approval_verifier.mail_activity_verify_request
msgid "Verify the approval request you are named on"
msgstr "ตรวจสอบข้อมูลคำขออนุมัติที่ระบุให้ท่านเป็นผู้ตรวจสอบ"

#. module: agx_approval_verifier
