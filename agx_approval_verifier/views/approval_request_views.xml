<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.form.verifier</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form" />
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field
                    name="verifier_id"
                    options="{'no_create': True, 'no_open': True}"
                    attrs="{'readonly': [('state', 'not in', ('draft', 'to_verify'))]}"
                />
            </field>
        </field>
    </record>

    <record id="approval_request_view_tree" model="ir.ui.view">
        <field name="name">approval.request.tree.verifier</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_tree" />
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field name="verifier_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="approval_request_view_search" model="ir.ui.view">
        <field name="name">approval.request.search.verifier</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_search" />
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field name="verifier_id" />
            </field>
            <filter name="created_by_me" position="after">
                <filter
                    name="my_to_verify"
                    string="รอฉันตรวจสอบ"
                    domain="[('verifier_id', '=', uid), ('state', '=', 'to_verify')]"
                />
            </filter>
        </field>
    </record>
</odoo>
