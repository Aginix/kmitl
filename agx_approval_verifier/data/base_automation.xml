<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Fires on entering รอตรวจสอบข้อมูล and on re-assigning the Designated
             Verifier while there: drop any existing verify Todo, then give it to
             whoever is designated now. -->
        <record id="automation_notify_verify_request" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: แจ้งผู้ตรวจสอบที่ระบุเมื่อเข้าสถานะรอตรวจสอบข้อมูล</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_domain">[('state', '=', 'to_verify')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state'), ref('agx_approval_verifier.field_approval_request__verifier_id')])]"
            />
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.activity_unlink(["agx_approval_verifier.mail_activity_verify_request"])
    if record.verifier_id:
        record.activity_schedule(
            "agx_approval_verifier.mail_activity_verify_request",
            summary="คำขออนุมัติเลขที่ %s รอตรวจสอบข้อมูล" % (record.name or ""),
            user_id=record.verifier_id.id,
        )
</field>
        </record>

        <record id="automation_clear_verify_request" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: ล้าง Todo ตรวจสอบเมื่อออกจากสถานะรอตรวจสอบข้อมูล</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '=', 'to_verify')]</field>
            <field name="filter_domain">[('state', '!=', 'to_verify')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state')])]"
            />
            <field name="state">code</field>
            <field
                name="code"
            >records.activity_unlink(["agx_approval_verifier.mail_activity_verify_request"])</field>
        </record>

    </data>
</odoo>
