<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_partner_bank)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/tree/field[@name='partner_bank_id']"
                position="after"
            >
                <!-- Only a payee paid by transfer has accounts to manage. -->
                <field name="requires_partner_bank" invisible="1" />
                <button
                    name="action_open_partner_bank_wizard"
                    type="object"
                    icon="fa-university"
                    string="Bank Accounts"
                    title="Bank Accounts"
                    class="btn-secondary btn-sm"
                    attrs="{'invisible': ['|', ('parent.state', '!=', 'draft'), ('requires_partner_bank', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
