<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_partner_bank)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree/field[@name='partner_bank_id']" position="after">
                <button
                    name="action_open_partner_bank_wizard"
                    type="object"
                    icon="fa-university"
                    title="Bank Accounts"
                    attrs="{'invisible': [('parent.state', '!=', 'draft')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
