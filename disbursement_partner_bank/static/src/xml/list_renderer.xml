<templates xml:space="preserve">
    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-if=&quot;column.type === 'button_group'&quot;]//ViewButton" position="attributes">
            <attribute name="onClick">isX2Many and record.isVirtual ? (() => this.onPayeeBankVirtualRowClick(record, button)) : ''</attribute>
        </xpath>
    </t>
</templates>
