<?xml version="1.0" encoding="utf-8"?>
<!--
    Seed payment subjects gathered from the treasury office. The paying
    accounts (หัวจ่าย) are chart-of-accounts records the treasury office flags
    and may differ per database, so they are left empty here — after install,
    flag the accounts in Finance ▸ Settings ▸ หัวจ่าย and then bind them to
    each subject in Finance ▸ Settings ▸ Payment Subjects:

      เงินเดือน            → allow only the KTB account
      เงินยืม/สำรองจ่าย     → allow all four bank accounts (payee's bank decides)
      จ่ายตรงคู่ค้า         → allow only the SCB account
      ค่าน้ำค่าไฟ          → cheque, allow the account the cheque book is drawn on
-->
<odoo noupdate="1">

    <!-- เงินเดือน: บุคลากรบังคับมีบัญชี KTB → หัวจ่าย KTB ตายตัว -->
    <record id="payment_subject_salary" model="kmitl.payment.subject">
        <field name="name">เงินเดือน</field>
        <field name="sequence">10</field>
        <field name="default_payment_type_id" ref="payment_type_normal_outbound"/>
    </record>

    <!-- เงินยืม/สำรองจ่าย: จ่ายจากหัวจ่ายธนาคารเดียวกับบัญชีผู้รับ -->
    <record id="payment_subject_advance_reimburse" model="kmitl.payment.subject">
        <field name="name">เงินยืม/สำรองจ่าย</field>
        <field name="sequence">20</field>
        <field name="default_payment_type_id" ref="payment_type_normal_outbound"/>
        <field name="auto_match_payee_bank" eval="True"/>
    </record>

    <!-- จ่ายตรงคู่ค้า: หัวจ่าย SCB ตายตัว (ต่างธนาคารระบบแบงก์ route เอง) -->
    <record id="payment_subject_vendor_direct" model="kmitl.payment.subject">
        <field name="name">จ่ายตรงคู่ค้า</field>
        <field name="sequence">30</field>
        <field name="default_payment_type_id" ref="payment_type_normal_outbound"/>
    </record>

    <!-- ค่าน้ำค่าไฟ: ออกเป็นเช็คธนาคาร -->
    <record id="payment_subject_utilities" model="kmitl.payment.subject">
        <field name="name">ค่าน้ำค่าไฟ</field>
        <field name="sequence">40</field>
        <field name="default_payment_type_id" ref="payment_type_cheque_outbound"/>
    </record>

</odoo>
