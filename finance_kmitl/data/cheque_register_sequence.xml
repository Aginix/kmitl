<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!--
            The register's own reference, which is not the cheque number: the paper
            carries that and the bank knows the cheque by it, while this only has
            to name the row before a number has been typed into it. There is one
            sequence and not one per cheque book, because it numbers rows in Odoo
            and says nothing about any book.
        -->
        <record id="seq_cheque_register" model="ir.sequence">
            <field name="name">Cheque Register</field>
            <field name="code">cheque.register</field>
            <field name="prefix">CHQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False" />
        </record>
    </data>
</odoo>
