<?xml version="1.0" encoding="utf-8"?>
<!--
    NOTE: Override accounts below are matched by KMITL chart-of-accounts code
    "2150000006" (deposit liability). If this code is absent in the installed
    chart, the override_account_id field is left empty (graceful no-op).
    Admins can manually set the override account on each kmitl.payment.type
    record after install via the Settings menu.
-->
<odoo noupdate="1">

    <record id="payment_type_normal_inbound" model="kmitl.payment.type">
        <field name="name">Receive Money</field>
        <field name="direction">inbound</field>
        <field name="sequence">10</field>
    </record>

    <!-- Archived: guarantee money is now received by issuing a guarantee
         receipt (purchase_guarantee_receipt_kmitl), which books the deposit
         liability from the guarantee method's own account. Kept, not deleted,
         so the payments raised the old way still resolve their type. -->
    <record id="payment_type_guarantee_receive" model="kmitl.payment.type">
        <field name="name">Receive Contract Guarantee</field>
        <field name="direction">inbound</field>
        <field name="sequence">20</field>
        <field name="active" eval="False"/>
        <field name="override_account_id" search="[('code', '=', '2150000006')]" model="account.account"/>
    </record>

    <record id="payment_type_bid_guarantee_receive" model="kmitl.payment.type">
        <field name="name">Receive Bid Guarantee</field>
        <field name="direction">inbound</field>
        <field name="sequence">30</field>
        <field name="active" eval="False"/>
        <field name="override_account_id" search="[('code', '=', '2150000006')]" model="account.account"/>
    </record>

    <record id="payment_type_normal_outbound" model="kmitl.payment.type">
        <field name="name">Pay Money</field>
        <field name="direction">outbound</field>
        <field name="sequence">40</field>
    </record>

</odoo>
