<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_bank_payment_export">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-set="currency" t-value="o.currency_id" />
                    <t
                        t-set="lines"
                        t-value="o.export_line_ids.filtered(lambda l: l.state != 'reject')"
                    />
                    <t t-set="dim_data" t-value="lines._report_dimensions()" />
                    <t
                        t-set="dim_labels"
                        t-value="[('departments', 'ส่วนงาน'), ('sources', 'แหล่งเงิน'), ('funds', 'กองทุน'), ('activities', 'ด้าน/แผนงาน/กิจกรรม'), ('kmitl_project', 'โครงการ/กิจกรรม'), ('procurement_plan', 'แผนจัดซื้อจัดจ้าง')]"
                    />
                    <t
                        t-set="dim_cols"
                        t-value="[d for d in dim_labels if d[0] in dim_data['plans']]"
                    />

                    <style>
                        * {
                        font-family: "THSarabunNew", Arial, sans-serif;
                        --bs-body-font-size: 16pt;
                        }
                        p,
                        span,
                        div {
                        font-size: 16pt;
                        line-height: 1.2;
                        }
                        table.bpe-lines,
                        table.bpe-lines th,
                        table.bpe-lines td,
                        table.bpe-lines span,
                        table.bpe-lines div {
                        font-size: 12pt;
                        }
                        table.bpe-lines th,
                        table.bpe-lines td {
                        word-break: break-word;
                        }
                    </style>

                    <div class="page">
                        <!-- Company Logo -->
                        <div style="position: absolute; top: 0px; left: 0px">
                            <img
                                t-if="o.company_id.logo"
                                t-att-src="image_data_uri(o.company_id.logo)"
                                style="max-height: 110px"
                                alt="Logo"
                            />
                        </div>

                        <div class="oe_structure" />
                        <div style="height: 1px" />

                        <div class="page-header mt-5 mb-5">
                            <h3
                                class="text-center fw-bolder"
                                style="line-height: 1.575"
                            >
                                รายงานการเบิกจ่าย
                            </h3>
                        </div>

                        <div class="my-5" />
                        <div class="my-5" />

                        <!-- Document Information -->
                        <div class="row pt-8">
                            <div class="col-4">
                                เลขที่ <span class="ms-2 fw-normal" t-out="o.name" />
                            </div>
                            <div class="col">
                                วันที่ <span
                                    class="ms-2 fw-normal"
                                    t-field="o.effective_date"
                                />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                ธนาคาร <span
                                    class="ms-2"
                                    t-out="o.template_id.name or dict(o._fields['bank'].selection).get(o.bank, '')"
                                />
                            </div>
                        </div>

                        <!-- Where the money leaves from. One file debits one
                             account, so this belongs to the whole document rather
                             than to a column repeated on every row. -->
                        <div class="row" t-if="o.paying_account_id">
                            <div class="col">
                                หัวจ่าย <span
                                    class="ms-2"
                                    t-out="o.paying_account_id.display_name"
                                />
                            </div>
                        </div>

                        <div class="row" t-if="o.paying_account_id.acc_number">
                            <div class="col">
                                บัญชีต้นทาง
                                <span
                                    class="ms-2"
                                    t-out="o.paying_account_id.bank_id.name"
                                />
                                <span
                                    class="ms-2"
                                    t-out="o.paying_account_id.acc_number"
                                />
                            </div>
                        </div>

                        <div class="row" t-if="o.account_fiscal_year_id">
                            <div class="col">
                                ปีงบประมาณ <span
                                    class="ms-2"
                                    t-out="o.account_fiscal_year_id.name"
                                />
                            </div>
                        </div>

                        <div class="row" t-if="o.epayment_note">
                            <div class="col">
                                หมายเหตุ <span class="ms-2" t-out="o.epayment_note" />
                            </div>
                        </div>

                        <div class="my-4" />

                        <!-- Line Items Table -->
                        <table class="table table-bordered table-sm mb-4 bpe-lines">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 4%">ลำดับ</th>
                                    <th
                                        class="text-center"
                                        style="width: 10%"
                                    >เลขที่รายการ</th>
                                    <th
                                        class="text-center"
                                        style="width: 15%"
                                    >ผู้รับเงิน</th>
                                    <th
                                        class="text-center"
                                        style="width: 13%"
                                    >ธนาคาร/เลขที่บัญชี</th>
                                    <th
                                        class="text-center"
                                        t-foreach="dim_cols"
                                        t-as="dim"
                                        t-att-style="'width: %.2f%%' % (49.0 / len(dim_cols))"
                                        t-out="dim[1]"
                                    />
                                    <th
                                        class="text-end"
                                        style="width: 9%"
                                    >จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="row_no" t-value="1" />
                                <t t-foreach="lines" t-as="line">
                                    <tr>
                                        <td class="text-center" t-out="row_no" />
                                        <td t-out="line.payment_id.name" />
                                        <td t-out="line.payment_partner_id.name" />
                                        <td>
                                            <t t-if="line.payment_partner_bank_id">
                                                <span
                                                    t-out="line.payment_partner_bank_id.bank_id.name"
                                                />
                                                <br />
                                                <span
                                                    t-out="line.payment_partner_bank_id.acc_number"
                                                />
                                            </t>
                                        </td>
                                        <t
                                            t-set="line_dims"
                                            t-value="dim_data['lines'].get(line.id) or {}"
                                        />
                                        <t t-foreach="dim_cols" t-as="dim">
                                            <t
                                                t-set="acc"
                                                t-value="line_dims.get(dim[0])"
                                            />
                                            <td>
                                                <t t-if="acc">
                                                    <span t-out="acc.code" />
                                                    <div t-out="acc.name" />
                                                </t>
                                            </td>
                                        </t>
                                        <td
                                            class="text-end"
                                            t-out="'{0:,.2f}'.format(line.payment_amount)"
                                        />
                                    </tr>
                                    <t t-set="row_no" t-value="row_no + 1" />
                                </t>

                                <!-- Total -->
                                <tr class="fw-bold">
                                    <td colspan="2" class="text-center align-middle">
                                        (<t
                                            t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.total_amount)"
                                        />)
                                    </td>
                                    <td
                                        class="text-center"
                                        t-att-colspan="2 + len(dim_cols)"
                                    >รวมทั้งสิ้น</td>
                                    <td
                                        class="text-end"
                                        t-out="'{0:,.2f}'.format(o.total_amount)"
                                    />
                                </tr>
                            </tbody>
                        </table>

                        <div class="my-4" />

                        <!-- Signatures -->
                        <div class="my-5">
                            <div class="my-2 d-inline-block">
                                <div>ลงชื่อ <t t-out="'.' * 80" /> ผู้จัดทำ</div>
                                <div class="text-center my-2">
                                    (<span t-out="o.create_uid.name" />)
                                </div>
                                <div class="text-center">
                                    วันที่ ......../......../.........
                                </div>
                            </div>
                        </div>

                        <!-- No approver block. Nothing is approved here: the
                             authorisation happened on the disbursement request,
                             and what this document reports is a file the finance
                             office prepared and sent. A signature line for an
                             approval that never takes place invites one. -->

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
