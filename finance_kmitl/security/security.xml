<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_finance_kmitl" model="ir.module.category">
            <field name="name">KMITL Finance</field>
            <field name="description">User groups for KMITL finance operations</field>
            <field name="sequence">21</field>
        </record>

        <!-- User การเงินรับ: create inbound payments -->
        <record id="group_finance_kmitl_user_in" model="res.groups">
            <field name="name">User การเงินรับ (Payment In)</field>
            <field
                name="category_id"
                ref="finance_kmitl.module_category_finance_kmitl"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('account.group_account_invoice'))]"
            />
        </record>

        <!-- User การเงินจ่าย: create outbound payments -->
        <record id="group_finance_kmitl_user_out" model="res.groups">
            <field name="name">User การเงินจ่าย (Payment Out)</field>
            <field
                name="category_id"
                ref="finance_kmitl.module_category_finance_kmitl"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('account.group_account_invoice'))]"
            />
        </record>

        <!-- Manager: full access.

             base.group_partner_manager ("Contact Creation") is what grants
             write on res.bank and res.partner.bank; core gives everyone else
             read only, and account.group_account_manager does not imply it. The
             treasury office maintains both from Finance ▸ Settings — a new
             institute account to pay out of, a payee's account to pay into — so
             without it those screens open read-only. It also carries write on
             res.partner and the country/category/title reference data, which is
             proportionate for a role that already manages the accounts. -->
        <record id="group_finance_kmitl_manager" model="res.groups">
            <field name="name">Manager</field>
            <field
                name="category_id"
                ref="finance_kmitl.module_category_finance_kmitl"
            />
            <field
                name="implied_ids"
                eval="[
                (4, ref('group_finance_kmitl_user_in')),
                (4, ref('group_finance_kmitl_user_out')),
                (4, ref('account.group_account_manager')),
                (4, ref('base.group_partner_manager')),
            ]"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>
</odoo>
