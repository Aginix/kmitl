<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Categories -->
        <record id="module_category_finance_kmitl" model="ir.module.category">
            <field name="name">KMITL Finance</field>
            <field name="description">Base role for KMITL finance: viewer or manager.</field>
            <field name="sequence">21</field>
        </record>

        <record id="module_category_finance_kmitl_payment_in" model="ir.module.category">
            <field name="name">KMITL Finance: Payment In</field>
            <field name="description">Permission to create inbound payments.</field>
            <field name="sequence">22</field>
        </record>

        <record id="module_category_finance_kmitl_payment_out" model="ir.module.category">
            <field name="name">KMITL Finance: Payment Out</field>
            <field name="description">Permission to create outbound payments, bank export, and WHT certificates.</field>
            <field name="sequence">23</field>
        </record>

        <!-- Viewer: view only (base role; "Approver" name reserved for future approval workflow) -->
        <record id="group_finance_kmitl_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="finance_kmitl.module_category_finance_kmitl"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- User การเงินรับ: create inbound payments (independent checkbox category) -->
        <record id="group_finance_kmitl_user_in" model="res.groups">
            <field name="name">User การเงินรับ</field>
            <field name="category_id" ref="finance_kmitl.module_category_finance_kmitl_payment_in"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- User การเงินจ่าย: create outbound payments (independent checkbox category) -->
        <record id="group_finance_kmitl_user_out" model="res.groups">
            <field name="name">User การเงินจ่าย</field>
            <field name="category_id" ref="finance_kmitl.module_category_finance_kmitl_payment_out"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Manager: full access -->
        <record id="group_finance_kmitl_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="finance_kmitl.module_category_finance_kmitl"/>
            <field name="implied_ids" eval="[
                (4, ref('group_finance_kmitl_viewer')),
                (4, ref('group_finance_kmitl_user_in')),
                (4, ref('group_finance_kmitl_user_out')),
                (4, ref('account.group_account_manager')),
            ]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
