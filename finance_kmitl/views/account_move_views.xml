<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- The accounting maker's worklist: payment vouchers the finance office has
         finished with and nobody has booked yet. Without it a handed-over voucher
         is one draft entry among all the other draft entries. Both kinds are here
         — from a disbursement request and made by hand — so nothing falls between
         the two ways they are announced. -->
    <record id="view_account_move_to_book_tree" model="ir.ui.view">
        <field name="name">account.move.to.book.tree</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree
                string="Payment vouchers to book"
                create="false"
                default_order="date asc, name asc"
            >
                <field name="name" />
                <field name="date" />
                <field name="journal_id" />
                <field name="partner_id" string="Payee" />
                <field name="ref" optional="show" />
                <field name="amount_total" sum="Total" string="Amount" />
                <field name="payment_id" optional="hide" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="action_account_move_to_book" model="ir.actions.act_window">
        <field name="name">ใบจ่ายรอบันทึกบัญชี</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_account_move_to_book_tree" />
        <field
            name="domain"
        >[('payment_id', '!=', False), ('payment_id.finance_state', '=', 'paid'), ('state', '=', 'draft')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ไม่มีใบจ่ายที่รอบันทึกบัญชี
            </p>
            <p>
                ใบสำคัญจ่ายที่ฝ่ายการเงินยืนยันจ่ายสำเร็จแล้ว รอผู้จัดทำตรวจมิติ/ประเภทธุรกรรม แล้วส่งอนุมัติ
            </p>
        </field>
    </record>

    <menuitem
        id="menu_account_move_to_book"
        name="ใบจ่ายรอบันทึกบัญชี"
        parent="accounting_kmitl.menu_accounting_root"
        action="action_account_move_to_book"
        sequence="22"
        groups="accounting_kmitl.group_accounting_kmitl_user"
    />

    <!-- เจ้าหนี้ ▸ ใบล้างเจ้าหนี้ — the accounting maker's register of the vouchers
         that clear a payable.

         Read off account.payment rather than account.move even though the menu is
         about the entries: one payment is one clearing voucher, and the payment is
         the record that carries *both* offices' statuses side by side (the treasury's
         finance_state and the accounting office's display_state) plus the หัวจ่าย the
         money left from. The entry itself is one press away, on the voucher's form.

         It is the finance office's own list and search that are shown, not a second
         pair: the columns this office needs are the columns that office needed, and
         the questions they ask — what has been handed over, what is awaiting
         approval, what is booked — are already filters there. The default filter is
         what makes it their register rather than the whole payment ledger.

         The act_window this replaces (accounting_kmitl.action_vendor_payment_moves)
         is left in place; nothing points at it any more, and it is one `ref` for
         anyone who wants the flat list of entries back. -->
    <record id="action_vendor_clearing_vouchers" model="ir.actions.act_window">
        <field name="name">Vendor Clearing Vouchers</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="finance_kmitl.view_account_payment_tree_kmitl" />
        <field
            name="search_view_id"
            ref="finance_kmitl.view_account_payment_search_kmitl"
        />
        <field
            name="domain"
        >[('partner_type', '=', 'supplier'), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{'create': False, 'search_default_to_book': 1}</field>
    </record>

    <!-- `action` is a Reference field, so it wants the "model,id" string rather
         than a bare id — hence eval and not ref. -->
    <record id="accounting_kmitl.menu_vendor_payment_moves" model="ir.ui.menu">
        <field
            name="action"
            eval="'ir.actions.act_window,%d' % ref('finance_kmitl.action_vendor_clearing_vouchers')"
        />
    </record>

</odoo>
