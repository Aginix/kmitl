<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bank account form: mark the account as a paying account (หัวจ่าย) -->
    <record id="view_partner_bank_form_inherit_paying" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.paying.finance_kmitl</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="หัวจ่าย (Paying Account)" name="paying_account">
                    <field name="is_paying_account"/>
                    <field name="payment_account_id"
                           attrs="{'invisible': [('is_paying_account', '=', False)], 'required': [('is_paying_account', '=', True)]}"
                           options="{'no_create': True}"/>
                    <field name="cheque_layout_id"
                           attrs="{'invisible': [('is_paying_account', '=', False)]}"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_bank_tree_inherit_paying" model="ir.ui.view">
        <field name="name">res.partner.bank.tree.inherit.paying.finance_kmitl</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_id']" position="after">
                <field name="is_paying_account" optional="hide"/>
                <field name="payment_account_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Paying accounts as their own master-data list, next to the other
         finance settings, so the treasury office does not have to hunt for
         them among every partner's bank accounts. -->
    <record id="action_paying_account" model="ir.actions.act_window">
        <field name="name">หัวจ่าย (Paying Accounts)</field>
        <field name="res_model">res.partner.bank</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_paying_account', '=', True)]</field>
        <field name="context">{'default_is_paying_account': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีหัวจ่าย
            </p>
            <p>
                หัวจ่ายคือบัญชีธนาคารของสถาบันที่ใช้จ่ายเงินออก —
                สร้างบัญชีธนาคาร (เจ้าของบัญชีเป็นสถาบัน) ติ๊ก "หัวจ่าย"
                แล้วผูกบัญชีแยกประเภท (GL) ที่ใช้บันทึกการจ่าย
            </p>
        </field>
    </record>

    <!-- The institute-wide fallback: a payee whose bank is not one of the main
         paying banks is paid from this account. -->
    <record id="view_company_form_inherit_paying" model="ir.ui.view">
        <field name="name">res.company.form.inherit.paying.finance_kmitl</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="หัวจ่าย (Paying Account)" name="kmitl_paying_account">
                    <field name="default_paying_account_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
