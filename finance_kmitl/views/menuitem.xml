<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root menu — visible to any finance role (manager implies the other three) -->
    <menuitem
        id="menu_payment_root"
        name="Finance"
        web_icon="finance_kmitl,static/description/icon.png"
        sequence="8"
        groups="finance_kmitl.group_finance_kmitl_user_in,finance_kmitl.group_finance_kmitl_user_out"
    />

    <!-- Action: account.payment outbound -->
    <record id="action_account_payment_outbound" model="ir.actions.act_window">
        <field name="name">จ่ายเงิน</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,kanban,form,graph</field>
        <field name="domain">[('payment_type', '=', 'outbound')]</field>
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'default_move_journal_types': ('bank', 'cash'),
        }</field>
    </record>

    <!-- Action: account.payment inbound -->
    <record id="action_account_payment_inbound" model="ir.actions.act_window">
        <field name="name">รับเงิน</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,kanban,form,graph</field>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'default_move_journal_types': ('bank', 'cash'),
        }</field>
    </record>

    <menuitem
        id="menu_account_payment_outbound"
        name="Payment List"
        parent="menu_payment_root"
        action="action_account_payment_outbound"
        sequence="10"
        groups="finance_kmitl.group_finance_kmitl_user_out"
    />
    <!-- Receive Money menu temporarily hidden (inbound receipts not in use yet) -->
    <!--
    <menuitem
        id="menu_account_payment_inbound"
        name="รับเงิน"
        parent="menu_payment_root"
        action="action_account_payment_inbound"
        sequence="15"
        groups="finance_kmitl.group_finance_kmitl_user_in"
    />
    -->

    <!-- Bank Payment Export (outbound-side workflow) -->
    <menuitem
        id="menu_bank_payment_export"
        name="e-Payment List"
        parent="menu_payment_root"
        action="l10n_th_bank_payment_export.action_bank_payment_export"
        sequence="20"
        groups="finance_kmitl.group_finance_kmitl_user_out"
    />

    <!-- Withholding Tax Certificates (outbound-side workflow) -->
    <menuitem
        id="menu_withholding_tax_cert"
        name="Withholding Tax Certificates"
        parent="menu_payment_root"
        action="l10n_th_account_tax.action_withholding_tax_cert_menu"
        sequence="25"
        groups="finance_kmitl.group_finance_kmitl_user_out"
    />

    <!-- Cheque Control Register -->
    <menuitem
        id="menu_cheque_register_root"
        name="Cheque Register"
        parent="menu_payment_root"
        sequence="30"
        groups="finance_kmitl.group_finance_kmitl_user_out,finance_kmitl.group_finance_kmitl_user_in" />
    <menuitem
        id="menu_cheque_register_outbound"
        name="Issued Cheques"
        parent="menu_cheque_register_root"
        action="action_cheque_register_outbound"
        sequence="10"
        groups="finance_kmitl.group_finance_kmitl_user_out" />
    <menuitem
        id="menu_cheque_register_inbound"
        name="Received Cheques"
        parent="menu_cheque_register_root"
        action="action_cheque_register_inbound"
        sequence="20"
        groups="finance_kmitl.group_finance_kmitl_user_in" />

    <!-- Settings submenu (manager only) -->
    <menuitem
        id="menu_payment_settings"
        name="Settings"
        parent="menu_payment_root"
        sequence="90"
        groups="finance_kmitl.group_finance_kmitl_manager"
    />
    <menuitem
        id="menu_settings_bank_payment_template"
        name="Bank Payment Templates"
        parent="menu_payment_settings"
        action="l10n_th_bank_payment_export.action_bank_payment_template"
        sequence="10"
    />
    <menuitem
        id="menu_settings_bank_export_format"
        name="Bank Export Formats"
        parent="menu_payment_settings"
        action="l10n_th_bank_payment_export_format.action_bank_export_format_template"
        sequence="20"
    />
    <menuitem
        id="menu_settings_payment_types"
        name="Payment Types (KMITL)"
        parent="menu_payment_settings"
        action="action_kmitl_payment_type"
        sequence="5"
    />
    <menuitem
        id="menu_settings_cheque_layout"
        name="Cheque Layouts"
        parent="menu_payment_settings"
        action="action_cheque_layout"
        sequence="15"
    />

</odoo>
