<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Assign a cheque print layout to a bank/cash journal (cheque book) -->
    <record id="view_account_journal_form_cheque" model="ir.ui.view">
        <field name="name">account.journal.form.cheque.kmitl</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bank_account_number']" position="after">
                <group name="cheque_settings" string="Cheque"
                    attrs="{'invisible': [('type', 'not in', ('bank', 'cash'))]}">
                    <field name="cheque_layout_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
