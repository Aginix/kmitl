<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- The filing run (การรวบรวมนำส่ง). KMITL files ภ.ง.ด. itself rather than
         letting a bank do it, so this list is not a folder of copies handed to
         payees — it *is* the return. A certificate that is not here, or that is
         still a draft, is a payee missing from the month's filing.

         Written from scratch rather than inherited, for the reason the payment
         list is (see account_payment_list_views.xml): the columns an officer
         footing a month needs are not the columns upstream shows for looking one
         certificate up. -->
    <record id="view_withholding_tax_cert_tree_kmitl" model="ir.ui.view">
        <field name="name">withholding.tax.cert.tree.kmitl</field>
        <field name="model">withholding.tax.cert</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" multi_edit="1">
                <header>
                    <!-- One press for the month. What it changes is not
                         cosmetic: the filing report reads certificates that are
                         no longer draft, so this is the act that puts the month
                         in the return. -->
                    <button
                        name="action_done"
                        string="Confirm for Filing"
                        type="object"
                        class="btn-primary"
                        confirm="Confirm the selected certificates for this month's filing? They can no longer be corrected afterwards — a wrong one has to be cancelled and reissued."
                    />
                </header>
                <field name="date" />
                <field name="name" />
                <field name="partner_id" string="Payee" />
                <field name="partner_vat" string="Payee Tax ID" optional="show" />
                <field name="income_tax_form" />
                <field name="currency_id" invisible="1" />
                <field name="amount_base_total" sum="Total Income" />
                <field name="amount_wht_total" sum="Total Withheld" />
                <field name="payment_id" optional="hide" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"
                />
            </tree>
        </field>
    </record>

    <record id="view_withholding_tax_cert_search_kmitl" model="ir.ui.view">
        <field name="name">withholding.tax.cert.search.kmitl</field>
        <field name="model">withholding.tax.cert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="payment_id" />
                <!-- First filter on the screen, because it is the one that
                     answers "what is still not in a return". -->
                <filter
                    name="draft"
                    string="Not Filed Yet"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="done"
                    string="Confirmed for Filing"
                    domain="[('state', '=', 'done')]"
                />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancel')]"
                />
                <separator />
                <!-- The month is the unit of a ภ.ง.ด., and the date these are
                     filtered on is the day the money actually left — see
                     withholding_tax_cert.py. -->
                <filter
                    name="this_month"
                    string="This Month"
                    domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(day=1, months=1, days=-1)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="last_month"
                    string="Last Month"
                    domain="[('date', '&gt;=', (context_today() + relativedelta(day=1, months=-1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(day=1, days=-1)).strftime('%Y-%m-%d'))]"
                />
                <separator />
                <filter
                    name="pnd1"
                    string="PND1"
                    domain="[('income_tax_form', '=', 'pnd1')]"
                />
                <filter
                    name="pnd3"
                    string="PND3"
                    domain="[('income_tax_form', '=', 'pnd3')]"
                />
                <filter
                    name="pnd53"
                    string="PND53"
                    domain="[('income_tax_form', '=', 'pnd53')]"
                />
                <separator />
                <!-- A rate with no default type of income cannot produce a
                     certificate line, so these are the ones the Hand-over could
                     not raise and an officer has to finish by hand. -->
                <filter
                    name="no_income_tax_form"
                    string="No Income Tax Form"
                    domain="[('income_tax_form', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_income_tax_form"
                        string="Income Tax Form"
                        context="{'group_by': 'income_tax_form'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_partner"
                        string="Payee"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_month"
                        string="Month"
                        context="{'group_by': 'date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_withholding_tax_cert_kmitl" model="ir.actions.act_window">
        <field name="name">Withholding Tax Certificates</field>
        <field name="res_model">withholding.tax.cert</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_withholding_tax_cert_tree_kmitl" />
        <field name="search_view_id" ref="view_withholding_tax_cert_search_kmitl" />
        <!-- Opens on what is still outstanding, grouped by the return it belongs
             to, because that is the question the office comes here with. -->
        <field
            name="context"
        >{'search_default_draft': 1, 'search_default_group_income_tax_form': 1}</field>
    </record>

</odoo>
