<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kmitl_paying_account_view_tree" model="ir.ui.view">
        <field name="name">kmitl.paying.account.tree</field>
        <field name="model">kmitl.paying.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="bank_account_id"/>
                <field name="bank_id" optional="show"/>
                <field name="payment_type_id"/>
                <field name="payment_account_id"/>
                <field name="cheque_layout_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="kmitl_paying_account_view_form" model="ir.ui.view">
        <field name="name">kmitl.paying.account.form</field>
        <field name="model">kmitl.paying.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="บัญชีธนาคาร">
                            <field name="bank_account_id"
                                   options="{'no_create': True}"/>
                            <field name="bank_id"/>
                            <field name="acc_number"/>
                        </group>
                        <group string="วิธีจ่ายและการลงบัญชี">
                            <field name="payment_type_id"
                                   options="{'no_create': True}"/>
                            <!-- The GL account belongs to the pair, not to the
                                 bank account: a cheque drawn on this account is
                                 booked against "เช็คจ่าย" until it clears, a
                                 transfer straight against the bank account. -->
                            <field name="payment_account_id"
                                   options="{'no_create': True}"/>
                            <field name="is_cheque" invisible="1"/>
                            <field name="cheque_layout_id"
                                   attrs="{'invisible': [('is_cheque', '=', False)]}"
                                   options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kmitl_paying_account_view_search" model="ir.ui.view">
        <field name="name">kmitl.paying.account.search</field>
        <field name="model">kmitl.paying.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="bank_account_id"/>
                <field name="bank_id"/>
                <field name="payment_type_id"/>
                <filter string="เช็ค" name="cheque"
                        domain="[('is_cheque', '=', True)]"/>
                <filter string="เงินสด" name="cash"
                        domain="[('is_cash', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="ธนาคาร" name="group_bank"
                            context="{'group_by': 'bank_id'}"/>
                    <filter string="วิธีจ่าย" name="group_method"
                            context="{'group_by': 'payment_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_paying_account" model="ir.actions.act_window">
        <field name="name">หัวจ่าย (Paying Accounts)</field>
        <field name="res_model">kmitl.paying.account</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีหัวจ่าย
            </p>
            <p>
                หัวจ่ายคือคู่ของ "บัญชีธนาคารของสถาบัน" กับ "วิธีจ่าย" —
                บัญชีเดียวกันจ่ายด้วยเงินโอนและด้วยเช็คได้ แต่ลงบัญชีแยกประเภทคนละตัว
                (เช็คลง "เช็คจ่าย" จนกว่าเช็คจะขึ้นเงิน) จึงต้องสร้างหัวจ่ายหนึ่งรายการต่อหนึ่งวิธีจ่าย
            </p>
        </field>
    </record>

    <!-- The institute-wide fallback: a payee whose bank is not one of the main
         paying banks is paid from this account. -->
    <record id="view_company_form_inherit_paying" model="ir.ui.view">
        <field name="name">res.company.form.inherit.paying.finance_kmitl</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="หัวจ่าย (Paying Account)" name="kmitl_paying_account">
                    <field name="default_paying_account_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
