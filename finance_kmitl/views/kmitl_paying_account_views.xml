<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- หัวจ่าย is a payment method line: Odoo already models "on this voucher
         journal, money may move this way, booked against this account". These
         views are that model presented as the treasury office's master data,
         narrowed to the lines that actually name their GL account — the ones
         Odoo seeds on every bank journal by default do not, and are not paying
         accounts. -->
    <record id="kmitl_paying_account_view_tree" model="ir.ui.view">
        <field name="name">account.payment.method.line.paying.tree</field>
        <field name="model">account.payment.method.line</field>
        <field name="arch" type="xml">
            <!-- payment_type, available_payment_method_ids and company_id are
                 carried because core's own domains on payment_method_id and
                 payment_account_id read them; a view that leaves one out fails
                 validation. -->
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="payment_type" invisible="1"/>
                <field name="available_payment_method_ids" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="journal_id"/>
                <field name="payment_method_id"/>
                <field name="bank_id" optional="show"/>
                <field name="acc_number" optional="show"/>
                <field name="payment_account_id"/>
                <field name="cheque_layout_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="kmitl_paying_account_view_form" model="ir.ui.view">
        <field name="name">account.payment.method.line.paying.form</field>
        <field name="model">account.payment.method.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. เงินโอน – ธ.กรุงไทย /หัวตะเข้ /CA-028-6-01583-8"
                            />
                        </h1>
                    </div>
                    <group>
                        <group string="ใบสำคัญและวิธีจ่าย">
                            <!-- payment_type and available_payment_method_ids are
                                 read by core's domain on payment_method_id, and
                                 company_id by its domain on payment_account_id,
                                 so all three have to be in the view. -->
                            <field name="payment_type" invisible="1"/>
                            <field name="available_payment_method_ids" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="payment_method_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="บัญชีและการลงบัญชี">
                            <!-- The institute's own bank account: the sending
                                 account of the e-payment file and the cheque
                                 book the register controls. Empty for cash. -->
                            <field name="payment_method_code" invisible="1"/>
                            <field name="bank_account_id"
                                   options="{'no_create': True}"/>
                            <!-- Naming this account is what makes the line a
                                 paying account at all. -->
                            <field name="payment_account_id"
                                   options="{'no_create': True}"/>
                            <field name="cheque_layout_id"
                                   attrs="{'invisible': [('payment_method_code', '!=', 'kmitl_cheque')]}"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kmitl_paying_account_view_search" model="ir.ui.view">
        <field name="name">account.payment.method.line.paying.search</field>
        <field name="model">account.payment.method.line</field>
        <field name="arch" type="xml">
            <!-- Only fields whose domain is literal or absent are declared
                 here: the same domain validation applies to search views, and
                 journal_id / payment_method_id would drag their siblings in for
                 no gain — the group-by filters below need no field node. -->
            <search>
                <field name="name"/>
                <field name="bank_id"/>
                <group expand="0" string="Group By">
                    <filter string="ธนาคาร" name="group_bank"
                            context="{'group_by': 'bank_id'}"/>
                    <filter string="วิธีจ่าย" name="group_method"
                            context="{'group_by': 'payment_method_id'}"/>
                    <filter string="ใบสำคัญ" name="group_journal"
                            context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_paying_account" model="ir.actions.act_window">
        <field name="name">หัวจ่าย (Paying Accounts)</field>
        <field name="res_model">account.payment.method.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('payment_account_id', '!=', False)]</field>
        <field name="context">{'search_default_group_bank': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('kmitl_paying_account_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('kmitl_paying_account_view_form')}),
        ]"/>
        <field name="search_view_id" ref="kmitl_paying_account_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีหัวจ่าย
            </p>
            <p>
                หัวจ่ายคือรายการวิธีจ่ายบนใบสำคัญ — บอกทั้งใบสำคัญที่ใช้ วิธีจ่าย
                บัญชีธนาคารของสถาบันที่เงินออก และบัญชีแยกประเภทที่ลงรายการ
                บัญชีธนาคารเดียวกันมีได้หลายหัวจ่าย (เช่นกระแสรายวันที่ทั้งโอนและออกเช็คได้)
                แต่ทุกหัวจ่ายของบัญชีเดียวกันต้องลงบัญชีแยกประเภทตัวเดียวกัน
            </p>
        </field>
    </record>

    <!-- The institute-wide fallback: a payee whose bank is not one of the main
         paying banks is paid from this account. -->
    <record id="view_company_form_inherit_paying" model="ir.ui.view">
        <field name="name">res.company.form.inherit.paying.finance_kmitl</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="หัวจ่าย (Paying Account)" name="kmitl_paying_account">
                    <field name="default_paying_account_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
