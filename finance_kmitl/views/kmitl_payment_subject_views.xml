<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kmitl_payment_subject_view_tree" model="ir.ui.view">
        <field name="name">kmitl.payment.subject.tree</field>
        <field name="model">kmitl.payment.subject</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_method"/>
                <field name="bank_policy" optional="show"/>
                <field name="journal_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="kmitl_payment_subject_view_form" model="ir.ui.view">
        <field name="name">kmitl.payment.subject.form</field>
        <field name="model">kmitl.payment.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. เงินเดือน"/></h1>
                    </div>
                    <group>
                        <!-- Step 1: choose cheque or transfer. Cheque needs no
                             paying bank here (cheques draw on the journal of
                             the 'จ่ายเช็ค' payment type); transfers configure
                             the main paying journal / bank policy. -->
                        <group>
                            <field name="default_method" widget="radio"/>
                            <field name="bank_policy" widget="radio"
                                   attrs="{'invisible': [('default_method', '=', 'cheque')]}"/>
                            <field name="journal_id"
                                   attrs="{'invisible': ['|', ('default_method', '=', 'cheque'), ('bank_policy', '=', 'payee_bank')], 'required': [('default_method', '=', 'transfer'), ('bank_policy', '=', 'fixed')]}"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kmitl_payment_subject" model="ir.actions.act_window">
        <field name="name">Payment Subjects (เรื่องที่จ่าย)</field>
        <field name="res_model">kmitl.payment.subject</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
