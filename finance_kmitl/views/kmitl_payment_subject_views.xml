<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kmitl_payment_subject_view_tree" model="ir.ui.view">
        <field name="name">kmitl.payment.subject.tree</field>
        <field name="model">kmitl.payment.subject</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_payment_type_id"/>
                <field name="default_paying_account_id" optional="show"/>
                <field name="allowed_paying_account_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="kmitl_payment_subject_view_form" model="ir.ui.view">
        <field name="name">kmitl.payment.subject.form</field>
        <field name="model">kmitl.payment.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. เงินเดือน"/></h1>
                    </div>
                    <group>
                        <group string="วิธีจ่าย">
                            <field name="default_payment_type_id" options="{'no_create': True}"/>
                        </group>
                        <group string="หัวจ่าย">
                            <field name="auto_match_payee_bank"/>
                            <field name="allowed_paying_account_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   attrs="{'invisible': [('auto_match_payee_bank', '=', False)]}"/>
                            <!-- One field, two roles: the label follows the
                                 auto-match flag. -->
                            <field name="default_paying_account_id"
                                   string="หัวจ่ายหลัก"
                                   options="{'no_create': True}"
                                   attrs="{'invisible': [('auto_match_payee_bank', '=', True)]}"/>
                            <field name="default_paying_account_id"
                                   string="หัวจ่ายสำรอง (fallback)"
                                   options="{'no_create': True}"
                                   attrs="{'invisible': [('auto_match_payee_bank', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        เปิด "จับคู่ตามธนาคารผู้รับ" = จ่ายผู้รับแต่ละรายจากหัวจ่ายของธนาคารเดียวกับบัญชีผู้รับ
                        (ไม่ตรงกับที่อนุญาตเลย จะใช้หัวจ่ายสำรอง) ·
                        ปิด = ทุกรายจ่ายจากหัวจ่ายหลักบัญชีเดียว ·
                        เว้นว่างหัวจ่ายหลัก/สำรอง = ใช้หัวจ่ายตั้งต้นของสถาบัน
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kmitl_payment_subject" model="ir.actions.act_window">
        <field name="name">Payment Subjects (เรื่องที่จ่าย)</field>
        <field name="res_model">kmitl.payment.subject</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
