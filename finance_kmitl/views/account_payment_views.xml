<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit account.payment form: add Submit button, update statusbar -->
    <record id="view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.kmitl</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Hide Confirm (action_post) - posting is done from account.move -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Submit button before the hidden Confirm -->
            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_submit" string="Submit" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" data-hotkey="v" />
                <!-- Cheque payments never enter a bank export, so finance
                     confirms their actual result manually here. Transfers are
                     confirmed from the bank payment export line instead. -->
                <field name="is_cheque_payment" invisible="1"/>
                <button name="action_mark_bank_result_success"
                        string="ยืนยันจ่ายสำเร็จ (เช็ค)"
                        type="object"
                        class="btn-success"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'submitted'), ('is_cheque_payment', '=', False), ('bank_result_status', '=', 'success')]}"
                        groups="finance_kmitl.group_finance_kmitl_user_out"/>
                <button name="action_mark_bank_result_failed"
                        string="จ่ายไม่สำเร็จ (เช็ค)"
                        type="object"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'submitted'), ('is_cheque_payment', '=', False), ('bank_result_status', '=', 'failed')]}"
                        groups="finance_kmitl.group_finance_kmitl_user_out"/>
            </xpath>

            <!-- Bank result (set by export-line marking or the cheque buttons) -->
            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="bank_result_status"
                       attrs="{'invisible': [('bank_result_status', '=', False)]}"
                       readonly="1"/>
            </xpath>

            <!-- Update Reset to Draft to also work from submitted -->
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', 'not in', ('posted', 'cancel', 'submitted'))]}</attribute>
            </xpath>

            <!-- Update statusbar to show submitted -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,submitted,posted</attribute>
            </xpath>

            <!-- Hide payment_type selector (controlled by kmitl_payment_type_id) -->
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide is_internal_transfer -->
            <xpath expr="//field[@name='is_internal_transfer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide bank_payment_template_id (from l10n_th_bank_payment_export) -->
            <xpath expr="//field[@name='bank_payment_template_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide operating_unit_id (from account_operating_unit) -->
            <xpath expr="//field[@name='operating_unit_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- journal_id is auto-set from kmitl_payment_type_id; not user-editable.
                 force_save persists the value set by the onchange even though readonly. -->
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="attrs">{'readonly': [(1, '=', 1)]}</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Hide export status display (managed via the bank export wizard) -->
            <xpath expr="//label[@for='export_status']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[field[@name='export_status']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Lock Memo once the payment leaves draft -->
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>

            <!-- Add KMITL payment type where payment_type was -->
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="kmitl_payment_type_id" domain="[('direction', '=', payment_type)]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <!-- หัวจ่าย: the account the money leaves from. Editable while
                     the entry is not posted so finance can correct it. -->
                <field name="paying_account_id"
                       options="{'no_create': True}"
                       attrs="{'readonly': [('state', 'not in', ('draft', 'submitted'))]}"/>
            </xpath>

            <!-- Rename partner_id labels: Customer -> Payer (inbound), Vendor -> Payee (outbound).
                 Selector cannot use @string (translated attr is forbidden); match via @attrs which
                 contains the discriminating partner_type value. -->
            <xpath expr="//field[@name='partner_id'][contains(@attrs, 'customer')]" position="attributes">
                <attribute name="string">Payer</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][contains(@attrs, 'supplier')]" position="attributes">
                <attribute name="string">Payee</attribute>
            </xpath>

            <!-- Rename partner_bank_id labels accordingly -->
            <xpath expr="//field[@name='partner_bank_id'][contains(@attrs, 'customer')]" position="attributes">
                <attribute name="string">Payer Bank Account</attribute>
                <attribute name="attrs">{'invisible': ['|', '|', '|', ('show_partner_bank_account', '=', False), ('partner_type', '!=', 'customer'), ('is_internal_transfer', '=', True), ('payment_type', '=', 'inbound')], 'required': [('require_partner_bank_account', '=', True), ('is_internal_transfer', '=', False)], 'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][contains(@attrs, 'supplier')]" position="attributes">
                <attribute name="string">Payee Bank Account</attribute>
                <attribute name="attrs">{'invisible': ['|', '|', '|', ('show_partner_bank_account', '=', False), ('partner_type', '!=', 'supplier'), ('is_internal_transfer', '=', True), ('payment_type', '=', 'inbound')], 'required': [('require_partner_bank_account', '=', True), ('is_internal_transfer', '=', False)], 'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>

            <!-- Move partner_bank_id directly under partner_id (per direction) -->
            <xpath expr="//field[@name='partner_id'][contains(@attrs, 'customer')]" position="after">
                <xpath expr="//field[@name='partner_bank_id'][contains(@attrs, 'customer')]" position="move"/>
            </xpath>
            <xpath expr="//field[@name='partner_id'][contains(@attrs, 'supplier')]" position="after">
                <xpath expr="//field[@name='partner_bank_id'][contains(@attrs, 'supplier')]" position="move"/>
            </xpath>

            <!-- Withholding tax breakdown (shown only when the payment has WHT) -->
            <xpath expr="//group[@name='group2']/.." position="after">
                <group string="Withholding Tax Summary" name="wht_summary"
                       attrs="{'invisible': [('amount_wht', '=', 0)]}">
                    <field name="amount_before_wht"/>
                    <field name="amount_wht"/>
                    <field name="amount" string="Net Amount Paid" readonly="1" force_save="1"/>
                </group>
            </xpath>

            <!-- Add Budget tab -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Accounting Dimensions" name="budget">
                        <group string="Accounting Dimensions" name="budget_info">
                            <field name="analytic_distribution" widget="analytic_distribution" invisible="1"/>
                            <field name="activity_analytic_id" domain="[('plan_id.code', '=', 'activities')]" options="{'no_create': True}" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="department_analytic_id" domain="[('plan_id.code', '=', 'departments')]" options="{'no_create': True}" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="fund_analytic_id" domain="[('plan_id.code', '=', 'funds')]" options="{'no_create': True}" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="source_analytic_id" domain="[('plan_id.code', '=', 'sources')]" options="{'no_create': True}" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </page>
                </notebook>
            </xpath>

            <!-- Smart button: cheques linked to this payment in the register -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cheque_register" type="object" class="oe_stat_button" icon="fa-credit-card"
                    attrs="{'invisible': [('cheque_register_count', '=', 0)]}">
                    <field name="cheque_register_count" widget="statinfo" string="Cheques"/>
                </button>
            </xpath>

        </field>
    </record>

    <!-- Inherit account.payment tree: add kmitl_payment_type column -->
    <record id="view_account_payment_tree_inherit" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.kmitl</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kmitl_payment_type_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
