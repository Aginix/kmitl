<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_flow_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.flow.wizard.form</field>
        <field name="model">purchase.request.flow.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="request_id" invisible="1" />
                    <field name="approval_id" invisible="1" />
                    <field name="mode" invisible="1" />
                    <field name="reason" placeholder="กรุณาระบุเหตุผล..." />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="ยืนยัน"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="ปิด" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
