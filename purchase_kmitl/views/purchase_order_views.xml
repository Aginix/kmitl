<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View purchase.order form (KMITL: general + contract) -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <!-- Contract Details / Fines sections -->
            <xpath expr="//field[@name='date_order']/../.." position="after">
                <group
                    string="Contract Details"
                    name="contract_info_section"
                >
                    <group>
                        <field name="contract_name" />
                        <field
                            name="contract_type_id"
                            required="1"
                            options="{'no_open': True}"
                        />
                        <field name="contract_number" />
                        <field name="date_order_date" required="1" />
                        <label for="contract_period_days" />
                        <div name="contract_period_days_div" class="o_row">
                            <field name="contract_period_days" required="1" />
                            <span>วัน</span>
                        </div>
                        <label for="work_start" string="Date Work" />
                        <div name="work_start_div" class="o_row">
                            <field name="work_start" required="1" />
                            <i
                                class="fa fa-long-arrow-right mx-2 oe_edit_only"
                                aria-label="Arrow icon"
                                title="Arrow"
                            />
                            <field name="work_end" readonly="1" />
                        </div>
                    </group>
                </group>
                <group string="Fines Details" name="fines_supervision_section">
                    <group>
                        <field name="fines_late" invisible="1" />
                        <field name="late_days" invisible="1" />
                        <field name="fines_rate" widget="float" />
                        <field name="supervision_cost" widget="float" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Fines" name="late_fines_page">
                    <group>
                        <field name="fines_late" widget="float" readonly="1" />
                        <field name="late_days" readonly="1" />
                    </group>
                </page>
            </xpath>

            <!-- General KMITL fields -->
            <field name="partner_id" position="before">
                <field
                    name="account_fiscal_year_id"
                    widget="selection"
                    required="1"
                    invisible="1"
                />
            </field>
            <xpath expr="//group/group[1]" position="inside">
                <field name="payment_type" required="1" invisible="1" />
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_purchase_request"
                    type="object"
                    icon="fa-shopping-cart"
                    string="Purchase Request"
                    class="oe_stat_button"
                />
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="department_id" />
            </xpath>

            <!-- Attachment page -->
            <xpath expr="//notebook" position="inside">
                <page name="document" string="Attachment">
                    <field
                        name="attachment_ids"
                        context="{'default_res_model': 'purchase.order'}"
                    >
                        <tree default_order="sequence">
                            <field name="sequence" widget="handle" />
                            <field name="name" string="File Name" required="1" />
                            <field name="description" />
                        </tree>
                        <form>
                            <sheet>
                                <group>
                                    <field
                                        name="res_model"
                                        invisible="1"
                                        readonly="0"
                                    />
                                    <field name="res_id" invisible="1" readonly="0" />
                                    <field name="name" required="1" invisible="1" />
                                    <field name="datas" filename="name" required="1" />
                                    <field
                                        name="description"
                                        placeholder="Description"
                                    />
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <h2>Purchase Order Form</h2>
            </xpath>

            <!-- State / button tweaks -->
            <xpath expr="//field[@name='state']" position="replace">
                <field
                    name="state"
                    widget="statusbar"
                    statusbar_visible="draft,purchase,done,cancel"
                    readonly="1"
                />
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="string">Cancel PO</attribute>
                <attribute name="states">purchase</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="states">done,cancel</attribute>
            </xpath>
            <xpath expr="//button[@name='button_done']" position="attributes">
                <attribute name="string">Done</attribute>
            </xpath>
            <xpath expr="//button[@name='button_unlock']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide base / upstream fields not used by KMITL -->
            <xpath
                expr="//button[@name='action_rfq_send' and @states='draft']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_rfq_send' and @states='sent']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='action_rfq_send' and @states='purchase']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='confirm_reminder_mail']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='date_planned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='reminder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_planned_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ignore_exception']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//button[@name='%(purchase_stock.action_purchase_vendor_delay_report)d']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- hide label -->
            <xpath expr="//span[hasclass('o_form_label')][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- View purchase.order form: invoice plan + information section -->
    <record id="view_purchase_order_form_invoice_plan" model="ir.ui.view">
        <field name="name">view.purchase.order.form(Invoice Plan)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_invoice_plan.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_invoice_plan']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='remove_invoice_plan']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', ('state', '!=', 'draft'), ('invoice_plan_ids', '=', []), ('invoice_count', '>', 0)]}</attribute>
            </xpath>
            <xpath expr="/form/sheet/notebook" position="before">
                <group string="Purchase Details" name="information_section">
                    <group>
                        <field
                            name="account_fiscal_year_id"
                            widget="selection"
                            readonly="1"
                        />
                        <field
                            name="partner_id"
                            readonly="1"
                            widget="res_partner_many2one"
                            context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"
                        />
                        <field name="department_id" readonly="1" />
                        <field name="payment_type" readonly="1" />
                    </group>
                </group>

                <field name="invoice_count" invisible="1" />

                <group
                    string="Invoice Plan"
                    name="invoice_plan_section"
                    attrs="{'readonly': [('invoice_count', '>', 0)]}"
                >
                    <field name="use_invoice_plan" string="use invoice plan" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- View purchase.order tree (KMITL: contract columns + hidden base columns) -->
    <record id="view_purchase_order_tree" model="ir.ui.view">
        <field name="name">view.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <!-- Contract columns before partner_id -->
            <field name="partner_id" position="before">
                <field name="contract_number" optional="show" />
                <field name="contract_name" />
                <field name="contract_type_id" />
            </field>

            <!-- work_start after partner_id -->
            <field name="partner_id" position="after">
                <field name="work_start" optional="show" />
            </field>

            <!-- work_end_display after amount_total -->
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="work_end_display" />
            </xpath>

            <!-- late_days at end of tree -->
            <xpath expr="//tree" position="inside">
                <field name="late_days" optional="hide" />
            </xpath>

            <!-- payment_type after invoice_status -->
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="payment_type" optional="show" />
            </xpath>

            <!-- Hide / de-emphasise base columns -->
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='date_approve']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- View purchase.order search (KMITL: contract + payment type) -->
    <record id="view_purchase_order_search" model="ir.ui.view">
        <field name="name">purchase.order.list.select</field>
        <field name="model">purchase.order</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search" />
        <field name="arch" type="xml">
            <!-- Contract search fields / filters -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="contract_number" />
            </xpath>
            <xpath expr="//search" position="inside">
                <filter
                    string="Work delayed"
                    name="work_delayed"
                    domain="[('state', 'in', ['purchase', 'done']), ('late_days', '&gt;', 0)]"
                />
            </xpath>
            <xpath expr="//separator[1]" position="after">
                <filter
                    string="Contract period 0 - 15 days"
                    name="period_0_15"
                    domain="[('contract_period_days', '&gt;=', 0), ('contract_period_days', '&lt;=', 15)]"
                />
                <filter
                    string="Contract period 0 - 30 days"
                    name="period_0_30"
                    domain="[('contract_period_days', '&gt;=', 0), ('contract_period_days', '&lt;=', 30)]"
                />
                <filter
                    string="Contract period 0 - 60 days"
                    name="period_0_60"
                    domain="[('contract_period_days', '&gt;=', 0), ('contract_period_days', '&lt;=', 60)]"
                />
                <filter
                    string="Contract period 60+ days"
                    name="period_60"
                    domain="[('contract_period_days', '&gt;', 60)]"
                />
            </xpath>

            <!-- Payment type field + group-by filters -->
            <field name="product_id" position="before">
                <field name="payment_type" />
            </field>
            <xpath expr="//group" position="inside">
                <filter
                    string="Vendor"
                    name="partner_id"
                    context="{'group_by': 'partner_id'}"
                />
                <filter
                    string="Payment Type"
                    name="payment_type"
                    domain="[]"
                    context="{'group_by': 'payment_type'}"
                />
                <filter
                    string="Contract Type"
                    name="contract_type_id"
                    context="{'group_by': 'contract_type_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
