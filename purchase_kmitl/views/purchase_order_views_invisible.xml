<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide picking_type_id from purchase_stock -->
    <record id="view_purchase_order_form_purchase_stock" model="ir.ui.view">
        <field name="name">view.purchase.order.form(Hide Stock)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide exception_ids from purchase_exception -->
    <record id="view_purchase_order_form_invisible_exception" model="ir.ui.view">
        <field name="name">view.purchase.order.form(Hide Exception)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_exception.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='exception_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide requisition fields from purchase_requisition -->
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">view.purchase.order.form(Hide Requisition)</field>
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_requisition.purchase_order_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='alternative_pos']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='requisition_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide label from purchase_no_rfq -->
    <record id="view_purchase_order_no_rfq_form_invisible" model="ir.ui.view">
        <field name="name">view.purchase.order.form(Hide label)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_no_rfq.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//span[hasclass('o_form_label')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
