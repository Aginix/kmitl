<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="hr_employee_relative_relation_search">
        <field name="name">hr.employee.relative.relation.search</field>
        <field name="model">hr.employee.relative.relation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_employee_relative_relation_view_tree">
        <field name="name">hr.employee.relative.relation.view.tree</field>
        <field name="model">hr.employee.relative.relation</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="hr_employee_relative_relation_act_window">
        <field name="name">Relative Relation</field>
        <field name="res_model">hr.employee.relative.relation</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="hr_employee_relative_relation_menu">
        <field name="name">Relative Relation</field>
        <field name="parent_id" ref="hr.menu_config_employee" />
        <field name="action" ref="hr_employee_relative_relation_act_window" />
        <field name="sequence" eval="17" />
    </record>
</odoo>
