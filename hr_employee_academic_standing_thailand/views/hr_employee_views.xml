<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">view.hr.employee.view.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="(//page[@name='hr_settings']/group)" position="inside">
                <group name="academic_standing_title" string="Academic Standing Title">
                    <field
                        name="academic_standing_id"
                        attrs="{'invisible': [('role', '!=', 'academic')]}"
                    />
                    <field
                        name="rank_id"
                        attrs="{'invisible': [('role', '!=', 'academic')]}"
                    />
                    <field
                        name="profession_id"
                        attrs="{'invisible': [('role', '!=', 'academic')]}"
                    />
                    <field
                        name="rank_nobility_id"
                        attrs="{'invisible': [('role', '!=', 'academic')]}"
                    />
                    <field name="academic_standing_title" />
                    <field
                        name="academic_standing_title_abbreviation"
                        attrs="{'invisible': [('role', '!=', 'academic')]}"
                    />
                    <field name="academic_standing_title_en" />
                    <field
                        name="academic_standing_title_abbreviation_en"
                        attrs="{'invisible': [('role', '!=', 'academic')]}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
