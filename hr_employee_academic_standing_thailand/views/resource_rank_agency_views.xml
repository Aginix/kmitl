<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View resource.rank.agency View Tree -->
    <record id="view_resource_rank_agency_tree" model="ir.ui.view">
        <field name="name">view.resource.rank.agency.tree</field>
        <field name="model">resource.rank.agency</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="name_abbreviation" />
            </tree>
        </field>
    </record>

    <!-- View resource.rank.agency form -->
    <record id="view_resource_rank_agency_form" model="ir.ui.view">
        <field name="name">view.resource.rank.agency.form</field>
        <field name="model">resource.rank.agency</field>
        <field name="arch" type="xml">
            <form string="HR Employee Rank Agency">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="name_abbreviation" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View resource.rank.agency search -->
    <record id="view_resource_rank_agency_search" model="ir.ui.view">
        <field name="name">view.resource.rank.agency.search</field>
        <field name="model">resource.rank.agency</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action resource.rank.agency -->
    <record id="action_resource_rank_agency" model="ir.actions.act_window">
        <field name="name">HR Employee Rank Agency</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">resource.rank.agency</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Resource Rank Agency.
            </p>
        </field>
    </record>

</odoo>
