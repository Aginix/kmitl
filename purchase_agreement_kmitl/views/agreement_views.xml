<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View agreement tree -->
    <record id="view_agreement_tree" model="ir.ui.view">
        <field name="name">view.agreement.tree</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

            <xpath expr="//field[@name='code']" position="after">
                <field name="purchase_order_id" string="PO Ref"/>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='parent_agreement_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='agreement_type_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='agreement_subtype_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- View agreement kanban -->
    <record id="view_agreement_kanban" model="ir.ui.view">
        <field name="name">view.agreement.kanban</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.view_project_agreement_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- View agreement form -->
    <record id="view_agreement_form" model="ir.ui.view">
        <field name="name">view.agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="domain">[('stage_type', '=', 'agreement'), ('name', 'in', ['New','Draft','Active','Expired','Terminated','Cancelled'])]</attribute>
            </xpath>

            <xpath expr="//h1" position="after">
                <label for="purchase_order_id" string="PO Ref"/>
                <h2>
                    <field name="purchase_order_id" readonly='True'/>
                </h2>
            </xpath>

            <xpath expr="//button[@name='create_new_version']" position="attributes">
                <attribute name="name">action_open_new_version_wizard</attribute>
            </xpath>

            <xpath expr="//field[@name='parent_agreement_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='template_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='agreement_type_id']" position="after">
                <field name="contract_type" readonly="1" />
            </xpath>

            <xpath expr="//field[@name='agreement_type_id']" position="attributes">
                <attribute name="required">False</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='agreement_subtype_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='assigned_user_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>

            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>

            <xpath expr="//field[@name='description']" position="before">
                <label for="description" string="Description"/>
            </xpath>

            <xpath expr="//group[field[@name='field_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//p[contains(text(), 'add dynamic fields')]" position="replace">
                <p invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='parties']" position="attributes">
                <attribute name="string"></attribute>
            </xpath>

            <xpath expr="//group[@name='cust_parties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='parties']//p" position="replace">
                <p invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='company']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='partner_left']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='contact_right']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='signature_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='to_review_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='change_notice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='notification_address_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='termination_requested']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='termination_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='structure']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='child_agreements']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='performance']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='code']" position="after">
                <field name="version" string='version'/>
            </xpath>

            <xpath expr="//field[@name='expiration_notice']" position="after">
                <field name="contract_type" invisible="1" readonly="0" />
                <field name="work_start_date" attrs="{'invisible': [('contract_type', '!=', 'contract_construction')]}" />
                <field name="work_end_date" attrs="{'invisible': [('contract_type', '!=', 'contract_construction')]}" />
            </xpath>

            <xpath expr="//field[@name='qty']" position="before">
                <field name="product_categ_id" required="1"/>
            </xpath>

            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="price_unit" />
                <field name="price_subtotal" />
            </xpath>

            <xpath expr="//page[@name='old_versions']//field[@name='previous_version_agreements_ids']//tree//field[@name='name']" position="after">
                <field name="revision_reason"/>
            </xpath>

            <xpath expr="//page[@name='old_versions']//field[@name='previous_version_agreements_ids']//tree//field[@name='revision']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//page[@name='old_versions']" position="before">

                <page name="committee" string="Committee">

                    <field name="pr1_total" invisible='1'/>
                    <separator string="Work Acceptance Committee"/>
                    <field name="work_acceptance_committee_ids" readonly="1">
                        <tree>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="approve_role"/>
                            <field name="department_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </tree>
                    </field>

                    <div attrs="{'invisible': [('pr1_total', '&lt;', 100000)]}">
                        <separator string="TOR Committee"/>
                        <field name="tor_committee_ids" readonly="1">
                            <tree>
                                <field name="employee_id"/>
                                <field name="name"/>
                                <field name="approve_role"/>
                                <field name="department_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="note"/>
                            </tree>
                        </field>

                        <separator string="Price Determine Committee"/>
                        <field name="price_determine_committee_ids" readonly="1">
                            <tree>
                                <field name="employee_id"/>
                                <field name="name"/>
                                <field name="approve_role"/>
                                <field name="department_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="note"/>
                            </tree>
                        </field>


                        <separator string="Evaluation Committee"/>
                        <field name="evaluation_committee_ids" readonly="1">
                            <tree>
                                <field name="employee_id"/>
                                <field name="name"/>
                                <field name="approve_role"/>
                                <field name="department_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </div>
                </page>

                <page name="document" string="Attachment">
                        <separator string="Attachment"/>
                        <field name="document_ids">
                            <tree>
                                <field name="file" filename="file_name" />
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>
                        <separator string="Attachment Reversion"/>
                        <field name="reversion_document_ids">
                            <tree>
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>
                </page>

                <page name="fee" string="Fee">
                    <group name="fee">
                        <field name="fee" />
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='special_terms']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@name='Administration']/preceding-sibling::separator[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@name='Administration']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//p[@name='footer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- View agreement form -->
    <record id="view_l10n_agreement_form" model="ir.ui.view">
        <field name="name">view.l10n.agreement.form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_agreement.partner_agreement_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_order_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='to_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='invoiced']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
