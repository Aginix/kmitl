<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form.operating.unit</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit"/>
            </xpath>
        </field>
    </record>

    <record id="approval_request_view_search" model="ir.ui.view">
        <field name="name">approval.request.view.search.operating.unit</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit"/>
                <filter name="group_operating_unit" string="Operating Unit"
                        context="{'group_by': 'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"/>
            </xpath>
        </field>
    </record>

</odoo>
