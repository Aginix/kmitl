<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_rule_approval_request_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="agx_approval.model_approval_request"/>
        <field name="domain_force">
            ['|',
             '|', ('operating_unit_id','=',False),
                  ('operating_unit_id','in',user.operating_unit_ids.ids),
             '|', ('owner_id.user_id','=',user.id),
                  ('user_id','=',user.id)]
        </field>
        <field name="name">Approval Request from allowed operating units</field>
        <field name="global" eval="True"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>

