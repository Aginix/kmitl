<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Comment editor — granted independently of the Sarabun access level, like
             the Route Editor (ADR-0018): NO module category so it renders as a
             standalone checkbox in "Other". It grants no extra document access; the
             editor corrects comments on the หนังสือ they can already open. -->
        <record id="group_sarabun_step_note_edit" model="res.groups">
            <field name="name">Sarabun Comment Editor</field>
            <field name="category_id" eval="False" />
            <field
                name="implied_ids"
                eval="[(4, ref('agx_sarabun.group_sarabun_user'))]"
            />
        </record>
    </data>
</odoo>
