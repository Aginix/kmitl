<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sarabun_step_note_wizard_form" model="ir.ui.view">
        <field name="name">sarabun.step.note.wizard.form</field>
        <field name="model">sarabun.step.note.wizard</field>
        <field name="arch" type="xml">
            <form string="แก้ไขความเห็น">
                <group>
                    <field name="step_id" string="ขั้นตอน" readonly="1" />
                    <field name="acted_by_id" readonly="1" />
                    <field name="note" />
                </group>
                <p class="text-muted">
                    การแก้ไขจะบันทึกในประวัติของหนังสือ (ข้อความเดิม → ข้อความใหม่)
                </p>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="บันทึก"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
