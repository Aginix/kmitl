<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- verifier_id's domain reads operating_unit_id client-side, but the visible
         operating_unit_id is gated on group_multi_operating_unit: keep an
         ungated invisible copy so single-OU users can still open the picker. -->
    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.form.verifier.operating_unit</field>
        <field name="model">approval.request</field>
        <field
            name="inherit_id"
            ref="agx_approval_verifier.approval_request_view_form"
        />
        <field name="arch" type="xml">
            <field name="verifier_id" position="before">
                <field name="operating_unit_id" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
