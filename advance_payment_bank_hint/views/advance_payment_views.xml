<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_advance_payment_form_bank_hint" model="ir.ui.view">
        <field name="name">advance.payment.form.bank.hint</field>
        <field name="model">advance.payment</field>
        <field name="inherit_id" ref="advance_payment.view_advance_payment_form" />
        <field name="arch" type="xml">
            <field name="use_unlisted_bank" position="before">
                <div
                    colspan="2"
                    class="alert alert-info mb-2"
                    role="status"
                    attrs="{'invisible': [('state', '!=', 'draft')]}"
                >
                    💡 แนะนำให้รับเงินผ่านบัญชีธนาคารไทยพาณิชย์ (SCB) เพื่อไม่ต้องเสียค่าธรรมเนียมการโอน หากใช้บัญชีธนาคารอื่น อาจมีค่าธรรมเนียมซึ่งจะหักจากยอดเงินที่ท่านได้รับ
                </div>
            </field>
        </field>
    </record>
</odoo>
