<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_compilation_f24" model="ir.actions.report">
        <field name="name">F24 สรุปงบประมาณตามหน่วยงาน</field>
        <field name="model">budget.appropriation.master.summary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_summary_f24.report_compilation_f24</field>
        <field name="report_file">budget_appropriation_summary_f24.report_compilation_f24</field>
        <field name="paperformat_id" ref="budget_appropriation_summary.paperformat_landscape" />
    </record>

    <!-- Partial template for F24 content -->
    <template id="report_compilation_f24_content">
        <style>
            .f24 {
                font-size: 11pt;
                border-color: #000 !important;
            }
            .f24 th, .f24 td {
                border-color: #000 !important;
            }
            .f24 thead th {
                text-align: center;
                vertical-align: middle;
                font-weight: bold;
            }
            .f24 tbody td.num {
                text-align: right;
                white-space: nowrap;
            }
            .f24 tfoot th {
                text-align: right;
                white-space: nowrap;
                font-weight: bold;
            }
            .f24 tfoot th.dept {
                text-align: center;
            }
        </style>
        <div class="page landscape" t-att-contenteditable="'true' if o.env.context.get('html_preview', False) else None">
            <t t-call="budget_appropriation_summary.report_print_button"/>
            <div class="text-center">
                <h3>F24 สรุปงบประมาณรายจ่ายแยกตามหน่วยงาน</h3>
                <h3>ประจำปีงบประมาณ พ.ศ. <t t-out="o.account_fiscal_year_id.name"/></h3>
            </div>
            <t t-set="f24" t-value="o.get_f24_report_data()"/>
            <div class="mt-3">
                <table class="table table-sm table-bordered f24">
                    <thead>
                        <tr>
                            <th rowspan="2">หน่วยงาน</th>
                            <th rowspan="2">สำรองจ่าย 15%</th>
                            <th rowspan="2">ชดใช้เงินคงคลัง</th>
                            <th colspan="2">MA</th>
                            <th rowspan="2">งบประจำ</th>
                            <th rowspan="2">งบลงทุน</th>
                            <th rowspan="2">เงินสนับสนุนภายนอก</th>
                            <th rowspan="2">รวม (1)</th>
                            <th colspan="2">ด้านการศึกษา</th>
                            <th colspan="2">ด้านการวิจัย</th>
                            <th colspan="2">ด้านตอบโจทย์อุตสาหกรรม</th>
                            <th colspan="2">ด้านสังคม</th>
                            <th rowspan="2">รวม (2)</th>
                            <th rowspan="2">รวมจัดสรร</th>
                            <th rowspan="2">รวม (1)+(2)</th>
                        </tr>
                        <tr>
                            <th>วงเงิน</th>
                            <th>จัดสรร %</th>
                            <th>วงเงิน</th>
                            <th>จัดสรร %</th>
                            <th>วงเงิน</th>
                            <th>จัดสรร %</th>
                            <th>วงเงิน</th>
                            <th>จัดสรร %</th>
                            <th>วงเงิน</th>
                            <th>จัดสรร %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="f24['rows']" t-as="row">
                            <tr>
                                <td contenteditable="false" t-out="row['department_name']"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['reserve_15']) if row['reserve_15'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['treasury']) if row['treasury'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['ma']) if row['ma'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['ma_allocated_pct']) if row['ma_allocated_pct'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['recurrent']) if row['recurrent'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['capital']) if row['capital'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['external']) if row['external'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['total_1']) if row['total_1'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['education']) if row['education'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['education_pct']) if row['education_pct'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['academic']) if row['academic'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['academic_pct']) if row['academic_pct'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['industrial']) if row['industrial'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['industrial_pct']) if row['industrial_pct'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['social']) if row['social'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['social_pct']) if row['social_pct'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['total_2']) if row['total_2'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['total_pct']) if row['total_pct'] else '-'"/>
                                <td class="num" contenteditable="false" t-out="'{:,.2f}'.format(row['total_1_2']) if row['total_1_2'] else '-'"/>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="dept" contenteditable="false" t-out="f24['total']['department_name']"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['reserve_15']) if f24['total']['reserve_15'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['treasury']) if f24['total']['treasury'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['ma']) if f24['total']['ma'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['ma_allocated_pct']) if f24['total']['ma_allocated_pct'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['recurrent']) if f24['total']['recurrent'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['capital']) if f24['total']['capital'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['external']) if f24['total']['external'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['total_1']) if f24['total']['total_1'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['education']) if f24['total']['education'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['education_pct']) if f24['total']['education_pct'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['academic']) if f24['total']['academic'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['academic_pct']) if f24['total']['academic_pct'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['industrial']) if f24['total']['industrial'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['industrial_pct']) if f24['total']['industrial_pct'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['social']) if f24['total']['social'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['social_pct']) if f24['total']['social_pct'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['total_2']) if f24['total']['total_2'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['total_pct']) if f24['total']['total_pct'] else '-'"/>
                            <th contenteditable="false" t-out="'{:,.2f}'.format(f24['total']['total_1_2']) if f24['total']['total_1_2'] else '-'"/>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </template>

    <!-- Main F24 report template -->
    <template id="report_compilation_f24">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang='th_TH')" />
                    <t t-call="budget_appropriation_summary.report_common_styles" />
                    <t t-set="is_landscape" t-value="True" />
                    <t t-call="budget_appropriation_summary.report_preview_styles" />
                    <t t-call="budget_appropriation_summary_f24.report_compilation_f24_content" />
                </t>
            </t>
        </t>
    </template>
</odoo>
