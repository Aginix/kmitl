<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_cancel_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.cancel.wizard.form</field>
        <field name="model">purchase.request.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="ยกเลิกคำขอ (พ.1)">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="กรุณาระบุเหตุผลการยกเลิก..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="ยืนยัน" type="object" class="btn-primary"/>
                    <button string="ปิด" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_request_cancel_wizard" model="ir.actions.act_window">
        <field name="name">ยกเลิกคำขอ (พ.1)</field>
        <field name="res_model">purchase.request.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
