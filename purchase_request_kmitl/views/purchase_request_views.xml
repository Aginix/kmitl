<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ========================================= -->
    <!-- Views from l10n_th_gov_purchase_request    -->
    <!-- ========================================= -->

    <record id="view_purchase_request_tree_l10n" model="ir.ui.view">
        <field name="name">purchase.request.tree (l10n)</field>
        <field name="model">purchase.request</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="assigned_to" />
                <field name="purchase_type_id" optional="hide" />
                <field name="procurement_method_id" optional="hide" />
            </field>
            <field name="state" position="before">
                <field name="substate_sequence" invisible="1" />
                <field
                    name="substate_id"
                    widget="badge"
                    decoration-muted="substate_sequence == 1"
                    decoration-warning="substate_sequence == 2"
                    decoration-success="substate_sequence == 3"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record id="view_purchase_request_search_l10n" model="ir.ui.view">
        <field name="name">purchase.request.list.select (l10n)</field>
        <field name="model">purchase.request</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <field name="requested_by" position="before">
                <field name="purchase_type_id" />
                <field name="procurement_method_id" />
            </field>
            <field name="picking_type_id" position="after">
                <separator orientation="vertical" />
                <filter
                    name="toverify"
                    string="Subsate = To Verify"
                    domain="[('substate_sequence','=',10)]"
                />
                <filter
                    name="verified"
                    string="Subsate = Verified"
                    domain="[('substate_sequence','=',20)]"
                />
                <separator orientation="vertical" />
                <filter
                    name="toassign"
                    string="To Assign Representative"
                    domain="[('assigned_to','=',False), ('state','=','to_approve')]"
                />
            </field>
            <group position="inside">
                <filter
                    string="Purchase Type"
                    name="purchase_type"
                    domain="[]"
                    context="{'group_by': 'purchase_type_id'}"
                />
                <filter
                    string="Procurement Method"
                    name="procurement_method"
                    domain="[]"
                    context="{'group_by': 'procurement_method_id'}"
                />
            </group>
        </field>
    </record>

    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form (l10n)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <button name="button_rejected" position="attributes">
                <attribute name="states">draft,to_approve,approved</attribute>
                <attribute name="groups" />
            </button>
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('state','not in', ['to_approve', 'approved'])]}</attribute>
            </xpath>
            <!-- Custom fields -->
            <field name="requested_by" position="before">
                <field
                    name="procurement_type_id"
                    required="True"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                />
                <field
                    name="purchase_type_id"
                    widget="radio"
                    required="True"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                />
                <field name="to_create" invisible="True" />
                <field
                    name="expense_reason"
                    attrs="{'invisible': [('to_create', '!=', 'expense')], 'required': [('to_create', '=', 'expense')], 'readonly': [('is_editable','=', False)]}"
                />
                <field name="procurement_method_ids" invisible="True" />
                <field
                    name="procurement_method_id"
                    required="True"
                    domain="[('id', 'in', procurement_method_ids)]"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                />
            </field>
            <field name="assigned_to" position="after">
                <field name="verified_by" readonly="1" />
                <field name="date_verified" readonly="1" />
                <field name="approved_by" readonly="1" />
                <field name="date_approved" readonly="1" />
            </field>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page name="committee" string="Committee">
                    <separator string="Work Acceptance Committee" />
                        <field
                        name="work_acceptance_committee_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'work_acceptance'}"
                        attrs="{'readonly': [('is_editable', '=', False)]}"
                    >
                            <tree editable="bottom">
                                <field name="committee_type" invisible="1" />
                                <field
                                name="employee_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                                <field name="name" />
                                <field name="approve_role" />
                                <field name="department_id" />
                                <field name="email" />
                                <field name="phone" />
                                <field name="note" />
                            </tree>
                        </field>

                    <separator string="Procurement Committee" />
                        <field
                        name="procurement_committee_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'procurement'}"
                        attrs="{'readonly': [('is_editable', '=', False)]}"
                    >
                            <tree editable="bottom">
                                <field name="committee_type" invisible="1" />
                                <field
                                name="employee_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                                <field name="name" />
                                <field name="approve_role" />
                                <field name="department_id" />
                                <field name="email" />
                                <field name="phone" />
                                <field name="note" />
                            </tree>
                        </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_form_substate" model="ir.ui.view">
        <field name="name">view.purchase.request.form.substate</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_substate.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <field name="substate_id" position="attributes">
                <attribute name="options">{'clickable': False,}</attribute>
            </field>
            <!-- Action button for substate -->
            <button name="button_draft" position="before">
                <field name="substate_sequence" invisible="1" />
                <button
                    id="button_substate_verify"
                    name="action_to_substate"
                    type="object"
                    string="Verify"
                    context="{'to_substate_sequence': 20}"
                    attrs="{'invisible': ['|', ('substate_sequence', '!=', 10), ('state', '!=', 'to_approve')]}"
                    groups="purchase_request_kmitl.group_purchase_request_verify"
                    class="oe_highlight"
                />
            </button>
            <button name="button_approved" position="attributes">
                <attribute name="states" />
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('substate_sequence', '!=', 20), ('state', '!=', 'to_approve')]}</attribute>
            </button>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- KMITL-specific views                      -->
    <!-- ========================================= -->

    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree (KMITL)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="title" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="before">
                <field name="user_id" widget="many2one_avatar_user" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="after">
                <field name="procurement_type_id" optional="hide" />
                <field name="account_fiscal_year_id" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='estimated_cost']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='main_exception_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_form_kmitl" model="ir.ui.view">
        <field name="name">view.purchase.request.form (KMITL)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="before">
                <field
                    name="title"
                    required="1"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                />
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='assigned_to']" position="after">
                <field name="user_id" readonly="1" />
            </xpath>
            <xpath expr="//form/header/field[@name='state']" position="attributes">
                <attribute
                    name="statusbar_visible"
                >draft,to_approve,approved,in_progress,done</attribute>
            </xpath>
            <xpath expr="//button[@name='button_in_progress']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_done']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_rejected']" position="attributes">
                <attribute name="states">to_approve</attribute>
                <attribute
                    name="groups"
                >purchase_request.group_purchase_request_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="states">to_verify</attribute>
                <attribute name="groups" />
            </xpath>
            <xpath expr="//page[@name='committee']" position="after">
                <page name="logs" string="Operation">
                    <group>
                        <field name="date_start" readonly="1" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="document" string="Attachment">
                    <field
                        name="attachment_ids"
                        attrs="{'readonly': [('is_editable','=', False)]}"
                        context="{'default_res_model': 'purchase.request'}"
                    >
                        <tree default_order="attachment_type, sequence">
                            <field name="sequence" widget="handle" />
                            <field name="attachment_type" required="1" />
                            <field name="name" string="File Name" required="1" />
                            <field name="description" />
                        </tree>
                        <form>
                            <sheet>
                                <group>
                                    <field
                                        name="res_model"
                                        invisible="1"
                                        readonly="0"
                                    />
                                    <field name="res_id" invisible="1" readonly="0" />
                                    <field name="attachment_type" required="1" />
                                    <field name="name" required="1" invisible="1" />
                                    <field name="datas" filename="name" required="1" />
                                    <field
                                        name="description"
                                        placeholder="Description"
                                    />
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_form_l10n" model="ir.ui.view">
        <field name="name">view.purchase.request.form (Committee)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='committee']" position="replace">
                <page name="committee" string="Committee">
                    <separator
                        string="TOR Committee"
                        attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"
                    />
                    <field
                        name="tor_committee_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'tor_committee'}"
                        attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}"
                    />
                    <separator
                        string="Price Determine Committee"
                        attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"
                    />
                    <field
                        name="price_determine_committee_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'price_determine'}"
                        attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}"
                    />
                    <separator
                        string="Evaluation Committee"
                        attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"
                    />
                    <field
                        name="evaluation_committee_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'evaluation'}"
                        attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}"
                    />
                    <separator string="Work Acceptance Committee" />
                    <field
                        name="work_acceptance_committee_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'work_acceptance'}"
                        attrs="{'readonly': [('is_editable', '=', False)]}"
                    />
                </page>
                <page name="work_supervisor" string="Work Supervisors">
                    <field
                        name="work_supervisor_ids"
                        nolabel="1"
                        context="{'default_committee_type': 'work_supervisor'}"
                        attrs="{'readonly': [('is_editable', '=', False)]}"
                    >
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field
                                name="employee_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="name" />
                            <field name="department_id" />
                            <field name="email" />
                            <field name="mobile_phone" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_form_fiscal_year" model="ir.ui.view">
        <field name="name">view.purchase.request.form (fiscal year)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='procurement_type_id']" position="before">
                <field
                    name="account_fiscal_year_id"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                    required="1"
                    widget="selection"
                />
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.list.select</field>
        <field name="model">purchase.request</field>
        <field name="priority">30</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_search_l10n"
        />
        <field name="arch" type="xml">
            <field name="requested_by" position="before">
                <searchpanel>
                    <field
                        name="procurement_type_id"
                        icon="fa-money"
                        enable_counters="1"
                    />
                </searchpanel>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_search_user" model="ir.ui.view">
        <field name="name">purchase.request.list.select (Responsible User)</field>
        <field name="model">purchase.request</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_requests']" position="after">
                <filter
                    name="created_by_me"
                    domain="[('user_id','=', uid)]"
                    help="Created by me"
                />
            </xpath>
        </field>
    </record>

    <menuitem
        id="purchase_request.parent_menu_purchase_request"
        name="Purchase Requests"
        web_icon="purchase_request_kmitl,static/description/icon.png"
    />

    <!-- hide menu -->
    <menuitem id="purchase_request.menu_purchase_request_line_act" active="False" />
    <menuitem id="purchase_request.menu_purchase_request_act" active="False" />
    <!-- menu -->
    <menuitem
        id="purchase_request.menu_purchase_request"
        action="purchase_request.purchase_request_form_action"
        parent="purchase_request.parent_menu_purchase_request"
    />
    <menuitem
        id="purchase_request_kmitl_root_menu"
        name="PR1"
        parent="purchase.menu_purchase_root"
        action="purchase_request.purchase_request_form_action"
        sequence="3"
    />

    <function name="write" model="ir.actions.act_window">
        <value
            model="ir.actions.act_window"
            search="[('id', '=', ref('purchase_request.purchase_request_form_action'))]"
        />
        <value eval="{'context': '{}'}" />
    </function>
</odoo>
