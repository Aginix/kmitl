<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- purchase request view inherit to add/remove fields -->
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="before">
                <field name="title" />
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="after">
                <field name="procurement_type_id" optional="show" />
                <field name="contract_type" optional="show" />
                <field name="payment_type" optional="show" />
            </xpath>
            <xpath expr="//field[@name='estimated_cost']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
    <!-- purchase request view inherit to add/remove fields -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//button[@type='action']" position="attributes">
                <attribute name="states"/>
                <attribute name="string">Create PO</attribute>
                <attribute name="attrs">{'invisible':[('hide_create_po_button', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="states"></attribute>
                <attribute name="attrs">{'invisible': [('state', 'in', ['draft', 'to_approve', 'approved', 'in_progress', 'done'])]}</attribute>
            </xpath>
            <xpath expr="//button[@name='button_approved']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', '!=', 'to_approve')]}</attribute>
                <attribute name="groups">purchase_request.group_purchase_request_manager</attribute>
                <attribute name="class">btn-primary o_button_approved</attribute>
            </xpath>
            <xpath expr="//button[@name='button_rejected']" position="attributes">
                <attribute name="states"></attribute>
                <attribute name="attrs">{'invisible': [('state', 'in', ['draft', 'approved', 'in_progress', 'done', 'rejected'])]}</attribute>
                <attribute name="groups">purchase_request.group_purchase_request_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='button_to_approve']" position="attributes">
                <attribute name="string">Submit Approval</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_type_id']" position="attributes">
                <attribute name="widget">selection</attribute>
            </xpath>
            <xpath expr="//field[@name='procurement_type_id']" position="before">
                <field name="account_fiscal_year_id" attrs="{'readonly': [('is_editable','=', False)]}" widget="selection" />
            </xpath>
            <xpath expr="//field[@name='procurement_method_id']" position="attributes">
                <attribute name="widget">selection</attribute>
            </xpath>
            <field name="requested_by" position="before">
                <field name="payment_type" required="True" attrs="{'readonly': [('is_editable','=', False)]}" />
                <field name="contract_type" attrs="{'readonly': [('is_editable','=', False)]}" />
            </field>
            <field name="description" position="before">
                <field name="title" attrs="{'readonly': [('is_editable','=', False)]}" />
            </field>
            <xpath expr="//field[@name='procurement_type_id']" position="after">
                <field name="product_id" required="1" attrs="{'readonly': [('is_editable','=', False)]}" />
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_request_id': active_id, 'default_product_id': product_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree/field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page name="committee" string="Committee">
                    <separator string="Work Acceptance Committee" />
                    <field name="work_acceptance_committee_ids" nolabel="1" context="{'default_committee_type': 'work_acceptance'}" attrs="{'readonly': [('is_editable', '=', False)]}" />
                    <separator string="Tor Committee" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"/>
                    <field name="tor_committee_ids" nolabel="1" context="{'default_committee_type': 'tor_committee'}" attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}" />
                    <separator string="Price Determine Committee" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"/>
                    <field name="price_determine_committee_ids" nolabel="1" context="{'default_committee_type': 'price_determine'}" attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}" />
                    <separator string="Evaluation Committee" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"/>
                    <field name="evaluation_committee_ids" nolabel="1" context="{'default_committee_type': 'evaluation'}" attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}" />
                </page>
                <page name="logs" string="Operation">
                    <group>
                        <field name="requested_by" widget="many2one_avatar_user" readonly="1" />
                        <field name="date_start" readonly="1" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- purchase request search view inherit to add filters -->
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">purchase.request.list.select</field>
        <field name="model">purchase.request</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <field name="requested_by" position="before">
                <searchpanel>
                    <field name="state" icon="fa-money" enable_counters="1"/>
                    <field name="procurement_type_id" icon="fa-money" enable_counters="1"/>
                    <field name="contract_type" icon="fa-money" enable_counters="1"/>
                    <field name="payment_type" icon="fa-money" enable_counters="1"/>
                </searchpanel>
            </field>
        </field>
    </record>
</odoo>
