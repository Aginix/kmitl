<odoo noupdate="1">

    <!-- Default product, for procurement type -->
    <record id="product_type_001" model="product.product">
        <field name="name">ซื้อ/จ้าง/เช่า</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="True" />
        <field name="supplier_taxes_id" eval="False" />
        <field name="taxes_id" eval="False" />
        <field name="purchase_method">purchase</field>
    </record>
    <record id="product_type_002" model="product.product">
        <field name="name">จ้างที่ปรึกษา</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="True" />
        <field name="supplier_taxes_id" eval="False" />
        <field name="taxes_id" eval="False" />
        <field name="purchase_method">purchase</field>
    </record>
    <record id="product_type_003" model="product.product">
        <field name="name">จ้างออกแบบและควบคุมงานก่อสร้าง</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="True" />
        <field name="supplier_taxes_id" eval="False" />
        <field name="taxes_id" eval="False" />
        <field name="purchase_method">purchase</field>
    </record>

    <!-- Disabled old procurement types -->
    <record id="procurement_type_001" model="procurement.type">
        <field name="name">ซื้อ/จ้าง/เช่า</field>
        <field name="product_id" ref="product_type_001" />
        <field name="sequence">10</field>
        <field name="active" eval="False" />
    </record>
    <record id="procurement_type_002" model="procurement.type">
        <field name="name">จ้างที่ปรึกษา</field>
        <field name="product_id" ref="product_type_002" />
        <field name="sequence">20</field>
        <field name="active" eval="False" />
    </record>
    <record id="procurement_type_003" model="procurement.type">
        <field name="name">จ้างออกแบบและควบคุมงานก่อสร้าง</field>
        <field name="product_id" ref="product_type_003" />
        <field name="sequence">30</field>
        <field name="active" eval="False" />
    </record>

    <!-- Active procurement types -->
    <record id="procurement_type_004" model="procurement.type">
        <field name="name">ซื้อ</field>
        <field name="sequence">10</field>
        <field name="is_purchase">True</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_005" model="procurement.type">
        <field name="name">เช่า</field>
        <field name="sequence">20</field>
        <field name="is_purchase">True</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_006" model="procurement.type">
        <field name="name">จ้างก่อสร้าง</field>
        <field name="sequence">30</field>
        <field name="is_purchase">False</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_007" model="procurement.type">
        <field name="name">จ้างทำของ/จ้างเหมาบริการ</field>
        <field name="sequence">40</field>
        <field name="is_purchase">True</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_008" model="procurement.type">
        <field name="name">จ้างออกแบบ</field>
        <field name="sequence">50</field>
        <field name="is_purchase">False</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_009" model="procurement.type">
        <field name="name">จ้างควบคุมงาน</field>
        <field name="sequence">60</field>
        <field name="is_purchase">False</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_010" model="procurement.type">
        <field name="name">จ้างที่ปรึกษา</field>
        <field name="sequence">70</field>
        <field name="is_purchase">True</field>
        <field name="is_construction">True</field>
    </record>
    <record id="procurement_type_011" model="procurement.type">
        <field name="name">จ้างปรับปรุง</field>
        <field name="sequence">80</field>
        <field name="is_purchase">True</field>
        <field name="is_construction">True</field>
    </record>

</odoo>
