<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="kmitl_purchase_exception_amount_not_exceed_pr" model="exception.rule">
        <field
            name="name"
        >ยอดเงินของเอกสารนี้ เกินยอดเงินในเอกสาร PR</field>
        <field name="description">กรุณาเช็คยอดเงินใหม่อีกครั้ง</field>
        <field name="model">purchase.order</field>
        <field name="exception_type">by_py_code</field>
        <field name="code">
pr_total = sum(self.order_line.mapped("purchase_request_lines.estimated_cost"))
if pr_total:
    po_total = self.amount_total
    failed = po_total > pr_total
        </field>
    </record>

    <!-- ปรับ active(exception rule) ของ l10n ให้เป็น False เพื่อไม่ให้ทำงาน -->
    <record id="l10n_th_gov_purchase_request.purchase_exception_amount_not_exceed_pr" model="exception.rule">
        <field name="active">False</field>
    </record>
</odoo>
