<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request.group_purchase_request_user" model="res.groups">
        <field name="name">Purchase Request User : Own Documents Only</field>
    </record>

    <record id="purchase.group_purchase_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('purchase_request.group_purchase_request_user'))]"
        />
    </record>

    <record id="group_purchase_request_user_all" model="res.groups">
        <field name="name">Purchase Request User : All Documents</field>
        <field
            name="implied_ids"
            eval="[(4, ref('purchase_request.group_purchase_request_user'))]"
        />
        <field
            name="category_id"
            ref="purchase_request.module_category_purchase_request"
        />
    </record>

    <record id="purchase_request.group_purchase_request_manager" model="res.groups">
        <field name="name">Purchase Request Manager</field>
        <field
            name="implied_ids"
            eval="[(4, ref('purchase_request_kmitl.group_purchase_request_user_all'))]"
        />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="group_purchase_request_verify" model="res.groups">
        <field name="name">Can verify purchase request</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- rules -->
    <record id="purchase_request_user_all_rule" model="ir.rule">
        <field name="name">Purchase Request User : All Documents</field>
        <field name="model_id" ref="purchase_request.model_purchase_request" />
        <field
            name="groups"
            eval="[(6, 0, [ref('purchase_request_kmitl.group_purchase_request_user_all')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="purchase_request_line_user_all_rule" model="ir.rule">
        <field name="name">Purchase Request User : All Documents</field>
        <field name="model_id" ref="purchase_request.model_purchase_request_line" />
        <field
            name="groups"
            eval="[(6, 0, [ref('purchase_request_kmitl.group_purchase_request_user_all')])]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
