<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.appropriation.line form -->
    <record id="view_budget_appropriation_line_form_project" model="ir.ui.view">
        <field name="name">view.budget.appropriation.line.form.project</field>
        <field name="model">budget.appropriation.line</field>
        <field name="inherit_id" ref="budget_appropriation.view_budget_appropriation_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="is_project" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='balance']" position="after">
                <field name="project_ids" attrs="{'invisible': [('is_project', '=', False)]}" context="{
                        'hide_header': True,
                        'hide_budget': True,
                        'default_date_range_fy_id': date_range_fy_id,
                        'default_source_analytic_id': source_analytic_id,
                        'default_activity_analytic_id': activity_analytic_id,
                        'default_department_analytic_id': department_analytic_id,
                        'default_fund_analytic_id': fund_analytic_id,
                        'default_budget_account_id': account_id,
                        'default_company_id': company_id,
                        'default_currency_id': currency_id,
                    }">
                    <tree editable="bottom">
                        <field name="state" invisible="1" />
                        <field name="department_analytic_id" invisible="1" />
                        <field name="budget_appropriation_id" invisible="1" />
                        <field name="budget_appropriation_line_id" invisible="1" />
                        <field name="source_analytic_id" invisible="1" />
                        <field name="activity_analytic_id" invisible="1" />
                        <field name="fund_analytic_id" invisible="1" />
                        <field name="budget_account_id" invisible="1" />
                        <field name="name" />
                        <field name="amount" />
                    </tree>
                </field>
                <!-- <field name="unallocated_balance" attrs="{'invisible': [('is_project', '=', False)]}" /> -->
            </xpath>
        </field>
    </record>

    <!-- View budget.appropriation form -->
    <record id="view_budget_appropriation_form_project" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form.project</field>
        <field name="model">budget.appropriation</field>
        <field name="inherit_id" ref="budget_appropriation.view_budget_appropriation_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="is_project" invisible="1" />
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="โครงการ/กิจกรรม" attrs="{'invisible': [('budget_type', '!=', 'expense')]}">
                    <field name="project_ids">
                        <tree create="0" delete="0" limit="1000">
                            <field name="state" invisible="1" />
                            <field name="department_analytic_id" invisible="1" />
                            <field name="budget_appropriation_id" invisible="1" />
                            <field name="budget_appropriation_line_id" invisible="1" />
                            <field name="source_analytic_id" invisible="1" />
                            <field name="activity_analytic_id" optional="show" />
                            <field name="fund_analytic_id" optional="show" />
                            <field name="budget_account_id" optional="show" />
                            <field name="name" />
                            <!-- <field name="description" /> -->
                            <field name="amount" sum="รวมทั้งหมด" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
