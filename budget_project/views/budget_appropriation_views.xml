<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.appropriation.line form -->
    <record id="view_budget_appropriation_line_form_project" model="ir.ui.view">
        <field name="name">view.budget.appropriation.line.form.project</field>
        <field name="model">budget.appropriation.line</field>
        <field name="inherit_id" ref="budget_appropriation.view_budget_appropriation_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="is_project" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='balance']" position="after">
                <field name="enable_project" string="จัดสรรงบประมาณโครงการ/กิจกรรม" attrs="{'invisible': [('is_project', '=', False)]}" />
            </xpath>
            <xpath expr="//group" position="after">
                <group name="project" string="โครงการ/กิจกรรม" attrs="{'invisible': [('enable_project', '=', False)]}">
                    <div class="alert alert-info" role="alert" colspan="2">
                        ระบบจะนำข้อมูลส่วนนี้ไปสร้างเป็นการกันเงินโครงการ/กิจกรรม
                        <p class="fst-italic fw-light mt-1">
                            ตัวอย่างการกรอกข้อมูล<br />
                            ตัวอย่าง 1. "กิจกรรม KMITL Open House 2025" <br />
                            ตัวอย่าง 2. "โครงการเสริมสร้าง Soft Skill" <br />
                        </p>
                    </div>
                    <field name="description" string="ชื่อโครงการ/กิจกรรม" attrs="{'required': [('enable_project', '=', True)], 'invisible': [('budget_project_id', '!=', False)]}" />
                    <field name="budget_project_id" attrs="{'invisible': [('budget_project_id', '=', False)]}" readonly="1" />
                    <field name="project_type" invisible="1" attrs="{'required': [('enable_project', '=', True)]}" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- View budget.appropriation form -->
    <record id="view_budget_appropriation_form_project" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form.project</field>
        <field name="model">budget.appropriation</field>
        <field name="inherit_id" ref="budget_appropriation.view_budget_appropriation_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree" position="inside">
                <field name="is_project" invisible="1" />
                <field name="enable_project" invisible="1" />
                <field name="project_type" invisible="1" />
                <field name="budget_project_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                <attribute name="decoration-info">is_project</attribute>
            </xpath>
        </field>
    </record>
</odoo>
