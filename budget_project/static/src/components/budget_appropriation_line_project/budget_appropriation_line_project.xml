<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_project.BudgetAppropriationLineProjectRenderer" t-inherit="budget_appropriation.ListRenderer.RecordRow" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-if='record.data.note']" position="before">
            <div t-if="record.data.enable_project" class="o_field_project">
                <span class="fw-medium fst-italic" t-esc="`${record.data.description}`" />
            </div>
        </xpath>
    </t>

</templates>
