<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Reuse the same all-OU right as core budget (ADR-0011): a person with
         "Access all OUs' Budget" sees every support request, not only their
         own OU's. -->
    <function model="ir.rule" name="write">
        <value
            eval="[ref('budget_support_request_operating_unit.ir_rule_budget_support_request_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|',(1, '=', 1) if user.has_group('budget_operating_unit_access_all.group_all_ou_budget') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>

</odoo>
