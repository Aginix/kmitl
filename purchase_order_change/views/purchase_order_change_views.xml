<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_change_tree" model="ir.ui.view">
        <field name="name">view.purchase.order.change.tree</field>
        <field name="model">purchase.order.change</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number" />
                <field name="date" />
                <field name="change_type" />
                <field name="editor_id" widget="many2one_avatar_user" />
            </tree>
        </field>
    </record>

    <record id="view_purchase_order_change_form" model="ir.ui.view">
        <field name="name">view.purchase.order.change.form</field>
        <field name="model">purchase.order.change</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Change">
                <sheet>
                    <group>
                        <group>
                            <field name="number" invisible="1" />
                            <field name="has_sections" invisible="1" />
                            <field name="date" readonly="1" />
                            <field name="change_type" required="1" invisible="1" />
                            <field
                                name="editor_id"
                                readonly="1"
                                options="{'no_create_edit': True, 'no_open': True}"
                            />
                            <field
                                name="section_ids"
                                widget="many2many_checkboxes"
                                domain="[('id', 'in', allowed_section_ids)]"
                            />
                            <field name="allowed_section_ids" invisible="1" />
                            <field name="has_change_fields" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Change Details">
                            <field name="change_field_ids" readonly="1" />
                        </page>
                        <page name="document" string="Attachment">
                            <field
                                name="attachment_ids"
                                context="{'default_res_model': 'purchase.order.change'}"
                            >
                                <tree>
                                    <field
                                        name="name"
                                        string="File Name"
                                        required="1"
                                    />
                                    <field name="description" />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field
                                                name="res_model"
                                                invisible="1"
                                                readonly="0"
                                            />
                                            <field
                                                name="res_id"
                                                invisible="1"
                                                readonly="0"
                                            />
                                            <field
                                                name="name"
                                                required="1"
                                                invisible="1"
                                            />
                                            <field
                                                name="datas"
                                                filename="name"
                                                required="1"
                                            />
                                            <field
                                                name="description"
                                                placeholder="Description"
                                            />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        string="next"
                        name="action_next"
                        type="object"
                        class="btn-primary"
                        attrs="{
                            'invisible': [
                                '|',
                                ('has_change_fields', '=', True),
                                ('has_sections', '=', False)
                            ]
                        }"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_purchase_order_change_search" model="ir.ui.view">
        <field name="name">view.purchase.order.change.search</field>
        <field name="model">purchase.order.change</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter
                        string="Number"
                        name="number"
                        domain="[]"
                        context="{'group_by':'number'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_order_change" model="ir.actions.act_window">
        <field name="name">Purchase Order Change</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order.change</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Order Change.
            </p>
        </field>
    </record>
</odoo>
