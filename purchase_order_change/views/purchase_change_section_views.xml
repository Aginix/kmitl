<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_change_section_tree" model="ir.ui.view">
        <field name="name">view.purchase.change.section.tree</field>
        <field name="model">purchase.change.section</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="section_type" />
            </tree>
        </field>
    </record>

    <record id="view_purchase_change_section_form" model="ir.ui.view">
        <field name="name">view.purchase.change.section.form</field>
        <field name="model">purchase.change.section</field>
        <field name="arch" type="xml">
            <form string="Purchase Change Section">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="section_type" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_change_section_search" model="ir.ui.view">
        <field name="name">view.purchase.change.section.search</field>
        <field name="model">purchase.change.section</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_change_section" model="ir.actions.act_window">
        <field name="name">Purchase Change Section</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.change.section</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Change Section.
            </p>
        </field>
    </record>
</odoo>
