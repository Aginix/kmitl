<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_change_field_tree" model="ir.ui.view">
        <field name="name">view.purchase.order.change.field.tree</field>
        <field name="model">purchase.order.change.field</field>
        <field name="arch" type="xml">
            <tree>
                <field name="field_id" />
                <field name="old_value" />
                <field name="new_value" />
                <field name="field_name" />
            </tree>
        </field>
    </record>

    <record id="view_purchase_order_change_field_form" model="ir.ui.view">
        <field name="name">view.purchase.order.change.field.form</field>
        <field name="model">purchase.order.change.field</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Change Field">
                <sheet>
                    <group>
                        <group>
                            <field name="change_id" options="{'no_create_edit': True, 'no_open': True}" />
                            <field name="section_id" options="{'no_create_edit': True, 'no_open': True}" />
                            <field name="field_id" options="{'no_create_edit': True, 'no_open': True}" />
                            <field name="old_value" />
                            <field name="new_value" />
                            <field name="field_name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_order_change_field_search" model="ir.ui.view">
        <field name="name">view.purchase.order.change.field.search</field>
        <field name="model">purchase.order.change.field</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter
                        string="change_id"
                        name="change_id"
                        domain="[]"
                        context="{'group_by':'change_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_order_change_field" model="ir.actions.act_window">
        <field name="name">Purchase Order Change Field</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order.change.field</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Order Change Field.
            </p>
        </field>
    </record>
</odoo>
