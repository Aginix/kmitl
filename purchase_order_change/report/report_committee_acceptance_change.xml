<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="report_committee_acceptance_change"
        inherit_id="purchase_work_acceptance_kmitl.report_committee_acceptance"
    >
        <xpath expr="//div[@name='payment_section']" position="inside">
            <div
                t-if="o.is_delivery_late or o.is_work_end_extended"
                name="section_change"
            >
                ในการนี้ผู้รับจ้างทำงานเกินกำหนดสัญญา ตั้งแต่วันที่
                <span
                    class="ub"
                    t-esc="o.format_date_thai(o.po_work_end_original + datetime.timedelta(days=1))"
                />
                ถึงวันที่
                <span
                    class="ub"
                    t-esc="o.format_date_thai(o.requested_delivery_date)"
                />
                เป็นเวลา
                <span
                    class="ub"
                    t-esc="(o.requested_delivery_date - o.po_work_end_original).days"
                />
                วัน
                <span
                    t-if="o.is_work_end_extended"
                    name="section_over_time"
                >
                    และได้รับอนุมัติให้ต่อสัญญาจากวันที่
                    <span
                        class="ub"
                        t-esc="o.format_date_thai(o.po_work_end_original + datetime.timedelta(days=1))"
                    />
                    ถึงวันที่
                    <span
                        class="ub"
                        t-esc="o.format_date_thai(o.date_due)"
                    />
                    เป็นเวลา
                    <span
                        class="ub"
                        t-esc="(o.date_due - o.po_work_end_original).days"
                    />
                    วัน
                </span>
                คงทำงานเกินกำหนดสัญญาไป
                <span class="ub" t-esc="o.late_days" />
                วัน จะต้องเสียค่าปรับวันละ
                <span class="ub" t-esc="'{0:,.2f}'.format(o.fines_rate)" />
                บาท (<t
                    t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.fines_rate) if o.fines_rate else '-'"
                />) คงรับเงินงวดนี้เป็น
                <span
                    class="ub"
                    t-esc="'{0:,.2f}'.format(final_amount)"
                />
                บาท (<span
                    class="ub"
                    t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(final_amount)"
                />)
            </div>
        </xpath>
    </template>
</odoo>
