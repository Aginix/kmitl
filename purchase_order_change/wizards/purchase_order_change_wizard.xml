<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_change_wizard" model="ir.ui.view">
        <field name="name">purchase.order.change.wizard.form</field>
        <field name="model">purchase.order.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Purchase Order">
                <group>
                    <!-- กลุ่ม 1: ค่าปรับ -->
                    <field name="show_fines_fields" invisible="1" />
                    <field name="show_work_fields" invisible="1" />
                    <field name="show_contract_fields" invisible="1" />
                    <field name="fines_rate" />

                    <field name="fines_late" readonly="1" />

                    <field name="late_days" readonly="1" />

                    <field name="supervision_cost" />

                    <!-- กลุ่ม 2: ขยายเวลา / ลดยอด -->
                    <field name="work_start" />

                    <field name="contract_period_days" />

                    <field name="date_order_date" />

                    <!-- กลุ่ม 3: อื่นๆ -->
                    <field name="contract_name" />

                    <field name="contract_number" />
                </group>
                <footer>
                    <button
                        string="Save"
                        name="action_save_changes"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
