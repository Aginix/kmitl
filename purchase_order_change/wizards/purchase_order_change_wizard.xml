<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_change_wizard" model="ir.ui.view">
        <field name="name">purchase.order.change.wizard.form</field>
        <field name="model">purchase.order.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Purchase Order">
                <group>
                    <!-- กลุ่ม 1: ค่าปรับ -->
                    <field name="show_fines_fields" invisible="1" />
                    <field name="show_work_fields" invisible="1" />
                    <field name="show_contract_fields" invisible="1" />
                    <field
                        name="fines_rate"
                        attrs="{'invisible': [('show_fines_fields', '=', False)]}"
                    />
                    <field
                        name="supervision_cost"
                        attrs="{'invisible': [('show_fines_fields', '=', False)]}"
                    />

                    <!-- กลุ่ม 2: ขยายเวลา / ลดยอด -->
                    <field
                        name="date_order_date"
                        attrs="{'invisible': [('show_work_fields', '=', False)]}"
                    />
                    <field
                        name="contract_period_days"
                        attrs="{'invisible': [('show_work_fields', '=', False)]}"
                    />
                    <field
                        name="work_start"
                        attrs="{'invisible': [('show_work_fields', '=', False)]}"
                    />

                    <!-- กลุ่ม 3: อื่นๆ -->
                    <field
                        name="contract_name"
                        attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                    />
                    <field
                        name="contract_number"
                        attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                    />
                </group>
                <footer>
                    <button
                        string="Save"
                        name="action_save_changes"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('show_contract_fields', '=', True)]}"
                    />
                    <button
                        string="Save"
                        name="action_save_changes_other"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
