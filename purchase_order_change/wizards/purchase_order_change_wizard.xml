<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_change_wizard" model="ir.ui.view">
        <field name="name">purchase.order.change.wizard.form</field>
        <field name="model">purchase.order.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Purchase Order">
                <group>
                    <field name="show_fines_fields" invisible="1" />
                    <field name="show_work_fields" invisible="1" />
                    <field name="show_contract_fields" invisible="1" />
                    <group name="old_fines_field_group">
                        <field
                            name="fines_rate_old"
                            attrs="{'invisible': [('show_fines_fields', '=', False)]}"
                        />
                        <field
                            name="supervision_cost_old"
                            attrs="{'invisible': [('show_fines_fields', '=', False)]}"
                        />
                    </group>
                    <group name="new_fines_field_group">
                        <field
                            name="fines_rate"
                            attrs="{'invisible': [('show_fines_fields', '=', False)]}"
                        />
                        <field
                            name="supervision_cost"
                            attrs="{'invisible': [('show_fines_fields', '=', False)]}"
                        />
                    </group>
                    <group name="old_work_field_group">
                        <field
                            name="date_order_date_old"
                            attrs="{'invisible': [('show_work_fields', '=', False)]}"
                        />
                        <field
                            name="contract_period_days_old"
                            attrs="{'invisible': [('show_work_fields', '=', False)]}"
                        />
                        <field
                            name="work_start_old"
                            attrs="{'invisible': [('show_work_fields', '=', False)]}"
                        />
                    </group>
                    <group name="new_work_field_group">
                        <field
                            name="date_order_date"
                            attrs="{'invisible': [('show_work_fields', '=', False)]}"
                        />
                        <field
                            name="contract_period_days"
                            attrs="{'invisible': [('show_work_fields', '=', False)]}"
                        />
                        <field
                            name="work_start"
                            attrs="{'invisible': [('show_work_fields', '=', False)]}"
                        />
                    </group>
                    <group name="old_contract_field_group">
                        <field
                            name="contract_name_old"
                            attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                        />
                        <field
                            name="contract_number_old"
                            attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                        />
                    </group>
                    <group name="new_contract_field_group">
                        <field
                            name="contract_name"
                            attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                        />
                        <field
                            name="contract_number"
                            attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        string="Save"
                        name="action_save_changes"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('show_contract_fields', '=', True)]}"
                    />
                    <button
                        string="Save"
                        name="action_save_changes_other"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('show_contract_fields', '=', False)]}"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
