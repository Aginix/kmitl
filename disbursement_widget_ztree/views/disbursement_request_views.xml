<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form.ztree</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <!-- The account tree comes from parent_id (account_account_parent_code) -->
            <xpath
                expr="//field[@name='line_ids']/tree/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
