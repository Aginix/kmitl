<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">

            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>

            <xpath expr="//form/header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,to_approve,validation,approved,done</attribute>
            </xpath>

            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='committee']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@widget='selection']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='purchase_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='group_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_required']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='purchased_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='purchase_state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_show_details']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='button_in_progress']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_verified']" position="after">
                <field name="validated_by" readonly="1" />
                <field name="date_validated" readonly="1" />
            </xpath>

            <xpath expr="//button[@name='button_approved']" position="after">
                <button name='button_approved' string="Approve" states="validation" class="btn-primary o_button_approved" type="object" groups="purchase_request.group_purchase_request_manager" />
            </xpath>

            <xpath expr="//button[@name='button_approved']" position="after">
                <button name='button_validate' string="Validate" class="btn-primary" attrs="{'invisible': ['|' ,('substate_sequence', '!=', 20), ('state', '!=', 'to_approve')]}" type="object" groups="kmitl_purchase_request.group_pr_supply, kmitl_purchase_request.group_pr_admin"/>
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="states">to_approve,validation,approved,rejected,done</attribute>
            </xpath>

            <xpath expr="//button[@name='button_approved']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@type='action']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='requested_by']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <field name="requested_by" position="before">
                <field name="payment_type" required="True" attrs="{'readonly': [('is_editable','=', False)]}"  />
                <field name="contract_type" attrs="{'readonly': [('is_editable','=', False)]}" />
                <field name="purchase_type_id"
                    invisible = "1" attrs="{'readonly': [('is_editable','=', False)]}" />
                <field name="procurement_method_ids" invisible="True" />
                <separator string="ขบวนการดำเนินการ" />
            </field>

            <field name="description" position="before">
                <field name="title" attrs="{'readonly': [('is_editable','=', False)]}" />
            </field>

            <xpath expr="//field[@name='date_start']" position="after">
                <field name="department_id" />
            </xpath>

            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <xpath expr="//form/sheet/notebook" position="inside">
                <page name="committee" string="Committee">
                    <separator string="คณะกรรมการตรวจรับพัสดุ" />
                    <field name="work_acceptance_committee_ids" nolabel="1" context="{'default_committee_type': 'work_acceptance'}" attrs="{'readonly': [('is_editable', '=', False)]}">
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field name="employee_id" string="Employee" options="{'no_create': True, 'no_open': True}" />
                            <field name="name" string="Committee Name" readonly="1" />
                            <field name="approve_role" string="Role" />
                            <field name="department_id" string="Department" readonly="1" />
                            <field name="email" string="Work Email" readonly="1" />
                            <field name="phone" string="Work Phone" readonly="1" />
                        </tree>
                    </field>
                    <separator string="คณะกรรมการกำหนดคุณลักษณะเฉพาะร่างขอบเขตงาน" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"/>
                    <field name="tor_committee_ids" nolabel="1" context="{'default_committee_type': 'tor_committee'}" attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}">
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field name="employee_id" string="Employee" options="{'no_create': True, 'no_open': True}" />
                            <field name="name" string="Committee Name" />
                            <field name="approve_role" string="Role" />
                            <field name="department_id" string="Department" />
                            <field name="email" string="Work Email" />
                            <field name="phone" string="Work Phone" />
                            <field name="note" string="Note" />
                        </tree>
                    </field>
                    <separator string="คณะกรรมการกำหนดราคากลาง" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"/>
                    <field name="price_determine_committee_ids" nolabel="1" context="{'default_committee_type': 'price_determine'}" attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}">
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field name="employee_id" string="Employee" options="{'no_create': True, 'no_open': True}" />
                            <field name="name" string="Committee Name" />
                            <field name="approve_role" string="Role" />
                            <field name="department_id" string="Department" />
                            <field name="email" string="Work Email" />
                            <field name="phone" string="Work Phone" />
                            <field name="note" string="Note" />
                        </tree>
                    </field>
                    <separator string="คณะกรรมการพิจารณาผล" attrs="{'invisible': [('estimated_cost', '&lt;', 100000)]}"/>
                    <field name="evaluation_committee_ids" nolabel="1" context="{'default_committee_type': 'evaluation'}" attrs="{'readonly': [('is_editable', '=', False)], 'invisible': [('estimated_cost', '&lt;', 100000)]}">
                        <tree editable="bottom">
                            <field name="committee_type" invisible="1" />
                            <field name="employee_id" string="Employee" options="{'no_create': True, 'no_open': True}" />
                            <field name="name" string="Committee Name" />
                            <field name="approve_role" string="Role" />
                            <field name="department_id" string="Department" />
                            <field name="email" string="Work Email" />
                            <field name="phone" string="Work Phone" />
                            <field name="note" string="Note" />
                        </tree>
                    </field>
                </page>

                <page name="document" string="เอกสารแนบ">
                    <group>
                        <field name="tor_document_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                            <tree editable="bottom">
                                <field name="file" filename="file_name" />
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>

                        <field name="rfq_attachment_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                            <tree editable="bottom">
                                <field name="file" filename="file_name" />
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>

                        <field name="etc_document_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                            <tree editable="bottom">
                                <field name="file" filename="file_name" />
                                <field name="file_name" readonly="1" />
                                <field name="description" />
                            </tree>
                        </field>
                    </group>
                </page>

                <page name="budget" string="งบประมาณ">
                    <group name="budget" string="ข้อมูลมิติทางบัญชี">
                        <field name="source_of_fund" />
                        <field name="plan" />
                        <field name="fund" />
                        <field name="budget_type" />
                        <field name="expense_code" string="รหัสค่าใช้จ่าย" />
                    </group>

                </page>
            </xpath>

        </field>
    </record>

    <record id="view_purchase_request_exception_inherit_view_form" model="ir.ui.view">
        <field name="name">view.purchase.request.exception.inherit.view.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_exception.view_purchase_request_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='exception_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_purchase_request_exception_inherit_view_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.exception.inherit.view.tree</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_exception.view_purchase_request_tree" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='main_exception_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_purchase_request_inherit_view_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.inherit.view.tree</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>
