<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View purchase.request.attachment View Tree -->
    <record id="view_purchase_request_attachment_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.attachment.tree</field>
        <field name="model">purchase.request.attachment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="attachment_type" />
                <field name="file_name" string="ชื่อไฟล์ที่แสดง" />
                <field name="file" filename="file_name" />
                <field name="description" string="คำอธิบาย" />
            </tree>
        </field>
    </record>

    <!-- View purchase.request.attachment form -->
    <record id="view_purchase_request_attachment_form" model="ir.ui.view">
        <field name="name">view.purchase.request.attachment.form</field>
        <field name="model">purchase.request.attachment</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Attachment">
                <sheet>
                    <group name="file" string="รายละเอียดไฟล์">
                        <field name="attachment_type" invisible="1" />
                        <field name="file" filename="file_name" />
                        <field name="file_name" string="ชื่อไฟล์ที่แสดง" />
                        <field name="description" string="คำอธิบาย" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action purchase.request.attachment -->
    <record id="action_purchase_request_attachment" model="ir.actions.act_window">
        <field name="name">Purchase Request Attachment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Attachment.
            </p>
        </field>
    </record>
</odoo>
