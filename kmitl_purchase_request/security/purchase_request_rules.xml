<odoo>
    <data noupdate="0">
        <!-- Supply: เห็นได้ทุก PR แต่ edit ได้เฉพาะ state 'commit' -->
        <record id="rule_pr_supply_read" model="ir.rule">
            <field name="name">PR Supply - Edit Commit</field>
            <field name="model_id" ref="purchase_request.model_purchase_request"/>
            <field name="domain_force">[('state', 'in', ['to_approve', 'validation', 'approved'])]</field>
            <field name="groups" eval="[(4, ref('kmitl_purchase_request.group_pr_supply'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pr_supply_line_read" model="ir.rule">
            <field name="name">PR Supply - Lines Access</field>
            <field name="model_id" ref="purchase_request.model_purchase_request_line"/>
            <field name="groups" eval="[(4, ref('kmitl_purchase_request.group_pr_supply'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
        [(1, '=', 1)]
            </field>
        </record>

        <!-- Approver: เห็นได้ทุก PR แต่ edit ได้เฉพาะ state 'validate' -->
        <record id="rule_pr_approver_read" model="ir.rule">
            <field name="name">PR Approver - Edit Validate</field>
            <field name="model_id" ref="purchase_request.model_purchase_request"/>
            <field name="domain_force">[('state', 'in', ['validate', 'approved'])]</field>
            <field name="groups" eval="[(4, ref('kmitl_purchase_request.group_pr_approver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pr_approver_line_read" model="ir.rule">
            <field name="name">PR Supply - Lines Access</field>
            <field name="model_id" ref="purchase_request.model_purchase_request_line"/>
            <field name="groups" eval="[(4, ref('kmitl_purchase_request.group_pr_approver'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pr_substate_read" model="ir.rule">
            <field name="name">PR Supply - Lines Access</field>
            <field name="model_id" ref="purchase_request.model_purchase_request"/>
            <field name="domain_force">[('state', 'in', ['to_approve'])]</field>
            <field name="groups" eval="[(4, ref('kmitl_purchase_request_substate.group_purchase_request_substate_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pr_substate_line_read" model="ir.rule">
            <field name="name">PR Supply - Lines Access</field>
            <field name="model_id" ref="purchase_request.model_purchase_request_line"/>
            <field name="groups" eval="[(4, ref('kmitl_purchase_request_substate.group_purchase_request_substate_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
