<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
      Shared button pair — "Assign to me" + "Assign…". Both branches of the
      assignment alert render these; the *assigned* branch adds "Unassign"
      inline. Extracted so we do not maintain two copies of the same widget
      config.

      Render params (from the caller's t-call scope):
        * ``user_group``     — xmlid gating "Assign to me"
        * ``manager_group``  — xmlid gating "Assign…"
    -->
    <template id="_assignment_common_buttons">
        <button
            name="action_assignment_assign_me"
            string="Assign to me"
            type="object"
            class="btn-sm btn-primary mx-1"
            icon="fa-hand-paper-o"
            t-attf-groups="#{user_group}"
            attrs="{'invisible': [('assignment_can_assign_me', '=', False)]}"
        />
        <button
            name="action_assignment_open_wizard"
            string="Assign…"
            type="object"
            class="btn-sm btn-secondary mx-1"
            icon="fa-share"
            t-attf-groups="#{manager_group}"
        />
    </template>

    <!--
      Assignment alert injected above the sheet of any form whose model
      inherits ``assignment.mixin`` (see get_view there) — same shape as
      base_tier_validation's tier_validation_label. Keeps the Assign to me /
      Assign… / Unassign buttons out of the header's workflow buttons.

      The injection loop inserts the *children* of the root div, so the
      groups-gated wrapper must be one level down.
    -->
    <template id="assignment_buttons_alert">
        <div>
            <div t-attf-groups="#{user_group},#{manager_group}">
                <field name="assignment_can_assign_me" invisible="1" />
                <!-- No officer yet -->
                <div
                    class="alert alert-warning mb-0 pb-1 px-4"
                    role="alert"
                    attrs="{'invisible': [('assigned_to', '!=', False)]}"
                >
                    <p>
                        <i class="fa fa-user-o" /> This document has no assigned officer.
                        <t t-call="base_assignment._assignment_common_buttons" />
                    </p>
                </div>
                <!-- Officer assigned -->
                <div
                    class="alert alert-info mb-0 pb-1 px-4"
                    role="alert"
                    attrs="{'invisible': [('assigned_to', '=', False)]}"
                >
                    <p>
                        <i class="fa fa-user" /> Assigned Officer:
                        <field
                            name="assigned_to"
                            readonly="1"
                            class="fw-bold"
                        />
                        <t t-call="base_assignment._assignment_common_buttons" />
                        <button
                            name="action_assignment_unassign"
                            string="Unassign"
                            type="object"
                            class="btn-sm btn-danger mx-1"
                            icon="fa-times"
                            t-attf-groups="#{manager_group}"
                        />
                    </p>
                </div>
            </div>
        </div>
    </template>

</odoo>
