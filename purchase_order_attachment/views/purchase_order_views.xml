<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- View purchase.order form -->
  <record id="view_purchase_order_form" model="ir.ui.view">
      <field name="name">view.purchase.order.form Attachment</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">
          <xpath expr="//notebook" position="inside">
            <page name="document" string="Attachment">
                  <field name="attachment_ids" 
                        context="{'default_res_model': 'purchase.order'}">
                      <tree default_order="sequence">
                          <field name="sequence" widget="handle"/>
                          <field name="name" string="File Name" required="1"/>
                          <field name="description"/>
                      </tree>
                      <form>
                          <sheet>
                              <group>
                                  <field name="res_model" invisible="1" readonly="0"/>
                                  <field name="res_id" invisible="1" readonly="0"/>
                                  <field name="name" required="1" invisible="1"/>
                                  <field name="datas" filename="name" required="1"/>
                                  <field name="description" placeholder="Description"/>
                              </group>
                          </sheet>
                      </form>
                  </field>
              </page>
          </xpath>
      </field>
  </record>

</odoo>