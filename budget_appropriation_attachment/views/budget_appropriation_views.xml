<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_appropriation_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form.attachment</field>
        <field name="model">budget.appropriation</field>
        <field
            name="inherit_id"
            ref="budget_appropriation.view_budget_appropriation_form"
        />
        <field name="arch" type="xml">
            <notebook position="before">
                <group name="attachments" string="เอกสารแนบ">
                    <field
                        name="attachment_ids"
                        nolabel="1"
                        colspan="2"
                        widget="many2many_binary"
                        context="{'default_res_model': 'budget.appropriation'}"
                        attrs="{'readonly': [('state', 'in', ['posted', 'cancel'])]}"
                    />
                </group>
            </notebook>
        </field>
    </record>

</odoo>
