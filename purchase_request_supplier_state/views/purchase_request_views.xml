<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_rejected']" position="attributes">
                <attribute name="states">to_examine,to_approve</attribute>
                <attribute name="groups">purchase_request.group_purchase_request_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="before">
                <button name="button_examine" states="to_examine" string="Examine" type="object" class="oe_highlight" groups="purchase_request_security.purchase_request_user_all_rule"/>
            </xpath>
        </field>
    </record>

  </odoo>