  <record id="group_pr_approver" model="res.groups">
      <field name="name">Purchase Request Approver</field>
      <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchase_request_user'))]"/>
  </record>

  <record id="group_pr_admin" model="res.groups">
    <field name="name">Purchase Request Admin</field>
    <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchase_request_manager'))]"/>
  </record>
</odoo>