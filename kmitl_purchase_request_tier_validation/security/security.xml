  <record id="group_pr_finance" model="res.groups">
    <field name="name">Purchase Request Finance</field>
    <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchase_request_user'))]"/>
  </record>

  <record id="group_pr_supply" model="res.groups">
      <field name="name">Purchase Request Supply</field>
      <field name="implied_ids" eval="[(4, ref('purchase_request.group_purchase_request_user'))]"/>
