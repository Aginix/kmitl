<?xml version="1.0" encoding="utf-8"?>
<!-- 
Tier Definition Data for Account Move Validation

This file defines the 2-step approval workflow for journal entries (account.move).
It creates two sequential tier definitions that must be completed in order:

1. Validation Tier (sequence 10): Users with 'Account Move Validator' role
2. Approval Tier (sequence 20): Users with 'Account Move Approver' role

Key Configuration:
- review_type: "individual" means any single user from the group can perform the review
- approve_sequence: True ensures tiers must be completed in sequential order
- has_comment: True allows reviewers to add comments during validation
- definition_type: "domain" allows for domain-based conditions (if needed)

Workflow: Draft → Request Validation → Validation Review → Approval Review → Posted
-->
<odoo>
    <!-- 
    First Tier: Account Move Validation
    
    This tier defines the initial validation step where users with the 
    'Account Move Validator' role review journal entries for accuracy 
    and completeness before passing to the approval stage.
    -->
    <record id="tier_definition_account_move_validate" model="tier.definition">
        <field name="model_id" ref="account.model_account_move"/>
        <field name="name">Account Move Validation</field>
        <field name="sequence">10</field>  <!-- First step in workflow -->
        <field name="review_type">individual</field>  <!-- Any validator can review -->
        <field name="reviewer_id" eval="False"/>  <!-- No specific user required -->
        <field name="reviewer_group_id" ref="account_move_tier_validation.group_account_move_validator"/>
        <field name="definition_type">domain</field>  <!-- Supports domain filtering if needed -->
        <field name="approve_sequence">True</field>  <!-- Sequential processing required -->
        <field name="has_comment">True</field>  <!-- Allow validation comments -->
        <field name="active">True</field>
    </record>

    <!-- 
    Second Tier: Account Move Approval
    
    This tier defines the final approval step where users with the 
    'Account Move Approver' role give final authorization for posting 
    the journal entry after validation is complete.
    -->
    <record id="tier_definition_account_move_approve" model="tier.definition">
        <field name="model_id" ref="account.model_account_move"/>
        <field name="name">Account Move Approval</field>
        <field name="sequence">20</field>  <!-- Second step in workflow -->
        <field name="review_type">individual</field>  <!-- Any approver can review -->
        <field name="reviewer_id" eval="False"/>  <!-- No specific user required -->
        <field name="reviewer_group_id" ref="account_move_tier_validation.group_account_move_approver"/>
        <field name="definition_type">domain</field>  <!-- Supports domain filtering if needed -->
        <field name="approve_sequence">True</field>  <!-- Must complete validation tier first -->
        <field name="has_comment">True</field>  <!-- Allow approval comments -->
        <field name="active">True</field>
    </record>
</odoo>
