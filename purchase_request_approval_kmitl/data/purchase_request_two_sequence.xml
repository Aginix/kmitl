<odoo>
    <data noupdate="1">
        <record id="seq_purchase_request_approval_form" model="ir.sequence">
            <field name="name">PR2 Form</field>
            <field name="code">purchase.request.approval.form</field>
            <field name="prefix">PR2/Form/%(y_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>

        <record id="seq_purchase_request_approval_submitted" model="ir.sequence">
            <field name="name">PR2 Submitted Sequence</field>
            <field name="code">purchase.request.approval.submitted</field>
            <field name="prefix">PR2/Submit/%(y_be)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
    </data>

</odoo>
