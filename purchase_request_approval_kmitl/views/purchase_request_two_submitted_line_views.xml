<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.two.submitted.line View Tree -->
    <record id="view_purchase_request_approval_submitted_line_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.submitted.line.tree</field>
        <field name="model">purchase.request.approval.submitted.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="vendor"/>
                <field name="submitted_id" />
            </tree>
        </field>
    </record>

    <!-- View purchase.request.two.submitted.line form -->
    <record id="view_purchase_request_approval_submitted_line_form" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.submitted.line.form</field>
        <field name="model">purchase.request.approval.submitted.line</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Two Submitted Line">
                <sheet>
                    <div class="oe_title">
                        <label for="vendor"/>
                        <h1>
                            <field name="vendor" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action purchase.request.two.submitted.line -->
    <record id="action_purchase_request_approval_submitted_line" model="ir.actions.act_window">
        <field name="name">Purchase Request approval Submitted Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.approval.submitted.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Two Submitted Line.
            </p>
        </field>
    </record>

</odoo>
