<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.two View Tree -->
    <record id="view_purchase_request_approval_form_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form.tree</field>
        <field name="model">purchase.request.approval.form</field>
        <field name="arch" type="xml">
            <tree create='0' decoration-success="state == 'approved'" decoration-info="state in ('submitted', 'po_created')" decoration-warning="state == 'draft'" decoration-danger="state == 'rejected'">
                <field name="name" />
                <field name="pr1_ref"/>
                <field name="vendor" />
                <field name="payment_type" />
                <field name="amount_total" />
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state in ('submitted', 'po_created')" decoration-warning="state == 'draft'" decoration-danger="state == 'rejected'" />
            </tree>
        </field>
    </record>

    <!-- View purchase.request.two form -->
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form</field>
        <field name="model">purchase.request.approval.form</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Two">
                <header>
                    <button name="action_merge_to_submitted" type="object" string="Create PR2" class="btn-primary" attrs="{'invisible': ['|' , ('estimated_cost_from_pr', '&gt;', 100000), ('state', '!=', 'draft')]}" />
                    <button name="action_egp" string="Submit EGP" type="object" class="btn-primary" attrs="{'invisible': ['|' , ('estimated_cost_from_pr', '&lt;', 100000) , ('state', '!=', 'draft')]}" />
                    <button name="button_draft" type="object" string="Reset" class="btn-secondary" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,po_created,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..." readonly="1" />
                        </h1>
                    </div>
                    <field name="is_editable" invisible="1" />
                    <group>
                        <group>
                            <field name="vendor" required="1" attrs="{'readonly': [('is_editable','=', False)]}" />
                             <field name="purchase_request_name" required="1" attrs="{'readonly': [('is_editable','=', False)]}" />
                            <field name="start_date" widget="remaining_days"  attrs="{'readonly': [('is_editable','=', False)]}" />
                            <field name="end_date" widget="remaining_days" attrs="{'readonly': [('is_editable','=', False)]}" />
                        </group>
                        <group>
                            <field name="contract_type" readonly="1" />
                            <field name="pr1_requested_by" invisible='1'/>
                            <field name="payment_type" readonly="1" />
                            <field name="department_id" readonly="1"/>
                            <field name="generate_po" attrs="{'readonly': [('is_editable','=', False)]}"/>
                            <field name="submitted_id" readonly='1'/>
                            <field name="submitted_state" readonly='1'/>
                        </group>
                    </group>
                    <label for="pr1_ref"/>
                    <h2>
                        <field name="pr1_ref" options="{'no_create': True}" context="{}"/>
                    </h2>
                    <label for="estimated_cost_from_pr"/>
                    <h2>
                        <field name="estimated_cost_from_pr"/>
                    </h2>
                    <notebook>
                        <page string="Product Lines">
                            <field name="line_ids" attrs="{'readonly': [('is_editable','=', False)]}">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="taxes"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_untaxed" readonly="1"/>
                        <field name="amount_tax" readonly="1"/>
                        <field name="amount_total" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View purchase.request.two search -->
    <record id="view_purchase_request_approval_form_search" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form.search</field>
        <field name="model">purchase.request.approval.form</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action purchase.request.two -->
    <record id="action_purchase_request_approval_form" model="ir.actions.act_window">
        <field name="name">Purchase Request Approval Form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.approval.form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Two.
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_request_approval_form" name="Purchase Requests Approval" parent="purchase_request.parent_menu_purchase_request" />
    <menuitem id="menu_purchase_request_approval_form_root_pr" name="Purchase Request Approval Form" parent="purchase_request_approval_kmitl.menu_purchase_request_approval_form" action="action_purchase_request_approval_form" sequence="20"/>
    <menuitem id="menu_purchase_request_approval_form_root" name="Purchase Request Approval" parent="purchase.menu_procurement_management" action="action_purchase_request_approval_form" sequence="20"/>
</odoo>
