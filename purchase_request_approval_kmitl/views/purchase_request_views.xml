<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <!-- tier validation -->
            <button name="button_draft" position="after">
                <field name="hide_request_validation_button" invisible="1" />
                <field name="hide_restart_validation_button" invisible="1" />
                <field name="validation_status" invisible="1" />
                <field name="need_validation" invisible="1" />
                <field name="can_request" invisible="1" />
                <button name="request_validation" string="Request Validation" class="btn-primary" attrs="{'invisible': [('hide_request_validation_button', '=', True)]}" type="object" />
                <button name="restart_validation" string="Restart Validation" class="btn-primary" attrs="{'invisible': [('hide_restart_validation_button', '=', True)]}" type="object" groups="purchase_request.group_purchase_request_manager" />
            </button>
            <!-- state change -->
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,to_verify,to_approve,approved,done,in_progress</attribute
                >
            </field>
            <button name="button_to_approve" position="after">
                <button name="button_to_verify" states="draft" string="Request approval" type="object" class="oe_highlight" />
            </button>
            <button name="button_approved" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
        </field>
    </record>
</odoo>
