<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_tier_validation.view_purchase_request_form_inherit_tier"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <field name="rejected" invisible="1" />
                <field name="validation_status" invisible="1" />
                <field name="need_validation" invisible="1" />
                <button name="request_validation" string="Request Validation" class="btn-primary" attrs="{'invisible': ['|', '|',
        ('need_validation', '!=', True),
        ('validation_status', '=', 'pending'),
        ('rejected', '=', True),
    ]}" type="object" />
                <button name="restart_validation" string="Restart Validation" class="btn-primary" attrs="{'invisible': ['|',
        ('need_validation', '!=', True),
        ('validation_status', '!=', 'pending'),
    ]}" type="object" groups="purchase_request.group_purchase_request_manager" />
            </button>
        </field>
    </record>
</odoo>
