<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <!-- state change -->
            <field name="state" position="attributes">
                <attribute
                    name="statusbar_visible"
                >draft,to_verify,to_approve,approved,done,in_progress</attribute>
            </field>
            <button name="button_to_approve" position="after">
                <button
                    name="button_to_verify"
                    states="draft"
                    string="Request approval"
                    type="object"
                    class="oe_highlight"
                    groups="purchase_request.group_purchase_request_user"
                />
            </button>
            <button name="button_approved" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
        </field>
    </record>

    <record id="view_purchase_request_form_fy_lock" model="ir.ui.view">
        <field name="name">purchase.request.form (FY lock on numbering)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_kmitl.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_fiscal_year_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('fiscal_year_locked', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='account_fiscal_year_id']" position="after">
                <field name="fiscal_year_locked" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
