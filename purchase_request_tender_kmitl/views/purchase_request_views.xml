<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form(purchase Request Tender)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_purchase_request_tender" class="oe_stat_button" icon="fa-user">
                    <field name="tender_count" widget="statinfo" string="Tenderer" />
                </button>
            </xpath>
        </field>
    </record>

  </odoo>
