<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_tender_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tender.tree</field>
        <field name="model">purchase.request.tender</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="price" />
                <button
                    name="unlink"
                    type="object"
                    icon="fa-trash"
                    title="Delete"
                />
            </tree>
        </field>
    </record>

    <record id="view_purchase_request_tender_form" model="ir.ui.view">
        <field name="name">view.purchase.request.tender.form</field>
        <field name="model">purchase.request.tender</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Tender">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Name..." />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_request_tender_search" model="ir.ui.view">
        <field name="name">view.purchase.request.tender.search</field>
        <field name="model">purchase.request.tender</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        domain="[]"
                        context="{'group_by':'name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_request_tender" model="ir.actions.act_window">
        <field name="name">Purchase Request Tender</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.tender</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Tender.
            </p>
        </field>
    </record>
</odoo>
