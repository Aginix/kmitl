<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" class="oe_stat_button" icon="fa-camera" name="action_view_snapshots">
                    <field string="Snapshots" name="snapshot_count" widget="statinfo"/>
                </button>
            </xpath>
            <!-- <xpath expr="//header" position="inside">
                <button name="action_create_snapshot" type="object" class="oe_stat_button" string="Snapshot" />
            </xpath> -->
        </field>
    </record>
</odoo>
