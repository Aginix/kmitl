<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend hr.applicant form with profile tabs -->
    <record id="hr_applicant_view_form_profile" model="ir.ui.view">
        <field name="name">hr.applicant.form.profile</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Profile Info tab -->
                <page string="Profile Info" name="profile_info">
                    <group>
                        <group string="Thai Name">
                            <field name="applicant_title" />
                            <field name="first_name" />
                            <field name="middle_name" />
                            <field name="last_name" />
                        </group>
                        <group string="English Name">
                            <field name="first_name_en" />
                            <field name="middle_name_en" />
                            <field name="last_name_en" />
                        </group>
                    </group>
                    <group>
                        <group string="Personal Info">
                            <field name="identification_id" />
                            <field name="birthday" />
                            <field name="nationality_id" />
                            <field name="marital" />
                        </group>
                        <group
                            string="Spouse"
                            attrs="{'invisible': [('marital', '!=', 'married')]}"
                        >
                            <field name="spouse_prefix" />
                            <field name="spouse_first_name" />
                            <field name="spouse_middle_name" />
                            <field name="spouse_last_name" />
                        </group>
                    </group>
                </page>
                <!-- Contact & Address tab -->
                <page string="Contact &amp; Address" name="contact_address">
                    <group>
                        <group string="Registered Address">
                            <field name="address_street" />
                            <field name="address_zip_id" />
                            <field name="address_city" />
                            <field name="address_state_id" />
                            <field name="address_zip" />
                            <field name="address_country_id" />
                        </group>
                        <group string="Current Address">
                            <field name="current_street" />
                            <field name="current_zip_id" />
                            <field name="current_city" />
                            <field name="current_state_id" />
                            <field name="current_zip" />
                            <field name="current_country_id" />
                        </group>
                        <group string="Emergency Contact">
                            <field name="emergency_contact_name" />
                            <field name="emergency_contact_relation" />
                            <field name="emergency_contact_phone" />
                            <field name="emergency_contact_email" />
                        </group>
                    </group>
                    <group string="Health">
                        <field name="congenital_disease" nolabel="1" />
                    </group>
                </page>
                <!-- Education History tab -->
                <page string="Education History" name="education_history">
                    <group>
                        <field name="highest_education" />
                    </group>
                    <field name="education_history_ids">
                        <tree editable="bottom">
                            <field name="education_level_id" />
                            <field name="program" />
                            <field name="major" />
                            <field name="institution" />
                            <field name="country_id" />
                            <field name="graduation_date" />
                        </tree>
                    </field>
                </page>
                <!-- Work History tab -->
                <page string="Work History" name="work_history">
                    <field name="work_history_ids">
                        <tree editable="bottom">
                            <field name="company_name" />
                            <field name="job_title" />
                            <field name="salary" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="duration" />
                        </tree>
                    </field>
                </page>
                <!-- Skills & Qualifications tab -->
                <page string="Skills &amp; Qualifications" name="skills">
                    <group>
                        <group string="Academic">
                            <field name="academic_standing_id" />
                            <field name="academic_position_date" />
                            <field name="academic_position_institution" />
                        </group>
                        <group string="OCSC Exam">
                            <field name="has_ocsc_exam" />
                            <field
                                name="ocsc_exam_level"
                                attrs="{'invisible': [('has_ocsc_exam', '=', False)]}"
                            />
                            <field
                                name="ocsc_exam_date"
                                attrs="{'invisible': [('has_ocsc_exam', '=', False)]}"
                            />
                            <field
                                name="ocsc_exam_number"
                                attrs="{'invisible': [('has_ocsc_exam', '=', False)]}"
                            />
                        </group>
                    </group>
                    <group>
                        <group string="Skills">
                            <field name="foreign_language_skills" />
                            <field name="computer_skills" />
                            <field name="other_abilities" />
                            <field name="interests" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
