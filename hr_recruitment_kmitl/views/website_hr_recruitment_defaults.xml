<odoo>
    <template id="website_hr_recruitment.default_website_description">
        <!-- Job Description -->
        <div class="oe_structure">
            <div class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div
                            class="rounded-3 d-flex align-items-center justify-content-center me-3 bg-primary-light text-primary p-3"
                        >
                            <i class="fa fa-file-text-o fs-6" />
                        </div>
                        <h5 class="fw-bold text-dark mb-0">
                            รายละเอียดงาน (Job Description)
                        </h5>
                    </div>
                    <ul>
                        <li
                        >ปฏิบัติงานในฐานะผู้ปฏิบัติการที่ต้องใช้ความรู้ ความสามารถทางวิชาการในการทำงาน
                            ปฏิบัติงานเกี่ยวกับสิ่งแวดล้อม ภายใต้การกำกับแนะนำ
                            ตรวจสอบและปฏิบัติงานอื่นตามที่ได้รับมอบหมาย ลักษณะงานที่ปฏิบัติในด้านต่าง ๆ</li>
                        <li
                        >ปฏิบัติการเกี่ยวกับการสำรวจ รวบรวมข้อมูล ศึกษา วิเคราะห์ วิจัย ประเมินผล
                            และสรุปผลข้อมูลและการดำเนินงาน
                            รวมทั้งสามารถติดตามตรวจสอบข้อมูลและการดำเนินงานที่เกี่ยวข้องกับงานและระบบการจัดการด้านสิ่งแวดล้อม
                            เพื่อเป็นแนวทางในการกำหนด พัฒนาและปรับปรุงนโยบาย แผนการดำเนินงาน
                            ตัวชี้วัดและมาตรการในการพัฒนาระบบการจัดการสิ่งแวดล้อมและความยั่งยืนของสถาบัน</li>
                        <li>จัดเก็บข้อมูลเบื้องต้น หรือฐานข้อมูลระบบสารสนเทศ
                            จัดทำสถิติและจัดทำรายงานที่เกี่ยวข้องกับงานและระบบการจัดการด้านสิ่งแวดล้อมเพื่อติดตาม
                            ประเมินและพัฒนาระบบบริหารจัดการทรัพยากรในพื้นที่สถาบัน</li>
                        <li
                        >ร่วมวางแผนและพัฒนาระบบฐานข้อมูลด้านสิ่งแวดล้อมที่เชื่อมต่อกับฐานข้อมูลระบบสารสนเทศเพื่อใช้ในการรายงานและคาดการณ์ผลกระทบในอนาคต
                        </li>
                        <li
                        >ร่วมพัฒนาและถ่ายทอดองค์ความรู้ในการปฏิบัติงานด้านสิ่งแวดล้อม</li>
                        <li>ประสานการทำงานร่วมกันทั้งภายในและภายนอกสถาบันหรือหน่วยงาน
                            เพื่อให้เกิดความร่วมมือและผลสัมฤทธิ์ตามที่กำหนดไว้</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- Qualifications -->
        <div class="oe_structure">
            <div class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div
                            class="rounded-3 d-flex align-items-center justify-content-center me-3 bg-primary-light text-primary p-3"
                        >
                            <i class="fa fa-star fs-6" />
                        </div>
                        <h5 class="fw-bold text-dark mb-0">
                            คุณสมบัติ (Qualifications)
                        </h5>
                    </div>
                    <div id="qualifications" class="accordion" role="tablist">
                        <div class="card bg-white" data-name="Item">
                            <a
                                href="#"
                                t-attf-data-bs-target="#qualificationsTabInitial_1"
                                role="tab"
                                data-bs-toggle="collapse"
                                aria-expanded="true"
                                class="card-header"
                            >
                                คุณสมบัติทั่วไป (General Qualifications)
                            </a>
                            <div
                                t-attf-id="qualificationsTabInitial_1"
                                class="collapse show"
                                data-bs-parent="#qualifications"
                                role="tabpanel"
                            >
                                <div class="card-body">
                                    <ul>
                                        <li>ทุกสัญชาติ</li>
                                        <li
                                        >มีอายุไม่ต่ำกว่าสิบแปดปีบริบูรณ์ และไม่เกินหกสิบปี</li>
                                        <li
                                        >เป็นผู้เลื่อมใสในการปกครองระบอบประชาธิปไตยอันมีพระมหากษัตริย์ทรงเป็นประมุขด้วยความบริสุทธิ์ใจ
                                        </li>
                                        <li>อื่น ๆ ตามที่ ก.บ. สถล. กำหนด</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="card bg-white" data-name="Item">
                            <a
                                href="#"
                                t-attf-data-bs-target="#qualificationsTabInitial_2"
                                role="tab"
                                data-bs-toggle="collapse"
                                aria-expanded="false"
                                class="collapsed card-header"
                            >
                                คุณสมบัติเฉพาะตำแหน่ง (Specific Qualifications)
                            </a>
                            <div
                                t-attf-id="qualificationsTabInitial_2"
                                class="collapse"
                                data-bs-parent="#qualifications"
                                role="tabpanel"
                            >
                                <div class="card-body">
                                    <ul>
                                        <li
                                        >สาขาวิชาที่เกี่ยวข้องสถิติ, คณิตศาสตร์, วิทยาการคอมพิวเตอร์,
                                            ระบบสารสนเทศเพื่อการจัดการ หรือสาขาที่เกี่ยวข้องกับการวิเคราะห์ข้อมูล</li>
                                        <li>
                                            ทักษะการใช้โปรแกรมพื้นฐาน (Microsoft Office หรือเทียบเท่า) ระดับดีขึ้นไป
                                            <ul>
                                                <li>
                                                    Microsoft Word
                                                    <ul>
                                                        <li
                                                        >จัดรูปแบบเอกสารตามหนังสือราชการ</li>
                                                        <li>สร้างสารบัญอัตโนมัติ</li>
                                                        <li>จัดการเชิงอรรถ</li>
                                                        <li
                                                        >ใช้ Styles เพื่อจัดเอกสารให้เป็นระเบียบ</li>
                                                    </ul>
                                                </li>
                                                <li>
                                                    Microsoft Excel
                                                    <ul>
                                                        <li
                                                        >ใช้ฟังก์ชันพื้นฐานและขั้นสูง เช่น VLOOKUP, PivotTable,
                                                            SUMIFS, IF, Conditional Formatting</li>
                                                        <li>สร้างตารางและแผนภูมิ
                                                            เพื่อวิเคราะห์และนำเสนอข้อมูลสถิติที่เกี่ยวข้องกับตัวชี้วัดได้อย่างถูกต้องและน่าสนใจ
                                                        </li>
                                                    </ul>
                                                </li>
                                                <li>
                                                    Microsoft Powerpoint
                                                    <ul>
                                                        <li
                                                        >สร้างสไลด์เพื่อนำเสนอข้อมูลและผลการประเมินได้อย่างชัดเจนและมีประสิทธิภาพ
                                                        </li>
                                                    </ul>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="card bg-white" data-name="Item">
                            <a
                                href="#"
                                t-attf-data-bs-target="#qualificationsTabInitial_3"
                                role="tab"
                                data-bs-toggle="collapse"
                                aria-expanded="false"
                                class="collapsed card-header"
                            >
                                ลักษณะต้องห้าม (Disqualifications)
                            </a>
                            <div
                                t-attf-id="qualificationsTabInitial_3"
                                class="collapse"
                                data-bs-parent="#qualifications"
                                role="tabpanel"
                            >
                                <div class="card-body">
                                    <ul>
                                        <li>เป็นผู้ดำรงตำแหน่งทางการเมือง</li>
                                        <li
                                        >เป็นคนวิกลจริต หรือจิตฟั่นเฟือนไม่สมประกอบ หรือเป็นคนเสมือนไร้ความสามารถ
                                            หรือเป็นโรคตามที่กำหนดในกฎ ก.พ.อ. หรือเป็นโรคตามที่กำหนดในประกาศของ ก.บ.
                                            สถล.</li>
                                        <li>เป็นผู้อยู่ในระหว่างถูกสั่งพักราชการ
                                            หรือถูกสั่งให้ออกจากราชการไว้ก่อนตามข้อบังคับนี้หรือกฎหมายอื่น</li>
                                        <li
                                        >เป็นผู้บกพร่องในศีลธรรมอันดี จนเป็นที่รังเกียจของสังคม</li>
                                        <li>เป็นกรรมการ
                                            หรือผู้ดำรงตำแหน่งที่รับผิดชอบในการบริหารพรรคการเมืองหรือเจ้าหน้าที่ในพรรคการเมือง
                                        </li>
                                        <li>เป็นบุคคลล้มละลาย</li>
                                        <li>เคยถูกจำคุกโดยคำพิพากษาถึงที่สุดให้จำคุก
                                            เว้นแต่เป็นโทษสำหรับความผิดที่ได้กระทำโดยประมาทหรือความผิดลหุโทษ</li>
                                        <li
                                        >เคยถูกลงโทษให้ออก ปลดออก หรือไล่ออกจากรัฐวิสาหกิจ องค์กรมหาชน
                                            หรือหน่วยงานอื่นของรัฐ</li>
                                        <li>เคยถูกลงโทษให้ออก ปลดออก
                                            หรือไล่ออกเพราะกระทำผิดวินัยตามข้อบังคับนี้หรือกฎหมายอื่น</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Responsibilities -->
        <div class="oe_structure">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div
                            class="rounded-3 d-flex align-items-center justify-content-center me-3 bg-primary-light text-primary p-3"
                        >
                            <i class="fa fa-briefcase fs-6" />
                        </div>
                        <h5 class="fw-bold text-dark mb-0">
                            ภาระงาน (Responsibilities)
                        </h5>
                    </div>
                    <ol>
                        <li
                        >รวบรวมและวิเคราะห์ข้อมูลผลการดำเนินงานตามตัวชี้วัด (KPIs) ของคณะ</li>
                        <li
                        >จัดเตรียมเอกสารและรายงานสำหรับการประเมินคุณภาพการศึกษาประจำปี</li>
                        <li
                        >ติดตามและประเมินผลการดำเนินงานโครงการต่างๆ ที่ตอบสนองต่อยุทธศาสตร์ของสถาบัน</li>
                        <li>งานอื่นๆ ตามที่ได้รับมอบหมายจากผู้บังคับบัญชา</li>
                    </ol>
                </div>
            </div>
        </div>
        <!-- Benefits -->
        <div class="oe_structure">
            <div class="card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div
                            class="rounded-3 d-flex align-items-center justify-content-center me-3 bg-primary-light text-primary p-3"
                        >
                            <i class="fa fa-shield fs-6" />
                        </div>
                        <h5 class="fw-bold text-dark mb-0">
                            สวัสดิการและสิทธิประโยชน์ (Benefits and Welfare)
                        </h5>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div
                                class="bg-primary-light rounded-5 p-3 d-flex align-items-center h-100"
                            >
                                <div
                                    class="bg-white rounded-circle p-2 shadow-sm me-3 d-flex align-items-center justify-content-center"
                                    style="width: 40px; height: 40px;"
                                >
                                    <i class="fa fa-shield fa-fw text-primary fs-5" />
                                </div>
                                <span class="small fw-bold text-dark lh-sm">
                                    ประกันสังคม
                                    <br />
                                    <span
                                        class="text-muted fw-normal small"
                                    >Social Security</span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div
                                class="bg-primary-light rounded-5 p-3 d-flex align-items-center h-100"
                            >
                                <div
                                    class="bg-white rounded-circle p-2 shadow-sm me-3 d-flex align-items-center justify-content-center"
                                    style="width: 40px; height: 40px;"
                                >
                                    <i class="fa fa-database fa-fw text-primary fs-5" />
                                </div>
                                <span class="small fw-bold text-dark lh-sm">
                                    กองทุนสำรองเลี้ยงชีพ
                                    <br />
                                    <span
                                        class="text-muted fw-normal small"
                                    >Provident Fund</span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div
                                class="bg-primary-light rounded-5 p-3 d-flex align-items-center h-100"
                            >
                                <div
                                    class="bg-white rounded-circle p-2 shadow-sm me-3 d-flex align-items-center justify-content-center"
                                    style="width: 40px; height: 40px;"
                                >
                                    <i
                                        class="fa fa-stethoscope fa-fw text-primary fs-5"
                                    />
                                </div>
                                <span class="small fw-bold text-dark lh-sm">
                                    สวัสดิการค่ารักษาพยาบาล
                                    <br />
                                    <span
                                        class="text-muted fw-normal small"
                                    >รวมครอบครัว</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Documents -->
        <div class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <div
                        class="rounded-3 d-flex align-items-center justify-content-center me-3 bg-primary-light text-primary p-3"
                    >
                        <i class="fa fa-paperclip fs-6" />
                    </div>
                    <h5 class="fw-bold text-dark mb-0">
                        เอกสารที่ใช้สมัคร (Required Documents)
                    </h5>
                </div>
                <ol>
                    <li
                    >ใบสมัครสอบคัดเลือกเพื่อบรรจุเป็นพนักงานสถาบัน โดยกรอกรายละเอียดครบถ้วน
                        พร้อมแนบรูปถ่ายหน้าตรงไม่สวมหมวก ไม่สวมแว่นตาดำ ขนาด 1 นิ้ว จำนวน 1 รูป (ถ่ายไว้ไม่เกิน 6 เดือน)
                    </li>
                    <li
                    >สําเนาใบปริญญาบัตร หรือสําเนาหนังสือรับรองที่สภามหาวิทยาลัยอนุมัติผลการศึกษา</li>
                    <li>สำเนาใบรายงานผลการศึกษาเป็นรายวิชา</li>
                    <li>สำเนาบัตรประจำตัวประชาชน</li>
                    <li>สำเนาทะเบียนบ้าน</li>
                    <li
                    >สำเนาหนังสือรับรองผ่านการเกณฑ์ทหาร หรือได้รับการยกเว้นการเกณฑ์ทหาร ใบ สด.8 สด.9 หรือ สด.43
                        หรือหลักฐานทางการอื่น ๆ (เฉพาะเพศชาย)</li>
                    <li
                    >ประวัติส่วนตัว (Resume หรือ CV) และผลงานทางวิชาการ/งานวิจัย (Publication/Research)</li>
                    <li
                    >สำเนาเอกสารอื่น ๆ เช่น หนังสือเปลี่ยนชื่อ นามสกุล และอื่น ๆ (ถ้ามี)</li>
                    <li
                    >ใบรับรองแพทย์ใช้สำหรับสมัครงาน จากโรงพยาบาลรัฐ หรือโรงพยาบาลเอกชน หรือคลินิกเวชกรรม สอจอ
                        ซึ่งมีอายุไม่เกิน 1 เดือน</li>
                    <li>หลักฐานการชำระค่าธรรมเนียมการสมัครสอบ</li>
                </ol>
                <t t-snippet-call="website.s_hr" />
                <div>
                    <b>หมายเหตุ:</b>
                    <br />
                    <ul>
                        <li
                        >การสมัครทางอีเมลให้ใช้เอกสารสำหรับการสมัคร พร้อมลงลายมือชื่อสำเนาถูกต้อง ในเอกสารส่วนตัว
                            ให้รวมเอกสารไฟล์ .pdf เป็นไฟล์เดียว พร้อมติดรูปถ่ายในใบสมัครให้เรียบร้อย</li>
                        <li
                        >หากเอกสารอย่างใดอย่างหนึ่งไม่ครบถ้วน ไม่เรียบร้อย ตรงตามประกาศ
                            หรือไม่สามารถส่งได้ภายในระยะเวลาที่กำหนด ให้ถือว่าการสมัครสอบคัดเลือกครั้งนี้เป็นโมฆะ</li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
</odoo>
