<odoo>
    <template id="section_tab_intro">
        <div class="mb-4">
            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-1">
                <span class="section-indicator bg-primary"></span>
                <t t-esc="title" />
            </h5>
            <p t-if="description" class="text-secondary small ms-4 mb-0">
                <t t-esc="description" />
            </p>
        </div>
    </template>
    <template id="input_readonly_field">
        <label class="form-label fw-semibold text-dark">
            <t t-esc="label"/>
        </label>
        <input type="text"
               class="form-control text-muted border-0 py-2"
               t-att-value="value or '-'"
               readonly="readonly"/>
    </template>
    <template id="input_readonly_textarea">
        <label class="form-label fw-semibold text-dark">
            <t t-esc="label"/>
        </label>
        <textarea class="form-control text-muted border-0 py-2"
                  t-att-rows="rows or 4"
                  readonly="readonly">
            <t t-esc="value or '-'"/>
        </textarea>
    </template>
    <!-- Alert หน้าฟอร์มที่บอกวาขั้นตอน 1-4 แก้ไขไม่ได้ -->
    <template id="profile_banner">
        <div
            class="alert d-flex align-items-start gap-3 p-3 mb-4 rounded-4 bg-primary-light border border-primary">
            <i class="fa fa-exclamation-circle fs-4 text-primary mt-1"></i>
            <div>
                <h6 class="fw-bold text-dark mb-1">
                    ข้อมูลในขั้นตอนที่ 1–5 ดึงมาจากแฟ้มประวัติ (Master Profile)
                    และไม่สามารถแก้ไขได้ในหน้านี้
                </h6>
                <p class="text-secondary small mb-0">
                    เพื่อป้องกันข้อมูลไม่ตรงกัน หากพบว่าข้อมูลไม่ถูกต้อง
                    <a href="/my/profile" class="fw-bold text-primary text-decoration-underline">
                        คลิกที่นี่เพื่อแก้ไขแฟ้มประวัติส่วนตัว
                    </a>
                </p>
            </div>
        </div>
    </template>
    <!-- สำหรับอัปโหลดเอกสาร -->
    <template id="document_upload_item">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-3 border rounded-12 bg-white">
            <div class="d-flex align-items-start gap-3 flex-grow-1">
                <div class="d-flex align-items-center justify-content-center rounded-3 bg-light flex-shrink-0 upload-file-icon">
                    <i class="fa fa-file-text-o text-secondary"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                        <span class="fw-semibold text-dark">
                            <t t-esc="label"/>
                        </span>
                        <t t-if="required">
                            <span class="badge rounded-pill text-danger bg-danger-subtle">
                            จำเป็น
                        </span>
                        </t>
                    </div>
                    <p class="text-secondary small mb-2">
                        <t t-esc="description"/>
                    </p>
                    <div class="small text-muted js-file-status">
                    ยังไม่ได้เลือกไฟล์
                </div>
                </div>
            </div>
            <div class="flex-shrink-0">
                <label class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-4 fw-medium mb-0">
                    <i class="fa fa-upload me-1"></i>
                    <span class="js-upload-label">อัปโหลด</span>
                    <input type="file"
                       class="d-none js-file-input"
                       t-att-name="name"
                       accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"/>
                </label>
            </div>
        </div>
    </template>
</odoo>