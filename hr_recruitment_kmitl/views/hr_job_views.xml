<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_job_form" model="ir.ui.view">
        <field name="name">hr.job.form (role)</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form" />
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="role" widget="radio" />
                <field name="kmitl_employee_type" widget="radio" />
                <field name="currency_id" invisible="1" />
                <label for="salary_min" string="Salary" />
                <div class="o_row">
                    <field name="salary_min" />
                    <span class="text-muted">-</span>
                    <field name="salary_max" />
                </div>
                <field name="education_level_ids" widget="many2many_checkboxes" />
                <field name="attachment_ids" widget="many2many_binary" />
            </field>

            <field name="name" position="after">
                <field name="category_ids" widget="many2many_tags" />
            </field>

            <xpath expr="//label[@for='no_of_recruitment']" position="before">
                <field name="date_close" />
                <field name="exam_eligible_announce_date" />
                <field name="exam_passed_announce_date" />
                <field name="start_service_date" />
            </xpath>

            <field name="website_published" position="before">
                <field name="old_code" />
            </field>
        </field>
    </record>

    <record id="view_hr_job_tree" model="ir.ui.view">
        <field name="name">hr.job.tree (role)</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_tree" />
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="role" optional="show" />
                <field name="kmitl_employee_type" optional="show" />
                <field name="date_close" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_hr_job_search" model="ir.ui.view">
        <field name="name">hr.job.search (role)</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_job_filter" />
        <field name="arch" type="xml">
            <filter name="department" position="after">
                <filter
                    string="Role"
                    name="role"
                    domain="[]"
                    context="{'group_by': 'role'}"
                />
                <filter
                    string="Employee Type"
                    name="kmitl_employee_type"
                    domain="[]"
                    context="{'group_by': 'kmitl_employee_type'}"
                />
            </filter>
        </field>
    </record>
</odoo>
