<odoo>
    <template id="application_view_tab_personal">
        <t t-set="tab" t-value="view_data['tabs']['personal']" />
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">1. ข้อมูลส่วนบุคคล (Personal Information)</t>
                </t>
                <div class="row g-3">
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ชื่อ - นามสกุล</t>
                            <t t-set="value" t-value="tab['full_name']" />
                        </t>
                    </div>
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ชื่อ - นามสกุล (ภาษาอังกฤษ)</t>
                            <t t-set="value" t-value="tab['full_name_en']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">สัญชาติ</t>
                            <t t-set="value" t-value="tab['nationality']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">เลขบัตรประชาชน</t>
                            <t t-set="value" t-value="tab['identification_id']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">วัน/เดือน/ปีเกิด</t>
                            <t t-set="value" t-value="tab['birthday']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">เพศ</t>
                            <t t-set="value" t-value="tab['gender']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">อีเมล</t>
                            <t t-set="value" t-value="tab['email']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">เบอร์โทรศัพท์</t>
                            <t t-set="value" t-value="tab['phone']" />
                        </t>
                    </div>
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">ที่อยู่ตามทะเบียนบ้าน</t>
                            <t t-set="value" t-value="tab['address_address']" />
                            <t t-set="rows">3</t>
                        </t>
                    </div>
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">ที่อยู่ปัจจุบัน</t>
                            <t t-set="value" t-value="tab['current_address']" />
                            <t t-set="rows">3</t>
                        </t>
                    </div>
                </div>
                <hr class="my-4" />
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">ผู้ติดต่อกรณีฉุกเฉิน</t>
                </t>
                <div class="row g-3">
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ชื่อผู้ติดต่อ</t>
                            <t t-set="value" t-value="tab['emergency_contact_name']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ความสัมพันธ์</t>
                            <t
                                t-set="value"
                                t-value="tab['emergency_contact_relation']"
                            />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">เบอร์โทรศัพท์</t>
                            <t t-set="value" t-value="tab['emergency_contact_phone']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">อีเมล</t>
                            <t t-set="value" t-value="tab['emergency_contact_email']" />
                        </t>
                    </div>
                </div>
                <hr class="my-4" />
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">ข้อมูลสุขภาพ</t>
                </t>
                <div class="row g-3">
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">โรคประจำตัว</t>
                            <t t-set="value" t-value="tab['congenital_disease']" />
                            <t t-set="rows">4</t>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>
    <template id="application_view_tab_education">
        <t t-set="tab" t-value="view_data['tabs']['education']" />
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">2. ประวัติการศึกษา (Education History)</t>
                    <t t-set="description">แสดงวุฒิการศึกษาที่ใช้ในการสมัครงาน</t>
                </t>
                <t t-if="tab">
                    <t t-foreach="tab" t-as="edu">
                        <div
                            t-attf-class="border rounded-12 overflow-hidden #{'mt-3' if not edu_first else ''}"
                        >
                            <div class="row g-0">
                                <div
                                    class="col-lg-3 d-flex align-items-center justify-content-center p-3 border-end"
                                >
                                    <div class="text-center">
                                        <div
                                            class="rounded-circle border border-2 border-primary text-primary d-inline-flex align-items-center justify-content-center mb-2"
                                            style="width: 36px; height: 36px; font-weight: bold; font-size: 1.1rem;"
                                        >
                                            <t t-esc="edu_index + 1" />
                                        </div>
                                        <h6 class="mb-0 fw-bold">
                                            <t t-esc="edu.get('level') or '-'" />
                                        </h6>
                                    </div>
                                </div>
                                <div class="col-lg-9 p-3">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_readonly_field"
                                            >
                                                <t t-set="label">หลักสูตร</t>
                                                <t
                                                    t-set="value"
                                                    t-value="edu.get('program')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-6">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_readonly_field"
                                            >
                                                <t t-set="label">สาขา/วิชาเอก</t>
                                                <t
                                                    t-set="value"
                                                    t-value="edu.get('major')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-4">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_readonly_field"
                                            >
                                                <t t-set="label">สถาบัน/มหาวิทยาลัย</t>
                                                <t
                                                    t-set="value"
                                                    t-value="edu.get('institution')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-4">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_readonly_field"
                                            >
                                                <t t-set="label">ประเทศ</t>
                                                <t
                                                    t-set="value"
                                                    t-value="edu.get('country')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-4">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_readonly_field"
                                            >
                                                <t t-set="label">ปีที่เริ่มศึกษา</t>
                                                <t
                                                    t-set="value"
                                                    t-value="edu.get('start_year')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-4">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_readonly_field"
                                            >
                                                <t t-set="label">ปีที่สำเร็จการศึกษา</t>
                                                <t
                                                    t-set="value"
                                                    t-value="edu.get('graduate_year')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-6">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_document_item"
                                            >
                                                <t
                                                    t-set="label"
                                                >ใบรับรอง (Certificate)</t>
                                                <t
                                                    t-set="filename"
                                                    t-value="edu.get('certificate_filename')"
                                                />
                                                <t
                                                    t-set="download_url"
                                                    t-value="edu.get('certificate_url')"
                                                />
                                            </t>
                                        </div>
                                        <div class="col-md-6">
                                            <t
                                                t-call="hr_recruitment_kmitl.application_document_item"
                                            >
                                                <t
                                                    t-set="label"
                                                >ผลการเรียนรายวิชา (Transcript)</t>
                                                <t
                                                    t-set="filename"
                                                    t-value="edu.get('transcript_filename')"
                                                />
                                                <t
                                                    t-set="download_url"
                                                    t-value="edu.get('transcript_url')"
                                                />
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="text-secondary">
                        ไม่มีข้อมูลการศึกษา
                    </div>
                </t>
            </div>
        </div>
    </template>
    <template id="application_view_tab_work_history">
        <t t-set="tab" t-value="view_data['tabs']['work_history']" />
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">3. ประสบการณ์ทำงาน (Work Experience)</t>
                    <t t-set="description">ประสบการณ์ทำงานที่ใช้ในใบสมัครนี้</t>
                </t>
                <t t-if="tab">
                    <t t-foreach="tab" t-as="work" t-foreach-index="idx">
                        <div
                            t-attf-class="border rounded-3 p-3 #{'' if idx == 0 else 'mt-3'}"
                        >
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <t
                                        t-call="hr_recruitment_kmitl.application_readonly_field"
                                    >
                                        <t t-set="label">บริษัท/หน่วยงาน</t>
                                        <t
                                            t-set="value"
                                            t-value="work.get('company_name')"
                                        />
                                    </t>
                                </div>
                                <div class="col-md-6">
                                    <t
                                        t-call="hr_recruitment_kmitl.application_readonly_field"
                                    >
                                        <t t-set="label">ตำแหน่งงาน</t>
                                        <t
                                            t-set="value"
                                            t-value="work.get('job_title')"
                                        />
                                    </t>
                                </div>
                                <div class="col-md-4">
                                    <t
                                        t-call="hr_recruitment_kmitl.application_readonly_field"
                                    >
                                        <t t-set="label">วันที่เริ่มงาน</t>
                                        <t
                                            t-set="value"
                                            t-value="work.get('date_start')"
                                        />
                                    </t>
                                </div>
                                <div class="col-md-4">
                                    <t
                                        t-call="hr_recruitment_kmitl.application_readonly_field"
                                    >
                                        <t t-set="label">วันที่สิ้นสุดงาน</t>
                                        <t
                                            t-set="value"
                                            t-value="work.get('date_end')"
                                        />
                                    </t>
                                </div>
                                <div class="col-md-4">
                                    <t
                                        t-call="hr_recruitment_kmitl.application_readonly_field"
                                    >
                                        <t t-set="label">เงินเดือน</t>
                                        <t t-set="value" t-value="work.get('salary')" />
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="text-secondary">
                        ไม่มีข้อมูลประสบการณ์ทำงาน
                    </div>
                </t>
            </div>
        </div>
    </template>
    <template id="application_view_tab_academic">
        <t t-set="tab" t-value="view_data['tabs']['academic']" />
        <div
            class="card shadow-sm border-0 rounded-4"
            t-if="tab['job_role'] == 'academic'"
        >
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">4. ข้อมูลทางวิชาการและราชการ</t>
                    <t t-set="description">ข้อมูลทางวิชาการที่ใช้ในใบสมัครนี้</t>
                </t>
                <h6 class="fw-bold text-dark mb-4">ตำแหน่งทางวิชาการ</h6>
                <div class="row g-4">
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ตำแหน่งทางวิชาการ</t>
                            <t t-set="value" t-value="tab['academic_standing_id']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">สถาบันที่ได้รับแต่งตั้ง</t>
                            <t
                                t-set="value"
                                t-value="tab['academic_position_institution']"
                            />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">วันที่ได้รับแต่งตั้ง</t>
                            <t t-set="value" t-value="tab['academic_position_date']" />
                        </t>
                    </div>
                </div>
                <div class="mt-3">
                    <t t-call="hr_recruitment_kmitl.application_document_item">
                        <t
                            t-set="label"
                        >หลักฐานตำแหน่งทางวิชาการ (Academic Position Proof)</t>
                        <t
                            t-set="filename"
                            t-value="tab['academic_position_file']['filename']"
                        />
                        <t
                            t-set="download_url"
                            t-value="tab['academic_position_file']['download_url']"
                        />
                    </t>
                </div>
            </div>
        </div>
        <div
            class="card shadow-sm border-0 rounded-4 mt-3"
            t-if="tab['job_role'] == 'support'"
        >
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">4. การสอบ ก.พ. (OCSC Exam)</t>
                    <t t-set="description">ผลการสอบที่ใช้ในใบสมัครนี้</t>
                </t>
                <div class="row g-4">
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">สถานะการสอบ ก.พ.</t>
                            <t t-set="value" t-value="tab['has_ocsc_exam']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ระดับการสอบ</t>
                            <t t-set="value" t-value="tab['ocsc_exam_level']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">วันที่สอบผ่าน</t>
                            <t t-set="value" t-value="tab['ocsc_exam_date']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">เลขที่ใบรับรอง</t>
                            <t t-set="value" t-value="tab['ocsc_exam_number']" />
                        </t>
                    </div>
                </div>
                <div class="mt-3">
                    <t t-call="hr_recruitment_kmitl.application_document_item">
                        <t t-set="label">หลักฐานการสอบ ก.พ. (OCSC Exam Proof)</t>
                        <t
                            t-set="filename"
                            t-value="tab['ocsc_exam_file']['filename']"
                        />
                        <t
                            t-set="download_url"
                            t-value="tab['ocsc_exam_file']['download_url']"
                        />
                    </t>
                </div>
            </div>
        </div>
        <div
            class="card shadow-sm border-0 rounded-4 mt-3"
            t-if="tab['job_role'] == 'academic'"
        >
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">ผลสอบภาษาอังกฤษ (English Test Result)</t>
                </t>
                <div class="row g-4">
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">ประเภทการสอบ (Test Type)</t>
                            <t t-set="value" t-value="tab['english_test_type']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">คะแนน (Score)</t>
                            <t t-set="value" t-value="tab['english_test_score']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">วันที่สอบ (Test Date)</t>
                            <t t-set="value" t-value="tab['english_test_date']" />
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="hr_recruitment_kmitl.application_readonly_field">
                            <t t-set="label">เลขที่ใบรับรอง (Certificate Number)</t>
                            <t
                                t-set="value"
                                t-value="tab['english_test_certificate_number']"
                            />
                        </t>
                    </div>
                </div>
                <div class="mt-3">
                    <t t-call="hr_recruitment_kmitl.application_document_item">
                        <t
                            t-set="label"
                        >ไฟล์แนบผลสอบภาษาอังกฤษ (English Test Result Attachment)</t>
                        <t
                            t-set="filename"
                            t-value="tab['english_score_file']['filename']"
                        />
                        <t
                            t-set="download_url"
                            t-value="tab['english_score_file']['download_url']"
                        />
                    </t>
                </div>
            </div>
        </div>
    </template>
    <template id="application_view_tab_skills">
        <t t-set="tab" t-value="view_data['tabs']['skills']" />
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <t t-call="hr_recruitment_kmitl.application_tab_intro">
                    <t t-set="title">5. ความสามารถพิเศษ (Skills &amp; Interests)</t>
                    <t t-set="description">ทักษะและความสามารถเพิ่มเติมของผู้สมัคร</t>
                </t>
                <div class="row g-4">
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">ทักษะภาษาต่างประเทศ</t>
                            <t t-set="value" t-value="tab['foreign_language_skills']" />
                            <t t-set="rows">3</t>
                        </t>
                    </div>
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">ทักษะทางคอมพิวเตอร์</t>
                            <t t-set="value" t-value="tab['computer_skills']" />
                            <t t-set="rows">3</t>
                        </t>
                    </div>
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">ความสามารถพิเศษอื่น ๆ</t>
                            <t t-set="value" t-value="tab['other_abilities']" />
                            <t t-set="rows">3</t>
                        </t>
                    </div>
                    <div class="col-12">
                        <t t-call="hr_recruitment_kmitl.application_readonly_textarea">
                            <t t-set="label">ความสนใจ</t>
                            <t t-set="value" t-value="tab['interests']" />
                            <t t-set="rows">3</t>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>
    <template id="application_view_tab_documents">
        <t t-set="tab" t-value="view_data['tabs']['documents']" />
        <t t-if="tab">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <t t-call="hr_recruitment_kmitl.application_tab_intro">
                        <t t-set="title">6. เอกสารประกอบ (Supporting Documents)</t>
                        <t t-set="description">เอกสารที่ใช้ประกอบการสมัครงาน</t>
                    </t>
                    <div class="d-flex flex-column gap-3">
                        <t t-foreach="tab" t-as="doc">
                            <t t-call="hr_recruitment_kmitl.application_document_item">
                                <t t-set="label" t-value="doc.get('label')" />
                                <t t-set="filename" t-value="doc.get('filename')" />
                                <t t-set="status" t-value="doc.get('status')" />
                                <t
                                    t-set="download_url"
                                    t-value="doc.get('download_url')"
                                />
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5 text-secondary">
                    <t t-call="hr_recruitment_kmitl.application_tab_intro">
                        <t t-set="title">6. เอกสารประกอบ (Supporting Documents)</t>
                        <t t-set="description">เอกสารที่ใช้ประกอบการสมัครงาน</t>
                    </t>
                    ไม่มีข้อมูลเอกสารประกอบ
                </div>
            </div>
        </t>
    </template>
