<odoo>
    <template id="application_tab_intro">
        <div class="mb-4">
            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-1">
                <span class="section-indicator bg-primary"></span>
                <t t-esc="title" />
            </h5>
            <p t-if="description" class="text-secondary small ms-4 mb-0">
                <t t-esc="description" />
            </p>
        </div>
    </template>
    <template id="application_readonly_field">
        <label class="form-label fw-semibold text-dark">
            <t t-esc="label"/>
        </label>
        <input type="text"
               class="form-control text-muted border-0 py-2"
               t-att-value="value or '-'"
               readonly="readonly"/>
    </template>
    <template id="application_readonly_textarea">
        <label class="form-label fw-semibold text-dark">
            <t t-esc="label"/>
        </label>
        <textarea class="form-control text-muted border-0 py-2"
                  t-att-rows="rows or 4"
                  readonly="readonly">
            <t t-esc="value or '-'"/>
        </textarea>
    </template>
    <template id="application_status_badge">
        <span t-attf-class="badge text-bg-#{badge_class or 'primary'} px-3 py-2 rounded-pill fw-semibold">
            <t t-esc="label or '-'"/>
        </span>
    </template>
    <template id="application_document_item">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 p-3 border rounded-3 bg-white">
            <div>
                <div class="fw-semibold text-dark small">
                    <t t-esc="label"/>
                </div>
                <div class="text-secondary small">
                    <t t-esc="filename or '-'"/>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span t-if="status" class="badge text-bg-secondary rounded-pill px-3 py-2">
                    <t t-esc="status"/>
                </span>
                <a t-if="download_url"
                   t-att-href="download_url"
                   class="btn btn-outline-primary btn-sm">
                    Download
                </a>
                <span t-elif="not status" class="badge text-bg-secondary rounded-pill px-3 py-2">
                    No file
                </span>
            </div>
        </div>
    </template>
</odoo>