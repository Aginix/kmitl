<odoo>
    <template id="application_status_badge">
        <t t-if="app.application_status == 'hired'">
            <span class="badge bg-success px-3 py-2 rounded-pill">
                รายงานตัว
            </span>
        </t>
        <t t-elif="app.application_status == 'refused'">
            <span class="badge bg-danger px-3 py-2 rounded-pill">
                ไม่ผ่านคัดเลือก
            </span>
        </t>
        <t t-else="">
            <span class="badge bg-primary px-3 py-2 rounded-pill">
                <t t-esc="app.stage_id.name or 'อยู่ระหว่างดำเนินการ'" />
            </span>
        </t>
    </template>
</odoo>