<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home Entry -->
    <template id="portal_my_home_onboarding" name="Portal My Home: Onboarding" inherit_id="portal.portal_my_home"
        priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Onboarding</t>
                <t t-set="url" t-value="'/my/onboarding'" />
                <t t-set="placeholder_count" t-value="'onboarding_count'" />
            </t>
        </xpath>
    </template>
    <!-- Onboarding List Page -->
    <template id="portal_my_onboarding_list" name="My Onboarding List">
        <t t-call="website.layout">
            <div id="wrap" class="pb-5">
                <div class="py-5 overflow-hidden position-relative text-white bg-thai-d-dark">
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-pattern-dots opacity-25" />
                    <div class="container position-relative z-1 py-4">
                        <h1 class="display-5 fw-bold mb-2">รายงานตัวเข้าปฏิบัติงาน</h1>
                        <p class="lead text-white-50 mb-0">
                            กระบวนการจัดทำประวัติพนักงานใหม่สำหรับผู้ผ่านการคัดเลือก
                        </p>
                    </div>
                </div>
                <div class="container mt-5">
                    <div class="card shadow-sm border-0 rounded-4 p-4">
                        <!-- Header -->
                        <div class="d-flex align-items-start mb-4">
                            <div class="bg-primary-light rounded-3 p-2 me-3">
                                <i class="fa fa-file-text-o text-primary fs-4"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-1">รายงานตัวเข้าปฏิบัติงาน</h4>
                                <p class="text-secondary small mb-0">
                                    คุณมีตำแหน่งที่ผ่านการคัดเลือกและต้องรายงานตัว กรุณาเลือกรายการด้านล่าง
                                </p>
                            </div>
                        </div>
                        <!-- Pending Section -->
                        <section class="mb-5">
                            <h6 class="text-primary fw-bold d-flex align-items-center mb-3">
                                <i class="fa fa-clock-o me-2"></i>
                                สิ่งที่ต้องดำเนินการ (รอรายงานตัว)
                            </h6>
                            <div class="card border-primary-light rounded-4 mb-3 hover-shadow-sm transition-base">
                                <div class="card-body p-4">
                                    <div class="row align-items-center g-3">
                                        <div class="col-auto">
                                            <div class="rounded-circle bg-primary-light text-primary fw-bold d-flex align-items-center justify-content-center"
                                                style="width: 40px; height: 40px;">
                                                1
                                            </div>
                                        </div>
                                        <div class="col">
                                            <h5 class="fw-bold text-dark mb-1">
                                                เจ้าหน้าที่บริหารงานทั่วไป (ปฏิบัติงานประจำ งานการเงินและบัญชี)
                                            </h5>
                                            <div class="text-secondary small">
                                                <i class="fa fa-building-o me-1"></i>
                                                คณะวิศวกรรมศาสตร์
                                            </div>
                                            <div class="text-primary small mt-1">
                                                <i class="fa fa-calendar-check-o me-1"></i>
                                                ผ่านการคัดเลือกเมื่อ: 20 ก.พ. 2569
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-auto">
                                            <a href="/my/onboarding/form/1"
                                                class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                                                ทำรายการรายงานตัว
                                                <i class="fa fa-chevron-right ms-2"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- Completed Section -->
                        <section>
                            <h6 class="text-success fw-bold d-flex align-items-center mb-3">
                                <i class="fa fa-check-square-o me-2"></i>
                                ประวัติการรายงานตัว (เสร็จสิ้น)
                            </h6>
                            <div class="card border-light bg-light-subtle rounded-4 mb-3 opacity-75">
                                <div class="card-body p-4">
                                    <div class="row align-items-center g-3">
                                        <div class="col-auto">
                                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center"
                                                style="width: 40px; height: 40px;">
                                                <i class="fa fa-check"></i>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <h5 class="fw-bold text-dark mb-1">
                                                เจ้าหน้าที่บริหารงานทั่วไป (ปฏิบัติงานประจำ งานการเงินและบัญชี)
                                            </h5>
                                            <div class="text-secondary small">
                                                <i class="fa fa-building-o me-1"></i>
                                                คณะวิศวกรรมศาสตร์
                                            </div>
                                            <div class="text-secondary small mt-1">
                                                <i class="fa fa-send-o me-1"></i>
                                                ข้อมูลถูกส่งเข้า HRIS แล้วเมื่อ: 22 ก.พ. 2569
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-auto">
                                            <a href="/my/onboarding/1"
                                                class="btn btn-light border rounded-pill px-4 fw-bold text-secondary">
                                                <i class="fa fa-eye me-2"></i>
                                                ดูข้อมูล
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <!-- Onboarding Detail Page -->
    <template id="portal_my_onboarding_detail" name="My Onboarding Detail">
        <t t-call="website.layout">
            <div id="wrap" class="pb-5">
                <nav class="container py-3">
                    <div class="d-flex align-items-center small text-secondary">
                        <a href="/my/onboarding" class="text-secondary text-decoration-none">
                            <i class="fa fa-chevron-left me-1" style="font-size: 0.7rem;"></i>
                            รายการรายงานตัว
                        </a>
                        <span class="mx-2">/</span>
                        <span class="fw-bold text-dark">
                            เจ้าหน้าที่บริหารงานทั่วไป
                        </span>
                    </div>
                </nav>
                <div class="container py-4">
                    <!-- Summary -->
                    <div class="card shadow-sm border-0 rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                <div>
                                    <h4 class="fw-bold text-dark mb-2">
                                        เจ้าหน้าที่บริหารงานทั่วไป (ปฏิบัติงานประจำ งานการเงินและบัญชี)
                                    </h4>
                                    <div class="text-secondary mb-1">
                                        <i class="fa fa-building-o me-1"></i>
                                        คณะวิศวกรรมศาสตร์
                                    </div>
                                    <div class="text-secondary small">
                                        <i class="fa fa-calendar-check-o me-1"></i>
                                        วันที่ผ่านการคัดเลือก: 20 ก.พ. 2569
                                    </div>
                                </div>
                                <div>
                                    <span class="badge rounded-pill text-bg-primary px-3 py-2">
                                        รอรายงานตัว
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Detail -->
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <h6 class="fw-bold text-dark mb-3">รายละเอียด</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="text-secondary small">ตำแหน่ง</div>
                                    <div class="fw-bold text-dark">
                                        เจ้าหน้าที่บริหารงานทั่วไป (ปฏิบัติงานประจำ งานการเงินและบัญชี)
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-secondary small">หน่วยงาน</div>
                                    <div class="fw-bold text-dark">คณะวิศวกรรมศาสตร์</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-secondary small">สถานะรายงานตัว</div>
                                    <div class="fw-bold text-dark">รอรายงานตัว</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-secondary small">วันที่เริ่มปฏิบัติงาน</div>
                                    <div class="fw-bold text-dark">1 มี.ค. 2569</div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <a href="/my/onboarding/form/1" class="btn btn-primary rounded-pill px-4">
                                    ทำรายการรายงานตัว
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <!-- Onboarding Form Page -->
    <template id="portal_my_onboarding_form" name="My Onboarding Form">
        <t t-call="website.layout">
            <div id="wrap" class="pb-5">
                <nav class="container py-3">
                    <div class="d-flex align-items-center small text-secondary">
                        <a href="/my/onboarding" class="text-secondary text-decoration-none">
                            <i class="fa fa-chevron-left me-1" style="font-size: 0.7rem;"></i>
                            รายการรายงานตัว
                        </a>
                        <span class="mx-2">/</span>
                        <span class="fw-bold text-dark">ฟอร์มรายงานตัว</span>
                    </div>
                </nav>
                <div class="container py-4">
                    <!-- Header -->
                    <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                        <div class="card-body p-4 position-relative">
                            <div class="position-absolute start-0 top-0 bottom-0 bg-primary" style="width: 6px;"></div>
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                <div>
                                    <div class="text-primary small fw-bold mb-2">
                                        ตำแหน่งที่กำลังรายงานตัว
                                    </div>
                                    <h4 class="fw-bold text-dark mb-2">
                                        เจ้าหน้าที่บริหารงานทั่วไป (ปฏิบัติงานประจำ งานการเงินและบัญชี)
                                    </h4>
                                    <div class="text-secondary mb-1">
                                        <i class="fa fa-building-o me-1"></i>
                                        <span>คณะครุศาสตร์อุตสาหกรรมและเทคโนโลยี</span>
                                    </div>
                                </div>
                                <div class="d-flex flex-column align-items-start align-items-md-end gap-2">
                                    <span class="badge rounded-pill text-bg-primary px-3 py-2">
                                        รอรายงานตัว
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <form action="#" method="post" enctype="multipart/form-data">
                        <!-- Tabs Navigation -->
                        <nav class="nav nav-pills wizard-tabs nav-fill bg-secondary-light p-1 rounded-4 flex-column flex-lg-row gap-1 mb-4"
                            id="form-tabs" role="tablist">

                            <a class="nav-link active text-nowrap rounded-4 px-3 py-2 d-flex justify-content-center align-items-center gap-2"
                                href="#nav-personal" data-bs-toggle="tab">
                                <i class="fa fa-user"></i>
                                <span>ข้อมูลส่วนบุคคล</span>
                            </a>

                            <a class="nav-link text-nowrap rounded-4 px-3 py-2 d-flex justify-content-center align-items-center gap-2"
                                href="#nav-education" data-bs-toggle="tab">
                                <i class="fa fa-graduation-cap"></i>
                                <span>การศึกษา</span>
                            </a>

                            <a class="nav-link text-nowrap rounded-4 px-3 py-2 d-flex justify-content-center align-items-center gap-2"
                                href="#nav-decoration" data-bs-toggle="tab">
                                <i class="fa fa-certificate"></i>
                                <span>เครื่องราชอิสริยาภรณ์</span>
                            </a>

                            <a class="nav-link text-nowrap rounded-4 px-3 py-2 d-flex justify-content-center align-items-center gap-2"
                                href="#nav-work" data-bs-toggle="tab">
                                <i class="fa fa-briefcase"></i>
                                <span>ข้อมูลการปฏิบัติงาน</span>
                            </a>

                            <a class="nav-link text-nowrap rounded-4 px-3 py-2 d-flex justify-content-center align-items-center gap-2"
                                href="#nav-benefit" data-bs-toggle="tab">
                                <i class="fa fa-money"></i>
                                <span>สวัสดิการและกองทุน</span>
                            </a>

                            <a class="nav-link text-nowrap rounded-4 px-3 py-2 d-flex justify-content-center align-items-center gap-2"
                                href="#nav-confirm" data-bs-toggle="tab">
                                <i class="fa fa-check-square-o"></i>
                                <span>ตรวจสอบประวัติและยืนยันตัวตน</span>
                            </a>
                        </nav>
                        <!-- Tabs Content -->
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-personal" role="tabpanel"
                                aria-labelledby="tab-personal-tab">
                                <t t-call="hr_recruitment_kmitl.onboarding_tab_personal" />
                            </div>
                            <div class="tab-pane fade" id="nav-education" role="tabpanel"
                                aria-labelledby="tab-education-tab">
                                <t t-call="hr_recruitment_kmitl.onboarding_tab_education" />
                            </div>
                            <div class="tab-pane fade" id="nav-decoration" role="tabpanel"
                                aria-labelledby="tab-decoration-tab">
                                <t t-call="hr_recruitment_kmitl.onboarding_tab_decoration" />
                            </div>
                            <div class="tab-pane fade" id="nav-work" role="tabpanel" aria-labelledby="tab-work-tab">
                                <t t-call="hr_recruitment_kmitl.onboarding_tab_work" />
                            </div>
                            <div class="tab-pane fade" id="nav-benefit" role="tabpanel"
                                aria-labelledby="tab-benefit-tab">
                                <t t-call="hr_recruitment_kmitl.onboarding_tab_benefit" />
                            </div>
                            <div class="tab-pane fade" id="nav-confirm" role="tabpanel"
                                aria-labelledby="tab-confirm-tab">
                                <t t-call="hr_recruitment_kmitl.onboarding_tab_confirm" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>