<!-- data/website_data.xml -->
<odoo>
    <data noupdate="1">
        <record id="job_website" model="website">
            <field name="name">KMITL Job Website</field>
            <field name="sequence">20</field>
            <field name="user_id" ref="base.public_user" />
            <field name="theme_id" ref="base.module_theme_kmitl" />
            <field name="auth_signup_uninvited">b2c</field>
            <field name="homepage_url">/jobs</field>
            <field
                name="logo"
                type="base64"
                file="hr_recruitment_kmitl/static/src/img/kmitl_job_logo.png"
            />
        </record>

        <record model="hr.recruitment.degree" id="degree_under_bachelor">
            <field name="name">Below Bachelor's Degree</field>
            <field name="sequence">0</field>
        </record>

    </data>

    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>hr.applicant</value>
        <value
            eval="[
            'exam_fee_file',
            'exam_fee_filename',
            'medical_certificate_file',
            'medical_certificate_filename',
        ]"
        />
    </function>

    <record id="ir_cron_close_expired_jobs" model="ir.cron">
        <field name="name">Close Expired Job Postings</field>
        <field name="model_id" ref="hr.model_hr_job" />
        <field name="state">code</field>
        <field name="code">model._cron_close_expired_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
