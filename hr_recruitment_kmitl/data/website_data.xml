<!-- data/website_data.xml -->
<odoo>

    <data noupdate="1">
        <record id="hr_recruitment_kmitl.website_hr_career" model="website">
            <field name="name">HR Career</field>
            <!-- ระบุไม่ได้ เพราะจะถูกบังคับ redirect เข้า domain -->
            <field name="domain" />
            <field name="sequence">20</field>
            <field
                name="logo"
                type="base64"
                file="hr_recruitment_kmitl/static/src/img/kmitl_careers_logo.png"
            />
        </record>

        <record id="page_jobs" model="website.menu">
            <field name="name">Jobs</field>
            <field name="url">/jobs</field>
            <field name="website_id" ref="hr_recruitment_kmitl.website_hr_career" />
            <field name="sequence">20</field>
        </record>

        <record model="hr.recruitment.degree" id="degree_under_bachelor">
            <field name="name">Below Bachelor's Degree</field>
            <field name="sequence">0</field>
        </record>

    </data>

    <record id="ir_cron_close_expired_jobs" model="ir.cron">
        <field name="name">Close Expired Job Postings</field>
        <field name="model_id" ref="hr.model_hr_job" />
        <field name="state">code</field>
        <field name="code">model._cron_close_expired_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
