<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Move Request Form View with Budget Integration -->
    <record id="view_account_move_request_form_budget" model="ir.ui.view">
        <field name="name">account.move.request.form.budget</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="inside">
                <field name="budget_commitment_id" required="1" />
                <field name="source_analytic_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                <field name="department_analytic_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                <field name="fund_analytic_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                <field name="activity_analytic_id" readonly="1" options="{'no_create': True, 'no_open': True}" />
                <field name="budget_account_id" readonly="1" required="1" options="{'no_create': True, 'no_open': True}" />
                <field name="budget_account_id" invisible="1" />
                <field name="analytic_distribution" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_request_tree_budget" model="ir.ui.view">
        <field name="name">account.move.request.tree.budget</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="budget_commitment_id" optional="hide" />
                <field name="source_analytic_id" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_account_move_request_search_budget" model="ir.ui.view">
        <field name="name">account.move.request.search.budget</field>
        <field name="model">account.move.request</field>
        <field name="inherit_id" ref="account_move_request.view_account_move_request_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="source_analytic_id" domain="[('root_plan_id.code', '=', 'sources')]" />
            </field>
        </field>
    </record>
</odoo>
