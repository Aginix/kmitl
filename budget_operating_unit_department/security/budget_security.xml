<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- A transfer is one budget.move stamped with its author's unit, yet it
         moves money onto another unit's department (budget ADR-0011
         amendment): a transfer line is also visible — and counted by the
         availability engine and the dashboard — for the unit its own
         department dimension is tagged with, so the receiving unit sees the
         budget it was sent.

         Rewrites the domain budget_operating_unit_access_all writes (this
         module depends on it, so it loads — and re-applies on every upgrade
         of either — last). Keep the leading clauses in sync with it and with
         hooks.ACCESS_ALL_MOVE_LINE_DOMAIN. -->
    <function model="ir.rule" name="write">
        <value
            eval="[ref('budget_operating_unit.ir_rule_budget_move_line_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|','|','|',(1, '=', 1) if user.has_group('budget_operating_unit_access_all.group_all_ou_budget') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids),('commitment_id.beneficiary_operating_unit_id','in', user.operating_unit_ids.ids),'&amp;',('transfer_direction','!=',False),('department_analytic_id.operating_unit_ids','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>

</odoo>
