<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- สร้างไฟล์ PDF ใหม่ (ADR-0019) — in the form's Action (⚙) menu. Sarabun Manager
         only, which also covers the Sarabun Route Editor (it implies Manager). The menu
         cannot hide by state, so the method refuses a หนังสือ that is not completed. -->
    <record id="action_sarabun_document_regenerate_signed_pdf" model="ir.actions.server">
        <field name="name">สร้างไฟล์ PDF ใหม่</field>
        <field name="model_id" ref="agx_sarabun.model_sarabun_document" />
        <field name="binding_model_id" ref="agx_sarabun.model_sarabun_document" />
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('agx_sarabun.group_sarabun_manager'))]" />
        <field name="state">code</field>
        <field name="code">action = records.action_regenerate_signed_pdf()</field>
    </record>
</odoo>
