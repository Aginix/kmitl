<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_change_wizard_form" model="ir.ui.view">
        <field name="name"
            >view.purchase.order.change.wizard.form(Change Invoice Plan)</field
        >
        <field name="model">purchase.order.change.wizard</field>
        <field
            name="inherit_id"
            ref="purchase_order_change.view_purchase_order_change_wizard"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='field_groups']" position="inside">
                <group name="old_invoice_group">
                    <field name="show_invoice" invisible="1" />
                    <field
                        name="invoice_plan_ids_old"
                        attrs="{'invisible': [('show_invoice', '=', False)]}"
                    />
                </group>
                <group name="new_invoice_group">
                    <field
                        name="invoice_plan_ids"
                        attrs="{'invisible': [('show_invoice', '=', False)]}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
