<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View budget.template form -->
    <record id="view_budget_template_form_inherit" model="ir.ui.view">
        <field name="name">view.budget.template.form</field>
        <field name="model">budget.template</field>
        <field name="inherit_id" ref="budget.view_budget_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="replace">
                <field name="line_ids" widget='budget_template_line_custom' style="max-width: 100%; display: block;">
                    <tree limit="2000">
                        <field name="code"/>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="budget_type" invisible="1"/>
                        <field name="fund_analytic_ids" widget="many2many_tags"/>
                        <field name="budgetable"/>
                        <field name="procurement_plan" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

  </odoo>
