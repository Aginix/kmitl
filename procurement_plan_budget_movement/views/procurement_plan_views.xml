<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_procurement_plan_form" model="ir.ui.view">
        <field name="name">procurement.plan.form.budget.movement</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan_budget.view_procurement_plan_form_budget" />
        <!-- Replaces the ledger button: apply after other extensions. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- One button for plan users in place of the budget-viewer-only
                 ledger button. -->
            <button name="action_open_budget_move_lines" position="replace">
                <button
                    name="action_open_budget_movements"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    attrs="{'invisible': [('analytic_account_id', '=', False)]}"
                    groups="procurement_plan.group_procurement_plan_user,budget.group_budget_viewer"
                >
                    <field
                        name="budget_movement_count"
                        widget="statinfo"
                        string="การเคลื่อนไหวงบ"
                    />
                </button>
            </button>
        </field>
    </record>
</odoo>
