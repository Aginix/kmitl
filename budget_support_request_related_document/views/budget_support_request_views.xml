<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_budget_support_request_form" model="ir.ui.view">
        <field name="name">budget.support.request.form.related.document</field>
        <field name="model">budget.support.request</field>
        <field
            name="inherit_id"
            ref="budget_support_request.view_budget_support_request_form"
        />
        <field name="arch" type="xml">
            <group name="attachments" position="after">
                <group name="related_documents" string="เอกสารอ้างอิง" colspan="4">
                    <field
                        name="related_document_ids"
                        nolabel="1"
                        colspan="2"
                        context="{'tree_view_ref': 'agx_related_document.view_related_document_embedded_tree', 'default_res_model': 'budget.support.request'}"
                        attrs="{'readonly': [('can_edit', '=', False)]}"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
