<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_appropriation_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form.ztree</field>
        <field name="model">budget.appropriation</field>
        <field
            name="inherit_id"
            ref="budget_appropriation.view_budget_appropriation_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='analytic_dimensions']/field[@name='department_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//group[@name='analytic_dimensions']/field[@name='source_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_budget_appropriation_line_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.line.form.ztree</field>
        <field name="model">budget.appropriation.line</field>
        <field
            name="inherit_id"
            ref="budget_appropriation.view_budget_appropriation_line_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//sheet//group/field[@name='activity_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//sheet//group/field[@name='fund_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//sheet//group/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//sheet//group/field[@name='deduct_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
