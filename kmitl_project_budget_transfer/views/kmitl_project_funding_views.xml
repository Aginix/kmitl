<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_funding_tree" model="ir.ui.view">
        <field name="name">kmitl.project.funding.tree</field>
        <field name="model">kmitl.project.funding</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="date" />
                <field name="name" />
                <field name="project_id" optional="hide" />
                <field name="counterpart_department_id" />
                <field name="direction" />
                <field name="account_id" optional="hide" />
                <field name="amount" sum="รวม" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'received'"
                    decoration-warning="status == 'in_progress'"
                    decoration-danger="status == 'off_target'"
                />
            </tree>
        </field>
    </record>

    <!-- Every Many2one is no_open: its comodel is a budget model the project
         user cannot read (ADR-0007). -->
    <record id="view_kmitl_project_funding_form" model="ir.ui.view">
        <field name="name">kmitl.project.funding.form</field>
        <field name="model">kmitl.project.funding</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="date" />
                            <field name="project_id" options="{'no_open': True}" />
                            <field name="status" />
                        </group>
                        <group>
                            <field
                                name="counterpart_department_id"
                                options="{'no_open': True}"
                            />
                            <field name="direction" />
                            <field name="account_id" options="{'no_open': True}" />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kmitl_project_funding_search" model="ir.ui.view">
        <field name="name">kmitl.project.funding.search</field>
        <field name="model">kmitl.project.funding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="counterpart_department_id" />
                <filter
                    string="ได้รับแล้ว"
                    name="received"
                    domain="[('status', '=', 'received')]"
                />
                <filter
                    string="อยู่ระหว่างดำเนินการ"
                    name="in_progress"
                    domain="[('status', '=', 'in_progress')]"
                />
                <filter
                    string="พิกัดไม่ตรงกับโครงการ"
                    name="off_target"
                    domain="[('status', '=', 'off_target')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="สถานะ"
                        name="group_status"
                        context="{'group_by': 'status'}"
                    />
                    <filter
                        string="ส่วนงานคู่โอน"
                        name="group_counterpart"
                        context="{'group_by': 'counterpart_department_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_kmitl_project_funding" model="ir.actions.act_window">
        <field name="name">เงินสนับสนุนที่ได้รับ</field>
        <field name="res_model">kmitl.project.funding</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>
</odoo>
