<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_kmitl_project_form" model="ir.ui.view">
        <field name="name">kmitl.project.form.budget.transfer</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_form" />
        <field name="arch" type="xml">
            <!-- Editable in every state (ADR-0008). -->
            <xpath expr="//group[@name='budget']" position="inside">
                <label for="is_supported_by_other_units" />
                <div>
                    <field name="is_supported_by_other_units" />
                    <div>
                        ติ๊กเมื่อโครงการได้รับการสนับสนุนงบประมาณจากหน่วยงานอื่น
                        — โครงการจะเปิดให้ทุกหน่วยงานมองเห็น เพื่อให้หน่วยงานผู้สนับสนุนเลือกโครงการนี้ในใบโอนงบประมาณได้
                        โดยใบโอนต้องระบุ ส่วนงาน/กิจกรรม/กองทุน ของหน่วยงานเจ้าของโครงการ
                        หากไม่ติ๊ก จะเห็นเฉพาะหน่วยงานเจ้าของโครงการ
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
