<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_transfer_form" model="ir.ui.view">
        <field name="name">budget.transfer.form.kmitl.project</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <!-- Project picker narrows to the projects matching the line's budget code / dimensions. -->
            <xpath
                expr="//field[@name='from_line_ids']//form//field[@name='kmitl_project_analytic_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id', 'in', allowed_kmitl_project_analytic_ids)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='from_line_ids']//form//field[@name='kmitl_project_analytic_id']"
                position="before"
            >
                <field name="allowed_kmitl_project_analytic_ids" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='to_line_ids']//form//field[@name='kmitl_project_analytic_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('id', 'in', allowed_kmitl_project_analytic_ids)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='to_line_ids']//form//field[@name='kmitl_project_analytic_id']"
                position="before"
            >
                <field name="allowed_kmitl_project_analytic_ids" invisible="1" />
            </xpath>
            <!-- Lines carrying this dimension; "เปิด" opens the record in a new tab. -->
            <xpath expr="//notebook/page[@name='transfer_lines']" position="after">
                <page name="kmitl_projects" string="โครงการ/กิจกรรม">
                    <field name="kmitl_project_line_ids" nolabel="1" readonly="1">
                        <tree>
                            <field
                                name="kmitl_project_analytic_id"
                                string="โครงการ/กิจกรรม"
                            />
                            <field name="department_analytic_id" />
                            <field name="transfer_direction" />
                            <field name="amount" widget="monetary" />
                            <field name="currency_id" invisible="1" />
                            <button
                                name="action_open_kmitl_project"
                                type="object"
                                string="เปิด"
                                icon="fa-external-link"
                            />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_budget_transfer_form_floating" model="ir.ui.view">
        <field name="name">budget.transfer.form.floating.allocation</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="is_floating_allocation" invisible="1" />
                <field name="is_floating_return" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="status"
                    attrs="{'invisible': [('is_floating_allocation', '=', False), ('is_floating_return', '=', False)]}"
                >
                    <i class="fa fa-bolt" />
                    <span attrs="{'invisible': [('is_floating_allocation', '=', False)]}">จัดสรรตรงจากงบลอย</span>
                    <span attrs="{'invisible': [('is_floating_return', '=', False)]}">โอนคืนงบลอย</span>
                    — ใบโอนนี้สร้างจากหน้าโครงการ <field
                        name="kmitl_project_id"
                        readonly="1"
                        class="oe_inline fw-bold"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_budget_transfer_search" model="ir.ui.view">
        <field name="name">budget.transfer.search.floating.allocation</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reason']" position="after">
                <field name="kmitl_project_id" />
            </xpath>
            <xpath expr="//filter[@name='cancelled']" position="after">
                <separator />
                <filter
                    name="floating_allocation"
                    string="จัดสรรตรงจากงบลอย"
                    domain="[('is_floating_allocation', '=', True)]"
                />
                <filter
                    name="floating_return"
                    string="โอนคืนงบลอย"
                    domain="[('is_floating_return', '=', True)]"
                />
            </xpath>
        </field>
    </record>

</odoo>
