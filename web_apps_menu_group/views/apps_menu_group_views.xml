<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_web_apps_menu_group_tree" model="ir.ui.view">
        <field name="name">web.apps.menu.group.tree</field>
        <field name="model">web.apps.menu.group</field>
        <field name="arch" type="xml">
            <tree string="Apps Menu Groups">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="view_web_apps_menu_group_form" model="ir.ui.view">
        <field name="name">web.apps.menu.group.form</field>
        <field name="model">web.apps.menu.group</field>
        <field name="arch" type="xml">
            <form string="Apps Menu Group">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_web_apps_menu_group" model="ir.actions.act_window">
        <field name="name">Apps Menu Groups</field>
        <field name="res_model">web.apps.menu.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_web_apps_menu_group"
        name="Apps Menu Groups"
        parent="base.next_id_2"
        action="action_web_apps_menu_group"
        sequence="15"
    />

</odoo>
