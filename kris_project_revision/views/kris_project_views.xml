<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View kris.project form -->
    <record id="view_kris_project_form" model="ir.ui.view">
        <field name="name">view.kris.project.form</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_draft']" position="after">
                <button
                    name="create_revision"
                    string="สร้างฉบับแก้ไข"
                    type="object"
                    attrs="{'invisible': ['|', ('current_revision_id', '!=', False), ('state', 'not in', ('in_progress', 'cancel'))]}"
                    groups="kris_project.group_kris_project_officer"
                />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="has_old_revisions" invisible="1" />
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="inside">
                <field
                    name="current_revision_id"
                    attrs="{'invisible': [('current_revision_id', '=', False)]}"
                />
            </xpath>
            <xpath expr="//div[hasclass('dialog-warning-receipt')]" position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    attrs="{'invisible': [('current_revision_id', '=', False)]}"
                >
                    เอกสารฉบับนี้เป็นสำเนาเก่าที่เก็บไว้อ้างอิง มีฉบับแก้ไขใหม่กว่าแล้ว
                </div>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_view_revisions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        attrs="{'invisible': ['|', ('has_old_revisions', '=', False), ('revision_count', '=', 0)]}"
                    >
                        <field
                            name="revision_count"
                            widget="statinfo"
                            string="ฉบับแก้ไข"
                        />
                    </button>
                </div>
                <widget
                    name="web_ribbon"
                    title="สำเนาเก่า"
                    bg_color="bg-black"
                    attrs="{'invisible': [('current_revision_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <!-- Search view: expose current_revision_id for filters/defaults -->
    <record id="view_kris_project_search" model="ir.ui.view">
        <field name="name">view.kris.project.search.revision</field>
        <field name="model">kris.project</field>
        <field name="inherit_id" ref="kris_project.view_kris_project_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_type_id']" position="after">
                <field name="current_revision_id" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
