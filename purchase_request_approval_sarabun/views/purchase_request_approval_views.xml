<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject sarabun column into the PA tree view -->
    <record id="view_purchase_request_approval_tree_sarabun" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.tree.sarabun</field>
        <field name="model">purchase.request.approval</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_approval_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="active_sarabun_document_id" string="Document Number" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inject sarabun buttons, stat button, and alert block into the PA form -->
    <record id="view_purchase_request_approval_form_sarabun" model="ir.ui.view">
        <field name="name">view.purchase.request.approval.form.sarabun</field>
        <field name="model">purchase.request.approval</field>
        <field name="inherit_id" ref="purchase_request_approval.view_purchase_request_approval_form"/>
        <field name="arch" type="xml">
            <!-- Invisible gate fields -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="sarabun_document_count" invisible="1" />
                <field name="sarabun_has_live_document" invisible="1" />
            </xpath>

            <!-- Create Sarabun button — before "Request approval" -->
            <xpath expr="//button[@name='button_to_approve']" position="before">
                <button
                    name="action_submit_to_sarabun"
                    string="Create Sarabun"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('sarabun_has_live_document', '=', True)]}"
                />
            </xpath>

            <!-- Resend to Sarabun + ตีกลับ/แก้ไข buttons — after "Request approval" -->
            <xpath expr="//button[@name='button_to_approve']" position="after">
                <button
                    name="action_resend_to_sarabun"
                    states="sarabun_returned"
                    string="Resend to Sarabun"
                    type="object"
                    class="oe_highlight"
                />
                <button
                    name="action_open_return_cancel_wizard"
                    states="draft"
                    string="ตีกลับ/แก้ไข"
                    type="object"
                    groups="purchase.group_purchase_user"
                />
            </xpath>

            <!-- Extend button_cancel to also show in sarabun_returned state -->
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="states" add="sarabun_returned" separator=","/>
            </xpath>

            <!-- Sarabun stat button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_sarabun_documents"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('sarabun_document_count', '=', 0)]}"
                    string="Sarabun Document"
                />
            </xpath>

            <!-- Sarabun status alert blocks — before the main group -->
            <xpath expr="//sheet/group[1]" position="before">
                <field name="sarabun_is_draft" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1"/>
                    หนังสือสารบรรณถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                    <button name="action_view_sarabun_documents" type="object"
                            class="btn btn-sm btn-warning ms-2" string="เปิดหนังสือเพื่อส่ง"/>
                </div>
                <div class="alert alert-info mb-2" role="alert"
                     attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1"/>
                    สถานะการเดินหนังสือสารบรรณ: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
