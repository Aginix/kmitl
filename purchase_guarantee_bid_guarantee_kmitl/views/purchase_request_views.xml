<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
              <button
                    name="action_view_purchase_guarantee"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    groups="purchase.group_purchase_user"
                    attrs="{'invisible':['&amp;', ('purchase_guarantee_count', '=', 0), ('state', 'not in', ['approved', 'in_progress'])]}"
                >
                    <field
                        name="purchase_guarantee_count"
                        widget="statinfo"
                        string="Guarantee"
                    />
                </button>
            </xpath>
        </field>
    </record>

  </odoo>
