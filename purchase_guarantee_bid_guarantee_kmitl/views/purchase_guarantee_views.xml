<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.guarantee form -->
    <record id="view_purchase_guarantee_form" model="ir.ui.view">
        <field name="name">view.purchase.guarantee.form</field>
        <field name="model">purchase.guarantee</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_guarantee.view_purchase_guarantee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <field name="is_purchase_request" invisible="1"/>
                <field name="request_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_request"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        attrs="{'invisible': ['|', ('is_purchase_request', '=', False), ('request_id', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Purchase Request</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

  </odoo>