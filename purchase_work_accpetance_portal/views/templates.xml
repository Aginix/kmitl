<odoo>
    <template id="portal_my_purchase" name="My Purchases">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <div class="container mt-4">
                <div class="container o_portal_wrap mt-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">
                                <i class="fa fa-shopping-cart"></i> Purchase Order <t t-esc="purchase.name"/>
                            </h3>
                            <span class="badge badge-light">
                                <t t-esc="purchase.state"/>
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p>
                                        <strong>Date:</strong>
                                        <t t-esc="purchase.date_order"/>
                                    </p>
                                    <p>
                                        <strong>Vendor:</strong>
                                        <t t-esc="purchase.partner_id.display_name"/>
                                    </p>
                                </div>
                                <div class="col-md-6 text-md-right">
                                    <h4 class="text-success">
              Total: <t t-esc="purchase.amount_total"/>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">Order Lines</h5>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Product</th>
                                        <th>Description</th>
                                        <th class="text-right">Qty</th>
                                        <th class="text-right">Unit Price</th>
                                        <th class="text-right">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="purchase.order_line" t-as="line">
                                        <tr>
                                            <td>
                                                <t t-esc="line.product_id.display_name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.name"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="line.product_qty"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="line.price_unit"/>
                                            </td>
                                            <td class="text-right font-weight-bold">
                                                <t t-esc="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
