<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Route editor (ADR-0018) — granted INDEPENDENTLY of the Sarabun access level,
             like the Reset admin (ADR-0011): a Sarabun Manager need not hold it. It has
             NO module category so it renders as a standalone checkbox in "Other" rather
             than joining the User/Manager level dropdown, and it implies Manager for the
             see-all + document write the edit needs. (category_id=False is explicit so
             it also clears on an in-place upgrade.) -->
        <record id="group_sarabun_route_edit" model="res.groups">
            <field name="name">Sarabun Route Editor</field>
            <field name="category_id" eval="False" />
            <field
                name="implied_ids"
                eval="[(4, ref('agx_sarabun.group_sarabun_manager'))]"
            />
        </record>
    </data>
</odoo>
