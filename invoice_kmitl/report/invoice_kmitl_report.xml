<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Official KMITL invoice (ใบแจ้งหนี้ / INVOICE).
        Like the official receipt, a fixed-format document handed to the debtor, so it
        is intentionally BILINGUAL (Thai + English on every label) and the labels are
        inline rather than translated via i18n.

        Laid out to the shape a Thai accounting department expects: issuer block with
        its tax id and head-office marker, a boxed document panel, a ruled line table
        of a fixed height, the total spelled out in words, and two signature boxes —
        ผู้จัดทำ (filled in) and ผู้รับวางบิล (the debtor signs on collection).

        `is_copy` is set by the Copy wrapper below; QWeb passes it down into t-call.
    -->
    <template id="report_invoice_kmitl_document">
        <t t-call="web.basic_layout">
            <style>
                * { font-family: 'THSarabunNew', Arial, sans-serif; }
                .page, .page p, .page span, .page div, .page td, .page th {
                    font-size: 15pt;
                    line-height: 1.25;
                }
                .kmitl-inv-box { border: 1px solid #000; padding: 4px 8px; }
                /* One table, not two floated boxes: wkhtmltopdf's WebKit does not
                   equalise flex/grid heights, but table cells in a row are equal
                   in every renderer. Same reason the header of
                   accounting_kmitl_reports' templates is a table. */
                table.kmitl-inv-head { width: 100%; border-collapse: collapse; }
                table.kmitl-inv-head td {
                    border: 1px solid #000; padding: 4px 8px; vertical-align: top;
                }
                .kmitl-inv-stamp {
                    position: absolute; top: 0; right: 0; font-size: 18pt;
                    font-weight: bold; border: 2px solid #333; padding: 1px 10px;
                    white-space: nowrap;
                }
                table.kmitl-inv-lines { width: 100%; border-collapse: collapse; }
                table.kmitl-inv-lines th, table.kmitl-inv-lines td {
                    border: 1px solid #000; padding: 2px 6px; vertical-align: top;
                }
                table.kmitl-inv-lines thead th {
                    text-align: center; font-weight: bold; background-color: #f0f0f0;
                }
                .kmitl-inv-sign { height: 54px; }
                .kmitl-inv-tick { display: inline-block; width: 11px; height: 11px;
                    border: 1px solid #000; text-align: center;
                    line-height: 11px; font-size: 9px; }
            </style>

            <div class="footer" style="text-align: right; font-size: 11pt;">
                หน้า <span class="page"/>/<span class="topage"/>
            </div>

            <div class="page">
                <t t-set="cust_branch" t-value="o._partner_branch()"/>
                <t t-set="min_rows" t-value="10"/>

                <t t-if="o.state == 'cancelled'">
                    <div style="position: absolute; top: 320px; left: 180px;
                                transform: rotate(-30deg); font-size: 96px;
                                color: red; opacity: 0.25; z-index: 1000;">
                        ยกเลิก / CANCELLED
                    </div>
                </t>

                <!-- Original / Copy -->
                <div class="kmitl-inv-stamp">
                    <t t-if="is_copy">สำเนา / Copy</t>
                    <t t-else="">ต้นฉบับ / Original</t>
                </div>

                <!-- Title -->
                <div class="text-center">
                    <img t-if="o.company_id.logo"
                         t-att-src="image_data_uri(o.company_id.logo)"
                         style="max-height: 62px;" alt="Logo"/>
                    <h3 style="margin: 4px 0 0 0;">ใบแจ้งหนี้</h3>
                    <h4 style="margin: 0 0 4px 0;">INVOICE</h4>
                </div>

                <!-- Issuer, document panel and debtor: one table, so the
                     cells of a row share a height and every rule lines up. -->
                <table class="kmitl-inv-head">
                    <tr>
                        <td style="width: 58%;">
                            <div><strong>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหาร ลาดกระบัง</strong></div>
                            <div>King Mongkut's Institute of Technology Ladkrabang</div>
                            <div>ถนนฉลองกรุง เขตลาดกระบัง กรุงเทพ 10520</div>
                            <div>Chalongkrung Road, Ladkrabang Bangkok 10520</div>
                            <div>
                                <span>เลขประจำตัวผู้เสียภาษีอากร / Tax ID</span>
                                <span t-esc="o.company_id.vat or '-'"/>
                                <span style="margin-left: 12px;">สำนักงานใหญ่</span>
                            </div>
                            <div t-if="o.company_id.phone">
                                <span>โทรศัพท์ / Tel.</span>
                                <span t-esc="o.company_id.phone"/>
                            </div>
                        </td>
                        <td>
                            <div>
                                <span>เลขที่ / No.</span>
                                <strong t-field="o.name"/>
                            </div>
                            <div>
                                <span>วันที่ / Date</span>
                                <span t-esc="o.format_date_thai_short(o.date)"/>
                            </div>
                            <div>
                                <span>ครบกำหนดชำระ / Due Date</span>
                                <span t-esc="o.format_date_thai_short(o.date_due)"/>
                            </div>
                            <div>
                                <span>ส่วนงาน / Department</span>
                                <span t-esc="o.department_analytic_id.display_name or ''"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <div>
                                <strong>ลูกหนี้ / CUSTOMER</strong>
                                <span t-esc="o.partner_id.name or ''"/>
                            </div>
                            <div>
                                <strong>ที่อยู่ / ADDRESS</strong>
                                <span t-esc="o.partner_id.contact_address.replace('\n', ' ') if o.partner_id.contact_address else ''"/>
                            </div>
                            <div>
                                <strong>เลขประจำตัวผู้เสียภาษีอากร / Tax ID</strong>
                                <span t-esc="o.partner_id.vat or '-'"/>
                                <span style="margin-left: 16px;" class="kmitl-inv-tick">
                                    <t t-if="not cust_branch">✓</t>
                                </span>
                                <span>สำนักงานใหญ่ / Head Office</span>
                                <span style="margin-left: 10px;" class="kmitl-inv-tick">
                                    <t t-if="cust_branch">✓</t>
                                </span>
                                <span>สาขาที่ / Branch</span>
                                <span t-esc="cust_branch or ''"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Lines -->
                <table class="kmitl-inv-lines" style="margin-top: 8px;">
                    <thead>
                        <tr>
                            <th style="width: 7%;">ลำดับ<br/>No.</th>
                            <th>รายการ<br/>Description</th>
                            <th style="width: 10%;">จำนวน<br/>Qty.</th>
                            <th style="width: 12%;">หน่วย<br/>Unit</th>
                            <th style="width: 16%;">ราคาต่อหน่วย<br/>Unit Price</th>
                            <th style="width: 18%;">จำนวนเงิน<br/>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td class="text-center">
                                <span t-esc="line_index + 1"/>
                            </td>
                            <td>
                                <span t-esc="line.name"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="'{:,.0f}'.format(line.quantity) if float(line.quantity).is_integer() else '{:,.2f}'.format(line.quantity)"/>
                            </td>
                            <td class="text-center">
                                <span t-esc="line.product_id.uom_id.name if line.product_id else ''"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="'{:,.2f}'.format(line.price_unit)"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="'{:,.2f}'.format(line.amount)"/>
                            </td>
                        </tr>
                        <tr t-foreach="range(max(0, min_rows - len(o.line_ids)))" t-as="filler">
                            <td class="text-center">&#160;</td>
                            <td/>
                            <td/>
                            <td/>
                            <td/>
                            <td/>
                        </tr>
                        <tr>
                            <td colspan="4" style="font-style: italic;">
                                (
                                <span t-esc="o.currency_id.with_context(lang='th_TH').amount_to_text(o.amount_total)"/>
                                /
                                <span t-esc="o.currency_id.with_context(lang='en_US').amount_to_text(o.amount_total)"/>
                                )
                            </td>
                            <td class="text-center">
                                <strong>รวมทั้งสิ้น<br/>Total</strong>
                            </td>
                            <td class="text-end">
                                <strong t-esc="'{:,.2f}'.format(o.amount_total)"/>
                            </td>
                        </tr>
                            </tbody>
                </table>

                <!-- Note -->
                <div class="row mt-2" t-if="o.note">
                    <div class="col-12">
                        <strong>หมายเหตุ / Remarks</strong>
                        <span t-esc="o.note"/>
                    </div>
                </div>

                <!-- Signatures -->
                <div class="row" style="margin-top: 28px;">
                    <div class="col-6 text-center">
                        <div class="kmitl-inv-box" style="margin-right: 12px;">
                            <div><strong>ผู้จัดทำ / Prepared by</strong></div>
                            <div class="kmitl-inv-sign"/>
                            <div>............................................</div>
                            <div t-esc="o.user_id.name or ''"/>
                            <div>
                                <span>วันที่ / Date</span>
                                <span t-esc="o.format_date_thai_short(o.date)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 text-center">
                        <div class="kmitl-inv-box" style="margin-left: 12px;">
                            <div><strong>ผู้รับวางบิล / Received by</strong></div>
                            <div class="kmitl-inv-sign"/>
                            <div>............................................</div>
                            <div>(............................................)</div>
                            <div>วันที่ / Date ............................</div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_invoice_kmitl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="is_copy" t-value="False"/>
                <t t-call="invoice_kmitl.report_invoice_kmitl_document"
                   t-lang="o.partner_id.lang or 'th_TH'"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_kmitl_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="is_copy" t-value="True"/>
                <t t-call="invoice_kmitl.report_invoice_kmitl_document"
                   t-lang="o.partner_id.lang or 'th_TH'"/>
            </t>
        </t>
    </template>
</odoo>
