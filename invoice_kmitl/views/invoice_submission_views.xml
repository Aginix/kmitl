<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_invoice_submission_tree" model="ir.ui.view">
        <field name="name">kmitl.invoice.submission.tree</field>
        <field name="model">kmitl.invoice.submission</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="department_analytic_id" optional="show"/>
                <field name="invoice_count" string="Invoice Count" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="user_id" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'accepted'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"
                       optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_invoice_submission_form" model="ir.ui.view">
        <field name="name">kmitl.invoice.submission.form</field>
        <field name="model">kmitl.invoice.submission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull_pending_invoices"
                            type="object"
                            string="Pull Pending Invoices"
                            states="draft"
                            groups="invoice_kmitl.group_invoice_kmitl_user"/>
                    <button name="action_submit"
                            type="object"
                            string="Submit to Treasury"
                            class="btn-primary"
                            states="draft"
                            groups="invoice_kmitl.group_invoice_kmitl_user"/>
                    <button name="action_accept"
                            type="object"
                            string="Accept"
                            class="btn-primary"
                            states="submitted"
                            groups="invoice_kmitl.group_invoice_kmitl_approver"/>
                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            states="submitted"
                            groups="invoice_kmitl.group_invoice_kmitl_approver"/>
                    <button name="action_done"
                            type="object"
                            string="Send to Accounting"
                            class="btn-primary"
                            states="accepted"
                            groups="invoice_kmitl.group_invoice_kmitl_approver"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            states="submitted,accepted,cancelled"
                            groups="invoice_kmitl.group_invoice_kmitl_user"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            states="done"
                            groups="invoice_kmitl.group_invoice_kmitl_manager"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            states="draft,submitted,accepted"
                            groups="invoice_kmitl.group_invoice_kmitl_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,accepted,done"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                attrs="{'invisible': [('move_count', '=', 0)]}"
                                groups="invoice_kmitl.group_invoice_kmitl_approver">
                            <field name="move_count" widget="statinfo" string="Receivable Entries"/>
                        </button>
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="department_analytic_id"
                                   options="{'no_create': True}"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="approver_id"
                                   options="{'no_create': True}"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="user_id" readonly="1"/>
                            <field name="accepted_by"
                                   attrs="{'invisible': [('state', 'not in', ('accepted', 'done'))]}"/>
                        </group>
                    </group>
                    <field name="invoice_ids" widget="many2many"
                           domain="[('state', '=', 'draft'),
                                    ('submission_id', '=', False),
                                    ('department_analytic_id', 'child_of', department_analytic_id),
                                    ('company_id', '=', company_id)]"
                           attrs="{'readonly': [('state', '!=', 'draft')]}">
                        <tree edit="false">
                            <field name="name"/>
                            <field name="date" optional="show"/>
                            <field name="date_due" optional="show"/>
                            <field name="partner_id" optional="show"/>
                            <field name="department_analytic_id" optional="show"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="state" optional="hide"/>
                        </tree>
                    </field>
                    <group string="Notes">
                        <field name="note" nolabel="1" colspan="2" placeholder="Notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_invoice_submission_search" model="ir.ui.view">
        <field name="name">kmitl.invoice.submission.search</field>
        <field name="model">kmitl.invoice.submission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_analytic_id"/>
                <field name="user_id"/>
                <field name="approver_id"/>
                <separator/>
                <filter string="My Submissions" name="my_submissions"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Accepted" name="accepted" domain="[('state', '=', 'accepted')]"/>
                <filter string="Sent to Accounting" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_analytic_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Approver" name="group_approver" context="{'group_by': 'approver_id'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-tasks" enable_counters="1"/>
                    <field name="department_analytic_id" icon="fa-building"
                           enable_counters="1"
                           groups="invoice_kmitl.group_invoice_kmitl_approver"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_invoice_submission" model="ir.actions.act_window">
        <field name="name">Invoice Submissions</field>
        <field name="res_model">kmitl.invoice.submission</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_invoice_submission_search"/>
    </record>
</odoo>
