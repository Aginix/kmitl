<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_invoice_kmitl" model="ir.module.category">
            <field name="name">Invoice KMITL</field>
            <field name="description">User groups for KMITL invoice management</field>
            <field name="sequence">16</field>
        </record>

        <!-- Tier: Viewer -> User -> Manager (each implies the one below) -->
        <record id="group_invoice_kmitl_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="module_category_invoice_kmitl"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <!-- The department officer who issues an invoice also receipts its payment,
             so the User tier carries the receipt app's User tier. -->
        <record id="group_invoice_kmitl_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_invoice_kmitl"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_invoice_kmitl_viewer'), ref('receipt_kmitl.group_receipt_kmitl_user')])]"/>
        </record>

        <!-- Submission Approver: independent checkbox (no category), implies User.
             The treasury office. Carries real accounting rights so the receivable
             entries are raised by the acting user, not sudo'd. -->
        <record id="group_invoice_kmitl_approver" model="res.groups">
            <field name="name">Submission Approver</field>
            <field name="category_id" eval="False"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_invoice_kmitl_user'), ref('account.group_account_invoice')])]"/>
        </record>

        <record id="group_invoice_kmitl_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_invoice_kmitl"/>
            <field name="implied_ids" eval="[(4, ref('group_invoice_kmitl_user')), (4, ref('group_invoice_kmitl_approver'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
