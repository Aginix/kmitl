<odoo>
    <template id="portal_account_asset" name="My Account Asset">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1" />
            <t t-set="title">รายละเอียดครุภัณฑ์</t>

            <div class="container my-4">
                <div
                    class="card shadow border-0 rounded-3"
                    style="max-width: 636px; margin: auto"
                >
                    <div class="card-body">
                        <div class="text-center border-bottom pb-3 mb-3">
                            <t t-if="asset.image">
                                <img
                                    t-att-src="image_data_uri(asset.image)"
                                    class="img-fluid rounded shadow-sm mx-auto d-block"
                                    style="max-height: 220px"
                                />
                            </t>
                            <t t-else="">
                                <div class="border rounded p-5 text-muted bg-light">
                                    ไม่มีรูปภาพ
                                </div>
                            </t>
                        </div>
                        <div class="text-center mb-2">
                            <t t-if="asset.state == 'open'">
                                <span class="badge bg-success px-3 py-2 fs-6">
                                    <span t-field="asset.state" />
                                </span>
                            </t>

                            <t t-elif="asset.state == 'close'">
                                <span class="badge bg-dark px-3 py-2 fs-6">
                                    <span t-field="asset.state" />
                                </span>
                            </t>

                            <t t-elif="asset.state == 'removed'">
                                <span class="badge bg-danger px-3 py-2 fs-6">
                                    <span t-field="asset.state" />
                                </span>
                            </t>
                        </div>

                        <div class="text-center mb-1">
                            <h4 class="fw-bold">
                                <t t-esc="asset.name or '-' " />
                            </h4>
                        </div>

                        <div class="text-center mb-3">
                            <h4 class="fw-bold" style="color: #e35205">
                                <t t-esc="asset.number or '-' " />
                            </h4>
                        </div>

                        <table class="table mt-4">
                            <tbody>
                                <tr>
                                    <td class="text-start" width="35%">
                                        หมายเลขประจำเครื่อง (S/N)
                                    </td>
                                    <th class="text-end">
                                        <t t-esc="asset.asset_model or '-'" />
                                        /
                                        <t t-esc="asset.asset_brand or '-'" />
                                    </th>
                                </tr>

                                <tr>
                                    <td class="text-start">วันที่ได้มา</td>
                                    <th class="text-end">
                                        <t t-esc="asset.date_start or '-'" />
                                    </th>
                                </tr>

                                <tr>
                                    <td class="text-start">ประเภทครุภัณฑ์</td>
                                    <th class="text-end">
                                        <t t-esc="asset.profile_id.name or '-'" />
                                    </th>
                                </tr>

                                <tr>
                                    <td class="text-start">ชื่อโครงการ</td>
                                    <th class="text-end">
                                        <t t-esc="asset.purchase_id.contract_name" />
                                    </th>
                                </tr>

                                <tr>
                                    <td class="text-start">เลขที่สัญญา</td>
                                    <th class="text-end">
                                        <t
                                            t-esc="asset.purchase_id.contract_number or '0.00'"
                                        />
                                    </th>
                                </tr>

                                <tr>
                                    <td class="text-start">ระยะเวลารับประกัน</td>
                                    <th class="text-end">
                                        <t t-esc="asset.asset_guarantee_start or '-'" />
                                        -
                                        <t t-esc="asset.asset_guarantee_end or '-'" />
                                    </th>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
