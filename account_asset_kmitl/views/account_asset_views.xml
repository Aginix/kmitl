<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field
            name="inherit_id"
            ref="l10n_th_gov_account_asset_management.account_asset_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='asset_maintenance']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- page name asset_info -->
            <xpath expr="//page[@name='asset_info']" position="replace"/>

            <xpath expr="//page[.//field[@name='account_move_line_ids']]" position="after">
                <page name="asset_info" string="Other Information">
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="asset_location_id" invisible="1" />
                            <field name="location" />
                            <field name="department_id" />
                        </group>
                        <group>
                            <field name="asset_serial_number" />
                            <label for="asset_guarantee_start" string="Guarantee" />
                            <div class="o_row">
                                <field name="asset_guarantee_start" class="oe_inline" placeholder="Start Date"/>
                                <span class="oe_inline">-</span>
                                <field name="asset_guarantee_end" class="oe_inline" placeholder="End Date"/>
                            </div>
                            <field name="asset_model" />
                            <field name="asset_brand" />
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
    <record id="view_account_asset_kmitl_form" model="ir.ui.view">
        <field name="name">view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field
            name="inherit_id"
            ref="account_asset_management.account_asset_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_portal_view"
                    type="object"
                    string="Portal"
                    class="oe_highlight"
                    icon="fa-search-plus"
                    attrs="{'invisible': [('state', '=', 'draft')]}"
                />
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="state" invisible="1"/>
                <field name="activity_analytic_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="department_analytic_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="fund_analytic_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="source_analytic_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
            </xpath>
            <xpath expr="//field[@name='group_ids']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('state', '!=', 'draft')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='days_calc']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('state', '!=', 'draft')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='prorata']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('state', '!=', 'draft')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='carry_forward_missed_depreciations']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('state', '!=', 'draft')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('state', '!=', 'draft')]}
                </attribute>
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_ou_form" model="ir.ui.view">
        <field name="name">view.account.asset.ou.form</field>
        <field name="model">account.asset</field>
        <field
            name="inherit_id"
            ref="account_asset_operating_unit.account_asset_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operating_unit_id']" position="before">
                <field name="state" invisible="1"/>
                <field name="gpsc_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="account_fiscal_year_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_account_asset_l10n_form" model="ir.ui.view">
        <field name="name">view.account.asset.l10n.form</field>
        <field name="model">account.asset</field>
        <field
            name="inherit_id"
            ref="l10n_th_account_asset_management.account_asset_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="state" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('state', '!=', 'draft')]}
                </attribute>
            </xpath>
        </field>
    </record>

    <record
        id="account_asset_management.account_asset_action"
        model="ir.actions.act_window"
    >
        <field name="name">ครุภัณฑ์/สินทรัพย์</field>
    </record>
</odoo>
