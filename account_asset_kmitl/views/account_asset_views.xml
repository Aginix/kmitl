<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View account.asset form -->
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="l10n_th_gov_account_asset_management.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='asset_location_id']" position="after">
              <field name="department_id" />
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_ou_form" model="ir.ui.view">
        <field name="name">view.account.asset.ou.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_operating_unit.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operating_unit_id']" position="before">
              <field name="gpsc_id" />
              <field name="account_fiscal_year_id" />
            </xpath>
        </field>
    </record>

  </odoo>