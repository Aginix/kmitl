<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wiz_depreciation_report_view_form" model="ir.ui.view">
        <field name="name">wiz.depreciation.report.form</field>
        <field name="model">wiz.depreciation.report</field>
        <field name="arch" type="xml">
            <form string="รายงานค่าเสื่อมราคา">
                <group>
                    <field name="profile_id" />
                    <field name="source_of_asset" />
                    <field name="department_id" />
                    <field name="account_fiscal_year_id" />
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <footer>
                    <button
                        name="action_view_report"
                        type="object"
                        string="ดูรายงาน"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wiz_depreciation_report" model="ir.actions.act_window">
        <field name="name">Depreciation Report</field>
        <field name="res_model">wiz.depreciation.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
