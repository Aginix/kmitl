<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_all_ou_work_acceptance" model="res.groups">
            <field name="name">Access all OUs' work acceptance</field>
            <field name="category_id" ref="operating_unit.module_operating_units" />
        </record>
    </data>

    <!-- "Access all Operating Units" opens this module's OUs too. -->
    <record id="operating_unit_access_all.group_all_operating_unit" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_all_ou_work_acceptance'))]" />
    </record>

    <function model="ir.rule" name="write">
        <value
            eval="[ref('purchase_work_acceptance_operating_unit.ir_rule_work_acceptance_operating_units'),
                   ref('purchase_work_acceptance_operating_unit.ir_rule_work_acceptance_line_allowed_operating_units')]"
        />
        <value
            eval="{'domain_force': &quot;['|','|',(1, '=', 1) if user.has_group('purchase_work_acceptance_operating_unit_access_all.group_all_ou_work_acceptance') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>

</odoo>
