<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_all_ou_work_acceptance" model="res.groups">
            <field name="name">Access all OUs' work acceptance</field>
            <field name="category_id" ref="operating_unit.module_operating_units" />
        </record>
    </data>

    <record id="ir_rule_work_acceptance_all_ou" model="ir.rule">
        <field name="model_id" ref="purchase_work_acceptance.model_work_acceptance" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="name">Work Acceptance All Operating Units</field>
        <field name="groups" eval="[(6, 0, [ref('group_all_ou_work_acceptance')])]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="ir_rule_work_acceptance_line_all_ou" model="ir.rule">
        <field name="model_id" ref="purchase_work_acceptance.model_work_acceptance_line" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="name">WA Lines All Operating Units</field>
        <field name="groups" eval="[(6, 0, [ref('group_all_ou_work_acceptance')])]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>
