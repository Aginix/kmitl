<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_purchase_order_change_installment_wizard"
        model="ir.ui.view"
    >
        <field name="name">purchase.order.change.wizard.form.installment</field>
        <field name="model">purchase.order.change.wizard</field>
        <field
            name="inherit_id"
            ref="purchase_order_change.view_purchase_order_change_wizard"
        />
        <field name="arch" type="xml">
            <field name="show_fines_fields" position="after">
                <field name="show_installment" invisible="1" />
                <field name="editable_installment_ids" invisible="1" />
            </field>
            <group name="new_contract_field_group" position="after">
                <group
                    name="installment_select_group"
                    colspan="2"
                    attrs="{'invisible': [('show_installment', '=', False)]}"
                >
                    <field
                        name="installment_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                </group>
                <group
                    string="งวดงาน (เดิม)"
                    name="old_installment_group"
                    attrs="{'invisible': ['|', ('show_installment', '=', False), ('installment_id', '=', False)]}"
                >
                    <field name="plan_date_old" />
                    <field name="duration_days_old" />
                    <field name="percent_old" />
                    <field name="amount_old" />
                    <field name="deliverables_old" />
                </group>
                <group
                    string="งวดงาน (ใหม่)"
                    name="new_installment_group"
                    attrs="{'invisible': ['|', ('show_installment', '=', False), ('installment_id', '=', False)]}"
                >
                    <field name="plan_date" />
                    <field name="duration_days" />
                    <field name="percent" />
                    <field name="amount" />
                    <field name="deliverables" />
                </group>
            </group>
        </field>
    </record>
</odoo>
