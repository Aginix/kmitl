<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.request form -->
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_operating_unit.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operating_unit_id']" position="attributes">
              <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

  </odoo>