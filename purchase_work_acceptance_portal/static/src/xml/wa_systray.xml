<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="purchase_work_acceptance_portal.WaSystray" owl="1">
        <Dropdown
            position="'bottom-end'"
            beforeOpen.bind="fetchData"
        >
            <t t-set-slot="toggler">
                <span class="o_wa_systray_toggle">
                    <i class="fa fa-fw fa-check-square-o" role="img" aria-label="Work Acceptance" title="ตรวจรับพัสดุ"/>
                    <t t-if="state.totalCount > 0">
                        <span class="badge" t-esc="state.totalCount"/>
                    </t>
                </span>
            </t>
            <div class="o_wa_systray_dropdown" style="min-width: 360px;">
                <div class="o_wa_systray_header d-flex align-items-center px-3 py-2 border-bottom">
                    <span class="fw-bold">ตรวจรับพัสดุ</span>
                    <t t-if="state.totalCount > 0">
                        <span class="ms-auto badge bg-primary text-white" t-esc="state.totalCount"/>
                        <button class="btn btn-sm btn-link ms-2 p-0" t-on-click="markAllRead">อ่านทั้งหมด</button>
                    </t>
                </div>
                <t t-if="state.items.length === 0">
                    <div class="text-muted text-center py-4">
                        <i class="fa fa-check-circle fa-2x mb-2 d-block"/>
                        <span>ไม่มีรายการรอตรวจรับ</span>
                    </div>
                </t>
                <t t-else="">
                    <div style="max-height: 400px; overflow-y: auto;">
                        <t t-foreach="state.items" t-as="item" t-key="item.id">
                            <div class="o_wa_systray_item px-2 py-2 border-bottom">
                                <div><a t-att-href="item.wa_url" target="_blank" t-on-click="() => markRead(item)">กรุณาตรวจรับพัสดุ</a></div>
                                <div><a t-att-href="item.order_url" target="_blank">เอกสารสัญญา</a></div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </Dropdown>
    </t>

</templates>
