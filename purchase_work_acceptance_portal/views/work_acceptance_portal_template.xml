<odoo>
    <template id="work_acceptance_portal_template" name="Purchases Portal">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <div class="container">
                <div class="container o_portal_wrap mt-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">
                               การยืนยันคณะกรรมการตรวจรับของ                                <t t-esc="committee.name"/>
                            </h3>
                            <div class="d-flex gap-2" t-if="not committee.status">
                                <!-- Accept Button -->
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#acceptModal">
        ยืนยันการอนุมัติ
                                </button>
                                <!-- Reject Button -->
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
        ปฏิเสธการอนุมัติ
                                </button>
                            </div>
                            <span class="p-2" t-if="committee.status">ท่านได้ดำเนินการแล้ว</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container mt-2">
                <div class="container o_portal_wrap mt-2">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">
                                <i class="fa fa-file"></i> การตรวจรับ                                <t t-esc="work_acceptance.name"/>
                            </h3>
                            <span class="badge badge-light">
                                <t t-esc="work_acceptance.state"/>
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td>
                                                <strong>ผู้ขาย</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.partner_id.display_name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>ผู้รับผิดชอบ</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.responsible_id.display_name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>สัญญา/ใบสั่งซื้อ/จ้าง</strong>
                                            </td>
                                            <td>
                                                <a t-att-href="work_acceptance.purchase_id.get_portal_link()">
                                                    <t t-esc="work_acceptance.purchase_id.name"/>
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td>
                                                <strong>เวลาที่สิ้นสุด</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.date_due"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>วันครบกำหนด</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.date_receive"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">รายการสินค้า</h5>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>สินค้า</th>
                                        <th>รายละเอียด</th>
                                        <th class="text-right">จำนวน</th>
                                        <th class="text-right">ราคาต่อหน่วย</th>
                                        <th class="text-right">ราคาย่อย</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="work_acceptance.wa_line_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <t t-esc="line.product_id.display_name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.name"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="line.product_qty"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="line.price_unit"/>
                                            </td>
                                            <td class="text-right font-weight-bold">
                                                <t t-esc="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- Modal Accept -->
        <div class="modal fade" id="acceptModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form t-att-action="'/wa/view/%s/accept' % committee.id" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title">เหตุผลการอนุมัติ</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="committee_id" t-att-value="committee.id"/>
                            <input type="hidden" name="access_token" t-att-value="committee.access_token"/>
                            <textarea name="comment" class="form-control" placeholder="ใส่เหตุผล"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-success">ยืนยัน</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal Reject -->
        <div class="modal fade" id="rejectModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form t-att-action="'/wa/view/%s/reject' % committee.id" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title">เหตุผลการปฏิเสธ</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="committee_id" t-att-value="committee.id"/>
                            <input type="hidden" name="access_token" t-att-value="committee.access_token"/>
                            <textarea name="comment" class="form-control" placeholder="ใส่เหตุผล"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-danger">ปฏิเสธ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>
</odoo>
