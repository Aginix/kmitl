<odoo>
    <template id="work_acceptance_portal_template" name="Purchases Portal">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <div class="container">
                <div class="container o_portal_wrap mt-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">
                               การยืนยันคณะกรรมการตรวจรับ                                <t t-esc="committee.name"/>
                            </h3>
                            <div class="d-flex gap-2">
                                <form action="/wa/view/confirm" method="post">
                                    <input type="hidden" name="committee_id" t-att-value="committee.id"/>
                                    <input type="hidden" name="access_token" t-att-value="committee.access_token"/>
                                    <button type="submit" class="btn btn-success">ยืนยันการอนุมัติ</button>
                                </form>
                                <form action="/wa/view/reject" method="post">
                                    <button type="submit" class="btn btn-danger">ปฎิเสธการอนุมัติ</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container mt-2">
                <div class="container o_portal_wrap mt-2">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">
                                <i class="fa fa-file"></i> การตรวจรับ                                <t t-esc="work_acceptance.name"/>
                            </h3>
                            <span class="badge badge-light">
                                <t t-esc="work_acceptance.state"/>
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td>
                                                <strong>ผู้ขาย</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.partner_id.display_name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>ผู้รับผิดชอบ</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.responsible_id.display_name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>ใบสั่งซื้อ</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.purchase_id.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td>
                                                <strong>เวลาที่สิ้นสุด</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.date_due"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>วันครบกำหนด</strong>
                                            </td>
                                            <td>
                                                <t t-esc="work_acceptance.date_receive"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">รายการสินค้า</h5>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>สินค้า</th>
                                        <th>รายละเอียด</th>
                                        <th class="text-right">จำนวน</th>
                                        <th class="text-right">ราคาต่อหน่วย</th>
                                        <th class="text-right">ราคาย่อย</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="work_acceptance.wa_line_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <t t-esc="line.product_id.display_name"/>
                                            </td>
                                            <td>
                                                <t t-esc="line.name"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="line.product_qty"/>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="line.price_unit"/>
                                            </td>
                                            <td class="text-right font-weight-bold">
                                                <t t-esc="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
