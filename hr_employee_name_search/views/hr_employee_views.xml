<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_view_filter_inherit" model="ir.ui.view">
        <field name="name">hr.employee.search.name.search</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', '|', ('work_email', 'ilike', self), ('name', 'ilike', self), ('academic_standing_name_search', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
