<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.request.two.submitted View Tree -->
    <record id="view_purchase_request_two_submitted_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.two.submitted.tree</field>
        <field name="model">purchase.request.two.submitted</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View purchase.request.two.submitted form -->
    <record id="view_purchase_request_two_submitted_form" model="ir.ui.view">
        <field name="name">view.purchase.request.two.submitted.form</field>
        <field name="model">purchase.request.two.submitted</field>
        <field name="arch" type="xml">
            <form string="PR2 Submitted">
                <header>
                    <button name="button_draft" type="object" string="Reset" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button name="button_approved" type="object" string="Submit" class="btn-primary" states="draft"/>
                    <button name="button_rejected" type="object" string="Rejected" states="draft"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,rejected"/>
                </header>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="department_id" />
                        <field name="request_by" />
                        <field name="payment_type_ref" string="ประเภทการจ่ายเงิน"/>
                        <field name="approval_date" />
                        <field name="approval_by" />
                        <field name="purchase_order_id" readonly="1" invisible="1"/>
                    </group>

                    <notebook>
                        <page string="Select PR2 Forms">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="pr2_form_id" widget="many2one" domain="[('payment_type', '=', payment_type_ref)]"/>
                                    <field name="vendor"/>
                                    <field name="payment_type"/>
                                    <field name="payment_type_ref" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View purchase.request.two.submitted search -->
    <record id="view_purchase_request_two_submitted_search" model="ir.ui.view">
        <field name="name">view.purchase.request.two.submitted.search</field>
        <field name="model">purchase.request.two.submitted</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action purchase.request.two.submitted -->
    <record id="action_purchase_request_two_submitted" model="ir.actions.act_window">
        <field name="name">Purchase Request Two Submitted</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.two.submitted</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Purchase Request Two Submitted.
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_request_two_submitted" name="PR2 Submitted" parent="purchase.menu_procurement_management" action="action_purchase_request_two_submitted" sequence="25"/>

</odoo>
