<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="work_center_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">work.center.assign.wizard.form</field>
        <field name="model">work.center.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1" />
                <field name="res_id" invisible="1" />
                <field name="allowed_user_ids" invisible="1" />
                <group>
                    <field
                        name="user_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                </group>
                <footer>
                    <button
                        name="action_assign"
                        string="Assign"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
