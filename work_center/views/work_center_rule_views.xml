<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="work_center_rule_view_tree" model="ir.ui.view">
        <field name="name">work.center.rule.tree</field>
        <field name="model">work.center.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="model_id" />
                <field name="work_center_id" />
                <field name="domain" />
            </tree>
        </field>
    </record>

    <record id="work_center_rule_view_form" model="ir.ui.view">
        <field name="name">work.center.rule.form</field>
        <field name="model">work.center.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="work_center_id" options="{'no_create': True}" />
                        <field name="area_model_ids" invisible="1" />
                        <field name="model_id" options="{'no_create': True}" />
                        <field name="model_name" invisible="1" />
                        <field name="sequence" />
                    </group>
                    <field
                        name="domain"
                        widget="domain"
                        options="{'model': 'model_name', 'in_dialog': True}"
                        attrs="{'invisible': [('model_name', '=', False)]}"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="work_center_rule_view_search" model="ir.ui.view">
        <field name="name">work.center.rule.search</field>
        <field name="model">work.center.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="work_center_id" />
                <field name="model_id" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_model"
                        string="Document Model"
                        context="{'group_by': 'model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="work_center_rule_action" model="ir.actions.act_window">
        <field name="name">Station Routing Rules</field>
        <field name="res_model">work.center.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_model': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a routing rule</p>
            <p>
                When a document reaches a route line with several candidate
                stations, the rules of its model are tried in order and the
                first whose condition matches picks the station.
            </p>
        </field>
    </record>

</odoo>
