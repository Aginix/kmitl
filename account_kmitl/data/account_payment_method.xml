<?xml version="1.0" encoding="utf-8"?>
<!--
    KMITL's three payment methods, in both directions. Creating a 'multi'
    method auto-adds a payment method line to every existing journal matching
    its domain; the KMITL journals are created later (post_init_hook), so
    hooks._setup_payment_method_lines adds their lines explicitly.
-->
<odoo noupdate="1">

    <record id="payment_method_transfer_out" model="account.payment.method">
        <field name="name">เงินโอน</field>
        <field name="code">kmitl_transfer</field>
        <field name="payment_type">outbound</field>
    </record>
    <record id="payment_method_transfer_in" model="account.payment.method">
        <field name="name">เงินโอน</field>
        <field name="code">kmitl_transfer</field>
        <field name="payment_type">inbound</field>
    </record>

    <record id="payment_method_cheque_out" model="account.payment.method">
        <field name="name">เช็ค</field>
        <field name="code">kmitl_cheque</field>
        <field name="payment_type">outbound</field>
    </record>
    <record id="payment_method_cheque_in" model="account.payment.method">
        <field name="name">เช็ค</field>
        <field name="code">kmitl_cheque</field>
        <field name="payment_type">inbound</field>
    </record>

    <record id="payment_method_cash_out" model="account.payment.method">
        <field name="name">เงินสด</field>
        <field name="code">kmitl_cash</field>
        <field name="payment_type">outbound</field>
    </record>
    <record id="payment_method_cash_in" model="account.payment.method">
        <field name="name">เงินสด</field>
        <field name="code">kmitl_cash</field>
        <field name="payment_type">inbound</field>
    </record>

</odoo>
