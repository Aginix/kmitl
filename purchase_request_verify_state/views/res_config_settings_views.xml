<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View res.config.settings form -->
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='purchase']" position="inside">
                <h2>Purchase Request Verification</h2>
                <div
                    class="row mt16 o_settings_container"
                    name="purchase_request_verify_state_settings"
                >
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="purchase_request_allow_verify_state_settings"
                    >
                        <div class="o_setting_left_pane">
                            <field name="purchase_request_allow_verify_state" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label
                                for="purchase_request_allow_verify_state"
                                string="Allow Purchase Request Verification"
                            />
                            <div class="text-muted">
                                Add a verification step for procurement officers before proceeding to the payment stage.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
