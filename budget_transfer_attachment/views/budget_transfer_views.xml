<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_transfer_form" model="ir.ui.view">
        <field name="name">budget.transfer.form.attachment</field>
        <field name="model">budget.transfer</field>
        <field name="inherit_id" ref="budget_transfer.view_budget_transfer_form" />
        <field name="arch" type="xml">
            <notebook position="before">
                <group name="attachments" string="เอกสารแนบ">
                    <field
                        name="attachment_ids"
                        nolabel="1"
                        colspan="2"
                        widget="many2many_binary"
                        context="{'default_res_model': 'budget.transfer'}"
                        attrs="{'readonly': [('state', 'in', ['posted', 'cancelled'])]}"
                    />
                </group>
            </notebook>
        </field>
    </record>

</odoo>
