<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Wizard Form View for Editing Impact Lines (single form with context-based visibility) -->
    <record id="view_impact_line_wizard_form" model="ir.ui.view">
        <field name="name">budget.appropriation.report.impact.wizard</field>
        <field name="model">budget.appropriation.report</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="แก้ไขรายการผลกระทบ">
                <sheet>
                    <!-- Helper field to capture context -->
                    <field name="wizard_impact_type" invisible="1"/>

                    <!-- Education -->
                    <field name="education_impact_line_ids" nolabel="1"
                           attrs="{'invisible': [('wizard_impact_type', '!=', 'education')]}"
                           context="{'default_impact_type': 'education'}">
                        <tree editable="bottom">
                            <field name="analytic_account_id"/>
                            <field name="impact_type" invisible="1"/>
                            <field name="amount" sum="รวม"/>
                        </tree>
                    </field>

                    <!-- Academic -->
                    <field name="academic_impact_line_ids" nolabel="1"
                           attrs="{'invisible': [('wizard_impact_type', '!=', 'academic')]}"
                           context="{'default_impact_type': 'academic'}">
                        <tree editable="bottom">
                            <field name="analytic_account_id"/>
                            <field name="impact_type" invisible="1"/>
                            <field name="amount" sum="รวม"/>
                        </tree>
                    </field>

                    <!-- Industrial -->
                    <field name="industrial_impact_line_ids" nolabel="1"
                           attrs="{'invisible': [('wizard_impact_type', '!=', 'industrial')]}"
                           context="{'default_impact_type': 'industrial'}">
                        <tree editable="bottom">
                            <field name="analytic_account_id"/>
                            <field name="impact_type" invisible="1"/>
                            <field name="amount" sum="รวม"/>
                        </tree>
                    </field>

                    <!-- Social -->
                    <field name="social_impact_line_ids" nolabel="1"
                           attrs="{'invisible': [('wizard_impact_type', '!=', 'social')]}"
                           context="{'default_impact_type': 'social'}">
                        <tree editable="bottom">
                            <field name="analytic_account_id"/>
                            <field name="impact_type" invisible="1"/>
                            <field name="amount" sum="รวม"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button string="ปิด" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_budget_appropriation_report_form" model="ir.ui.view">
        <field name="name">budget.appropriation.report.form</field>
        <field name="model">budget.appropriation.report</field>
        <field name="arch" type="xml">
            <form string="Budget Appropriation Report">
                <header>
                    <button name="action_confirm" string="ยืนยัน" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_done" string="เสร็จสิ้น" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_draft" string="กลับไปร่าง" type="object" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button name="action_open_report" string="ดูรายงาน" type="object" class="btn-secondary"/>
                    <button name="action_print_all_with_header" string="พิมพ์เล่มประมาณการ (มีมติ)" type="object" class="btn-secondary"/>
                    <button name="action_print_all_without_header" string="พิมพ์เล่มประมาณการ (ไม่มีมติ)" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appropriations" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="appropriation_count" widget="statinfo" string="รายการ"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="ชื่อรายงาน"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_fiscal_year_id"/>
                            <field name="source_analytic_id"/>
                            <field name="department_analytic_id"/>
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="parent_id" />
                            <field name="compare_report_id"/>
                            <field name="use_f23"/>
                            <field name="council_meeting_no"/>
                            <field name="council_meeting_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ประมาณการรายรับ" name="revenue_appropriations">
                            <field name="revenue_appropriation_ids" domain="[('account_fiscal_year_id', '=', account_fiscal_year_id), ('budget_type', '=', 'revenue'), '|', ('source_analytic_id', '=', source_analytic_id), ('source_analytic_id', '=', False)]">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="department_analytic_id"/>
                                    <field name="source_analytic_id"/>
                                    <field name="amount_net" sum="รวม"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ประมาณการรายจ่าย" name="expense_appropriations">
                            <field name="expense_appropriation_ids" domain="[('account_fiscal_year_id', '=', account_fiscal_year_id), ('budget_type', '=', 'expense'), '|', ('source_analytic_id', '=', source_analytic_id), ('source_analytic_id', '=', False)]">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="department_analytic_id"/>
                                    <field name="source_analytic_id"/>
                                    <field name="amount_net" sum="รวม"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="รายงานย่อย" name="child_reports">
                            <field name="child_ids"
                                   domain="[('id', '!=', id), ('source_analytic_id', '=', source_analytic_id), '|', ('department_analytic_id', '=', department_analytic_id), ('department_analytic_id.parent_id', '=', department_analytic_id)]"
                                   context="{'default_source_analytic_id': source_analytic_id, 'default_account_fiscal_year_id': account_fiscal_year_id}"
                                   widget="many2many">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="department_analytic_id"/>
                                    <field name="amount_revenue_total" sum="รวม"/>
                                    <field name="amount_expense_total" sum="รวม"/>
                                    <field name="state" invisible="1" />
                                </tree>
                            </field>
                        </page>
                        <page string="รายงาน F23-W" name="f23w_report" attrs="{'invisible': [('use_f23', '=', False)]}">
                            <style>
                                td.o_data_cell[name='analytic_account_id'] span {
                                    white-space: normal !important;
                                }
                            </style>

                            <!-- Education Section -->
                            <separator string="ด้านการศึกษา (Education)"/>
                            <div class="row">
                                <div class="col-6">
                                    <field name="education_impact_line_ids" nolabel="1"
                                           context="{'default_impact_type': 'education'}">
                                        <tree editable="bottom">
                                            <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                            <field name="impact_type" invisible="1"/>
                                            <field name="amount" sum="รวม"/>
                                        </tree>
                                    </field>
                                </div>
                                <div class="col-6">
                                    <widget name="budget_appropriation_impact_hierarchy"
                                            impact_type="education"
                                            title="ลำดับชั้นกิจกรรม"/>
                                </div>
                            </div>

                            <!-- Academic Section -->
                            <separator string="ด้านการวิจัย (Academic)"/>
                            <div class="row">
                                <div class="col-6">
                                    <field name="academic_impact_line_ids" nolabel="1"
                                           context="{'default_impact_type': 'academic'}">
                                        <tree editable="bottom">
                                            <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                            <field name="impact_type" invisible="1"/>
                                            <field name="amount" sum="รวม"/>
                                        </tree>
                                    </field>
                                </div>
                                <div class="col-6">
                                    <widget name="budget_appropriation_impact_hierarchy"
                                            impact_type="academic"
                                            title="ลำดับชั้นกิจกรรม"/>
                                </div>
                            </div>

                            <!-- Industrial Section -->
                            <separator string="ด้านอุตสาหกรรม (Industrial)"/>
                            <div class="row">
                                <div class="col-6">
                                    <field name="industrial_impact_line_ids" nolabel="1"
                                           context="{'default_impact_type': 'industrial'}">
                                        <tree editable="bottom">
                                            <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                            <field name="impact_type" invisible="1"/>
                                            <field name="amount" sum="รวม"/>
                                        </tree>
                                    </field>
                                </div>
                                <div class="col-6">
                                    <widget name="budget_appropriation_impact_hierarchy"
                                            impact_type="industrial"
                                            title="ลำดับชั้นกิจกรรม"/>
                                </div>
                            </div>

                            <!-- Social Section -->
                            <separator string="ด้านสังคม (Social)"/>
                            <div class="row">
                                <div class="col-6">
                                    <field name="social_impact_line_ids" nolabel="1"
                                           context="{'default_impact_type': 'social'}">
                                        <tree editable="bottom">
                                            <field name="analytic_account_id" widget="helper_text" options="{'no_open': True}"/>
                                            <field name="impact_type" invisible="1"/>
                                            <field name="amount" sum="รวม"/>
                                        </tree>
                                    </field>
                                </div>
                                <div class="col-6">
                                    <widget name="budget_appropriation_impact_hierarchy"
                                            impact_type="social"
                                            title="ลำดับชั้นกิจกรรม"/>
                                </div>
                            </div>
                        </page>
                        <page string="หมายเหตุ" name="note">
                            <field name="note" placeholder="หมายเหตุ..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_budget_appropriation_report_tree" model="ir.ui.view">
        <field name="name">budget.appropriation.report.tree</field>
        <field name="model">budget.appropriation.report</field>
        <field name="arch" type="xml">
            <tree string="Budget Appropriation Reports">
                <field name="name"/>
                <field name="account_fiscal_year_id"/>
                <field name="council_meeting_no"/>
                <field name="council_meeting_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_budget_appropriation_report_kanban" model="ir.ui.view">
        <field name="name">budget.appropriation.report.kanban</field>
        <field name="model">budget.appropriation.report</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="account_fiscal_year_id"/>
                <field name="department_analytic_id"/>
                <field name="source_analytic_id"/>
                <field name="state"/>
                <field name="amount_revenue_total"/>
                <field name="amount_expense_total"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted">
                                    <field name="account_fiscal_year_id"/> | <field name="source_analytic_id"/>
                                </div>
                                <div class="mt-2">
                                    <span class="text-success">รายรับ: <field name="amount_revenue_total" widget="monetary"/></span>
                                </div>
                                <div>
                                    <span class="text-danger">รายจ่าย: <field name="amount_expense_total" widget="monetary"/></span>
                                </div>
                                <div class="mt-2">
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_budget_appropriation_report_search" model="ir.ui.view">
        <field name="name">budget.appropriation.report.search</field>
        <field name="model">budget.appropriation.report</field>
        <field name="arch" type="xml">
            <search string="Search Budget Appropriation Reports">
                <field name="name"/>
                <field name="account_fiscal_year_id"/>
                <field name="council_meeting_no"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Fiscal Year" name="group_by_fiscal_year" context="{'group_by': 'account_fiscal_year_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_appropriation_report" model="ir.actions.act_window">
        <field name="name">สรุปประมาณการรายรับและรายจ่าย</field>
        <field name="res_model">budget.appropriation.report</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_budget_appropriation_report_search"/>
    </record>
</odoo>
