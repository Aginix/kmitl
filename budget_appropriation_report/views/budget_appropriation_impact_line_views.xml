<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View budget.appropriation.impact.line View Tree -->
    <record id="view_budget_appropriation_impact_line_tree" model="ir.ui.view">
        <field name="name">view.budget.appropriation.impact.line.tree</field>
        <field name="model">budget.appropriation.impact.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="report_id" invisible="1"/>
                <field name="impact_type" invisible="1"/>
                <field name="analytic_account_id"/>
                <field name="amount" sum="รวม"/>
                <button name="action_delete" type="object" icon="fa-trash" title="ลบ" class="text-danger"/>
            </tree>
        </field>
    </record>

    <!-- View budget.appropriation.impact.line form -->
    <record id="view_budget_appropriation_impact_line_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.impact.line.form</field>
        <field name="model">budget.appropriation.impact.line</field>
        <field name="arch" type="xml">
            <form string="Budget Appropriation Impact Line">
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="1" />
                            <field name="impact_type" widget="radio" />
                            <field name="analytic_account_id" />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View budget.appropriation.impact.line search -->
    <record id="view_budget_appropriation_impact_line_search" model="ir.ui.view">
        <field name="name">view.budget.appropriation.impact.line.search</field>
        <field name="model">budget.appropriation.impact.line</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action budget.appropriation.impact.line -->
    <record id="action_budget_appropriation_impact_line" model="ir.actions.act_window">
        <field name="name">Budget Appropriation Impact Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">budget.appropriation.impact.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Budget Appropriation Impact Line.
            </p>
        </field>
    </record>

</odoo>
