<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_appropriation_report.BudgetRevenueOverview" owl="1">
        <div class="o_action budget_appropriation_report_revenue_overview">
            <!-- <div
                class="o_control_panel d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom"
            ></div> -->
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-bottom-left-buttons">
                    <div class="o_cp_buttons">
                        <div class="btn-group me-2">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                t-on-click="onRefresh"
                                title="รีเฟรช"
                            >
                                <i class="fa fa-refresh" />
                            </button>
                        </div>
                        <div class="btn-group">
                            <button
                                type="button"
                                class="btn btn-primary"
                                t-on-click="onPrint"
                                title="พิมพ์"
                            >
                                <i class="fa fa-print" /> พิมพ์
                            </button>
                        </div>
                    </div>
                </t>
                <t t-set-slot="control-panel-top-right">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <div>
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="toggleHideEmpty"
                                    t-model="state.hideEmpty"
                                    t-on-change="onToggleHideEmpty"
                                />
                                <label class="form-check-label" for="toggleHideEmpty">
                                    ซ่อนหน่วยงานที่ไม่มีประมาณการ
                                </label>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">ปีงบประมาณ:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select
                                    class="form-select form-select-sm"
                                    t-model="state.filters.fiscal_year_id"
                                    t-on-change="onFiscalYearChange"
                                >
                                    <t
                                        t-foreach="state.filterOptions.fiscal_years"
                                        t-as="fy"
                                        t-key="fy.id"
                                    >
                                        <option t-att-value="fy.id" t-esc="fy.name" />
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">สถานะ:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select
                                    class="form-select form-select-sm"
                                    t-model="state.filters.state"
                                    t-on-change="onStateChange"
                                >
                                    <option value="">ทุกสถานะ</option>
                                    <t
                                        t-foreach="state.filterOptions.state"
                                        t-as="state"
                                        t-key="state.id"
                                    >
                                        <option
                                            t-att-value="state.id"
                                            t-esc="state.id"
                                        />
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>
                </t>
            </ControlPanel>
            <div class="o_content">
                <div t-if="!state.loading" class="budget_appropriation_content">
                    <div class="row justify-content-center">
                        <div class="col-12" style="max-width: 960px">
                            <div class="budget-report-container">
                                <div class="report-header text-center mb-4">
                                    <!-- <h3
                                        t-if="appropriation.source"
                                        t-esc="appropriation.source.name"
                                    /> -->
                                    <h3>
                                        สรุปประมาณการรายรับ ประจำปีงบประมาณ พ.ศ.
                                        <t t-esc="fiscalYear.name" />
                                    </h3>
                                    <h3>
                                        สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง
                                    </h3>
                                </div>

                                <!-- Report Table -->
                                <div class="table-responsive">
                                    <t t-set="row_no" t-value="1" />
                                    <t t-if="data.length > 0">
                                        <t
                                            t-foreach="data"
                                            t-as="account"
                                            t-key="account.id"
                                        >
                                            <div style="margin-bottom: 24px">
                                                <div>
                                                    <span
                                                        style="
                                                            font-weight: bold;
                                                            text-decoration: underline;
                                                            font-size: 16px;
                                                        "
                                                    >
                                                        <t
                                                            t-esc="`${row_no}. ${account.name}`"
                                                        />
                                                    </span>
                                                </div>

                                                <table
                                                    class="table budget-report-table"
                                                >
                                                    <tbody>
                                                        <t
                                                            t-foreach="account.departments"
                                                            t-as="dept"
                                                            t-key="account.id + dept.id"
                                                        >
                                                            <tr>
                                                                <td style="width: 60%">
                                                                    <div
                                                                        style="
                                                                            padding-left: 16px;
                                                                        "
                                                                    >
                                                                        -
                                                                        <t
                                                                            t-esc="dept.name"
                                                                        />
                                                                    </div>
                                                                </td>
                                                                <td
                                                                    class="amount-cell"
                                                                    style="
                                                                        text-align: right;
                                                                        width: 20%;
                                                                    "
                                                                >
                                                                    <t
                                                                        t-esc="formatCurrency(dept.balance)"
                                                                    />
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td
                                                                colspan="2"
                                                                class="amount-cell"
                                                                style="
                                                                    text-align: right;
                                                                    font-weight: bold;
                                                                "
                                                            >
                                                                รวม
                                                                <span
                                                                    style="
                                                                        text-decoration: underline;
                                                                    "
                                                                    ><t
                                                                        t-esc="formatCurrency(account.total_balance)"
                                                                /></span>
                                                                บาท
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                            <t t-set="row_no" t-value="row_no + 1" />
                                        </t>
                                    </t>
                                    <div
                                        style="
                                            text-align: right;
                                            font-weight: bold;
                                            font-size: 16px;
                                            padding-right: 6px;
                                        "
                                    >
                                        รวมทั้งสิ้น
                                        <span
                                            class="amount-cell"
                                            style="
                                                text-decoration: underline;
                                                text-decoration-style: double;
                                            "
                                            ><t t-esc="formatCurrency(totalBalance)"
                                        /></span>
                                        บาท
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
