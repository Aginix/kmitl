<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_appropriation_report.BudgetAppropriationF5Expense" owl="1">
        <div class="o_action budget_appropriation_f5_expense d-flex flex-column h-100">
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-bottom-left-buttons">
                    <div class="o_cp_buttons">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-secondary" t-on-click="onRefresh" title="รีเฟรช">
                                <i class="fa fa-refresh" />
                            </button>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-primary" t-on-click="onPrint" title="พิมพ์" t-att-disabled="!hasSelection">
                                <i class="fa fa-print" />
                                พิมพ์
                            </button>
                        </div>
                    </div>
                </t>
                <t t-set-slot="control-panel-top-right">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <div>
                            <label class="form-label-sm mb-1">ปีงบประมาณ:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.fiscal_year_id" t-on-change="onFiscalYearChange">
                                    <t t-foreach="state.filterOptions.fiscal_years" t-as="fy" t-key="fy.id">
                                        <option t-att-value="fy.id" t-esc="fy.name" />
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">แหล่งเงิน:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.source_analytic_id" t-on-change="onSourceChange">
                                    <t t-foreach="state.filterOptions.sources" t-as="source" t-key="source.id">
                                        <option t-att-value="source.id">[<t t-esc="source.code"/>] <t t-esc="source.name"/></option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>
                </t>
            </ControlPanel>

            <!-- Appropriation Selection Panel (below control panel) -->
            <div class="appropriation-selection-panel border-bottom p-3 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>เลือกคำขอตั้งงบประมาณ:</strong>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" t-on-click="onExpandAll" title="ขยายทั้งหมด">
                            <i class="fa fa-expand"/>
                        </button>
                        <button class="btn btn-outline-secondary" t-on-click="onCollapseAll" title="ย่อทั้งหมด">
                            <i class="fa fa-compress"/>
                        </button>
                        <button class="btn btn-outline-secondary" t-on-click="onSelectAll">เลือกทั้งหมด</button>
                        <button class="btn btn-outline-secondary" t-on-click="onDeselectAll">ยกเลิกทั้งหมด</button>
                    </div>
                </div>
                <div t-if="state.loading" class="text-center py-3">
                    <i class="fa fa-spinner fa-spin"/> กำลังโหลด...
                </div>
                <div t-elif="state.appropriations.length === 0" class="text-muted py-2">
                    ไม่พบคำขอตั้งงบประมาณ
                </div>
                <div t-else="" class="department-tree" style="max-height: 250px; overflow-y: auto;">
                    <t t-foreach="state.appropriations" t-as="dept" t-key="dept.id">
                        <t t-call="budget_appropriation_report.DepartmentNode">
                            <t t-set="department" t-value="dept"/>
                            <t t-set="level" t-value="0"/>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Content Area -->
            <div class="o_content flex-grow-1">
                <div t-if="hasSelection" class="h-100">
                    <iframe t-att-src="portalUrl" class="w-100 h-100 border-0"/>
                </div>
                <div t-else="" class="d-flex align-items-center justify-content-center h-100">
                    <div class="text-center text-muted">
                        <i class="fa fa-hand-pointer-o fa-3x mb-3"/>
                        <h4>กรุณาเลือกคำขอตั้งงบประมาณ</h4>
                        <p>เลือกรายการด้านบนเพื่อแสดงรายงาน</p>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Recursive Department Node Template -->
    <t t-name="budget_appropriation_report.DepartmentNode" owl="1">
        <div class="department-node" t-att-style="'padding-left: ' + (level * 16) + 'px'">
            <!-- Department Header -->
            <div class="d-flex align-items-center py-1">
                <span class="dept-toggle me-1" style="width: 16px; cursor: pointer;"
                      t-on-click="() => this.onToggleDepartment(department.id)">
                    <i t-if="department.children and department.children.length > 0"
                       t-att-class="isDepartmentExpanded(department.id) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                </span>
                <div class="form-check mb-0">
                    <input type="checkbox" class="form-check-input"
                           t-att-id="'dept_' + department.id"
                           t-att-checked="isDepartmentSelected(department)"
                           t-on-change="() => this.onSelectDepartment(department)"/>
                    <label class="form-check-label fw-semibold" t-att-for="'dept_' + department.id">
                        [<t t-esc="department.code"/>] <t t-esc="department.name"/>
                    </label>
                </div>
            </div>

            <!-- Appropriations under this department (always visible if department has them) -->
            <t t-if="isDepartmentExpanded(department.id) or !department.children or department.children.length === 0">
                <t t-foreach="department.appropriations" t-as="app" t-key="app.id">
                    <div class="d-flex align-items-center py-1" t-att-style="'padding-left: ' + ((level + 1) * 16 + 16) + 'px'">
                        <div class="form-check mb-0">
                            <input type="checkbox" class="form-check-input"
                                   t-att-id="'app_' + app.id"
                                   t-att-checked="isAppropriationSelected(app.id)"
                                   t-on-change="() => this.onAppropriationToggle(app.id)"/>
                            <label class="form-check-label" t-att-for="'app_' + app.id">
                                <t t-esc="app.name"/>
                                <small class="text-muted ms-1">(<t t-esc="formatCurrency(app.amount_net)"/> บาท)</small>
                            </label>
                        </div>
                    </div>
                </t>
            </t>

            <!-- Child departments (recursive) -->
            <t t-if="isDepartmentExpanded(department.id) and department.children and department.children.length > 0">
                <t t-foreach="department.children" t-as="child" t-key="child.id">
                    <t t-call="budget_appropriation_report.DepartmentNode">
                        <t t-set="department" t-value="child"/>
                        <t t-set="level" t-value="level + 1"/>
                    </t>
                </t>
            </t>
        </div>
    </t>
</templates>
