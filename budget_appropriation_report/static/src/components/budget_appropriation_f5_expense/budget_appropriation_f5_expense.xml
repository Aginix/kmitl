<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_appropriation_report.BudgetAppropriationF5Expense" owl="1">
        <div class="o_action budget_appropriation_f5_expense">
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-bottom-left-buttons">
                    <div class="o_cp_buttons">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-secondary" t-on-click="onRefresh" title="รีเฟรช">
                                <i class="fa fa-refresh" />
                            </button>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-primary" t-on-click="onPrint" title="พิมพ์">
                                <i class="fa fa-print" />
                                พิมพ์
                            </button>
                        </div>
                    </div>
                </t>
                <t t-set-slot="control-panel-top-right">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <div>
                            <label class="form-label-sm mb-1">ปีงบประมาณ:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.fiscal_year_id" t-on-change="onFiscalYearChange">
                                    <t t-foreach="state.filterOptions.fiscal_years" t-as="fy" t-key="fy.id">
                                        <option t-att-value="fy.id" t-esc="fy.name" />
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">แหล่งเงิน:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.source_analytic_id" t-on-change="onSourceChange">
                                    <t t-foreach="state.filterOptions.sources" t-as="source" t-key="source.id">
                                        <option t-att-value="source.id">[<t t-esc="source.code"/>] <t t-esc="source.name"/></option>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">หน่วยงาน:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.department_id" t-on-change="onDepartmentChange">
                                    <option value="">ทุกหน่วยงาน</option>
                                    <t t-foreach="flatDepartmentOptions" t-as="dept" t-key="dept.id">
                                        <option t-att-value="dept.id" t-esc="dept.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>
                </t>
            </ControlPanel>
            <div class="o_content">
                <div t-if="!state.loading" class="budget_appropriation_content">
                    <div class="row justify-content-center">
                        <div class="col-12" style="max-width: 960px">
                            <div class="budget-report-container">
                                <div class="report-header text-center mb-4">
                                    <h3>
                                        รายงาน F5 - งบประมาณรายจ่าย ประจำปีงบประมาณ พ.ศ.
                                        <t t-esc="selectedFiscalYear?.name || '-'"/>
                                    </h3>
                                    <h3>
                                        สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง
                                    </h3>
                                    <p t-if="selectedSource">
                                        แหล่งเงิน: [<t t-esc="selectedSource.code"/>] <t t-esc="selectedSource.name"/>
                                    </p>
                                    <p t-if="selectedDepartment">
                                        หน่วยงาน: <t t-esc="selectedDepartment.name"/>
                                    </p>
                                </div>

                                <!-- Report Table -->
                                <div class="table-responsive">
                                    <t t-set="row_no" t-value="1" />
                                    <t t-if="hierarchy.length > 0">
                                        <t t-foreach="hierarchy" t-as="activity" t-key="activity.key">
                                            <div style="margin-bottom: 24px">
                                                <div>
                                                    <span style="font-weight: bold; text-decoration: underline; font-size: 16px;">
                                                        <t t-esc="`${row_no}. [${activity.code}] ${activity.complete_name || activity.name}`"/>
                                                    </span>
                                                </div>

                                                <table class="table budget-report-table">
                                                    <tbody>
                                                        <t t-foreach="activity.children" t-as="fund" t-key="fund.key">
                                                            <!-- Fund header -->
                                                            <tr>
                                                                <td colspan="2" style="font-weight: bold; background-color: #f8f9fa; padding-left: 16px;">
                                                                    [<t t-esc="fund.code"/>] <t t-esc="fund.complete_name || fund.name"/>
                                                                </td>
                                                            </tr>
                                                            <!-- Account rows -->
                                                            <t t-foreach="fund.children" t-as="account" t-key="account.key">
                                                                <tr>
                                                                    <td style="width: 60%">
                                                                        <div style="padding-left: 32px;">
                                                                            - [<t t-esc="account.code"/>] <t t-esc="account.complete_name || account.name"/>
                                                                        </div>
                                                                    </td>
                                                                    <td class="amount-cell" style="text-align: right; width: 20%;">
                                                                        <t t-esc="formatCurrency(account.total_amount)"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                            <!-- Fund total -->
                                                            <tr>
                                                                <td style="text-align: right; font-weight: bold; padding-left: 32px;">
                                                                    รวม [<t t-esc="fund.code"/>] <t t-esc="fund.complete_name || fund.name"/>
                                                                </td>
                                                                <td class="amount-cell" style="text-align: right; font-weight: bold;">
                                                                    <span style="text-decoration: underline;">
                                                                        <t t-esc="formatCurrency(fund.total_amount)"/>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <td colspan="2" class="amount-cell" style="text-align: right; font-weight: bold;">
                                                                รวม
                                                                <span style="text-decoration: underline;">
                                                                    <t t-esc="formatCurrency(activity.total_amount)"/>
                                                                </span>
                                                                บาท
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                            <t t-set="row_no" t-value="row_no + 1" />
                                        </t>
                                    </t>
                                    <div style="text-align: right; font-weight: bold; font-size: 16px; padding-right: 6px;">
                                        รวมทั้งสิ้น
                                        <span class="amount-cell" style="text-decoration: underline; text-decoration-style: double;">
                                            <t t-esc="formatCurrency(totalBalance)" />
                                        </span>
                                        บาท
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>