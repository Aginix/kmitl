<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_appropriation_report.BudgetAppropriationF5Expense" owl="1">
        <div class="o_action budget_appropriation_f5_expense">
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-bottom-left-buttons">
                    <div class="o_cp_buttons">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-secondary" t-on-click="onExpandAll" title="ขยายทั้งหมด">
                                <i class="fa fa-expand" />
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="onCollapseAll" title="ย่อทั้งหมด">
                                <i class="fa fa-compress" />
                            </button>
                        </div>
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-secondary" t-on-click="onRefresh" title="รีเฟรช">
                                <i class="fa fa-refresh" />
                            </button>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-primary" t-on-click="onPrint" title="พิมพ์">
                                <i class="fa fa-print" />
                                พิมพ์
                            </button>
                        </div>
                    </div>
                </t>
                <t t-set-slot="control-panel-top-right">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <div>
                            <label class="form-label-sm mb-1">ปีงบประมาณ:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.fiscal_year_id" t-on-change="onFiscalYearChange">
                                    <t t-foreach="state.filterOptions.fiscal_years" t-as="fy" t-key="fy.id">
                                        <option t-att-value="fy.id" t-esc="fy.name" />
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">แหล่งเงิน:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.source_analytic_id" t-on-change="onSourceChange">
                                    <t t-foreach="state.filterOptions.sources" t-as="source" t-key="source.id">
                                        <option t-att-value="source.id">[<t t-esc="source.code"/>] <t t-esc="source.name"/></option>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label-sm mb-1">หน่วยงาน:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select class="form-select form-select-sm" t-model="state.filters.department_id" t-on-change="onDepartmentChange">
                                    <option value="">ทุกหน่วยงาน</option>
                                    <t t-foreach="flatDepartmentOptions" t-as="dept" t-key="dept.id">
                                        <option t-att-value="dept.id" t-esc="dept.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>
                </t>
            </ControlPanel>
            <div class="o_content">
                <div t-if="!state.loading" class="budget_appropriation_content">
                    <div class="row justify-content-center">
                        <div class="col-12" style="max-width: 960px">
                            <div class="budget-report-container">
                                <div class="report-header text-center mb-4">
                                    <h3>
                                        รายงาน F5 - งบประมาณรายจ่าย ประจำปีงบประมาณ พ.ศ.
                                        <t t-esc="selectedFiscalYear?.name || '-'"/>
                                    </h3>
                                    <h3>
                                        สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง
                                    </h3>
                                    <p t-if="selectedSource">
                                        แหล่งเงิน: [<t t-esc="selectedSource.code"/>] <t t-esc="selectedSource.name"/>
                                    </p>
                                    <p t-if="selectedDepartment">
                                        หน่วยงาน: <t t-esc="selectedDepartment.name"/>
                                    </p>
                                </div>

                                <!-- Report Table -->
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm budget-report-table">
                                        <thead>
                                            <tr class="table-active">
                                                <th width="80%">รายการ</th>
                                                <th width="20%" class="text-end">จำนวนเงิน</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="hierarchy.length > 0">
                                                <t t-foreach="hierarchy" t-as="rootNode" t-key="rootNode.key">
                                                    <t t-call="budget_appropriation_report.F5TableRow">
                                                        <t t-set="node" t-value="rootNode"/>
                                                        <t t-set="level" t-value="0"/>
                                                    </t>
                                                </t>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-active fw-bold">
                                                <td class="text-end">
                                                    <strong>ยอดรวมทั้งหมด</strong>
                                                </td>
                                                <td class="text-end">
                                                    <strong>
                                                        <t t-esc="formatCurrency(totalBalance)"/> บาท
                                                    </strong>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                <!-- Empty State -->
                                <div t-if="hierarchy.length === 0" class="text-center py-5">
                                    <div class="text-muted">
                                        <h4>ไม่มีข้อมูล</h4>
                                        <p>ไม่พบรายการจัดสรรงบประมาณ</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Table Row Template -->
    <t t-name="budget_appropriation_report.F5TableRow" owl="1">
        <tr t-attf-class="{{node.type}} {{node.type !== 'account' ? 'font-weight-bold' : ''}}">
            <td>
                <div t-att-style="getMarginStyle(node)">
                    <div class="d-flex align-items-center">
                        <button
                            t-if="node.children and node.children.length > 0"
                            type="button"
                            class="btn btn-sm btn-link p-0 me-2"
                            t-on-click="() => this.onToggleNode(node.key)"
                            style="width: 20px;">
                            <i t-att-class="isNodeExpanded(node.key) ? 'fa fa-minus-square-o' : 'fa fa-plus-square-o'"/>
                        </button>
                        <div t-else="" style="width: 20px; display: inline-block;" class="me-2"></div>
                        <span>
                            <t t-if="node.type === 'account'">
                                <t t-esc="node.code"/> - <t t-esc="node.name"/>
                            </t>
                            <t t-else="">
                                <t t-esc="node.name"/>
                                <t t-if="node.code">
                                    <span class="text-muted"> (<t t-esc="node.code"/>)</span>
                                </t>
                            </t>
                        </span>
                    </div>
                </div>
            </td>
            <td class="text-end">
                <t t-if="node.total_amount != 0">
                    <t t-esc="formatCurrency(node.total_amount)"/>
                </t>
            </td>
        </tr>

        <!-- Children Rows -->
        <t t-if="isNodeExpanded(node.key) and node.children and node.children.length > 0">
            <t t-foreach="node.children" t-as="childNode" t-key="childNode.key">
                <t t-call="budget_appropriation_report.F5TableRow">
                    <t t-set="node" t-value="childNode"/>
                    <t t-set="level" t-value="level + 1"/>
                </t>
            </t>
        </t>
    </t>

</templates>