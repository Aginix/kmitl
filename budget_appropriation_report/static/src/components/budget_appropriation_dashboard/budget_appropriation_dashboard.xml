<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_appropriation_report.BudgetAppropriationDashboard" owl="1">
        <div class="o_action budget_appropriation_dashboard">
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-top-right">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <div>
                            <label class="form-label-sm mb-1">ปีงบประมาณ:</label>
                            <div class="o_mobile_search_filter o_search_options">
                                <select
                                    class="form-select form-select-sm"
                                    t-on-change="onFiscalYearChange"
                                >
                                    <t
                                        t-foreach="state.filterOptions.fiscal_years"
                                        t-as="fy"
                                        t-key="fy.id"
                                    >
                                        <option
                                            t-att-value="fy.id"
                                            t-att-selected="isFiscalYearSelected(fy.id)"
                                            t-esc="fy.name"
                                        />
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>
                </t>
            </ControlPanel>
            <div class="o_content">
                <div t-if="state.loading" class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <div t-else="" class="budget_appropriation_dashboard_content p-3">
                    <div class="text-center text-muted p-5">
                        <h4>Dashboard การจัดสรรงบประมาณ</h4>
                        <p>ปีงบประมาณ: <t t-esc="selectedFiscalYear"/></p>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
