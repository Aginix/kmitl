<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="budget_appropriation_report.ImpactLineHierarchy" owl="1">
        <div class="impact-line-hierarchy border rounded">
            <!-- Header with title -->
            <div class="p-2 bg-light border-bottom">
                <strong t-esc="props.title"/>
            </div>
            <!-- Content area -->
            <div class="overflow-auto" style="max-height: 400px;">
                <div t-if="state.loading" class="text-center py-3">
                    <i class="fa fa-spinner fa-spin"/> กำลังโหลด...
                </div>
                <div t-elif="state.rows.length === 0" class="text-muted py-2 text-center">
                    ไม่มีข้อมูล
                </div>
                <table t-else="" class="table table-sm table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>กิจกรรม</th>
                            <th class="text-end" style="width: 120px;">จำนวนเงิน</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.rows" t-as="row" t-key="row.id">
                            <tr t-att-class="row.type === 'line' ? 'text-muted' : ''">
                                <td t-att-style="'padding-left: ' + (row.level * 16 + 8) + 'px'">
                                    <t t-if="row.type === 'account'">
                                        <span class="fw-semibold" t-esc="row.name"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-circle-o me-1" style="font-size: 6px;"/>
                                        <span class="fst-italic">รายการ</span>
                                    </t>
                                </td>
                                <td class="text-end">
                                    <t t-esc="formatCurrency(row.amount)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td>รวมทั้งหมด</td>
                            <td class="text-end"><t t-esc="formatCurrency(state.totalAmount)"/></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>
</templates>
