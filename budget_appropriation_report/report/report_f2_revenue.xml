<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Partial template for F2 content (reusable) -->
    <template id="report_f2_revenue_content">
        <style>
            .f2-w tr:last-child td {
                padding-bottom: 36px;
            }
        </style>
        <div class="page" style="width: 100%;">
            <div class="text-center mt-5 mb-5">
                <div class="header-box">
                    <div class="header-text">
                        มติที่ประชุมสภาสถาบัน ครั้งที่
                        <t t-esc="o.council_meeting_no or '-'" />
                    </div>
                    <div class="header-text">
                        วันที่
                        <t t-if="o.council_meeting_date">
                            <t t-esc="o.council_meeting_date.strftime('%d')" />
                            <t t-esc="dict([('01','มกราคม'),('02','กุมภาพันธ์'),('03','มีนาคม'),('04','เมษายน'),('05','พฤษภาคม'),('06','มิถุนายน'),('07','กรกฎาคม'),('08','สิงหาคม'),('09','กันยายน'),('10','ตุลาคม'),('11','พฤศจิกายน'),('12','ธันวาคม')]).get(o.council_meeting_date.strftime('%m'), '')" />
                            พ.ศ.
                            <t t-esc="o.council_meeting_date.year + 543" />
                        </t>
                        <t t-else="">-</t>
                    </div>
                </div>
            </div>
            <div class="text-center mt-5 mb-3" style="font-weight: bold">
                <div>สรุปเปรียบเทียบประมาณการรายรับ</div>
                <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                <div>จําแนกตามประเภท</div>
            </div>
            <table class="table table-sm table-bordered f2-w">
                <thead>
                    <tr>
                        <th style="width: 40%" rowspan="2">ประเภท</th>
                        <th colspan="2" class="text-center">ปีงบประมาณ <t t-esc="o.compare_report_id.account_fiscal_year_id.name" /></th>
                        <th colspan="2" class="text-center">ปีงบประมาณ <t t-esc="o.account_fiscal_year_id.name" /></th>
                        <th rowspan="2" class="text-center">
                            + เพิ่ม - ลด <br />
                            จำนวนเงิน
                        </th>
                        <th rowspan="2" class="text-center" style="width: 80px">%</th>
                    </tr>
                    <tr>
                        <th class="text-center">จำนวนเงิน</th>
                        <th class="text-center" style="width: 60px">%</th>
                        <th class="text-center">จำนวนเงิน</th>
                        <th class="text-center" style="width: 60px">%</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1. รายรับจากรัฐบาล</td>
                        <td class="text-end">0</td>
                        <td class="text-end">0.00</td>
                        <td class="text-end">0</td>
                        <td class="text-end">0.00</td>
                        <td class="text-end">0</td>
                        <td class="text-end">0.00</td>
                    </tr>
                    <tr>
                        <td><strong>2. เงินรายได้</strong></td>
                        <td class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['compare_total_amount'])" /></strong>
                        </td>
                        <td class="text-end"><strong>100.0</strong></td>
                        <td class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['total_amount'])" /></strong>
                        </td>
                        <td class="text-end"><strong>100.0</strong></td>
                        <td class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['diff_amount'])" /></strong>
                        </td>
                        <td class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['diff_percentage'])" /></strong>
                        </td>
                    </tr>
                    <t t-foreach="o.f2_revenue_data['categories']" t-as="row">
                        <tr>
                            <td class="ps-4" t-esc="row['name']" />
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(row['compare_amount'])" /></td>
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(row['compare_percentage'])" /></td>
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(row['amount'])" /></td>
                            <td class="text-end" t-esc="row['percentage']" />
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(row['diff_amount'])" /></td>
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(row['diff_percentage'])" /></td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr style="padding-top: 60px">
                        <th class="text-center">รวมรายได้ทั้งสิ้น</th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['compare_total_amount'])" /></strong>
                        </th>
                        <th class="text-end">100.0</th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['total_amount'])" /></strong>
                        </th>
                        <th class="text-end">100.0</th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['diff_amount'])" /></strong>
                        </th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['diff_percentage'])" /></strong>
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </template>

    <!-- Main F2 report template -->
    <template id="report_f2_revenue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-call="budget_appropriation_report.report_common_styles" />
                    <t t-call="budget_appropriation_report.report_f2_revenue_content" />
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_f2_revenue" model="ir.actions.report">
        <field name="name">F2 - สรุปเปรียบเทียบประมาณการรายรับจําแนกตามประเภท</field>
        <field name="model">budget.appropriation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_report.report_f2_revenue</field>
        <field name="report_file">budget_appropriation_report.report_f2_revenue</field>
        <field name="paperformat_id" ref="paperformat_landscape" />
    </record>
</odoo>
