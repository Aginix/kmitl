<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Partial template for F3-W-วง-003 และ F6-W-วง-003 content (reusable) -->
    <template id="report_f3w_f6w_revenue_content">
        <style>
            .f3w_f6w .table-bordered td {
                border-color: #000 !important;
            }
            .f3w_f6w .table {
                border-color: #000 !important;
            }
        </style>
        <div class="page f3w_f6w">
            <div class="text-center mt-5 mb-3" style="font-weight: bold">
                <div>
                    สรุปเปรียบเทียบประมาณการรายรับ - รายจ่าย
                </div>
                <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                <div>จําแนกตามหน่วยงาน ปีงบประมาณ พ.ศ. <t t-esc="o.compare_report_id.account_fiscal_year_id.name" /> และ <t t-esc="o.account_fiscal_year_id.name" /></div>
            </div>
            <div>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center" rowspan="2" style="width: 35%;">หน่วยงาน</th>
                            <th class="text-center" colspan="2">ปีงบประมาณ <t t-esc="o.compare_report_id.account_fiscal_year_id.name" /></th>
                            <th class="text-center" colspan="2">ปีงบประมาณ <t t-esc="o.account_fiscal_year_id.name" /></th>
                            <th class="text-center" colspan="2">+ เพิ่ม - ลด</th>
                        </tr>
                        <tr>
                            <th class="text-center">เงินรายได้</th>
                            <th class="text-center">%</th>
                            <th class="text-center">เงินรายได้</th>
                            <th class="text-center">%</th>
                            <th class="text-center">เงินรายได้</th>
                            <th class="text-center">%</th>
                        </tr>
                    </thead>
                    <tbody class="category">
                        <t t-set="row_no" t-value="1" />
                        <t t-foreach="o.f4w_revenue_data['departments']" t-as="row">
                            <tr class="border-0">
                                <td class="border-0 border-start">
                                    <strong>
                                        <u>
                                            <t t-esc="row_no" />.
                                            <t t-esc="row['name']" />
                                        </u>
                                    </strong>
                                </td>
                                <td class="text-end border-bottom border-black">
                                    <strong><t t-out="'{0:,.2f}'.format(row['compare_amount'])" /></strong>
                                </td>
                                <td class="text-end border-bottom border-black">
                                    <strong>100.0</strong>
                                </td>
                                <td class="text-end border-bottom border-black">
                                    <strong><t t-out="'{0:,.2f}'.format(row['amount'])" /></strong>
                                </td>
                                <td class="text-end border-bottom border-black">
                                    <strong>100.0</strong>
                                </td>
                                <td class="text-end border-bottom border-black">
                                    <strong><t t-out="'{0:,.2f}'.format(row['diff_amount'])" /></strong>
                                </td>
                                <td class="text-end border-bottom border-black">
                                    <strong><t t-out="'{0:,.2f}'.format(row['diff_percentage'])" /></strong>
                                </td>
                            </tr>
                            <t t-set="row_no" t-value="row_no + 1" />
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="text-center">
                                <strong>รวมทั้งสิ้น</strong>
                            </td>
                            <td class="text-end" style="font-weight: bold;">
                                <t t-out="'{0:,.2f}'.format(o.f4w_revenue_data['summary']['compare_total_amount'])" />
                            </td>
                            <td class="text-end" style="font-weight: bold;">
                                <t t-out="'{0:,.2f}'.format(100)" />
                            </td>
                            <td class="text-end" style="font-weight: bold;">
                                <t t-out="'{0:,.2f}'.format(o.f4w_revenue_data['summary']['total_amount'])" />
                            </td>
                            <td class="text-end" style="font-weight: bold;">
                                <t t-out="'{0:,.2f}'.format(100)" />
                            </td>
                            <td class="text-end" style="font-weight: bold;">
                                <t t-out="'{0:,.2f}'.format(o.f4w_revenue_data['summary']['diff_amount'])" />
                            </td>
                            <td class="text-end" style="font-weight: bold;">
                                <t t-out="'{0:,.2f}'.format(o.f4w_revenue_data['summary']['diff_percentage'])" />
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </template>

    <!-- Main F3-W-วง-003 และ F6-W-วง-003 report template -->
    <template id="report_f3w_f6w_revenue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-call="budget_appropriation_report.report_common_styles" />
                    <t t-call="budget_appropriation_report.report_f3w_f6w_revenue_content" />
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_f3w_f6w_revenue" model="ir.actions.report">
        <field name="name">F3-W-วง-003 และ F6-W-วง-003 - สรุปเปรียบเทียบรายรับ-รายจ่าย</field>
        <field name="model">budget.appropriation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_report.report_f3w_f6w_revenue</field>
        <field name="report_file">budget_appropriation_report.report_f3w_f6w_revenue</field>
    </record>
</odoo>
