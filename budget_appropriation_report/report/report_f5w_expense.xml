<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Partial template for F5 content (reusable) -->
    <template id="report_f5w_expense_content">
        <style>
            .f5w tr:last-child td {
                padding-bottom: 36px;
            }
        </style>
        <div class="page" style="width: 100%;">
            <div class="text-center mt-5 mb-3" style="font-weight: bold">
                <div>สรุปเปรียบเทียบประมาณการรายจ่าย</div>
                <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                <div>จําแนกตามแผนงาน</div>
            </div>
            <table class="table table-sm table-bordered f5w">
                <thead>
                    <tr>
                        <th style="width: 40%" rowspan="2">แผนงาน</th>
                        <th colspan="2" class="text-center">ปีงบประมาณ <t t-esc="o.compare_report_id.account_fiscal_year_id.name" /></th>
                        <th colspan="2" class="text-center">ปีงบประมาณ <t t-esc="o.account_fiscal_year_id.name" /></th>
                        <th rowspan="2" class="text-center">
                            + เพิ่ม - ลด <br />
                            จำนวนเงิน
                        </th>
                        <th rowspan="2" class="text-center" style="width: 80px">%</th>
                    </tr>
                    <tr>
                        <th class="text-center">รายได้</th>
                        <th class="text-center" style="width: 60px">%</th>
                        <th class="text-center">รายได้</th>
                        <th class="text-center" style="width: 60px">%</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.f5w_expense_data['activities']" t-as="activity">
                        <tr>
                            <td class="ps-4" t-esc="activity['name']" />
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(activity['compare_amount'])" /></td>
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(activity['compare_percentage'])" /></td>
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(activity['amount'])" /></td>
                            <td class="text-end" t-esc="activity['percentage']" />
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(activity['diff_amount'])" /></td>
                            <td class="text-end"><t t-out="'{0:,.2f}'.format(activity['diff_percentage'])" /></td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr style="padding-top: 60px">
                        <th class="text-center">รวมทั้งสิ้น</th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f5w_expense_data['summary']['compare_total_amount'])" /></strong>
                        </th>
                        <th class="text-end">100.0</th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f5w_expense_data['summary']['total_amount'])" /></strong>
                        </th>
                        <th class="text-end">100.0</th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f5w_expense_data['summary']['diff_amount'])" /></strong>
                        </th>
                        <th class="text-end">
                            <strong><t t-out="'{0:,.2f}'.format(o.f5w_expense_data['summary']['diff_percentage'])" /></strong>
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </template>

    <!-- Main F5 report template -->
    <template id="report_f5w_expense">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-call="budget_appropriation_report.report_common_styles" />
                    <t t-call="budget_appropriation_report.report_f5w_expense_content" />
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_f5w_expense" model="ir.actions.report">
        <field name="name">F5W - สรุปเปรียบเทียบประมาณการรายจ่ายจําแนกตามกิจกรรม</field>
        <field name="model">budget.appropriation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_report.report_f5w_expense</field>
        <field name="report_file">budget_appropriation_report.report_f5w_expense</field>
        <field name="paperformat_id" ref="budget_appropriation_report_paperformat_landscape" />
    </record>
</odoo>
