<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Common styles template shared across all reports -->
    <template id="report_common_styles">
        <style>
            * {
                font-family: "THSarabunNew", Arial, sans-serif;
                --bs-body-font-size: 16pt;
            }
            p,
            span,
            div {
                font-size: 16pt;
                line-height: 1.2;
            }
            .header-box {
                border: 1px solid #000;
                padding: 15px 30px;
                text-align: center;
                display: inline-block;
            }
            .header-text {
                font-size: 18pt;
                font-weight: normal;
            }
        </style>
    </template>
</odoo>
