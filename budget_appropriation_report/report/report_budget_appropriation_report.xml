<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_budget_appropriation_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        p,
                        span,
                        div {
                            font-size: 16pt;
                            line-height: 1.2;
                        }
                        .header-box {
                            border: 1px solid #000;
                            padding: 15px 30px;
                            text-align: center;
                            display: inline-block;
                        }
                        .header-text {
                            font-size: 18pt;
                            font-weight: normal;
                        }
                        @page landscape-page { size: A4 landscape; }
                        .landscape { page: landscape-page; }
                    </style>

                    <div class="page landscape" style="width: 100%;">
                        <div class="text-center mt-5 mb-5">
                            <div class="header-box">
                                <div class="header-text">
                                    มติที่ประชุมสภาสถาบัน ครั้งที่
                                    <t t-esc="o.council_meeting_no or '-'" />
                                </div>
                                <div class="header-text">
                                    วันที่
                                    <t t-if="o.council_meeting_date">
                                        <t
                                            t-esc="o.council_meeting_date.strftime('%d')"
                                        />
                                        <t
                                            t-esc="dict([('01','มกราคม'),('02','กุมภาพันธ์'),('03','มีนาคม'),('04','เมษายน'),('05','พฤษภาคม'),('06','มิถุนายน'),('07','กรกฎาคม'),('08','สิงหาคม'),('09','กันยายน'),('10','ตุลาคม'),('11','พฤศจิกายน'),('12','ธันวาคม')]).get(o.council_meeting_date.strftime('%m'), '')"
                                        />
                                        พ.ศ.
                                        <t t-esc="o.council_meeting_date.year + 543" />
                                    </t>
                                    <t t-else="">-</t>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-5 mb-3" style="font-weight: bold">
                            <div>สรุปเปรียบเทียบประมาณการรายรับ</div>
                            <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                            <div>จําแนกตามประเภท</div>
                        </div>
                        <style>
                            .f2-w tr:last-child td {
                                padding-bottom: 36px;
                            }
                        </style>
                        <table class="table table-sm table-bordered f2-w">
                            <thead>
                                <tr>
                                    <th style="width: 40%" rowspan="2">ประเภท</th>
                                    <th colspan="2" class="text-center">ปีงบประมาณ</th>
                                    <th colspan="2" class="text-center">ปีงบประมาณ</th>
                                    <th rowspan="2" class="text-center">
                                        + เพิ่ม - ลด <br />
                                        จำนวนเงิน
                                    </th>
                                    <th
                                        rowspan="2"
                                        class="text-center"
                                        style="width: 80px"
                                    >
                                        %
                                    </th>
                                </tr>
                                <tr>
                                    <th class="text-center">ปี</th>
                                    <th class="text-center" style="width: 60px">%</th>
                                    <th class="text-center">
                                        ปี <t t-esc="o.account_fiscal_year_id.name" />
                                    </th>
                                    <th class="text-center" style="width: 60px">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1. รายรับจากรัฐบาล</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">0.00</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">0.00</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">0.00</td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>2. เงินรายได้</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0.00</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <t
                                                t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['total_amount'])"
                                            />
                                        </strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>100.0</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0.00</strong>
                                    </td>
                                </tr>
                                <t
                                    t-foreach="o.f2_revenue_data['categories']"
                                    t-as="row"
                                >
                                    <tr>
                                        <td class="ps-4" t-esc="row['name']" />
                                        <td class="text-end">0</td>
                                        <td class="text-end">0.00</td>
                                        <td class="text-end">
                                            <t
                                                t-out="'{0:,.2f}'.format(row['amount'])"
                                            />
                                        </td>
                                        <td
                                            class="text-end"
                                            t-esc="row['percentage']"
                                        />
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="padding-top: 60px">
                                    <th class="text-center">รวมรายได้ทั้งสิ้น</th>
                                    <th class="text-end"></th>
                                    <th class="text-end"></th>
                                    <th class="text-end">
                                        <strong>
                                            <t
                                                t-out="'{0:,.2f}'.format(o.f2_revenue_data['summary']['total_amount'])"
                                            />
                                        </strong>
                                    </th>
                                    <th class="text-end">100.0</th>
                                    <th class="text-end"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <style>
                        .f4-p table tbody.category tr:last-child td {
                            padding-bottom: 36px;
                        }
                    </style>
                    <div class="page f4-p">
                        <div class="text-center mt-5 mb-3" style="font-weight: bold">
                            <div>
                                สรุปประมาณการรายรับ ประจําปีงบประมาณ
                                <t t-esc="o.account_fiscal_year_id.name" />
                            </div>
                            <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                        </div>
                        <div>
                            <table class="table table-sm table-borderless">
                                <thead>
                                    <tr>
                                        <th style="width: 60%" />
                                        <th style="width: 20%" />
                                        <th style="width: 20%" />
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th colspan="3">
                                            <strong>
                                                <u> รายรับ :- </u>
                                            </strong>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="ps-3">1. รายรับจากรัฐบาล</th>
                                        <th />
                                        <th class="text-end">0 บาท</th>
                                    </tr>
                                    <tr>
                                        <td class="ps-3" colspan="2">2. เงินรายได้</td>
                                        <td class="text-end">
                                            <strong>
                                                <t
                                                    t-out="'{0:,.2f}'.format(o.f4p_revenue_data['summary']['total_amount'])"
                                                />
                                                บาท
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                                <t t-set="row_no" t-value="1" />
                                <t
                                    t-foreach="o.f4p_revenue_data['categories']"
                                    t-as="row"
                                >
                                    <tbody class="category">
                                        <tr>
                                            <td class="ps-4" colspan="3">
                                                <strong>
                                                    <u>
                                                        2.<t t-esc="row_no" />
                                                        <t t-esc="row['name']" />
                                                    </u>
                                                </strong>
                                            </td>
                                        </tr>
                                        <t t-foreach="row['departments']" t-as="dept">
                                            <tr class="department">
                                                <td class="ps-5">
                                                    - <t t-esc="dept['name']" />
                                                </td>
                                                <td class="text-end">
                                                    <t
                                                        t-out="'{0:,.2f}'.format(dept['amount'])"
                                                    />
                                                </td>
                                                <td />
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-end">รวม</td>
                                            <td class="text-end">
                                                <strong>
                                                    <u>
                                                        <t
                                                            t-out="'{0:,.2f}'.format(row['amount'])"
                                                        />
                                                    </u>
                                                </strong>
                                            </td>
                                            <td />
                                        </tr>
                                    </tbody>
                                    <t t-set="row_no" t-value="row_no + 1" />
                                </t>
                                <tbody>
                                    <tr>
                                        <td class="text-end">
                                            <strong>รวมรายรับทั้งสิ้น</strong>
                                        </td>
                                        <td
                                            class="text-end"
                                            style="
                                                text-decoration: underline;
                                                text-decoration-style: double;
                                                font-weight: bold;
                                            "
                                        >
                                            <t
                                                t-out="'{0:,.2f}'.format(o.f4p_revenue_data['summary']['total_amount'])"
                                            />
                                        </td>
                                        <td />
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <style>
                        .f4-w table tbody.category tr:last-child td {
                            padding-bottom: 0px;
                        }

                        .f4-w table .table td {
                            border-color: #000 !important;
                        }
                    </style>
                    <div class="page f4-w">
                        <div class="text-center mt-5 mb-3" style="font-weight: bold">
                            <div>
                                สรุปเปรียบเทียบประมาณการรายรับ ปีงบประมาณ พ.ศ. <t t-esc="o.compare_report_id.account_fiscal_year_id.name" /> และ <t t-esc="o.account_fiscal_year_id.name" />
                            </div>
                            <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                            <div>จําแนกตามหน่วยงานและประเภท</div>
                        </div>
                        <div>
                            <table class="table table-sm table-bordered ">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width: 40%" rowspan="2">หน่วยงาน</th>
                                        <th class="text-center" style="width: 20%" colspan="2">ปีงบประมาณ <t t-esc="o.compare_report_id.account_fiscal_year_id.name" /></th>
                                        <th class="text-center" style="width: 20%" colspan="2">ปีงบประมาณ <t t-esc="o.account_fiscal_year_id.name" /></th>
                                        <th class="text-center" style="width: 20%" colspan="2">+ เพิ่ม - ลด</th>
                                    </tr>
                                    <tr>
                                        <th class="text-center" style="width: 15%">เงินรายได้</th>
                                        <th class="text-center" style="width: 5%">%</th>
                                        <th class="text-center" style="width: 15%">เงินรายได้</th>
                                        <th class="text-center" style="width: 5%">%</th>
                                        <th class="text-center" style="width: 15%">เงินรายได้</th>
                                        <th class="text-center" style="width: 5%">%</th>
                                    </tr>
                                </thead>
                                <tbody class="category">
                                <t t-set="row_no" t-value="1" />
                                <t
                                    t-foreach="o.f4w_revenue_data['departments']"
                                    t-as="row"
                                >
                                        <tr class="border-0">
                                            <td class="border-0 border-start border-black">
                                                <strong>
                                                    <u>
                                                        <t t-esc="row_no" />.
                                                        <t t-esc="row['name']" />
                                                    </u>
                                                </strong>
                                            </td>
                                            <td class="border-0 text-end">
                                                <t t-out="'{0:,.2f}'.format(row['compare_amount'])" />
                                            </td>
                                            <td class="border-0 text-end">
                                                100.0
                                            </td>
                                            <td class="border-0 text-end">
                                                <t t-out="'{0:,.2f}'.format(row['amount'])" />
                                            </td>
                                            <td class="border-0 text-end">
                                                100.0
                                            </td>
                                            <td class="border-0 text-end">
                                                <t t-out="'{0:,.2f}'.format(row['diff_amount'])" />
                                            </td>
                                            <td class="border-0 text-end border-end">
                                                <t t-out="'{0:,.2f}'.format(row['diff_percentage'])" />
                                            </td>
                                        </tr>
                                        <t t-foreach="row['categories']" t-as="category">
                                            <tr class="department border-0">
                                                <td class="ps-5 border-0 border-start">
                                                    - <t t-esc="category['name']" />
                                                </td>
                                                <td class="text-end border-0">
                                                    <t
                                                        t-out="'{0:,.2f}'.format(category['amount'])"
                                                    />
                                                </td>
                                                <td class="text-end border-0">
                                                    <t t-out="category['percentage']" />
                                                </td>
                                                <td class="text-end border-0">
                                                    <t
                                                        t-out="'{0:,.2f}'.format(category['amount'])"
                                                    />
                                                </td>
                                                <td class="text-end border-0">
                                                    <t t-out="category['percentage']" />
                                                </td>
                                                <td class="text-end border-0">
                                                    <t t-out="'{0:,.2f}'.format(category['diff_amount'])" />
                                                </td>
                                                <td class="text-end border-0 border-end">
                                                    <t t-out="'{0:,.2f}'.format(category['diff_percentage'])" />
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-set="row_no" t-value="row_no + 1" />
                                    </t>
                                </tbody>
                                <tbody>
                                    <tr>
                                        <td class="text-center">
                                            <strong>รวมทั้งสิ้น</strong>
                                        </td>
                                        <td
                                            class="text-end"
                                            style="font-weight: bold;"
                                        >
                                            <t
                                                t-out="'{0:,.2f}'.format(o.f4p_revenue_data['summary']['compare_total_amount'])"
                                            />
                                        </td>
                                        <td
                                            class="text-end"
                                            style="font-weight: bold;"
                                        >
                                            <t t-out="'{0:,.2f}'.format(100)" />
                                        </td>
                                        <td
                                            class="text-end"
                                            style="font-weight: bold;"
                                        >
                                            <t
                                                t-out="'{0:,.2f}'.format(o.f4p_revenue_data['summary']['total_amount'])"
                                            />
                                        </td>
                                        <td
                                            class="text-end"
                                            style="font-weight: bold;"
                                        >
                                            <t t-out="'{0:,.2f}'.format(100)" />
                                        </td>
                                        <td
                                            class="text-end"
                                            style="font-weight: bold;"
                                        >
                                            <t
                                                t-out="'{0:,.2f}'.format(o.f4p_revenue_data['summary']['diff_amount'])"
                                            />
                                        </td>
                                        <td
                                            class="text-end"
                                            style="font-weight: bold;"
                                        >
                                            <t t-out="'{0:,.2f}'.format(o.f4p_revenue_data['summary']['diff_percentage'])" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_budget_appropriation_report" model="ir.actions.report">
        <field name="name">Budget Appropriation Report</field>
        <field name="binding_model_id" ref="model_budget_appropriation_report" />
        <field name="model">budget.appropriation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name"
            >budget_appropriation_report.report_budget_appropriation_report</field
        >
        <field name="report_file"
            >budget_appropriation_report.report_budget_appropriation_report</field
        >
    </record>
</odoo>
