<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_budget_appropriation_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <style>
                        * {
                            font-family: "THSarabunNew", Arial, sans-serif;
                            --bs-body-font-size: 16pt;
                        }
                        p,
                        span,
                        div {
                            font-size: 16pt;
                            line-height: 1.2;
                        }
                        .header-box {
                            border: 1px solid #000;
                            padding: 15px 30px;
                            text-align: center;
                            display: inline-block;
                        }
                        .header-text {
                            font-size: 18pt;
                            font-weight: normal;
                        }
                    </style>

                    <div class="page">
                        <div class="text-center mt-5 mb-5">
                            <div class="header-box">
                                <div class="header-text">
                                    มติที่ประชุมสภาสถาบัน ครั้งที่
                                    <t t-esc="o.council_meeting_no or '-'" />
                                </div>
                                <div class="header-text">
                                    วันที่
                                    <t t-if="o.council_meeting_date">
                                        <t
                                            t-esc="o.council_meeting_date.strftime('%d')"
                                        />
                                        <t
                                            t-esc="dict([('01','มกราคม'),('02','กุมภาพันธ์'),('03','มีนาคม'),('04','เมษายน'),('05','พฤษภาคม'),('06','มิถุนายน'),('07','กรกฎาคม'),('08','สิงหาคม'),('09','กันยายน'),('10','ตุลาคม'),('11','พฤศจิกายน'),('12','ธันวาคม')]).get(o.council_meeting_date.strftime('%m'), '')"
                                        />
                                        พ.ศ.
                                        <t t-esc="o.council_meeting_date.year + 543" />
                                    </t>
                                    <t t-else="">-</t>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-5 mb-3" style="font-weight: bold">
                            <div>สรุปเปรียบเทียบประมาณการรายรับ</div>
                            <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                            <div>จําแนกตามประเภท</div>
                        </div>
                        <style>
                            .f2-w tr:last-child td {
                                padding-bottom: 60px;
                            }
                        </style>
                        <table class="table table-sm table-bordered f2-w">
                            <thead>
                                <tr>
                                    <th style="width: 40%" rowspan="2">ประเภท</th>
                                    <th colspan="2" class="text-center">ปีงบประมาณ</th>
                                    <th colspan="2" class="text-center">ปีงบประมาณ</th>
                                    <th rowspan="2" class="text-center">
                                        + เพิ่ม - ลด <br />
                                        จำนวนเงิน
                                    </th>
                                    <th
                                        rowspan="2"
                                        class="text-center"
                                        style="width: 80px"
                                    >
                                        %
                                    </th>
                                </tr>
                                <tr>
                                    <th class="text-center">ปี</th>
                                    <th class="text-center" style="width: 60px">%</th>
                                    <th class="text-center">
                                        ปี <t t-esc="o.account_fiscal_year_id.name" />
                                    </th>
                                    <th class="text-center" style="width: 60px">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1. รายรับจากรัฐบาล</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">0.00</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">0.00</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">0.00</td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>2. เงินรายได้</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0.00</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            ><t
                                                t-esc="o.f2_revenue_data['summary']['total_amount']"
                                        /></strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>100.00</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>0.00</strong>
                                    </td>
                                </tr>
                                <t
                                    t-foreach="o.f2_revenue_data['categories']"
                                    t-as="row"
                                >
                                    <tr>
                                        <td class="ps-4" t-esc="row['name']" />
                                        <td class="text-end">0</td>
                                        <td class="text-end">0.00</td>
                                        <td class="text-end" t-esc="row['amount']" />
                                        <td
                                            class="text-end"
                                            t-esc="row['percentage']"
                                        />
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="padding-top: 60px">
                                    <th class="text-center">รวมรายได้ทั้งสิ้น</th>
                                    <th class="text-end"></th>
                                    <th class="text-end"></th>
                                    <th class="text-end">
                                        <strong
                                            ><t
                                                t-esc="o.f2_revenue_data['summary']['total_amount']"
                                        /></strong>
                                    </th>
                                    <th class="text-end">100.00</th>
                                    <th class="text-end"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <style>
                        .f4-p table tbody.category tr:last-child td {
                            padding-bottom: 36px;
                        }
                    </style>
                    <div class="page f4-p">
                        <div class="text-center mt-5 mb-3" style="font-weight: bold">
                            <div>
                                สรุปประมาณการรายรับ ประจําปีงบประมาณ
                                <t t-esc="o.account_fiscal_year_id.name" />
                            </div>
                            <div>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</div>
                        </div>
                        <div>
                            <table class="table table-sm table-borderless">
                                <thead>
                                    <tr>
                                        <th style="width: 40%" />
                                        <th style="width: 40%" />
                                        <th style="width: 20%" />
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th colspan="3">
                                            <strong>
                                                <u> รายรับ :- </u>
                                            </strong>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="ps-3" style="width: 40%">
                                            1. รายรับจากรัฐบาล
                                        </th>
                                        <th style="width: 40%" />
                                        <th class="text-end" style="width: 20%">
                                            0 บาท
                                        </th>
                                    </tr>
                                    <tr>
                                        <td class="ps-3" colspan="2">2. เงินรายได้</td>
                                        <td class="text-end">
                                            <strong>
                                                <t
                                                    t-esc="o.f4p_revenue_data['summary']['total_amount']"
                                                />
                                                บาท
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                                    <t
                                        t-foreach="o.f4p_revenue_data['categories']"
                                        t-as="row"
                                    >
                                        <tbody  class="category">
                                            <tr>
                                            <td class="ps-4">
                                                <strong>
                                                    <u>
                                                        <t t-esc="row['name']" />
                                                    </u>
                                                </strong>
                                            </td>
                                            <td class="text-end">
                                                <strong
                                                    ><u><t t-esc="row['amount']" /></u
                                                ></strong>
                                            </td>
                                            <td />
                                        </tr>
                                        <t t-foreach="row['departments']" t-as="dept">
                                            <tr class="department">
                                                <td class="ps-5">
                                                    - <t t-esc="dept['name']" />
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="dept['amount']" />
                                                </td>
                                                <td />
                                            </tr>
                                        </t>
                                        </tbody>
                                    </t>
                                <tbody>
                                    <tr>
                                        <td class="text-center">
                                                    <strong
                                                    ><u>รวมรายรับทั้งสิ้น</u
                                                ></strong>
                                        </td>
                                                <td class="text-end">
                                                    <t t-esc="o.f4p_revenue_data['summary']['total_amount']" />
                                                </td>
                                                <td />
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_budget_appropriation_report" model="ir.actions.report">
        <field name="name">Budget Appropriation Report</field>
        <field name="binding_model_id" ref="model_budget_appropriation_report" />
        <field name="model">budget.appropriation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name"
            >budget_appropriation_report.report_budget_appropriation_report</field
        >
        <field name="report_file"
            >budget_appropriation_report.report_budget_appropriation_report</field
        >
    </record>
</odoo>
