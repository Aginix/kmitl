<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Combined report that includes all sub-reports via t-call -->
    <template id="report_budget_appropriation_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                    <t t-call="budget_appropriation_report.report_common_styles" />

                    <!-- F2 Report - สรุปเปรียบเทียบประมาณการรายรับจําแนกตามประเภท -->
                    <t t-call="budget_appropriation_report.report_f2_revenue_content" />

                    <!-- F4-P Report - สรุปประมาณการรายรับจําแนกตามหน่วยงานและประเภท -->
                    <t t-call="budget_appropriation_report.report_f4p_revenue_content" />

                    <!-- F4-W Report - สรุปเปรียบเทียบประมาณการรายรับจําแนกตามหน่วยงานและประเภท -->
                    <t t-call="budget_appropriation_report.report_f4w_revenue_content" />
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_budget_appropriation_report" model="ir.actions.report">
        <field name="name">รายงานรวมทั้งหมด</field>
        <field name="model">budget.appropriation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">budget_appropriation_report.report_budget_appropriation_report</field>
        <field name="report_file">budget_appropriation_report.report_budget_appropriation_report</field>
    </record>
</odoo>
