<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_all_ou_purchase_guarantee" model="res.groups">
            <field name="name">Access all OUs' purchase guarantee</field>
            <field name="category_id" ref="operating_unit.module_operating_units" />
        </record>
    </data>

    <function model="ir.rule" name="write">
        <value
            eval="[ref('purchase_guarantee_operating_unit.ir_rule_purchase_guarantee_operating_units')"
        />
        <value
            eval="{'domain_force': &quot;['|','|',(1, '=', 1) if user.has_group('purchase_guarantee_operating_unit_access_all.group_all_ou_purchase_guarantee') else (0, '=', 1),('operating_unit_id','=',False),('operating_unit_id','in', user.operating_unit_ids.ids)]&quot;}"
        />
    </function>
</odoo>
