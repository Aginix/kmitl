<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_all_ou_purchase_guarantee" model="res.groups">
            <field name="name">Access all OUs' purchase guarantee</field>
            <field name="category_id" ref="operating_unit.module_operating_units" />
        </record>
    </data>

    <record id="ir_rule_purchase_guarantee_all_ou" model="ir.rule">
        <field name="model_id" ref="l10n_th_gov_purchase_guarantee.model_purchase_guarantee" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="name">Purchase Guarantee All Operating Units</field>
        <field name="groups" eval="[(6, 0, [ref('group_all_ou_purchase_guarantee')])]"/>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>
