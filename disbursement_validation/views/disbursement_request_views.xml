<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_validation)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <field name="arch" type="xml">
            <button name="action_draft" position="before">
                <button
                    name="action_validate"
                    string="Validate"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('can_validate', '=', False)]}"
                    confirm="Are you sure you want to validate this request?"
                    groups="disbursement.group_disbursement_officer"
                />
                <field name="can_validate" invisible="1" />
            </button>
            <group id="dates" position="inside">
                <field name="verify_date" string="Verification Date" widget="date" />
            </group>
            <group id="other_information" position="inside">
                <field
                    name="verifier_id"
                    attrs="{'invisible': [('verifier_id', '=', False)]}"
                />
            </group>
        </field>
    </record>
</odoo>
