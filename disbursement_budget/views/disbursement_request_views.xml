<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_tree" model="ir.ui.view">
        <field name="name">disbursement.request.tree (disbursement_budget)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_tree" />
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <field name="main_exception_id" position="after">
                <field name="budget_commitment_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form (disbursement_budget)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form" />
        <!-- Below the default 16 so it applies before the bridges' inherits that
             already exist on upgraded databases (lower ids) and xpath / attrs on
             the budget fields this view adds. -->
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <button name="action_approve" position="attributes">
                <attribute name="confirm">Are you sure you want to approve? This will obligate and consume the budget.</attribute>
            </button>
            <button name="action_draft" position="before">
                <button name="action_return_leftover_budget" string="ส่งคืนเงินเหลือจ่าย" type="object" attrs="{'invisible': ['|', ('budget_consumed_amount', '&lt;=', 0), ('budget_available_to_obligate', '&lt;=', 0)]}" groups="disbursement.group_disbursement_manager" />
                <field name="budget_available_to_obligate" invisible="1"/>
            </button>
            <header position="after">
                <!-- Budget Consumed Banner -->
                <div class="alert alert-success" role="alert" style="margin-bottom:0px;" attrs="{'invisible': [('budget_consumed_amount', '=', 0)]}">
                    <strong>ตัดงบประมาณแล้ว:</strong>
                    <field name="budget_consumed_amount" widget="monetary" class="oe_inline" nolabel="1"/>
                    <span> เมื่อ </span>
                    <field name="budget_consumed_date" class="oe_inline" nolabel="1"/>
                </div>
            </header>
            <field name="account_fiscal_year_id" position="after">
                <field name="budget_commitment_id" />
            </field>
            <!-- The linked commitment carries the dimensions: lock them once set. -->
            <field name="source_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('budget_commitment_id', '!=', False), ('state', '!=', 'draft')]}</attribute>
            </field>
            <field name="department_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('budget_commitment_id', '!=', False), ('state', '!=', 'draft')]}</attribute>
            </field>
            <field name="fund_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('budget_commitment_id', '!=', False), ('state', '!=', 'draft')]}</attribute>
            </field>
            <field name="activity_analytic_id" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('budget_commitment_id', '!=', False), ('state', '!=', 'draft')]}</attribute>
            </field>
            <field name="activity_analytic_id" position="after">
                <!-- force_save: filled by the commitment onchange while readonly. -->
                <field name="budget_account_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': ['|', ('budget_commitment_id', '!=', False), ('state', '!=', 'draft')]}" force_save="1" />
                <!-- Loaded (hidden) so the line list can hide the
                     product column via parent. -->
                <field name="is_budget_account_product_expense" invisible="1" />
            </field>
            <xpath expr="//group[@name='dates']" position="inside">
                <field name="budget_consumed_date" string="Budget Consumed / Disbursed On" widget="date" />
            </xpath>
            <xpath expr="//group[@name='budget_information']/field[@name='currency_id']" position="before">
                <field name="budget_consumed_amount" attrs="{'invisible': [('budget_consumed_amount', '=', 0)]}" />
            </xpath>
            <!-- Budget codes that carry their own product stamp it
                 automatically, so the whole column is hidden and only
                 ordinary disbursements pick a product by hand. -->
            <xpath expr="//field[@name='line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="attrs">{'column_invisible': [('parent.is_budget_account_product_expense', '=', True)], 'required': [('parent.is_budget_account_product_expense', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
