<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.analytic.account.public View Tree -->
    <record id="view_account_analytic_account_public_tree" model="ir.ui.view">
        <field name="name">view.account.analytic.account.public.tree</field>
        <field name="model">account.analytic.account.public</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View account.analytic.account.public form -->
    <record id="view_account_analytic_account_public_form" model="ir.ui.view">
        <field name="name">view.account.analytic.account.public.form</field>
        <field name="model">account.analytic.account.public</field>
        <field name="arch" type="xml">
            <form string="Account Analytic Account Public">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View account.analytic.account.public search -->
    <record id="view_account_analytic_account_public_search" model="ir.ui.view">
        <field name="name">view.account.analytic.account.public.search</field>
        <field name="model">account.analytic.account.public</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action account.analytic.account.public -->
    <record id="action_account_analytic_account_public" model="ir.actions.act_window">
        <field name="name">Account Analytic Account Public</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.analytic.account.public</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Account Analytic Account Public.
            </p>
        </field>
    </record>

</odoo>
