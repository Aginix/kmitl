<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Change date -->
    <record id="ir_cron_recompute_expire" model="ir.cron">
        <field name="name">Recompute Contract Expire Days</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model.action_recompute_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <!-- Notification -->
    <record id="ir_cron_notify_contract_expire" model="ir.cron">
        <field name="name">Notify Contract Nearly Expire</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_contract_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>