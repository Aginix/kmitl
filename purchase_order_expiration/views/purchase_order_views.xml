<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order tree -->
    <record id="view_purchase_order_tree_expiring" model="ir.ui.view">
        <field name="name">purchase.order.tree.expiring</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <tree string="Contracts Nearly Expiring" 
                  decoration-muted="days_to_expire &lt; 0"
                  decoration-danger="days_to_expire &lt; 15 and days_to_expire &gt;= 0"
                  decoration-warning="days_to_expire &lt; 30 and days_to_expire &gt;= 15">
                <field name="contract_name"/>
                <field name="contract_number"/>
                <field name="partner_id"/>
                <field name="work_end"/>
                <field name="days_to_expire" invisible="1"/>
                <field name="days_to_expire_display"/>
                <field name="expire_range" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_order_search_expiring" model="ir.ui.view">
        <field name="name">purchase.order.search.expiring</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" name="group_by" string="Group By">
                    <filter name="group_by_expire_range" string="Expire Range"
                            context="{'group_by':'expire_range'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contracts_expiring" model="ir.actions.act_window">
        <field name="name">Contract Nearly Expire</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="purchase_order_expiration.view_purchase_order_tree_expiring"/>
        <field name="search_view_id" ref="purchase_order_expiration.view_purchase_order_search_expiring"/>
        <field name="domain">[('days_to_expire', '&lt;', 90)]</field>
        <field name="context">{'search_default_group_by_expire_range': 1}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_purchase_cotract_expire"
              name="Contract Nearly Expire"
              parent="purchase_kmitl.menu_purchase_tracking"
              action="purchase_order_expiration.action_contracts_expiring"
              sequence="20"/>

  </odoo>