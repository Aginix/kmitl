<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View res.config.settings form -->
    <record id="res_config_settings_view_form_purchase_notification" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='purchase']" position="inside">
                <h2>Contract Expiry Notification</h2>
                <div
                    class="row mt16 o_settings_container"
                    name="purchase_contract_notification"
                >
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="purchase_contract_notification"
                    >
                        <div class="o_setting_right_pane">
                            <label
                                for="purchase_contract_notify_days"
                            />
                            <div class="text-muted">
                                Notify purchase users when contract expires within this many days
                            </div>
                            <div class="mt8">
                                <field name="purchase_contract_notify_days"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

  </odoo>