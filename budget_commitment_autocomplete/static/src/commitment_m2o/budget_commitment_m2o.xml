<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Rendered once per dropdown option, inside the autocomplete <a> item.
         `option` is in scope. Record options carry `option.commitmentInfo`
         (from get_reservation_info); action rows (Create…/Search More…) do
         not — fall back to their plain label. -->
    <t t-name="budget_commitment_m2o.Option" owl="1">
        <t t-if="option.commitmentInfo">
            <div class="o_bcm2o_option">
                <div class="d-flex align-items-center gap-1">
                    <i class="fa fa-bookmark text-primary"/>
                    <strong t-esc="option.commitmentInfo.name"/>
                    <span t-if="option.commitmentInfo.title" class="text-truncate"
                        t-esc="option.commitmentInfo.title"/>
                </div>
                <div class="o_bcm2o_rows">
                    <span t-foreach="option.commitmentInfo.rows" t-as="row" t-key="row_index"
                        class="o_bcm2o_row">
                        <small class="text-muted" t-esc="row.label"/>
                        <span t-esc="row.value"/>
                    </span>
                </div>
                <div t-foreach="option.commitmentInfo.amounts" t-as="amount"
                    t-key="'amt_' + amount_index" class="o_bcm2o_amount">
                    <small class="text-muted" t-esc="amount.label"/>
                    <strong t-esc="amount.value"/>
                </div>
            </div>
        </t>
        <t t-else="">
            <t t-esc="option.label"/>
        </t>
    </t>
</templates>
