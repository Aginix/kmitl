<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">view.form(Approval Disbursement)</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_to_approve']" position="after">
                <field name="use_purchase_order" invisible="1" />
                <field name="purchase_count" invisible="1" />
                <button
                    name="approval_make_purchase_order"
                    string="Create Purchase Order"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', '|', ('use_purchase_order', '=', False), ('purchase_count', '&gt;', 0), ('state', 'not in', ['approved'])]}"
                />
                <button
                    name="action_disbursement_request"
                    string="Create Bill"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', '|', ('use_purchase_order', '=', True), ('disbursement_request_count', '&gt;', 0), ('state', 'not in', ['approved'])]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_purchase_order"
                    type="object"
                    icon="fa-book"
                    class="oe_highlight"
                    attrs="{'invisible': [('purchase_count', '=', 0)]}"
                >
                    <field
                        name="purchase_count"
                        widget="statinfo"
                        string="Purchase Orders"
                    />
                </button>
                <button
                    name="action_view_disbursement_request"
                    type="object"
                    icon="fa-exchange"
                    class="oe_highlight"
                    attrs="{'invisible': [('disbursement_request_count', '=', 0)]}"
                >
                    <field
                        name="disbursement_request_count"
                        widget="statinfo"
                        string="Disbursement Request"
                    />
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="after">
                <field
                    name="billing_status"
                    readonly="1"
                    widget="badge"
                    decoration-info="billing_status == 'draft'"
                    decoration-warning="billing_status == 'submitted'"
                    decoration-primary="billing_status == 'in_progress'"
                    decoration-success="billing_status == 'done'"
                    decoration-danger="billing_status == 'cancel'"
                />
            </xpath>
            <xpath expr="//group[1]" position="before">
                <h2>Purchase Request Approval Form</h2>
                <group>
                    <group>
                        <field
                            name="use_purchase_order"
                            attrs="{'readonly': [('state', 'not in', ['draft'])]}"
                        />
                        <div class="alert alert-info mt16" role="alert" colspan="2"
                            attrs="{'invisible': [('use_purchase_order', '=', False)]}">
                            <strong>Note:</strong>
                            If you select "Use Purchase Order", you must create a Purchase Order.
                        </div>
                    </group>
                </group>
            </xpath>
            <!-- Return-to-source correction: Confirm button + statusbar + fields -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="before">
                <button name="action_confirm_correction" type="object" string="Confirm Correction" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'returned')]}"/>
            </xpath>
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,validate,to_approve,approved,returned,reject</attribute>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning" role="alert" attrs="{'invisible': [('state', '!=', 'returned')]}">
                    <p><strong>Returned for correction.</strong> The disbursement officer returned the linked disbursement request. Correct the payee bank account and note and/or attach evidence below, then click <b>Confirm Correction</b>.</p>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group name="disbursement_correction" string="Disbursement Correction" attrs="{'invisible': [('state', '!=', 'returned')]}">
                    <field name="partner_id" invisible="1"/>
                    <field name="disbursement_return_bank_id" domain="[('partner_id', '=', partner_id)]" options="{'no_create': True}"/>
                    <field name="disbursement_return_note"/>
                    <field name="disbursement_return_attachment_ids" widget="many2many_binary"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_approval_tree" model="ir.ui.view">
        <field name="name">view.tree(Approval Disbursement)</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requested_by']" position="before">
                <field name="billing_status" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="after">
                <field name="display_purchase_order" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_approval_search" model="ir.ui.view">
        <field name="name">view.search(Approval Disbursement)</field>
        <field name="model">purchase.request.approval</field>
        <field
            name="inherit_id"
            ref="purchase_request_approval.view_purchase_request_approval_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="billing_status" string="Bill Status" />
            </xpath>
        </field>
    </record>
</odoo>
