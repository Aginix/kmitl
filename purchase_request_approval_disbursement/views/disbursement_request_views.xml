<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">view.disbursement.request.form</field>
        <field name="model">disbursement.request</field>
        <field
            name="inherit_id"
            ref="disbursement.view_disbursement_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_type_id']" position="before">
                <field
                    name="purchase_request_approval_id"
                    attrs="{'invisible': [('purchase_request_approval_id', '=', False)]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_purchase_approval"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-contract"
                    string="PA"
                    attrs="{'invisible': [('purchase_request_approval_id', '=', False)]}"
                    groups="purchase.group_purchase_user"
                ></button>
            </xpath>
        </field>
    </record>

    <record id="view_disbursement_request_search" model="ir.ui.view">
        <field name="name">disbursement.request.search (purchase_request_approval_disbursement)</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="purchase_request_approval_id" />
            </field>
        </field>
    </record>
</odoo>
