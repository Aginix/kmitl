<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_budget_commitment_exception_rule_tree" model="ir.actions.act_window">
        <field name="name">Budget Commitment Exception Rules</field>
        <field name="res_model">exception.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="base_exception.view_exception_rule_tree" />
        <field name="domain">[('model', '=', 'budget.commitment')]</field>
        <field
            name="context"
        >{'active_test': False, 'default_model': 'budget.commitment'}</field>
    </record>
    <menuitem
        id="menu_budget_commitment_exception_rule"
        name="Budget Commitment Exceptions"
        action="action_budget_commitment_exception_rule_tree"
        parent="budget.budget_config_menu"
        sequence="61"
        groups="base_exception.group_exception_rule_manager"
    />

    <!-- Non-blocking rules detected on จองงบ stay visible on the slip. -->
    <record id="budget_commitment_form_view" model="ir.ui.view">
        <field name="name">budget.commitment.form.exception</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    attrs="{'invisible': [('exceptions_summary', '=', False)]}"
                >
                    <field name="exceptions_summary" />
                </div>
            </sheet>
        </field>
    </record>
</odoo>
