<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View budget.commitment form -->
    <record id="view_budget_commitment_form_inherit" model="ir.ui.view">
        <field name="name">view.budget.commitment.form (account.move.request)</field>
        <field name="model">budget.commitment</field>
        <field name="inherit_id" ref="budget.budget_commitment_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="account_move_request_count" invisible="1" />
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_account_move_requests"
                    string="Account Move Requests"
                    icon="fa-file-invoice-dollar"
                    attrs="{'invisible': [('account_move_request_count', '=', 0)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
