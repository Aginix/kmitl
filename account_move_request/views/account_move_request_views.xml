<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_account_move_request_tree" model="ir.ui.view">
        <field name="name">account.move.request.tree</field>
        <field name="model">account.move.request</field>
        <field name="arch" type="xml">
            <tree string="Move Requests">
                <field name="name" />
                <field name="partner_id" />
                <field name="date" />
                <field name="ref" />
                <field name="amount_total" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state in ('approved', 'done')" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_account_move_request_form" model="ir.ui.view">
        <field name="name">account.move.request.form</field>
        <field name="model">account.move.request</field>
        <field name="arch" type="xml">
            <form string="Move Request">
                <header>
                    <button name="action_create_bill" string="Create Bill" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'validated'), ('bill_count', '>', 0)]}" />
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'submitted')]}" confirm="Are you sure you want to validate this request?" />
                    <button name="action_cancel" string="Cancel" type="object" attrs="{'invisible': [('state', '!=', 'validated')]}" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bill" type="object" class="oe_stat_button" icon="fa-pencil-square-o" attrs="{'invisible': [('bill_count', '=', 0)]}">
                            <field name="bill_count" widget="statinfo" string="Bill" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="date" />
                            <field name="ref" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Lines" name="lines">
                            <field name="line_ids" widget="one2many" context="{'default_request_id': active_id}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="product_id" />
                                    <field name="name" />
                                    <field name="quantity" />
                                    <field name="price_unit" />
                                    <field name="tax_ids" widget="many2many_tags" />
                                    <field name="account_id" />
                                    <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting" />
                                    <field name="price_subtotal" />
                                    <field name="price_tax" optional="hide" />
                                    <field name="price_total" />
                                    <field name="company_id" invisible="1" />
                                    <field name="currency_id" invisible="1" />
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed" />
                                <field name="amount_tax" />
                                <field name="amount_total" class="oe_subtotal_footer_separator" />
                            </group>
                            <div class="oe_clear" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_account_move_request_search" model="ir.ui.view">
        <field name="name">account.move.request.search</field>
        <field name="model">account.move.request</field>
        <field name="arch" type="xml">
            <search string="Move Requests">
                <field name="name" />
                <field name="partner_id" />
                <field name="ref" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]" />
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]" />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Partner" name="partner" context="{'group_by': 'partner_id'}" />
                    <filter string="Date" name="date" context="{'group_by': 'date'}" />
                    <filter string="State" name="state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_account_move_request" model="ir.actions.act_window">
        <field name="name">Move Requests</field>
        <field name="res_model">account.move.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Move Request
            </p>
            <p>
                Move requests are used to hold information before creating bills.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_account_move_request" name="Move Requests" parent="account.menu_finance_entries" action="action_account_move_request" sequence="10" />
</odoo>
