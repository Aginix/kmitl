<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ================================================================
         Document Type master (kept for the m2o edit-popup + quick-create;
         no menu, but the views must be registered so the m2o's
         "Search More" and edit dialog can find them)
         ================================================================ -->

    <record id="view_ir_attachment_document_type_tree" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.tree</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_ir_attachment_document_type_form" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.form</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Attachment Doctypes — model-first config
         Tree = one row per configured model. "New" creates a config
         (not a new ir.model), so `create="true"` is safe.
         ================================================================ -->

    <record id="view_attachment_classifier_model_config_tree" model="ir.ui.view">
        <field name="name">attachment.classifier.model.config.tree</field>
        <field name="model">attachment.classifier.model.config</field>
        <field name="arch" type="xml">
            <tree string="Attachment Doctypes">
                <field name="res_model_id"/>
            </tree>
        </field>
    </record>

    <record id="view_attachment_classifier_model_config_form" model="ir.ui.view">
        <field name="name">attachment.classifier.model.config.form</field>
        <field name="model">attachment.classifier.model.config</field>
        <field name="arch" type="xml">
            <form string="Attachment Doctypes">
                <sheet>
                    <group>
                        <field
                            name="res_model_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                            attrs="{'readonly': [('id', '!=', False)]}"
                        />
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="document_type_id"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attachment_classifier_model_config" model="ir.actions.act_window">
        <field name="name">Attachment Doctypes</field>
        <field name="res_model">attachment.classifier.model.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================================================================
         Menu
         ================================================================ -->

    <menuitem
        id="menu_ir_attachment_document_type_rel"
        name="Attachment Doctypes"
        parent="base.menu_ir_property"
        action="action_attachment_classifier_model_config"
        sequence="90"
    />

</odoo>
