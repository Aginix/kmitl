<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ================================================================
         Document Type master (kept for the m2o "Search More" / edit
         popup on document_type_id — not menu'd)
         ================================================================ -->

    <record id="view_ir_attachment_document_type_tree" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.tree</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_ir_attachment_document_type_form" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.form</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Attachment Doctypes (single settings entry)
         Tree on the rel table, grouped by res_model_id — only models
         with at least one mapping ever show up.
         ================================================================ -->

    <record id="view_ir_attachment_document_type_rel_tree" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.rel.tree</field>
        <field name="model">ir.attachment.document.type.rel</field>
        <field name="arch" type="xml">
            <tree default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="res_model_id"/>
                <field name="document_type_id"/>
            </tree>
        </field>
    </record>

    <record id="view_ir_attachment_document_type_rel_form" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.rel.form</field>
        <field name="model">ir.attachment.document.type.rel</field>
        <field name="arch" type="xml">
            <form string="Attachment Doctype">
                <sheet>
                    <group>
                        <field
                            name="res_model_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="document_type_id"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_attachment_document_type_rel" model="ir.actions.act_window">
        <field name="name">Attachment Doctypes</field>
        <field name="res_model">ir.attachment.document.type.rel</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'group_by': 'res_model_id'}</field>
    </record>

    <menuitem
        id="menu_ir_attachment_document_type_rel"
        name="Attachment Doctypes"
        parent="base.menu_ir_property"
        action="action_ir_attachment_document_type_rel"
        sequence="90"
    />

</odoo>
