<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ================================================================
         Document Type master (kept for the m2o edit-popup + quick-create;
         no menu, but the views must be registered so the m2o's
         "Search More" and edit dialog can find them)
         ================================================================ -->

    <record id="view_ir_attachment_document_type_tree" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.tree</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <tree string="Document Types">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_ir_attachment_document_type_form" model="ir.ui.view">
        <field name="name">ir.attachment.document.type.form</field>
        <field name="model">ir.attachment.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Attachment Doctypes (single settings entry — model-first)
         Tree on ir.model, filtered to models that have at least one
         Mapping. Custom form exposes only the classifier tab so we
         don't drag in ir.model's dense core form.
         ================================================================ -->

    <record id="view_ir_model_classifier_tree" model="ir.ui.view">
        <field name="name">ir.model.classifier.tree</field>
        <field name="model">ir.model</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree
                string="Attachment Doctypes"
                default_order="name"
                create="false"
            >
                <header>
                    <button
                        name="%(action_add_model_wizard)d"
                        type="action"
                        string="Add Model"
                        class="btn-primary"
                    />
                </header>
                <field name="name"/>
                <field name="model"/>
            </tree>
        </field>
    </record>

    <record id="view_ir_model_classifier_form" model="ir.ui.view">
        <field name="name">ir.model.classifier.form</field>
        <field name="model">ir.model</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Attachment Document Types" create="false">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="model" readonly="1"/>
                    </group>
                    <field name="attachment_doctype_rel_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="document_type_id"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_model_classifier" model="ir.actions.act_window">
        <field name="name">Attachment Doctypes</field>
        <field name="res_model">ir.model</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('attachment_doctype_rel_ids', '!=', False)]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'tree', 'view_id': ref('view_ir_model_classifier_tree')}),
                   (0, 0, {'view_mode': 'form', 'view_id': ref('view_ir_model_classifier_form')})]"
        />
    </record>

    <!-- ================================================================
         Add Model wizard (invoked from the tree's header button)
         ================================================================ -->

    <record id="view_add_model_wizard_form" model="ir.ui.view">
        <field name="name">attachment.classifier.add.model.wizard.form</field>
        <field name="model">attachment.classifier.add.model.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Model">
                <group>
                    <field name="res_model_id"/>
                </group>
                <footer>
                    <button
                        name="action_open"
                        type="object"
                        string="Continue"
                        class="btn-primary"
                    />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_add_model_wizard" model="ir.actions.act_window">
        <field name="name">Add Model</field>
        <field name="res_model">attachment.classifier.add.model.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================================================================
         Menu
         ================================================================ -->

    <menuitem
        id="menu_ir_attachment_document_type_rel"
        name="Attachment Doctypes"
        parent="base.menu_ir_property"
        action="action_ir_model_classifier"
        sequence="90"
    />

</odoo>
