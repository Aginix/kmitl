<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_attachment_classifier.Many2ManyBinaryClassifierField" owl="1">
        <div
            t-attf-class="oe_fileupload o_classifier_dropzone w-100 {{props.className ? props.className : ''}} {{ dragState.isDraggingOver ? 'o_dragging_over' : '' }}"
            aria-atomic="true"
            t-on-dragenter.prevent="onDragEnter"
            t-on-dragover.prevent="onDragOver"
            t-on-dragleave.prevent="onDragLeave"
            t-on-drop.prevent.stop="onDrop"
        >
            <div t-if="dragState.isDraggingOver" class="o_classifier_dropzone_overlay">
                <span class="fa fa-cloud-upload me-2"/>Drop files to attach
            </div>
            <div class="o_attachments_classifier d-flex flex-column gap-2">
                <t t-foreach="files" t-as="file" t-key="file.id">
                    <t t-set="editable" t-value="!props.readonly" />
                    <t t-set="ext" t-value="getExtension(file)" />
                    <div
                        class="o_attachment_row d-flex flex-row align-items-center border rounded p-2"
                        t-att-title="file.name"
                    >
                        <div
                            class="o_image_box"
                            t-att-data-tooltip="'Download ' + file.name"
                        >
                            <a
                                t-att-href="getUrl(file.id)"
                                aria-label="Download"
                                download=""
                            >
                                <span
                                    class="o_image"
                                    t-att-data-mimetype="file.mimetype"
                                    t-att-data-ext="ext"
                                    role="img"
                                />
                            </a>
                        </div>
                        <div class="flex-grow-1 ms-2 text-truncate">
                            <div class="text-truncate">
                                <a t-att-href="getUrl(file.id)" download="">
                                    <b t-esc="file.name" />
                                </a>
                                <span
                                    class="badge text-bg-light text-uppercase ms-1"
                                    t-esc="ext"
                                />
                            </div>
                            <div class="small text-muted">
                                <span t-esc="classifierLabel" />:
                                <span
                                    t-if="file.classifierName"
                                    class="badge text-bg-secondary ms-1"
                                    t-esc="file.classifierName"
                                />
                                <span t-else="" class="fst-italic ms-1">-</span>
                            </div>
                        </div>
                        <div
                            t-if="editable"
                            class="o_attachment_edit btn btn-link"
                            t-on-click.stop="() => this.onEditClick(file.id, file.classifierRawId)"
                            title="Edit"
                        >
                            <span class="fa fa-pencil" role="img" aria-label="Edit" />
                        </div>
                        <div
                            t-if="editable"
                            class="o_attachment_delete btn btn-link text-danger"
                            t-on-click.stop="() => this.onFileRemove(file.id)"
                            title="Delete"
                        >
                            <span class="fa fa-trash" role="img" aria-label="Delete" />
                        </div>
                    </div>
                </t>
            </div>
            <div t-if="!props.readonly" class="oe_add mt-2">
                <button
                    class="btn btn-secondary o_attach"
                    data-tooltip="Attach"
                    t-on-click="onAddClick"
                >
                    <span class="fa fa-paperclip me-1" aria-label="Attach" /> <t
                        t-esc="props.uploadText"
                    />
                </button>
            </div>
        </div>
    </t>

</templates>
