<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_attachment_classifier.AttachmentClassifierDialog" owl="1">
        <Dialog title="title" size="'md'">
            <div class="mb-3">
                <label class="o_form_label">
                    <span t-esc="isEditMode ? 'Replace file (optional)' : 'File'"/>
                </label>
                <div
                    t-attf-class="o_classifier_dialog_dropzone p-2 border rounded {{ state.isDraggingOver ? 'o_dragging_over' : '' }}"
                    t-on-dragenter.prevent="onDragEnter"
                    t-on-dragover.prevent="onDragOver"
                    t-on-dragleave.prevent="onDragLeave"
                    t-on-drop.prevent="onDrop"
                >
                    <input
                        type="file"
                        t-ref="fileInput"
                        class="form-control"
                        t-att-multiple="!isEditMode"
                    />
                    <div class="small text-muted mt-1">
                        <span class="fa fa-cloud-upload me-1"/>Or drop <t t-esc="isEditMode ? 'a file' : 'files'"/> here
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="o_form_label">
                    <span t-esc="props.classifierLabel" />
                    <span
                        t-if="props.classifierRequired"
                        class="text-danger ms-1"
                    >*</span>
                </label>
                <select class="form-select" t-model="state.classifierId">
                    <option value="">--</option>
                    <t t-foreach="classifierOptions" t-as="opt" t-key="opt.id">
                        <option t-att-value="opt.id" t-esc="opt.name" />
                    </t>
                </select>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave">Save</button>
                <button
                    class="btn btn-secondary"
                    t-on-click="() => props.close()"
                >Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
