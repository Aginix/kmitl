<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_attachment_classifier.AttachmentClassifierDialog" owl="1">
        <Dialog title="title" size="'md'">
            <div t-if="isAddMode" class="mb-3">
                <label class="o_form_label">File</label>
                <div
                    t-attf-class="o_classifier_dialog_dropzone p-2 border rounded {{ state.isDraggingOver ? 'o_classifier_dragging_over' : '' }}"
                    t-on-dragenter.prevent="onDragEnter"
                    t-on-dragover.prevent="onDragOver"
                    t-on-dragleave.prevent="onDragLeave"
                    t-on-drop.prevent="onDrop"
                >
                    <input
                        type="file"
                        t-ref="fileInput"
                        class="form-control"
                        t-att-multiple="true"
                    />
                    <div class="small text-muted mt-1">
                        <span class="fa fa-cloud-upload me-1" />Or drop files here
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="o_form_label">Document Type</label>
                <select
                    class="form-select"
                    t-att-value="state.value"
                    t-on-change="onValueChange"
                >
                    <option
                        value=""
                        t-att-selected="isSelected('')"
                    >--</option>
                    <t t-foreach="props.options" t-as="opt" t-key="opt.id">
                        <option
                            t-att-value="opt.id"
                            t-att-selected="isSelected(opt.id)"
                            t-esc="opt.name"
                        />
                    </t>
                </select>
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary"
                    t-on-click="onSave"
                    t-att-disabled="state.saving"
                >
                    <i
                        t-if="state.saving"
                        class="fa fa-spin fa-spinner me-1"
                    />Save
                </button>
                <button
                    class="btn btn-secondary"
                    t-on-click="onCancel"
                    t-att-disabled="state.saving"
                >Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
