<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View procurement.plan form - Add Smart Button -->
    <record id="view_procurement_plan_form_purchase_request" model="ir.ui.view">
        <field name="name">view.procurement.plan.form.purchase.request</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <field name="purchase_request_count" invisible="1" />
                    <button
                        name="action_view_purchase_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        attrs="{'invisible': [('purchase_request_count', '=', 0)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Purchase Requests</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
