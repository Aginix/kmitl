<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form (disbursement_advance_clearing)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="inside">
                <h2>ล้างลูกหนี้เงินยืม</h2>
                <div class="row mt16 o_settings_container" name="advance_clearing">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="advance_clearing_journal_id" />
                            <div class="text-muted">
                                สมุดรายวันของรายการล้างลูกหนี้เงินยืม จากใบขอเบิกประเภทเงินยืม
                            </div>
                            <field
                                name="advance_clearing_journal_id"
                                options="{'no_create': True}"
                            />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="advance_clearing_account_id" />
                            <div class="text-muted">
                                บัญชีลูกหนี้เงินยืมฝั่งเครดิตของรายการล้างลูกหนี้
                            </div>
                            <field
                                name="advance_clearing_account_id"
                                options="{'no_create': True}"
                            />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
