<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_rule_work_acceptance_operating_units" model="ir.rule">
        <field name="model_id" ref="purchase_work_acceptance.model_work_acceptance" />
        <field
            name="domain_force"
        >['|', ('operating_unit_id','=',False), ('operating_unit_id','in', user.operating_unit_ids.ids)]
        </field>
        <field name="name">Work Acceptance Operating Unit</field>
        <field name="global" eval="False" />
        <field name="groups" eval="[(6, 0, [ref('purchase.group_purchase_user')])]" />
        <field name="perm_unlink" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
    </record>

    <record id="ir_rule_work_acceptance_line_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="purchase_work_acceptance.model_work_acceptance_line" />
        <field
            name="domain_force"
        >['|', ('operating_unit_id','=',False), ('operating_unit_id','in', user.operating_unit_ids.ids)]
        </field>
        <field name="name">WA lines from allowed operating units</field>
        <field name="global" eval="False" />
        <field name="groups" eval="[(6, 0, [ref('purchase.group_purchase_user')])]" />
        <field name="perm_unlink" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
    </record>
</odoo>
