<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="before">
                <field name="can_edit_egp" invisible="1" />
                <field
                    name="is_egp"
                    attrs="{'readonly': ['|', ('estimated_cost', '&gt;', 100000), ('is_editable', '=', False)]}"
                />
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page
                    string="e-GP"
                    name="egp_page"
                    attrs="{'invisible': ['|', ('is_egp', '=', False), ('state', 'not in', ('egp', 'purchasing', 'done'))]}"
                >
                    <group>
                        <field
                            name="egp_project_id"
                            attrs="{'readonly': [('can_edit_egp', '=', False)]}"
                        />
                        <field name="egp_project_url" widget="url" />
                    </group>
                    <div attrs="{'invisible': [('egp_project_url', '=', False)]}">
                        <field
                            name="egp_project_url"
                            widget="iframe_viewer"
                            options="{'auto_height': false, 'width': '100%', 'height': '800px'}"
                        />
                    </div>
                </page>
            </xpath>
            <!-- egp → purchasing button -->
            <xpath expr="//button[@name='button_done']" position="after">
                <button
                    name="action_egp_in_progress"
                    type="object"
                    string="ยืนยัน e-GP"
                    attrs="{'invisible': [('state', '!=', 'egp')]}"
                    class="btn-primary"
                    groups="purchase_request_kmitl.group_purchase_request_user_all"
                />
            </xpath>
            <!-- Create PO from egp path (shown only in purchasing state for egp PRs) -->
            <xpath expr="//button[@type='action']" position="after">
                <field name="show_egp_create_purchase_order_button" invisible="1" />
                <button
                    name="action_egp_create_purchase_order"
                    type="object"
                    string="สร้างใบสั่งซื้อ/จ้าง"
                    attrs="{'invisible': [('show_egp_create_purchase_order_button', '=', False)]}"
                    groups="purchase.group_purchase_user"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>

    <!-- Tree: only show is_egp column (egp_status removed) -->
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_egp" invisible="1" />
            </field>
        </field>
    </record>

    <!-- Kanban: keep is_egp indicator -->
    <record id="view_purchase_request_kanban" model="ir.ui.view">
        <field name="name">view.purchase.request.kanban (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_egp" invisible="1" />
            </xpath>
        </field>
    </record>

    <!-- Search: keep egp_project_id and is_egp filters -->
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">view.purchase.request.search (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="egp_project_id" />
                <field name="is_egp" />
            </xpath>
        </field>
    </record>

    <!-- UX override: move is_egp into purchase_request_group -->
    <record id="view_purchase_request_form_ux" model="ir.ui.view">
        <field name="name">view.purchase.request.form.ux (e-GP)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <!-- Hide is_egp from original position (near origin) -->
            <xpath expr="//field[@name='is_egp']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Re-add is_egp into the custom group, before operating_unit_id -->
            <xpath
                expr="//group[@name='purchase_request_group']//field[@name='operating_unit_id']"
                position="before"
            >
                <field
                    name="is_egp"
                    attrs="{'readonly': ['|', ('estimated_cost', '&gt;', 100000), ('is_editable', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <menuitem
        action="base_tier_validation.tier_validation_exception_action"
        id="menu_purchase_request_tier_validation_exception"
        parent="purchase.menu_purchase_config"
    />
</odoo>
