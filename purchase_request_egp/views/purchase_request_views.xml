<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form" model="ir.ui.view">
        <field name="name">view.purchase.request.form (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="before">
                <field
                    name="egp_status"
                    readonly="1"
                    widget="badge"
                    decoration-info="egp_status == 'waiting'"
                    decoration-warning="egp_status == 'in_progress'"
                    decoration-success="egp_status == 'done'"
                    attrs="{'invisible': [('egp_status', '=', False)]}"
                />
                <field name="can_edit_egp" invisible="1" />
                <field
                    name="is_egp"
                    attrs="{'readonly': ['|', ('estimated_cost', '>', 100000), ('is_editable', '=', False)]}"
                />
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page
                    string="e-GP"
                    name="egp_page"
                    attrs="{'invisible': ['|', ('is_egp', '=', False), ('state', 'not in', ('approved', 'in_progress', 'in_egp', 'done'))]}"
                >
                    <group>
                        <!-- remove required in attrs -->
                        <field
                            name="egp_project_id"
                            attrs="{
                                'readonly': [('can_edit_egp', '=', False)],
                                'required': [('egp_status', '=', 'in_progress')],
                            }"
                            class="o_required_modifier"
                        />
                        <field name="egp_project_url" widget="url" />
                    </group>
                    <div attrs="{'invisible': [('egp_project_url', '=', False)]}">
                        <field
                            name="egp_project_url"
                            widget="iframe_viewer"
                            options="{'auto_height': false, 'width': '100%', 'height': '800px'}"
                        />
                    </div>
                </page>
            </xpath>
            <xpath expr="//button[@name='button_done']" position="after">
                <button
                    name="action_egp_in_progress"
                    type="object"
                    string="อยู่ในกระบวนการ e-GP"
                    attrs="{'invisible': ['|', ('state', '!=', 'in_egp'), ('egp_status', '!=', 'waiting')]}"
                    class="btn-primary"
                />
                <!-- Reject button while parked in e-GP -->
                <button
                    name="button_rejected_egp"
                    attrs="{'invisible': ['|', ('is_egp', '=', False), ('state', '!=', 'in_egp')]}"
                    string="Reject"
                    type="object"
                    groups="purchase_request.group_purchase_request_manager"
                />
            </xpath>
            <xpath expr="//button[@type='action']" position="after">
                <field name="show_egp_create_purchase_order_button" invisible="1" />
                <button
                    name="action_egp_create_purchase_order"
                    type="object"
                    string="Create PO"
                    attrs="{'invisible': [('show_egp_create_purchase_order_button', '=', False)]}"
                    groups="purchase.group_purchase_user"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>

    <!-- View purchase.request tree -->
    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_egp" invisible="1" />
                <field
                    name="egp_status"
                    widget="badge"
                    decoration-info="egp_status == 'waiting'"
                    decoration-warning="egp_status == 'in_progress'"
                    decoration-success="egp_status == 'done'"
                    optional="show"
                />
            </field>
        </field>
    </record>

    <!-- View purchase.request kanban -->
    <record id="view_purchase_request_kanban" model="ir.ui.view">
        <field name="name">view.purchase.request.kanban (e-GP)</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_egp" invisible="1" />
            </xpath>
        </field>
    </record>

    <!-- View purchase.request search -->
    <record id="view_purchase_request_search" model="ir.ui.view">
        <field name="name">view.purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="egp_project_id" />
                <field name="is_egp" />
            </xpath>
        </field>
    </record>

    <!-- View purchase.request kanban -->
    <record id="view_purchase_request_kanban" model="ir.ui.view">
        <field name="name">view.purchase.request.kanban</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_kanban_record_bottom')]" position="after">
                <div class="o_kanban_record_bottom">
                    <div class="oe_kanban_bottom_left">
                        <span>e-GP</span>
                        <field name="is_egp" />
                    </div>
                    <div class="oe_kanban_bottom_right">
                        <field name="egp_project_id" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <menuitem
        action="base_tier_validation.tier_validation_exception_action"
        id="menu_purchase_request_tier_validation_exception"
        parent="purchase.menu_purchase_config"
    />

    <!-- UX override: move is_egp into the purchase_request_group (defined in
         purchase_request_kmitl.view_purchase_request_form_ux). This view inherits from
         the UX view so it is applied right after the UX restructure. -->
    <record id="view_purchase_request_form_ux" model="ir.ui.view">
        <field name="name">view.purchase.request.form.ux (e-GP)</field>
        <field name="model">purchase.request</field>
        <field
            name="inherit_id"
            ref="purchase_request_kmitl.view_purchase_request_form"
        />
        <field name="arch" type="xml">
            <!-- Hide is_egp from its original position (near origin) -->
            <xpath expr="//field[@name='is_egp']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Re-add is_egp into the custom group, before operating_unit_id -->
            <xpath
                expr="//group[@name='purchase_request_group']//field[@name='operating_unit_id']"
                position="before"
            >
                <field
                    name="is_egp"
                    attrs="{'readonly': ['|', ('estimated_cost', '&gt;', 100000), ('is_editable', '=', False)]}"
                />
            </xpath>

            <!-- Dual statusbar: KMITL view already sets the non-e-GP list;
                 here we make it invisible when is_egp=True and add an e-GP
                 statusbar after it. is_egp is present in this view via the
                 xpath above. -->
            <xpath expr="//form/header/field[@name='state']" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('is_egp', '=', True)]}</attribute>
            </xpath>

            <xpath expr="//form/header/field[@name='state']" position="after">
                <field
                    name="state"
                    widget="statusbar"
                    statusbar_visible="draft,to_verify,to_submit,to_approve,in_egp,in_progress,done"
                    attrs="{'invisible': [('is_egp', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
