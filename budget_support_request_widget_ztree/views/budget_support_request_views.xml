<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_budget_support_request_form" model="ir.ui.view">
        <field name="name">budget.support.request.form.ztree</field>
        <field name="model">budget.support.request</field>
        <field name="inherit_id" ref="budget_support_request.view_budget_support_request_form" />
        <field name="arch" type="xml">
            <!-- Every hierarchical picker in มิติทางบัญชี; ztree_select
                 evaluates each field's domain at RPC time. -->
            <xpath expr="//group[@name='budget_info']/field[@name='department_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//group[@name='budget_info']/field[@name='fund_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//group[@name='budget_info']/field[@name='activity_analytic_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath expr="//group[@name='budget_info']/field[@name='budget_account_id']" position="attributes">
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
