<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_material_withdrawal" model="ir.ui.view">
        <field name="name">purchase.order.form.material.withdrawal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_material_withdrawal_wizard"
                    string="พิมพ์ใบเบิกวัสดุ"
                    type="object"
                    attrs="{'invisible': [('state', 'not in', ('purchase', 'done'))]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
