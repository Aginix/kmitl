<odoo>
    <record id="paperformat_purchase_order_report" model="report.paperformat">
        <field name="name">Purchase Request Report Paper Format</field>
        <field name="default" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">110</field>
    </record>

    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_purchase_order_report"/>
        <field name="print_report_name">'Purchase Order - %s' % (object.name)</field>
    </record>
</odoo>
