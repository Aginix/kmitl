<odoo>
    <template
        id="report_purchase_order_kmitl"
        inherit_id="purchase.report_purchaseorder"
    >
        <xpath
            expr="//t[@t-call='purchase.report_purchaseorder_document']"
            position="replace"
        >
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                <style>
                    * {
                        font-family: "THSarabunNew", Arial, sans-serif;
                        --bs-body-font-size: 16pt;
                    }
                    table.budget tr td:first-child {
                        width: 30%;
                    }
                    p,
                    span,
                    div {
                        font-size: 16pt;
                        line-height: 1.2;
                    }
                    span {
                        word-break: break-all !important;
                    }
                    .force-wrap {
                        white-space: normal !important;
                        word-break: break-word !important;
                        overflow-wrap: break-word !important;
                    }
                </style>

                <div class="page">
                    <div style="position: absolute; top: 0px; left: 0px">
                        <img
                            t-if="o.company_id.logo"
                            t-att-src="image_data_uri(o.company_id.logo)"
                            style="max-height: 110px"
                            alt="Logo"
                        />
                    </div>
                    <div style="position: absolute; top: 0px; right: 0px">
                        <div>ใบสั่งซื้อ/จ้าง/PO</div>
                    </div>
                    <div class="oe_structure" />
                    <div style="height: 1px" />
                    <div class="page-header mt-5 mb-5">
                        <h3 class="text-center fw-bolder" style="line-height: 1.575">
                            <span t-esc="o.contract_type_id.name" />
                        </h3>
                    </div>
                    <div class="row">
                        <div class="col-7">
                            ผู้รับจ้าง
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline"
                                t-out="o.partner_id.name"
                            />
                        </div>
                        <div class="col-5">
                            <span t-esc="o.contract_type_id.name" />เลขที่
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline"
                                t-esc="o.contract_number"
                            />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-7">
                            ที่อยู่
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline force-wrap"
                                t-out="o.partner_id.street"
                            />
                        </div>
                        <div class="col-5">
                            วันที่
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline"
                                t-esc="o.format_date_thai(o.date_order)"
                            />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-7">
                            <span
                                class="fw-normal fw-bolder text-decoration-underline"
                                t-out="o.partner_id.city"
                            />
                            <span
                                class="fw-normal fw-bolder text-decoration-underline"
                                t-out="o.partner_id.zip"
                            />
                        </div>
                        <div class="col-5">
                            ส่วนราชการ
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline force-wrap"
                                t-esc="o.company_id.name"
                            />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-7">
                            โทรศัพท์
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline"
                                t-out="o.partner_id.phone"
                            />
                            <div>เลขประจำตัวผู้เสียภาษี</div>
                            <div>
                                <span
                                    class="fw-normal fw-bolder text-decoration-underline"
                                    t-out="o.partner_id.vat"
                                />
                            </div>
                        </div>
                        <div class="col-5">
                            ที่อยู่
                            <span
                                class="ms-2 fw-normal fw-bolder text-decoration-underline force-wrap"
                                t-esc="o.company_id.partner_id.street"
                            />
                            <span
                                class="fw-normal fw-bolder text-decoration-underline"
                                t-esc="o.company_id.partner_id.city"
                            />
                            <span
                                class="fw-normal fw-bolder text-decoration-underline"
                                t-esc="o.company_id.partner_id.zip"
                            />
                        </div>
                    </div>

                    <div class="my-4" />

                    <div class="row">
                        <div class="col">
                            ตามที่
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-out="o.partner_id.name"
                            />
                            ได้เสนอราคาไว้ต่อ
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-out="o.company_id.name"
                            />
                            ซึ่งได้รับราคาและตกลงซื้อ ตามรายการดังต่อไปนี้
                        </div>
                    </div>
                    <table class="table table-bordered table-sm mb-4">
                        <thead>
                            <tr>
                                <th>ลำดับ</th>
                                <th class="text-center">รายการ</th>
                                <th class="text-center">จำนวน</th>
                                <th class="text-end">ราคา (บาท)</th>
                                <th class="text-end">จำนวนเงิน (บาท)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="row_no" t-value="1" />
                            <t t-foreach="o.order_line" t-as="line">
                                <tr>
                                    <td class="text-center" t-out="row_no" />
                                    <td t-out="line.name" />
                                    <td class="text-center">
                                        <span
                                            t-out="'{0:,.0f}'.format(line.product_qty)"
                                        />
                                        <span
                                            t-out="line.uom_text or line.product_uom.name or ''"
                                        />
                                    </td>
                                    <td
                                        class="text-end"
                                        t-out="'{0:,.2f}'.format(line.price_unit)"
                                    />
                                    <td
                                        class="text-end"
                                        t-out="'{0:,.2f}'.format(line.price_subtotal)"
                                    />
                                </tr>
                                <t t-set="row_no" t-value="row_no + 1" />
                            </t>
                            <tr>
                                <t t-set="currency" t-value="o.currency_id" />
                                <td
                                    colspan="2"
                                    rowspan="3"
                                    class="text-center align-middle"
                                >
                                    (
                                    <t
                                        t-esc="currency.with_context({'lang': 'th_TH'}).amount_to_text(o.amount_total)"
                                    />
                                    )
                                </td>
                                <td class="text-center" colspan="2">
                                    ราคาก่อนรวมภาษีมูลค่าเพิ่ม
                                </td>
                                <td
                                    class="text-end"
                                    t-out="'{0:,.2f}'.format(o.amount_untaxed)"
                                />
                            </tr>
                            <tr>
                                <td class="text-center" colspan="2">
                                    ภาษีมูลค่าเพิ่ม (VAT 7%)
                                </td>
                                <td
                                    class="text-end"
                                    t-out="'{0:,.2f}'.format(o.amount_tax)"
                                />
                            </tr>
                            <tr>
                                <td class="text-center" colspan="2">ราคาสุทธิ</td>
                                <td
                                    class="text-end"
                                    t-out="'{0:,.2f}'.format(o.amount_total)"
                                />
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-2">การสั่งซื้อ อยู่ภายใต้เงื่อนไขดังนี้</div>
                    <ol>
                        <li>
                            กำหนดส่งมอบภายใน
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.contract_period_days"
                            />
                            วัน นับถัดจากวันที่ผู้รับจ้างได้รับ
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.contract_type_id.name"
                            />
                        </li>
                        <li>
                            ครบกำหนดส่งมอบวันที่
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.format_date_thai(o.work_end)"
                            />
                        </li>
                        <li>
                            สถานที่ส่งมอบ
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.company_id.name"
                            />
                        </li>
                        <li>
                            สงวนสิทธิ์ค่าปรับกรณีส่งมอบเกินกำหนด
                            โดยคิดค่าปรับเป็นรายวันในอัตราร้อยละ
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.fines_rate"
                            />
                            ของราคางานจ้าง แต่ต้องไม่น้อยกว่า 100.00 บาท
                        </li>
                        <li>
                            ส่วนราชการสงวนสิทธิ์ที่จะไม่รับมอบถ้าปรากฎว่าสินค้านั้นมีลักษณะไม่ตรงตามรายการที่ระบุไว้ใน
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.contract_type_id.name"
                            />
                            กรณีนี้ผู้รับจ้างจะต้องดำเนินการเปลี่ยนใหม่ให้ถูกต้องตาม
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.contract_type_id.name"
                            />
                            ทุกประการ
                        </li>
                        <li>
                            การจ้างช่วง
                            ผู้รับจ้างจะต้องไม่เอางานทั้งหมดหรือแต่บางส่วนไปจ้างช่วงอีกทอดหนึ่ง
                            เว้นแต่การจ้างช่วงแต่บางส่วนที่ได้รับอนุญาตเป็นหนังสือจากผู้ว่าจ้างแล้ว
                            การที่ผู้ว่าจ้างได้อนุญาตให้จ้างช่วงงานแต่บางส่วนดังกล่าว
                            ไม่เป็นเหตุให้ผู้รับจ้างหลุดพ้นจากความรับผิดหรือพันธะหน้าที่และผู้รับจ้างจะยังคงต้องรับผิดในความผิดและประมาทเลินเล่อของผู้รับจ้างช่วง
                            หรือของตัวแทนหรือลูกจ้างของผู้รับจ้างช่วงนั้นทุกประการ
                            กรณีผู้รับจ้างไปจ้างช่วงงานแต่บางส่วน
                            โดยฝ่าฝืนความในวรรคหนึ่ง
                            ผู้รับจ้างต้องชำระค่าปรับให้แก่ผู้ว่าจ้างเป็นจำนวนเงินในอัตราร้อยละ
                            10 (สิบ) ของวงเงินของงาน ที่จ้างช่วง ทั้งนี้
                            ไม่ตัดสิทธิ์ผู้ว่าจ้างในการบอกเลิกสัญญา
                        </li>
                        <li>
                            การประเมินผลการปฏิบัติงานของผู้ประกอบการ
                            หน่วยงานของรัฐสามารถนำผลการปฏิบัติงานแล้วเสร็จตามสัญญาหรือข้อตกลงของคู่สัญญาเพื่อนำมาประเมินผลการปฏิบัติงานของผู้ประกอบการ
                        </li>
                    </ol>
                    <div class="my-4" />
                    <div class="mb-2 text-decoration-underline">หมายเหตุ</div>
                    <ol>
                        <li>
                            การติดอากรแสตมป์ให้เป็นไปตามประมวลกฏหมายรัษฎากร
                            หากต้องการให้
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.contract_type_id.name"
                            />มีผลตามกฎหมาย
                        </li>
                        <li>
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.contract_type_id.name"
                            />
                            นี้อ้างอิงตามเลขที่โครงการ
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.request_id.egp_project_id or '-'"
                            >
                            </span>
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.product_id.name"
                            />
                            <span class="fw-bolder text-decoration-underline">
                                จำนวน 1 รายการ
                            </span>
                            โดยวิธี
                            <span
                                class="fw-bolder text-decoration-underline"
                                t-esc="o.request_id.procurement_method_id.name"
                            />
                        </li>
                    </ol>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
