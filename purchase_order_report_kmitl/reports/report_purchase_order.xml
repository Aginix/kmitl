<odoo>
    <template
        id="report_purchase_order_kmitl"
        inherit_id="purchase.report_purchaseorder"
    >
        <xpath
            expr="//t[@t-call='purchase.report_purchaseorder_document']"
            position="replace"
        >
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="o.with_context({'lang': 'th_TH'})" />
                <style>
                    * {
                        font-family: "THSarabunNew", Arial, sans-serif;
                        --bs-body-font-size: 16pt;
                    }
                    table.budget tr td:first-child {
                        width: 30%;
                    }
                    p,
                    span,
                    div {
                        font-size: 16pt;
                        line-height: 1.2;
                    }
                </style>

                <div class="page">
                    <div style="position: absolute; top: 0px; left: 0px">
                        <img
                            t-if="o.company_id.logo"
                            t-att-src="image_data_uri(o.company_id.logo)"
                            style="max-height: 110px"
                            alt="Logo"
                        />
                    </div>
                    <div style="position: absolute; top: 0px; right: 0px">
                        <div>ใบสั่งซื้อ/จ้าง/PO</div>
                    </div>
                    <div class="oe_structure" />
                    <div style="height: 1px" />
                    <div class="page-header mt-5 mb-5">
                        <h3 class="text-center fw-bolder" style="line-height: 1.575">
                            ใบสั่งซื้อ/จ้าง
                        </h3>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            ผู้รับจ้าง
                            <span class="ms-2 fw-normal" t-out="o.partner_id.name" />
                        </div>
                        <div class="col">
                            ใบสั่งซื้อเลขที่
                            <span
                                class="ms-2 fw-normal"
                                t-esc="o.name"
                            />
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="report_purchase_request_committee">
        <li>
            ขออนุมัติแต่งตั้งคณะกรรมการตรวจรับพัสดุ ดังต่อไปนี้
            <ol>
                <li t-foreach="o.work_acceptance_committee_ids" t-as="committee">
                    <span t-field="committee.employee_id" />
                </li>
            </ol>
        </li>
        <t t-if="o.estimated_cost > 100000">
            <li>
                ขออนุมัติแต่งตั้งคณะกรรมการกำหนดคุณลักษณะเฉพาะร่างขอบเขตงาน ดังต่อไปนี้
                <ol>
                    <li t-foreach="o.tor_committee_ids" t-as="committee">
                        <span t-field="committee.employee_id" />
                    </li>
                </ol>
            </li>
            <li>
                ขออนุมัติแต่งตั้งคณะกรรมการกำหนดราคากลาง ดังต่อไปนี้
                <ol>
                    <li t-foreach="o.price_determine_committee_ids" t-as="committee">
                        <span t-field="committee.employee_id" />
                    </li>
                </ol>
            </li>
            <li>
                ขออนุมัติแต่งตั้งคณะกรรมการพิจารณาผล ดังต่อไปนี้
                <ol>
                    <li t-foreach="o.evaluation_committee_ids" t-as="committee">
                        <span t-field="committee.employee_id" />
                    </li>
                </ol>
            </li>
        </t>
        <t t-else=""></t>
    </template>

    <template id="report_purchase_request_budget">
        <table class="table table-bordered border table-sm budget">
            <tbody>
                <tr class="o_field_budget_commitment_id">
                    <td>เลขที่ใบจองงบประมาณ</td>
                    <td>
                        <span t-field="o.budget_commitment_id" />
                    </td>
                </tr>
                <tr class="o_field_budget_account_id">
                    <td>รหัสงบประมาณค่าใช้จ่าย</td>
                    <td>
                        <span t-field="o.budget_account_id" />
                    </td>
                </tr>
                <tr class="o_field_source_analytic_id">
                    <td>แหล่งเงิน</td>
                    <td>
                        <span t-field="o.source_analytic_id" />
                    </td>
                </tr>
                <tr class="o_field_department_analytic_id">
                    <td>หน่วยงาน</td>
                    <td>
                        <span t-field="o.department_analytic_id" />
                    </td>
                </tr>
                <tr class="o_field_activity_analytic_id">
                    <td>ด้าน/แผนงาน/กิจกรรม</td>
                    <td>
                        <span t-field="o.activity_analytic_id" />
                    </td>
                </tr>
                <tr class="o_field_fund_analytic_id">
                    <td>กองทุน</td>
                    <td>
                        <span t-field="o.fund_analytic_id" />
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_purchase_request_sign">
        <div class="my-5">
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /> ผู้ขอให้จัดหา</div>
                <div class="text-center my-2">
                    ( <span t-field="o.requested_by" />
                    )
                </div>
            </div>
        </div>
        <div class="my-5" />
        <div class="my-5">
            <div class="my-2 d-inline-block">
                <div>ลงชื่อ <t t-out="'.' * 80" /></div>
                <div class="text-center">
                    ( <span t-field="o.requested_by" />
                    )
                </div>
                <div class="text-center">
                    คณบดี <span t-out="o.department_id.master_department_id.name" />
                </div>
            </div>
        </div>
    </template>
</odoo>
