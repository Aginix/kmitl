<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form.ztree</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="agx_approval.approval_request_view_form" />
        <field name="arch" type="xml">
            <!-- หน่วยงานผู้ขอ (a departments analytic account, independent of
                 the budget ส่วนงาน below). -->
            <xpath
                expr="//group[@name='approval_details']//field[@name='requesting_department_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <!-- Budget dimensions, scoped to the Budget group. budget_account_id
                 keeps its dynamic budget_account_domain (ztree_select evaluates
                 the field domain at RPC time). -->
            <xpath
                expr="//group[@name='budget']/field[@name='budget_account_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//group[@name='budget']/field[@name='activity_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//group[@name='budget']/field[@name='department_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//group[@name='budget']/field[@name='fund_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
            <xpath
                expr="//group[@name='budget']/field[@name='source_analytic_id']"
                position="attributes"
            >
                <attribute name="widget">ztree_select</attribute>
                <attribute
                    name="options"
                >{'no_create': True, 'no_open': True, 'ztree_parent_key': 'parent_id', 'ztree_expend_level': '2', 'order': 'code', 'ztree_name_format': '[{code}] {name}'}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
