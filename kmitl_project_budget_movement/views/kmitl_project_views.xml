<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_form" model="ir.ui.view">
        <field name="name">kmitl.project.form.budget.movement</field>
        <field name="model">kmitl.project</field>
        <field name="inherit_id" ref="kmitl_project.view_kmitl_project_form" />
        <!-- Replaces the ledger button: apply after other extensions. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <data>
                <!-- One button for everyone in place of the budget-viewer-only
                     ledger button (ADR-0007). -->
                <button name="action_open_budget_move_lines" position="replace">
                    <button
                        name="action_open_budget_movements"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                        groups="kmitl_project.group_kmitl_project_user,budget.group_budget_viewer"
                    >
                        <field
                            name="budget_movement_count"
                            widget="statinfo"
                            string="การเคลื่อนไหวงบ"
                        />
                    </button>
                </button>
            </data>
        </field>
    </record>
</odoo>
