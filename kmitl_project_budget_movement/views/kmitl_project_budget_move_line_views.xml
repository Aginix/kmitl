<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_kmitl_project_budget_move_line_tree" model="ir.ui.view">
        <field name="name">kmitl.project.budget.move.line.tree</field>
        <field name="model">kmitl.project.budget.move.line</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="date" />
                <field name="name" />
                <field name="project_id" optional="hide" />
                <field name="kind" />
                <field name="source_name" />
                <field name="counterpart_department_id" />
                <field name="account_id" optional="hide" />
                <field name="account_fiscal_year_id" optional="hide" />
                <field
                    name="move_id"
                    optional="hide"
                    groups="budget.group_budget_viewer"
                />
                <field name="amount" sum="รวม" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'posted'"
                    decoration-warning="status == 'in_progress'"
                    decoration-info="status == 'other_year'"
                    decoration-danger="status == 'off_target'"
                />
            </tree>
        </field>
    </record>

    <!-- Many2ones are no_open: project users cannot read their comodels
         (ADR-0007); budget viewers drill in through move_id. -->
    <record id="view_kmitl_project_budget_move_line_form" model="ir.ui.view">
        <field name="name">kmitl.project.budget.move.line.form</field>
        <field name="model">kmitl.project.budget.move.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="date" />
                            <field name="project_id" options="{'no_open': True}" />
                            <field name="kind" />
                            <field name="status" />
                            <field name="move_id" groups="budget.group_budget_viewer" />
                        </group>
                        <group>
                            <field name="source_name" />
                            <field
                                name="counterpart_department_id"
                                options="{'no_open': True}"
                            />
                            <field name="account_id" options="{'no_open': True}" />
                            <field
                                name="account_fiscal_year_id"
                                options="{'no_open': True}"
                            />
                            <field name="amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kmitl_project_budget_move_line_search" model="ir.ui.view">
        <field name="name">kmitl.project.budget.move.line.search</field>
        <field name="model">kmitl.project.budget.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="counterpart_department_id" />
                <filter
                    string="เงินเข้า"
                    name="inflow"
                    domain="[('kind', 'in', ('appropriation', 'transfer_in'))]"
                />
                <filter
                    string="ตัดงบ"
                    name="consume"
                    domain="[('kind', '=', 'consume')]"
                />
                <separator />
                <filter
                    string="ผ่านแล้ว"
                    name="posted"
                    domain="[('status', '=', 'posted')]"
                />
                <filter
                    string="อยู่ระหว่างดำเนินการ"
                    name="in_progress"
                    domain="[('status', '=', 'in_progress')]"
                />
                <filter
                    string="ต่างปีงบประมาณ"
                    name="other_year"
                    domain="[('status', '=', 'other_year')]"
                />
                <filter
                    string="พิกัดไม่ตรงกับโครงการ"
                    name="off_target"
                    domain="[('status', '=', 'off_target')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="ประเภท"
                        name="group_kind"
                        context="{'group_by': 'kind'}"
                    />
                    <filter
                        string="สถานะ"
                        name="group_status"
                        context="{'group_by': 'status'}"
                    />
                    <filter
                        string="ส่วนงานคู่โอน"
                        name="group_counterpart"
                        context="{'group_by': 'counterpart_department_id'}"
                    />
                    <filter
                        string="ปีงบประมาณ"
                        name="group_fiscal_year"
                        context="{'group_by': 'account_fiscal_year_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_kmitl_project_budget_move_line" model="ir.actions.act_window">
        <field name="name">การเคลื่อนไหวงบประมาณโครงการ</field>
        <field name="res_model">kmitl.project.budget.move.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_kind': 1}</field>
    </record>
</odoo>
