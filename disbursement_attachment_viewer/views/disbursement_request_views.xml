<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_disbursement_request_form" model="ir.ui.view">
        <field name="name">disbursement.request.form.attachment.viewer</field>
        <field name="model">disbursement.request</field>
        <field name="inherit_id" ref="disbursement.view_disbursement_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state'][@invisible='1']" position="before">
                <button name="action_view_attachments"
                        type="object"
                        string="ดูไฟล์แนบทั้งหมด"
                        icon="fa-files-o"
                        attrs="{'invisible': [('attachment_count', '=', 0)]}"/>
                <field name="attachment_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
