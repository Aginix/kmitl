<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Route Template for Purchase Request -->
    <record id="route_template_purchase_request" model="sarabun.route.template">
        <field name="name">Purchase Request Approval</field>
        <field name="description">Route template for purchase request approval workflow</field>
        <field name="sequence">10</field>
        <field name="origin_model">purchase.request</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Route Template Line 1: Approver (person target - uses admin for demo) -->
    <record id="route_template_line_pr_approve" model="sarabun.route.template.line">
        <field name="template_id" ref="route_template_purchase_request"/>
        <field name="order">10</field>
        <field name="verb">sign_approve</field>
        <field name="target_mode">person</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>

</odoo>
