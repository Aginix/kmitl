<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_sarabun" model="ir.ui.view">
        <field name="name">purchase.request.form.sarabun</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <!-- Add Submit to Sarabun button after Request approval button -->
            <xpath expr="//button[@name='button_draft']" position="after">
                <button
                    name="action_submit_to_sarabun"
                    string="Create Sarabun"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('state', '!=', 'to_submit'), ('sarabun_has_live_document', '=', True)]}"
                />
                <button
                    name="action_resend_to_sarabun"
                    string="Resend to Sarabun"
                    type="object"
                    class="oe_highlight"
                    states="returned"
                />
            </xpath>

            <!-- Add Sarabun Documents smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sarabun_document_count" invisible="1" />
                <field name="sarabun_has_live_document" invisible="1" />
                <button
                    type="object"
                    name="action_view_sarabun_documents"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('sarabun_document_count', '=', 0)]}"
                    string="Sarabun Document"
                />
            </xpath>

            <!-- Sarabun status notification on the origin record -->
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="sarabun_is_draft" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     attrs="{'invisible': [('sarabun_is_draft', '=', False)]}">
                    <i class="fa fa-pencil-square-o me-1"/>
                    หนังสือสารบรรณถูกสร้างแล้วแต่ยังไม่ได้ส่งออก (สถานะ: ร่าง)
                    <button name="action_view_sarabun_documents" type="object"
                            class="btn btn-sm btn-warning ms-2" string="เปิดหนังสือเพื่อส่ง"/>
                </div>
                <div class="alert alert-info mb-2" role="alert"
                     attrs="{'invisible': ['|', ('sarabun_has_live_document', '=', False), ('sarabun_is_draft', '=', True)]}">
                    <i class="fa fa-paper-plane me-1"/>
                    สถานะการเดินหนังสือสารบรรณ: <field name="sarabun_state_label" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_tree" model="ir.ui.view">
        <field name="name">view.purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="active_sarabun_document_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
