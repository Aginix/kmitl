<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_receipt_kmitl_form" model="ir.ui.view">
        <field name="name">kmitl.receipt.form.guarantee</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='receipt_kind']" position="after">
                <field
                    name="purchase_guarantee_id"
                    attrs="{'invisible': [('purchase_guarantee_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_receipt_kmitl_tree" model="ir.ui.view">
        <field name="name">kmitl.receipt.tree.guarantee</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='receipt_kind']" position="after">
                <field name="purchase_guarantee_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_receipt_kmitl_search" model="ir.ui.view">
        <field name="name">kmitl.receipt.search.guarantee</field>
        <field name="model">kmitl.receipt</field>
        <field name="inherit_id" ref="receipt_kmitl.view_receipt_kmitl_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='kind_revenue']" position="after">
                <filter
                    string="Guarantee"
                    name="kind_guarantee"
                    domain="[('receipt_kind', '=', 'guarantee')]"
                />
            </xpath>
        </field>
    </record>

</odoo>
