<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_guarantee_form" model="ir.ui.view">
        <field name="name">purchase.guarantee.form.receipt</field>
        <field name="model">purchase.guarantee</field>
        <field
            name="inherit_id"
            ref="purchase_guarantee_kmitl.view_purchase_guarantee_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_monetary_guarantee" invisible="1"/>
                <field name="has_active_receipt" invisible="1"/>
                <button
                    name="action_create_receipt"
                    string="Issue Guarantee Receipt"
                    type="object"
                    class="btn-primary"
                    groups="receipt_kmitl.group_receipt_kmitl_user"
                    attrs="{'invisible': ['|', ('is_monetary_guarantee', '=', False), ('has_active_receipt', '=', True)]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_receipts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    groups="receipt_kmitl.group_receipt_kmitl_viewer"
                    attrs="{'invisible': [('receipt_count', '=', 0)]}"
                >
                    <field
                        name="receipt_count"
                        widget="statinfo"
                        string="Receipts"
                    />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
