<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_order_change_form_committee" model="ir.ui.view">
        <field name="name">view.purchase.order.change.form.committee</field>
        <field name="model">purchase.order.change</field>
        <field
            name="inherit_id"
            ref="purchase_order_change.view_purchase_order_change_form"
        />
        <field name="arch" type="xml">
            <page name="document" position="before">
                <page
                    string="Committee Changes"
                    name="committee_changes"
                    attrs="{'invisible': [('has_wa_snapshot', '=', False), ('has_ws_snapshot', '=', False)]}"
                >
                    <field name="has_wa_snapshot" invisible="1" />
                    <field name="has_ws_snapshot" invisible="1" />
                    <!-- WA Committee snapshots -->
                    <group
                        name="procurement_inspection_committee_before" string="Procurement Inspection Committee (Before)"
                        colspan="2"
                        col="1"
                        attrs="{'invisible': [('has_wa_snapshot', '=', False)]}"
                    >
                        <field name="old_wa_snapshot_ids" nolabel="1" readonly="1">
                            <tree no_open="1">
                                <field name="employee_id" />
                                <field name="approve_role" />
                            </tree>
                        </field>
                    </group>
                    <group
                        name="procurement_inspection_committee_after" string="Procurement Inspection Committee (After)"
                        attrs="{'invisible': [('has_wa_snapshot', '=', False)]}"
                        colspan="2"
                        col="1"
                    >
                        <field name="new_wa_snapshot_ids" nolabel="1" readonly="1">
                            <tree no_open="1">
                                <field name="employee_id" />
                                <field name="approve_role" />
                            </tree>
                        </field>
                    </group>
                    <!-- Work Supervisor snapshots -->
                    <group
                        name="work_supervisor_before" string="Work Supervisor (Before)"
                        attrs="{'invisible': [('has_ws_snapshot', '=', False)]}"
                        colspan="2"
                        col="1"
                    >
                        <field name="old_ws_snapshot_ids" nolabel="1" readonly="1">
                            <tree no_open="1">
                                <field name="employee_id" />
                            </tree>
                        </field>
                    </group>
                    <group
                        name="work_supervisor_after" string="Work Supervisor (After)"
                        attrs="{'invisible': [('has_ws_snapshot', '=', False)]}"
                        colspan="2"
                        col="1"
                    >
                        <field name="new_ws_snapshot_ids" nolabel="1" readonly="1">
                            <tree no_open="1">
                                <field name="employee_id" />
                            </tree>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
