<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_purchase_order_change_committee_wizard"
        model="ir.ui.view"
    >
        <field name="name">purchase.order.change.wizard.form.committee</field>
        <field name="model">purchase.order.change.wizard</field>
        <field
            name="inherit_id"
            ref="purchase_order_change.view_purchase_order_change_wizard"
        />
        <field name="arch" type="xml">
            <field name="show_fines_fields" position="after">
                <field name="show_wa_committee" invisible="1" />
                <field name="show_ws_committee" invisible="1" />
            </field>
            <group name="new_contract_field_group" position="after">
                <!-- WA Committee: Before -->
                <group
                    name="procurement_inspection_committee_before" string="Procurement Inspection Committee (Before)"
                    colspan="2"
                    col="1"
                    attrs="{'invisible': [('show_wa_committee', '=', False)]}"
                >
                    <field
                        name="old_wa_committee_ids"
                        nolabel="1"
                        readonly="1"
                    >
                        <tree no_open="1">
                            <field name="employee_id" />
                            <field name="approve_role" />
                        </tree>
                    </field>
                </group>
                <!-- WA Committee: After -->
                <group
                    name="procurement_inspection_committee_after" string="Procurement Inspection Committee (After)"
                    colspan="2"
                    col="1"
                    attrs="{'invisible': [('show_wa_committee', '=', False)]}"
                >
                    <field name="new_wa_committee_ids" nolabel="1">
                        <tree editable="bottom">
                            <field
                                name="employee_id"
                                options="{'no_create': True}"
                            />
                            <field name="approve_role" />
                        </tree>
                    </field>
                </group>
                <!-- Work Supervisor: Before -->
                <group
                    name="work_supervisor_before" string="Work Supervisor (Before)"
                    colspan="2"
                    col="1"
                    attrs="{'invisible': [('show_ws_committee', '=', False)]}"
                >
                    <field
                        name="old_ws_committee_ids"
                        nolabel="1"
                        readonly="1"
                    >
                        <tree no_open="1">
                            <field name="employee_id" />
                        </tree>
                    </field>
                </group>
                <!-- Work Supervisor: After -->
                <group
                    name="work_supervisor_after" string="Work Supervisor (After)"
                    colspan="2"
                    col="1"
                    attrs="{'invisible': [('show_ws_committee', '=', False)]}"
                >
                    <field name="new_ws_committee_ids" nolabel="1">
                        <tree editable="bottom">
                            <field
                                name="employee_id"
                                options="{'no_create': True}"
                            />
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
