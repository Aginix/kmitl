<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Kept for the To-Dos raised before agx_approval ADR-0010 (the request
         no longer goes to `billed`). -->
    <record id="mail_activity_billed_fyi" model="mail.activity.type">
        <field name="name">คำขออนุมัติเบิกจ่ายแล้ว</field>
        <field name="summary">คำขออนุมัติของท่านดำเนินการเบิกจ่ายแล้ว</field>
        <field name="todo_category">acknowledgement</field>
        <field name="res_model">approval.request</field>
        <field name="icon">fa-check-circle</field>
        <field name="delay_count">0</field>
    </record>

    <record id="mail_activity_disbursed_fyi" model="mail.activity.type">
        <field name="name">ใบขอเบิกของคำขออนุมัติตัดงบแล้ว</field>
        <field name="summary">มีใบขอเบิกของคำขออนุมัติของท่านตัดงบแล้ว</field>
        <field name="todo_category">acknowledgement</field>
        <field name="res_model">approval.request</field>
        <field name="icon">fa-money</field>
        <field name="delay_count">0</field>
    </record>

    <record id="mail_activity_closed_fyi" model="mail.activity.type">
        <field name="name">คำขออนุมัติเสร็จสิ้น</field>
        <field name="summary">คำขออนุมัติของท่านปิดการเบิกจ่ายแล้ว</field>
        <field name="todo_category">acknowledgement</field>
        <field name="res_model">approval.request</field>
        <field name="icon">fa-check-circle</field>
        <field name="delay_count">0</field>
    </record>
</odoo>
