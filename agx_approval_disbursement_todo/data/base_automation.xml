<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- agx_approval ADR-0010: the request raises no To-Do for finance (finance
         works from the paperwork it receives); the requester is told as the
         request's ใบขอเบิก are disbursed and when it closes. -->
    <data noupdate="1">

        <record id="automation_notify_disbursed_fyi" model="base.automation">
            <field
                name="name"
            >ใบขอเบิก: แจ้ง FYI ผู้ขอเมื่อใบขอเบิกของคำขออนุมัติตัดงบแล้ว</field>
            <field name="model_id" ref="disbursement.model_disbursement_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('budget_consumed_amount', '=', 0)]</field>
            <field
                name="filter_domain"
            >[('budget_consumed_amount', '>', 0), ('approval_request_id', '!=', False)]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('disbursement_budget.field_disbursement_request__budget_consumed_amount')])]"
            />
            <field name="state">code</field>
            <field name="code">
for record in records:
    request = record.approval_request_id.sudo()
    request.activity_schedule(
        "agx_approval_disbursement_todo.mail_activity_disbursed_fyi",
        summary="ใบขอเบิก %s ของคำขออนุมัติเลขที่ %s ตัดงบแล้ว" % (record.display_name, request.name or ""),
        user_id=(request.user_id or env.user).id,
    )
</field>
        </record>

        <record id="automation_notify_closed_fyi" model="base.automation">
            <field
                name="name"
            >คำขออนุมัติ: แจ้ง FYI ผู้ขอเมื่อปิดคำขอ (done)</field>
            <field name="model_id" ref="agx_approval.model_approval_request" />
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '=', 'approved')]</field>
            <field name="filter_domain">[('state', '=', 'done')]</field>
            <field
                name="trigger_field_ids"
                eval="[(6, 0, [ref('agx_approval.field_approval_request__state')])]"
            />
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.activity_schedule(
        "agx_approval_disbursement_todo.mail_activity_closed_fyi",
        summary="คำขออนุมัติเลขที่ %s ปิดการเบิกจ่ายแล้ว" % (record.name or ""),
        user_id=(record.user_id or env.user).id,
    )
</field>
        </record>

    </data>
</odoo>
