<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <!-- Main F5 Overview Template -->
    <t t-name="budget_appropriation.F5Overview" owl="1">
        <div class="budget-appropriation-f5-overview">
            
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="mb-0">
                        <i class="fa fa-chart-bar me-2"/>
                        Budget Appropriation F5 Overview Report
                    </h3>
                    <small class="text-muted">Comprehensive view of all budget appropriations</small>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary btn-sm" t-on-click="onToggleFilters">
                        <i class="fa fa-filter me-1"/>
                        <t t-if="state.showFilters">Hide Filters</t>
                        <t t-else="">Show Filters</t>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"/>
                        Refresh
                    </button>
                    <button type="button" class="btn btn-outline-info btn-sm" t-on-click="onPrint">
                        <i class="fa fa-print me-1"/>
                        Print
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" t-on-click="onExport">
                        <i class="fa fa-download me-1"/>
                        Export
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="onBack">
                        <i class="fa fa-arrow-left me-1"/>
                        Back
                    </button>
                </div>
            </div>

            <!-- Filters Section -->
            <div t-if="state.showFilters" class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa fa-sliders me-2"/>
                        Filter Options
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Fiscal Year</label>
                            <!-- TODO: Add fiscal year selector -->
                            <select class="form-select" t-model="state.filters.fiscal_year_id">
                                <option value="">All Fiscal Years</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">State</label>
                            <select class="form-select" t-model="state.filters.state">
                                <option value="">All States</option>
                                <option value="draft">Draft</option>
                                <option value="review">Under Review</option>
                                <option value="posted">Posted</option>
                                <option value="cancel">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" 
                                       t-model="state.filters.include_zero_amounts"/>
                                <label class="form-check-label">
                                    Include Zero Amounts
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mt-4">
                                <button type="button" class="btn btn-primary me-2" t-on-click="onApplyFilters">
                                    Apply Filters
                                </button>
                                <button type="button" class="btn btn-outline-secondary" t-on-click="onResetFilters">
                                    Reset
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            <div t-if="state.loading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading overview data...</p>
            </div>

            <!-- Error State -->
            <div t-if="state.error" class="alert alert-danger">
                <i class="fa fa-exclamation-triangle me-2"/>
                <strong>Error:</strong> <t t-esc="state.error"/>
            </div>

            <!-- Main Content -->
            <div t-if="!state.loading and !state.error and state.data">
                
                <!-- Summary Cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title text-primary">
                                    <i class="fa fa-file-text-o"/>
                                </h5>
                                <h3 class="mb-1" t-esc="state.data.appropriations_summary.total_count"/>
                                <p class="card-text text-muted mb-0">Total Appropriations</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title text-success">
                                    <i class="fa fa-money"/>
                                </h5>
                                <h3 class="mb-1" t-esc="formatCurrency(state.data.appropriations_summary.total_amount)"/>
                                <p class="card-text text-muted mb-0">Total Amount</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title text-info">
                                    <i class="fa fa-list"/>
                                </h5>
                                <h3 class="mb-1" t-esc="state.data.summary.total_lines"/>
                                <p class="card-text text-muted mb-0">Total Lines</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title text-warning">
                                    <i class="fa fa-sitemap"/>
                                </h5>
                                <h3 class="mb-1" t-esc="state.data.summary.activities_count"/>
                                <p class="card-text text-muted mb-0">Activities</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- State Summary -->
                <div t-if="state.data.appropriations_summary.by_state" class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0">Appropriations by State</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <t t-foreach="Object.entries(state.data.appropriations_summary.by_state)" t-as="stateEntry" t-key="stateEntry[0]">
                                <div class="col-md-3 mb-2">
                                    <span class="badge bg-secondary me-2" t-esc="stateEntry[1]"/>
                                    <span t-esc="getStateDisplayName(stateEntry[0])"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Tree Controls -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        <i class="fa fa-tree me-2"/>
                        Budget Hierarchy
                    </h5>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" t-on-click="onExpandAll">
                            <i class="fa fa-plus-square-o me-1"/>
                            Expand All
                        </button>
                        <button type="button" class="btn btn-outline-primary" t-on-click="onCollapseAll">
                            <i class="fa fa-minus-square-o me-1"/>
                            Collapse All
                        </button>
                    </div>
                </div>

                <!-- Hierarchy Table -->
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60%;">
                                    <i class="fa fa-sitemap me-1"/>
                                    Description
                                </th>
                                <th class="text-end" style="width: 40%;">
                                    <i class="fa fa-money me-1"/>
                                    Amount (฿)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.data.hierarchy.length === 0">
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-4">
                                        <i class="fa fa-info-circle me-2"/>
                                        No data available with current filters
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <t t-foreach="state.data.hierarchy" t-as="node" t-key="node.key">
                                    <t t-call="budget_appropriation.F5OverviewTableRow">
                                        <t t-set="node" t-value="node"/>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Summary Footer -->
                <div class="card mt-4">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-2">
                                <strong>Appropriations:</strong><br/>
                                <span t-esc="state.data.summary.appropriations_count"/>
                            </div>
                            <div class="col-md-2">
                                <strong>Departments:</strong><br/>
                                <span t-esc="state.data.summary.departments_count"/>
                            </div>
                            <div class="col-md-2">
                                <strong>Activities:</strong><br/>
                                <span t-esc="state.data.summary.activities_count"/>
                            </div>
                            <div class="col-md-2">
                                <strong>Funds:</strong><br/>
                                <span t-esc="state.data.summary.funds_count"/>
                            </div>
                            <div class="col-md-2">
                                <strong>Lines:</strong><br/>
                                <span t-esc="state.data.summary.total_lines"/>
                            </div>
                            <div class="col-md-2">
                                <strong>Total Amount:</strong><br/>
                                <span t-esc="formatCurrency(state.data.summary.total_amount)"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Recursive Table Row Template (reuse from F5 Report) -->
    <t t-name="budget_appropriation.F5OverviewTableRow" owl="1">
        <tr t-attf-class="{{node.type}} {{node.type !== 'line' ? 'font-weight-bold' : ''}}">
            <td>
                <div t-att-style="node.type === 'account' ? 'margin-left: ' + (node.level * 15) + 'px;' : ''">
                    <div class="d-flex align-items-center">
                        <button
                            t-if="node.children and node.children.length > 0"
                            type="button"
                            class="btn btn-sm btn-link p-0 me-2"
                            t-on-click="() => this.onToggleNode(node.key)"
                            style="width: 20px;">
                            <i t-att-class="isNodeExpanded(node.key) ? 'fa fa-minus-square-o' : 'fa fa-plus-square-o'"/>
                        </button>
                        <div t-else="" style="width: 20px; display: inline-block;" class="me-2"></div>
                        <span>
                            <t t-if="node.code">
                                <t t-esc="node.code"/> - 
                            </t>
                            <t t-esc="node.name"/>
                            
                            <!-- Show note for accounts with line details -->
                            <t t-if="node.type === 'account' and node.line_details">
                                <t t-foreach="node.line_details" t-as="detail" t-key="detail.id">
                                    <t t-if="detail.note">
                                        <div class="text-muted small" style="margin-left: 20px;">
                                            <t t-esc="detail.note"/>
                                        </div>
                                    </t>
                                </t>
                            </t>
                        </span>
                    </div>
                </div>
            </td>
            <td class="text-end">
                <t t-if="node.total_amount != 0">
                    <t t-esc="formatCurrency(node.total_amount)"/>
                </t>
            </td>
        </tr>
        
        <!-- Recursive children -->
        <t t-if="isNodeExpanded(node.key) and node.children and node.children.length > 0">
            <t t-foreach="node.children" t-as="childNode" t-key="childNode.key">
                <t t-call="budget_appropriation.F5OverviewTableRow">
                    <t t-set="node" t-value="childNode"/>
                </t>
            </t>
        </t>
    </t>

</templates>