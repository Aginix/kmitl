<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="budget_appropriation.F5Widget" owl="1">
        <div class="budget_appropriation_f5_widget">
            <!-- Loading State -->
            <div t-if="state.loading" class="d-flex justify-content-center align-items-center p-5">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="sr-only">กำลังโหลด...</span>
                    </div>
                    <div>กำลังโหลดข้อมูล...</div>
                </div>
            </div>

            <!-- Error State -->
            <div t-elif="state.error" class="alert alert-danger m-3">
                <h4 class="alert-heading">เกิดข้อผิดพลาด</h4>
                <p t-esc="state.error"/>
            </div>

            <!-- Main Content -->
            <div t-elif="hasData" class="budget_appropriation_content">
                <!-- Controls -->
                <div class="d-flex justify-content-start align-items-center mb-3">
                    <div class="btn-group">
                        <button class="btn btn-sm btn-secondary" t-on-click="expandAll" title="ขยายทั้งหมด">
                            <i class="fa fa-expand"/>
                        </button>
                        <button class="btn btn-sm btn-secondary" t-on-click="collapseAll" title="ย่อทั้งหมด">
                            <i class="fa fa-compress"/>
                        </button>
                    </div>
                </div>

                <!-- Report Container -->
                <div class="budget-report-container">
                    <!-- Report Header -->
                    <div class="report-header text-center mb-4">
                        <h3 t-if="appropriation.source" t-esc="appropriation.source.name"/>
                        <h3>ประมาณการค่าใช้จ่าย ประจำปีงบประมาณ พ.ศ. <t t-if="appropriation.fiscal_year" t-esc="appropriation.fiscal_year.name"/></h3>
                        <h3>สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</h3>
                        <h3 t-if="appropriation.department" t-esc="appropriation.department.complete_name"/>
                        <h3>วงเงิน <t t-esc="formatCurrency(appropriation.total_amount)"/> บาท</h3>
                    </div>

                    <!-- Report Table -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm budget-report-table">
                            <thead>
                                <tr class="table-active">
                                    <th width="80%">รายการ</th>
                                    <th width="20%" class="text-end">จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="hierarchy" t-as="rootNode" t-key="rootNode.id">
                                    <t t-call="budget_appropriation.F5WidgetTableRow">
                                        <t t-set="node" t-value="rootNode"/>
                                        <t t-set="level" t-value="0"/>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="table-active fw-bold">
                                    <td class="text-end">
                                        <strong>ยอดรวมทั้งหมด</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-esc="formatCurrency(appropriation.total_amount)"/> บาท
                                        </strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div t-else="" class="text-center py-5">
                <div class="text-muted">
                    <i class="fa fa-folder-open fa-3x mb-3"/>
                    <h4>ไม่มีข้อมูล</h4>
                    <p>ไม่พบรายการจัดสรรงบประมาณ</p>
                </div>
            </div>
        </div>
    </t>

    <!-- Table Row Template -->
    <t t-name="budget_appropriation.F5WidgetTableRow" owl="1">
        <tr t-att-class="`${node.type} ${node.type !== 'line' ? 'fw-bold' : ''}`">
            <td>
                <div t-att-style="node.type === 'account' ? `margin-left: ${level * 20}px;` : ''">
                    <div class="d-flex align-items-center">
                        <button
                            t-if="node.children and node.children.length > 0"
                            type="button"
                            class="btn btn-sm btn-link p-0 me-2"
                            t-on-click="() => toggleNode(node.id)"
                            style="width: 20px;">
                            <i t-att-class="isExpanded(node.id) ? 'fa fa-minus-square-o' : 'fa fa-plus-square-o'"/>
                        </button>
                        <div t-else="" style="width: 20px; display: inline-block;" class="me-2"></div>
                        <span>
                            <t t-if="node.type === 'account'">
                                <t t-esc="node.code"/> - <t t-esc="node.name"/>
                                <t t-if="node.children">
                                    <t t-foreach="node.children" t-as="child" t-key="child.id">
                                        <t t-if="child.note">
                                            <div class="text-muted" style="white-space: pre-line;"><t t-esc="child.note"/></div>
                                        </t>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-esc="node.name"/>
                                <t t-if="node.code">
                                    <span class="text-muted"> (<t t-esc="node.code"/>)</span>
                                </t>
                            </t>
                        </span>
                    </div>
                </div>
            </td>
            <td class="text-end">
                <t t-if="node.total_amount != 0 or node.type !== 'line'">
                    <t t-esc="formatCurrency(node.total_amount || node.balance || 0)"/>
                </t>
            </td>
        </tr>

        <!-- Children Rows -->
        <t t-if="isExpanded(node.id) and node.children and node.children.length > 0">
            <t t-foreach="node.children" t-as="childNode" t-key="childNode.id">
                <t t-call="budget_appropriation.F5WidgetTableRow">
                    <t t-set="node" t-value="childNode"/>
                    <t t-set="level" t-value="level + 1"/>
                </t>
            </t>
        </t>
    </t>

</templates>