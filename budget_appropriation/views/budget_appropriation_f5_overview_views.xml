<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- F5 Overview Form View -->
        <record id="view_budget_appropriation_f5_overview_form" model="ir.ui.view">
            <field name="name">budget.appropriation.f5.overview.form</field>
            <field name="model">budget.appropriation.f5.overview</field>
            <field name="arch" type="xml">
                <form string="Budget Appropriation F5 Overview">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <i class="fa fa-chart-bar me-2"/>
                                F5 Overview Report
                            </h1>
                            <p class="text-muted">
                                Generate comprehensive overview of all budget appropriations with customizable filters
                            </p>
                        </div>
                        
                        <group>
                            <group string="General Filters">
                                <field name="fiscal_year_id" 
                                       domain="[('type_id.fiscal_type', '=', 'fiscal_year')]"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="state"/>
                                <field name="include_zero_amounts"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Dimension Filters">
                                <field name="department_ids" 
                                       widget="many2many_tags"
                                       domain="[('root_plan_id.code', '=', 'departments')]"
                                       options="{'no_create': True}"/>
                                <field name="activity_ids" 
                                       widget="many2many_tags"
                                       domain="[('root_plan_id.code', '=', 'activities')]"
                                       options="{'no_create': True}"/>
                                <field name="fund_ids" 
                                       widget="many2many_tags"
                                       domain="[('root_plan_id.code', '=', 'funds')]"
                                       options="{'no_create': True}"/>
                                <field name="source_ids" 
                                       widget="many2many_tags"
                                       domain="[('root_plan_id.code', '=', 'sources')]"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>
                        
                        <div class="alert alert-info mt-3">
                            <strong>Note:</strong> 
                            Leave dimension filters empty to include all values. 
                            Only expense-type appropriations are included in F5 reports.
                        </div>
                    </sheet>
                    
                    <footer>
                        <button name="action_generate_overview" 
                                string="Generate Overview Report" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- F5 Overview Action -->
        <record id="action_budget_appropriation_f5_overview" model="ir.actions.act_window">
            <field name="name">F5 Overview Report</field>
            <field name="res_model">budget.appropriation.f5.overview</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>

        <!-- Direct Overview Action (No Form) -->
        <record id="action_budget_appropriation_f5_overview_direct" model="ir.actions.client">
            <field name="name">F5 Overview Report</field>
            <field name="tag">budget_appropriation_f5_overview</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>