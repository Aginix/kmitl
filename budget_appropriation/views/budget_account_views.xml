<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View budget.account form -->
    <record id="view_budget_account_form" model="ir.ui.view">
        <field name="name">view.budget.account.form</field>
        <field name="model">budget.account</field>
        <field name="inherit_id" ref="budget.view_budget_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group name="revenue_deduction" string="หักโอน (รายรับ)" attrs="{'invisible': [('budget_type', '!=', 'revenue')]}">
                    <field name="deduct"  />
                    <field name="default_deduct_analytic_id" attrs="{'invisible': [('deduct', '!=', True)]}" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
