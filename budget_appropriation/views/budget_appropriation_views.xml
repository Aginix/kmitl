<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View budget.appropriation Tree -->
    <record id="view_budget_appropriation_tree" model="ir.ui.view">
        <field name="name">view.budget.appropriation.tree</field>
        <field name="model">budget.appropriation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_range_fy_id" />
                <field name="date" />
                <field name="name" />
                <field name="journal_id" />
                <field name="source_analytic_id" />
                <field name="total_amount" sum="Total Amount" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'review'"
                    decoration-success="state == 'posted'"
                />
                <field name="budget_move_id" />
            </tree>
        </field>
    </record>

    <!-- View budget.appropriation form -->
    <record id="view_budget_appropriation_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.form</field>
        <field name="model">budget.appropriation</field>
        <field name="arch" type="xml">
            <form string="Budget Appropriation">
                <header>
                    <button
                        name="action_review"
                        string="Submit for review"
                        class="oe_highlight"
                        type="object"
                        data-hotkey="r"
                        attrs="{'invisible': [('hide_review_button', '=', True)]}"
                    />
                    <button
                        name="action_post"
                        string="Post"
                        class="oe_highlight"
                        type="object"
                        data-hotkey="v"
                        attrs="{'invisible': [('hide_post_button', '=', True)]}"
                    />
                    <button
                        name="button_draft"
                        string="Reset to Draft"
                        type="object"
                        attrs="{'invisible' : [('show_reset_to_draft_button', '=', False)]}"
                        data-hotkey="q"
                    />
                    <button
                        name="button_cancel"
                        string="Cancel"
                        type="object"
                        data-hotkey="w"
                        attrs="{'invisible' : ['|', ('id', '=', False), ('state', '!=', 'draft')]}"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,review,posted"
                        readonly="1"
                    />
                </header>
                <!-- Invisible Fields -->
                <field name="show_reset_to_draft_button" invisible="1" />
                <field name="hide_review_button" invisible="1" />
                <field name="hide_post_button" invisible="1" />
                <field name="state" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="budget_type" invisible="1" />
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="ข้อมูลทั่วไป">
                            <field name="date" required="1" />
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                required="1"
                            />
                            <field name="ref" />
                            <field name="note" />
                            <field name="total_amount" readonly="1" />
                        </group>
                        <group string="มิติบัญชี">
                            <field
                                name="date_range_fy_id"
                                options='{"no_create": True, "no_create_edit": True,"no_open": True}'
                                required="1"
                            />
                            <field
                                name="department_analytic_id"
                                options='{"no_create": True, "no_create_edit": True,"no_open": True}'
                            />
                            <field
                                name="source_analytic_id"
                                options='{"no_create": True, "no_create_edit": True,"no_open": True}'
                                required="1"
                            />
                            <field
                                name="journal_id"
                                required="1"
                                attrs="{'readonly': [('id', '!=', False)]}"
                            />
                        </group>
                        <group string="การเชื่อมโยง" attrs="{'invisible': [('state', '!=', 'posted')]}">
                            <field name="budget_move_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="line_ids" string="Appropriation Lines">
                            <field
                                name="line_ids"
                                style="max-width: 100%; display: block;"
                                attrs="{'readonly': [('state', 'in', ['review', 'posted', 'cancel'])]}"
                            >
                                <tree editable="bottom">
                                    <field name="appropriation_id" invisible="1" />
                                    <field name="budget_type" invisible="1" />
                                    <field
                                        name="account_id"
                                        options='{"no_open": True}'
                                        required="1"
                                    />
                                    <field name="balance" sum="Total" />
                                    <field name="note" />
                                    <field
                                        name="analytic_distribution"
                                        widget="analytic_distribution"
                                        options="{'account_field': 'account_id', 'business_domain': 'budget'}"
                                    />
                                </tree>
                                <form>
                                    <group>
                                        <field name="appropriation_id" invisible="1" />
                                        <field name="budget_type" invisible="1" />
                                        <field
                                            name="account_id"
                                            options='{"no_create": True, "no_create_edit": True,"no_open": True}'
                                            required="1"
                                        />
                                        <field name="balance" />
                                        <field name="note" />
                                    </group>
                                    <group string="Analytic Distribution">
                                        <field
                                            name="analytic_distribution"
                                            widget="analytic_distribution"
                                            options="{'account_field': 'account_id', 'business_domain': 'budget'}"
                                        />
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- View budget.appropriation.line Tree -->
    <record id="view_budget_appropriation_line_tree" model="ir.ui.view">
        <field name="name">view.budget.appropriation.line.tree</field>
        <field name="model">budget.appropriation.line</field>
        <field name="arch" type="xml">
            <tree
                create="false"
                edit="false"
                delete="false"
                expand="context.get('expand', False)"
                sample="1"
            >
                <field name="budget_type" />
                <field name="appropriation_id" widget="many2onebutton" />
                <field name="date" />
                <field name="department_analytic_id" />
                <field name="activity_analytic_id" />
                <field name="fund_analytic_id" />
                <field name="source_analytic_id" />
                <field name="account_id" />
                <field name="balance" sum="Total" />
                <field name="note" />
            </tree>
        </field>
    </record>

    <!-- View budget.appropriation.line form -->
    <record id="view_budget_appropriation_line_form" model="ir.ui.view">
        <field name="name">view.budget.appropriation.line.form</field>
        <field name="model">budget.appropriation.line</field>
        <field name="arch" type="xml">
            <form string="Budget Appropriation Line">
                <sheet>
                    <group>
                        <field name="appropriation_id" readonly="1" />
                        <field name="budget_type" invisible="1" />
                        <field
                            name="account_id"
                            options='{"no_create": True, "no_create_edit": True,"no_open": True}'
                            required="1"
                        />
                        <field name="balance" />
                        <field name="note" />
                    </group>
                    <group string="Analytic Distribution">
                        <field
                            name="analytic_distribution"
                            widget="analytic_distribution"
                            options="{'account_field': 'account_id', 'business_domain': 'budget'}"
                        />
                    </group>
                    <group string="Analytic Dimensions" readonly="1">
                        <field name="department_analytic_id" />
                        <field name="activity_analytic_id" />
                        <field name="fund_analytic_id" />
                        <field name="source_analytic_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View budget.appropriation search -->
    <record id="view_budget_appropriation_search" model="ir.ui.view">
        <field name="name">view.budget.appropriation.search</field>
        <field name="model">budget.appropriation</field>
        <field name="arch" type="xml">
            <search string="Budget Appropriations">
                <field name="name" />
                <field name="ref" />
                <field name="journal_id" />
                <field name="source_analytic_id" />
                <field name="department_analytic_id" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="review"
                    string="In Review"
                    domain="[('state', '=', 'review')]"
                />
                <filter
                    name="posted"
                    string="Posted"
                    domain="[('state', '=', 'posted')]"
                />
                <separator />
                <filter
                    name="current_fy"
                    string="Current Fiscal Year"
                    domain="[('date_range_fy_id.date_from', '&lt;=', context_today()), ('date_range_fy_id.date_to', '&gt;=', context_today())]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_journal"
                        string="Journal"
                        context="{'group_by': 'journal_id'}"
                    />
                    <filter
                        name="group_by_fiscal_year"
                        string="Fiscal Year"
                        context="{'group_by': 'date_range_fy_id'}"
                    />
                    <filter
                        name="group_by_source"
                        string="Source"
                        context="{'group_by': 'source_analytic_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_budget_appropriation" model="ir.actions.act_window">
        <field name="name">Budget Appropriations</field>
        <field name="res_model">budget.appropriation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new budget appropriation!
            </p>
            <p>
                Budget appropriations allow you to plan budget allocations before creating actual budget moves.
                This provides a preliminary stage for budget planning without affecting the accounting records.
            </p>
        </field>
    </record>

    <record id="action_budget_appropriation_line" model="ir.actions.act_window">
        <field name="name">Budget Appropriation Lines</field>
        <field name="res_model">budget.appropriation.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

</odoo>