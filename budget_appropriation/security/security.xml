<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Record rules for budget appropriation -->
        <record id="budget_appropriation_company_rule" model="ir.rule">
            <field name="name">Budget Appropriation: multi-company</field>
            <field name="model_id" ref="model_budget_appropriation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="budget_appropriation_line_company_rule" model="ir.rule">
            <field name="name">Budget Appropriation Line: multi-company</field>
            <field name="model_id" ref="model_budget_appropriation_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
