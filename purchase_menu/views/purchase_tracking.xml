<odoo>
    <record id="action_contracts_expiring" model="ir.actions.act_window">
        <field name="name">Contract Nearly Expire</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="purchase_menu.view_purchase_order_tree_expiring"/>
        <field name="search_view_id" ref="purchase_menu.view_purchase_order_search_expiring"/>
        <field name="domain">[('days_to_expire', '&lt;', 60)]</field>
        <field name="context">{'search_default_group_by_days_to_expire': 1}</field>
    </record>

    <record id="action_guarantees_expiring" model="ir.actions.act_window">
        <field name="name">Guarantee Expire</field>
        <field name="res_model">purchase.guarantee</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('date_due_guarantee', '&lt;', (context_today() + relativedelta(days=30)))]</field>
        <field name="context">{}</field>
    </record>
</odoo>