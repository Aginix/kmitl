<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Purchase menu -->
    <menuitem id="purchase.menu_purchase_root" name="Purchases" sequence="10" />

    <!-- Remove "Orders" menu -->
    <record id="purchase.menu_purchase_order" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Remove "Products" menu -->
    <record id="purchase.product_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- เมนูหลักใหม่ -->
    <menuitem id="menu_purchase_contract_root"
              name="สัญญา/ใบสั่งซื้อ/จ้าง"
              parent="purchase.menu_purchase_root"
              sequence="10"/>

    <!-- เมนูย่อย: รายการสัญญา/ใบสั่งซื้อ/จ้าง (purchase.order) -->
    <menuitem id="menu_purchase_contract_orders"
              name="รายการสัญญา/ใบสั่งซื้อ/จ้าง"
              parent="menu_purchase_contract_root"
              action="purchase.purchase_order_action"
              sequence="10"/>

    <!-- เมนูย่อย: การตรวจรับ (สมมุติว่าเป็นโมเดล work.acceptance) -->
    <menuitem id="menu_purchase_work_acceptance"
              name="การตรวจรับ"
              parent="menu_purchase_contract_root"
              action="purchase_work_acceptance.action_work_acceptance"
              sequence="20"/>
</odoo>
